#!/usr/bin/env python3
"""Merge per-agent evidence/*.jsonl into index/ops.jsonl (one row per op; missing outcome => status=unknown). Raw streams are never modified."""
import json, glob, os, collections
R = os.path.expanduser("~/projects/siminfeng/campaign"); ops = collections.OrderedDict(); raw = {}
for f in sorted(glob.glob(f"{R}/evidence/*.jsonl") + glob.glob(f"{R}/evidence/*/*.jsonl")):
    raw[os.path.basename(f)] = sum(1 for _ in open(f))
    for l in open(f):
        r = json.loads(l)
        if "op" not in r: continue
        o = ops.setdefault(r["op"], dict(op=r["op"], agent=r.get("agent"), task=r.get("task"), parent=r.get("parent"), stream=os.path.basename(f), status="unknown"))
        k = r["kind"]
        if k == "intent": o.update(desc=r.get("desc"), argv=r.get("argv"), cwd=r.get("cwd"), t_start=r["ts"])
        elif k == "started": o.update(pgid=r.get("pgid"))
        elif k == "outcome": o.update(status=r["status"], exit_code=r.get("exit_code"), t_end=r["ts"], elapsed_s=r.get("elapsed_s"), survivors=r.get("survivors", []),
                                      stdout=r.get("stdout"), stderr=r.get("stderr"))
os.makedirs(f"{R}/index", exist_ok=True)
with open(f"{R}/index/ops.jsonl.tmp", "w") as w:
    for o in ops.values(): w.write(json.dumps(o, sort_keys=True) + "\n")
os.replace(f"{R}/index/ops.jsonl.tmp", f"{R}/index/ops.jsonl")
c = collections.Counter(o["status"] for o in ops.values())
print("ops:", len(ops), dict(c), "| raw streams:", raw)
