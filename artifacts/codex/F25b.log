"""MCP front door for agents: discover, read, call, start and stop CCs in a folder.

One stdio server per agent session. It wraps one `Host` (so receipts, call keys
and instance records persist in `--store`) and one folder of CC packages
(`--ccs DIR`, each child holding a `cc.yaml`).

Authority comes only from `--grant` flags and `--workspace`; an agent cannot
widen them. Reading a material never grants execution.
"""
from __future__ import annotations

import argparse
import atexit
import functools
import json
import uuid
from pathlib import Path
from typing import Any

from .ccv2 import CCError, Host, callable_entries, service_entries

MAX_TEXT = 200_000


class Catalog:
    def __init__(self, ccs, store: Path, grants=(), workspace: Path | None = None):
        self.roots = [Path(c).resolve() for c in ([ccs] if isinstance(ccs, (str, Path)) else ccs)]
        self.ccs = self.roots[0]
        resources = {}
        self.workspace = Path(workspace).resolve() if workspace else None
        if workspace:
            resources['workspace'] = {'kind': 'workspace', 'path': str(Path(workspace).resolve())}
        self.host = Host(store, resources=resources, session_grants=list(grants))
        self.releases: dict[str, str] = {}
        self.errors: dict[str, dict] = {}
        self.owned: dict[str, str] = {}  # instance id -> handle, for instances this session started

    # -- discovery ---------------------------------------------------------
    def scan(self) -> list[dict]:
        self.releases.clear()
        self.errors.clear()
        entries = []
        folders = [p for root in self.roots if root.is_dir() for p in sorted(root.iterdir()) if (p / 'cc.yaml').is_file()]
        for folder in folders:
            try:
                release = self.host.prepare(folder)
                release = release['release'] if isinstance(release, dict) else release
                declaration = self.host.describe(release)
            except CCError as e:
                self.errors[folder.name] = e.record()
                entries.append({'folder': folder.name, 'usable': False, 'error': e.record()})
                continue
            if declaration['id'] in self.releases:
                err = {'code': 'DUPLICATE_ID', 'path': '', 'message': f"{declaration['id']!r} in {folder} duplicates an earlier CC; the earlier one is kept"}
                self.errors[folder.name] = err
                entries.append({'folder': folder.name, 'usable': False, 'error': err})
                continue
            self.releases[declaration['id']] = release
            entries.append(self.summary(declaration, release, folder.name))
        return entries

    @staticmethod
    def summary(declaration: dict, release: str, folder: str) -> dict:
        callable_ = callable_entries(declaration)
        services = service_entries(declaration)
        caps = {}
        for name, cap in declaration.get('capabilities', {}).items():
            caps[name] = {
                'kind': 'service' if name in services else 'finite',
                'does': cap.get('does'),
                'takes': sorted(cap.get('takes', {})),
                'gives': sorted(cap.get('gives', {})),
                'needs': cap.get('needs', []),
                'effects': cap.get('changes', []),
                'binding': (declaration['bindings'].get(cap.get('using', 'default')) or {}).get('kind'),
                'module': cap.get('kind', 'tool'),
            }
        return {
            'cc': declaration['id'], 'version': declaration['version'], 'release': release,
            'folder': folder, 'usable': True, 'capabilities': caps,
            'materials': {k: v.get('description') for k, v in declaration.get('materials', {}).items()},
            'material_kinds': {k: v.get('kind', 'reference') for k, v in declaration.get('materials', {}).items()},
            'callable': sorted(callable_), 'services': sorted(services),
        }

    def release_for(self, cc: str) -> str:
        if cc not in self.releases:
            self.scan()
        if cc not in self.releases:
            raise CCError('UNKNOWN_CC', f'{cc!r} not found in {self.ccs}; known: {sorted(self.releases)}')
        return self.releases[cc]

    def workspace_file(self, path: str) -> Path:
        root = self.workspace
        if root is None:
            raise CCError('NO_WORKSPACE', 'No workspace is configured; artifacts cannot be registered')
        target = (root / path).resolve() if not Path(path).is_absolute() else Path(path).resolve()
        if root != target and root not in target.parents:
            raise CCError('OUTSIDE_WORKSPACE', f'{path!r} is outside the workspace')
        if not target.is_file():
            raise CCError('NOT_A_FILE', f'{path!r} is not a file in the workspace')
        return target

    # -- use ---------------------------------------------------------------
    def material(self, cc: str, name: str) -> dict:
        release = self.release_for(cc)
        meta = self.host.material(release, name)
        _, bundle = self.host.release(release)
        path = Path(bundle) / meta['path']
        data = path.read_bytes()
        text = data[:MAX_TEXT].decode('utf-8', errors='replace')
        return {'cc': cc, 'material': name, 'media_type': meta.get('media_type'),
                'description': meta.get('description'), 'truncated': len(data) > MAX_TEXT, 'text': text,
                'authority': 'Reading this grants no execution authority.'}

    def start(self, cc: str, capability: str, inputs: dict | None, key: str | None) -> dict:
        instance = self.host.start(self.release_for(cc), capability, inputs or {}, key=key or str(uuid.uuid4()))
        endpoints = instance.get('endpoints') or {}
        if instance.get('state') == 'running' and endpoints:
            handle = f"env-{instance['id']}"
            self.host.resources[handle] = {'kind': 'environment', 'url': next(iter(endpoints.values())),
                                           'instance': instance['id']}
            instance = dict(instance, handle=handle)
        if instance.get('id') and instance.get('state') in {'running', 'preparing'}:
            self.owned[instance['id']] = instance.get('handle', '')
        return instance

    def stop(self, instance: str) -> dict:
        if instance not in self.owned:
            raise CCError('NOT_OWNED', f'{instance!r} was not started by this session; refusing to stop it')
        result = self.host.stop(instance)
        if result.get('state') == 'stopped':
            self.host.resources.pop(self.owned.pop(instance), None)
        return result

    def stop_all(self) -> None:
        for instance in list(self.owned):
            try:
                self.stop(instance)
            except Exception:
                pass


def build(catalog: Catalog):
    from mcp.server.fastmcp import FastMCP

    mcp = FastMCP('cc-v2')

    def guarded(fn):
        @functools.wraps(fn)  # keeps the real signature so MCP advertises the right arguments
        def run(*a, **k):
            try:
                return fn(*a, **k)
            except CCError as e:
                return {'error': e.record()}
        return run

    @mcp.tool()
    @guarded
    def cc_list() -> Any:
        """List the Capability Capsules available to this session: their capabilities (finite or service), materials, and whether each declaration is usable. Start here."""
        return {'ccs': catalog.scan(), 'folders': [str(r) for r in catalog.roots],
                'handles': {k: v['kind'] for k, v in catalog.host.resources.items()},
                'note': 'Pass a listed handle name as the value of a handle input (e.g. workspace).'}

    @mcp.tool()
    @guarded
    def cc_describe(cc: str) -> Any:
        """Full normalized declaration of one CC (ports, bindings, effects)."""
        return catalog.host.describe(catalog.release_for(cc))

    @mcp.tool()
    @guarded
    def cc_material(cc: str, material: str) -> Any:
        """Read a passive material (instructions, methodology, reference). Reading it does not authorize running anything."""
        return catalog.material(cc, material)

    @mcp.tool()
    @guarded
    def cc_artifact(path: str) -> Any:
        """Register a file inside the workspace as an artifact ({uri, sha256}) usable as an artifact input. Paths outside the workspace are refused."""
        return catalog.host.put_artifact(catalog.workspace_file(path))

    @mcp.tool()
    @guarded
    def cc_call(cc: str, capability: str, inputs: dict | None = None, key: str | None = None) -> Any:
        """Run a finite capability and return its receipt. Reuse the same `key` to retry without running twice; omit it for a fresh call. A receipt state of failed/blocked/unknown is not a success."""
        return catalog.host.call(catalog.release_for(cc), capability, inputs or {}, key=key or str(uuid.uuid4()))

    @mcp.tool()
    @guarded
    def cc_start(cc: str, capability: str, inputs: dict | None = None, key: str | None = None) -> Any:
        """Start a served capability (native process or image). Returns the instance with native endpoints and, when running, a `handle` you can pass to client CCs. Always cc_stop it when done."""
        return catalog.start(cc, capability, inputs, key)

    @mcp.tool()
    @guarded
    def cc_instance(instance: str) -> Any:
        """Inspect a started instance (state, readiness, endpoints, image identity)."""
        return catalog.host.inspect_instance(instance)

    @mcp.tool()
    @guarded
    def cc_stop(instance: str) -> Any:
        """Stop an instance this session owns and confirm it stopped. A state other than 'stopped' means stop was not confirmed."""
        return catalog.stop(instance)

    return mcp


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--ccs', required=True, action='append', help='folder containing CC packages (each with cc.yaml); repeatable')
    p.add_argument('--store', required=True)
    p.add_argument('--grant', action='append', default=[])
    p.add_argument('--workspace', help="path exposed as the 'workspace' handle")
    p.add_argument('--allow-built', action='append', default=[], help='extra CC folder the agent may write into; its CCs run with the same grants as trusted ones')
    a = p.parse_args(argv)
    catalog = Catalog([Path(c) for c in a.ccs + a.allow_built], Path(a.store), a.grant, Path(a.workspace) if a.workspace else None)
    atexit.register(catalog.stop_all)
    try:
        build(catalog).run()
    finally:
        catalog.stop_all()


if __name__ == '__main__':
    main()
from copy import deepcopy
import json
from pathlib import Path
import tempfile
import unittest
import subprocess

from jiuwenswarm.ccv2.ccv2 import CCError, Host
from .product_fixture import fixture
from jiuwenswarm.ccv2.source_build import materialize


class SourceTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.root = Path(self.temp.name)
        self.host = Host(self.root/'store')
        self.template, self.change = fixture(self.root/'input', self.host)

    def tearDown(self): self.temp.cleanup()

    def build(self, change=None, **options):
        return materialize(self.host, self.template, change or self.change, self.root/'output', **options)

    def test_exact_change_build_and_provenance(self):
        built = self.build(trusted_build=True)
        record = json.loads(self.host.artifact_path(built['build_record']).read_bytes())
        self.assertEqual(record['observed_tree'], self.change['tree'])
        self.assertIn(b'FACTOR = 2', (self.root/'output/payload/server.py').read_bytes())
        call = self.host.call(built['release'], 'inspect', {})
        self.assertEqual(call['state'], 'succeeded')
        self.assertEqual(call['provenance']['build_record'], built['build_record'])

    def test_build_authority_not_implicit(self):
        with self.assertRaises(CCError) as error: self.build()
        self.assertEqual(error.exception.code, 'BUILD_AUTHORIZATION_REQUIRED')

    def test_wrong_tree_rejected(self):
        change = deepcopy(self.change); change['tree'] = '0'*40
        with self.assertRaises(CCError) as error: self.build(change, trusted_build=True)
        self.assertEqual(error.exception.code, 'TREE_MISMATCH')
        self.assertFalse((self.root/'output').exists())

    def test_mutable_base_rejected(self):
        change = deepcopy(self.change); change['base'] = 'main'
        with self.assertRaises(CCError) as error: self.build(change, trusted_build=True)
        self.assertEqual(error.exception.code, 'MUTABLE_SOURCE')

    def test_missing_lock_rejected(self):
        change = deepcopy(self.change); change['build']['lock'] = 'missing.lock'
        with self.assertRaises(CCError) as error: self.build(change, trusted_build=True)
        self.assertEqual(error.exception.code, 'MISSING_DEPENDENCY_LOCK')

    def test_staged_source_mutation_rejected(self):
        change = deepcopy(self.change)
        change['build']['command'] = ['{python}', '-c', "from pathlib import Path; import subprocess; Path('server.py').write_text('changed'); subprocess.run(['git','add','server.py'],check=True)"]
        with self.assertRaises(CCError) as error: self.build(change, trusted_build=True)
        self.assertEqual(error.exception.code, 'BUILD_MUTATED_SOURCE')

    def test_no_overwrite(self):
        (self.root/'output').mkdir()
        with self.assertRaises(CCError) as error: self.build(trusted_build=True)
        self.assertEqual(error.exception.code, 'OUTPUT_EXISTS')

    def test_failure_retains_stdout_stderr_and_exit(self):
        change = deepcopy(self.change)
        change['build']['command'] = ['{python}', '-c', "import sys; print('build observation'); print('build failure',file=sys.stderr); sys.exit(3)"]
        with self.assertRaises(CCError) as error: self.build(change, trusted_build=True)
        record = json.loads(Path(error.exception.path).read_bytes())
        self.assertEqual(record['state'], 'failed')
        self.assertEqual(record['steps'][-1]['exit_code'], 3)
        self.assertIn('build observation', record['steps'][-1]['stdout'])
        self.assertIn('build failure', record['steps'][-1]['stderr'])

    def test_timeout_is_durable_unknown(self):
        change = deepcopy(self.change)
        change['build']['command'] = ['{python}', '-c', "import time; print('started',flush=True); time.sleep(5)"]
        with self.assertRaises(CCError) as error: self.build(change, trusted_build=True, timeout=.5)
        self.assertEqual(error.exception.code, 'BUILD_TIMEOUT')
        record = json.loads(Path(error.exception.path).read_bytes())
        self.assertEqual(record['state'], 'unknown')
        self.assertIn('started', record['steps'][-1]['stdout'])

    def test_empty_patch_rebuilds_exact_base(self):
        repository = self.root/'input/repository'
        tree = subprocess.check_output(['git', 'rev-parse', self.change['base']+'^{tree}'], cwd=repository).decode().strip()
        patch = self.root/'empty.patch'; patch.write_bytes(b'')
        change = deepcopy(self.change); change.update(tree=tree, patch=self.host.put_artifact(patch))
        built = self.build(change, trusted_build=True)
        self.assertEqual(built['source_tree'], tree)

    def test_unresolved_lfs_pointer_rejected(self):
        repository = self.root/'input/repository'
        (repository/'weights.bin').write_text('version https://git-lfs.github.com/spec/v1\noid sha256:'+'a'*64+'\nsize 999\n', encoding='utf-8')
        def git(*args): return subprocess.check_output(['git', *args], cwd=repository, stderr=subprocess.PIPE).decode().strip()
        git('add', 'weights.bin')
        git('-c', 'user.name=CC fixture', '-c', 'user.email=fixture@example.invalid', 'commit', '-m', 'LFS pointer fixture')
        patch = self.root/'empty.patch'; patch.write_bytes(b'')
        change = deepcopy(self.change); change.update(base=git('rev-parse', 'HEAD'), tree=git('rev-parse', 'HEAD^{tree}'), patch=self.host.put_artifact(patch))
        with self.assertRaises(CCError) as error: self.build(change, trusted_build=True)
        self.assertEqual(error.exception.code, 'UNSUPPORTED_SOURCE_MATERIAL')


if __name__ == '__main__': unittest.main()
from copy import deepcopy
import os
import json
from pathlib import Path
import tempfile
import shutil
import subprocess
import sys
import time
import unittest
from unittest.mock import patch
import urllib.request

from jiuwenswarm.ccv2.ccv2 import CCError, Host, normalize, service_entries, callable_entries


EXAMPLE = Path(__file__).parent/'examples/http_product'


def draft(declaration):
    """Create a test-only mutable service view."""
    result = deepcopy(declaration)
    result['applications'] = service_entries(result)
    result['capabilities'] = callable_entries(result)
    return result


def undraft(declaration):
    declaration = deepcopy(declaration)
    declaration.setdefault('capabilities', {})
    for name, app in declaration.pop('applications', {}).items():
        cap = {k:v for k,v in app.items() if k not in {'interfaces','ready'}}
        cap['serves'] = {k:v for k,v in app.items() if k in {'interfaces','ready'}}
        declaration['capabilities'][name] = cap
    return declaration


class ProductTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.host = Host(Path(self.temp.name)/'store', session_grants=['process.exec', 'network.listen', 'workspace.write'])
        self.release = self.host.prepare(EXAMPLE)
        self.started = []

    def tearDown(self):
        for instance in self.started:
            self.host.stop(instance)
        self.temp.cleanup()

    def start(self, **options):
        result = self.host.start(self.release, 'api', **options)
        if result['identity']:
            self.started.append(result['id'])
        return result

    def test_hybrid_package_tool_and_application(self):
        description = self.host.describe(self.release)
        self.assertEqual(set(description['capabilities']), {'inspect', 'api'})
        self.assertEqual(set(service_entries(description)), {'api'})
        tool = self.host.call(self.release, 'inspect', {})
        self.assertEqual(tool['state'], 'succeeded')
        self.assertEqual(tool['effects']['granted'], [])
        app = self.start()
        self.assertEqual((app['state'], app['readiness']), ('running', 'ready'), app)
        self.assertEqual(app['effects']['granted'], ['network.listen', 'process.exec'])
        with urllib.request.urlopen(app['endpoints']['api']+'compute?x=3', timeout=2) as response:
            self.assertEqual(json.load(response)['value'], 3)
        self.assertEqual(self.host.inspect_instance(app['id'])['state'], 'running')
        self.assertEqual(self.host.stop(app['id'])['state'], 'stopped')

    def test_application_is_not_implicitly_an_agent_tool(self):
        result = self.host.call(self.release, 'api', {})
        self.assertEqual(result['reason'], 'SERVICE_REQUIRES_START')

    def test_product_only_and_no_empty_package(self):
        declaration = draft(self.host.release(self.release)[0])
        declaration.pop('capabilities')
        product = normalize(undraft(declaration))
        self.assertEqual(set(service_entries(product)), {'api'})
        product.pop('capabilities')
        with self.assertRaises(CCError): normalize(product)

    def test_no_implicit_deployment_authority(self):
        host = Host(Path(self.temp.name)/'limited')
        release = host.prepare(EXAMPLE)
        with self.assertRaises(CCError) as error:
            host.start(release, 'api')
        self.assertEqual(error.exception.code, 'DENIED')

    def test_instance_replay_and_conflict(self):
        first = self.start(key='start-once')
        self.assertEqual(first['id'], self.host.start(self.release, 'api', key='start-once')['id'])
        with self.assertRaises(CCError):
            self.host.start(self.release, 'api', key='start-once', timeout=3)

    def test_unknown_protocol_and_reference_rejected(self):
        declaration = draft(self.host.release(self.release)[0])
        wrong = deepcopy(declaration)
        wrong['applications']['api']['interfaces']['api']['protocol'] = 'invented'
        with self.assertRaises(CCError): normalize(undraft(wrong))
        wrong = deepcopy(declaration)
        wrong['applications']['api']['ready']['interface'] = 'missing'
        with self.assertRaises(CCError): normalize(undraft(wrong))

    def test_generation_mismatch_never_stops_another_process(self):
        app = self.start()
        manager = self.host._applications()
        original = manager.get(app['id'])
        wrong = deepcopy(original); wrong['identity']['created'] += 100
        manager.save(wrong)
        try:
            with self.assertRaises(CCError) as error:
                self.host.stop(app['id'])
            self.assertEqual(error.exception.code, 'INSTANCE_REPLACED')
        finally:
            manager.save(original)

    def test_lab_optional_telemetry_does_not_block_benchmark(self):
        app=self.start()
        self.host.resources['engine']={'kind':'environment','url':app['endpoints']['api'],'instance':app['id']}
        self.host.session_grants.append('network.request')
        bundle=Path(__file__).resolve().parent/'protocol_examples/lab'
        observation=self.host.run(bundle,'observe',{'engine':'engine'})
        self.assertEqual((observation['state'],observation['completeness']),('succeeded','partial'))
        self.assertEqual(observation['effects']['granted'],[])
        result=self.host.run(bundle,'benchmark',{'engine':'engine','workload':{'points':[1,2,3]}})
        self.assertEqual(result['state'],'succeeded')
        self.assertEqual(result['outputs']['metrics']['values'],[1,2,3])
        self.assertEqual(result['assessment']['verdict'],'not_requested')

    def test_image_listen_does_not_silently_grant_egress(self):
        declaration = draft(self.host.release(self.release)[0])
        declaration['bindings']['default'] = {'kind': 'image', 'image': 'sha256:'+'a'*64, 'command': ['app']}
        import yaml
        folder = Path(self.temp.name)/'image'; folder.mkdir()
        (folder/'cc.yaml').write_text(yaml.safe_dump(undraft(declaration)), encoding='utf-8')
        (folder/'api.json').write_bytes((EXAMPLE/'api.json').read_bytes())
        (folder/'inspect.py').write_bytes((EXAMPLE/'inspect.py').read_bytes())
        release = self.host.prepare(folder)
        with self.assertRaises(CCError) as error:
            self.host.start(release, 'api')
        self.assertEqual(error.exception.code, 'UNSUPPORTED_NETWORK_POLICY')

    def variant(self, change):
        import yaml
        folder = Path(self.temp.name)/'variant'
        shutil.copytree(EXAMPLE, folder)
        declaration = draft(self.host.release(self.release)[0])
        change(declaration)
        (folder/'cc.yaml').write_text(yaml.safe_dump(undraft(declaration)), encoding='utf-8')
        return self.host.prepare(folder)

    def test_application_inputs_are_strict_ports_with_open_json(self):
        release = self.variant(lambda d: d['applications']['api'].update(takes={'options': 'json'}))
        with self.assertRaises(CCError) as error: self.host.start(release, 'api')
        self.assertEqual(error.exception.code, 'INVALID_INPUT')
        inputs = {'options': {'arbitrary': {'new_fields': [1, True, None]}}}
        app = self.host.start(release, 'api', inputs)
        self.started.append(app['id'])
        self.assertEqual((app['state'], app['inputs']), ('running', inputs))

    def test_readiness_failure_preserves_logs_and_stops(self):
        release = self.variant(lambda d: d['applications']['api']['ready'].update(path='/unavailable'))
        app = self.host.start(release, 'api', timeout=0.15)
        self.started.append(app['id'])
        self.assertEqual(app['state'], 'failed', app)
        self.assertTrue(any(d['code'] == 'READINESS_TIMEOUT' for d in app['diagnostics']))
        self.assertTrue(Path(app['logs']['stderr']).is_file())
        self.assertEqual(self.host.stop(app['id'])['state'], 'failed')
        self.assertIn('stopped', app['provenance'])

    def test_restart_host_looks_up_original_instance(self):
        app = self.start(key='durable-start')
        other = Host(Path(self.temp.name)/'store', session_grants=['process.exec', 'network.listen'])
        replay = other.start(self.release, 'api', key='durable-start')
        self.assertEqual(replay['id'], app['id'])
        self.assertEqual(other.inspect_instance(app['id'])['state'], 'running')

    def test_cli_start_and_stop_use_same_ledger(self):
        command = [sys.executable, '-m', 'jiuwenswarm.ccv2']
        def cli(*arguments):
            result = subprocess.run(command + list(arguments) + ['--store', str(self.host.store)], capture_output=True, text=True, env={**os.environ, 'PYTHONPATH': str(Path(__file__).resolve().parents[2])})
            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
            return json.loads(result.stdout)
        session = Path(self.temp.name)/'session.json'
        session.write_text(json.dumps({'grants': ['process.exec', 'network.listen']}), encoding='utf-8')
        app = cli('start', self.release, 'api', '--session', str(session), '--trusted-local')
        self.started.append(app['id'])
        self.assertEqual(cli('instance', app['id'])['state'], 'running')
        self.assertEqual(cli('stop', app['id'])['state'], 'stopped')

    def test_replay_does_not_need_original_artifact(self):
        release = self.variant(lambda d: d['applications']['api'].update(takes={'config': 'artifact'}))
        source = Path(self.temp.name)/'config.json'; source.write_text('{}')
        artifact = self.host.put_artifact(source)
        app = self.host.start(release, 'api', {'config': artifact}, key='artifact-start')
        self.started.append(app['id'])
        self.host.artifact_path(artifact).unlink()
        self.assertEqual(self.host.start(release, 'api', {'config': artifact}, key='artifact-start')['id'], app['id'])
        self.assertEqual(self.host.lookup_instance('artifact-start')['id'], app['id'])

    def test_literal_input_is_not_launch_syntax(self):
        def change(d):
            app = d['applications']['api']; app.update(takes={'task': 'text'}, interfaces={}); app.pop('ready')
            d['bindings']['default']['command'] = ['{python}', '-c', 'import time; time.sleep(30)', '{input.task}']
        release = self.variant(change)
        task = 'Explain {input.NAME} and {port.api} literally'
        app = self.host.start(release, 'api', {'task': task})
        self.started.append(app['id'])
        self.assertEqual(app['state'], 'running', app)
        self.assertEqual(app['provenance']['command'][-1], task)

    def test_exited_launcher_does_not_confirm_children_stopped(self):
        import psutil
        def change(d):
            app = d['applications']['api']; app.update(interfaces={}); app.pop('ready')
            d['bindings']['default']['command'] = ['{python}', '-c', "import subprocess,sys,time; from pathlib import Path; p=subprocess.Popen([sys.executable,'-c','import time; time.sleep(30)']); Path('child.pid').write_text(str(p.pid)); time.sleep(.25)"]
        release = self.variant(change)
        app = self.host.start(release, 'api')
        pidfile = self.host.store/'instances'/app['id']/'child.pid'
        deadline = time.monotonic()+4
        while not pidfile.exists() and time.monotonic() < deadline: time.sleep(.03)
        child = psutil.Process(int(pidfile.read_text()))
        try:
            time.sleep(.4)
            with self.assertRaises(CCError) as error: self.host.stop(app['id'])
            self.assertEqual(error.exception.code, 'STOP_UNCONFIRMED')
            self.assertEqual(self.host.lookup_instance(app['key'])['state'], 'unknown')
            self.assertTrue(child.is_running())
        finally:
            child.kill(); child.wait(timeout=3)
            self.host.reconcile_instance(app['id'], stopped=True, note='Test operator terminated observed orphan child')


if __name__ == '__main__':
    unittest.main()

