{\n  5353\t                    d.failed = true;\n  5354\t                    d.fail = \"the expert cache could not fill a slot\";\n  5355\t                    d.fail_layer = d.layers;\n  5356\t                    d.fail_expert = e;\n  5357\t                    return;\n  5358\t                }\n  5359\t                d.src->note_async_read(b, cs);   // #1237: a page-locked stage buffer is not recycled under the queued copy\n  5360\t                ++d.cache_admitted;\n  5361\t                slot = cand;\n  5362\t            } else {\n  5363\t                ++d.cache_hits;\n  5364\t            }\n  5365\t            d.is_hit[(size_t) i] = 1;\n  5366\t            d.h_slot[(size_t) d.n_hits] = slot;\n  5367\t            d.h_dst[(size_t) d.n_hits] = (int32_t) i;\n  5368\t            ++d.n_hits;\n  5369\t        }\n  5370\t        d.decided = true;\n  5371\t        if (d.n_hits <= 0) return;   // nothing resident yet: no GPU work, and nothing for `Combine` to add\n  5372\t\n  5373\t        const size_t list_bytes = (size_t) d.n_hits * sizeof(int32_t);\n  5374\t        // `hit_out` is ZEROED rather than overwritten: the kernel writes only the rows this layer's hits own,\n  5375\t        // so a row that was a hit last layer and a miss this one would still hold last layer's expert and\n  5376\t        // `add_inplace` would sum it in.  Finite, plausible, wrong.\n  5377\t        if (cudaMemsetAsync(d.hit_out, 0, (size_t) d.parts_elems * sizeof(float), cs) != cudaSuccess ||\n  5378\t            cudaMemcpyAsync(d.d_slot, d.h_slot.data(), list_bytes, cudaMemcpyHostToDevice, cs) != cudaSuccess ||\n  5379\t            cudaMemcpyAsync(d.d_dst, d.h_dst.data(), list_bytes, cudaMemcpyHostToDevice, cs) != cudaSuccess) {\n  5380\t            d.hit_fail = \"the hit list could not be staged\";\n  5381\t            d.failed = true;\n  5382\t            d.fail = d.hit_fail;\n  5383\t            return;\n  5384\t        }\n  5385\t        // The activation is quantized HERE rather than