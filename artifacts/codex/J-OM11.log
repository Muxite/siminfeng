            const char * csv = getenv("LLAMA_EXPERT_FILL_DIAG_CSV");
            if (csv && *csv) {
                expert_diag_csv = fopen(csv, "w");
                if (!expert_diag_csv) { throw std::runtime_error("cannot open diagnostic CSV"); }
                fprintf(expert_diag_csv, "token_idx,fill_ns,between_ns,majflt_fill,majflt_between,post_fill_nonresident_pages,pre_use_nonresident_pages,bytes_read\n");
            }
        }
        const char * random = getenv("LLAMA_EXPERT_FILL_RANDOM");
        expert_fill_random_decode = random && strcmp(random, "decode") == 0;
        auto token_limit = [](const char * name) -> uint64_t {
            const char * value = getenv(name);
            if (!value || !*value || *value == '-') { return 0; }
            char * end = nullptr; errno = 0;
            const auto n = strtoull(value, &end, 10);
            return errno || *end ? 0 : n;
        };
        expert_fill_min_tokens = token_limit("LLAMA_EXPERT_FILL_MIN_TOKENS");
        expert_fill_max_tokens = token_limit("LLAMA_EXPERT_FILL_MAX_TOKENS");
        const auto & filler = *expert_fillers.begin()->second;
        LLAMA_LOG_INFO("expert_fill: active threads=%zu chunk_kib=%zu random=%s files=%zu\n",
            filler.threads(), filler.chunk_bytes() / 1024, expert_fill_random_decode ? "decode" : (random && strcmp(random, "1") == 0 ? "1" : "0"), expert_fillers.size());
    } catch (const std::exception & e) {
        expert_fill_enabled = false; expert_diag_enabled = false;
        if (expert_diag_csv) { fclose(expert_diag_csv); expert_diag_csv = nullptr; }
        expert_fillers.clear();
        LLAMA_LOG_INFO("expert_fill: inactive (%s)\n", e.what());
    }
