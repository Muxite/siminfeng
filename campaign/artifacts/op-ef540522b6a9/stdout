 // the slot map is a host weight, so the scheduler starts a new split here and copies it with the copy callback\n  2560\t    // the callback reads the selected experts, uploads the missing ones and updates the slot map\n  2561\t    ggml_tensor * slots = ggml_get_rows(ctx0, slot_map, ids); // [1, n_expert_used*n_tokens]\n  2562\t    if (!ggml_backend_supports_op(moe_cache->backend(il), slots)) {\n  2563\t        return nullptr;\n  2564\t    }\n  2565\t    ggml_backend_sched_set_tensor_backend(sched, slots, moe_cache->backend(il));\n  2566\t    cb(slots, \"ffn_moe_slots\", il);\n  2567\t\n  2568\t    // add the lookup now: the transform of a Hadamard-folded expert reads host weights and would start its split first\n  2569\t    ggml_build_forward_expand(gf, slots);\n  2570\t\n  2571\t    return ggml_reshape_2d(ctx0, slots, selected_experts->ne[0], selected_experts->ne[1]); // [n_expert_used, n_tokens]\n  2572\t}\n  2573\t\n  2574\t// input embeddings with optional lora\n  2575\tggml_tensor * llm_graph_context::build_inp_embd(ggml_tensor * tok_embd, float tok_scale) const {\n  2740\t        if (set_threadpool_fn) {\n  2741\t            set_threadpool_fn(backend_cpu, tp);\n  2742\t        }\n  2743\t    }\n  2744\t\n  2745\t    // set the number of threads for all the backends\n  2746\t    for (const auto & set_n_threads_fn : set_n_threads_fns) {\n  2747\t        set_n_threads_fn.second(set_n_threads_fn.first, n_threads);\n  2748\t    }\n  2749\t\n  2750\t    copy_experts.reset();\n  2751\t\n  2752\t    auto status = ggml_backend_sched_graph_compute_async(sched.get(), gf);\n  2753\t    if (status != GGML_STATUS_SUCCESS) {\n  2754\t        LLAMA_LOG_ERROR(\"%s: ggml_backend_sched_graph_compute_async failed with error %d\\n\", __func__, status);\n  2755\t    }\n  2756\t\n  2757\t    // fprintf(stderr, \"splits: %d\\n\", ggml_backend_sched_get_n_splits(sched));\n  2758\t\n  2759\t    return status;\n  2760\t}\n  2761\t\n  2762\tbool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, ggml_cgraph * graph, void * user_data) {\n  2763\t    auto * lctx = static_cast<llama_context *>(user_data);\n  2764\t\n  2765\t    // the slot maps of the MoE cache\n  2766\t    if (lctx->moe_cache && lctx->moe_cache->copy(backend, src, dst, graph)) {\n  2767\t        return true;\n  2768\t    }\n  2769\t\n  2770\t    auto & st = lctx->copy_experts;\n  2771\t\n  2772\t    // the ids must be computed before the split starts, so only the first node of the split is considered\n  2773\t    if (ggml_graph_n_nodes(graph) == 0) {\n  2774\t        return false;\n  2775\t    }\n  2776\t    const ggml_tensor * node = ggml_graph_node(graph, 0);\n  2777\t    if (node->op != GGML_OP_MUL_MAT_ID || node->src[0] != dst) {\n  2778\t        return false;\n  2779\t    }\n  2780\t\n  2781\t    const ggml_tensor * ids = node->src[2];\n  2782\t    if (ggml_nelements(ids) == 0) {\n  2783\t        return true;\n  2784\t    }\n  2785\t\n  2786\t    const int64_t n_expert    = src->ne[2];\n  2787\t    const size_t  expert_size = src->nb[2];\n  2788\t\n  2789\t    if (ids != st.ids || (int64_t) st.used.size() != n_expert) {\n  2790\t        st.ids_data.resize(ggml_nbytes(ids)/sizeof(int32_t));\n  2791\t        ggml_backend_tensor_get_async(backend, ids, st.ids_data.data(), 0, ggml_nbytes(ids));\n  2792\t        ggml_backend_synchronize(backend);\n  2793\t\n  2794\t        st.used.assign(n_expert, false);\n  2795\t        for (int64_t i1 = 0; i1 < ids->ne[1]; i1++) {\n  2796\t            for (int64_t i0 = 0; i0 < ids->ne[0]; i0++) {\n  2797\t                const int32_t id = st.ids_data[i1*ids->nb[1]/sizeof(int32_t) + i0*ids->nb[0]/sizeof(int32_t)];\n  2798\t                GGML_ASSERT(id >= 0 && id < n_expert);\n  2799\t                st.used[id] = true;\n  2800\t            }\n  2801\t        }\n  2802\t\n  2803\t        st.ids = ids;\n  2804\t    }\n  2805\t\n  2806\t    // group consecutive experts and copy them together\n  2807\t    for (int64_t first = 0; first < n_expert; ) {\n  2808\t        if (!st.used[first]) {\n  2809\t            first++;\n  2810\t            continue;\n  2811\t        }\n  2812\t        int64_t last = first;\n  2813\t        while (last + 1 < n_expert && st.used[last + 1]) {\n  2814\t            last++;\n  2815\t        }\n  2816\t\n  2817\t        // the experts in the MoE cache are copied from device memory, the others are uploaded\n  2818\t        int64_t next = first;\n  2819\t        for (int64_t e = first; e <= last && lctx->moe_cache; ) {\n  2820\t            const int64_t n = lctx->moe_cache->copy_experts(backend, src, dst, e, last);\n  2821\t            if (n == 0) {\n  2822\t                e++;\n  2823\t                continue;\n  2824\t            }\n  2825\t            if (next < e) {\n  2826\t                ggml_backend_tensor_set_async(backend, dst, (const uint8_t *) src->data + next*expert_size, next*expert_size, (e - next)*expert_size);\n  2827\t            }\n  2828\t            e   += n;\n  2829\t            next = e;\n  2830\t        }\n  2831\t\n  2832\t        // copy a bit extra to ensure there are no NaNs in the padding of the last expert, this is necessary for MMQ in the CUDA backend\n  2833\t        const size_t offset  = next*expert_size;\n  2834\t        const size_t padding = last < n_expert - 1 ? std::min<size_t>(expert_size, 512) : 0;\n  2835\t        const size_t size    = (last + 1 - next)*expert_size + padding;\n  2836\t        if (size > 0) {\n  2837\t            ggml_backend_tensor_set_async(backend, dst, (const uint8_t *) src->data + offset, offset, size);\n  2838\t        }\n  2839\t\n  2840\t        first = last + 1;\n  2841\t    }\n  2842\t\n  2843\t    return true;\n  2844\t}\n  2845\t\n  2846\tllm_graph_cb llama_context::graph_get_cb() const {\n  2847\t    return [&](const llama_ubatch & ubatch, ggml_tensor * cur, const char * name, int il) {\n  2848\t        if (il >= 0) {\n  2849\t            ggml_format_name(cur, \"%s-%d\", name, il);\n  2850\t        } else {\n  2851\t            ggml_set_name(cur, name);\n  2852\t        }\n  2853\t\n  2854\t        // - norm may be automatically assigned to the backend of the previous layer, increasing data transfer between backends\n  2855\t        // - force the last op of the layer on the specified backend to avoid running it on the backend of the next layer due to scheduling\n  2856\t        // FIXME: fix in ggml_backend_sched\n  2857\t        const bool full_offload = model.n_gpu_layers() > model.hparams.n_layer_all;\n  2858\t        if (ubatch.n_tokens < 32 || full_offload) {\n  2859\t            if (il != -1 && (strcmp(name, \"norm\") == 0 || strcmp(name, \"l_last\") == 0)) {\n  2860\t                const auto & dev_layer = model.dev_layer(il);\n  2861\t                for (const auto & backend : backends) {\n  2862\t                    if (ggml_backend_get_device(backend.get()) == dev_layer) {\n  2863\t                        if (ggml_backend_supports_op(backend.get(), cur)) {\n  2864\t                            ggml_backend_sched_set_tensor_backend(sched.get(), cur, backend.get());\n  2865\t                        }\n  2866\t                    }\n  2867\t                }\n  2868\t            }\n  2869\t        }\n  2870\t    };\n  2871\t}\n  2872\t\n  2873\t//\n  2874\t// state save/load\n  2875\t//\n","exit_code":0,"status":"completed"}}
