+bool llama_model::is_mmap_range(const void * data, size_t size) const {
+    const uintptr_t start = reinterpret_cast<uintptr_t>(data);
+    for (const auto & mapping : pimpl->mappings) {
+        const uintptr_t base = reinterpret_cast<uintptr_t>(mapping->addr());
+        if (start >= base && start - base <= mapping->size() && size <= mapping->size() - (start - base)) {
+            return true;
+        }
+    }
+    return false;
+}
