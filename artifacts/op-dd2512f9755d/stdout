er trusts heartbeats\n  lab register JOB ATT              register result into index (idempotent; stale/conflicting rejected)\nStore: $LAB/{images,jobs,index}. Fault injection for recovery tests: LAB_FAULT=die_after_start|die_in_export\n\"\"\"\nimport json, sys, os, re, time, uuid, hashlib, fcntl, subprocess, argparse, shutil, datetime as dt, glob\nLAB = os.environ.get(\"LAB\", os.path.expanduser(\"~/projects/siminfeng/campaign/lab\"))\nCID = os.environ.get(\"CAMPAIGN_ID\", \"c1\")\nnow = lambda: dt.datetime.now(dt.timezone.utc).isoformat()\ndef jd(o): return json.dumps(o, sort_keys=True)\ndef sha(p):\n    h = hashlib.sha256()\n    with open(p, \"rb\") as f:\n        for b in iter(lambda: f.read(1 << 20), b\"\"): h.update(b)\n    return h.hexdigest()\ndef sha_s(s): return hashlib.sha256(s.encode()).hexdigest()\ndef sh(cmd, **kw): return subprocess.run(cmd, capture_output=True, text=True, **kw)\ndef append(path, rec):\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)\n    try: fcntl.flock(fd, fcntl.LOCK_EX); os.write(fd, (jd(rec) + \"\\n\").encode()); os.fsync(fd)\n    finally: os.close(fd)\ndef proc_start(pid):\n    try: return open(f\"/proc/{pid}/stat\").read().rsplit(\")\", 1)[1].split()[19]\n    except Exception: return None\ndef last_state(adir):\n    p = os.path.join(adir, \"state.jsonl\")\n    rows = [json.loads(l) for l in open(p)] if os.path.exists(p) else []\n    return rows[-1] if rows else None\n\n# ---- test definitions: how an image's tools are exercised and judged (the \"tests\" half of a lab) ----\ndef load_tests():\n    t = {}\n    import glob as g\n    for f in sorted(g.glob(os.path.join(LAB, \"tests\", \"*.json\"))): t.update(json.load(open(f)))\n    return t\nTESTS = load_tests()\ndef assess(test, out, err, rc):\n    txt = out + \"\\n\" + err\n    if TESTS[test].get(\"parser\") == \"ppl\":\n        m = re.search(r\"Final estimate: PPL = ([\\d.]+) \\+/- ([\\d.]+)\", txt)\n 