    c = verdict['comparisons']['pg']
    assert c['ratio'] == base['eval_ms_per_token'] / pg['eval_ms_per_token']
    assert c['verdict'] == 'improved'
    reversed_gate = gate.evaluate({'base': [pg, pg], 'pg': [base, base]}, 'eval_ms_per_token')
    assert reversed_gate['comparisons']['pg']['verdict'] == 'regressed'


def test_real_regate_dry_recomputes_without_writes(tmp_path):
    from cc.abrun import regate
    source = ROOT / 'experiments/jetson/OM/J-OM10c'
    original = {p: hashlib.sha256(p.read_bytes()).digest() for p in source.rglob('*') if p.is_file()}
    result = subprocess.run([sys.executable, regate.__file__, str(source), '--dry'],
                            capture_output=True, text=True, check=True)
    assert 'ms/token' in result.stdout and '| base | 840.975 |' in result.stdout
    assert '| pg8i8 | 720.34 |' in result.stdout
    verdict = regate.recompute(source, metric='eval_ms_per_token')
    assert verdict['direction'] == 'lower'
    assert verdict['inputs']['pg8i8'][0] == 716.54
    assert all(c['verdict'] == 'improved' for c in verdict['comparisons'].values())
    assert original == {p: hashlib.sha256(p.read_bytes()).digest() for p in source.rglob('*') if p.is_file()}
    # A spec without a primary metric selects the new precise default.
    spec_data = json.loads((source / 'spec.json').read_text())
    spec_data.pop('metric')
    (tmp_path / 'spec.json').write_text(json.dumps(spec_data))
    shutil.copytree(CAPTURED, tmp_path / '001-pg8i8')
    summary = run_summary.summarize(tmp_path / '001-pg8i8')
    verdict = regate.recompute(tmp_path)
    assert verdict['metric'] == 'eval_ms_per_token'
"""Thread capture spec, preflight, summary and shell integration without Docker."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys

import pytest
from cc.abrun import abrun, gate, run_summary
from cc.thread_sampler.test_thread_sampler import write_capture

ROOT = Path(__file__).resolve().parents[3]


def spec():
    return json.loads((ROOT / 'cc/abrun/specs/J-OM12.json').read_text())


def test_om12_plan(monkeypatch):
    monkeypatch.delenv('ABRUN_RUNNER', raising=False)
    s = spec()
    abrun.validate(s)
    _, runs = abrun.plan(s)
    assert [r['arm'] for r in runs] == ['base', 'pg8', 'pg8t4', 'pg8t6', 'pg8t6', 'pg8t4', 'pg8', 'base']
    for run in runs:
        assert 'OM_THREADS=1' in run['command']
        if run['arm'] in ('pg8t4', 'pg8t6'):
            assert run['command'][-2:] == ['-t', run['arm'][-1]]
        else:
            assert '-t' not in run['command']
    s.pop('threads')
    assert all('OM_THREADS=1' not in r['command'] for r in abrun.plan(s)[1])
    assert s['arms']['base']['env'] == {}


@pytest.mark.parametrize('field,value', [('threads', 1), ('threads', 'yes'), ('extra_argv', '-t 4'), ('extra_argv', [4])])
def test_validation(field, value):
    s = spec()
    (s if field == 'threads' else s['arms']['pg8'])[field] = value
    with pytest.raises(ValueError, match=field):
        abrun.validate(s)


def test_extra_argv_preflight(tmp_path, monkeypatch):
    s = spec()
    calls = []
    def check(image, tool, argv):
        calls.append(argv)
        if '-t' in argv:
            raise ValueError('unsupported flags: -t')
    monkeypatch.setattr(abrun.preflight, 'check', check)
    assert abrun.execute(s, tmp_path / 'run', []) == 1
    assert any(a[-2:] == ['-t', '4'] for a in calls)
    v = json.loads((tmp_path / 'run/verdict.json').read_text())
    assert 'unsupported flags: -t' in v['invalid_reasons']


def test_summary_secondary(tmp_path):
    write_capture(tmp_path / 'threads.jsonl')
    (tmp_path / 'stderr.txt').write_text('eval time = 1500 ms / 2 runs (750 ms per token, 1.3 tokens per second)\n')
    s = run_summary.summarize(tmp_path)
    assert s['threads.cpu_workers_r_fraction'] == 1
    assert s['threads.main_workers_d_fraction'] == .25
    assert s['threads.majflt_per_token'] == 4.5
    v = gate.evaluate({'base': [s], 'pg8': [s]}, 'eval_ms_per_token')
    assert v['secondary_metrics']['base']['threads.majflt_per_token'] == 4.5
    assert 'Threads majflt/token' in gate.secondary_table(v)
    assert json.loads((tmp_path / 'threads.summary.json').read_text())['phase_window']['tokens'] == 2


def test_om_run_commands_unchanged(tmp_path):
    # Stub executables only; never invoke Docker, resource observers, or a GPU.
    bindir = tmp_path / 'bin'
    bindir.mkdir()
    docker = bindir / 'docker'
    docker.write_text(f'''#!{sys.executable}
import json,os,sys,time
args=sys.argv[1:]
with open(os.environ['DOCKER_LOG'],'a') as f:f.write(json.dumps(args)+'\\n')
if args[0]=='run': print('fake-container')
elif args[0]=='wait': time.sleep(.2); print('0')
elif args[0]=='inspect': print(os.getppid() if '-f' in args else 'false')
elif args[0]=='logs': print('eval time = 100 ms / 2 runs',file=sys.stderr)
''')
    docker.chmod(0o755)
    python = bindir / 'python3'
    python.write_text(f'''#!{sys.executable}
import os,sys,time
if len(sys.argv)>1 and sys.argv[1].endswith('resource_observe.py'):
    if '--out' in sys.argv:open(sys.argv[sys.argv.index('--out')+1],'w').close()
    time.sleep(60)
elif len(sys.argv)>1 and sys.argv[1].endswith('thread_sampler.py'):
    # The real sampler itself is covered by local busy-process tests. No proc
    # namespace/container dependency belongs in this shell command comparison.
    if '--out' in sys.argv:open(sys.argv[sys.argv.index('--out')+1],'w').close()
else:os.execv({sys.executable!r},[{sys.executable!r}]+sys.argv[1:])
''')
    python.chmod(0o755)
    original = subprocess.check_output(['git', 'show', 'HEAD:./cc/om_run/om_run.sh'], cwd=ROOT, text=True)
    baseline = tmp_path / 'original.sh'
    baseline.write_text(original)
    commands = []
    for script, threads in [(baseline, None), (ROOT / 'cc/om_run/om_run.sh', None), (ROOT / 'cc/om_run/om_run.sh', '1')]:
        idx = len(commands)
        out = tmp_path / f'out{idx}'
        log = tmp_path / f'docker{idx}.jsonl'
        env = dict(os.environ, PATH=str(bindir) + ':' + os.environ['PATH'], DOCKER_LOG=str(log))
        env.pop('DOCKER_CMD_PREFIX', None)
        env.pop('OM_THREADS', None)
        if threads:
            env['OM_THREADS'] = threads
        subprocess.run(['bash', str(script), str(out), 'test-image', '-e TEST=1', 'llama-completion', '-t', '4'], env=env, check=True, capture_output=True, timeout=10)
        rows = [json.loads(line) for line in log.read_text().splitlines()]
        run = next(row for row in rows if row[0] == 'run')
        commands.append([re.sub(r'om-\d+-\d+', 'CONTAINER', arg) for arg in run])
        assert (out / 'threads.jsonl').exists() == bool(threads)
    assert commands[0] == commands[1] == commands[2]
# Inference-engine experiment methods — jetson-arm

Read with CLOSEOUT.md (all, especially §§5–6), `c2/PLAN.md`, and the cited
Jetson D-notes. Qualification below distinguishes protocol tests, compilation,
live execution and scored engine evidence; one does not imply the others.

## Lab map

- **jetson-arm = satay**: Orin Nano 8GB Super, sm_87, six Cortex-A78AE cores,
  7.4 GiB shared DRAM, L4T 36.5.2 / JetPack 6.2.3 / CUDA 12.6.68.
  CPU, GPU and page cache compete for the same physical memory (UMA).
  NVML memory is N/A; declare memory domain `shared-dram`, not VRAM.
- GPU devfreq is unpinned, nvhost_podgov 306–1020 MHz. Keep power/clocks
  unchanged; warm up, counterbalance, measure A/A and retain frequency samples.
- Six zram devices total about 3.8 GiB swap. Swap bursts can be benign;
  monitor available DRAM and cumulative swap as well as swap rate.
- X15 Lite SSD 128GB, PCIe Gen3 x4: about 536–573 MiB/s at large queued reads,
  only 19.6 MiB/s at random 4 KiB qd1. Access granularity matters (D031/D033).
- Native builds and engine runs execute here with target `jetson-orin`.
  **x86-main** is the separate discrete RTX 5070 Ti / sm_120 lane; default Build
  CC target `x86-5070ti` belongs there. No SSH transport between lanes;
  operator-managed git branches exchange recipes/evidence. Do not pool t/s.
- Sources: ref/llama.cpp @ 31288c9c66e59377f7788d920678a565bb89dd37;
  ref/llama.cpp-up1108 @ cf34d311332e362198f0a410c466d1e940287d02.
  Keep reference trees read-only; patch staged snapshots or separate copies.
- Models: ~/models/campaign/gguf (Granite), ~/models/campaign/qwen36-35b-a3b
  (22,360,456,160-byte Qwen), data and kl subdirectories for corpus/base logits.
  CLOSEOUT §§1.4/1.6 contain hashes/download revisions; some hashes remain missing.
- Raw engine results: `experiments/jetson/`; build records/archives:
  `cc/build_engine/results/`; operation logs: artifacts/op-* and
  evidence/jetson-arm/*.jsonl; lab attempts: lab/jobs; queue state: lab/jobq.
  Worker logs/finals: artifacts/codex; work ledger: `c2/worklog.jsonl`.
  Models, Docker images, ccache and build trees are local-only, not a remote backup.

## Tool catalog

Qualification is evidence already recorded, not a fresh run of the tool.
All top-level bin tools and cc capabilities are included; helpers/tests/patches
belong to their capability row. UNTESTED means no qualified Jetson engine result.

