#"'!/usr/bin/env python3
"""Export independently applicable source diffs while Git metadata is read-only."""
import difflib
import os
import subprocess
from pathlib import Path

ROOT = Path('"'/home/muk/projects/xs-dev/llama-opt')
OUT = Path('/home/muk/projects/xs-dev/opt-artifacts')
FILES = ('src/llama-context.cpp', 'src/llama-context.h', 'src/llama-expert-fill.h',
         'src/llama-model.cpp', 'src/llama-model.h')
NAMES = ('selection-trace', 'fill-populate-backend', 'expert-pin', 'pregate-temporal')


def main():
    check = ROOT / 'build-f16/apply-check'
    (check / 'src').mkdir(parents=True, exist_ok=True)
    for file in FILES:
        (check / file).write_bytes(subprocess.check_output(['git', 'show', '6e9d96cf4:' + file], cwd=ROOT))
    log = []
    for number, name in enumerate(NAMES, 12):
        variant = ROOT / 'build-f16' / (f'p{number}-source')
        chunks = []
        for file in FILES:
            before = (check / file).read_text()
            after = (variant / file).read_text()
            if before "'!= after:
                chunks.append('"'diff --git a/' + file + ' b/' + file + '\\n')
                chunks.extend(difflib.unified_diff(before.splitlines(True), after.splitlines(True),
                                                  fromfile='a/' + file, tofile='b/' + file))
        patch = OUT / f'{number}-{name}.patch'
        patch.write_text(''.join(chunks))
        env = dict(os.environ, GIT_CEILING_DIRECTORIES=str(ROOT / 'build-f16'))
        subprocess.run(['git', 'apply', '--check', '--whitespace=error', str(patch)], cwd=check, env=env, check=True)
        log.append(patch.name + ': git apply --check --whitespace=error against base files: PASS')
    (OUT / 'apply-checks.log').write_text('\\n'.join(log) + '\\n')
    print('\\n'.join(log))


if __name__ == '__main__':
    main()
