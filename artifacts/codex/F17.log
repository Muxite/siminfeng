+        rc = int(phase == 'start' and protocol != 'carryover')
+        print(f'page_cache {phase}: {exc}', file=sys.stderr)
+    (Path(out) / f'page_cache.{phase}.json').write_text(json.dumps(result, indent=2) + '\n')
