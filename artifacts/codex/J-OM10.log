            if (!sched->callback_cpu || ggml_backend_dev_type(ggml_backend_get_device(split_backend)) != GGML_BACKEND_DEVICE_TYPE_CPU) {
                return ggml_backend_graph_compute_async(split_backend, graph);
            }
            int first = 0;
            for (int i = 0; i < graph->n_nodes; ++i) {
                bool observe = false;
                sched->callback_cpu(graph->nodes[i], true, &observe, sched->callback_cpu_user_data);
                if (!observe) {
                    continue;
                }
                if (first < i) {
                    ggml_cgraph prefix = ggml_graph_view(graph, first, i);
                    ggml_status ec = ggml_backend_graph_compute_async(split_backend, &prefix);
                    if (ec != GGML_STATUS_SUCCESS) {
                        return ec;
                    }
                }
                ggml_backend_synchronize(split_backend);
                sched->callback_cpu(graph->nodes[i], false, &observe, sched->callback_cpu_user_data);
                first = i;
            }
            ggml_cgraph tail = ggml_graph_view(graph, first, graph->n_nodes);
            return ggml_backend_graph_compute_async(split_backend, &tail);
        };

