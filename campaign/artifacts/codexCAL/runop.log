ater than model context_length')\n    ctx = int(ctx)\n    if type(top) is not int or top < 1:\n        raise ValueError('top must be a positive integer')\n    finite(prompt_tokens, 'prompt_tokens', positive=True)\n    if int(prompt_tokens) != prompt_tokens or prompt_tokens >= ctx:\n        raise ValueError('prompt_tokens must be integral and less than ctx')\n    prompt_tokens = int(prompt_tokens)\n    objective = budget.get('objective', 'decode')\n    if objective not in ('decode', 'ttft', 'balanced'):\n        raise ValueError('objective must be decode, ttft, or balanced')\n    finite(budget.get('max_ppl_change', .01), 'max_ppl_change')\n    max_kld = budget.get('max_quality_loss')\n    if max_kld is not None:\n        finite(max_kld, 'max_quality_loss')\n    gb = finite(budget['gpu_mib'], 'gpu_mib', positive=True)\n    hb = finite(budget.get('host_mib', host['ram_bytes']/MIB), 'host_mib', positive=True)\nartifacts/codexPL4/cpu-screen/04-pap24_q2.stdout\nartifacts/codexPL4/cpu-screen/00-granite-3.stdout\nartifacts/codexPL4/cpu-screen/06-pap24_q3_noimat.stdout\nartifacts/codexPL4/cpu-screen/02-granite-3.stdout\nartifacts/codexPL4/cpu-screen/03-granite-3.stdout\nartifacts/codexPL4/cpu-screen/01-granite-3.stdout\nartifacts/codexPL4/cpu-screen/05-pap24_q3.stdout\nartifacts/codexPL4/tree/benches/dgx-spark/aime25_openai__gpt-oss-120b-high_temp1.0_20251109_094547_allresults.json\nartifacts/codexPL4/tree/benches/dgx-spark/aime25_openai__gpt-oss-120b-high_temp1.0_20251109_094547.json\nartifacts/codexH/verification-tree/benches/dgx-spark/aime25_openai__gpt-oss-120b-high_temp1.0_20251109_094547_allresults.json\nartifacts/codexH/verification-tree/benches/dgx-spark/aime25_openai__gpt-oss-120b-high_temp1.0_20251109_094547.json\nartifacts/codexF/verification-tree/benches/dgx-spark/aime25_openai__gpt-oss-120b-high_temp1.0_20251109_094547_allresults.json\nartifacts/codexF/verification-tree/benches/dgx-spark/aime25_openai__gpt-oss-120b-high_temp1.0_20251109_094547.json\nartifacts/co