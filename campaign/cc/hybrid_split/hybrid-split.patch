+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+static ggml_context * context() {
+    ggml_init_params p = {ggml_tensor_overhead() * 512 + ggml_graph_overhead_custom(512, false), nullptr, true};
+    auto * ctx = ggml_init(p);
+    require(ctx, "context allocation");
+    return ctx;
+}
+
+// Run cold MUL_MAT_ID on CPU and hot/null slots on the requested backend.
+// All numerical expectations come from scalar dequantized dot products.
+static void test(ggml_backend_t hot_backend, ggml_backend_t cpu, ggml_type type, int nt, bool broadcast) {
+    const int k = 256, m = 32, used = 8;
+    auto * hc = context();
+    auto * cc = context();
+    auto * gc = context();
+    auto * ah = ggml_new_tensor_3d(hc, type, k, m, 3);
+    auto * ac = ggml_new_tensor_3d(cc, type, k, m, 2);
+    auto * mh = ggml_new_tensor_2d(hc, GGML_TYPE_I32, 1, 4);
+    auto * mc = ggml_new_tensor_2d(hc, GGML_TYPE_I32, 1, 4);
+    auto * order = ggml_new_tensor_1d(hc, GGML_TYPE_I32, 4);
+    auto * logits = ggml_new_tensor_2d(hc, GGML_TYPE_F32, 4, nt);
+    auto * ids = ggml_new_tensor_2d(hc, GGML_TYPE_I32, used, nt);
+    auto * x = ggml_new_tensor_3d(hc, GGML_TYPE_F32, k, broadcast ? 1 : used, nt);
+    ggml_set_name(ah, "weight.hot");
+    ggml_set_name(ac, "weight.cold");
+    ggml_set_name(ids, "router_ids");
+    ggml_set_name(x, "input");
+    auto hb = ggml_backend_alloc_ctx_tensors(hc, hot_backend);
+    auto cb = ggml_backend_alloc_ctx_tensors(cc, cpu);
+    require(hb && cb, "weight allocation");
+    ggml_backend_buffer_set_usage(hb, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    ggml_backend_buffer_set_usage(cb, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    const size_t stride = ggml_row_size(type, k) * m;
+    std::vector<uint8_t> packed(4 * stride), hot(3 * stride, 0);
+    std::vector<float> weights(4 * k * m), dequant(weights.size());
+    for (int e = 0; e < 4; ++e) {
+        for (int j = 0; j < k * m; ++j) {
+            weights[e * k * m + j] = (e + 1) * ((j % 7) - 3) * 0.125f;
+        }
+    }
+    if (type == GGML_TYPE_F32) {
+        std::memcpy(packed.data(), weights.data(), packed.size());
+        dequant = weights;
+    } else {
+        require(ggml_quantize_chunk(type, weights.data(), packed.data(), 0, 4 * m, k, nullptr) == packed.size(), "quantize");
+        for (int row = 0; row < 4 * m; ++row) {
+            ggml_get_type_traits(type)->to_float(packed.data() + row * ggml_row_size(type, k), dequant.data() + row * k, k);
+        }
+    }
+    // new -> original permutation [2,0,3,1]
+    std::memcpy(hot.data(), packed.data() + 2 * stride, stride);
+    std::memcpy(hot.data() + stride, packed.data(), stride);
+    std::vector<uint8_t> cold_weights(2 * stride);
+    std::memcpy(cold_weights.data(), packed.data() + 3 * stride, stride);
+    std::memcpy(cold_weights.data() + stride, packed.data() + stride, stride);
+    ggml_backend_tensor_set(ah, hot.data(), 0, hot.size());
+    ggml_backend_tensor_set(ac, cold_weights.data(), 0, cold_weights.size());
+    int32_t hot_map[] = {1, 2, 0, 2};
+    int32_t cold_map[] = {-1, 1, -7, 0};
+    int32_t inverse[] = {1, 3, 0, 2};
+    int perm[] = {2, 0, 3, 1};
+    std::vector<float> permuted_logits(4 * nt);
+    for (int t = 0; t < nt; ++t) {
+        for (int e = 0; e < 4; ++e) { permuted_logits[t * 4 + e] = t * 10 + perm[e]; }
+    }
+    ggml_backend_tensor_set(order, inverse, 0, sizeof(inverse));
+    ggml_backend_tensor_set(logits, permuted_logits.data(), 0, permuted_logits.size() * sizeof(float));
+    ggml_backend_tensor_set(mh, hot_map, 0, sizeof(hot_map));
+    ggml_backend_tensor_set(mc, cold_map, 0, sizeof(cold_map));
+    std::vector<float> input(ggml_nelements(x));
+    for (size_t i = 0; i < input.size(); ++i) { input[i] = 1.0f + (i / k % 2) * .5f; }
+    ggml_backend_tensor_set(x, input.data(), 0, input.size() * sizeof(float));
+    auto * rows = ggml_cont(gc, ggml_transpose(gc, logits));
+    auto * restored = ggml_cont(gc, ggml_transpose(gc, ggml_get_rows(gc, rows, order)));
+    ggml_set_output(restored);
+    auto * flat = ggml_reshape_1d(gc, ids, used * nt);
+    auto * ih = ggml_reshape_2d(gc, ggml_get_rows(gc, mh, flat), used, nt);
+    auto * ic = ggml_reshape_2d(gc, ggml_get_rows(gc, mc, flat), used, nt);
+    auto * cold = ggml_mul_mat_id(gc, ac, x, ic);
+    ggml_set_name(cold, "cold_skipped");
+    ggml_set_output(cold);
+    ggml_tensor * hot_result = nullptr;
+    std::vector<ggml_tensor *> hot_ops;
+    for (int slot = 0; slot < used; ++slot) {
+        auto * id = ggml_view_2d(gc, ih, 1, nt, ih->nb[1], slot * ih->nb[0]);
+        auto * src = broadcast ? x : ggml_view_3d(gc, x, k, 1, nt, x->nb[1], x->nb[2], slot * x->nb[1]);
+        auto * one = ggml_mul_mat_id(gc, ah, src, id);
+        hot_ops.push_back(one);
+        hot_result = hot_result ? ggml_concat(gc, hot_result, one, 1) : one;
+    }
+    auto * out = ggml_add(gc, hot_result, cold);
+    ggml_set_output(out);
+    auto * graph = ggml_new_graph_custom(gc, 512, false);
+    ggml_build_forward_expand(graph, restored);
+    ggml_build_forward_expand(graph, out);
+    ggml_backend_t backends[] = {hot_backend, cpu};
+    auto sched = ggml_backend_sched_new(backends, nullptr, hot_backend == cpu ? 1 : 2, 512, false, false);
+    require(sched, "scheduler allocation");
+    require(ggml_backend_sched_alloc_graph(sched, graph), "graph allocation");
+    require(ggml_backend_sched_get_tensor_backend(sched, cold) == cpu, "cold op must stay on CPU");
+    for (auto * op : hot_ops) {
+        require(ggml_backend_sched_get_tensor_backend(sched, op) == hot_backend, "hot op must use requested backend");
+    }
+    std::vector<int32_t> route(used * nt);
+    std::vector<float> result(m * used * nt), cold_result(result.size());
+    for (int mode = 0; mode < 3; ++mode) {
+        for (int t = 0; t < nt; ++t) {
+            for (int slot = 0; slot < used; ++slot) {
+                // mixed, all cold (every hot ID is the same null), all hot (all cold IDs skipped)
+                route[t * used + slot] = mode == 0 ? (slot + t) % 4 : mode == 1 ? 1 + 2 * (slot % 2) : 2 * (slot % 2);
+            }
+        }
+        ggml_backend_tensor_set(ids, route.data(), 0, route.size() * sizeof(int32_t));
+        std::vector<float> poison(result.size(), std::numeric_limits<float>::quiet_NaN());
+        ggml_backend_tensor_set(cold, poison.data(), 0, poison.size() * sizeof(float));
+        require(ggml_backend_sched_graph_compute(sched, graph) == GGML_STATUS_SUCCESS, "graph computation");
+        std::vector<float> restored_logits(4 * nt);
+        ggml_backend_tensor_get(restored, restored_logits.data(), 0, restored_logits.size() * sizeof(float));
+        for (int t = 0; t < nt; ++t) {
+            for (int e = 0; e < 4; ++e) { require(restored_logits[t * 4 + e] == t * 10 + e, "router order mismatch"); }
+        }
+        ggml_backend_tensor_get(out, result.data(), 0, result.size() * sizeof(float));
+        ggml_backend_tensor_get(cold, cold_result.data(), 0, cold_result.size() * sizeof(float));
+        for (int t = 0; t < nt; ++t) {
+            for (int slot = 0; slot < used; ++slot) {
+                int e = route[t * used + slot];
+                int col = (t * (broadcast ? 1 : used) + (broadcast ? 0 : slot)) * k;
+                for (int row = 0; row < m; ++row) {
+                    float expected = 0;
+                    for (int i = 0; i < k; ++i) { expected += dequant[(e * m + row) * k + i] * input[col + i]; }
+                    int idx = (t * used + slot) * m + row;
+                    require(std::isfinite(result[idx]) && std::abs(result[idx] - expected) < .002f * (1 + std::abs(expected)), "split scalar reference mismatch");
+                    if (cold_map[e] < 0) {
+                        require(cold_result[idx] == 0.0f, "skipped output must be exact zero after buffer reuse");
+                    } else {
+                        require(std::isfinite(cold_result[idx]) && std::abs(cold_result[idx] - expected) < .002f * (1 + std::abs(expected)), "cold scalar reference mismatch");
+                    }
+                }
+            }
+        }
+    }
+    std::printf("PASS type=%s tokens=%d broadcast=%d hot=%s cold=CPU modes=mixed,all-cold,all-hot reuse=NaN-poison\n", ggml_type_name(type), nt, broadcast, ggml_backend_name(hot_backend));
+    ggml_backend_sched_free(sched);
+    ggml_backend_buffer_free(hb);
+    ggml_backend_buffer_free(cb);
+    ggml_free(gc);
+    ggml_free(hc);
+    ggml_free(cc);
+}
+
+int main(int argc, char ** argv) {
+    const char * name = "CPU";
+    if (argc == 3 && std::strcmp(argv[1], "--backend") == 0) { name = argv[2]; }
+    else if (argc != 1) { std::fprintf(stderr, "usage: test-hybrid-split [--backend CPU|CUDA0]\n"); return 2; }
+    ggml_backend_load_all();
+    auto * cpu = ggml_backend_init_by_name("CPU", nullptr);
+    auto * hot = std::strcmp(name, "CPU") == 0 ? cpu : ggml_backend_init_by_name(name, nullptr);
+    if (!cpu || !hot) { std::fprintf(stderr, "requested backend unavailable: %s\n", name); return 2; }
+    ggml_backend_cpu_set_n_threads(cpu, 4);
+    try {
+        for (auto type : {GGML_TYPE_F32, GGML_TYPE_Q4_K}) {
+            for (int nt : {1, 17}) {
+                for (bool broadcast : {true, false}) { test(hot, cpu, type, nt, broadcast); }
+            }
+        }
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "FAIL: %s\n", e.what());
+        return 1;
+    }
+    if (hot != cpu) { ggml_backend_free(hot); }
+    ggml_backend_free(cpu);
+    return 0;
+}
