+void llama_context::expert_trace_flush() {
+    if (!expert_trace_file) { return; }
+    for (const auto & r : expert_trace_buffer) {
+        fprintf(expert_trace_file, "%llu,%llu,%zu,%s,", (unsigned long long)expert_trace_run,
+            (unsigned long long)r.token, r.layer, r.decode ? "decode" : "prompt");
+        for (size_t i = 0; i < r.selected.size(); ++i) { fprintf(expert_trace_file, "%s%d", i ? " " : "", r.selected[i]); }
+        fputc(',', expert_trace_file);
+        for (size_t i = 0; i < r.predicted.size(); ++i) { fprintf(expert_trace_file, "%s%d", i ? " " : "", r.predicted[i]); }
+        fputc('\n', expert_trace_file);
+    }
+    expert_trace_records += expert_trace_buffer.size();
+    expert_trace_buffer.clear();
+    if (fflush(expert_trace_file) || ferror(expert_trace_file)) {
+        LLAMA_LOG_ERROR("expert_trace: write failed path=%s\n", expert_config.trace.c_str());
+        fclose(expert_trace_file); expert_trace_file = nullptr;
+    }
+}
+
+void llama_context::expert_trace_begin(const llama_ubatch & ubatch) {
+    const uint32_t n_tokens = ubatch.n_tokens;
+    if (expert_config.trace.empty()) { return; }
+    if (!expert_trace_checked) {
+        expert_trace_checked = true;
+        expert_trace_file = fopen(expert_config.trace.c_str(), "a+");
+        if (!expert_trace_file) {
+            LLAMA_LOG_ERROR("expert_trace: cannot open path=%s\n", expert_config.trace.c_str());
+            return;
+        }
+        fseek(expert_trace_file, 0, SEEK_END);
+        if (ftell(expert_trace_file) == 0) { fputs("run,token_idx,layer,phase,selected,predicted\n", expert_trace_file); }
+        expert_trace_run = std::chrono::steady_clock::now().time_since_epoch().count();
+        expert_prefetch_layers.resize(model.layers.size());
+    }
+    if (!expert_trace_file) { return; }
+    // Flush between graphs, never once per layer.
+    if (expert_trace_token / 128 != (expert_trace_token + n_tokens) / 128) { expert_trace_flush(); }
+    expert_trace_ubatch_tokens = n_tokens;
+    expert_trace_output_tokens.clear();
+    for (uint32_t i = 0; i < n_tokens; ++i) {
+        if (ubatch.output && ubatch.output[i]) { expert_trace_output_tokens.push_back(expert_trace_token + i); }
+    }
+    expert_trace_token += n_tokens;
+}
+
+void llama_context::expert_trace_selected(size_t il, const ggml_tensor * ids) {
+    if (!expert_trace_file) { return; }
+    const bool full = ids->ne[1] == expert_trace_ubatch_tokens;
+    if (!full && size_t(ids->ne[1]) != expert_trace_output_tokens.size()) {
+        if (!expert_trace_warned) { LLAMA_LOG_ERROR("expert_trace: unsupported token subset (once)\n"); expert_trace_warned = true; }
+        return;
+    }
+    for (int64_t token = 0; token < ids->ne[1]; ++token) {
+        const uint64_t index = full ? expert_trace_token - expert_trace_ubatch_tokens + uint64_t(token) : expert_trace_output_tokens[token];
+        expert_trace_record r {index, il, expert_fill_decode, {}, {}};
+        for (int64_t k = 0; k < ids->ne[0]; ++k) {
+            int32_t id;
+            memcpy(&id, static_cast<const char *>(ids->data) + token * ids->nb[1] + k * ids->nb[0], sizeof(id));
+            r.selected.push_back(id);
+        }
+        if (expert_pregate_enabled && il < expert_pregate_layers.size()) {
+            for (const auto & prediction : expert_pregate_layers[il].predictions[0]) { r.predicted.push_back(prediction.id); }
+        }
+        expert_trace_buffer.push_back(std::move(r));
+    }
+}
