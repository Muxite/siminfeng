                            for direct in ([False] if engine == 'python' else [False, True]):
                                cell = dict(pattern=pattern, engine=engine, direct=direct,
                                            request_bytes=size, concurrency=concurrency)
                                cells.append(cell)
                                if (engine, direct) in unsupported:
