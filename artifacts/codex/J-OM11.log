void llama_context::expert_fill_init() {
    if (expert_fill_checked) { return; }
    expert_fill_checked = true;
    const char * fill = getenv("LLAMA_EXPERT_FILL");
    if (!fill || strcmp(fill, "1") != 0) { return; }
    try {
        for (const auto & layer : model.layers) {
            for (const ggml_tensor * w : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
                if (!w) { continue; }
                llama_model::expert_file_range info;
                if (w->ne[2] <= 0 || w->ne[3] != 1 || !ggml_is_contiguous(w) || !w->nb[2] ||
                        !model.expert_file_info(w, info)) {
                    throw std::runtime_error("expert tensors not mmap-backed or file offsets unavailable/unsupported layout");
                }
                if (!expert_fillers.count(info.file_index)) {
                    expert_fillers.emplace(info.file_index, std::make_unique<ExpertFiller>(
                        "/proc/self/fd/" + std::to_string(info.source_fd), info.mapping, info.mapping_size));
                }
            }
        }
        if (expert_fillers.empty()) { throw std::runtime_error("no mmap-backed expert tensors"); }
        expert_prefetch_layers.resize(model.layers.size());
        expert_fill_enabled = true;
        expert_pregate_init();
        expert_diag_enabled = expert_fillers.begin()->second->diagnostic();
