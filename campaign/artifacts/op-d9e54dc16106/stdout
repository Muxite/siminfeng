int trial = 0; trial < 400; ++trial) {\n    28\t        // per slot: a reply tail of 0..40 tokens\n    29\t        std::vector<std::vector<int32_t>> tail(kSlots);\n    30\t        std::vector<const int32_t*> tails(kSlots, nullptr);\n    31\t        std::vector<int64_t> n_tails(kSlots, 0);\n    32\t        for (int b = 0; b < kSlots; ++b) {\n    33\t            const int n = (int) (rng() % 41);\n    34\t            for (int i = 0; i < n; ++i) tail[b].push_back((int32_t) (rng() % 500));\n    35\t            tails[b] = tail[b].empty() ? nullptr : tail[b].data();\n    36\t            n_tails[b] = (int64_t) tail[b].size();\n    37\t        }\n    38\t        // a window: 1..8 rows; each slot at most once, or as a contiguous group of 1..3 rows (MTP drafts)\n    39\t        std::vector<int> rows; std::vector<int32_t> toks;\n    40\t        std::vector<int> order = {0, 1, 2, 3, 4, 5};\n    41\t        std::shuffle(order.begin(), order.end(), rng);\n    42\t        for (int b : order) {\n    43\t            if (rows.size() >= 8) break;\n    44\t            if (rng() % 3 == 0) continue;\n    45\t            const int g = 1 + (int) (rng() % 3);\n    46\t            for (int j = 0; j < g && rows.size() < 8; ++j) { rows.push_back(b); toks.push_back((int32_t) (rng() % 500)); }\n    47\t        }\n    48\t        if (rows.empty()) { rows.push_back(2); toks.push_back(9); }\n    49\t        const int S = (int) rows.size();\n    50\t        std::vector<int32_t> out((size_t) S * kH, 12345);\n    51\t        slot_penalty_rows(rows.data(), toks.data(), S, tails.data(), n_tails.data(), kH, out.data());\n    52\t        // the definition: per slot, penalty_rows over (its tail, its rows of this window)\n    53\t        for (int b = 0; b < kSlots; ++b) {\n    54\t            std::vector<int> idx;\n    55\t            std::vector<int32_t> win;\n    56\t            for (int t = 0; t < S; ++t) if (rows[t] == b) { idx.push_back(t); win.push_back(toks[t]); }\n    57\t            if (idx.empty()) continue;\n    58\t            std::vector<int32_t> ref(idx.size() * kH);\n    59\t            penalty_rows(tail[b].data(), (int64_t) tail[b].size(), win.data(), (int) idx.size(), kH, ref.data());\n    60\t            for (size_t k = 0; k < idx.size(); ++k)\n    61\t                for (int j = 0; j < kH; ++j)\n    62\t                    check(out[(size_t) idx[k] * kH + j] == ref[k * kH + j], \"slot row equals penalty_rows of the slot alone\");\n    63\t        }\n    64\t    }\n    65\t    // ---- fixed cases: an empty tail, the fed-back head counted, other slots' tokens never in a row\n    66\t    {\n    67\t        const int rows[3] = {0, 1, 1};\n    68\t        const int32_t toks[3] = {10, 20, 21};\n    69\t        const int32_t t0[2] = {1, 2};\n    70\t        const int32_t t1[3] = {7, 8, 9};\n    71\t        const int32_t* tails[2] = {t0, t1};\n    72\t        const int64_t n_tails[2] = {2, 3};\n    73\t        std::vector<int32_t> out(3 * 4, 0);\n    74\t        slot_penalty_rows(rows, toks, 3, tails, n_tails, 4, out.data());\n    75\t        const int32_t e[12] = {-1, 1, 2, 10,    7, 8, 9, 20,    8, 9, 20, 21};\n    76\t        for (int i = 0; i < 12; ++i) check(out[i] == e[i], \"fixed case\");\n    77\t    }\n    78\t    {   // a slot with no tail (no penalty history): its row holds the fed token only\n    79\t        const int rows[1] = {0};\n    80\t        const int32_t toks[1] = {42};\n    81\t        const int32_t* tails[1] = {nullptr};\n    82\t        const int64_t n_tails[1] = {0};\n    83\t        int32_t out[4] = {0, 0, 0, 0};\n    84\t        slot_penalty_rows(rows, toks, 1, tails, n_tails, 4, out);\n    85\t        check(out[0] == -1 && out[1] == -1 && out[2] == -1 && out[3] == 42, \"empty tail\");\n    86\t    }\n    87\t    std::printf(\"slot_history_test: %d checks passed\\n\", checks);\n    88\t    return 0;\n    89\t}\n","exit_code":0,"status":"completed"}}
