hunk-GEMM part (cuBLAS / hipBLAS, and on HIP the engine's WMMA kernel src/prefill/wmma_gemm.cu); both are off by default.\nset -u\nMODE=${1:?cuda|hip}; OUT=${2:?outdir}\nSRC=${SRC:-$(cd \"$(dirname \"$0\")/../..\" && pwd)}\nEXTRA=${EXTRA:-}\nJOBS=${JOBS:-3}\nmkdir -p \"$OUT\"\nDEFS=\"-DSTRATA_Q6K_EXPERTS=1\"\nFILES=\"src/dsv41/ds4_iq.cu src/dsv41/ds4_tq.cu\"\ncase \" $EXTRA \" in *\" gguf \"*) DEFS=\"$DEFS -DDQ_TEST_GGUF=1\"; FILES=\"$FILES src/dsv41/ds4_gguf.cu\";; esac\ncase \" $EXTRA \" in *\" gemm \"*) DEFS=\"$DEFS -DDQ_TEST_GEMM=1\"; case \" $EXTRA \" in *\" gguf \"*) ;; *) FILES=\"$FILES src/dsv41/ds4_gguf.cu\";; esac;; esac\nINC=\"-I$SRC/include -I$SRC/third_party/ggml -I$SRC/src/dsv41 -I$SRC/src/prefill\"\n: > \"$OUT/build.status\"\n\nrun_jobs() {   # run_jobs \"<cmd>\" ... with at most $JOBS at once\n    local pids=() cmd\n    for cmd in \"$@\"; do\n        while [ \"$(jobs -rp | wc -l)\" -ge \"$JOBS\" ]; do sleep 2; done\n        ( eval \"$cmd\" ) &\n    done\n    wait\n}\n\nif [ \"$MODE\" = cuda ]; then\n    A=${CUDA_ARCH:?CUDA_ARCH, e.g. 86}\n    NVCC=${NVCC:-nvcc}\n    FL=\"-O2 -std=c++20 --generate-code=arch=compute_$A,code=sm_$A -Xcompiler -ffp-contract=off -Xcompiler -fPIC $DEFS $INC\"\n    if [ \"$A\" -lt 70 ]; then FL=\"$FL -include $SRC/tests/dsv41/dq_pascal_shim.h\"; fi   # Pascal: no __dp4a (< 61), no wmma (< 70)\n    cmds=()\n    n=0\n    for f in tests/dsv41/dq_dense_test.cpp $FILES; do\n        o=\"$OUT/$(basename \"$f\").o\"\n        [ -f \"$o\" ] && [ \"$o\" -nt \"$SRC/$f\" ] && continue   # (up to date)\n        x=\"\"; case \"$f\" in *.cpp) x=\"-x cu\";; esac\n        cmds+=(\"cd $SRC && $NVCC $FL $x -c $f -o $o > $o.log 2>&1 || echo FAILED $f >> $OUT/build.status\")\n    done\n    run_jobs \"${cmds[@]}\"\n    LIBS=\"\"; case \" $EXTRA \" in *\" gemm \"*) LIBS=\"-lcublas\";; esac\n    if grep -q FAILED \"$OUT/build.status\"; then cat \"$OUT/build.status\"; for l in \"$OUT\"/*.log; do echo \"== $l\"; grep -E \"error\" \"$l\" | head -12; done; exit 1; fi\n    $NVCC -o \"$OUT/dq_test\" $OUT/*.o $LIBS > \"$OUT/link.log\" 2>&1 || { cat \"$OUT/link.log\"; exit 1; }\nelse\n    HP=${HIP_ROOT:?HIP_ROOT}\n    ARCH=${HIP_ARCH:?HIP_ARCH}\n    CXX=${HIPCXX:-$HP/llvm/bin/clang++}\n    export HIP_PLATFORM=amd HIP_COMPILER=clang HIP_RUNTIME=rocclr ROCM_PATH=$HP HIP_PATH=$HP\n    FL=\"--rocm-path=$HP --rocm-device-lib-path=$HP/amdgcn/bitcode -O2 -std=c++20 --offload-arch=$ARCH -fPIE -ffp-contract=off\"\n    FL=\"$FL -include $SRC/include/strata/dsv41/hip_extra.h -include $SRC/include/strata/hip_compat/cuda_runtime.h\"\n    FL=\"$FL -DSTRATA_USE_HIP=1 -D__HIP_PLATFORM_AMD__=1 -D__HIP_ROCclr__=1 -isystem $HP/include $DEFS $INC -I$SRC/include/strata/hip_compat\"\n    case \" $EXTRA \" in *\" gemm \"*) FILES=\"$FILES src/prefill/wmma_gemm.cu\";; esac\n    cmds=()\n    for f in tests/dsv41/dq_dense_test.cpp $FILES; do\n        o=\"$OUT/$(basename \"$f\").o\"\n        [ -f \"$o\" ] && [ \"$o\" -nt \"$SRC/$f\" ] && continue   # (up to date)\n        cmds+=(\"cd $SRC && $CXX $FL -x hip -c $f -o $o > $o.log 2>&1 || echo FAILED $f >> $OUT/build.status\")\n    done\n    run_jobs \"${cmds[@]}\"\n    if grep -q FAILED \"$OUT/build.status\"; then cat \"$OUT/build.status\"; for l in \"$OUT\"/*.log; do echo \"== $l\"; grep -E \"error\" \"$l\" | head -12; done; exit 1; fi\n    LIBS=\"-L$HP/lib -lamdhip64 -Wl,-rpath,$HP/lib\"\n    case \" $EXTRA \" in *\" gemm \"*) LIBS=\"$LIBS -L${HIPBLAS_LIB:-$HP/lib} -lhipblas -Wl,-rpath,${HIPBLAS_LIB:-$HP/lib}\";; esac\n    $CXX --hip-link --rtlib=compiler-rt -unwindlib=libgcc --offload-arch=$ARCH -o \"$OUT/dq_test\" $OUT/*.o $LIBS > \"$OUT/link.log\" 2>&1 || { cat \"$OUT/link.log\"; exit 1; }\nfi\necho \"built $OUT/dq_test\"\n\"\"\"strata_control/split_engine.py (when the all-cards split engine may run) and src/split (no peer access in any path).\"\"\"\n\nfrom __future__ import annotations\n\nimport re\nimport unittest\nfrom pathlib import Path\n\nfrom strata_control import split_engine as S\n\nROOT = Path(__file__).resolve().parents[2]\nGIB = 1 << 30\n\nA6000 = dict(name=\"NVIDIA RTX A6000\", vram_mib=49140, cc=86)\n\n\ndef cards(n=2, **kw):\n    spec = {**A6000, **kw}\n    return [S.Card(index=i, **spec) for i in range(n)]\n\n\ndef udq4(**kw):\n    \"\"\"UD-Q4_K_XL as measured: 71.7 GiB of routed experts, Q8_0 embeddings, a 27.5 GiB embedding table in RAM.\"\"\"\n    f = dict(routed_types={\"Q4_K\": 97, \"Q5_K\": 2, \"Q5_1\": 43, \"Q8_0\": 5}, routed_bytes=int(71.7 * GIB), embd_type=\"Q8_0\",\n             shexp_types={\"Q8_0\": 144}, embd_ram_bytes=int(27.5 * GIB), layers=48, experts=512)\n    f.update(kw)\n    return S.ModelFacts(**f)\n\n\ndef decide(**kw):\n    a = dict(enabled=True, system=\"linux\", cards=cards(), ram_total_gib=125, ram_available_gib=80, model=udq4())\n    a.update(kw)\n    return S.decide(**a)\n\n\nclass Rule(unittest.TestCase):\n    def test_runs_on_the_tested_setup(self):\n        d = decide()\n        self.assertTrue(d.use_split, d.reasons)\n        self.assertEqual(d.cards, 2)\n        self.assertEqual(d.untested, [])\n        self.assertIn(\"2 cards\", d.line)\n\n    def test_off_unless_asked(self):\n        d = decide(enabled=False)\n        self.assertFalse(d.use_split)\n        self.assertIn(\"opt-in\", d.line)\n\n    def test_linux_nvidia_only(self):\n        for system in (\"windows\", \"darwin\"):\n            self.assertFalse(decide(system=system).use_split)\n\n    def test_card_count_and_sameness(self):\n        self.assertFalse(decide(cards=cards(1)).use_split)\n        self.assertFalse(decide(cards=cards(5)).use_split)\n        mixed = cards(1) + [S.Card(index=1, name=\"NVIDIA RTX A5000\", vram_mib=24564, cc=86)]\n        d = decide(cards=mixed)\n        self.assertFalse(d.use_split)\n        self.assertIn(\"same model\", d.line)\n\n    def test_untested_counts_archs_and_contexts_stay_off_unless_a_tester_allows_them(self):\n        for c in (cards(3), cards(2, cc=89), cards(2, cc=90)):\n            d = decide(cards=c)\n            self.assertFalse(d.use_split)\n            self.assertIn(\"only been run\", d.line)\n#!/usr/bin/env python3\n\"\"\"short_prompt_check.py <strata-dsv41> <pack> <ids file (comma separated token ids)> [engine args...]\n\nA short prompt (40 tokens: the windows path, below the chunked pass) with the expert cache on, default sampler, twice, then a\ngreedy one.  Fails (exit 1) on any ERR line, an engine death, or an engine stderr line with 'illegal memory access', 'router picked'\nor 'the move into VRAM failed'.  Found on HIP (p620): a swap copy out of a slot in the lent tail region read past the allocation\n(the RAM store's put used vram_base + slot * unit instead of sat()), which only the windows path's swaps reached.\n\"\"\"\nimport os, queue, subprocess, sys, tempfile, threading\n\nexe, pack, idsf = sys.argv[1:4]\nrest = sys.argv[4:]\nids = [int(x) for x in open(idsf).read().strip().split(\",\")][:40]\nlog = tempfile.NamedTemporaryFile(\"w+\", suffix=\".engine.log\", delete=False)\np = subprocess.Popen([exe, \"--serve\", \"--pack\", pack, \"--max-context\", \"16384\", \"--eos\", \"1\", \"--vision\", \"off\", \"--dspark\", \"off\"] + rest,\n                     stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=log, text=True, bufsize=1)\nq = queue.Queue()\nthreading.Thread(target=lambda: [q.put(l.rstrip(\"\\n\")) for l in p.stdout] + [q.put(None)], daemon=True).start()\nwhile True:\n    l = q.get(timeout=3600)\n    if l is None:\n        sys.exit(\"engine ended before READY\")\n    if l.startswith(\"READY\"):\n        break\nbad = 0\nfor k, keys in enumerate((\"\", \"\", \"temperature=0\")):\n    p.stdin.write(f\"GEN 16 {keys} {','.join(map(str, ids))}\\n\")\n    p.stdin.flush()\n    n = 0\n    while True:\n        l = q.get(timeout=900)\n        if l is None:\n            print(\"engine died\"); bad += 1; break\n        if l.startswith(\"T \"):\n            n += 1\n        if l.startswith(\"ERR\"):\n            print(\"request\", k + 1, l[:120]); bad += 1; break\n        if l.startswith(\"DONE\"):\n            print(f\"request {k + 1}: {n} tokens | {l[:80]}\")\n            bad += n != 16\n            break\n    if bad:\n        break\np.stdin.write(\"QUIT\\n\"); p.stdin.flush()\ntry:\n    p.wait(timeout=120)\nexcept Exception:\n    p.kill()\nlog.flush(); log.seek(0)\nfor line in log:\n    if any(s in line for s in (\"illegal memory access\", \"router picked\", \"the move into VRAM failed\")):\n        print(\"engine log:\", line.strip()[:160]); bad += 1\nos.unlink(log.name)\nprint(\"short prompt check:\", \"FAILED\" if bad else \"ok\")\nsys.exit(1 if bad else 0)\n    require(cudaMemcpy(src.exchange_buffer(0), cache.device_slot(0), bytes, cudaMemcpyDeviceToHost) == cudaSuccess,\n            \"D2H eviction failed\");\n    require(src.stage_exchange(0, 0, 2, 0), \"stage rejected\");\n    require(!src.replace_resident(0, 4, 1), \"accepted beside a staged exchange\");\n    require(cache.fill_slot_blocking(0, truth[0].data(), err), err);\n    require(src.commit_exchanges() == 1, \"commit count wrong\");   // RAM: 2 (in 0's place) and 1; VRAM: 0 and 3\n    const uint8_t* place = src.blob(0, 1);\n    require(src.replace_resident(0, 4, 1), \"replace rejected\");\n    require(src.ram_adapts() == 1 && src.has_resident(0, 4) && !src.has_resident(0, 1), \"residency wrong\");\n    require(src.blob(0, 4) == place && holds(4), \"the incoming expert is not in the outgoing one's place\");\n    require(holds(1) && holds(2), \"another expert's bytes changed\");\n    require(src.copy_blob(0, 1, actual.data()) && actual == truth[1], \"the outgoing expert is not read from the file\");\n    require(!src.transient(0, 4), \"resident became transient\");\n    if (pin) {\n        require(src.pinned(0, 4) && src.device_alias(0, 4), \"mapping lost\");\n        require(cudaMemcpy(actual.data(), src.device_alias(0, 4), bytes, cudaMemcpyDeviceToHost) == cudaSuccess,\n                \"device alias read failed\");\n        require(actual == truth[4], \"CUDA alias points at the old expert\");\n    }\n    // and back, then an exchange with the VRAM tier still works on the moved place\n    require(src.replace_resident(0, 1, 4) && holds(1) && src.blob(0, 1) == place && !src.has_resident(0, 4),\n            \"replace back wrong\");\n    require(cudaMemcpy(src.exchange_buffer(0), cache.device_slot(1), bytes, cudaMemcpyDeviceToHost) == cudaSuccess,\n            \"D2H eviction failed\");\n    require(src.stage_exchange(0, 1, 3, 0), \"stage after replace rejected\");\n    require(cache.fill_slot_blocking(1, truth[1].data(), err), err);\n    require(src.commit_exchanges() == 1 && src.has_resident(0, 3) && holds(3) && !src.has_resident(0, 1),\n            \"exchange after replace wrong\");\n    require(src.ram_adapts() == 2, \"accounting wrong\");\n    // a staged incoming blob: RAM {2,3}, VRAM {0,1}, 4 on the file tier\n    require(!src.replace_resident_staged(0, 4, 3) && src.has_resident(0, 3) && src.ram_adapts() == 2,\n            \"an unstaged expert moved\");\n    std::string why;\n    set_env(\"STRATA_UNBUFFERED_LOAD\", \"1\");\n    const bool unbuffered = src.set_unbuffered(0, why);\n    set_env(\"STRATA_UNBUFFERED_LOAD\", nullptr);\n    if (unbuffered && src.stages_blobs()) {\n        require(!src.replace_resident_staged(0, 4, 3) && holds(3), \"moved before any demand read\");\n        require(!src.has_resident(0, 4) && holds(4), \"demand read wrong\");   // leaves 4 in a stage buffer\n        require(!src.replace_resident_staged(0, 4, 0) && !src.replace_resident_staged(0, 2, 3),\n                \"invalid staged pair accepted\");\n        require(src.replace_resident_staged(0, 4, 3) && src.has_resident(0, 4) && !src.has_resident(0, 3),\n                \"staged replacement residency wrong\");\n        require(src.resident_blob(0, 4) != nullptr && !std::memcmp(src.resident_blob(0, 4), truth[4].data(), bytes),\n                \"staged replacement bytes wrong\");\n        require(holds(2) && holds(3) && src.ram_adapts() == 3 && src.ram_staged() == 1,\n                \"staged replacement changed another expert\");\n        std::cout << \"replace_resident_staged: pinned=\" << pin << \" exact_bytes=PASS\\n\";\n    } else {\n        std::cout << \"replace_resident_staged: pinned=\" << pin << \" unbuffered unavailable here (\" << why << \"), positive case SKIPPED\\n\";\n    }\n    std::cout << \"replace_resident: pinned=\" << pin << \" exact_bytes=PASS\\n\";\n}\n\n}  // namespace\n\nint main(int argc, char** argv) {\n    try {\n        test_complement_plan();\n        test_resident_lend_region();\n        test_split_lend_regions();\n        test_resident_exchange();\n        test_resident_memory_budget();\n        test_pin_pacing();\n        test_wait_for_ram();\n        test_numa_slice_ranges();\n        test_cgroup_memory_budget();\n        test_host_memory();\n        test_canonical_layout();\n        test_unbuffered_reads();\n        test_io_prefetch();\n#if defined(STRATA_NATIVE_EXPERTS)\n        test_native_variable_layout();\n#endif\n        if (argc == 2 && std::string(argv[1]) == \"--rotation-gpu\") {\n            test_rotating_source(false, true);\n            test_rotating_source(true, true);\n            test_rotating_source(true, false);\n            test_foresight_exchange(false);\n            test_foresight_exchange(true);\n            test_replace_resident(true);\n            test_replace_resident(false);\n        }\n        std::cout << \"file_expert_source_test: PASS\\n\";\n        return 0;\n    } catch (const std::exception& error) {\n        std::cerr << \"file_expert_source_test: \" << error.what() << '\\n';\n        return 1;\n    }\n}\n","exit_code":0,"status":"completed"}}
