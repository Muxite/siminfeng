+    def test_outside_choices_ignored(self):
+        expected = max((e for e in self.entries if e["token"] == "A"), key=lambda e: e["logprob"])
+        self.assertEqual(mcq.letter_argmax(self.entries, ["A"]), ("A", {"A": expected["logprob"]}))
