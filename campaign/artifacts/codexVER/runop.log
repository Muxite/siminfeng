           quality + [text('Greedy identity or unresolved KLD', [ref(KV, 'kv_gen32k_f16', 3),\n                                                                  ref(KV, f'kv_gen32k_{quant}', 3)])], ['D028', 'D033'])\n\n\nif __name__ == '__main__':\n    main()\nPY\npython3 cc/verdict/build_criteria.py\npython3 -B cc/verdict/verdict.py cc/verdict/criteria/D029-q8_reuse.json > artifacts/codexVER/D029-q8_reuse.verdict.json\npython3 - <<'PY'\nimport json\nr=json.load(open('artifacts/codexVER/D029-q8_reuse.verdict.json'))\nprint(r['status'])\nfor c in r['criteria']: print(c['id'],c['status'],c.get('value'),c.get('error'))\nPY\"","aggregated_output":"PASS\nQ8_0 decode gain PASS 2.0677823745951507 None\nq8 OFF/ON greedy identity PASS True None\nq8 printed PPL identity PASS 0.0 None\nmix OFF/ON greedy identity PASS True None\nmix printed PPL identity PASS 0.0 None\nCUDA MUL_MAT correctness PASS True None\nNo compiler during timing PASS True None\n","exit_code":0,"status":"completed"}}
