ies(direct_file_async_test PRIVATE Threads::Threads)\n2852:    add_test(NAME direct_file_async_test COMMAND direct_file_async_test)\n2855:  add_executable(aux_cpus_test tests/platform/aux_cpus_test.cpp)\n2856:  target_include_directories(aux_cpus_test PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/include)\n2857:  target_link_libraries(aux_cpus_test PRIVATE Threads::Threads)\n2858:  add_test(NAME aux_cpus_test COMMAND aux_cpus_test)\n2862:# to device memory in the hottest loops the engine has, and nothing on the build machine says so without -Xptxas -v\n2875:    add_test(NAME cuda_spill_guard COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tools/check_cuda_spills.py\n2877:    set_tests_properties(cuda_spill_guard PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 600)\n2879:      add_test(NAME check_cuda_spills_unit COMMAND ${Python3_EXECUTABLE} -m unittest tools.test_check_cuda_spills\n2883:    message(STATUS \"strata: no python3 - the cuda_spill_guard test is NOT registered\")\n2888:  enable_testing()\n2890:  if(EXISTS \"${CMAKE_CURRENT_SOURCE_DIR}/tests/CMakeLists.txt\")\n2891:    add_subdirectory(tests)\n2937:    add_executable(ds4_gg_bench tests/dsv41/gg_dot_bench.cpp src/dsv41/ds4_gg_cpu.cpp)\n\"\"\"pytest: setup.py's data-folder migration (#198) saves the data folder it settled on in the user's settings file\n(%APPDATA%\\Strata\\settings.json, ~/.config/strata/settings.json) and can MOVE model files from a folder it finds there.\nA test that reaches it must never touch the real file, so the whole session gets its own config home.\"\"\"\nimport os\nimport tempfile\n\n_home = tempfile.mkdtemp(prefix=\"strata-pytest-config-\")\nos.environ[\"APPDATA\"] = _home\nos.environ[\"XDG_CONFIG_HOME\"] = _home\n# The per-user STATE and DATA folders too (%LOCALAPPDATA%\\Strata: tuning/recheck.json, the engine store, the update records; ~/.local/state, ~/.local/share).\n# A test that installs a stub engine marks saved tuning presets for a re-check there: on 2026-10-24 one such run left an entry in the owner's real\n# tuning\\recheck.json. A test that wants a place of its own still names it (STRATA_COMPONENTS_DIR, state_base=...).\nos.environ[\"LOCALAPPDATA\"] = _home\nos.environ[\"XDG_STATE_HOME\"] = _home\nos.environ[\"XDG_DATA_HOME\"] = _home\n\"\"\"Terminal tests do not depend on the graphics card of the box they run on.\n\nThe Drafting step of `strata launch` (and the Drafting line of the summary) exists only where the engine can run DFlash2 (CUDA or HIP), so the number\nof steps and the layout of the summary used to differ between an Nvidia box and an Intel one. Every test starts on a computer with no card the engine\nknows; a test about drafting names the card it means (test_drafting.py and test_drafting_hardware.py patch `detect_hardware` themselves).\"\"\"\nfrom unittest import mock\n\nimport pytest\n\n\n@pytest.fixture(autouse=True)\ndef _no_card_unless_a_test_names_one(request):\n    from strata_control import drafting\n    if request.module.__name__.rsplit(\".\", 1)[-1].startswith(\"test_drafting\"):\n        yield                                    # these name their card themselves (setUpModule / per test)\n        return\n    with mock.patch.object(drafting, \"detect_hardware\", return_value=(\"cpu\", [])):\n        yield\n","exit_code":0,"status":"completed"}}
