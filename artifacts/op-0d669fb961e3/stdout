or a tensor, decided by `tools/pack_index.py` and written into the index\n    39\t/// rather than inferred here.  The four cases are distinguishable in the manifest only by combining\n    40\t/// `source_type` with `values_fp16`, and getting that combination wrong yields a plausible tensor.\n    41\tenum class WeightKind : int {\n    42\t    Verbatim = 0,   ///< quantized planes, or F16 already stored as 2 bytes: copy straight through\n    43\t    Bf16InF32 = 1,  ///< the pack holds the bf16 value promoted to f32: take the HIGH 16 BITS (exact)\n    44\t    F32 = 2,        ///< copy 4 bytes per element\n    45\t    F16InF32 = 3,   ///< an f16 value promoted to f32: a real f32->f16 conversion, not a truncation\n    46\t};\n    47\t\n    48\tstruct WeightRef {\n    49\t    const void* data = nullptr;   ///< device pointer inside the arena\n    50\t    uint64_t bytes = 0;\n    51\t    int64_t ne0 = 0;              ///< the manifest's own shape, ne0 the CONTIGUOUS axis\n    52\t    int64_t ne1 = 0;\n    53\t    int64_t elements = 0;\n    54\t    WeightKind kind = WeightKind::Verbatim;\n    55\t    /// The canonical-form attributes, valid only for a quantized VERBATIM tensor (`code_bits != 0`).\n    56\t    int code_bits = 0;\n    57\t    int code_bias = 0;\n    58\t    int group_elems = 0;\n    59\t    bool codebook_iq4nl = false;\n    60\t    bool has_offset = false;\n    61\t\n    62\t    /// THE THREE PLANE SIZES, IN ENGINE FORM, in the order they sit inside `data`.  Recorded by the loader\n    63\t    /// from what the index TOLD it rather than re-derived by each caller: the one time this layout was\n    64\t    /// re-derived independently it assumed 4-byte scales for tensors whose pack scales are fp16, and the\n    65\t    /// only reason that was not a silent wrong answer is that the re-derivation checked itself and refused.\n    66\t    /// Two places computing one layout is two places to disagree.\n    67\t    uint64_t codes_bytes = 0;\n    68\t    uint64_t scales_bytes = 0;    ///< always 4 B per scale in the arena, whatever the pack held\n    69\t    uint64_t offset_bytes = 0;    ///< 0 when the form has no offset plane\n    70\t\n    71\t    /// WHERE THIS TENSOR CAME FROM, so a caller can check the loader's work against the pack's own bytes\n    72\t    /// instead of against the loader's opinion of them.  Without `src_off` a test can only compare two\n    73\t    /// derived numbers; with it, the widening of an fp16 scale plane can be verified value by value against\n    74\t    /// `<file>.bin` - and the pack files are named, so `file_id` says which one to open.\n    75\t    uint64_t src_off = 0;\n    76\t    uint64_t src_bytes = 0;\n    77\t    int file_id = 0;\n    78\t    bool scales_fp16 = false;     ///< the PACK's width, before the loader widened it\n    79\t\n    80\t    /// WHICH ACTIVATION THIS WEIGHT WANTS - 0 for Q8_0, 1 for Q8_K.  Decided by \tools/pack_index.py from\n    81\t    /// source_type and carried here, because **the S-form CANNOT express it**: Q5_0 and Q5_K are both 8-bit\n    82\t    /// with bias -16, and IQ4_NL and IQ4_XS differ in nothing the S-form holds.  docs/activation-contract.md.\n    83\t    int act_kind = 0;\n    84\t    bool wants_q8k() const { return act_kind == 1; }\n    85\t\n    86\t    bool quantized() const { return code_bits != 0; }\n    87\t\n    88\t    // Optional native GGUF projection, owned by NativeDense. All references in\n    89\t    // one table share its scratch and must execute on one ordered session stream.\n    90\t    const void* native_data = nullptr;\n    91\t    void* native_q8_1 = nullptr;\n    92\t    int native_type = -1;\n    93\t    /// S23 experiment (STRATA_HC_Q8=1): a hyper-connection projection's Q8_0 bytes as the GGUF stores them, owned by\n    94\t    /// NativeDense, for the verify window's read (every other path keeps the pack's BF16 `data`)\n    95\t    const void* hc_q8 = nullptr;\n    96\t    /// Plan v0.3 P1: false when the loader SKIPPED t