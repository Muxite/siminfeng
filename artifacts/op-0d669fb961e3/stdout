{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc 'nl -ba include/strata/artifact/model_family.hpp; nl -ba include/strata/core/hit_hook.hpp; nl -ba include/strata/core/geometry.hpp; nl -ba include/strata/core/family_layout.hpp'","aggregated_output":"     1\t// include/strata/artifact/model_family.hpp - which model family a GGUF holds, from its general.architecture.\n     2\t//\n     3\t// Strata was written for one model (Qwen3.8-Flash-Next, `qwen4exp`).  Qwen3.6-35B-A3B (`qwen35moe`) is a close\n     4\t// cousin (same tokenizer, the same Gated-DeltaNet + gated-attention 3:1 layer pattern, the same head dims), so the\n     5\t// reader, the geometry and the layout tables know both.  The ENGINE runs only the families `model_family_runs`\n     6\t// names; a recognised family it does not run yet is refused with `model_family_not_supported`, not mis-run.\n     7\t//\n     8\t// No dependencies: the GGUF reader (the architecture guard) and the core geometry both include this.\n     9\t#pragma once\n    10\t\n    11\t#include <string>\n    12\t\n    13\tnamespace strata {\n    14\t\n    15\tenum class ModelFamily {\n    16\t    Unknown = 0,\n    17\t    Qwen4Exp,    ///< Qwen3.8-Flash-Next and its fine-tunes / pruned variants (Swift 1.5, the Coder)\n    18\t    Qwen35Moe,   ///< Qwen3.6-35B-A3B (Unsloth's MTP GGUFs): plain pre-norm residual, dense attention, nextn MTP block\n    19\t};\n    20\t\n    21\tinline ModelFamily model_family_from_arch(const std::string& arch) {\n    22\t    if (arch == \"qwen4exp\") return ModelFamily::Qwen4Exp;\n    23\t    if (arch == \"qwen35moe\") return ModelFamily::Qwen35Moe;\n    24\t    return ModelFamily::Unknown;\n    25\t}\n    26\t\n    27\t/// The GGUF architecture string (also the metadata key prefix: \"<arch>.block_count\").\n    28\tinline const char* model_family_arch(ModelFamily f) {\n    29\t    switch (f) {\n    30\t    case ModelFamily::Qwen4Exp:\n    31\t        return \"qwen4exp\";\n    32\t    case ModelFamily::Qwen35Moe:\n    33\t        return \"qwen35moe\";\n    34\t    default:\n    35\t        return \"\";\n    36\t    }\n    37\t}\n    38\t\n    39\t/// The model's name for messages.\n    40\tinline const char* model_family_title(ModelFamily f) {\n    41\t    switch (f) {\n    42\t    case ModelFamily::Qwen4Exp:\n    43\t        return \"Qwen3.8-Flash-Next\";\n    44\t    case ModelFamily::Qwen35Moe:\n    45\t        return \"Qwen3.6-35B-A3B\";\n    46\t    default:\n    47\t        return \"an unknown model\";\n    48\t    }\n    49\t}\n    50\t\n    51\t/// Whether Flash-Next's engine path runs the family.  Qwen3.6 has an engine path of its own (src/qwen35), which the\n    52\t/// CUDA and HIP builds of `strata` switch to at the top of main(); the Intel Arc (SYCL) build has none yet, so there\n    53\t/// (and on Flash-Next's path) the family is refused with `model_family_not_supported`.\n    54\tinline bool model_family_runs(ModelFamily f) { return f == ModelFamily::Qwen4Exp; }\n    55\t\n    56\t/// The refusal for a recognised family the engine does not run (empty when it runs it).\n    57\tinline std::string model_family_not_supported(ModelFamily f) {\n    58\t    if (model_family_runs(f)) return {};\n    59\t    if (f == ModelFamily::Unknown) return \"this is not a model family Strata knows\";\n    60\t    return std::string(model_family_title(f)) + \" (architecture '\" + model_family_arch(f) +\n    61\t           \"') runs on the NVIDIA (CUDA) and AMD (HIP) builds of Strata; this build does not run it yet (the Intel \"\n    62\t           \"Arc / SYCL port is in development). Use a CUDA or HIP build, or a Qwen3.8-Flash-Next model file\";\n    63\t}\n    64\t\n    65\t}  // namespace strata\n     1\t// include/strata/core/hit_hook.hpp - R4.2c: the seam between the host loop and the VRAM expert tier.\n     2\t//\n     3\t// **IT IS ITS OWN HEADER BECAUSE BOTH SIDES NEED IT AND NEITHER SHOULD OWN IT.**  `session.hpp` declares the\n     4\t// loop that calls the hook; `expert_source.hpp` declares the implementation that answers it.  Putting the type\n     5\t// in either one makes the other include a header it has no other use for, and the loop knowing what an expert\n     6\t// cache is (or the adapter knowing what a graph is) is exactly the coupling this seam exists to avoid.\n     7\t#pragma once\n     8\t\n     9\t#include <cstdint>\n    10\t\n    11\tnamespace strata::core {\n    12\t\n    13\t/// **TWO PHASES, AND THE SPLIT IS THE WHOLE POINT.**  `Launch` runs BEFORE the CPU pool and `Combine` runs\n    14\t/// AFTER the misses have been copied into `parts`.  That ordering is what lets the GPU's resident experts run\n    15\t/// at the same time as the CPU's misses instead of after them:\n    16\t///\n    17\t///     ring -> hits(Launch)   [GPU: quantize + grouped experts into `hit_out`]\n    18\t///          -> pool()         [CPU: the misses, CONCURRENT with the GPU]\n    19\t///          -> H2D misses into `parts`\n    20\t///          -> hits(Combine)  [GPU: parts += hit_out]\n    21\t///          -> post[l]\n    22\t///\n    23\t/// **MEASURED, AND WHY IT IS NOT THE OBVIOUS ORDER.**  The first version called the hit path once, after the\n    24\t/// pool, writing straight into `parts`.  The drain duly fell **18.2 -> 10.2 ms** - the CPU really was doing\n    25\t/// half the experts - and **the token did not move at all**, because the GPU's half had simply been moved onto\n    26\t/// the critical path behind the CPU's instead of beside it.  A second buffer and one `add_inplace` buy the\n    27\t/// overlap back.\n    28\tenum class HitPhase { Launch, Combine };\n    29\t\n    30\t/// `ids` AND `k` ARE THE ROUTER'S OWN OUTPUT, AND THEY ARE WHY THIS HOOK TAKES ARGUMENTS AT ALL.\n    31\t///\n    32\t/// The first version took only `(user, stream, phase)` and left the hit/miss decision inside the pool\n    33\t/// callback - which runs AFTER `Launch`.  So `Launch` read the hit list from the PREVIOUS layer and computed\n    34\t/// the previous layer's experts into the current layer's rows.  It produced a token, the timings looked\n    35\t/// plausible, and **C1 moved from mean KL 9.69e-02 to 1.03e+00 and top-1 from 0.867 to 0.333.**  The decision\n    36\t/// has to happen in `Launch`, on the ids the doorbell published for THIS layer, and the pool then consumes it.\n    37\t///\n    38\t/// A null `HitFn` means \"no VRAM tier\" - the default, and what every caller had before R4.\n    39\tusing HitFn = void (*)(void* user, void* stream, HitPhase phase, const int32_t* ids, int64_t k);\n    40\t\n    41\t}  // namespace strata::core\n     1\t// include/strata/core/geometry.hpp - the model's geometry: one struct for the shape a model file declares and\n     2\t// the shape the kernels are compiled for.\n     3\t//\n     4\t// A model file's geometry is read from its own metadata (`strata::read_geometry`, gguf_reader.hpp), and the\n     5\t// engine passes that struct everywhere it needs a dimension.  The CUDA/HIP kernels still fix most of these\n     6\t// numbers at compile time (`constexpr int N = 2560` and the like); `kCompiledGeometry` is that shape, written\n     7\t// once, and each kernel that pins a number `static_assert`s it against this struct.  So a kernel and this file\n     8\t// cannot drift apart without the build failing, and a model file of another shape is refused at load with the\n     9\t// metadata key that differs (`strata::geometry_unsupported`) instead of mis-running.\n    10\t//\n    11\t// Dependency-free on purpose: the kernels include it.\n    12\t#pragma once\n    13\t\n    14\t#include \"strata/artifact/model_family.hpp\"\n    15\t\n    16\t#include <cstdint>\n    17\t\n    18\tnamespace strata::core {\n    19\t\n    20\t/// Every field is a number a kernel depends on, so a change to the compiled values is a change to a kernel\n    21\t/// contract and not a tuning knob.  The defaults are Qwen3.8-Flash-Next's (qwen4exp), the shape the kernels\n    22\t/// are compiled for; the GGUF key each field is read from is named beside it.\n    23\tstruct ModelGeometry {\n    24\t    int64_t n_embd = 2560;          ///< embedding_length\n    25\t    int64_t n_layers = 48;          ///< block_count (the trunk; an in-file MTP block is counted in n_mtp_layers)\n    26\t    int64_t qsa_interval = 4;       ///< full_attention_interval: every 4th layer is full attention, 3, 7, ... 47\n    27\t    int64_t n_vocab = 248320;       ///< the length of tokenizer.ggml.tokens\n    28\t    double rms_eps = 1e-6;          ///< attention.layer_norm_rms_epsilon\n    29\t\n    30\t    // GDN (36 layers)\n    31\t    int64_t ssm_state_size = 128;        ///< ssm.state_size: the key head width, and the value head width\n    32\t    int64_t ssm_k_heads = 16;            ///< ssm.group_count\n    33\t    int64_t ssm_v_heads = 48;            ///< ssm.time_step_rank\n    34\t    int64_t ssm_d_conv = 4;              ///< ssm.conv_kernel\n    35\t    int64_t ssm_conv_channels = 10240;   ///< 2*128*16 + 128*48, derived\n    36\t    int64_t ssm_value_dim = 6144;        ///< ssm.inner_size, 128 * 48\n    37\t\n    38\t    // QSA (12 layers)\n    39\t    int64_t n_head = 24;            ///< attention.head_count\n    40\t    int64_t n_head_kv = 2;          ///< attention.head_count_kv\n    41\t    int64_t head_dim = 256;         ///< attention.key_length (= attention.value_length)\n    42\t    int64_t n_rot = 64;             ///< rope.dimension_count: the rotated slice of head_dim and of idx_key_dim\n    43\t    int64_t idx_q_heads = 4;        ///< attention.indexer.head_count\n    44\t    int64_t idx_key_dim = 128;      ///< attention.indexer.key_length\n    45\t    int64_t idx_block = 4;          ///< the non-zero attention.compress_ratios entry: one pooled key per 4 cells\n    46\t    int64_t idx_top_k = 2048;       ///< attention.indexer.top_k: cells of selection budget\n    47\t\n    48\t    // gated residual, on every layer\n    49\t    int64_t hc = 4;                 ///< hyper_connection.count\n    50\t    int64_t hc_lr = 320;            ///< hyper_connection.low_rank\n    51\t\n    52\t    // MoE, on every layer\n    53\t    int64_t n_expert = 512;         ///< expert_count; pruned variants (GSQ-RCO Coder) ship fewer\n    54\t    int64_t n_expert_used = 10;     ///< expert_used_count\n    55\t    int64_t n_ff = 640;             ///< expert_feed_forward_length (= expert_shared_feed_forward_length)\n    56\t\n    57\t    // appended for the model families (Qwen3.6 = qwen35moe); the defaults keep Flash-Next's values\n    58\t    int64_t n_ff_shexp = 640;       ///< the shared expert's FFN width (qwen4exp: equal to n_ff, read_geometry checks)\n    59\t    ModelFamily family = ModelFamily::Qwen4Exp;\n    60\t    int64_t n_mtp_layers = 0;       ///< MTP blocks inside the model file, after the trunk (qwen35moe: blk.40)\n    61\t\n    62\t    constexpr bool has_indexer() const { return idx_q_heads > 0; }              ///< false: dense attention only\n    63\t    constexpr bool has_hyper_connections() const { return hc > 0; }             ///< false: plain pre-norm residual\n    64\t    constexpr int64_t hc_dim() const { return hc * n_embd; }\n    65\t    /// `layer % qsa_interval == qsa_interval - 1` is full attention.  Derived, not a second list.\n    66\t    constexpr int64_t n_qsa_layers() const { return n_layers / qsa_interval; }\n    67\t    constexpr int64_t n_gdn_layers() const { return n_layers - n_qsa_layers(); }\n    68\t};\n    69\t\n    70\t/// The shape the kernels are compiled for.  A kernel that fixes a dimension at compile time asserts it here.\n    71\tinline constexpr ModelGeometry kCompiledGeometry{};\n    72\t\n    73\t/// True for the full-attention layers.  `docs/semantics.md` gives this twice over - `full_attention_interval\n    74\t/// = 4` and an explicit `attention.compress_ratios` array - and `read_geometry` checks that the two agree.\n    75\tinline bool is_qsa_layer(const ModelGeometry& g, int64_t layer) {\n    76\t    return layer % g.qsa_interval == g.qsa_interval - 1;\n    77\t}\n    78\t\n    79\t}  // namespace strata::core\n     1\t// include/strata/core/family_layout.hpp - per model family: the geometry read from a GGUF's metadata, and the\n     2\t// tensor layout table (every tensor of a layer, by name and GGUF shape) checked against a model file's directory.\n     3\t//\n     4\t// Header-only and GPU-free: the engine, the tools and the unit tests (tests/core/model_family_test.cpp) share it.\n     5\t//\n     6\t//   * geometry_from_gguf: fills core::ModelGeometry from \"<arch>.*\" keys.  For qwen4exp the keys a file does not\n     7\t//     carry keep Flash-Next's values (the struct defaults, which every published qwen4exp file matches); for\n     8\t//     qwen35moe every key is required (check_architecture_qwen35moe).\n     9\t//   * compiled_geometry_mismatch: the first field where a geometry differs from the shapes this engine's kernels\n    10\t//     are built for (the expert count and top-k are run-time values and are not compared).\n    11\t//   * layer_tensors / global_tensors: the layout tables.  Names are GGUF names (blk.N.<suffix>), shapes are in\n    12\t//     GGUF order (dim 0 contiguous), as tools/gguf_reader.py prints them.\n    13\t//   * check_gguf_layout: every table entry present with its shape, inside its file, of a type with a known block\n    14\t//     size; and, for a family whose table is complete (qwen35moe), no blk.* tensor the table does not name.\n    15\t#pragma once\n    16\t\n    17\t#include \"strata/artifact/gguf_reader.hpp\"\n    18\t#include \"strata/artifact/model_family.hpp\"\n    19\t#include \"strata/core/geometry.hpp\"\n    20\t\n    21\t#include <cstdint>\n    22\t#include <cstdio>\n    23\t#include <set>\n    24\t#include <string>\n    25\t#include <vector>\n    26\t\n    27\tnamespace strata::core {\n    28\t\n    29\t/// Fills `g` (and `top_k`, the experts per token) from the metadata shard `meta`.  False with `err` when the\n    30\t/// architecture guard refuses the file or a key has an impossible value.\n    31\tinline bool geometry_from_gguf(const strata::GgufFile& meta, ModelGeometry& g, int64_t& top_k, std::string& err) {\n    32\t    err = strata::check_architecture(meta);\n    33\t    if (!err.empty()) return false;\n    34\t    const strata::ModelFamily family = strata::model_family(meta);\n    35\t    const std::string p = std::string(strata::model_family_arch(family)) + \".\";\n    36\t    g = ModelGeometry{};\n    37\t    g.family = family;\n    38\t    // a key the file carries replaces the default; `required` keys were checked present by the guard\n    39\t    auto num = [&](const char* key, int64_t& dst) {\n    40\t        if (const strata::MetaValue* v = meta.get(p + key))\n    41\t            if (v->is_num()) dst = (int64_t) v->u;\n    42\t    };\n    43\t    int64_t block_count = g.n_layers, key_length = g.head_dim, value_length = -1;\n    44\t    num(\"block_count\", block_count);\n    45\t    num(\"embedding_length\", g.n_embd);\n    46\t    num(\"attention.head_count\", g.n_head);\n    47\t    num(\"attention.head_count_kv\", g.n_head_kv);\n    48\t    num(\"attention.key_length\", key_length);\n    49\t    num(\"attention.value_length\", value_length);\n    50\t    num(\"expert_count\", g.n_expert);\n    51\t    top_k = 10;\n    52\t    num(\"expert_used_count\", top_k);\n    53\t    g.n_expert_used = top_k;\n    54\t    num(\"expert_feed_forward_length\", g.n_ff);\n    55\t    num(\"expert_shared_feed_forward_length\", g.n_ff_shexp);\n    56\t    num(\"ssm.conv_kernel\", g.ssm_d_conv);\n    57\t    num(\"ssm.state_size\", g.ssm_state_size);\n    58\t    num(\"ssm.group_count\", g.ssm_k_heads);\n    59\t    num(\"ssm.time_step_rank\", g.ssm_v_heads);\n    60\t    num(\"ssm.inner_size\", g.ssm_value_dim);\n    61\t    num(\"full_attention_interval\", g.qsa_interval);\n    62\t    g.head_dim = key_length;\n    63\t    if (family == strata::ModelFamily::Qwen35Moe) {\n    64\t        num(\"nextn_predict_layers\", g.n_mtp_layers);\n    65\t        g.hc = g.hc_lr = 0;                 // a plain pre-norm residual\n    66\t        g.idx_q_heads = g.idx_key_dim = 0;  // dense attention, no sparse indexer\n    67\t    } else {\n    68\t        num(\"hyper_connection.count\", g.hc);\n    69\t        num(\"hyper_connection.low_rank\", g.hc_lr);\n    70\t        num(\"attention.indexer.head_count\", g.idx_q_heads);\n    71\t        num(\"attention.indexer.key_length\", g.idx_key_dim);\n    72\t    }\n    73\t    g.n_layers = block_count - g.n_mtp_layers;\n    74\t    g.ssm_conv_channels = 2 * g.ssm_state_size * g.ssm_k_heads + g.ssm_value_dim;\n    75\t    if (const strata::MetaValue* v = meta.get(\"tokenizer.ggml.tokens\"))\n    76\t        if (v->type == strata::MetaType::ARRAY && v->count > 0) g.n_vocab = (int64_t) v->count;\n    77\t\n    78\t    char buf[256];\n    79\t    auto bad = [&](const char* what) {\n    80\t        std::snprintf(buf, sizeof buf, \"%s: %s\", meta.path().c_str(), what);\n    81\t        err = buf;\n    82\t        return false;\n    83\t    };\n    84\t    if (g.n_layers <= 0 || g.n_embd <= 0 || g.n_head <= 0 || g.n_head_kv <= 0 || g.head_dim <= 0 || g.n_expert <= 0 ||\n    85\t        top_k <= 0 || top_k > g.n_expert || g.n_ff <= 0 || g.ssm_state_size <= 0 || g.ssm_k_heads <= 0 ||\n    86\t        g.ssm_v_heads <= 0 || g.ssm_d_conv <= 0 || g.qsa_interval < 2)\n    87\t        return bad(\"a geometry key is zero or out of range\");\n    88\t    if (value_length >= 0 && value_length != key_length) return bad(\"attention.key_length != attention.value_length\");\n    89\t    if (g.ssm_value_dim != g.ssm_state_size * g.ssm_v_heads) return bad(\"ssm.inner_size != ssm.state_size * ssm.time_step_rank\");\n    90\t    if (g.ssm_v_heads % g.ssm_k_heads) return bad(\"ssm.time_step_rank is not a multiple of ssm.group_count\");\n    91\t    if (g.n_head % g.n_head_kv) return bad(\"attention.head_count is not a multiple of attention.head_count_kv\");\n    92\t    if (g.n_layers % g.qsa_interval) return bad(\"the layer count is not a multiple of full_attention_interval\");\n    93\t    return true;\n    94\t}\n    95\t\n    96\t/// The first geometry field that differs from the shapes this engine's kernels are built for (ModelGeometry's\n    97\t/// defaults, Flash-Next's), as \"<what> is <got>, this engine's kernels are built for <want>\"; empty when none.\n    98\t/// n_expert and top-k are run-time sizes (the Coder ships 256 experts) and n_vocab is the embedding's business.\n    99\tinline std::string compiled_geometry_mismatch(const ModelGeometry& g) {\n   100\t    const ModelGeometry c;\n   101\t    if (g.family != c.family)\n   102\t        return std::string(\"the model is \") + strata::model_family_title(g.family) + \", this engine's kernels are built \"\n   103\t               \"for \" + strata::model_family_title(c.family);\n   104\t    struct F {\n   105\t        const char* what;\n   106\t        int64_t got, want;\n   107\t    };\n   108\t    const F fields[] = {\n   109\t        {\"embedding_length\", g.n_embd, c.n_embd},\n   110\t        {\"the layer count\", g.n_layers, c.n_layers},\n   111\t        {\"full_attention_interval\", g.qsa_interval, c.qsa_interval},\n   112\t        {\"ssm.state_size\", g.ssm_state_size, c.ssm_state_size},\n   113\t        {\"ssm.group_count\", g.ssm_k_heads, c.ssm_k_heads},\n   114\t        {\"ssm.time_step_rank\", g.ssm_v_heads, c.ssm_v_heads},\n   115\t        {\"ssm.conv_kernel\", g.ssm_d_conv, c.ssm_d_conv},\n   116\t        {\"the GDN conv channels\", g.ssm_conv_channels, c.ssm_conv_channels},\n   117\t        {\"ssm.inner_size\", g.ssm_value_dim, c.ssm_value_dim},\n   118\t        {\"attention.head_count\", g.n_head, c.n_head},\n   119\t        {\"attention.head_count_kv\", g.n_head_kv, c.n_head_kv},\n   120\t        {\"attention.key_length\", g.head_dim, c.head_dim},\n   121\t        {\"attention.indexer.head_count\", g.idx_q_heads, c.idx_q_heads},\n   122\t        {\"attention.indexer.key_length\", g.idx_key_dim, c.idx_key_dim},\n   123\t        {\"hyper_connection.count\", g.hc, c.hc},\n   124\t        {\"hyper_connection.low_rank\", g.hc_lr, c.hc_lr},\n   125\t        {\"expert_feed_forward_length\", g.n_ff, c.n_ff},\n   126\t        {\"expert_shared_feed_forward_length\", g.n_ff_shexp, c.n_ff_shexp},\n   127\t        {\"the in-file MTP layers\", g.n_mtp_layers, c.n_mtp_layers},\n   128\t    };\n   129\t    for (const F& f : fields)\n   130\t        if (f.got != f.want) {\n   131\t            char buf[256];\n   132\t            std::snprintf(buf, sizeof buf, \"%s is %lld, this engine's kernels are built for %lld\", f.what,\n   133\t                          (long long) f.got, (long long) f.want);\n   134\t            return buf;\n   135\t        }\n   136\t    return {};\n   137\t}\n   138\t\n   139\tenum class LayerKind { Gdn, Attention, Mtp };\n   140\t\n   141\tinline LayerKind layer_kind(const ModelGeometry& g, int64_t layer) {\n   142\t    if (layer >= g.n_layers) return LayerKind::Mtp;\n   143\t    return is_qsa_layer(g, layer) ? LayerKind::Attention : LayerKind::Gdn;\n   144\t}\n   145\t\n   146\t/// One tensor of the layout table: its name (a blk.N. suffix for a layer's, the full name for a global one) and\n   147\t/// its GGUF shape.\n   148\tstruct TensorWant {\n   149\t    std::string name;\n   150\t    std::vector<int64_t> shape;\n   151\t};\n   152\t\n   153\t/// Every tensor of layer `layer` (kind from `layer_kind`), by family.\n   154\tinline std::vector<TensorWant> layer_tensors(const ModelGeometry& g, int64_t layer) {\n   155\t    const LayerKind kind = layer_kind(g, layer);\n   156\t    const int64_t N = g.n_embd, NE = g.n_expert, FF = g.n_ff, FS = g.n_ff_shexp;\n   157\t    std::vector<TensorWant> t;\n   158\t    auto add = [&](const char* s, std::vector<int64_t> shape) { t.push_back({s, std::move(shape)}); };\n   159\t    // MoE, every layer (the MTP block's too)\n   160\t    add(\"ffn_gate_inp.weight\", {N, NE});\n   161\t    add(\"ffn_gate_inp_shexp.weight\", {N});\n   162\t    add(\"ffn_gate_shexp.weight\", {N, FS});\n   163\t    add(\"ffn_up_shexp.weight\", {N, FS});\n   164\t    add(\"ffn_down_shexp.weight\", {FS, N});\n   165\t    add(\"ffn_gate_exps.weight\", {N, FF, NE});\n   166\t    add(\"ffn_up_exps.weight\", {N, FF, NE});\n   167\t    add(\"ffn_down_exps.weight\", {FF, N, NE});\n   168\t    if (g.has_hyper_connections()) {\n   169\t        // gated residual (Flash-Next): `gr_read` transposes, so the file's orientation is [hc_dim, hc_lr] / [hc_lr, hc_dim]\n   170\t        const int64_t H = g.hc_dim();\n   171\t        add(\"hc_attn_down.weight\", {H, g.hc_lr});\n   172\t        add(\"hc_attn_up.weight\", {g.hc_lr, H});\n   173\t        add(\"hc_attn_inject.weight\", {H, g.hc});\n   174\t        add(\"hc_attn_norm.weight\", {H});\n   175\t        add(\"hc_ffn_down.weight\", {H, g.hc_lr});\n   176\t        add(\"hc_ffn_up.weight\", {g.hc_lr, H});\n   177\t        add(\"hc_ffn_inject.weight\", {H, g.hc});\n   178\t        add(\"hc_ffn_norm.weight\", {H});\n   179\t    } else {\n   180\t        // plain pre-norm residual (qwen35moe): x += mixer(rms(x)); x += moe(rms(x))\n   181\t        add(\"attn_norm.weight\", {N});\n   182\t        add(\"post_attention_norm.weight\", {N});\n   183\t    }\n   184\t    if (kind == LayerKind::Gdn) {\n   185\t        add(\"attn_qkv.weight\", {N, g.ssm_conv_channels});\n   186\t        add(\"attn_gate.weight\", {N, g.ssm_value_dim});\n   187\t        add(\"ssm_out.weight\", {g.ssm_value_dim, N});\n   188\t        add(\"ssm_conv1d.weight\", {g.ssm_d_conv, g.ssm_conv_channels});\n   189\t        add(\"ssm_alpha.weight\", {N, g.ssm_v_heads});\n   190\t        add(\"ssm_beta.weight\", {N, g.ssm_v_heads});\n   191\t        add(\"ssm_a\", {g.ssm_v_heads});\n   192\t        add(\"ssm_dt.bias\", {g.ssm_v_heads});\n   193\t        add(\"ssm_norm.weight\", {g.ssm_state_size});\n   194\t    } else {\n   195\t        // attention (query + output gate in attn_q), also the MTP block's\n   196\t        add(\"attn_q.weight\", {N, 2 * g.n_head * g.head_dim});\n   197\t        add(\"attn_k.weight\", {N, g.n_head_kv * g.head_dim});\n   198\t        add(\"attn_v.weight\", {N, g.n_head_kv * g.head_dim});\n   199\t        add(\"attn_output.weight\", {g.n_head * g.head_dim, N});\n   200\t        add(\"attn_q_norm.weight\", {g.head_dim});\n   201\t        add(\"attn_k_norm.weight\", {g.head_dim});\n   202\t        if (g.has_indexer() && kind == LayerKind::Attention) {\n   203\t            // `q_proj` is the QUERY count, `k_proj` the KEY width (round 194: they are different numbers)\n   204\t            add(\"indexer.q_proj.weight\", {N, g.idx_q_heads * g.idx_key_dim});\n   205\t            add(\"indexer.k_proj.weight\", {N, g.idx_key_dim});\n   206\t            add(\"indexer.q_norm.weight\", {g.idx_key_dim});\n   207\t            add(\"indexer.k_norm.weight\", {g.idx_key_dim});\n   208\t        }\n   209\t    }\n   210\t    if (kind == LayerKind::Mtp) {\n   211\t        // the GGUF-native MTP block: eh_proj over concat(enorm(embedding), hnorm(hidden))\n   212\t        add(\"nextn.eh_proj.weight\", {2 * N, N});\n   213\t        add(\"nextn.enorm.weight\", {N});\n   214\t        add(\"nextn.hnorm.weight\", {N});\n   215\t        add(\"nextn.shared_head_norm.weight\", {N});\n   216\t    }\n   217\t    return t;\n   218\t}\n   219\t\n   220\t/// The tensors outside the layers, by family.  (Flash-Next's output_norm, PLE and n-gram tables are not listed:\n   221\t/// the published files place them differently, and their loaders check them.)\n   222\tinline std::vector<TensorWant> global_tensors(const ModelGeometry& g) {\n   223\t    std::vector<TensorWant> t;\n   224\t    t.push_back({\"token_embd.weight\", {g.n_embd, g.n_vocab}});\n   225\t    t.push_back({\"output.weight\", {g.n_embd, g.n_vocab}});\n   226\t    if (g.has_hyper_connections()) {\n   227\t        t.push_back({\"output_hc_down.weight\", {g.hc_dim(), g.hc_lr}});\n   228\t        t.push_back({\"output_hc_up.weight\", {g.hc_lr, g.hc_dim()}});\n   229\t        t.push_back({\"output_hc_norm.weight\", {g.hc_dim()}});\n   230\t    } else {\n   231\t        t.push_back({\"output_norm.weight\", {g.n_embd}});\n   232\t    }\n   233\t    return t;\n   234\t}\n   235\t\n   236\t/// Whether the family's table names every blk.* tensor its files carry (then an unnamed one is an error).\n   237\tinline bool layout_table_complete(const ModelGeometry& g) { return g.family == strata::ModelFamily::Qwen35Moe; }\n   238\t\n   239\t/// Checks the model `m` (all shards) against the layout table of `g`.  `checked` counts the tensors found.\n   240\tinline bool check_gguf_layout(const strata::GgufModel& m, const ModelGeometry& g, std::string& err,\n   241\t                              size_t* checked = nullptr) {\n   242\t    std::set<std::string> named;\n   243\t    size_t n = 0;\n   244\t    auto check = [&](const std::string& name, const std::vector<int64_t>& shape) {\n   245\t        named.insert(name);\n   246\t        size_t s = 0;\n   247\t        const strata::TensorInfo* t = m.find(name, &s);\n   248\t        if (!t) {\n   249\t            err = \"missing \" + name;\n   250\t            return false;\n   251\t        }\n   252\t        bool same = t->shape.size() == shape.size();\n   253\t        for (size_t i = 0; same && i < shape.size(); ++i) same = t->shape[i] == (uint64_t) shape[i];\n   254\t        if (!same) {\n   255\t            std::string got, want;\n   256\t            for (uint64_t d : t->shape) got += (got.empty() ? \"\" : \", \") + std::to_string(d);\n   257\t            for (int64_t d : shape) want += (want.empty() ? \"\" : \", \") + std::to_string(d);\n   258\t            err = name + \" is [\" + got + \"], the \" + strata::model_family_title(g.family) + \" layout wants [\" + want + \"]\";\n   259\t            return false;\n   260\t        }\n   261\t        if (!m.in_bounds(*t, s)) {\n   262\t            err = name + \" (\" + t->type_name() + \") has no known size inside \" + m.shard(s).path();\n   263\t            return false;\n   264\t        }\n   265\t        ++n;\n   266\t        return true;\n   267\t    };\n   268\t    for (const TensorWant& w : global_tensors(g))\n   269\t        if (!check(w.name, w.shape)) return false;\n   270\t    for (int64_t l = 0; l < g.n_layers + g.n_mtp_layers; ++l)\n   271\t        for (const TensorWant& w : layer_tensors(g, l))\n   272\t            if (!check(\"blk.\" + std::to_string(l) + \".\" + w.name, w.shape)) return false;\n   273\t    if (layout_table_complete(g)) {\n   274\t        for (size_t s = 0; s < m.size(); ++s)\n   275\t            for (const strata::TensorInfo& t : m.shard(s).tensors())\n   276\t                if (!named.count(t.name)) {\n   277\t                    err = t.name + \" is not in the \" + std::string(strata::model_family_title(g.family)) + \" layout\";\n   278\t                    return false;\n   279\t                }\n   280\t    }\n   281\t    if (checked) *checked = n;\n   282\t    return true;\n   283\t}\n   284\t\n   285\t}  // namespace strata::core\n","exit_code":0,"status":"completed"}}
