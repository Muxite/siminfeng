F', '        result.update(status=\\\"unavailable\\\", reason=str(exc))\\\\n        result[\\\"ldd\\\"][\\\"reason\\\"] = str(exc)\\\\n    # Host ELF')\nopen(p,'w').write(s)\nPY\nPYTHONDONTWRITEBYTECODE=1 python - <<'PY'\nimport json, sys, time\nfrom pathlib import Path\nsys.path.insert(0, 'cc/build_engine')\nfrom host_linkage import collect_host_linkage\nstart = time.monotonic()\nr = collect_host_linkage('builds/results/shot-2/engine-image.docker.tar', temp_parent='artifacts/codexN3')\nr['archive'] = 'builds/results/shot-2/engine-image.docker.tar'\nr['elapsed_seconds'] = round(time.monotonic() - start, 3)\nPath('artifacts/codexN3/shot-2-real-archive.json').write_text(json.dumps(r, indent=2) + '\\\\n')\nprint(json.dumps(r, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
