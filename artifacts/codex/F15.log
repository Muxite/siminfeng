from __future__ import annotations

import time
import asyncio
import copy
import uuid
from datetime import datetime,timezone

from .builder_mode import builder_mode

from .compiler import VerifierBindings,input_port
from .contracts import ResearchError
from .native import run_native_workflow
from .planning import selected_plan_source


def stamp():return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


class Scheduler:
    def __init__(self,store,runner,factory,binder,*,library,planning=None,progress_sink=None,evidence=None):
        self.store,self.runner,self.factory,self.binder=store,runner,factory,binder
        self.library,self.planning,self.progress_sink=library,planning,progress_sink
        self.evidence=evidence

    async def run(self,run_id,brief_ref,protected):
        run=self.store.get_run(run_id);submission=run['submission'];mode=selected_plan_source(submission)
        configuration=self.store.read_record(submission['configuration_ref'])
        operator=configuration.get('operator',configuration)
        # cc.* is read solely from the captured, validated operator record.
        from .operator_config import OperatorConfiguration
        approved=OperatorConfiguration.from_mapping(operator,resolve_profile=lambda ref:self.store.read_record(ref))
        settings=approved.snapshot()['cc']
        snapshot_ref=protected.get('library_snapshot_ref') or self.library.snapshot(candidate_pins=protected.get('candidate_pins',()))
        resources_ref=protected['resource_inventory_ref']
        source_ref=settings['static_template_ref'];acceptance_ref=None
        if mode=='planned':
            if self.planning is None:raise ResearchError('planner_unavailable','Native planned path is not initialized')
            proposed=await self.planning.run(run_id,brief_ref,snapshot_ref,resources_ref,settings['plan_policy_ref'],protected)
            if not proposed.get('accepted'):return proposed
            source_ref=proposed['proposal_ref'];acceptance_ref=proposed['decision_ref']
        try:
            plan_ref=self.binder.freeze(source_ref,brief_ref,snapshot_ref,resources_ref,settings['plan_policy_ref'],submission['configuration_ref'],
                plan_source=mode,acceptance_ref=acceptance_ref,run_inputs=protected.get('run_inputs',{}),authority_ceiling=protected.get('authority_ceiling'))
        except ResearchError as exc:
            if exc.code!='plan_infeasible' or not exc.details.get('check_result_ref'):raise
            from .planning import PlanOutcomeController
            checks=self.store.read_record(exc.details['check_result_ref'],contract_id='deterministic-check-result')
            reasons=[{'check_id':r['check_id'],'detail':r['reason'][:300]} for r in checks['results'] if r['outcome']!='PASS'][:20]
            outcome,linked=(self.planning.outcomes if self.planning else PlanOutcomeController(self.store)).record(run_id,plan_source=mode,brief_ref=brief_ref,
                trigger='proposal_rejected',reasons=reasons,source_ref=source_ref,check_result_ref=exc.details['check_result_ref'])
            return {'accepted':False,'outcome_ref':outcome,'linked_run_id':linked}
        return await self.execute_plan(run_id,plan_ref,protected)

    def _committed_node(self, run_id, node_id, plan):
        from .binding import committed_output_proof
        nodes = {node['node_id']: node for node in plan['nodes']}
        if node_id not in nodes:
            raise ResearchError('unaccepted_input', 'Producer is outside the frozen plan')
        node = nodes[node_id]
        proof = committed_output_proof(self.store, run_id, node_id)
        parents = []
        for _, gate in proof['gates']:
            ref = gate['node_contract_ref']
            parent = self.store.read_record(ref, contract_id='node-execution-contract')
            work = [item for item in parent['subnodes'] if item['role'] == 'work']
            if (parent['run_id'] != run_id or parent['node_id'] != node_id or parent['attempt_id'] != proof['receipt']['attempt_id']
                    or parent['configuration_ref'] != plan['configuration_ref'] or parent['policy_ref'] != plan['policy_ref']
                    or parent['template_ref'] != plan['source_ref'] or parent['node_limits'] != node['limits']
                    or len(work) != 1 or work[0]['subnode_id'] != node_id
                    or work[0]['capsule_ref']['sha256'] != node['cc']['declaration_sha256']):
                raise ResearchError('unaccepted_input', 'Committed producer contract differs from the frozen run/node')
            declaration = self.store.read_record(work[0]['capsule_ref'], contract_id='capsule-declaration')
            template = self.store.read_record(work[0]['template_ref'])
            if (declaration['identity']['name'] != node['cc']['cc_name']
                    or declaration['identity']['version_label'] != node['cc']['cc_version'] or template['cc'] != node['cc']):
                raise ResearchError('unaccepted_input', 'Committed producer has another selected declaration')
            parents.append((ref, parent))
        if len(parents) != 1:
            raise ResearchError('unaccepted_input', 'Node has no unique actual advancing parent contract')
        return dict(proof, parent_ref=parents[0][0], parent=parents[0][1])

    def _accepted_compiler_brief(self,run_id,plan):
        """Only this run's real externally committed Compiler Brief transfers."""
        from .binding import committed_output_proof
        from .contracts import contract_schema
        proof=committed_output_proof(self.store,run_id,'intention_compiler')
        if proof['outputs']!={'brief':plan['brief_ref']} or len(proof['gates'])!=1:
            raise ResearchError('unaccepted_input','Frozen Brief lacks its exact same-run Compiler commit')
        gate=proof['gates'][0][1];parent_ref=gate['node_contract_ref']
        parent=self.store.read_record(parent_ref,contract_id='node-execution-contract')
        run=self.store.get_run(run_id);brief=self.store.read_record(plan['brief_ref'],contract_id='research-brief')
        request=[item for item in parent['inputs'] if item['name']=='request']
        outputs=[item for item in parent['outputs'] if item['name']=='brief']
        if (self.store.record_kind(parent_ref)!='node-execution-contract' or gate['contract_ref']!=parent_ref
                or parent['run_id']!=run_id or parent['node_id']!='intention_compiler'
                or parent['attempt_id']!=proof['receipt']['attempt_id'] or parent['required_outputs']!=['brief']
                or parent['configuration_ref']!=plan['configuration_ref'] or parent['policy_ref']!=plan['policy_ref']
                or run['submission'].get('configuration_ref')!=plan['configuration_ref']
                or len(request)!=1 or request[0]['artifact_refs']!=[run['submission'].get('intake_ref')]
                or brief['intake_ref']!=run['submission'].get('intake_ref') or len(outputs)!=1
                or contract_schema(outputs[0]['contract_id'])!=contract_schema('research-brief')):
            raise ResearchError('unaccepted_input','Original Compiler Brief context/output/run provenance differs')
        intent=committed_output_proof(self.store,run_id,'intention_compiler',subnode_id='intent',parent_ref=parent_ref)
        if intent['outputs']!={'intent':brief['intent_ref']}:
            raise ResearchError('unaccepted_input','Compiler Brief names another internally committed Intent')
        self.store.read_record(brief['intake_ref'],contract_id='qualified-intake')
        return plan['brief_ref']

    def _derived_run_input(self,run_id,plan,node,port,ref,baseline):
        """Original protected Brief/scope derivation, never generic Ref access."""
        key=port.get('run_input_key')
        if key=='brief':
            return ref==self._accepted_compiler_brief(run_id,plan)
        if key!='search_scope':return False
        if (port['name']!='search_scope' or self.store.record_kind(ref)!='search-scope'
                or node not in plan['nodes'] or not plan['frozen']):
            raise ResearchError('input_authority','Search scope is not its exact indexed frozen node input')
        scope=self.store.read_record(ref,contract_id='search-scope')
        brief=self._accepted_compiler_brief(run_id,plan)
        bounds_ref=self.binder.search_bounds_ref
        if bounds_ref is None:raise ResearchError('input_authority','Original protected Search bounds are unavailable')
        bounds=self.store.read_record(bounds_ref)
        inventory=self.store.read_record(plan['resource_inventory_ref'],contract_id='resource-inventory')
        local=[item for item in inventory['resources'] if item['resource_key']=='local_document_buffer']
        documents=[]
        if 'local_documents' in scope['connectors']:
            if (len(local)!=1 or local[0]['available'] is not True or local[0]['kind'] not in {'file','dataset','repository'}
                    or local[0]['ref'] is None or local[0]['ref'] not in baseline):
                raise ResearchError('input_authority','Search local text is outside the original frozen inventory/read ceiling')
            buffer_ref=local[0]['ref'];self.store.read_blob(buffer_ref)
            try:kind=self.store.record_kind(buffer_ref)
            except ResearchError as error:
                if error.code!='evidence_unavailable':raise
                kind=None
            if kind=='local-document-buffer':
                from .run_inputs import local_document_refs
                actual_brief=self.store.read_record(brief,contract_id='research-brief')
                documents=local_document_refs(self.store,buffer_ref,inventory_ref=plan['resource_inventory_ref'],
                    intake_ref=actual_brief['intake_ref'],run_id=run_id)
                if not documents or any(ref not in baseline for ref in documents):
                    raise ResearchError('input_authority','Current run documents are empty or outside original reads')
            else:documents=[buffer_ref]
        source=self.store.read_record(plan['source_ref'],contract_id='static-template' if plan['plan_source']=='static' else 'plan-proposal')
        if (scope['brief_ref']!=brief or scope['local_document_refs']!=documents
                or bounds.get('schema')!='ai4r-search-bounds:1'
                or not isinstance(bounds.get('id'),str) or not bounds['id']
                or set(bounds)!={'schema','id','connectors','max_queries','max_hits_per_query'}
                or any(scope[name]!=bounds[name] for name in ('connectors','max_queries','max_hits_per_query'))
                or scope['topic_hints']!=([] if plan['plan_source']=='static' else source.get('topic_hints',[]))):
            raise ResearchError('input_authority','Original binder-created Search scope disagrees with frozen run inputs')
        return True

    @staticmethod
    def _ancestors(plan, predecessors):
        nodes = {node['node_id']: node for node in plan['nodes']}
        reached = set()
        pending = list(predecessors)
        while pending:
            key = pending.pop()
            if key not in nodes:
                raise ResearchError('unaccepted_input', 'Unknown frozen ancestor')
            if key not in reached:
                reached.add(key)
                pending.extend(nodes[key]['predecessors'])
        return reached

    def _host_ref(self,run_id,key,protected,predecessors,plan_ref,*,node=None):
        plan = self.store.read_record(plan_ref, contract_id='run-plan')
        if node is None or node not in plan['nodes']:
            raise ResearchError('host_record_unavailable', 'Host input has no exact frozen consumer node')
        if key=='run_configuration':
            if protected['configuration_ref'] != plan['configuration_ref']:
                raise ResearchError('host_record_unavailable', 'Prepared configuration differs from the frozen plan')
            return protected['configuration_ref']
        if key in {'screening_rubric','environment_lock'}:
            refs=protected.get('host_records',{})
            if key not in refs:raise ResearchError('host_record_unavailable','Protected host record is not initialized: '+key)
            ref = refs[key]
            if key == 'screening_rubric':
                row = self.library.get(node['cc']['cc_name'], node['cc']['cc_version'])
                if (node['cc']['cc_name'] != 'research.screening' or row['declaration_ref']['sha256'] != node['cc']['declaration_sha256']
                        or row['body_refs'].get('screening_rubric.json') != ref):
                    raise ResearchError('host_record_unavailable', 'Prepared rubric differs from selected admitted body')
                self.store.read_record(ref, contract_id='screening-rubric')
            else:
                inventory = self.store.read_record(plan['resource_inventory_ref'], contract_id='resource-inventory')
                matches = [item for item in inventory['resources'] if item['resource_key'] == key]
                if len(matches) != 1 or matches[0]['available'] is not True or matches[0]['ref'] != ref:
                    raise ResearchError('host_record_unavailable', 'Prepared lock differs from captured inventory')
                self.store.read_record(ref, contract_id='environment-lock')
            return ref
        ancestors = self._ancestors(plan, predecessors)
        proofs = {key: self._committed_node(run_id, key, plan) for key in plan['topological_order'] if key in ancestors}
        if key=='gate_decision_index':
            entries=[{'node_id':key,'gate_decision_ref':proofs[key]['gates'][0][0]} for key in plan['topological_order'] if key in proofs]
            return self.store.put_record('gate-decision-index',{'schema_version':'1.0.0','id':'gate_decision_index','run_plan_ref':plan_ref,'entries':entries},scope={'run_id':run_id})
        direct = {'screening_result': ('research.screening', 'screening_result'),
                  'execution_receipt': ('research.benchmark', 'execution_receipt'),
                  'provisioning_receipt': ('research.benchmark', 'provisioning_receipt')}
        if key in direct:
            producer, port = direct[key]
            matches = [proof['outputs'][port] for name, proof in proofs.items()
                       if next(item for item in plan['nodes'] if item['node_id'] == name)['cc']['cc_name'] == producer
                       and port in proof['outputs']]
            if len(matches) != 1:
                raise ResearchError('host_record_unavailable', 'Required host output has no exact accepted producer/port')
            return matches[0]
        if key == 'build_receipt':
            matches = []
            for name, proof in proofs.items():
                selected = next(item for item in plan['nodes'] if item['node_id'] == name)
                if selected['cc']['cc_name'] != 'research.builder':
                    continue
                producer_inputs = {port['name']: port['artifact_refs'][0] for port in proof['parent']['inputs']}
                for row in self.store.iter_records(run_id=run_id, kinds=('host-record-proposal',)):
                    offered = row['record']
                    if (offered.get('key') != key or offered.get('node_id') != name
                            or offered.get('attempt_id') != proof['receipt']['attempt_id'] or offered.get('subnode_id') != name):
                        continue
                    captures = [item['record'] for item in self.store.iter_records(run_id=run_id,kinds=('captured-output',))
                        if item['record']['node_id'] == name and item['record']['subnode_id'] == name
                        and item['record']['attempt_id'] == proof['receipt']['attempt_id']
                        and item['record']['invocation_id'] == offered.get('invocation_id')]
                    if (len(captures) != len(proof['outputs'])
                            or {item['output_port']:item['artifact_ref'] for item in captures} != proof['outputs']):
                        raise ResearchError('host_record_unavailable', 'Host proposal lacks its exact original invocation output capture')
                    observations = [observed['record'] for observed in self.store.iter_records(run_id=run_id,kinds=('invocation-observation',))
                        if observed['record']['node_contract_ref'] == proof['parent_ref'] and observed['record']['subnode_id'] == name
                        and observed['record']['attempt_id'] == proof['receipt']['attempt_id']
                        and observed['record']['outcome'] == 'success' and observed['record']['failure_reason_code'] is None
                        and set((ref['id'],ref['sha256']) for ref in observed['record']['output_refs']) == set((ref['id'],ref['sha256']) for ref in proof['outputs'].values())]
                    if len(observations) != 1:
                        raise ResearchError('host_record_unavailable', 'Host proposal has no exact accepted original producing observation')
                    observed = observations[0]
                    producing = self.store.read_record(observed['contract_ref'],contract_id='subnode-execution-contract')
                    starts = [item['record'] for item in self.store.iter_records(run_id=run_id,kinds=('model-call-start',))
                        if item['record'].get('contract_ref') == observed['contract_ref']
                        and item['record'].get('invocation_id') == offered.get('invocation_id')]
                    mode = builder_mode(self.store.read_record(producing['bindings'][0]['declaration_ref']))
                    agent_builder = mode == 'agent'
                    loop_builder = mode == 'loop'
                    if (producing['node_contract_ref'] != proof['parent_ref'] or producing['subnode_id'] != name
                            or producing['bindings'][0]['role'] != 'work'
                            or producing['bindings'][0]['declaration_ref']['sha256'] != selected['cc']['declaration_sha256']
                            or not (1 <= len(starts) <= 20 if agent_builder else
                                    1 <= len(starts) <= 3 if loop_builder else len(starts) == 1)):
                        raise ResearchError('host_record_unavailable', 'Host proposal differs from the actual source/native producing attempt')
                    receipt_contract = ('urn:ai4r:prediction-build-receipt:4.0.0' if agent_builder else
                        'urn:ai4r:prediction-build-receipt:3.0.0' if loop_builder else 'urn:ai4r:prediction-build-receipt:2.0.0'
                        if mode == 'prediction' else 'build-receipt')
                    receipt = self.store.read_record(offered['ref'], contract_id=receipt_contract)
                    if (receipt['manifest_ref'] != proof['outputs'].get('manifest') or receipt['archive_ref'] != proof['outputs'].get('bundle')
                            or receipt['blueprint_ref'] != producer_inputs.get('blueprint') or receipt['environment_ref'] != producer_inputs.get('lock')
                            or receipt['readiness'] != 'READY'
                            or (receipt['schema_version'] not in {'3.0.0', '4.0.0'} and (receipt['trial_executed'] or receipt['packages_installed']))
                            or (receipt['schema_version'] == '4.0.0' and (receipt['trial_executed'] is not True
                                or receipt['development_only'] is not True or receipt['model_call_count'] != len(starts)
                                or not 1 <= receipt['tool_operation_count'] <= 40 or not 0 <= receipt['execution_job_count'] <= 12))
                            or (receipt['schema_version'] == '3.0.0' and receipt['candidate_count'] != len(starts))):
                        raise ResearchError('host_record_unavailable', 'Host receipt differs from accepted manifest/bundle/input closure')
                    if receipt['schema_version'] == '4.0.0':
                        journal_ref = receipt['journal_ref']
                        if self.store.record_kind(journal_ref) != 'builder_agent_execution':
                            raise ResearchError('host_record_unavailable', 'Agent Builder receipt lacks its protected execution journal')
                        journal = self.store.read_record(journal_ref)
                        if (journal.get('schema') != 'ai4r-builder-agent-execution:1'
                                or journal.get('contract_ref') != observed['contract_ref']
                                or journal.get('invocation_id') != offered.get('invocation_id')
                                or journal.get('manifest_ref') != proof['outputs'].get('manifest')
                                or journal.get('archive_ref') != proof['outputs'].get('bundle')
                                or journal.get('snapshot_sha256') != receipt['workspace_sha256']
                                or journal.get('submitted_snapshot_sha256') != receipt['submitted_snapshot_sha256']):
                            raise ResearchError('host_record_unavailable', 'Agent Builder journal differs from its receipt and accepted artifacts')
                    matches.append(offered['ref'])
            if len(matches) == 1:
                return matches[0]
        raise ResearchError('host_record_unavailable','Required accepted typed host record is unavailable: '+key)


    async def execute_plan(self,run_id,plan_ref,protected):
        plan=self.store.read_record(plan_ref,contract_id='run-plan')
        if not plan['frozen']:raise ResearchError('unfrozen_plan','Dispatch requires the committed frozen graph')
        self.binder.validate_acceptance(plan)
        finite_owner=getattr(self.binder,'finite_e1',None)
        if finite_owner is not None and protected.get('finite_e1_binding_ref') is not None:
            finite_owner.validate_dispatch(run_id,plan,protected)
        if self.evidence is not None:self.evidence.bind_plan(run_id,plan_ref)
        nodes={node['node_id']:node for node in plan['nodes']};states={};started=time.monotonic()
        snapshot=self.store.read_record(plan['library_snapshot_ref'],contract_id='library-snapshot')
        entries={(e['cc_name'],e['cc_version'],e['declaration_sha256']):e for e in snapshot['entries']}
        for node in plan['nodes']:self.store.set_node_state(run_id,node['node_id'],'pending')
        async def dispatch(node_id):
            if finite_owner is not None and protected.get('finite_e1_binding_ref') is not None:
                finite_owner.validate_dispatch(run_id,plan,protected)
            if self.store.cancellation_requested(run_id):raise ResearchError('cancelled','No new dispatch after cancellation')
            if time.monotonic()-started>=plan['limits']['time_s']:raise ResearchError('budget_exhausted','Frozen run wall-clock limit exhausted')
            node=nodes[node_id]
            failures=[p for p in node['predecessors'] if states.get(p)!='accepted']
            if failures:
                states[node_id]='skipped';self.store.set_node_state(run_id,node_id,'skipped',reason=failures[0])
                return {'node_id':node_id,'outcome':'skipped'}
            entry=entries[tuple(node['cc'][k] for k in ('cc_name','cc_version','declaration_sha256'))]
            authority=protected.get('authority_ceiling')
            if authority is None:raise ResearchError('authority_unavailable','No protected run authority ceiling')
            authority=copy.deepcopy(authority)
            baseline=list(authority['resource_reads']);derived=[];bound=[]
            for port in node['inputs']:
                if port['source_kind']=='accepted_ref':
                    ref=port['accepted_ref']
                    if ref not in baseline:
                        if not self._derived_run_input(run_id,plan,node,port,ref,baseline):
                            raise ResearchError('input_authority','External accepted input exceeds the explicit protected base ceiling')
                        derived.append(ref)
                elif port['source_kind']=='future_output':
                    future=port['future']
                    producer=next((item for item in plan['nodes'] if item['node_id']==future['producer_node']),None)
                    if (producer is None or producer['node_id'] not in self._ancestors(plan,node['predecessors'])
                            or not any(item['name']==future['port'] and item['artifact_type']==future['artifact_type'] for item in producer['outputs'])):
                        raise ResearchError('unaccepted_input','Future edge is outside the exact frozen typed producer/dependency')
                    proof=self._committed_node(run_id,producer['node_id'],plan)
                    ref=proof['outputs'].get(future['port'])
                    if ref is None:raise ResearchError('unaccepted_input','Future port has no committed original output')
                    derived.append(ref)
                else:
                    key=port['run_input_key']
                    ref=self._host_ref(run_id,key,protected,node['predecessors'],plan_ref,node=node)
                    if key in {'run_configuration','screening_rubric','environment_lock'}:
                        if ref not in baseline:raise ResearchError('input_authority','Prepared host resource exceeds the explicit protected base ceiling')
                    else:derived.append(ref)
                own=next(p for p in entry['input_ports'] if p['name']==port['name'])
                bound.append(input_port(port['name'],own['schema_ref'],ref))
            for ref in derived:
                if ref not in authority['resource_reads']:authority['resource_reads'].append(ref)
            outputs=[{'name':p['name'],'contract_id':next(v['schema_ref'] for v in entry['output_ports'] if v['name']==p['name']),
                      'version':self.factory._version(next(v['schema_ref'] for v in entry['output_ports'] if v['name']==p['name'])),'required':p['required']} for p in node['outputs']]
            parent_ref=self.factory.prepare_parent(run_id,node_id,[{'subnode_id':node_id,'cc':node['cc'],'depends_on':[]}],inputs=bound,outputs=outputs,
                objective=node['objective'],requirement_ids=node['requirement_ids'] or node['deliverable_ids'],limits=node['limits'],policy_ref=plan['policy_ref'],
                configuration_ref=plan['configuration_ref'],template_ref=plan['source_ref'],authority_ceiling=authority)
            work_ref,check_plan_ref,bundle=self.factory.bind_subnode(parent_ref,node_id,bound,role='work')
            parent=self.store.read_record(parent_ref);assignments={self.store.read_record(s['template_ref'])['output_port']:s['subnode_id'] for s in parent['subnodes'] if s['role']=='verifier'}
            processing_began=stamp();processing_clock=time.monotonic()
            try:
                self.runner.prepare_node_check_plan(parent_ref)
                dispatch_scope={'run_id':run_id,'node_id':node_id,'node_contract_ref':parent_ref,'run_plan_ref':plan_ref,
                    'predecessors':list(node['predecessors']),
                    'predecessor_commits':self.store.predecessor_snapshot(run_id,node['predecessors']),
                    'bound_input_refs':[{'name':p['name'],'ref':ref} for p in bound for ref in p['artifact_refs']]}
                result=await self.runner.run(work_ref,check_plan_ref,bundle_id=bundle,
                    verifier_contract_refs=VerifierBindings(self.factory,parent_ref,work_ref,assignments),dispatch=dispatch_scope)
            except BaseException as error:
                timing=self.runner.dispatch_timing(parent_ref)
                began=timing['started_at'] if timing else processing_began
                clock=timing['started_monotonic_s'] if timing else processing_clock
                try:
                    self.runner.capture_start_failure(parent_ref,started_at=began,elapsed_s=time.monotonic()-clock,
                        error=error,phase='planned',run_plan_ref=plan_ref,cc=node['cc'],check_pins=node['check_pins'])
                except Exception as capture_error:
                    # Missing complete source closure stays explicit. No worker,
                    # plan, Gate or timestamp is invented to make it terminal.
                    self.store.append_record('dispatch-finalization-unavailable',{'id':'dispatch-unavailable:'+uuid.uuid4().hex,
                        'run_id':run_id,'node_id':node_id,'attempt_id':node_id+'-a1','node_contract_ref':parent_ref,
                        'reason':getattr(capture_error,'code',type(capture_error).__name__)})
                states[node_id]='failed'
                reason=getattr(error,'code',type(error).__name__)
                self.store.set_node_state(run_id,node_id,'failed',attempt_id=node_id+'-a1',reason=reason)
                if (isinstance(error,asyncio.CancelledError) or self.store.cancellation_requested(run_id)
                        or reason in {'integrity_fault','security_fault','AUDIT_UNAVAILABLE','CONTAINMENT_UNCERTAIN','protected_stop','run_budget_exhausted'}):
                    raise
                return {'node_id':node_id,'outcome':'failed'}
            timing=self.runner.dispatch_timing(parent_ref)
            if timing is None:raise ResearchError('integrity_fault','Completed worker has no actual Scheduler start boundary')
            began=timing['started_at'];clock=timing['started_monotonic_s']
            decision_ref=await self.runner.finalize_node(parent_ref,[result],dict(result.output_refs) if result.accepted else {})
            decision=self.store.read_record(decision_ref);accepted=decision['action']=='advance';states[node_id]='accepted' if accepted else 'rejected'
            observation=self.store.read_record(result.observation_ref)
            self.runner.capture_dispatch(parent_ref,decision_ref,[result],started_at=began,elapsed_s=time.monotonic()-clock,phase='planned',run_plan_ref=plan_ref,cc=node['cc'],check_pins=node['check_pins'])
            stop_ref=getattr(result,'protected_stop_ref',None)
            if stop_ref is not None:
                stopped=self.store.read_record(stop_ref)
                failed=self.store.read_record(stopped['failure_observation_ref'],contract_id='invocation-observation')
                if (self.store.record_kind(stop_ref)!='protected-invocation-stop'
                        or stopped.get('schema')!='ai4r-protected-invocation-stop:1' or stopped.get('run_id')!=run_id
                        or stopped.get('node_id')!=node_id or stopped.get('contract_ref')!=observation['contract_ref']
                        or stopped.get('worker_observation_ref')!=result.observation_ref
                        or any(failed[key]!=observation[key] for key in ('run_id','node_id','attempt_id','node_contract_ref'))
                        or stopped.get('reason_code') not in {'integrity_fault','security_fault','AUDIT_UNAVAILABLE','CONTAINMENT_UNCERTAIN','run_budget_exhausted'}):
                    raise ResearchError('protected_stop','Protected stop receipt does not join the exact completed invocation')
                fault=stopped.get('executor_fault')
                from .private_rpc import fault_cause_text
                cause=(' Executor cause: %s %s at %s in %s%s.'%(fault.get('exception_class'),fault.get('code') or '',fault.get('frame'),fault.get('operation'),fault_cause_text(fault))
                       if isinstance(fault,dict) else '')
                raise ResearchError('protected_stop','An actual protected integrity/security/persistence/run-budget failure halts the whole run.'+cause)
            if observation['failure_reason_code'] in {'integrity_fault','security_fault','AUDIT_UNAVAILABLE'}:
                raise ResearchError('protected_stop','A protected integrity/security/persistence fault halts the whole run')
            return {'node_id':node_id,'outcome':states[node_id],'decision_ref':decision_ref}
        try:
            await run_native_workflow(plan['topological_order'],dispatch,run_id=run_id,progress_sink=self.progress_sink)
        except BaseException:
            self.store.set_run_state(run_id,'halted',reason='protected_stop');raise
        terminal='completed' if all(value=='accepted' for value in states.values()) else 'partial'
        self.store.set_run_state(run_id,terminal)
        return {'status':terminal,'plan_ref':plan_ref,'node_states':states}
"""Operator-authored frozen Pi task materials for the research pipeline."""
from __future__ import annotations

import hashlib
import inspect
import json
import platform
from pathlib import Path

from .contracts import validate
from .pi_protocol import _gauss_legendre, validate_pi_request
from .state import json_bytes


def _baseline_source() -> bytes:
    function = inspect.getsource(_gauss_legendre)
    source = (
        "import json\n"
        "import math\n"
        "from decimal import Decimal, localcontext\n"
        "from pathlib import Path\n\n"
        + function
        + "\n\ndef approximate_pi(digits):\n"
        "    return _gauss_legendre(digits)\n\n"
        "if __name__ == '__main__':\n"
        "    request = json.loads(Path('/resources/validation/data.json').read_text(encoding='utf-8'))\n"
        "    digits = request['digits']\n"
        "    print(json.dumps({'digits': digits, 'decimal': approximate_pi(digits)}, separators=(',', ':')))\n"
    )
    return source.encode("utf-8")


def _snapshot(store, *, id, kind, origin, revision, files, environment_ref, license_text):
    value = {
        "schema_version": "1.0.0", "id": id, "kind": kind, "origin": origin,
        "revision": revision,
        "files": [{"path": path, "artifact_ref": store.put_blob(raw, media_type=media),
                   "media_type": media, "audience": "authorized researcher"}
                  for path, raw, media in files],
        "access": "read-only", "license": license_text, "availability": "available",
        "environment_ref": environment_ref,
    }
    validate("resource-snapshot", value)
    return store.put_record("resource-snapshot", value)


def capture_pi_task(store, reference_directory, *, accepted_inputs=None):
    """Capture a complete, explicit Pi task and root-only scorer profile.

    `accepted_inputs`, when supplied, fills the three artifacts produced by the
    Builder: poc_manifest, poc_artifact_bundle, and build_receipt.
    """
    requirements_ref = store.put_blob(b"", media_type="text/plain")
    approval_ref = store.put_blob(json_bytes({
        "schema": "ai4r-pi-stdlib-environment-approval:1",
        "purpose": "Operator-authored Pi algorithm experiment; Python standard library only",
        "platform_fact": [platform.system(), platform.machine(), platform.python_version()],
        "network": "none", "gpu": False,
    }), media_type="application/json")
    lock = {
        "schema_version": "1.0.0", "id": "pi_stdlib_environment",
        "platform": platform.system().lower() + "-" + platform.machine().lower(),
        "requirements_ref": requirements_ref, "package_refs": [], "approval_ref": approval_ref,
    }
    validate("environment-lock", lock)
    lock_ref = store.put_record("environment-lock", lock)

    request_bytes = json_bytes({"schema": "ai4r-pi-cases:1", "digits": 100_000})
    request = validate_pi_request(request_bytes)
    validation_ref = _snapshot(store, id="pi_validation_resource", kind="public validation request",
        origin="Explicit operator-authored Pi protocol request; no hidden labels or answer are included",
        revision=hashlib.sha256(request_bytes).hexdigest(),
        files=[("data.json", request_bytes, "application/json")], environment_ref=lock_ref,
        license_text="Operator-authored protocol data")

    baseline_bytes = _baseline_source()
    baseline_ref = _snapshot(store, id="pi_baseline_resource", kind="immutable baseline implementation",
        origin="Captured standard-library Decimal Gauss-Legendre reference implementation",
        revision=hashlib.sha256(baseline_bytes).hexdigest(),
        files=[("baseline.py", baseline_bytes, "text/x-python")], environment_ref=lock_ref,
        license_text="First-party operator-authored baseline")

    # These provenance documents say exactly how the task was selected. They do
    # not claim search, screening, or prior scientific stages took place.
    brief_ref = store.put_blob(json_bytes({"schema": "ai4r-pi-task-provenance:1",
        "origin": "explicit_operator_assignment", "description": "Benchmark a candidate Python implementation of truncated decimal Pi",
        "prior_search_or_screening_claimed": False}))
    opportunity_ref = store.put_blob(json_bytes({"schema": "ai4r-pi-task-provenance:1",
        "origin": "explicit_operator_assignment", "selection": "fixed arithmetic benchmark",
        "prior_search_or_screening_claimed": False}))

    blueprint = {
        "schema_version": "2.0.0", "id": "hypothesis_blueprint",
        "brief_ref": brief_ref, "opportunity_ref": opportunity_ref,
        "claim": "The candidate computes truncated decimal Pi faster than the immutable Decimal Gauss-Legendre baseline at 100000 places.",
        "mechanism": "An alternative arithmetic algorithm or representation may reduce the work required to produce the requested decimal prefix.",
        "independent_variable": "Candidate implementation in poc_patch.py versus captured baseline.py",
        "dependent_variables": ["elapsed_s"],
        "baseline_identity": {"resource_ref": baseline_ref, "revision": hashlib.sha256(baseline_bytes).hexdigest(),
                              "entry_point": "baseline.py"},
        "validation_resource_ref": validation_ref,
        "resource_refs": [baseline_ref, validation_ref], "environment_ref": lock_ref,
        "metrics": [{"metric_id": "elapsed_s", "unit": "s",
            "measurement": "Protected executor wall time for producing and emitting the exact requested Pi prefix",
            "direction": "lower_better", "aggregation": "median", "target_id": None,
            "valid_min": 0, "valid_max": None}],
        "outcome_rules": [{"metric_id": "elapsed_s",
            "success": {"operand": "treatment", "comparator": "lt", "reference": "baseline", "factor": 1, "offset": 0},
            "falsification": {"operand": "treatment", "comparator": "ge", "reference": "baseline", "factor": 1, "offset": 0},
            "middle": "INCONCLUSIVE", "conditional_rule": None, "conditional_meaning": None}],
        "repeat_count": 5, "seed": 42, "seed_policy": "fixed_same_for_all_runs",
        "implementation_scope": {"poc_change_scope": ["Implement approximate_pi(digits) in poc_patch.py",
                "max_patch_files counts implementation files only; tests.py is a separate required Builder development file and is not counted"],
            "must_not_change": ["baseline", "public_validation_request", "trusted_scoring_protocol", "benchmark_cases"],
            "max_patch_files": 1},
        "constraints": [], "verification_plan": [
            "Verify output schema and exact requested decimal length for every measured and unseen precision",
            "Verify decimal prefixes against the independently computed host-owned reference",
            "Compare five baseline and treatment timings at 10000 and 100000 places",
            "Check additional host-selected precisions and boundary requests at 0, 1, 2, and 17 places",
            "Preserve failed, incorrect, or slower outcomes without converting them into success"],
    }
    validate("hypothesis-blueprint", blueprint)
    blueprint_ref = store.put_record("hypothesis-blueprint", blueprint)

    # The private reference bytes/path and host-selected unseen digits stay in
    # this host return value; only the scorer receives them.
    from .trusted_pi import capture_pi_profile
    scoring_profile = capture_pi_profile(reference_directory, validation_ref)
    approved = [{"lock_ref": lock_ref, "approval_ref": approval_ref,
        "platform_fact": [platform.system(), platform.machine(), platform.python_version()],
        "wheel_filenames": {}}]

    builder_inputs = {"blueprint": blueprint_ref, "baseline_resource": baseline_ref,
        "validation_resource": validation_ref, "lock": lock_ref}
    benchmark_inputs = {"hypothesis_blueprint": blueprint_ref, "baseline_resource": baseline_ref,
        "validation_resource": validation_ref, "environment_lock": lock_ref,
        "poc_manifest": None, "poc_artifact_bundle": None, "build_receipt": None}
    if accepted_inputs is not None:
        if type(accepted_inputs) is not dict or set(accepted_inputs) != {"poc_manifest", "poc_artifact_bundle", "build_receipt"}:
            raise ValueError("accepted_inputs must contain the exact three accepted Builder artifacts")
        benchmark_inputs.update(accepted_inputs)
    return {"builder_inputs": builder_inputs, "benchmark_inputs": benchmark_inputs,
        "approved_environments": approved, "scoring_profile": scoring_profile,
        "provenance": "explicit operator assignment; no prior search or screening is represented"}
"""Explicit immutable declaration context; never a worker's live Library access."""
from .contracts import ResearchError, validate
from .state import json_bytes

SCHEMA = 'urn:ai4r:planner-catalog:1.0.0'
MAX_BYTES = 2 * 1024 * 1024


def verify_catalog(value, snapshot, snapshot_ref):
    validate(SCHEMA, value)
    if value['library_snapshot_ref'] != snapshot_ref or len(json_bytes(value)) > MAX_BYTES:
        raise ResearchError('planner_catalog', 'Catalog differs from the frozen snapshot or exceeds its context ceiling')
    expected = {(e['cc_name'], e['cc_version'], e['declaration_sha256']): e
                for e in snapshot['entries'] if e['selectable_by_planner']}
    seen = set()
    for item in value['capsules']:
        pin, declaration = item['cc'], item['declaration']
        key = tuple(pin[k] for k in ('cc_name', 'cc_version', 'declaration_sha256'))
        entry = expected.get(key)
        if key in seen or entry is None or item['declaration_ref']['sha256'] != pin['declaration_sha256']:
            raise ResearchError('planner_catalog', 'Catalog has a duplicate, unavailable or mismatched capsule')
        validate('capsule-declaration', declaration)
        if (declaration['identity']['name'], declaration['identity']['version_label']) != key[:2]:
            raise ResearchError('planner_catalog', 'Declaration identity differs from its exact pin')
        for direction, field in (('inputs', 'input_ports'), ('outputs', 'output_ports')):
            ports = [{k: p[k] for k in ('name', 'artifact_type', 'schema_ref', 'required')}
                     for p in declaration['ports'][direction]]
            if ports != entry[field]:
                raise ResearchError('planner_catalog', 'Declared ports differ from the frozen snapshot')
        seen.add(key)
    if seen != set(expected):
        raise ResearchError('planner_catalog', 'Catalog omits a selectable admitted capsule')


def capture_catalog(store, library, snapshot_ref):
    snapshot = store.read_record(snapshot_ref, contract_id='library-snapshot')
    items = []
    for entry in snapshot['entries']:
        if not entry['selectable_by_planner']:
            continue
        row = library.get(entry['cc_name'], entry['cc_version'])
        ref = row['declaration_ref']
        if ref['sha256'] != entry['declaration_sha256']:
            raise ResearchError('planner_catalog', 'Live declaration differs from frozen admitted selection')
        items.append({'cc': {k: entry[k] for k in ('cc_name', 'cc_version', 'declaration_sha256')},
                      'declaration_ref': ref, 'declaration': store.read_record(ref, contract_id='capsule-declaration')})
    value = {'schema_version': '1.0.0', 'library_snapshot_ref': snapshot_ref, 'capsules': items}
    verify_catalog(value, snapshot, snapshot_ref)
    return store.put_blob(json_bytes(value), media_type='application/json')


def verify_captured_catalog(store, value, snapshot, snapshot_ref):
    """Host verifies exact source bytes as well as descriptive snapshot agreement."""
    verify_catalog(value, snapshot, snapshot_ref)
    for item in value['capsules']:
        if store.read_record(item['declaration_ref'], contract_id='capsule-declaration') != item['declaration']:
            raise ResearchError('planner_catalog', 'Catalog text differs from the pinned declaration bytes')
"""Bounded native proposals are advisory; independent checks and gates decide."""

import json
from importlib.resources import files

from ..binding import HOST_KEYS
from ..contracts import ResearchError,contract_schema
from ..native import NativePlanner
from ..planning import parse_planner_reply
from ..summary_planning import PAPER_CC_VERSION, PAPER_DELIVERY_CC, PAPER_SUMMARY_CC, is_document_summary_policy


def reachable_schema(schema):
    """The same schema with only the $defs its root can reach; validation is unchanged."""
    defs = schema.get('$defs', {})
    needed, pending = set(), [{k: v for k, v in schema.items() if k != '$defs'}]
    while pending:
        node = pending.pop()
        if isinstance(node, dict):
            for key, value in node.items():
                if key == '$ref' and isinstance(value, str) and value.startswith('#/$defs/'):
                    name = value.split('/')[2]
                    if name not in needed:
                        needed.add(name)
                        pending.append(defs[name])
                else:
                    pending.append(value)
        elif isinstance(node, list):
            pending.extend(node)
    return dict(schema, **{'$defs': {name: defs[name] for name in defs if name in needed}})


def _policy_hides(pin, policy):
    """Entries the protected policy can never accept: paper stages other than its one pinned release."""
    from ..unified_planning import is_integrated_policy
    return (pin['cc_name'] in (PAPER_SUMMARY_CC, PAPER_DELIVERY_CC) and pin['cc_version'] != PAPER_CC_VERSION
            and (is_integrated_policy(policy) or is_document_summary_policy(policy)))


def _pin(entry):
    return {k: entry[k] for k in ('cc_name', 'cc_version', 'declaration_sha256')}


def planner_views(catalog, snapshot, policy):
    """Reduced, planner-facing copies of the catalog and snapshot.

    The host keeps verifying and checking against the full records; the model
    only needs what it can act on: identity, purpose, typed ports, needs,
    limits, effects and check ids per exact pin, once. Nothing here is read back.
    """
    capsules = []
    for item in catalog.get('capsules', []):
        if _policy_hides(item['cc'], policy):
            continue
        d = item['declaration']
        ports = {side: [{k: p[k] for k in ('name', 'artifact_type', 'schema_ref', 'required', 'description') if k in p}
                        | ({'check_ids': p['check_ids']} if p.get('check_ids') else {}) for p in d['ports'][side]]
                 for side in ('inputs', 'outputs')}
        guarantees = d['guarantees']
        changes = d['changes']
        capsules.append({'cc': item['cc'], 'kind': d['identity']['kind'], 'purpose': d['identity']['summary'],
            'ports': ports, 'needs': d['needs'], 'limits': d['budget']['per_call'],
            'changes': {'effect_class': changes['effect_class'],
                'effects': [{k: e[k] for k in ('id', 'op', 'resource_key', 'reversibility', 'scope') if k in e} for e in changes['effects']],
                'invariants': changes['invariants'], 'provides': changes['provides']},
            'guarantees': {'check_ids': [c['id'] for c in guarantees['checks']], 'acceptance': guarantees['acceptance'],
                           'unanchored': guarantees['unanchored']},
            'coverage': d['coverage']})
    contracts = {'schema_version': catalog.get('schema_version', '1.0.0'),
        'library_snapshot_ref': catalog.get('library_snapshot_ref'), 'view': 'planner-reduced',
        'meaning': 'Reduced view of the pinned declarations; the host verifies and checks the complete declarations.',
        'capsules': capsules}
    entries = [{**_pin(e), **{k: e[k] for k in ('effect_class', 'network_mode', 'resource_needs', 'max_limits') if k in e}}
               for e in snapshot['entries'] if e.get('selectable_by_planner') and not _policy_hides(e, policy)]
    reduced = {'schema_version': snapshot['schema_version'], 'id': snapshot['id'], 'view': 'planner-reduced',
        'meaning': 'Selectable entries only; typed ports are listed once in capsule_contracts and check pins stay host-side.',
        'entries': entries}
    return contracts, reduced


def fill_declared_limits(raw, snapshot, policy):
    """Carrier-owned node limits: each node gets its capsule's declared max_limits.

    A node below its declared envelope cannot hold the reviews the host reserves
    for it (live run pl3: Screening at 120 s with two 60 s reviews ended
    budget_exhausted before its worker ran). Applied only when every node names a
    selectable pin and the declared envelopes fit the policy aggregate; otherwise
    the model's limits stand and plan_checks judge them.
    """
    try:
        value = json.loads(raw)
        nodes = value['nodes']
        declared = {tuple(e[k] for k in ('cc_name', 'cc_version', 'declaration_sha256')): e.get('max_limits')
                    for e in snapshot['entries'] if e.get('selectable_by_planner')}
        envelopes = [declared.get(tuple(n['cc'][k] for k in ('cc_name', 'cc_version', 'declaration_sha256'))) for n in nodes]
        aggregate = policy['aggregate_limits']
        if not isinstance(value.get('limits'), dict) or not envelopes or not all(isinstance(e, dict) for e in envelopes):
            return raw
        total = {'time_s': sum(e['time_s'] for e in envelopes), 'model_calls': sum(e['model_calls'] for e in envelopes),
                 'memory_mb': max(e['memory_mb'] for e in envelopes)}
    except (ValueError, KeyError, TypeError):
        return raw
    if any(total[d] > aggregate[d] for d in total):
        return raw
    for node, envelope in zip(nodes, envelopes):
        node['limits'] = {d: envelope[d] for d in ('time_s', 'model_calls', 'memory_mb')}
    for d in total:
        current = value['limits'].get(d)
        value['limits'][d] = min(aggregate[d], max(total[d], current if isinstance(current, (int, float)) else 0))
    return json.dumps(value, ensure_ascii=False, indent=2)


def _instructions_once(invoke):
    """The native harness repeats the system prompt as a system message inside the
    serialized conversation while the transport already carries it as system text."""
    async def call(prompt, system=None):
        if system is not None:
            try:
                messages = json.loads(prompt)
            except ValueError:
                messages = None
            if isinstance(messages, list) and all(isinstance(m, dict) for m in messages):
                prompt = json.dumps([m for m in messages if m.get('role') != 'system'], ensure_ascii=False)
        return await invoke(prompt, system=system)
    return call


def _protected_host_bindings():
    """Describe existing Binder/Scheduler inputs, without publishing live Refs.

    These records are host bindings, not missing Capsule output ports. Producer
    receipts become available only after the exact predecessor gate commits.
    The protected Binder and Scheduler still enforce every stated condition.
    """
    descriptions = {
        'screening_rubric': {
            'producer_cc': None, 'producer_output_port': None, 'direct_predecessor_required': False,
            'condition': 'Prepared rubric must equal screening_rubric.json in the exact selected admitted research.screening body.'},
        'environment_lock': {
            'producer_cc': None, 'producer_output_port': None, 'direct_predecessor_required': False,
            'condition': 'Prepared lock must equal the unique available environment_lock resource Ref in the frozen resource inventory.'},
        'run_configuration': {
            'producer_cc': None, 'producer_output_port': None, 'direct_predecessor_required': False,
            'condition': 'Host supplies the unchanged protected configuration Ref frozen into this run plan.'},
        'build_receipt': {
            'producer_cc': 'research.builder', 'producer_output_port': None, 'direct_predecessor_required': True,
            'condition': 'Exactly one Builder predecessor must advance. Host resolves its original build_receipt proposal by joining the actual producing invocation, model-call start, accepted manifest and bundle, blueprint and environment. Receipt readiness must be READY under the selected Builder receipt schema. Legacy static builds prohibit execution/install; prediction receipt v3 records bounded development tests and frozen offline provisioning, without scientific acceptance. This is not a public Builder output port.'},
        'screening_result': {
            'producer_cc': 'research.screening', 'producer_output_port': 'screening_result', 'direct_predecessor_required': True,
            'condition': 'Exactly one Screening predecessor must advance; host supplies its committed screening_result output.'},
        'execution_receipt': {
            'producer_cc': 'research.benchmark', 'producer_output_port': 'execution_receipt', 'direct_predecessor_required': True,
            'condition': 'Exactly one Benchmark predecessor must advance; host supplies its committed execution_receipt output.'},
        'provisioning_receipt': {
            'producer_cc': 'research.benchmark', 'producer_output_port': 'provisioning_receipt', 'direct_predecessor_required': True,
            'condition': 'Exactly one Benchmark predecessor must advance; host supplies its committed provisioning_receipt output.'},
        'gate_decision_index': {
            'producer_cc': None, 'producer_output_port': None, 'direct_predecessor_required': False,
            'condition': 'Host constructs one entry per committed accepted ancestor of this consumer in frozen topological order, naming each exact node-scope gate. Consumer predecessor edges must include all producers whose evidence it requires.'},
    }
    if set(descriptions) != HOST_KEYS:
        raise ResearchError('planner_host_bindings', 'Planner metadata does not cover the canonical protected host bindings')
    return {'schema': 'ai4r-planner-host-bindings:1',
        'meaning': 'Conditional host derivations supported by the existing protected Binder/Scheduler; not current artifacts, new permissions or acceptance.',
        'records': [dict(descriptions[key], run_input_key=key, artifact_type=key,
            source_kind='host_record', accepted_ref=None, future=None) for key in sorted(HOST_KEYS)]}


def _protected_run_inputs(resources):
    """Expose Binder's finite ordinary accepted-input aliases and inventory keys."""
    records = [
        {'run_input_key': 'brief', 'artifact_type': 'research_brief', 'schema_ref': None,
         'condition': 'Binder supplies this run\'s already committed Compiler Research Brief using the supplied exact brief_ref.'},
        {'run_input_key': 'search_scope', 'artifact_type': 'search_scope', 'schema_ref': 'search-scope:field-contract:1',
         'condition': 'Binder builds and captures search_scope during freeze, from the same accepted Brief, protected Search bounds, exact selected Search declaration, effective tool/network/read authority and this inventory. For local_documents the canonical local_document_buffer must resolve to nonempty qualified original document text within the run read ceiling. Proposal topic_hints are bounded phrases only. The resulting Ref does not exist at planning time and is never generated by a selectable Capsule.'},
    ]
    for resource in resources['resources']:
        if resource['resource_key'] in {'brief', 'search_scope'}:
            continue
        records.append({'run_input_key': resource['resource_key'], 'inventory_kind': resource['kind'],
            'inventory_available': resource['available'], 'inventory_ref_present': resource['ref'] is not None,
            'artifact_type': resource.get('artifact_type'), 'schema_ref': resource.get('schema_ref'),
            'condition': 'Binder takes the exact non-null Ref from this frozen inventory entry; selected Capsule needs and effective authority must still pass. The host captured artifact_type is what these bytes really are: bind this key only to a consumer input whose declared artifact_type (and schema_ref when given) equals it. A null artifact_type is untyped data that no input can consume. Never relabel the input to match the consumer. No new resource is created.'})
    return {'schema': 'ai4r-planner-run-input-bindings:1',
        'meaning': 'Existing ordinary Binder accepted-input keys are brief, search_scope and this resource inventory\'s resource_keys. This is descriptive context, not additional input or authority.',
        'records': [dict(record, source_kind='accepted_ref', accepted_ref=None, future=None) for record in records]}


async def execute(ctx,inputs):
    # The complete catalog is verified here, before the model sees only its reduced view.
    from ..planner_catalog import verify_catalog
    verify_catalog(inputs['capsule_contracts'], inputs['library_snapshot'], ctx.input_ref('library_snapshot'))
    contracts_view, snapshot_view = planner_views(inputs['capsule_contracts'], inputs['library_snapshot'], inputs['plan_policy'])
    payload=dict(inputs,capsule_contracts=contracts_view,library_snapshot=snapshot_view,brief_ref=ctx.input_ref('brief'),library_snapshot_ref=ctx.input_ref('library_snapshot'),
                 resource_inventory_ref=ctx.input_ref('resource_inventory'),policy_ref=ctx.input_ref('plan_policy'),
                 protected_host_bindings=_protected_host_bindings(),
                 protected_run_input_bindings=_protected_run_inputs(inputs['resource_inventory']))
    instructions=files('jiuwenswarm.research_assets').joinpath('planner','planner.txt').read_text('utf-8')
    from ..unified_planning import is_integrated_policy, integrated_planner_instructions
    if is_integrated_policy(inputs['plan_policy']):
        instructions += '\n' + integrated_planner_instructions(inputs['plan_policy'])
    from ..capability_planning import is_capability_policy, INSTRUCTIONS
    if is_capability_policy(inputs['plan_policy']):
        instructions += '\n' + INSTRUCTIONS
    instructions+='\nPinned output schema:\n'+json.dumps(reachable_schema(contract_schema('plan-proposal')),ensure_ascii=False,separators=(',',':'))
    from ..binding import plan_checks
    from ..state import json_bytes
    expected = {key: payload[key] for key in ('brief_ref', 'library_snapshot_ref', 'resource_inventory_ref', 'policy_ref')}
    # Two generations inside one work invocation. This is not a retry of an
    # executed DAG, a dispatch retry, a verifier waiver or an unbounded loop.
    for ordinal in (1, 2):
        raw = await NativePlanner().propose(payload, invoke=_instructions_once(ctx.model), instructions=instructions)
        if isinstance(raw, str) and not raw.startswith('INFEASIBLE:'):
            raw = fill_declared_limits(raw, inputs['library_snapshot'], inputs['plan_policy'])
        candidate_ref = ctx.store.put_blob(raw.encode('utf-8'), media_type='text/plain')
        try:
            kind, candidate = parse_planner_reply(raw)
            diagnostics = [] if kind == 'infeasible' else plan_checks(
                candidate, inputs['brief'], inputs['library_snapshot'], inputs['resource_inventory'],
                inputs['plan_policy'], plan_source='planned', expected_refs=expected)[1]
        except ResearchError as error:
            if error.code not in {'planner_output_invalid', 'contract_invalid', 'invalid_json'}:
                raise
            kind = 'proposal'
            diagnostics = [{'check_id': 'plan_proposal_schema', 'outcome': 'FAIL', 'reason': str(error), 'evidence_refs': []}]
        failed = [result for result in diagnostics if result['outcome'] == 'FAIL' and result['check_id'] != 'suggested_checks_known']
        diagnostic_ref = ctx.store.put_blob(json_bytes({'advisory': True, 'results': diagnostics}), media_type='application/json')
        ctx.store.append_record('planner_attempt', {'ordinal': ordinal, 'candidate_ref': candidate_ref,
            'diagnostics_ref': diagnostic_ref, 'advisory': True, 'repair_requested': bool(failed and ordinal == 1)})
        if not failed or ordinal == 2:
            break
        payload = dict(payload, repair={'previous_candidate': raw, 'validation_errors': failed,
            'instruction': 'Return one corrected complete proposal against the unchanged frozen inputs. These are advisory diagnostics, not authority or acceptance.'})
    try:
        kind,_=parse_planner_reply(raw)
    except ResearchError as error:
        # A completed text response that fails proposal structure is still a
        # candidate. The Runner captures its original bytes before checking;
        # missing schemas and actual model/runtime/budget faults still fail.
        if not isinstance(raw,str) or error.code not in {'planner_output_invalid','contract_invalid','invalid_json'}:
            raise
        kind='proposal'
    if kind=='infeasible':
        ref=ctx.store.put_blob(raw.encode('utf-8'),media_type='text/plain')
        ctx.record_host('planner_infeasible',ref)
        raise ResearchError('planner_reported_infeasible','The frozen capability set cannot cover this request',{'reason_ref':ref})
    from ..runner import ProducedArtifact
    return {'plan_proposal':ProducedArtifact(raw.encode('utf-8'),'plan-proposal',name='plan_proposal.json')}
"""Persistent state for Symphony graph builds."""

from __future__ import annotations

import hashlib
import json
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterable, Mapping

from openjiuwen.symphony import CapabilityDescriptor, CapabilityFingerprint

from jiuwenswarm.symphony.graph_storage import resolve_graph_artifact_dir

GRAPH_STATE_FILENAME = "graph_state.json"


@dataclass(frozen=True)
class GraphStateEntry:
    """State tracked for one Skill folder in a graph build."""

    skill_id: str
    relative_path: str
    content_hash: str
    fingerprint_hash: str
    status: str = "active"
    updated_at: str = ""

    def to_dict(self) -> dict[str, Any]:
        return {
            "skill_id": self.skill_id,
            "relative_path": self.relative_path,
            "content_hash": self.content_hash,
            "fingerprint_hash": self.fingerprint_hash,
            "status": self.status,
            "updated_at": self.updated_at,
        }

    @classmethod
    def from_dict(cls, payload: dict[str, Any]) -> "GraphStateEntry":
        return cls(
            skill_id=str(payload.get("skill_id") or ""),
            relative_path=str(payload.get("relative_path") or ""),
            content_hash=str(
                payload.get("content_hash") or payload.get("skill_md_sha256") or ""
            ),
            fingerprint_hash=str(payload.get("fingerprint_hash") or ""),
            status=str(payload.get("status") or "active"),
            updated_at=str(payload.get("updated_at") or ""),
        )


@dataclass(frozen=True)
class GraphState:
    """Serializable incremental graph state."""

    schema_version: str = "Symphony-graph-state-v2"
    skills: dict[str, GraphStateEntry] = field(default_factory=dict)

    def active_entries(self) -> dict[str, GraphStateEntry]:
        return {
            path: entry
            for path, entry in self.skills.items()
            if entry.status == "active"
        }

    def to_dict(self) -> dict[str, Any]:
        return {
            "schema_version": self.schema_version,
            "skills": {
                path: entry.to_dict() for path, entry in sorted(self.skills.items())
            },
        }

    @classmethod
    def from_dict(cls, payload: dict[str, Any]) -> "GraphState":
        raw_skills = payload.get("skills") or {}
        skills: dict[str, GraphStateEntry] = {}
        if isinstance(raw_skills, dict):
            for key, value in raw_skills.items():
                if not isinstance(value, dict):
                    continue
                entry = GraphStateEntry.from_dict(value)
                relative_path = entry.relative_path or str(key)
                skills[relative_path] = GraphStateEntry(
                    skill_id=entry.skill_id,
                    relative_path=relative_path,
                    content_hash=entry.content_hash,
                    fingerprint_hash=entry.fingerprint_hash,
                    status=entry.status,
                    updated_at=entry.updated_at,
                )
        return cls(
            schema_version=str(
                payload.get("schema_version") or "Symphony-graph-state-v1"
            ),
            skills=skills,
        )


class GraphStateBuilder:
    """Map a core capability inventory to JiuwenSwarm graph state."""

    def capability_hashes(
        self,
        capabilities: Iterable[CapabilityDescriptor],
    ) -> dict[str, str]:
        return {
            self.relative_path(capability): capability.content_hash
            for capability in capabilities
        }

    def next_state(
        self,
        *,
        capabilities: Iterable[CapabilityDescriptor],
        current_hashes: dict[str, str],
        fingerprints_by_id: Mapping[str, CapabilityFingerprint],
        old_state: GraphState,
        removed_paths: set[str],
    ) -> GraphState:
        now = datetime.now(timezone.utc).isoformat()
        entries: dict[str, GraphStateEntry] = {}
        for capability in capabilities:
            relative_path = self.relative_path(capability)
            fingerprint = fingerprints_by_id[capability.capability_id]
            entries[relative_path] = GraphStateEntry(
                skill_id=fingerprint.capability_id,
                relative_path=relative_path,
                content_hash=current_hashes[relative_path],
                fingerprint_hash=self.fingerprint_hash(fingerprint),
                status="active",
                updated_at=now,
            )

        for relative_path in sorted(removed_paths):
            old_entry = old_state.skills.get(relative_path)
            if old_entry is None:
                continue
            entries[relative_path] = GraphStateEntry(
                skill_id=old_entry.skill_id,
                relative_path=relative_path,
                content_hash=old_entry.content_hash,
                fingerprint_hash=old_entry.fingerprint_hash,
                status="removed",
                updated_at=now,
            )
        return GraphState(skills=entries)

    @staticmethod
    def fingerprint_hash(fingerprint: CapabilityFingerprint) -> str:
        payload = json.dumps(
            fingerprint.graph_identity_dict(),
            ensure_ascii=False,
            sort_keys=True,
        )
        return hashlib.sha256(payload.encode("utf-8")).hexdigest()

    @staticmethod
    def relative_path(capability: CapabilityDescriptor) -> str:
        entrypoint = str(capability.metadata.get("entrypoint") or "").strip()
        if not entrypoint:
            raise ValueError(
                f"Capability {capability.capability_id!r} has no entrypoint metadata."
            )
        return Path(entrypoint).parent.as_posix()


def load_graph_state(graph_dir: str | Path) -> GraphState:
    """Load graph_state.json, returning an empty state when it is missing."""

    path = resolve_graph_artifact_dir(graph_dir) / GRAPH_STATE_FILENAME
    if not path.exists():
        return GraphState()
    return GraphState.from_dict(json.loads(path.read_text(encoding="utf-8")))


def write_graph_state(state: GraphState, graph_dir: str | Path) -> None:
    """Write graph_state.json with stable formatting."""

    output_path = Path(graph_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    (output_path / GRAPH_STATE_FILENAME).write_text(
        json.dumps(state.to_dict(), ensure_ascii=False, indent=2),
        encoding="utf-8",
    )
"""Versioned storage helpers for Symphony graph artifacts."""

from __future__ import annotations

import json
import os
from dataclasses import dataclass
from pathlib import Path
from typing import Any

CURRENT_POINTER_FILENAME = "current.json"
VERSIONS_DIRNAME = "versions"
BUILD_RUNS_DIRNAME = ".build_runs"


@dataclass(frozen=True)
class GraphPointer:
    """Pointer to the currently published graph version."""

    version: str
    path: str

    def to_dict(self) -> dict[str, Any]:
        return {
            "schema_version": "1.0",
            "version": self.version,
            "path": self.path,
        }

    @classmethod
    def from_dict(cls, payload: dict[str, Any]) -> "GraphPointer":
        version = str(payload.get("version") or "").strip()
        path = str(payload.get("path") or payload.get("artifact") or "").strip()
        if path.endswith("/graph.json"):
            path = str(Path(path).parent)
        if not version or not path:
            raise ValueError("Invalid Symphony graph pointer.")
        return cls(version=version, path=path)


def resolve_graph_artifact_dir(graph_dir: str | Path) -> Path:
    """Return the directory containing the currently readable artifacts.

    New builds publish versioned artifacts behind ``current.json``. Older
    layouts stored artifacts directly in ``graph_dir``; this helper keeps that
    legacy layout readable.
    """

    root = Path(graph_dir).resolve()
    pointer_path = root / CURRENT_POINTER_FILENAME
    if not pointer_path.is_file():
        return root

    pointer = GraphPointer.from_dict(
        json.loads(pointer_path.read_text(encoding="utf-8"))
    )
    candidate = (root / pointer.path).resolve()
    if not _is_relative_to(candidate, root):
        raise ValueError(f"Symphony graph pointer escapes graph_dir: {candidate}")
    return candidate


def graph_manifest_path(graph_dir: str | Path) -> Path:
    """Return the public graph artifact used as the existence marker."""

    return resolve_graph_artifact_dir(graph_dir) / "graph.json"


def graph_exists(graph_dir: str | Path) -> bool:
    root = Path(graph_dir).resolve()
    pointer_path = root / CURRENT_POINTER_FILENAME
    if not pointer_path.is_file():
        return False
    try:
        pointer = json.loads(pointer_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False
    schema_version = str(pointer.get("schema_version") or "")
    return schema_version.startswith("1.") and graph_manifest_path(root).is_file()


def build_runs_dir(graph_dir: str | Path) -> Path:
    return Path(graph_dir).resolve() / BUILD_RUNS_DIRNAME


def build_run_dir(graph_dir: str | Path, run_id: str) -> Path:
    return build_runs_dir(graph_dir) / run_id


def build_artifact_dir(graph_dir: str | Path, run_id: str) -> Path:
    return build_run_dir(graph_dir, run_id) / "artifacts"


def publish_artifact_dir(
    graph_dir: str | Path,
    artifact_dir: str | Path,
    *,
    version: str,
) -> Path:
    """Publish a fully built artifact directory as the current graph version."""

    root = Path(graph_dir).resolve()
    source = Path(artifact_dir).resolve()
    versions_dir = root / VERSIONS_DIRNAME
    versions_dir.mkdir(parents=True, exist_ok=True)
    target = versions_dir / version
    if target.exists():
        raise FileExistsError(f"Symphony graph version already exists: {target}")
    os.replace(source, target)

    pointer = GraphPointer(
        version=version,
        path=f"{VERSIONS_DIRNAME}/{version}",
    )
    tmp_pointer = root / f".{CURRENT_POINTER_FILENAME}.{version}.tmp"
    tmp_pointer.write_text(
        json.dumps(pointer.to_dict(), ensure_ascii=False, indent=2),
        encoding="utf-8",
    )
    os.replace(tmp_pointer, root / CURRENT_POINTER_FILENAME)
    return target


def latest_incomplete_build(graph_dir: str | Path) -> Path | None:
    runs_root = build_runs_dir(graph_dir)
    if not runs_root.is_dir():
        return None
    candidates = []
    for child in runs_root.iterdir():
        checkpoint = child / "checkpoint.json"
        if not checkpoint.is_file():
            continue
        try:
            payload = json.loads(checkpoint.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            continue
        candidates.append(
            (
                str(payload.get("updated_at") or ""),
                str(payload.get("status") or ""),
                child,
            )
        )
    if not candidates:
        return None
    _updated_at, status, path = sorted(candidates, key=lambda item: item[0])[-1]
    if status in {"running", "failed"}:
        return path
    return None


def _is_relative_to(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
    except ValueError:
        return False
    return True

