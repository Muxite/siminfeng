"""Finish local Git packaging after this checkout'"'s .git becomes writable. Never pushes.\"\"\"
import subprocess
from pathlib import Path

ROOT = Path('/home/muk/projects/xs-dev/llama-opt')
OUT = Path('/home/muk/projects/xs-dev/opt-artifacts')
BASE = '6e9d96cf4'
PATCHES = [
    ('p12-trace', '12-selection-trace.patch', 'expert: add buffered selection trace'),
    ('p13-populate', '13-fill-populate-backend.patch', 'expert: add populate fill backend'),
    ('p14-pin', '14-expert-pin.patch', 'expert: pin hot expert bundles'),
    ('p15-temporal', '15-pregate-temporal.patch', 'expert: add temporal pregate modes'),
]


def git(*args, cwd=ROOT):
    return subprocess.check_output(['git', *args], cwd=cwd)


def main():
    assert not git('status', '--porcelain'), 'Review and save existing changes before packaging.'
    assert git('rev-parse', 'HEAD') == git('rev-parse', BASE), 'Start at the assigned base.'
    original = git('branch', '--show-current').decode().strip()
    for branch, patch, title in PATCHES:
        assert not git('branch', '--list', branch), f'Branch already exists: {branch}'
    for branch, patch, title in PATCHES:
        git('switch', '-c', branch, BASE)
        git('apply', str(OUT / patch))
        files = [line.split('\\t', 2)[2] for line in git('diff', '--numstat').decode().splitlines()]
        assert files and all(file.startswith('src/') for file in files)
        git('add', '--', *files)
        git('commit', '-m', title + '\\n\\nAssisted-by: Codex')
        assert git('rev-parse', 'HEAD"'^'"') == git('rev-parse', BASE)
        (OUT / patch).write_bytes(git('format-patch', '-1', '--stdout'))
    check = ROOT / 'build-f16/git-apply-worktree'
    git('worktree', 'add', '--detach', str(check), BASE)
    try:
        for branch, patch, title in PATCHES:
            git('apply', '--check', str(OUT / patch), cwd=check)
            assert git('rev-list', '--count', BASE + '..' + branch).strip() == b'1'
    finally:
        git('worktree', 'remove', str(check))
    git('switch', original or '--detach', *([] if original else [BASE]))
    print('B1 PASS: four independent branches/commits, format-patches, and worktree apply checks.')


if __name__ == '__main__':
    main()
