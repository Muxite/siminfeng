"""Native CC packet entry point for task-scoped evidence capabilities."""
from __future__ import annotations

import json
import os
import re
from pathlib import Path
import sqlite3
import sys

from .store import FactoryError, NotFound, ScopeDenied, Store


def fields(value, allowed, required=()):
    if not isinstance(value, dict) or set(value) - set(allowed) or set(required) - set(value):
        raise ValueError('Invalid or missing input fields')


def artifact_source(record, packet):
    if ('path' in record) == ('text' in record):
        raise ValueError('Supply exactly one of path or text')
    if 'text' in record:
        if not isinstance(record['text'], str):
            raise ValueError('text must be a string')
        return record['text'].encode('utf-8')
    if not isinstance(record['path'], str) or not record['path']:
        raise ValueError('path must be a nonempty string')
    roots = [Path(value).expanduser().resolve() for value in
             (packet.get('output_dir'), os.environ.get('FACTORY_WORKSPACE')) if isinstance(value, str) and value]
    candidate = Path(record['path']).expanduser()
    if not candidate.is_absolute():
        if not roots:
            raise ScopeDenied('Artifact publication requires an authorized directory')
        candidate = roots[0] / candidate
    candidate = candidate.resolve()
    if not any(candidate.is_relative_to(root) for root in roots):
        raise ScopeDenied('Artifact path is outside output_dir and workspace')
    if not candidate.is_file():
        raise ValueError('Artifact path must name an existing file')
    return candidate


def dispatch(store, task_id, capability, packet):
    inputs = packet.get('inputs', {})
    if capability.startswith('lab.'):
        from .manager import Manager
        operation = capability.removeprefix('lab.')
        if operation not in {'submit', 'status', 'cancel', 'result'}:
            raise ValueError('Unknown lab capability')
        if hasattr(store, '_check'):
            store._check(task_id, write=True)
            host = store._store
        else:
            host = store
        manager = Manager(host, host.home / 'lab-spool')
        if operation == 'submit':
            fields(inputs, {'image', 'build_attempt_id', 'contract_id', 'run_config', 'idem_key'},
                   {'image', 'build_attempt_id', 'contract_id', 'run_config', 'idem_key'})
            admission = manager.admit(task_id, inputs['image'], inputs['build_attempt_id'])
            attempt = manager.submit_run(task_id, admission['admission_id'], inputs['contract_id'],
                                         inputs['run_config'], inputs['idem_key'])
            return dict(admission=admission, **{k: attempt[k] for k in ('attempt_id', 'state', 'jobq_id')})
        fields(inputs, {'attempt_id'}, {'attempt_id'})
        attempt = manager.jobs._get(inputs['attempt_id'])
        if attempt['task_id'] != task_id or attempt['kind'] != 'lab':
            raise ScopeDenied('Lab attempt belongs to another task or capability')
        return getattr(manager, operation)(inputs['attempt_id'])
    if capability.startswith('builder.'):
        from .builder import Builder
        operation = capability.removeprefix('builder.')
        if operation not in {'submit', 'status', 'cancel', 'result'}:
            raise ValueError('Unknown builder capability')
        # Unwrap only after enforcing the current task's write boundary. Read
        # grants must never allow cancellation or use of another task's build.
        if hasattr(store, '_check'):
            store._check(task_id, write=True)
            host = store._store
        else:
            host = store
        builder = Builder(host)
        if operation == 'submit':
            fields(inputs, {'request', 'idem_key'}, {'request', 'idem_key'})
            attempt = builder.submit(task_id, inputs['request'], inputs['idem_key'])
            return {key: attempt[key] for key in ('attempt_id', 'state', 'jobq_id')}
        fields(inputs, {'attempt_id'}, {'attempt_id'})
        attempt = builder.jobs._get(inputs['attempt_id'])
        if attempt['task_id'] != task_id:
            raise ScopeDenied('Attempt belongs to another task')
        return getattr(builder, operation)(inputs['attempt_id'])
    if capability == 'evidence.query':
        fields(inputs, {'kinds', 'text', 'since', 'limit', 'task_id'})
        options = dict(inputs)
        target = options.pop('task_id', task_id)
        return store.query(target, **options)
    if capability == 'evidence.read':
        fields(inputs, {'id', 'task_id'}, {'id'})
        if not isinstance(inputs['id'], str) or not inputs['id']:
            raise ValueError('id must be a nonempty string')
        if 'task_id' in inputs:
            return store.read(inputs['task_id'], inputs['id'])
        # The advertised interface needs only an evidence id. Prefer the
        # current task, then search explicitly granted tasks in stable order.
        for target in [task_id, *sorted(store.readable - {task_id})]:
            try:
                return store.read(target, inputs['id'])
            except NotFound:
                continue
        raise NotFound('Record not found')
    if capability != 'evidence.publish':
        raise ValueError('Unknown evidence capability')
    fields(inputs, {'type', 'record', 'expected_rev'}, {'type', 'record'})
    record = inputs['record']
    if not isinstance(record, dict):
        raise ValueError('record must be an object')
    record = dict(record)
    if record.get('task_id', task_id) != task_id:
        raise ScopeDenied('Publication belongs to another task')
    if inputs['type'] == 'observation':
        if 'expected_rev' in inputs:
            raise ValueError('expected_rev applies only to decisions')
        return store.append_observation(task_id, record)
    if inputs['type'] == 'decision':
        if 'expected_rev' in record and 'expected_rev' in inputs and record['expected_rev'] != inputs['expected_rev']:
            raise ValueError('Conflicting expected_rev values')
        expected_rev = record.pop('expected_rev', inputs.get('expected_rev'))
        return store.advance_decision(task_id, expected_rev, record)
    if inputs['type'] == 'artifact':
        if 'expected_rev' in inputs:
            raise ValueError('expected_rev applies only to decisions')
        fields(record, {'task_id', 'artifact_id', 'path', 'text', 'media_type', 'producer_attempt'})
        source = artifact_source(record, packet)
        return store.put_artifact(task_id, record.get('artifact_id'), source,
                                  record.get('media_type', 'text/plain' if 'text' in record else 'application/octet-stream'),
                                  record.get('producer_attempt', packet.get('attempt')))
    raise ValueError('type must be observation, decision or artifact')


def input_reason(exc):
    """Keep actionable validation text while redacting configured credentials."""
    message = str(exc)
    for key, value in os.environ.items():
        if value and re.search(r'(?i)(secret|token|password|credential|api_key|private_key)', key):
            message = message.replace(value, '[redacted]')
    message = re.sub(r'(?i)(bearer\s+)[\w.\-]+', r'\1[redacted]', message)
    return message[:300]


def main():
    try:
        if len(sys.argv) != 2:
            raise ValueError('One capability argument is required')
        packet = json.load(sys.stdin)
        if not isinstance(packet, dict):
            raise ValueError('Packet must be an object')
        if packet.get('capability', sys.argv[1]) != sys.argv[1]:
            raise ValueError('Packet capability differs from command')
        task_id = os.environ.get('FACTORY_TASK_ID', '').strip()
        if not task_id:
            raise ValueError('FACTORY_TASK_ID is required')
        readable = frozenset(t.strip() for t in os.environ.get('FACTORY_READ_TASKS', '').split(',') if t.strip())
        with Store(Path(os.environ.get('FACTORY_HOME', '~/.jiuwenswarm-factory'))) as store:
            # Inspector dispatch: returns a native envelope, including failed
            # probes with their observation/artifact references (F04).
            if sys.argv[1].startswith('inspector.'):
                from .inspector import dispatch as inspector_dispatch
                result = inspector_dispatch(store.scoped(task_id), task_id, sys.argv[1], packet)
                print(json.dumps(result, ensure_ascii=False, allow_nan=False))
                return
            # End inspector dispatch.
            outputs = dispatch(store.scoped(task_id, readable), task_id, sys.argv[1], packet)
        result = {'outcome': 'ok', 'outputs': outputs}
    except FactoryError as exc:
        result = {'outcome': 'error', 'error': {'code': exc.code, 'message': str(exc)}}
    except (ValueError, TypeError, KeyError, OverflowError, sqlite3.ProgrammingError) as exc:
        result = {'outcome': 'error', 'error': {'code': 'INVALID_INPUT', 'message': input_reason(exc)}}
    except (OSError, sqlite3.Error):
        result = {'outcome': 'error', 'error': {'code': 'PERSISTENCE_FAILED', 'message': 'Evidence persistence failed'}}
    print(json.dumps(result, ensure_ascii=False, allow_nan=False))


if __name__ == '__main__':
    main()
"""Read-only, sanitized evidence bundles. No job reconciliation or Store initialization."""
from __future__ import annotations

import argparse
from contextlib import closing
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import sqlite3
import subprocess
import tempfile
from datetime import datetime, timezone

from .store import TABLES, NotFound

LIMIT = 50 * 1024 * 1024
ROOT = Path(__file__).resolve().parent
SECRET_PATTERNS = [
    re.compile(rb'eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}'),
    re.compile(rb'(?i)bearer\s+[A-Za-z0-9._-]{16,}'),
    re.compile(rb'sk-[A-Za-z0-9_-]{8,}'),
    re.compile(rb'[\w.+-]+@[\w-]+\.[\w.-]+'),
    re.compile(rb'''(?ix)(?:access_token|refresh_token|id_token|api_key|password|secret|token)["']?\s*[:=]\s*["']?[A-Za-z0-9_./+-]{16,}'''),
]
SENSITIVE_KEY = re.compile(r'(?i)^(?:.*_)?(?:token|secret|password|authorization|api_key|auth_json)$')


def sha(data):
    return hashlib.sha256(data).hexdigest()


def scrub_bytes(data):
    for pattern in SECRET_PATTERNS:
        data = pattern.sub(b'<redacted>', data)
    return data


def sanitize(value):
    if isinstance(value, dict):
        return {scrub_bytes(str(k).encode()).decode(): '<redacted>' if SENSITIVE_KEY.search(k)
                else sanitize(v) for k, v in value.items()}
    if isinstance(value, list):
        return [sanitize(v) for v in value]
    if isinstance(value, str):
        return scrub_bytes(value.encode()).decode()
    return value


def json_bytes(value):
    return (json.dumps(sanitize(value), indent=2, ensure_ascii=False, sort_keys=True) + '\n').encode()


def snapshot(home, task_id):
    # mode=ro deliberately avoids Store.__init__ (DDL and WAL configuration).
    with closing(sqlite3.connect((home / 'factory.sqlite').as_uri() + '?mode=ro', uri=True)) as db:
        db.row_factory = sqlite3.Row
        db.execute('BEGIN')
        result = {}
        for table in TABLES:
            columns = {r['name'] for r in db.execute(f'PRAGMA table_info({table})') if r['type'] == 'JSON'}
            records = []
            for row in db.execute(f'SELECT * FROM {table} WHERE task_id=?', (task_id,)):
                record = dict(row)
                for key in columns:
                    record[key] = json.loads(record[key])
                records.append(record)
            result[table] = sorted(records, key=lambda r: (r.get('rev', 0), r.get('created', 0), str(r)))
        if not result['tasks']:
            raise NotFound('Task not found')
        result['events'] = [dict(r) for r in db.execute('SELECT * FROM evidence WHERE task_id=? ORDER BY cursor', (task_id,))]
        for event in result['events']:
            event['record'] = json.loads(event['record'])
        return result


def command(argv):
    try:
        proc = subprocess.run(argv, capture_output=True, stdin=subprocess.DEVNULL, timeout=20,
                              env=dict(os.environ, GIT_OPTIONAL_LOCKS='0', GIT_TERMINAL_PROMPT='0'))
        if proc.returncode:
            return {'available': False, 'error': scrub_bytes(proc.stderr).decode(errors='replace')[:1000]}
        return {'available': True, 'stdout': proc.stdout.decode(errors='replace')}
    except (OSError, subprocess.TimeoutExpired) as exc:
        return {'available': False, 'error': scrub_bytes(str(exc).encode()).decode()}


def scan(directory):
    for path in sorted(directory.rglob('*')):
        if path.is_symlink():
            raise ValueError('Bundle contains symlink: ' + str(path.relative_to(directory)))
        if path.is_file() and any(p.search(path.read_bytes()) for p in SECRET_PATTERNS):
            # Never include the matched value in an error.
            raise ValueError('Secrets scan failed: ' + str(path.relative_to(directory)))


def verify(directory):
    directory = Path(directory).resolve()
    scan(directory)
    manifest = json.loads((directory / 'MANIFEST.json').read_text())
    actual = {p.relative_to(directory).as_posix(): sha(p.read_bytes())
              for p in directory.rglob('*') if p.is_file() and p != directory / 'MANIFEST.json'}
    if actual != manifest:
        raise ValueError('Manifest paths or SHA256 hashes differ')
    return len(actual)


def export_task(task_id, out, home=None):
    home = Path(home or os.environ.get('FACTORY_HOME', '~/.jiuwenswarm-factory')).expanduser().resolve()
    out = Path(out).resolve()
    if out == home or out.is_relative_to(home):
        raise ValueError('Export destination must be outside factory home')
    if out.exists():
        raise ValueError('Export destination already exists')
    records = snapshot(home, task_id)
    task = records['tasks'][0]
    out.parent.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix='.export-', dir=out.parent))
    omissions, artifacts, images, sources, builds = [], [], [], [], []

    def write(name, data):
        path = stage / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(scrub_bytes(data))
        return name

    def record(name, value):
        return write(name, json_bytes(value))

    def copy_blob(path, name=None, expected=None):
        if path.stat().st_size > LIMIT:
            omissions.append({'source': str(path), 'size': path.stat().st_size, 'reason': 'over_50_MiB', 'sha256': expected})
            return None
        data = path.read_bytes()
        if expected and sha(data) != expected:
            raise ValueError('Artifact digest mismatch')
        clean = scrub_bytes(data)
        try:
            parsed = json.loads(data)
            sanitized = sanitize(parsed)
            if sanitized != parsed:
                clean = json_bytes(sanitized)
        except (ValueError, UnicodeDecodeError):
            pass
        return write(name or 'artifacts/' + sha(clean), clean)

    try:
        for table, values in records.items():
            record('records/' + table + '.json', values)
        for item in records['artifacts']:
            path = (home / item['location']).resolve()
            if not path.is_relative_to(home / 'artifacts'):
                raise ValueError('Artifact location escapes artifact root')
            if path.stat().st_size != item['size']:
                raise ValueError('Artifact size mismatch')
            name = copy_blob(path, expected=item['sha256'])
            artifacts.append(dict(item, exported_path=name,
                                  exported_sha256=sha((stage / name).read_bytes()) if name else None))
        record('artifacts.json', artifacts)
        transcript = (home / 'sessions' / (task_id + '.jsonl')).resolve()
        if not transcript.is_relative_to(home / 'sessions'):
            raise ValueError('Session path escapes sessions root')
        if transcript.is_file():
            # Parse each event so sensitive JSON fields are scrubbed too.
            lines = []
            for line in transcript.read_text().splitlines():
                if line.strip():
                    lines.append(json.dumps(sanitize(json.loads(line)), ensure_ascii=False))
            write('session.jsonl', ('\n'.join(lines) + '\n').encode())
        else:
            omissions.append({'source': 'session.jsonl', 'reason': 'no agent session (operator task or unavailable)'})
        releases = {}
        for capsule in sorted((ROOT / 'ccs').iterdir()):
            if not capsule.is_dir():
                continue
            files = {p.relative_to(capsule).as_posix(): sha(p.read_bytes()) for p in sorted(capsule.rglob('*'))
                     if p.is_file() and '__pycache__' not in p.parts and p.suffix != '.pyc'}
            # Tree digest = SHA256 of sorted path<NUL>file-sha256<LF> entries.
            digest = sha(''.join(f'{p}\0{h}\n' for p, h in files.items()).encode())
            releases[capsule.name] = dict(sha256=digest, files=files)
            for relative in files:
                copy_blob(capsule / relative, 'capsules/' + capsule.name + '/' + relative)
        record('capsule-releases.json', {'identity_scope': 'export-time checkout; not an attestation of historical loaded bytes',
                                        'algorithm': 'sha256(sorted relative-path + NUL + file-sha256 + LF); excludes __pycache__ and .pyc', 'capsules': releases})
        contract_ids = {v['contract_id'] for v in records['evaluations']}
        if task.get('contract_id'):
            contract_ids.add(task['contract_id'])
        for cid in sorted(contract_ids):
            from .contract import load
            contract = load(cid)
            copy_blob(contract.path, 'contracts/' + contract.path.name)
        for attempt in records['attempts']:
            if attempt['kind'] != 'build':
                continue
            aid = attempt['attempt_id']
            source = attempt['request'].get('source', {})
            commit = source.get('commit')
            if source.get('path') and commit:
                base = ['git', '-C', source['path']]
                log = command(base + ['log', '-3', '--format=%H %T %P %s'])
                patch = command(base + ['show', '--format=fuller', '--no-ext-diff', commit, '--'])
                record('source/' + aid + '.json', dict(attempt_id=aid, source=source, log=log,
                       integration_diff_available=patch['available'], error=patch.get('error')))
                if patch['available']:
                    write('source/' + aid + '.diff', patch['stdout'].encode())
                sources.append(dict(attempt_id=aid, commit=commit))
            build_item = next((a for a in artifacts if a['artifact_id'] == aid + ':build-record'), None)
            build = {}
            if build_item and build_item['exported_path']:
                build = json.loads((stage / build_item['exported_path']).read_bytes())
                record('builds/' + aid + '/build-record.json', build)
            # Capture already-produced worker outputs; never run/reconcile a job.
            build_root = home / 'builds' / aid
            if build_root.is_dir():
                for path in sorted(build_root.rglob('*')):
                    if path.is_file() and not path.is_symlink() and 'build' not in path.relative_to(build_root).parts:
                        archive = build.get('archive') or {}
                        digest = archive.get('sha256') if path.name == archive.get('path') else None
                        copy_blob(path, 'builds/' + aid + '/worker/' + path.relative_to(build_root).as_posix(), expected=digest)
            image = build.get('image') or {}
            if image.get('Id'):
                inspected = command(['docker', 'image', 'inspect', image['Id']])
                identity = dict(attempt_id=aid, evidence_id=aid + ':build-record',
                                provenance='docker image inspect' if inspected['available'] else 'build record only',
                                inspect_error=inspected.get('error'))
                if inspected['available']:
                    row = json.loads(inspected['stdout'])[0]
                    identity['image'] = {k: row.get(k) for k in ('Id', 'Architecture', 'Os', 'RepoTags')}
                    identity['image']['Labels'] = (row.get('Config') or {}).get('Labels')
                else:
                    identity['image'] = image
                    identity['labels'] = None
                    identity['labels_note'] = 'Unavailable without Docker access; build record does not capture image labels'
                images.append(identity)
            builds.append(dict(attempt_id=aid, state=attempt['state'], build_record=build_item))
        record('image-identity.json', images)
        receipt = ROOT.parents[1] / 'artifacts/factory/live-jobs-receipt.jsonl'
        if task_id.startswith('operator-') and receipt.is_file():
            copy_blob(receipt, 'operator-live-jobs-receipt.jsonl')
        record('omissions.json', omissions)
        record('export.json', dict(task_id=task_id, exported_at=datetime.now(timezone.utc).isoformat(),
               snapshot_cursor=task['evidence_cursor'], factory_git_head=command(['git', '-C', str(ROOT), 'rev-parse', 'HEAD']),
               artifact_policy='50 MiB limit; sanitized copies may have a different SHA256; artifacts.json maps original identities',
               read_only=True))
        lines = [f'# Evidence chain: {task_id}', '',
                 'Read-only snapshot; missing links mean not demonstrated. Artifact IDs map to bundled bytes in [artifacts.json](artifacts.json).', '',
                 '| Component | Integration commit | Build attempt | Image ID | Admission | Lab run | Evaluation |',
                 '|---|---|---|---|---|---|---|']
        for build in builds:
            aid = build['attempt_id']
            source = next((s['commit'] for s in sources if s['attempt_id'] == aid), 'unavailable')
            image = next((i['image'].get('Id') for i in images if i['attempt_id'] == aid), 'not recorded')
            labs = [a for a in records['attempts'] if a['kind'] == 'lab' and a['request'].get('admission', {}).get('build_attempt_id') == aid]
            for lab in labs or [None]:
                admission = lab['request']['admission']['admission_id'] if lab else 'not recorded'
                lid = lab['attempt_id'] if lab else 'not recorded'
                evals = [e['eval_id'] for e in records['evaluations'] if e['eval_id'].startswith(lid + ':')]
                build_evidence = aid + ':build-record' if build['build_record'] else 'build record not present'
                source_link = f'{source} ([diff](source/{aid}.diff))' if (stage / f'source/{aid}.diff').is_file() else source
                lines.append(f"| {task.get('component_cc') or 'not recorded; capsules bundled separately'} | {source_link} | {aid} ({build['state']}); {build_evidence} | {image} | {admission} | {lid} | {', '.join(evals) or 'not recorded'} |")
        if not builds:
            lines.append('| not recorded | not recorded | not recorded | not recorded | not recorded | not recorded | not recorded |')
        lines += ['', '## Evidence records', '']
        for table, values in records.items():
            lines.append(f'- [{table}](records/{table}.json): {len(values)} records')
            if table in {'decisions', 'observations', 'evaluations'}:
                for value in values:
                    key = TABLES[table][0]
                    lines.append(f"  - `{value[key]}`" + (f" rev {value['rev']}" if 'rev' in value else ''))
        lines += ['', '## Limits', '',
                  'Capsule hashes describe the export-time source tree. Git log describes the current owned checkout; each integration diff names the recorded build commit.',
                  'Image identity provenance and Docker access errors: [image-identity.json](image-identity.json).',
                  'Skipped large files and absent session: [omissions.json](omissions.json). No absent chain link is inferred.']
        write('INDEX.md', ('\n'.join(lines) + '\n').encode())
        scan(stage)
        manifest = {p.relative_to(stage).as_posix(): sha(p.read_bytes()) for p in sorted(stage.rglob('*')) if p.is_file()}
        record('MANIFEST.json', manifest)
        verify(stage)
        stage.rename(out)
        return out
    finally:
        if stage.exists():
            shutil.rmtree(stage)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('task_id', nargs='?')
    parser.add_argument('--out', type=Path)
    parser.add_argument('--home', type=Path)
    parser.add_argument('--verify', type=Path)
    args = parser.parse_args(argv)
    try:
        if args.verify:
            print(f'Verified {verify(args.verify)} files; secrets scan clean')
        elif args.task_id and args.out:
            print(export_task(args.task_id, args.out, args.home))
        else:
            parser.error('provide TASK --out DIR, or --verify DIR')
    except (ValueError, OSError, sqlite3.Error, NotFound) as exc:
        parser.exit(2, str(exc) + '\n')


if __name__ == '__main__':
    main()
"""Versioned greedy-continuation contracts. Freezing is an operator action."""
from __future__ import annotations

import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import tempfile
from datetime import datetime, timezone

CONTRACTS = Path(__file__).parent / 'contracts'
OUTCOMES = {'ok', 'config_rejected', 'measurement_failed', 'candidate_failed',
            'wrong_target', 'bad_digest', 'cancelled', 'upload_pending'}


class ContractFrozen(ValueError):
    pass


class Contract(dict):
    path: Path


def load(contract_id):
    path = Path(contract_id)
    if not path.is_file():
        if not re.fullmatch(r'[A-Za-z0-9_-]+', str(contract_id)):
            raise ValueError('Invalid contract identifier')
        path = CONTRACTS / (str(contract_id) + '.json')
    result = Contract(json.loads(path.read_text()))
    result.path = path.resolve()
    if result['version'] < 1 or result['tolerance'] != 'byte-identical stdout':
        raise ValueError('Unsupported contract version or tolerance')
    return result


def atomic_json(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix='.pending-')
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(value, stream, sort_keys=True, indent=2, allow_nan=False)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    finally:
        Path(temporary).unlink(missing_ok=True)


def freeze(contract, reference_run):
    """Write the reference once, under a process lock; return the frozen contract."""
    if not isinstance(contract, Contract):
        contract = load(contract)
    with contract.path.with_suffix('.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        current = load(contract.path)
        if current['reference']['stdout_sha256'] is not None:
            raise ContractFrozen('Contract is frozen; create a version+1 contract file')
        if (reference_run.get('execution_outcome') != 'ok' or
                reference_run.get('evidence_completeness') != 'complete' or
                reference_run.get('image_id') != current['reference']['image_id']):
            raise ValueError('Reference requires a successful complete run of the pinned reference image')
        sha = reference_run.get('stdout_sha256', '')
        if not re.fullmatch(r'[a-f0-9]{64}', sha):
            raise ValueError('Reference stdout SHA256 is required')
        current['reference'].update(stdout_sha256=sha,
            frozen_at=datetime.now(timezone.utc).isoformat(), run_ref=reference_run['run_ref'])
        atomic_json(current.path, current)
        contract.clear()
        contract.update(current)
        return contract


def evaluate(contract, run):
    outcome = run.get('execution_outcome', 'measurement_failed')
    if outcome not in OUTCOMES:
        raise ValueError('Unknown execution outcome')
    complete = run.get('evidence_completeness') == 'complete'
    details = dict(run.get('details', {}))
    correctness = 'not_evaluated'
    reference = contract['reference']['stdout_sha256']
    if outcome == 'ok' and complete and reference and run.get('stdout_sha256'):
        correctness = 'pass' if reference == run['stdout_sha256'] else 'fail'
        if correctness == 'fail':
            outcome = 'candidate_failed'
    elif outcome == 'ok':
        details['unscored_reason'] = 'reference_unfrozen' if not reference else 'incomplete_evidence'
    return dict(execution_outcome=outcome, correctness=correctness,
                evidence_completeness='complete' if complete else 'partial', details=details)
