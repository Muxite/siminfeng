ll_clock_s_remaining": 19726}, "stop_condition": "Keep fill only on acceptance accept and improved direct gate with comparable starts. Preserve all prior nulls. Do not repeat this comparison indefinitely if noise or cache disparity persists.", "reason_for_change": "5dacbf5d0faf4cd4b77b2fe0aa92dd43:evaluation and cache artifacts establish the bounded primer; c6a4033c2f3e4805aa69c4faa1cace96 rejects chunk256 and motivates direct whole-stack evidence.", "created": 1794516780.4825797, "plan_patch": {"update": [{"evidence_ids": ["5dacbf5d0faf4cd4b77b2fe0aa92dd43:evaluation", "5dacbf5d0faf4cd4b77b2fe0aa92dd43:page_cache.end.json"], "node_id": "bare-primer", "reason": "Non-scoring fixed primer complete; frozen output correct.", "state": "done"}]}, "expected_graph_rev": 24}
