lueError(f\"unknown test: {t}\")\n        td = TESTS[t]\n        inputs[\"tests\"][t] = test_definition_sha(td)\n        name = td.get(\"model_file\", os.path.basename(spec[\"model\"]))\n        if not name or os.path.basename(name) != name:\n            raise ValueError(f\"test {t}: model_file must be a basename: {name}\")\n        if name not in inputs[\"model_files\"]:\n            inputs[\"model_files\"][name] = sha(os.path.join(os.path.dirname(spec[\"model\"]), name))\n        if td.get(\"needs_data\") and not spec.get(\"data\"):\n            raise ValueError(f\"test {t} requires --data\")\n        mounts = sorted(readonly_mounts(td), key=lambda m: len(m[1]), reverse=True)\n        for host, ctr in mounts:\n            if not os.path.isdir(host):\n                raise ValueError(f\"test {t}: read-only mount is not a directory: {host}\")\n            inputs[\"mounts\"].setdefault(host, {})\n        # Paths may be positional values or --option=/container/path. Do not\n        # walk entire mounts: unrelated files must not change job identity.\n        for arg in td.get(\"args\", []):\n            value = arg.split(\"=\", 1)[1] if arg.startswith(\"-\") and \"=\" in arg else arg\n            if not value.startswith(\"/\"): continue\n            value = os.path.normpath(value)\n            for host, ctr in mounts:\n                if value == ctr or value.startswith(ctr.rstrip(\"/\") + \"/\"):\n                    rel = os.path.relpath(value, ctr)\n                    path = os.path.join(host, rel)\n                    if not os.path.isfile(path):\n                        raise ValueError(f\"test {t}: referenced input file missing or not a file: {path} ({value})\")\n                    inputs[\"mounts\"][host][rel] = sha(path)\n                    break\n    if spec.get(\"data\"):\n        inputs[\"data_files\"][os.path.abspath(spec[\"data\"])] = sha(spec[\"data\"])\n    return inputs\n\ndef verify_inputs(spec):\n","exit_code":0,"status":"completed"}}
