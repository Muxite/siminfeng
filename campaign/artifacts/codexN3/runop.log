 OCI digest: \" + dg)\n                        child, _ = metadata(\"blobs/sha256/\" + dg[7:], dg)\n                        found.extend(images(child, depth + 1))\n                    return found\n                manifests = images(index)\n                if len(manifests) != 1:\n                    raise ValueError(\"OCI archive must contain exactly one runnable image\")\n                manifest = manifests[0]\n                config_name = \"blobs/sha256/\" + manifest[\"config\"][\"digest\"].removeprefix(\"sha256:\")\n                layers = []\n                for descriptor in manifest[\"layers\"]:\n                    dg = descriptor[\"digest\"]\n                    if not re.fullmatch(r\"sha256:[0-9a-f]{64}\", dg):\n                        raise ValueError(\"unsupported OCI layer digest: \" + dg)\n                    name = \"blobs/sha256/\" + dg[7:]\n                    layers.append(name)\n                    layer_digests[name] = dg[7:]\n            config, config_sha = metadata(config_name)\n            named = posixpath.basename(config_name).removesuffix(\".json\")\n            if not SHA.fullmatch(named):\n                raise ValueError(\"config blob name must be its SHA-256: \" + config_name)\n            diff_ids = config.get(\"rootfs\", {}).get(\"diff_ids\")\n            if diff_ids is not None and len(diff_ids) != len(layers):\n                raise ValueError(\"config rootfs.diff_ids count differs from layer count\")\n            executables = {}\n            for i, name in enumerate(layers):\n                changes, removals, directory_replacements = {}, [], set()\n                with stream(name) as src:\n                    raw = HashReader(src)\n                    # BufferedReader needs a richer IO interface; use the seekable\n                    # outer member only to sniff the gzip magic before streaming.\n                    magic = src.read(2)\n                    src.seek(0)\n                    decoded = gzip.GzipFile(fileobj=raw) if magic == b\"\\x1f\\x8b\" else raw\n                    unpacked = HashReader(decoded)\n                    with tarfile.open(fileobj=unpacked, mode=\"r|\") as layer:\n                        for entry in layer:\n                            p = archive_name(entry.name)\n                            parent, leaf = posixpath.split(p)\n                            if leaf == \".wh..wh..opq\":\n                                removals.append(parent + \"/\" if parent else \"\")\n                            elif leaf.startswith(\".wh.\"):\n                                removals.append(posixpath.join(parent, leaf[4:]))\n                            elif p == \"app\" or p.startswith(\"app/\"):\n                                if entry.isdir():\n                                    directory_replacements.add(\"/\" + p)\n                                    changes.pop(\"/\" + p, None)\n                                else:\n                                    removals.append(p)\n                                    for key in list(changes):\n                                        if key == \"/\" + p or key.startswith(\"/\" + p + \"/\"):\n                                            del changes[key]\n                                    if entry.isfile():   # every regular file under app/ (binaries AND libraries), matching the Build CC policy\n                                        h = HashReader(layer.extractfile(entry))\n                                        changes[\"/\" + p] = h.drain()\n                            # TarFile otherwise retains every layer header.\n                            layer.members.clear()\n                    diff_sha = unpacked.drain()\n                    blob_sha = raw.drain()\n                    if magic == b\"\\x1f\\x8b\":\n                        decoded.close()\n                expected = layer_digests.get(name)\n                if name.startswith(\"blobs/sha256/\"):\n                    expected = name.rsplit(\"/\", 1)[1]\n                if expected and blob_sha != expected:\n                    raise ValueError(f\"layer blob SHA-256 mismatch: {name}\")\n                if diff_ids is not None and diff_ids[i] != \"sha256:\" + diff_sha:\n                    raise ValueError(f\"layer uncompressed SHA-256 mismatch (rootfs.diff_ids[{i}]): {name}\")\n                # Whiteouts affect the lower view regardless of order in the tar.\n                for p in removals:\n                    target = \"/\" + p\n                    for key in list(executables):\n                        if key == target or key.startswith(target.rstrip(\"/\") + \"/\"):\n                            del executables[key]\n                for key in directory_replacements:\n                    executables.pop(key, None)\n                executables.update(changes)\n            return {\"image_config_id\": \"sha256:\" + config_sha,\n                    \"platform\": f\"{config['os']}/{config['architecture']}\",\n                    \"layer_count\": len(layers), \"executables\": dict(sorted(executables.items()))}\n    except (tarfile.TarError, OSError, EOFError, KeyError, TypeError, AttributeError) as exc:\n        raise ValueError(f\"invalid image archive: {exc}\") from exc\n\n\ndef collect_facts(record_path, archive_path, config_path, gguf=None):\n    record_path, archive_path, config_path = [Path(p).resolve() for p in\n                                             (record_path, archive_path, config_path)]\n    record, config = normalize_build_record(read_json(record_path)), read_json(config_path)\n    if not isinstance(record, dict) or not isinstance(config, dict):\n        raise ValueError(\"build record and HF config must be JSON objects\")\n    archive_sha, archive_bytes = digest(archive_path)\n    config_sha, _ = digest(config_path)\n#!/usr/bin/env python3\n\"\"\"Build a local CUDA engine and record evidence; uses only the Python stdlib.\"\"\"\nimport argparse\nimport hashlib\nimport json\nimport shutil\nimport os\nfrom pathlib import Path\nimport re\nimport subprocess\nimport tarfile\nimport tempfile\nimport time\nfrom datetime import datetime, timezone\n\nRECIPES = Path(__file__).resolve().parent / \"recipes\"\nTOOLS = (\"llama-bench\", \"llama-perplexity\", \"llama-completion\", \"llama-server\",\n         \"llama-eval-callback\", \"llama-cli\", \"llama-tokenize\")\nCMAKE_FLAGS = [\"-DCMAKE_BUILD_TYPE=Release\", \"-DGGML_CUDA=ON\",\n               \"-DCMAKE_CUDA_ARCHITECTURES=120\", \"-DLLAMA_CURL=OFF\",\n               \"-DBUILD_SHARED_LIBS=ON\", \"-DGGML_NATIVE=OFF\",\n               \"-DLLAMA_BUILD_TESTS=OFF\", \"-DLLAMA_BUILD_UI=OFF\",\n               \"-DLLAMA_USE_PREBUILT_UI=OFF\", \"-DLLAMA_OPENSSL=OFF\",\n               \"-DCMAKE_C_COMPILER_LAUNCHER=ccache\", \"-DCMAKE_CXX_COMPILER_LAUNCHER=ccache\",\n               \"-DCMAKE_CUDA_COMPILER_LAUNCHER=ccache\",\n               \"-DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined\"]\nDEFAULT_DEVEL = (\"nvidia/cuda:12.8.1-devel-ubuntu24.04@sha256:\"\n                 \"520292dbb4f755fd360766059e62956e9379485d9e073bbd2f6e3c20c270ed66\")\nDEFAULT_RUNTIME = \"nvidia/cuda:12.8.1-runtime-ubuntu24.04\"\n\n\ndef validate_defines(items):\n    \"\"\"Return canonical definitions; allow only literal, single shell words.\"\"\"\n    builtins = {flag[2:].split(\"=\", 1)[0] for flag in CMAKE_FLAGS}\n    defines = {}\n    for item in items:\n        key, separator, value = item.partition(\"=\")\n        if not separator or not re.fullmatch(r\"[A-Z0-9_]+\", key):\n            raise ValueError(\"--cmake-define requires KEY=VALUE with KEY matching ^[A-Z0-9_]+$\")\n        if not re.fullmatch(r\"[A-Za-z0-9_./:+,@%=-]+\", value):\n            raise ValueError(\"--cmake-define VALUE must be nonempty and contain only letters, digits, _./:+,@%=-\")\n        if key in builtins or key in defines:\n            raise ValueError(\"Duplicate or built-in CMake definition: \" + key)\n        defines[key] = value\n    return dict(sorted(defines.items()))\n\n\ndef recipe_identity(defines, extra_targets=()):\n    recipes = {name: file_digest(RECIPES / name)\n               for name in (\"Dockerfile\", \"docker-bake.hcl\")}\n    inputs = {\"recipes\": recipes, \"cmake_defines\": defines,\n              \"cmake_flags\": CMAKE_FLAGS, \"extra_targets\": list(extra_targets)}\n    digest = hashlib.sha256(json.dumps(inputs, sort_keys=True, separators=(\",\", \":\")).encode()).hexdigest()\n    return recipes, digest\n\n\nLINKAGE_SYMBOLS = (\"cudaMalloc\", \"cudaFree\", \"cudaMemGetInfo\")\nLINKAGE_SCRIPT = r'''\nlibrary=\"\"\nfor candidate in /app/libggml-cuda.so /app/libggml-cuda.so.*; do\n    if [ -f \"$candidate\" ]; then library=\"$candidate\"; break; fi\ndone\nprintf '__CAMPAIGN_LIBRARY__%s\\n' \"$library\"\nprintf '__CAMPAIGN_LDD_BEGIN__\\n'\nif [ -z \"$library\" ]; then\n    echo 'CUDA backend library not found in /app'; ldd_rc=125\nelif command -v ldd >/dev/null 2>&1; then\n    ldd \"$library\" 2>&1; ldd_rc=$?\nelse\n    echo 'ldd unavailable in runtime image'; ldd_rc=127\nfi\nprintf '__CAMPAIGN_LDD_END__%s\\n' \"$ldd_rc\"\nsymbol_tool=unavailable\nif command -v readelf >/dev/null 2>&1; then symbol_tool=readelf\nelif command -v nm >/dev/null 2>&1; then symbol_tool=nm; fi\nprintf '__CAMPAIGN_SYMBOLS_BEGIN__%s\\n' \"$symbol_tool\"\nif [ -z \"$library\" ]; then\n    echo 'CUDA backend library not found in /app'; symbols_rc=125\nelif [ \"$symbol_tool\" = readelf ]; then\n    readelf -Ws \"$library\" 2>&1; symbols_rc=$?\nelif [ \"$symbol_tool\" = nm ]; then\n    nm -D \"$library\" 2>&1; symbols_rc=$?\nelse\n    echo 'readelf and nm unavailable in runtime image'; symbols_rc=127\nfi\nprintf '__CAMPAIGN_SYMBOLS_END__%s\\n' \"$symbols_rc\"\n'''\n\n\ndef parse_linkage(ldd_text, symbols_text, *, symbol_tool=\"readelf\",\n                  ldd_returncode=0, symbols_returncode=0):\n    dynamic = None if ldd_returncode else bool(re.search(r\"\\blibcudart\\.so(?:\\.[\\w.]+)?\\b\", ldd_text))\n    imports = {name: None for name in LINKAGE_SYMBOLS}\n    if not symbols_returncode and symbol_tool in (\"readelf\", \"nm\"):\n        for name in imports:\n            if symbol_tool == \"readelf\":\n                pattern = r\"\\bUND\\s+\" + name + r\"(?:@\\S+)?(?:\\s|$)\"\n            else:\n                pattern = r\"^\\s*(?:[0-9a-fA-F]+\\s+)?[Uwv]\\s+\" + name + r\"(?:@\\S+)?(?:\\s|$)\"\n            imports[name] = bool(re.search(pattern, symbols_text, re.MULTILINE))\n    unavailable = bool(ldd_returncode or symbols_returncode or symbol_tool not in (\"readelf\", \"nm\"))\n    passed = dynamic is True and all(value is True for value in imports.values())\n    return {\"status\": \"unavailable\" if unavailable else \"passed\" if passed else \"failed\",\n            \"libcudart_dynamic\": dynamic, \"undefined_imports\": imports,\n            \"ldd\": {\"returncode\": ldd_returncode,\n                    \"reason\": ldd_text.strip() if ldd_returncode else None},\n            \"symbols\": {\"tool\": symbol_tool, \"returncode\": symbols_returncode,\n                        \"reason\": symbols_text.strip() if symbols_returncode or symbol_tool == \"unavailable\" else None}}\n\n\ndef collect_linkage(run, out, image_id):\n    result = {\"status\": \"unavailable\", \"image_config_id\": image_id,\n              \"libcudart_dynamic\": None, \"undefined_imports\": dict.fromkeys(LINKAGE_SYMBOLS),\n              \"raw_output\": \"linkage.raw.txt\", \"stderr_output\": \"linkage.stderr.txt\"}\n    try:\n        run([\"docker\", \"run\", \"--rm\", \"--network=none\", \"--read-only\",\n             \"--entrypoint\", \"/bin/sh\", image_id, \"-c\", LINKAGE_SCRIPT],\n            stdout_path=out / \"linkage.raw.txt\", stderr_path=out / \"linkage.stderr.txt\", timeout=60)\n        raw = (out / \"linkage.raw.txt\").read_text()\n        match = re.fullmatch(r\"__CAMPAIGN_LIBRARY__([^\\n]*)\\n__CAMPAIGN_LDD_BEGIN__\\n(.*?)\"\n                             r\"__CAMPAIGN_LDD_END__(\\d+)\\n__CAMPAIGN_SYMBOLS_BEGIN__(\\w+)\\n(.*?)\"\n                             r\"__CAMPAIGN_SYMBOLS_END__(\\d+)\\n\", raw, re.DOTALL)\n        if not match:\n            raise ValueError(\"Malformed linkage probe output; see linkage.raw.txt and linkage.stderr.txt\")\n        library, ldd, ldd_rc, tool, symbols, symbols_rc = match.groups()\n        (out / \"linkage.ldd.txt\").write_text(ldd)\n        (out / \"linkage.symbols.txt\").write_text(symbols)\n        result.update(parse_linkage(ldd, symbols, symbol_tool=tool,\n                                   ldd_returncode=int(ldd_rc), symbols_returncode=int(symbols_rc)))\n        result.update(library=library or None, ldd_output=\"linkage.ldd.txt\",\n                      symbols_output=\"linkage.symbols.txt\")\n    except Exception as exc:\n        result.update(status=\"unavailable\", reason=str(exc))\n    return result\n\n\ndef file_digest(path):\n    digest = hashlib.sha256()\n    size = 0\n    with Path(path).open(\"rb\") as stream:\n        for chunk in iter(lambda: stream.read(1024 * 1024), b\"\"):\n            digest.update(chunk)\n            size += len(chunk)\n    return {\"sha256\": digest.hexdigest(), \"bytes\": size}\n\n\ndef archive_identities(path):\n    \"\"\"Read the linux/amd64 config through OCI indexes or a classic Docker manifest.\n\n    index.json is an archive catalog, not necessarily the original image index.\n\"\"\"No Docker daemon, CUDA toolkit, GPU, or network needed.\"\"\"\nimport argparse\nimport hashlib\nimport io\nimport json\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport tarfile\n\nimport pytest\n\nimport build_engine as engine\n\nFIXTURES = Path(__file__).parent / \"fixtures\"\n\nCONFIG = {\"os\": \"linux\", \"architecture\": \"amd64\", \"config\": {}}\nCONFIG_ID = \"sha256:\" + hashlib.sha256(json.dumps(CONFIG).encode()).hexdigest()\n\n\ndef classic_archive():\n    return {\"manifest.json\": [{\"Config\": CONFIG_ID.split(\":\")[1] + \".json\", \"Layers\": []}],\n            CONFIG_ID.split(\":\")[1] + \".json\": CONFIG}\n\n\ndef oci_archive():\n    \"\"\"Construct real content-addressed index -> platform manifest -> config bytes.\"\"\"\n    objects = {}\n\n    def add(doc, media_type, **extra):\n        raw = json.dumps(doc).encode()\n        digest = \"sha256:\" + hashlib.sha256(raw).hexdigest()\n        objects[\"blobs/sha256/\" + digest.split(\":\")[1]] = doc\n        return {\"digest\": digest, \"mediaType\": media_type, \"size\": len(raw), **extra}\n\n    def image(config):\n        config_desc = add(config, \"application/vnd.oci.image.config.v1+json\")\n        return add({\"schemaVersion\": 2, \"config\": config_desc, \"layers\": []},\n                   \"application/vnd.oci.image.manifest.v1+json\",\n                   platform={\"os\": config[\"os\"], \"architecture\": config[\"architecture\"]})\n\n    arm = image({**CONFIG, \"architecture\": \"arm64\"})\n    amd = image(CONFIG)\n    attestation = add({\"schemaVersion\": 2, \"layers\": []}, \"application/vnd.oci.image.manifest.v1+json\",\n                      platform={\"os\": \"unknown\", \"architecture\": \"unknown\"},\n                      annotations={\"vnd.docker.reference.type\": \"attestation-manifest\"})\n    index = add({\"schemaVersion\": 2, \"manifests\": [arm, attestation, amd]},\n                \"application/vnd.oci.image.index.v1+json\")\n    objects[\"index.json\"] = {\"schemaVersion\": 2, \"manifests\": [index, amd]}\n    return objects, index[\"digest\"], amd[\"digest\"]\n\n\ndef linkage_output(ldd=None, symbols=None, tool=\"readelf\", ldd_rc=0, symbols_rc=0):\n    return (\"__CAMPAIGN_LIBRARY__/app/libggml-cuda.so.0\\n__CAMPAIGN_LDD_BEGIN__\\n\"\n            + (ldd if ldd is not None else (FIXTURES / \"ldd.txt\").read_text())\n            + f\"__CAMPAIGN_LDD_END__{ldd_rc}\\n__CAMPAIGN_SYMBOLS_BEGIN__{tool}\\n\"\n            + (symbols if symbols is not None else (FIXTURES / \"readelf.txt\").read_text())\n            + f\"__CAMPAIGN_SYMBOLS_END__{symbols_rc}\\n\")\n\n\n@pytest.fixture\ndef source(tmp_path):\n    repo = tmp_path / \"repo\"\n    repo.mkdir()\n    subprocess.run([\"git\", \"init\", \"--quiet\", str(repo)], check=True)\n    (repo / \"input.txt\").write_text(\"original\\n\")\n    subprocess.run([\"git\", \"-C\", str(repo), \"add\", \".\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(repo), \"-c\", \"user.name=Test\", \"-c\",\n                    \"user.email=test@example.invalid\", \"-c\", \"core.hooksPath=/dev/null\",\n                    \"commit\", \"--quiet\", \"-m\", \"fixture\"], check=True)\n    return repo\n\n\ndef arguments(source, tmp_path, patch=None):\n    commit = subprocess.check_output([\"git\", \"-C\", str(source), \"rev-parse\", \"HEAD\"], text=True).strip()\n    return argparse.Namespace(source=str(source), commit=commit, patch=patch,\n                              tag=\"campaign/test:unit\", out=str(tmp_path / \"out\"))\n\n\ndef record(args):\n    return json.loads((Path(args.out) / \"build-record.json\").read_text())\n\n\ndef make_tar(path, objects):\n    with tarfile.open(path, \"w\") as archive:\n        for name, obj in objects.items():\n            data = json.dumps(obj).encode()\n            member = tarfile.TarInfo(name)\n            member.size = len(data)\n            archive.addfile(member, io.BytesIO(data))\n\n\ndef test_sha256_bytes(tmp_path):\n    path = tmp_path / \"payload\"\n    data = b\"hello\\x00world\" * 200000\n    path.write_bytes(data)\n    assert engine.file_digest(path) == {\"sha256\": hashlib.sha256(data).hexdigest(), \"bytes\": len(data)}\n    path.write_bytes(b\"\")\n    assert engine.file_digest(path) == {\"sha256\": hashlib.sha256(b\"\").hexdigest(), \"bytes\": 0}\n\n\ndef test_patch_check_failure(source, tmp_path):\n    patch = tmp_path / \"bad.patch\"\n    patch.write_text(\"diff --git a/input.txt b/input.txt\\n--- a/input.txt\\n+++ b/input.txt\\n@@ -1 +1 @@\\n-missing\\n+changed\\n\")\n    args = arguments(source, tmp_path, str(patch))\ndef test_invalid_define_before_output_creation(source, tmp_path):\n    args = arguments(source, tmp_path)\n    args.cmake_define = [\"GGML_CUDA=OFF\"]\n    with pytest.raises(ValueError, match=\"built-in\"):\n        engine.build(args)\n    assert not Path(args.out).exists()\n\n\n@pytest.mark.parametrize(\"tool\", [\"readelf\", \"nm\"])\ndef test_linkage_parser_captured_elf(tool):\n    result = engine.parse_linkage((FIXTURES / \"ldd.txt\").read_text(),\n                                  (FIXTURES / (tool + \".txt\")).read_text(), symbol_tool=tool)\n    assert result[\"status\"] == \"passed\"\n    assert result[\"libcudart_dynamic\"] is True\n    assert result[\"undefined_imports\"] == dict.fromkeys(engine.LINKAGE_SYMBOLS, True)\n\n\ndef test_linkage_parser_versioned_imports_and_exact_names():\n    text = \"  1: 000000 0 FUNC GLOBAL DEFAULT UND cudaMalloc@libcudart.so.12 (2)\\n\"\n    text += \"  2: 000000 0 FUNC GLOBAL DEFAULT UND cudaFreeAsync\\n\"\n    text += \"  3: 000001 8 FUNC GLOBAL DEFAULT 12 cudaMemGetInfo\\n\"\n    result = engine.parse_linkage(\"libcudart.so.12 => not found\\n\", text)\n    assert result[\"libcudart_dynamic\"] is True\n    assert result[\"undefined_imports\"] == {\"cudaMalloc\": True, \"cudaFree\": False, \"cudaMemGetInfo\": False}\n    assert result[\"status\"] == \"failed\"\n    assert engine.parse_linkage(\"libc.so.6 => /lib/libc.so.6\\n\", \"\")[\"libcudart_dynamic\"] is False\n\n\n@pytest.mark.parametrize(\"missing\", [\"ldd\", \"symbols\", \"both\"])\ndef test_linkage_parser_unavailable_is_not_false(missing):\n    result = engine.parse_linkage(\"ldd unavailable\\n\", \"readelf and nm unavailable\\n\",\n                                  ldd_returncode=127 if missing in (\"ldd\", \"both\") else 0,\n                                  symbols_returncode=127 if missing in (\"symbols\", \"both\") else 0,\n                                  symbol_tool=\"unavailable\" if missing in (\"symbols\", \"both\") else \"readelf\")\n    assert result[\"status\"] == \"unavailable\"\n    if missing in (\"ldd\", \"both\"):\n        assert result[\"libcudart_dynamic\"] is None\n        assert \"unavailable\" in result[\"ldd\"][\"reason\"]\n    if missing in (\"symbols\", \"both\"):\n        assert all(value is None for value in result[\"undefined_imports\"].values())\n        assert \"unavailable\" in result[\"symbols\"][\"reason\"]\n\n\ndef test_linkage_build_success_and_raw_outputs(source, tmp_path, mock_docker):\n    args = arguments(source, tmp_path)\n    args.linkage = True\n    assert engine.build(args) == 0\n    linkage = record(args)[\"linkage\"]\n    assert linkage[\"status\"] == \"passed\"\n    assert linkage[\"image_config_id\"] == CONFIG_ID\n    assert linkage[\"library\"] == \"/app/libggml-cuda.so.0\"\n    assert (Path(args.out) / linkage[\"ldd_output\"]).read_text() == (FIXTURES / \"ldd.txt\").read_text()\n    assert (Path(args.out) / linkage[\"symbols_output\"]).read_text() == (FIXTURES / \"readelf.txt\").read_text()\n    assert (Path(args.out) / \"linkage.stderr.txt\").read_text() == \"probe diagnostic\\n\"\n\n\n@pytest.mark.parametrize(\"optional\", [False, True])\n@pytest.mark.parametrize(\"failure\", [\"missing_tools\", \"missing_imports\", \"docker\", \"malformed\", \"timeout\"])\ndef test_linkage_failure_policy(source, tmp_path, mock_docker, optional, failure):\n    args = arguments(source, tmp_path)\n    args.linkage = not optional\n    args.linkage_optional = optional  # this flag alone also enables the check\n    state = mock_docker[1]\n    if failure == \"missing_tools\":\n        state[\"linkage_output\"] = linkage_output(symbols=\"readelf and nm unavailable\\n\",\n                                                 tool=\"unavailable\", symbols_rc=127)\n    elif failure == \"missing_imports\":\n        state[\"linkage_output\"] = linkage_output(symbols=\"no CUDA imports\\n\")\n    elif failure == \"docker\":\n        state[\"linkage_code\"] = 125\n    elif failure == \"timeout\":\n        state[\"linkage_timeout\"] = True\n    else:\n        state[\"linkage_output\"] = \"unexpected probe output\\n\"\n    assert engine.build(args) == (0 if optional else 1)\n    result = record(args)\n    assert result[\"status\"] == (\"success\" if optional else \"failed\")\n    assert result[\"failure_stage\"] == (None if optional else \"linkage\")\n    assert result[\"linkage\"][\"status\"] == (\"failed\" if failure == \"missing_imports\" else \"unavailable\")\n    assert result[\"archive\"]  # all other evidence survives even a fatal linkage failure\n    assert (Path(args.out) / \"linkage.raw.txt\").exists()\n    if failure == \"timeout\":\n        assert (Path(args.out) / \"linkage.raw.txt\").read_text() == \"partial probe output\\n\"\n        assert \"timed out\" in result[\"linkage\"][\"reason\"]\n\n\n@pytest.mark.parametrize(\"tool\", [\"readelf\", \"nm\", \"unavailable\"])\ndef test_probe_shell_tool_selection_and_versioned_library(tmp_path, tool):\n    import os\n    import shlex\n    app = tmp_path / \"app\"\n    app.mkdir()\n    (app / \"libggml-cuda.so.0\").touch()\n    bin_dir = tmp_path / \"bin\"\n    bin_dir.mkdir()\n    for name, output in [(\"ldd\", (FIXTURES / \"ldd.txt\").read_text())] + (\n            [] if tool == \"unavailable\" else [(tool, (FIXTURES / (tool + \".txt\")).read_text())]):\n        executable = bin_dir / name\n        executable.write_text(\"#!/bin/sh\\nprintf '%s' \" + shlex.quote(output) + \"\\n\")\n        executable.chmod(0o755)\n    script = engine.LINKAGE_SCRIPT.replace(\"/app\", str(app))\n    result = subprocess.run([\"/bin/sh\", \"-c\", script], env={**os.environ, \"PATH\": str(bin_dir)},\n                            capture_output=True, text=True, check=True)\n    assert f\"__CAMPAIGN_LIBRARY__{app}/libggml-cuda.so.0\\n\" in result.stdout\n    assert f\"__CAMPAIGN_SYMBOLS_BEGIN__{tool}\\n\" in result.stdout\n    assert f\"__CAMPAIGN_SYMBOLS_END__{127 if tool == 'unavailable' else 0}\\n\" in result.stdout\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"The current check relies on `readelf` or `nm` inside the image. I’ll move symbol inspection to the saved archive, using a pure Python ELF reader, and retain the in-image `ldd` evidence. I’ll preserve the existing uncommitted work and add coverage for layer whiteouts, symlink resolution, and the new pass criteria."}}
