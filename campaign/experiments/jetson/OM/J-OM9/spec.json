{
  "id": "J-OM9",
  "outdir_base": "experiments/jetson/OM",
  "runner": "om_run",
  "tool": "llama-completion",
  "argv": [
    "-m",
    "/om/model.gguf",
    "-f",
    "/om/prompts/p1.txt",
    "-n",
    "64",
    "-c",
    "4096",
    "--temp",
    "0",
    "-s",
    "1",
    "-no-cnv",
    "-ngl",
    "99",
    "-lm",
    "mmap",
    "-cmoe",
    "-lv",
    "4"
  ],
  "metric": "eval_tps",
  "arms": {
    "base": {
      "image": "campaign/llamacpp:jetson-up1108-om9",
      "env": {
        "LLAMA_EXPERT_FILL": "0",
        "LLAMA_EXPERT_FILL_RANDOM": "0",
        "LLAMA_EXPERT_FILL_THREADS": "8",
        "LLAMA_EXPERT_FILL_CHUNK_KIB": "1024",
        "LLAMA_EXPERT_PREFETCH": "0",
        "LLAMA_EXPERT_PREFETCH_NEXT": "0",
        "LLAMA_MMAP_ADVICE": "default",
        "LLAMA_EXPERT_FILL_MAX_TOKENS": "0",
        "LLAMA_EXPERT_FILL_MIN_TOKENS": "0",
        "LLAMA_EXPERT_FILL_DIAG": "0",
        "LLAMA_EXPERT_FILL_POPULATE": "0"
      },
      "expect_switch": false,
      "switch_regex": [
        "expert_fill: active",
        "expert_fill: random advice applied at decode"
      ]
    },
    "frd16": {
      "image": "campaign/llamacpp:jetson-up1108-om9",
      "env": {
        "LLAMA_EXPERT_FILL": "1",
        "LLAMA_EXPERT_FILL_RANDOM": "decode",
        "LLAMA_EXPERT_FILL_THREADS": "16",
        "LLAMA_EXPERT_FILL_CHUNK_KIB": "2048",
        "LLAMA_EXPERT_PREFETCH": "0",
        "LLAMA_EXPERT_PREFETCH_NEXT": "0",
        "LLAMA_MMAP_ADVICE": "default",
        "LLAMA_EXPERT_FILL_MAX_TOKENS": "1",
        "LLAMA_EXPERT_FILL_MIN_TOKENS": "0",
        "LLAMA_EXPERT_FILL_DIAG": "0",
        "LLAMA_EXPERT_FILL_POPULATE": "0"
      },
      "expect_switch": true,
      "switch_regex": [
        "expert_fill: active",
        "expert_fill: random advice applied at decode"
      ]
    },
    "frd16d": {
      "image": "campaign/llamacpp:jetson-up1108-om9",
      "env": {
        "LLAMA_EXPERT_FILL": "1",
        "LLAMA_EXPERT_FILL_RANDOM": "decode",
        "LLAMA_EXPERT_FILL_THREADS": "16",
        "LLAMA_EXPERT_FILL_CHUNK_KIB": "2048",
        "LLAMA_EXPERT_PREFETCH": "0",
        "LLAMA_EXPERT_PREFETCH_NEXT": "0",
        "LLAMA_MMAP_ADVICE": "default",
        "LLAMA_EXPERT_FILL_MAX_TOKENS": "1",
        "LLAMA_EXPERT_FILL_MIN_TOKENS": "0",
        "LLAMA_EXPERT_FILL_DIAG": "1",
        "LLAMA_EXPERT_FILL_POPULATE": "0"
      },
      "expect_switch": true,
      "switch_regex": [
        "expert_fill: active",
        "expert_fill: random advice applied at decode",
        "expert_fill: diag"
      ]
    },
    "frd16p": {
      "image": "campaign/llamacpp:jetson-up1108-om9",
      "env": {
        "LLAMA_EXPERT_FILL": "1",
        "LLAMA_EXPERT_FILL_RANDOM": "decode",
        "LLAMA_EXPERT_FILL_THREADS": "16",
        "LLAMA_EXPERT_FILL_CHUNK_KIB": "2048",
        "LLAMA_EXPERT_PREFETCH": "0",
        "LLAMA_EXPERT_PREFETCH_NEXT": "0",
        "LLAMA_MMAP_ADVICE": "default",
        "LLAMA_EXPERT_FILL_MAX_TOKENS": "1",
        "LLAMA_EXPERT_FILL_MIN_TOKENS": "0",
        "LLAMA_EXPERT_FILL_DIAG": "1",
        "LLAMA_EXPERT_FILL_POPULATE": "1"
      },
      "expect_switch": true,
      "switch_regex": [
        "expert_fill: active",
        "expert_fill: random advice applied at decode",
        "expert_fill: diag"
      ]
    }
  },
  "order": "explicit",
  "rounds": 1,
  "explicit_order": [
    "base",
    "frd16",
    "frd16d",
    "frd16p",
    "frd16p",
    "frd16d",
    "frd16",
    "base"
  ]
}
