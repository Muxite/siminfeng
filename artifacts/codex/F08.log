"""Validated Builder submissions; compilation runs entirely under jobq."""
from __future__ import annotations

import hashlib
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

from .jobs import Jobs, KeyConflict, fingerprint
from .store import encoded

ENGINE = Path('/home/muk/projects/siminfeng/cc/build_engine/build_engine.py')
RECIPE = Path('/home/muk/projects/siminfeng/builds/llamacpp-jetson/Dockerfile')
# Explicit environment inputs affecting compilation. Credentials never enter receipts.
ENV_KEYS = {'PATH', 'LD_LIBRARY_PATH', 'BUILD_JOBS', 'CC', 'CXX', 'CUDAHOSTCXX',
            'CUDACXX', 'CUDA_HOME', 'CUDA_PATH', 'CFLAGS', 'CXXFLAGS', 'LDFLAGS',
            'CCACHE_DIR', 'CCACHE_BASEDIR', 'CCACHE_COMPILERCHECK', 'CCACHE_NOHASHDIR',
            'FACTORY_BUILD_ENGINE', 'BASE_RUNTIME'}


class Builder:
    def __init__(self, store, jobq_bin=Path('/home/muk/projects/siminfeng/bin/jobq'), jobq_dir=None):
        self.store = store
        self.jobs = Jobs(store, jobq_bin, jobq_dir)
        # Reused attempts retain their original identity. Bind additional keys
        # durably so a later request cannot silently change a reuse key's input.
        with store._transaction():
            store._db.execute('CREATE TABLE IF NOT EXISTS builder_reuse_keys (task_id TEXT NOT NULL, idem_key TEXT NOT NULL, fingerprint TEXT NOT NULL, attempt_id TEXT NOT NULL, PRIMARY KEY(task_id, idem_key))')

    def _request(self, request):
        if not isinstance(request, dict) or request.get('target') != 'jetson-orin':
            raise ValueError('target must be jetson-orin')
        if set(request) - {'target', 'source', 'patch', 'tag', 'deadline_s', 'env'}:
            raise ValueError('Unknown build request fields')
        source = request['source']
        path = Path(source['path']).expanduser().resolve()
        def git(*args):
            return subprocess.run(['git', '-C', str(path), *args], check=True,
                stdin=subprocess.DEVNULL, capture_output=True, text=True).stdout.strip()
        try:
            commit = git('rev-parse', 'HEAD')
            if commit != source['commit'] or git('status', '--porcelain', '--untracked-files=all'):
                raise ValueError('Source must be clean and HEAD must equal commit')
            tree = git('rev-parse', 'HEAD^{tree}')
        except subprocess.CalledProcessError as exc:
            raise ValueError('Source must be a git repository') from exc
        if not isinstance(request.get('tag'), str) or not re.fullmatch(r'factory/llamacpp:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}', request['tag']):
            raise ValueError('tag must use factory/llamacpp namespace')
        deadline = request.get('deadline_s') or 5400
        if isinstance(deadline, bool) or not isinstance(deadline, (int, float)) or not math.isfinite(deadline) or deadline <= 0:
            raise ValueError('deadline_s must be positive and finite')
        extra = request.get('env', {})
        if not isinstance(extra, dict) or set(extra) - ENV_KEYS or not all(isinstance(v, str) for v in extra.values()):
            raise ValueError('Invalid build environment')
        env = {key: os.environ[key] for key in ENV_KEYS if key in os.environ}
        env.update(extra)
        # Normalize the actual environment jobq will capture.
        env['PATH'] = env.get('PATH', os.defpath)
        engine = Path(env.get('FACTORY_BUILD_ENGINE', ENGINE)).resolve()
        normalized = dict(target='jetson-orin', source=dict(path=str(path), commit=commit, tree=tree),
            tag=request['tag'], deadline_s=deadline, env=env,
            engine_sha256=hashlib.sha256(engine.read_bytes()).hexdigest(),
            recipe_sha256=hashlib.sha256(RECIPE.read_bytes()).hexdigest())
        if request.get('patch'):
            patch = Path(request['patch']).expanduser().resolve()
            normalized.update(patch=str(patch), patch_sha256=hashlib.sha256(patch.read_bytes()).hexdigest())
        return normalized

    def submit(self, task_id, request, idem_key):
        self.store.get_task(task_id)
        if not isinstance(idem_key, str) or not idem_key.strip():
            raise ValueError('idem_key must be nonempty')
        request = self._request(request)
        # Stable request path and argv keep attempt identity out of its fingerprint.
        digest = hashlib.sha256(encoded(request).encode()).hexdigest()
        root = self.store.home / 'requests'
        root.mkdir(exist_ok=True)
        request_path = root / (digest + '.json')
        if not request_path.exists():
            fd, name = tempfile.mkstemp(dir=root)
            with os.fdopen(fd, 'w') as stream:
                json.dump(request, stream, sort_keys=True)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(name, request_path)
        argv = [sys.executable, '-m', 'jiuwenswarm.factory.build_job', '--task', task_id,
                '--attempt', '{attempt_id}', '--request', str(request_path)]
        fp = fingerprint('build', request, argv, 'build', request['deadline_s'])
        # Reconcile matching jobs before deciding whether completed output can
        # be reused. No caller needs to have polled their success previously.
        candidates = self.store._db.execute("SELECT attempt_id FROM attempts WHERE task_id=? AND kind='build' AND fingerprint=?", (task_id, fp)).fetchall()
        for candidate in candidates:
            self.jobs.status(candidate['attempt_id'])
        # Reuse is task-local and limited to observed successful output.
        with self.jobs.locked():
            alias = self.store._db.execute('SELECT * FROM builder_reuse_keys WHERE task_id=? AND idem_key=?', (task_id, idem_key)).fetchone()
            if alias:
                if alias['fingerprint'] != fp:
                    raise KeyConflict('Idempotency key names different inputs')
                return self.jobs._get(alias['attempt_id'])
            keyed = self.store._db.execute('SELECT fingerprint FROM attempts WHERE task_id=? AND idem_key=?', (task_id, idem_key)).fetchone()
            if keyed and keyed['fingerprint'] != fp:
                raise KeyConflict('Idempotency key names different inputs')
            if not keyed:
                rows = self.store._db.execute("SELECT * FROM attempts WHERE task_id=? AND kind='build' AND fingerprint=? AND state='succeeded'", (task_id, fp)).fetchall()
                if rows:
                    result = self.store._decode('attempts', rows[0])
                    with self.store._transaction():
                        self.store._db.execute('INSERT INTO builder_reuse_keys VALUES (?,?,?,?)',
                            (task_id, idem_key, fp, result['attempt_id']))
                    return result
        env = dict(request['env'], FACTORY_HOME=str(self.store.home))
        return self.jobs.submit(task_id, 'build', request, idem_key, 'build', argv, request['deadline_s'], env)

    def status(self, attempt_id):
        return self.jobs.status(attempt_id)

    def cancel(self, attempt_id):
        return self.jobs.cancel(attempt_id)

    def result(self, attempt_id):
        return self.jobs.result(attempt_id)


def submit(store, task_id, request, idem_key):
    return Builder(store).submit(task_id, request, idem_key)


def status(store, attempt_id):
    return Builder(store).status(attempt_id)


def cancel(store, attempt_id):
    return Builder(store).cancel(attempt_id)


def result(store, attempt_id):
    return Builder(store).result(attempt_id)
"""Versioned greedy-continuation contracts. Freezing is an operator action."""
from __future__ import annotations

import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import tempfile
from datetime import datetime, timezone

CONTRACTS = Path(__file__).parent / 'contracts'
OUTCOMES = {'ok', 'config_rejected', 'measurement_failed', 'candidate_failed',
            'wrong_target', 'bad_digest', 'cancelled', 'upload_pending'}


class ContractFrozen(ValueError):
    pass


class Contract(dict):
    path: Path


def load(contract_id):
    path = Path(contract_id)
    if not path.is_file():
        if not re.fullmatch(r'[A-Za-z0-9_-]+', str(contract_id)):
            raise ValueError('Invalid contract identifier')
        path = CONTRACTS / (str(contract_id) + '.json')
    result = Contract(json.loads(path.read_text()))
    result.path = path.resolve()
    if result['version'] < 1 or result['tolerance'] != 'byte-identical stdout':
        raise ValueError('Unsupported contract version or tolerance')
    return result


def atomic_json(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix='.pending-')
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(value, stream, sort_keys=True, indent=2, allow_nan=False)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    finally:
        Path(temporary).unlink(missing_ok=True)


def freeze(contract, reference_run):
    """Write the reference once, under a process lock; return the frozen contract."""
    if not isinstance(contract, Contract):
        contract = load(contract)
    with contract.path.with_suffix('.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        current = load(contract.path)
        if current['reference']['stdout_sha256'] is not None:
            raise ContractFrozen('Contract is frozen; create a version+1 contract file')
        if (reference_run.get('execution_outcome') != 'ok' or
                reference_run.get('evidence_completeness') != 'complete' or
                reference_run.get('image_id') != current['reference']['image_id']):
            raise ValueError('Reference requires a successful complete run of the pinned reference image')
        sha = reference_run.get('stdout_sha256', '')
        if not re.fullmatch(r'[a-f0-9]{64}', sha):
            raise ValueError('Reference stdout SHA256 is required')
        current['reference'].update(stdout_sha256=sha,
            frozen_at=datetime.now(timezone.utc).isoformat(), run_ref=reference_run['run_ref'])
        atomic_json(current.path, current)
        contract.clear()
        contract.update(current)
        return contract


def evaluate(contract, run):
    outcome = run.get('execution_outcome', 'measurement_failed')
    if outcome not in OUTCOMES:
        raise ValueError('Unknown execution outcome')
    complete = run.get('evidence_completeness') == 'complete'
    details = dict(run.get('details', {}))
    correctness = 'not_evaluated'
    reference = contract['reference']['stdout_sha256']
    if outcome == 'ok' and complete and reference and run.get('stdout_sha256'):
        correctness = 'pass' if reference == run['stdout_sha256'] else 'fail'
        if correctness == 'fail':
            outcome = 'candidate_failed'
    elif outcome == 'ok':
        details['unscored_reason'] = 'reference_unfrozen' if not reference else 'incomplete_evidence'
    return dict(execution_outcome=outcome, correctness=correctness,
                evidence_completeness='complete' if complete else 'partial', details=details)
"""Deterministic admission, durable lab submission and evidence upload boundary."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import time

from . import contract as contracts
from .jobs import Jobs
from .lab_runner import ENV_KEYS, collect, inspect_image
from .store import ArtifactConflict, FactoryError, NotFound, Store, encoded

BASELINE_RECORD = Path('/home/muk/projects/siminfeng/cc/build_engine/results/jetson-up1108-om11/build-record.json')


class AdmissionError(FactoryError):
    def __init__(self, code, message):
        self.code = code
        super().__init__(message)


class UploadConflict(FactoryError):
    code = 'UPLOAD_CONFLICT'


class Manager:
    def __init__(self, store, spool_root):
        self.store = store
        self.spool_root = Path(spool_root).resolve()
        self.spool_root.mkdir(parents=True, exist_ok=True)
        self.jobs = Jobs(store)

    def admit(self, task_id, image_ref, build_attempt_id):
        self.store.get_task(task_id)
        if not isinstance(image_ref, dict) or set(image_ref) != {'tag', 'id'}:
            raise ValueError('image requires tag and id')
        if (not isinstance(image_ref['tag'], str) or not image_ref['tag'] or image_ref['tag'].startswith('-')
                or not re.fullmatch(r'sha256:[a-f0-9]{64}', image_ref['id'])):
            raise ValueError('Invalid image tag or immutable Id')
        build = self.store._get('attempts', task_id, build_attempt_id)
        if build['kind'] != 'build':
            raise ValueError('build_attempt_id must name a build')
        # Reconcile the durable build lifecycle before accepting its receipt.
        if build['jobq_id'] or build['state'] != 'succeeded':
            build = self.jobs.status(build_attempt_id)
        if build['state'] != 'succeeded':
            raise ValueError('Admission requires a successful build attempt')
        receipt = json.loads(self.store.artifact_bytes(task_id, build_attempt_id + ':receipt'))
        row = inspect_image(image_ref['tag'])
        if row['Id'] != receipt.get('image_id') or row['Id'] != image_ref['id']:
            raise AdmissionError('BAD_DIGEST', 'Local image Id differs from build receipt or requested Id')
        if row.get('Architecture') != 'arm64' or (row.get('Config', {}).get('Labels') or {}).get('campaign.target.profile') != 'jetson-orin':
            raise AdmissionError('WRONG_TARGET', 'Image requires arm64 and campaign.target.profile=jetson-orin')
        admission = dict(task_id=task_id, image=dict(image_ref), build_attempt_id=build_attempt_id,
            delivery='same_host_local_image', architecture='arm64', target_profile='jetson-orin')
        key = hashlib.sha256(encoded(admission).encode()).hexdigest()
        admission['admission_id'] = 'admission:' + key
        self.store.put_artifact(task_id, admission['admission_id'], encoded(admission).encode(),
                                'application/json', build_attempt_id)
        return admission

    def _admission(self, task_id, admission_id):
        record = json.loads(self.store.artifact_bytes(task_id, admission_id))
        if record['task_id'] != task_id or record['admission_id'] != admission_id:
            raise ValueError('Admission identity differs')
        return record

    def submit_run(self, task_id, admission_id, contract_id, run_config, idem_key, role='candidate'):
        # role is set only by the Manager (freeze_reference -> 'reference'); agents cannot pass it.
        if role not in {'candidate', 'reference'}:
            raise ValueError('role must be candidate or reference')
        admission = self._admission(task_id, admission_id)
        contract = contracts.load(contract_id)
        if not isinstance(run_config, dict) or set(run_config) - {'env', 'argv_overrides'}:
            raise ValueError('run_config allows env and argv_overrides')
        env = dict(contract['workload']['env'])
        requested = run_config.get('env', {})
        if not isinstance(requested, dict):
            raise ValueError('run_config.env must be an object')
        env.update(requested)
        if any(k not in set(ENV_KEYS) | {'LLAMA_MMAP_ADVICE'} or not isinstance(v, str)
               or not re.fullmatch(r'[A-Za-z0-9_./:+-]+', v) for k, v in env.items()):
            raise ValueError('Lab environment requires supported engine keys and shell-safe string values')
        argv = contract['workload']['argv']
        if run_config.get('argv_overrides') not in (None, {}, [], argv):
            raise ValueError('Scored workload argv is fixed; use a version+1 contract for changes')
        config = dict(admission=admission, contract=dict(contract), env=env, argv=argv, role=role)
        digest = hashlib.sha256(encoded(config).encode()).hexdigest()
        path = self.spool_root / 'configs' / (digest + '.json')
        if not path.exists():
            contracts.atomic_json(path, config)
        argv = [sys.executable, '-m', 'jiuwenswarm.factory.lab_runner', '--task', task_id,
            '--run', '{attempt_id}', '--admission', admission_id, '--contract', contract['contract_id'],
            '--config', str(path), '--spool', str(self.spool_root)]
        env_extra = dict(FACTORY_HOME=str(self.store.home))
        # Only these explicit executable seams are inherited for offline tests.
        for key in ('FACTORY_DOCKER', 'FACTORY_OM_RUN'):
            if key in os.environ:
                env_extra[key] = os.environ[key]
        return self.jobs.submit(task_id, 'lab', config, idem_key, 'gpu', argv, 1800, env_extra)

    def status(self, attempt_id):
        return self.jobs.status(attempt_id)

    def cancel(self, attempt_id):
TERMINAL = {'accept', 'report_inconclusive', 'stop_missing_prerequisite'}


def read_tasks(task):
    constraints = task.get('constraints')
    reads = constraints.get('read_tasks', []) if isinstance(constraints, dict) else []
    if not isinstance(reads, list) or not all(isinstance(t, str) and t for t in reads):
        raise ValueError('constraints.read_tasks must be a list of task ids')
    return reads
SCRUB = [
    (re.compile(r'eyJ[A-Za-z0-9_\-]{8,}\.[A-Za-z0-9_\-]{8,}\.[A-Za-z0-9_\-]{8,}'), '<jwt>'),
    (re.compile(r'(?i)(bearer\s+)[A-Za-z0-9._\-]{16,}'), r'\1<token>'),
    (re.compile(r'sk-[A-Za-z0-9_\-]{16,}'), '<key>'),
    (re.compile(r'[\w.+-]+@[\w-]+\.[\w.-]+'), '<email>'),
    (re.compile(r'(?i)(state|code|code_challenge)=[A-Za-z0-9_\-%.~]{12,}'), r'\1=<redacted>'),
]


def scrub(value):
    if isinstance(value, str):
        for pattern, replacement in SCRUB:
            value = pattern.sub(replacement, value)
    elif isinstance(value, dict):
        value = {k: ('<redacted>' if (re.search(r'(?i)(token|secret|password|authorization|api_key)', k) and not k.startswith('LLAMA_'))
                     else scrub(v)) for k, v in value.items()}
    elif isinstance(value, (list, tuple)):
        value = [scrub(v) for v in value]
    return value


def factory_home():
    return Path(os.environ.get('FACTORY_HOME', '~/.jiuwenswarm-factory')).expanduser().resolve()


def configure_agent(task, grants=(), home=None):
    """Configure one operator-owned profile; grants are always an intersection."""
    home = Path(home or factory_home()).resolve()
    workspace, data = home / 'agent-workspace', home / 'agent-data'
    for directory in (home, workspace, data, home / 'sessions', home / 'ccstore'):
        directory.mkdir(parents=True, exist_ok=True)
    effective = sorted(set(task.get('allowed_effects', [])) & set(grants))
