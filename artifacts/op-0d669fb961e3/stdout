t BLOB = 3ull * (H * FF * BB / QK);   // 1,382,400\n    50\t\n    51\t// ---- the blob's internal layout (one expert) ----\n    52\tinline constexpr size_t O_GU_CODES = 0;\n    53\tinline constexpr size_t O_D_CODES = 2ull * FF * ROW_GU;\n    54\tinline constexpr size_t O_GU_SCALES = O_D_CODES + 1ull * H * ROW_D;\n    55\tinline constexpr size_t O_D_SCALES = O_GU_SCALES + 2ull * FF * SC_GU * 2;\n    56\t\n    57\t/// One activation in Strata's planar storage: `QKA` elements per chunk.\n    58\t/// The default legacy quantizer uses FP32 scales and half-away rounding. It is\n    59\t/// not the pinned ggml CPU Q8_0 contract; expert_set_oracle_q8_0 selects that\n    60\t/// experimental contract (FP16-rounded scales and x86 nearest-even codes).\n    61\t///\n    62\t/// The historical function name `act_quant_q8_1` does not describe a native\n    63\t/// ggml block layout. One 64-weight block always spans two 32-element chunks.\n    64\t///\n    65\t/// `hx[k] = scale[k] * sum[k]` is the weight-independent correction the Q2_0 identity needs\n    66\t/// (`sum (c-1) d_w xhat d_x = d_w (d_x*sum(c*xhat) - d_x*sum(xhat))`), precomputed once per layer rather than\n    67\t/// once per row: 640 rows would otherwise recompute it 640 times.\n    68\tstruct ActQ {\n    69\t    alignas(64) int8_t q[H];\n    70\t    float scale[MAXC];\n    71\t    int32_t sum[MAXC];\n    72\t    float hx[MAXC];\n    73\t    int nchunks;\n    74\t    /// The AVX-2 \"bit-plane\" image of `q` (src/kernels/cpu/q2_avx2.cpp explains it), filled only by\n    75\t    /// `act_quant_q8_1_avx2` with STRATA_Q2_BITPLANE=1 and read only by `q2_0_gguf_rows_multi_avx2`.  Per pair p of 64-value blocks:\n    76\t    /// `qp[128p + 32k + 16h + i] = q[128p + 64h + 4i + k]`, `psum[8p + 4h + m]` = the sum of q[128p + 64h + 16m ..\n    77\t    /// + 16), `pscale[8p + 2c + e] = scale[4p + c]`.  `bp_pairs` is 0 when the image is absent (n % 128 != 0).\n    78\t    alignas(32) int8_t qp[H];\n    79\t    alignas(32) int32_