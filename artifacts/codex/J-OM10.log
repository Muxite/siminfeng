    if (cparams.n_ctx_seq < hparams.n_ctx_train) {
        LLAMA_LOG_INFO("%s: n_ctx_seq (%u) < n_ctx_train (%u) -- the full capacity of the model will not be utilized\n",
                __func__, cparams.n_ctx_seq, hparams.n_ctx_train);
    }

    if (cparams.n_ctx_seq > hparams.n_ctx_train) {
        LLAMA_LOG_WARN("%s: n_ctx_seq (%u) > n_ctx_train (%u) -- possible training context overflow\n",
                __func__, cparams.n_ctx_seq, hparams.n_ctx_train);
    }

    if (!hparams.vocab_only) {
        // GPU backends
        for (const auto & dev : model.devices) {
            ggml_backend_t backend = ggml_backend_dev_init(dev.dev, nullptr);
            if (backend == nullptr) {
                throw std::runtime_error(format("failed to initialize %s backend", ggml_backend_dev_name(dev.dev)));
            }
            backends.emplace_back(backend);
        }

        // tensors of ctx_other (e.g. a shared KV cache) can be on devices that this model does not use
        if (cparams.ctx_other) {
            for (const auto & dev_other : llama_get_model(cparams.ctx_other)->devices) {
                const bool found = std::any_of(model.devices.begin(), model.devices.end(),
                        [&](const llama_device & dev) { return dev.dev == dev_other.dev; });
                if (found) {
                    continue;
                }
                ggml_backend_t backend = ggml_backend_dev_init(dev_other.dev, nullptr);
                if (backend == nullptr) {
                    throw std::runtime_error(format("failed to initialize %s backend", ggml_backend_dev_name(dev_other.dev)));
                }
                backends.emplace_back(backend);
            }
        }

        // add ACCEL backends (such as BLAS)
        for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
            ggml_backend_dev_t dev = ggml_backend_dev_get(i);
            if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_ACCEL) {
                ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
                if (backend == nullptr) {
                    throw std::runtime_error(format("failed to initialize %s backend", ggml_backend_dev_name(dev)));
                }
                backends.emplace_back(backend);
            }
        }

        // add CPU backend
        backend_cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
        if (backend_cpu == nullptr) {
            throw std::runtime_error("failed to initialize CPU backend");
        }
        backends.emplace_back(backend_cpu);

        // create a list of the set_n_threads functions in the backends
        for (auto & backend : backends) {
            ggml_backend_dev_t dev = ggml_backend_get_device(backend.get());
            ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
            if (reg) {
                auto ggml_backend_set_n_threads_fn = (ggml_backend_set_n_threads_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads");
                if (ggml_backend_set_n_threads_fn) {
                    set_n_threads_fns.emplace_back(backend.get(), ggml_backend_set_n_threads_fn);
                }
            }
        }

        llama_set_abort_callback(this, params.abort_callback, params.abort_callback_data);

        // graph outputs buffer
        {
            if (output_reserve(params.n_seq_max) < params.n_seq_max) {
                throw std::runtime_error("failed to reserve initial output buffer");
            }

            LLAMA_LOG_INFO("%s: %10s  output buffer size = %8.2f MiB\n", __func__,
                    ggml_backend_buffer_name    (buf_output.get()),
                    ggml_backend_buffer_get_size(buf_output.get()) / 1024.0 / 1024.0);
        }
    }

    // init the memory module
    if (!hparams.vocab_only) {
        llama_memory_params params_mem = {
            /*.type_k    =*/ params.type_k,
            /*.type_v    =*/ params.type_v,
            /*.swa_full  =*/ params.swa_full,
            /*.ctx_type  =*/ cparams.ctx_type,
            /*.mem_other =*/ llama_get_memory(cparams.ctx_other),
            /*.no_alloc  =*/ model.no_alloc(),
        };

        memory.reset(model.create_memory(params_mem, cparams));
    }

    // init backends
    if (!hparams.vocab_only) {
        LLAMA_LOG_DEBUG("%s: enumerating backends\n", __func__);

        backend_buft.clear();
        backend_ptrs.clear();
        backend_buf_exp_size.clear();

        for (auto & backend : backends) {
            auto * buft = ggml_backend_get_default_buffer_type(backend.get());
            auto backend_type = ggml_backend_dev_type(ggml_backend_get_device(backend.get()));

            if (backend_type == GGML_BACKEND_DEVICE_TYPE_CPU && !model.devices.empty()) {
                // use the host buffer of the first device CPU for faster transfer of the intermediate state
                const auto & dev = model.devices[0];
                auto * host_buft = ggml_backend_dev_host_buffer_type(dev.dev);
                if (host_buft) {
                    buft = host_buft;
                }
            }

            backend_buft.push_back(buft);
            backend_ptrs.push_back(backend.get());
            backend_buf_exp_size.push_back(0);
        }

        LLAMA_LOG_DEBUG("%s: backend_ptrs.size() = %zu\n", __func__, backend_ptrs.size());

        // TODO: move these checks to ggml_backend_sched
        // enabling pipeline parallelism in the scheduler increases memory usage, so it is only done when necessary
        bool pipeline_parallel =
            model.n_devices() > 1 &&
            model.n_gpu_layers() > model.hparams.n_layer_all &&
            model.split_mode() == LLAMA_SPLIT_MODE_LAYER &&
            cparams.offload_kqv &&
            !model.has_tensor_overrides() &&
            cparams.moe_cache_size == 0; // not supported by the MoE cache

        // pipeline parallelism requires support for async compute and events in all devices
        if (pipeline_parallel) {
            for (auto & backend : backends) {
                auto dev_type = ggml_backend_dev_type(ggml_backend_get_device(backend.get()));
                if (dev_type == GGML_BACKEND_DEVICE_TYPE_CPU) {
                    // ignore CPU backend
                    // TODO: should we ignore ACCEL types too?
                    continue;
                }
                auto * dev = ggml_backend_get_device(backend.get());
                ggml_backend_dev_props props;
                ggml_backend_dev_get_props(dev, &props);
                if (!props.caps.async || !props.caps.events) {
                    // device does not support async compute or events
                    pipeline_parallel = false;
                    break;
                }
            }
        }

        cparams.pipeline_parallel = pipeline_parallel;

        if (cparams.pipeline_parallel) {
            LLAMA_LOG_INFO("%s: pipeline parallelism enabled\n", __func__);
        }

        if (cparams.moe_cache_size > 0) {
            moe_cache = std::make_unique<llama_moe_cache>(model, model.no_alloc(), backend_ptrs, backend_buft, cparams.moe_cache_size, cparams.moe_cache_cpu_share);
        }

        sched_reserve();

        if (!cparams.flash_attn) {
            if (ggml_is_quantized(params.type_v)) {
                throw std::runtime_error("quantized V cache was requested, but this requires Flash Attention");
            }
        }
    }

    // Initialize the full vocabulary token ids for backend samplers.
    {
        const int n_vocab = model.vocab.n_tokens();

        sampling.token_ids_full_vocab.resize(n_vocab);
        for (int i = 0; i < n_vocab; ++i) {
            sampling.token_ids_full_vocab[i] = i;
        }
    }
}

#ifdef __linux__
void llama_context::expert_fill_init() {
    if (expert_fill_checked) { return; }
    expert_fill_checked = true;
    const char * fill = getenv("LLAMA_EXPERT_FILL");
    if (!fill || strcmp(fill, "1") != 0) { return; }
    try {
        for (const auto & layer : model.layers) {
            for (const ggml_tensor * w : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
                if (!w) { continue; }
                llama_model::expert_file_range info;
                if (w->ne[2] <= 0 || w->ne[3] != 1 || !ggml_is_contiguous(w) || !w->nb[2] ||
                        !model.expert_file_info(w, info)) {
                    throw std::runtime_error("expert tensors not mmap-backed or file offsets unavailable/unsupported layout");
                }
                if (!expert_fillers.count(info.file_index)) {
                    expert_fillers.emplace(info.file_index, std::make_unique<ExpertFiller>(
                        "/proc/self/fd/" + std::to_string(info.source_fd), info.mapping, info.mapping_size));
                }
            }
        }
        if (expert_fillers.empty()) { throw std::runtime_error("no mmap-backed expert tensors"); }
        expert_prefetch_layers.resize(model.layers.size());
        expert_fill_enabled = true;
        expert_diag_enabled = expert_fillers.begin()->second->diagnostic();
        if (expert_diag_enabled) {
            const char * csv = getenv("LLAMA_EXPERT_FILL_DIAG_CSV");
            if (csv && *csv) {
                expert_diag_csv = fopen(csv, "w");
                if (!expert_diag_csv) { throw std::runtime_error("cannot open diagnostic CSV"); }
                fprintf(expert_diag_csv, "token_idx,fill_ns,between_ns,majflt_fill,majflt_between,post_fill_nonresident_pages,pre_use_nonresident_pages,bytes_read\n");
            }
        }
        const char * random = getenv("LLAMA_EXPERT_FILL_RANDOM");
        expert_fill_random_decode = random && strcmp(random, "decode") == 0;
        auto token_limit = [](const char * name) -> uint64_t {
            const char * value = getenv(name);
            if (!value || !*value || *value == '-') { return 0; }
            char * end = nullptr; errno = 0;
            const auto n = strtoull(value, &end, 10);
            return errno || *end ? 0 : n;
        };
        expert_fill_min_tokens = token_limit("LLAMA_EXPERT_FILL_MIN_TOKENS");
        expert_fill_max_tokens = token_limit("LLAMA_EXPERT_FILL_MAX_TOKENS");
        const auto & filler = *expert_fillers.begin()->second;
        LLAMA_LOG_INFO("expert_fill: active threads=%zu chunk_kib=%zu random=%s files=%zu\n",
            filler.threads(), filler.chunk_bytes() / 1024, expert_fill_random_decode ? "decode" : (random && strcmp(random, "1") == 0 ? "1" : "0"), expert_fillers.size());
    } catch (const std::exception & e) {
        expert_fill_enabled = false; expert_diag_enabled = false;
        if (expert_diag_csv) { fclose(expert_diag_csv); expert_diag_csv = nullptr; }
        expert_fillers.clear();
        LLAMA_LOG_INFO("expert_fill: inactive (%s)\n", e.what());
    }
}

static uint64_t expert_diag_now() {
    return std::chrono::duration_cast<std::chrono::nanoseconds>(
        std::chrono::steady_clock::now().time_since_epoch()).count();
}
void llama_context::expert_diag_close_gap() {
    if (!expert_diag_gap) { return; }
    struct rusage r {}; getrusage(RUSAGE_SELF, &r);
    if (expert_fill_failed || !expert_fill_this_ubatch) { return; }
    try {
        std::map<size_t, std::vector<ExpertFiller::Range>> ranges;
        const auto & layer = model.layers[il];
        for (const ggml_tensor * w : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
            if (!w) { continue; }
            llama_model::expert_file_range info;
            if (!model.expert_file_info(w, info)) { throw std::runtime_error("expert mmap/file offsets unavailable"); }
            for (const auto id : selected) {
                if (id < 0 || id >= w->ne[2] || size_t(id) > (SIZE_MAX - info.offset) / w->nb[2]) {
                    throw std::runtime_error("expert slice out of bounds");
                }
                ranges[info.file_index].push_back({info.offset + size_t(id) * w->nb[2], w->nb[2]});
            }
        }
        const bool diag = expert_diag_enabled && expert_diag_token_active;
        struct rusage before {}, after {}, thread_before {}, thread_after {};
        uint64_t start = 0;
        if (diag) {
            // Previous layer was consumed; this is a separate, after-use eviction probe.
            for (const auto & entry : expert_diag_previous) {
                expert_diag_token.next_nonresident += expert_fillers.at(entry.first)->nonresident(entry.second);
                ++expert_diag_token.next_checks;
            }
            expert_diag_close_gap();
            getrusage(RUSAGE_SELF, &before); getrusage(RUSAGE_THREAD, &thread_before);
            start = expert_diag_now();
        }
        for (const auto & entry : ranges) {
            auto & filler = *expert_fillers.at(entry.first);
            ExpertFiller::Counters a {};
            if (diag) { a = filler.counters(); }
            filler.fill(entry.second, expert_fill_decode);
            if (diag) {
                const auto b = filler.counters();
                expert_diag_token.bytes_read += b.bytes_read - a.bytes_read;
                expert_diag_token.thread_majflt += b.thread_majflt - a.thread_majflt;
                expert_diag_token.thread_minflt += b.thread_minflt - a.thread_minflt;
                expert_diag_token.populate_calls += b.populate_calls - a.populate_calls;
                expert_diag_token.populate_ns += b.populate_ns - a.populate_ns;
                expert_diag_token.populate_errors += b.populate_errors - a.populate_errors;
                expert_diag_token.post_nonresident += filler.nonresident(entry.second);
                ++expert_diag_token.post_checks;
            }
        }
        if (diag) {
            getrusage(RUSAGE_SELF, &after); getrusage(RUSAGE_THREAD, &thread_after);
            expert_diag_token.fill_ns += expert_diag_now() - start;
            expert_diag_token.majflt_fill += after.ru_majflt - before.ru_majflt;
            expert_diag_token.minflt_fill += after.ru_minflt - before.ru_minflt;
            expert_diag_token.thread_majflt += thread_after.ru_majflt - thread_before.ru_majflt;
            expert_diag_token.thread_minflt += thread_after.ru_minflt - thread_before.ru_minflt;
            expert_diag_layers[il] = ranges; expert_diag_previous = ranges;
            getrusage(RUSAGE_SELF, &after);
            expert_diag_gap_maj = after.ru_majflt; expert_diag_gap_min = after.ru_minflt;
            expert_diag_gap_ns = expert_diag_now(); expert_diag_gap = true;
        }
    } catch (const std::exception & e) {
        expert_fill_failed = true;
        LLAMA_LOG_INFO("expert_fill: inactive (%s)\n", e.what());
    }
}
#endif

void llama_context::expert_prefetch_advise(size_t il, int32_t id) {
#ifdef __linux__
    auto & state = expert_prefetch_layers[il];
    for (auto it = state.recent.begin(); it != state.recent.end();) {
        if (state.tokens - it->second >= 32) {
            it = state.recent.erase(it);
        } else {
            if (it->first == id) {
                const auto hit = *it;
                state.recent.erase(it);
                state.recent.push_back(hit);
                return;
            }
            ++it;
        }
    }
    const auto & layer = model.layers[il];
    bool advised = false;
    bool failed = false;
    for (const ggml_tensor * w : { layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps }) {
        if (!w) {
            continue;
        }
        if (id < 0 || id >= w->ne[2] || w->ne[3] != 1 || !ggml_is_contiguous(w) ||
                w->nb[2] == 0 || !model.tensor_is_mapped(w)) {
            if (!expert_prefetch_warned) {
                LLAMA_LOG_INFO("expert_prefetch: skipping non-mmap or non-expert-contiguous tensors/invalid ids (once)\n");
                expert_prefetch_warned = true;
            }
            continue;
        }
        static const uintptr_t page = (uintptr_t) sysconf(_SC_PAGESIZE);
        const uintptr_t start = reinterpret_cast<uintptr_t>(w->data) + size_t(id) * w->nb[2];
        if (page == 0 || page == UINTPTR_MAX || start > UINTPTR_MAX - w->nb[2] ||
                start + w->nb[2] > UINTPTR_MAX - (page - 1)) {
            continue;
        }
        const uintptr_t first = start - start % page;
        const uintptr_t end = start + w->nb[2];
        const uintptr_t last = end + (page - end % page) % page;
        ++expert_prefetch_calls;
        expert_prefetch_bytes += last - first;
        if (madvise(reinterpret_cast<void *>(first), last - first, MADV_WILLNEED) != 0) {
            ++expert_prefetch_failures;
            failed = true;
        } else {
            advised = true;
        }
    }
    if (advised && !failed) {
        if (state.recent.size() == 32) {
            state.recent.erase(state.recent.begin());
        }
        state.recent.emplace_back(id, state.tokens);
    }
#else
    (void) il;
    (void) id;
#endif
}

void llama_context::expert_prefetch_cb(ggml_tensor * t, bool ask, bool * observe, void * data) {
    auto & ctx = *static_cast<llama_context *>(data);
#ifdef __linux__
    if (ctx.expert_fill_failed) { return; }
#endif
    if (t->op != GGML_OP_MUL_MAT_ID || !t->src[0] || !t->src[2]) {
        return;
    }
    size_t il = 0;
    for (; il < ctx.model.layers.size(); ++il) {
        const auto & layer = ctx.model.layers[il];
        if (t->src[0] == layer.ffn_up_exps || t->src[0] == layer.ffn_gate_exps ||
                t->src[0] == layer.ffn_down_exps || t->src[0] == layer.ffn_gate_up_exps) {
            break;
        }
    }
#ifdef __linux__
    if (il < ctx.model.layers.size() && ctx.expert_diag_enabled && ctx.expert_diag_token_active &&
            ctx.expert_prefetch_layers[il].observed) {
        *observe = true;
        if (!ask) { ctx.expert_diag_pre_use(il); }
        return;
    }
#endif
    if (il == ctx.model.layers.size() || ctx.expert_prefetch_layers[il].observed) {
        return;
    }
    *observe = true;
    if (ask) {
        return;
    }
    auto & state = ctx.expert_prefetch_layers[il];
    state.observed = true;
    const ggml_tensor * ids = t->src[2];
    const ggml_tensor * base = ids->view_src ? ids->view_src : ids;
    if (ids->type != GGML_TYPE_I32 || ids->ne[2] != 1 || ids->ne[3] != 1 ||
            !ids->data || !base->buffer || !ggml_backend_buffer_is_host(base->buffer) ||
            !strstr(ids->name, "ffn_moe_topk-")) {
        if (!ctx.expert_prefetch_warned) {
#ifdef __linux__
            if (ctx.expert_fill_enabled) {
                ctx.expert_fill_failed = true;
                LLAMA_LOG_INFO("expert_fill: inactive (unsupported host router ids)\n");
            } else
#endif
            LLAMA_LOG_INFO("expert_prefetch: skipping unsupported router ids (once)\n");
            ctx.expert_prefetch_warned = true;
        }
        return;
    }
    std::vector<int32_t> selected;
    for (int64_t token = 0; token < ids->ne[1]; ++token) {
        for (int64_t k = 0; k < ids->ne[0]; ++k) {
            int32_t id;
            memcpy(&id, static_cast<const char *>(ids->data) + token * ids->nb[1] + k * ids->nb[0], sizeof(id));
            if (id >= 0 && id < t->src[0]->ne[2] &&
                    std::find(selected.begin(), selected.end(), id) == selected.end()) {
                selected.push_back(id);
            }
        }
    }
#ifdef __linux__
    if (ctx.expert_fill_enabled) {
        ctx.expert_fill_selected(il, selected);
        if (ctx.expert_diag_enabled) { ctx.expert_diag_pre_use(il); }
        return;
    }
#endif
    state.tokens += ids->ne[1];
    for (int32_t id : state.predicted) {
        ++ctx.expert_prefetch_total;
        ctx.expert_prefetch_hits += std::find(selected.begin(), selected.end(), id) != selected.end();
    }
    state.predicted.clear();
    for (int32_t id : selected) {
        ctx.expert_prefetch_advise(il, id);
    }
    if (ctx.expert_prefetch_next && il + 1 < ctx.model.layers.size()) {
        auto & next = ctx.expert_prefetch_layers[il + 1];
        const ggml_tensor * w = ctx.model.layers[il + 1].ffn_down_exps;
        if (w && !next.observed) {
            for (int32_t id : selected) {
                if (id < w->ne[2]) {
                    next.predicted.push_back(id);
                    ctx.expert_prefetch_advise(il + 1, id);
                }
            }
        }
    }
}

