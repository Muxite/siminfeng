def plan(spec):
    out = Path(spec['outdir_base']).expanduser() / spec['id']
    if not out.is_absolute():
        out = ROOT / out
    runs = []
    for index, arm in enumerate(planned_order(spec), 1):
        config = spec['arms'][arm]
        directory = out / f'{index:03d}-{arm}'
        env_flags = ' '.join(f'-e {k}={v}' for k, v in config.get('env', {}).items())
        override = os.environ.get('ABRUN_RUNNER')
        runner = shlex.split(override) if override else [str(ROOT / 'cc/om_run/om_run.sh')]
        command = runner + [str(directory), config['image'], env_flags, spec['tool']] + spec['argv']
        if not override:
            command = [str(ROOT / 'bin/run_op'), '--agent', 'abrun', '--task', spec['id'], '--'] + command
        runs.append({'index': index, 'arm': arm, 'dir': str(directory), 'command': command})
    return out, runs


def switch_patterns(spec):
    """All signatures are observed on every run to detect cross-arm leaks."""
    return list(dict.fromkeys([*spec.get('switch_regex', []),
                              *(p for arm in spec['arms'].values()
                                for p in arm.get('switch_regex', []))]))


def switch_errors(spec, arm, summary):
    config = spec['arms'][arm]
    matches = summary.get('switch_matches', {})
    if not config.get('expect_switch', False):
        if any(matches.get(p, 0) for p in switch_patterns(spec)) or summary.get('switch_lines'):
            return [f'{arm}: switch leaked (switch_lines present)']
        return []
    errors = [f'{arm}: switch inert (no matches for {p!r})'
              for p in config.get('switch_regex', []) if not matches.get(p, 0)]
    legacy = spec.get('switch_regex', [])
    if legacy and not any(matches.get(p, 0) for p in legacy):
        errors.append(f'{arm}: switch inert (no switch_lines matching spec switch_regex)')
    return errors


def write_report(out, spec, runs, verdict):
    (out / 'verdict.json').write_text(json.dumps(verdict, indent=2) + '\n')
    lines = [f"# {spec['id']}", '', f"Status: {verdict['status']}", '',
             '| # | Arm | Status | Metric | Wall s | Output SHA | Switch matches |',
             '|---|---|---|---:|---:|---|---|']
    metric = spec.get('metric', 'eval_tps')
    for row in runs:
        s = row['summary']
        matches = json.dumps(s.get('switch_matches', {})).replace('|', '&#124;')
        lines.append(f"| {row['index']} | {row['arm']} | {s['status']} | {s.get(metric)} | {s['wall_s']} | {s['output_sha']} | {matches} |")
    lines += ['', f'Metric: {metric} (higher is better)', '', '| Arm | Mean | B/A | Gate |',
              '|---|---:|---:|---|']
    for arm, mean in verdict['means'].items():
        comparison = verdict['comparisons'].get(arm, {})
        lines.append(f"| {arm} | {mean} | {comparison.get('ratio', '—')} | {comparison.get('verdict', 'base')} |")
    lines += ['', '## Secondary metrics (descriptive; no verdict)', '',
              '| Arm | NVMe GiB/token | Prompt t/s | Eval t/s |',
              '|---|---:|---:|---:|']
    for arm, metrics in verdict['secondary_metrics'].items():
        lines.append('| ' + ' | '.join(str(v) for v in [arm, *metrics.values()]) + ' |')
    lines += ['', f"A/A gap: {verdict['aa_gap']}; drift: {verdict['drift']}; threshold: {verdict['threshold']}",
              '', f"Output class: {verdict['output']['class']}", '',
              'Output details: `' + json.dumps(verdict['output']) + '`', '',
              *verdict.get('invalid_reasons', []), *verdict.get('reasons', [])]
    (out / 'REPORT.md').write_text('\n'.join(lines) + '\n')


def execute(spec, out, runs):
    # Exclusive creation refuses accidental overwrite/replay into prior results.
    out.mkdir(parents=True, exist_ok=False)
    (out / 'spec.json').write_text(json.dumps(spec, indent=2) + '\n')
    grouped = {arm: [] for arm in spec['arms']}
    completed, invalid = [], []
    try:
        checked = set()
        for arm in spec['arms'].values():
            key = (arm['image'], spec['tool'])
            if key not in checked:
                preflight.check(*key, spec['argv'])
                checked.add(key)
        for run in runs:
            rc = subprocess.run(run['command'], cwd=ROOT).returncode
            summary = run_summary.summarize(run['dir'], switch_patterns(spec))
            run['summary'] = summary
            completed.append(run)
            grouped[run['arm']].append(summary)
            config = spec['arms'][run['arm']]
            invalid.extend(switch_errors(spec, run['arm'], summary))
            if rc != 0 or summary['status'] != 'ok':
                invalid.append(f"{run['arm']}: runner rc={rc}, status={summary['status']}")
            if invalid:
                break
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        invalid.append(str(exc))
    verdict = gate.evaluate(grouped, spec.get('metric', 'eval_tps'))
    if verdict['reasons']:
        invalid.extend(verdict['reasons'])
    verdict.update(status='INVALID' if invalid else 'completed', invalid_reasons=invalid,
                   planned_order=[r['arm'] for r in runs],
                   executed_order=[r['arm'] for r in completed])
    if invalid:
        for comparison in verdict['comparisons'].values():
            comparison['verdict'] = 'null'
    write_report(out, spec, completed, verdict)
    print(json.dumps(verdict, indent=2))
    return 1 if invalid else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('spec')
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--submit', action='store_true')
    args = parser.parse_args()
    try:
        path = Path(args.spec).resolve()
        spec = json.loads(path.read_text())
        validate(spec)
        out, runs = plan(spec)
        if args.dry_run:
            print('Order: ' + ', '.join(r['arm'] for r in runs))
            for run in runs:
                print(f"Run {run['index']}: {run['arm']}  {shlex.join(run['command'])}")
            return 0
        if args.submit:
            queue = ROOT / 'bin/jobq'
            if not queue.exists():
                raise ValueError('--submit requires bin/jobq')
            return subprocess.run([str(queue), 'submit', '--class', 'gpu', '--name', spec['id'],
                                   '--', sys.executable, str(Path(__file__).resolve()), str(path)],
                                  cwd=ROOT).returncode
        return execute(spec, out, runs)
    except (OSError, ValueError, TypeError, re.error) as exc:
        parser.exit(1, f'abrun: {exc}\n')


if __name__ == '__main__':
    sys.exit(main())
# abrun

Python 3 standard-library tools for guarded, counterbalanced experiments.
Run from the repository root; no package installation is needed.
```sh
python3 cc/abrun/abrun.py cc/abrun/specs/example-om7-replay.json --dry-run
OM_MAX_S=2400 python3 cc/abrun/abrun.py cc/abrun/specs/example-om7-replay.json
python3 cc/abrun/run_summary.py RUN_DIR --json --no-write
python3 cc/abrun/gate.py labelled-summaries.json --metric eval_tps
python3 cc/abrun/preflight.py IMAGE llama-bench -- -n 32 -o json
python3 -m pytest -q cc/abrun
```

## Spec schema

A spec is a JSON object with these fields:

| Field | Meaning |
|---|---|
| `id` | Required safe experiment name; no path separators |
| `outdir_base` | Required parent path; relative paths resolve from repo root |
| `runner` | Required; currently only `"om_run"` |
| `tool` | Required binary name inside `/app/` |
| `argv` | Required array of literal string arguments |
| `switch_regex` | Array of Python regexes matching stderr activation lines; default `[]` |
| `metric` | Numeric summary field to compare; default `"eval_tps"` |
| `arms` | Required object: arm name -> `{image, env, expect_switch}` |
| `order` | Required `"ABBA"`, `"ABCCBA"`, `"mirrored"`, or `"explicit"` |
| `explicit_order` | Array of known arm names, required for `"explicit"` |
| `rounds` | Positive integer repeating the entire order; default 1 |

`base` is mandatory and is A; remaining arms follow JSON insertion order.
Mirrored order visits every arm then reverses, including both end arms.
Explicit order must include all arms. Images are required; `env` defaults to
`{}` and maps env names to string values. Values cannot contain whitespace
because om_run splits its environment-flags argument. `expect_switch` defaults
to false; true requires regexes. Base must not expect a switch.
The OM7 example uses the original image, argv, env switches, and ABCCBA design.

## Execution and artifacts

Output is `outdir_base/id/`; an existing destination is refused. `--dry-run`
prints the order and shell-quoted commands without preflight or output writes.
Preflight runs once per image/tool before any measurement. Help is cached in
`lab/preflight/<sha256(image + NUL + tool)>.txt`. The real command uses
`$DOCKER_CMD_PREFIX` (e.g. `sg docker -c`) and Docker's NVIDIA runtime.
Unsupported flags fail before any run. Negative numbers are treated as values;
`--flag=value` is checked as `--flag`. Use separate short flags, not clusters.

Runs execute serially through `bin/run_op --agent abrun --task ID` and om_run.
Each numbered run directory gets `summary.json`; the experiment gets the
saved spec, `verdict.json`, and `REPORT.md`. Missing activation, activation in
base, failed runs, missing gate metrics, or preflight failure produce INVALID
and a nonzero exit. Activation failures stop immediately. Existing watchdog
settings are inherited. `--submit` queues the whole spec as one `gpu` job via
`bin/jobq`; a queue worker must execute it. Use the queue to exclude builds.

## Metrics and gate

CLI perf lines use their last occurrence. Benchmark JSON preserves pp/tg
`avg_ts`, `samples_ts`, and `steady` (mean excluding sample 1); `prompt_tps` and
`eval_tps` use avg_ts. Select `tg_steady` to gate steady benchmark throughput.
Telemetry read units are normalized to KiB (missing unit defaults to KiB).
Read/IO counters use max-minus-min. Memory and swap are MiB; GPU frequency is
MHz. Missing metrics are null with entries in `reasons`. `--no-write` prevents
summary writes; otherwise summaries are saved. Repeat `--switch-regex` as needed.

The gate accepts `{arm: [summary_object_or_path, ...]}` in execution order.
All metrics are higher-is-better. B/A uses per-arm arithmetic means. A/A gap
is the largest arm range/mean. Drift is the absolute difference of base-half
means divided by the whole base mean (odd middle run goes to second half).
Unmeasured gaps contribute zero; their per-arm fields and drift remain null.
Threshold is max(0.03, 2*A/A gap, 2*drift); strict excess gives improved/regressed.
Hashes classify outputs as identical/differs (with run indices), or unknown
when absent. This is byte equality, not a numerical-quality claim.

Tests can replace execution with `ABRUN_RUNNER` (receives om_run arguments,
bypasses run_op), and help with `ABRUN_PREFLIGHT_RUNNER` (IMAGE TOOL --help).
`ABRUN_PREFLIGHT_CACHE_DIR` relocates the cache. Python callers can inject
`preflight.check(..., runner=callable)` returning help text without Docker.

