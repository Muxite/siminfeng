\nst_prose_n24#9.stdout\nst_prose_n6#6.stderr\nst_prose_n6#6.stdout\nstate.jsonl\n179:def collect_inputs(spec):\n180:    inputs = dict(model_files={}, mounts={}, data_files={}, tests={})\n184:        inputs[\"tests\"][t] = test_definition_sha(td)\n188:        if name not in inputs[\"model_files\"]:\n189:            inputs[\"model_files\"][name] = sha(os.path.join(os.path.dirname(spec[\"model\"]), name))\n196:            inputs[\"mounts\"].setdefault(host, {})\n209:                    inputs[\"mounts\"][host][rel] = sha(path)\n212:        inputs[\"data_files\"][os.path.abspath(spec[\"data\"])] = sha(spec[\"data\"])\n213:    return inputs\n215:def verify_inputs(spec):\n223:    if \"inputs\" not in spec: return None  # Legacy attempts verify only spec.model.\n224:    inputs = spec[\"inputs\"]\n225:    for t, expected in inputs[\"tests\"].items():\n228:    for name, expected in inputs[\"model_files\"].items():\n231:    for host, manifest in inputs[\"mounts\"].items():\n235:    for path, expected in inputs[\"data_files\"].items():\n239:def cmd_submit(a):\n252:        if \"inputs\" not in old:\n254:            print(f\"duplicate submission: existing {jid} (legacy inputs unverified)\"); return\n256:        spec[\"inputs\"] = collect_inputs(spec)\n272:def cmd_run(a):\n287:    S(\"preparing\", **({\"inputs_unverified\": True} if \"inputs\" not in spec else {}))\n288:    error = verify_inputs(spec)\n290:        S(\"terminal\", execution=\"not_started\", reason=error, **({\"inputs_unverified\": True} if \"inputs\" not in spec else {})); sys.exit(4)\n337:    json.dump(result, open(os.path.join(adir,\"result.json\"),\"w\"), indent=1)\n339:    S(\"terminal\", result_sha256=sha(os.path.join(adir,\"result.json\"))); print(jd(result)[:700])\n347:    json.dump(manifest, open(os.path.join(stage, \"MANIFEST.json\"), \"w\"), indent=1)\n373:        if os.path.exists(os.path.join(adir, \"result.json\")):   # result was already produced: NEVER overwrite; just finish durable export\n374:            print(job, att, \"result.json already exists -> resuming export only (no rescoring, no overwrite)\")\n376:            S(\"terminal\", execution=\"completed_before_runner_death\", result_sha256=sha(os.path.join(adir, \"result.json\")), killed=owned); continue\n380:        json.dump(res, open(os.path.join(adir, \"result.json\"), \"w\"), indent=1); S(\"exporting\")\n382:        S(\"terminal\", execution=\"interrupted\", result_sha256=sha(os.path.join(adir, \"result.json\")), killed=owned)\n385:    adir = os.path.join(LAB, \"jobs\", a.job, a.att); res = json.load(open(os.path.join(adir, \"result.json\"))); ow = json.load(open(os.path.join(adir, \"owner.json\")))\n387:    key = (a.job, a.att); rsha = sha(os.path.join(adir, \"result.json\")); rows = [json.loads(l) for l in open(idx)] if os.path.exists(idx) else []\n393:    if not os.path.exists(os.path.join(LAB, \"export\", a.job, a.att, \"MANIFEST.json\")): print(\"REJECT: no confirmed durable export\"); sys.exit(7)\n","exit_code":0,"status":"completed"}}
