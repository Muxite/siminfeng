    scoped = store.scoped('a', readable=frozenset({'b'}))
    assert scoped.get_task('b')['objective'] == 'compare'
    assert scoped.read('b', 'blob')['sha256'] == blob['sha256']
    assert scoped.artifact_bytes('b', 'blob') == b'hello'
    assert scoped.query('b')['items']
