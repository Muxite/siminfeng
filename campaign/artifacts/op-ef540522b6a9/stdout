0\t// arena, and answers `(layer, expert) -> slot or -1`. It computes nothing itself: the GPU computes the experts it\n    21\t// holds in the verify window's grouped kernels and the prompt path (the hit/miss split), and the CPU pool the rest.\n    22\t// (Written when nothing consumed the slots yet and `--expert-cache` defaulted to 0; setup's configs use `auto`.)\n    23\t#pragma once\n    24\t\n    25\t#include <cstddef>\n    26\t#include <cstdint>\n    27\t#include <memory>\n    28\t#include <string>\n    29\t#include <vector>\n    30\t\n    31\t#include \"strata/core/vmm.hpp\"\n    32\t\n    33\tnamespace strata::core {\n    34\t\n    35\t/// Where one expert's VRAM lives, or -1.  `int32_t` and not a bool because the slot index is what the kernel\n    36\t/// needs, and a table that has to be re-derived from a bitmask is a table that will be re-derived differently\n    37\t/// in the two places that use it.\n    38\tinline constexpr int32_t kNotResident = -1;\n    39\t\n    40\t/// **THE STATIC RESIDENCY PLAN, READ BACK FROM THE FILE `tools/make_profile.py` WROTE.**\n    41\t///\n    42\t/// `profile.bin` is `STRP`, then `version, n_layers, n_expert, slots, n_ranked`, then `n_ranked` `(layer,\n    43\t/// expert)` pairs ranked by descending routing frequency, then a `n_layers x n_expert` frequency table.\n    44\t///\n    45\t/// **WHY A PROFILE AND NOT THE COMPULSORY-MISS POLICY THIS ENGINE ALREADY HAD.**  Compulsory-miss fills with\n    46\t/// the first `S` DISTINCT experts the run happens to route, which on this workload is whatever the prompt\n    47\t/// touched first - it measured `h = 0.4864`.  A profile ranked by frequency over a whole trace is what the\n    48\t/// plan's `0.6447` refers to, and the CPU's half of the drain is linear in `h`, so the gap is worth about\n    49\t/// 4 ms of drain.  The point of reading it from a file is that a profile built on ONE prompt can be scored on\n    50\t/// ANOTHER, which is the only way to know whether it transfers.\n    51\t///\n    52\t/// The frequency table is not returned: it is the profile's own working, and the engine measures `h` by\n    53\t/// running rather than by re-deriving what the file claims.\n    54\tbool read_expert_profile(const std::string& path, int64_t n_layers, int64_t n_expert,\n    55\t                         std::vector<std::pair<int32_t, int32_t>>& ranked, int64_t& slots, std::string& err);\n    56\t\n    57\t/// #477 (--expert-profile-save): what the adaptive tier learned, as a profile ranking EVERY (layer, expert) pair -\n    58\t/// the experts resident in VRAM now first (where the swaps left the cache), then the rest; within each, by `heat`\n    59\t/// (the routing the adaptive tier counted since the start, descending), then by `prior` (the profile the engine\n    60\t/// started from: an expert this run never routed keeps its old place), then by index.  A start from it begins\n    61\t/// where this one ended; one with more slots adds the hottest of the rest, one with fewer keeps the hottest.\n    62\t/// `resident` and `heat`: n_layers x n_expert entries (`heat` may be empty: no counts, the prior decides).\n    63\tstd::vector<std::pair<int32_t, int32_t>> rank_learned_profile(int64_t n_layers, int64_t n_expert,\n    64\t                                                              const std::vector<uint8_t>& resident,\n    65\t                                                              const std::vector<double>& heat,\n    66\t                                                              const std::vector<std::pair<int32_t, int32_t>>& prior);\n    67\t\n    68\t/// #477: writes `ranked` in tools/make_profile.py's format, byte for byte: `STRP`, `1, n_layers, n_expert,\n    69\t/// n_ranked, n_ranked` (uint32), the pairs (uint16 layer, uint16 expert), then the n_layers x n_expert int32 table\n    70\t/// of each pair's rank (-1: not ranked).  Atomically: a `<path>.tmp` beside it, renamed over `path` once complete,\n    71\t/// so a reader (the next start) never sees half a file.  False with `err` when it could not be written.\n    72\tbool write_expert_profile(const std::string& path, int64_t n_layers, int64_t n_expert,\n    73\t                          const std::vector<std::pair<int32_t, int32_t>>& ranked, std::string& err);\n  4787\t        if (b == nullptr) {\n  4788\t            // The one failure the loop cannot see.  Leaving `out` at its previous contents would feed the NEXT\n  4789\t            // layer a stale expert vector, which `moe_combine` would weight and add - the token would still be\n  4790\t            // finite and would still be wrong, 48 layers deep.\n  4791\t            d.failed = true;\n  4792\t            d.fail = \"the expert source could not produce a blob\";\n  4793\t            d.fail_layer = d.layers;\n  4794\t            d.fail_expert = e;\n  4795\t            ++d.missing;\n  4796\t            return;\n  4797\t        }\n  4798\t        // A hit's row was zeroed by `Launch` and belongs to the GPU; the pool must not touch it.\n  4799\t        if (use_hits && (graph_hits ? d.host_res[(size_t) d.layers * (size_t) d.n_expert + (size_t) e] >= 0\n  4800\t                                    : d.is_hit[(size_t) i] != 0)) {\n  4801\t            if (graph_hits) ++d.cache_hits;\n  4802\t            // The GPU owns this row and `hit_out` is zeroed, so the CPU's contribution is zero - but\n  4803\t            // `y_miss` is a REUSED pinned buffer, so the row must be written, not merely skipped.\n  4804\t            std::memset(out + (size_t) i * (size_t) n_embd, 0, (size_t) n_embd * sizeof(float));\n  4805\t            continue;\n  4806\t        }\n  4807\t        if (graph_hits) ++d.cache_refused;   // token graph: a miss (nothing is admitted during a token)\n  4808\t\n  4809\t        bool remote_owns = false;\n  4810\t        for (int r = 0; r < d.remote_count; ++r) remote_owns |= d.remote[r]->owns(i);\n  4811\t        if (remote_owns) {\n  4812\t            std::memset(out + (size_t) i * (size_t) n_embd, 0, (size_t) n_embd * sizeof(float));\n  4813\t            continue;\n  4814\t        }\n  4815\t\n  4816\t        // `njobs` indexes the JOB ARRAY and `i` indexes the OUTPUT - they are the same only when nothing is a\n  4817\t        // hit, and using one for the other is how a hit's row would get two experts summed into it.\n  4818\t        ExpertJob& j = d.jobs[(size_t) njobs++];\n  4819\t        j.blob = b;\n  4820\t        j.act = &d.act;             // SHARED across the batch: one conversion serves all ten experts\n  4821\t        j.out = out + (size_t) i * (size_t) n_embd;\n  4822\t        j.weight = 1.0f;            // clause 2: a diagnostic field, NOT the router weight\n  4823\t        j.slot = (int) i;\n  4824\t    }\n  4825\t\n  4826\t    // Plan v0.3 P4: rows of every expert across all threads (bitwise the same as `run`).\n  4827\t    if (d.split_rows) d.pool->run_split(d.jobs.data(), (int) njobs);\n  4828\t    else d.pool->run(d.jobs.data(), (int) njobs);\n  4829\t    if (d.remote_count > 0) {\n  4830\t        static thread_local std::string remote_error;\n  4831\t        for (int r = 0; r < d.remote_count; ++r)\n  4832\t            if (!d.remote[r]->finish(out, remote_error)) {\n  4833\t                d.failed = true; d.fail = remote_error.c_str(); d.fail_layer = d.layers; return;\n  4834\t            }\n  4835\t    }\n  4836\t    ++d.layers;\n  4837\t    d.experts += k;\n  4838\t}\n  4839\t\n  4840\tnamespace {\n","exit_code":0,"status":"completed"}}
