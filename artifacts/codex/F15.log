def wire_get(home, path):
    """Exercise the actual HTTP handler without sockets in restricted sandboxes."""
    import io
    from types import SimpleNamespace
    from jiuwenswarm.factory.monitor import make_handler
    class Connection:
        def __init__(self):
            self.response = bytearray()
        def makefile(self, *args):
            return io.BytesIO(('GET ' + path + ' HTTP/1.0\r\nHost: localhost\r\n\r\n').encode())
        def sendall(self, data):
            self.response.extend(data)
    connection = Connection()
    make_handler(home)(connection, ('127.0.0.1', 1), SimpleNamespace())
    headers, body = bytes(connection.response).split(b'\r\n\r\n', 1)
    assert b'200 OK' in headers, bytes(connection.response)
    return body


def test_http_handler_without_network(store):
    from jiuwenswarm.factory.story import build_events, load_source
    a = store.create_attempt('t', dict(kind='build', request={}, idem_key='k', fingerprint='f'))
    assert b'<h2>Engine</h2>' in wire_get(store.home, '/')
    assert json.loads(wire_get(store.home, '/api/tasks'))[0]['task_id'] == 't'
    story = json.loads(wire_get(store.home, '/api/story?task=t'))
    assert story['events'] == build_events(load_source('t', store.home))
    assert isinstance(json.loads(wire_get(store.home, '/api/telemetry?task=t')), list)
    assert json.loads(wire_get(store.home, '/api/job?attempt=' + a['attempt_id']))['state'] == 'queued'
import json
import os
from pathlib import Path
import subprocess
import sys

import pytest

from jiuwenswarm.factory.store import Store


@pytest.fixture
def home(tmp_path):
    home = tmp_path / 'store'
    with Store(home) as store:
        store.create_task({'task_id': 'a', 'objective': 'measure'})
        store.create_task({'task_id': 'b', 'objective': 'compare'})
    return home


def invoke(home, capability, inputs, *, extra_env=None, output_dir=None):
    env = dict(os.environ, FACTORY_HOME=str(home), FACTORY_TASK_ID='a', FACTORY_READ_TASKS='', FACTORY_WORKSPACE='')
    env.update(extra_env or {})
    packet = dict(call='call', attempt=1, capability=capability, inputs=inputs,
                  output_dir=str(output_dir or home.parent / 'out'), resources={})
    result = subprocess.run([sys.executable, '-m', 'jiuwenswarm.factory.api', capability],
                            input=json.dumps(packet), text=True, capture_output=True, env=env, timeout=20)
    assert result.returncode == 0, result.stderr
    assert not result.stderr
    # json.loads also verifies that stdout is exactly one process result.
    return json.loads(result.stdout)


def test_api_query_bounded(home):
    with Store(home) as store:
        for i in range(60):
            store.append_observation('a', {'kind': 'measurement', 'values': {'index': i, 'log': 'x' * 1000}})
    assert invoke(home, 'evidence.query', {'limit': 51})['error']['code'] == 'INVALID_INPUT'
    result = invoke(home, 'evidence.query', {})
    assert result['outcome'] == 'ok'
    assert len(result['outputs']['items']) == 50
    assert all(len(item['summary']) <= 300 for item in result['outputs']['items'])
    assert all(set(item) == {'id', 'type', 'kind', 'summary', 'created'} for item in result['outputs']['items'])
    following = invoke(home, 'evidence.query', {'since': result['outputs']['cursor']})
    assert len(following['outputs']['items']) == 11


def test_api_publish_decision_cas(home):
    first = invoke(home, 'evidence.publish', {'type': 'decision', 'expected_rev': 0, 'record': {'hypothesis': 'measure first'}})
    assert first['outputs']['rev'] == 1
    stale = invoke(home, 'evidence.publish', {'type': 'decision', 'expected_rev': 0, 'record': {'hypothesis': 'stale'}})
    assert stale['error']['code'] == 'STALE_REVISION'
    second = invoke(home, 'evidence.publish', {'type': 'decision', 'record': {'expected_rev': 1, 'reason_for_change': 'timing'}})
    assert second['outputs']['rev'] == 2
    assert second['outputs']['parent_rev'] == 1
    assert invoke(home, 'evidence.publish', {'type': 'decision', 'record': {}})['error']['code'] == 'INVALID_INPUT'


def test_api_observation_and_artifact_roundtrip(home):
    artifact = invoke(home, 'evidence.publish', {'type': 'artifact', 'record': {'artifact_id': 'blob', 'text': 'z' * 70000}})
    assert artifact['outcome'] == 'ok'
    read = invoke(home, 'evidence.read', {'id': 'blob'})['outputs']
    assert len(read['text_preview'].encode()) <= 65536
    assert read['preview_truncated'] is True
    assert read['sha256'] == artifact['outputs']['sha256']
    assert not Path(read['location']).is_absolute()
    assert str(home) not in json.dumps(read)
    obs = invoke(home, 'evidence.publish', {'type': 'observation', 'record': {'obs_id': 'timing', 'source_artifacts': ['blob'], 'kind': 'timing', 'values': {'seconds': 2}}})
    assert invoke(home, 'evidence.read', {'id': 'timing'})['outputs'] == obs['outputs']
    assert invoke(home, 'evidence.publish', {'type': 'artifact', 'record': {'artifact_id': 'blob', 'text': 'different'}})['error']['code'] == 'ARTIFACT_CONFLICT'
    assert invoke(home, 'evidence.read', {'id': 'missing'})['error']['code'] == 'NOT_FOUND'


def test_api_path_containment(home, tmp_path):
    out = tmp_path / 'out'
    workspace = tmp_path / 'workspace'
    out.mkdir()
    workspace.mkdir()
    (out / 'result').write_text('result')
    (workspace / 'source').write_text('source')
    outside = tmp_path / 'outside'
    outside.write_text('private')
    (out / 'link').symlink_to(outside)
    for path in ('result', str(workspace / 'source')):
        response = invoke(home, 'evidence.publish', {'type': 'artifact', 'record': {'path': path}}, extra_env={'FACTORY_WORKSPACE': str(workspace)}, output_dir=out)
"""Replay an explicit read-only subset against a disposable store copy."""
import argparse
import json
import os
from pathlib import Path
import shutil
import tempfile
import time
from contextlib import contextmanager
from . import api, telemetry
from .store import Store

@contextmanager
def environment(**values):
    previous = {key: os.environ.get(key) for key in values}
    os.environ.update(values)
    try:
        yield
    finally:
        for key, value in previous.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value


READ_ONLY = {'evidence.query', 'evidence.read', 'builder.status', 'builder.result',
             'lab.status', 'lab.result', 'inspector.inspect'}


def replay(task_id, home=None, *, calls=None, out=None):
    home = telemetry.home_path(home)
    calls = list(calls if calls is not None else
                 (e for e in telemetry.read_events(home, task_id) if e['event'] == 'cc.call' and not e.get('replay') and e['capability'] in READ_ONLY))
    # Validate the complete selection before doing any work. Default selection skips mutations.
    if any(e['capability'] not in READ_ONLY for e in calls):
        raise ValueError('Replay refuses mutating or unknown capabilities')
    if any(e.get('inputs_redacted') for e in calls):
        raise ValueError('Replay refuses redacted inputs')
    with tempfile.TemporaryDirectory(prefix='factory-replay-') as temporary:
        copied = Path(temporary) / 'home'
        copied.mkdir()
        # Credentials and agent profiles are never needed by offline replay.
        paths = [home / 'factory.sqlite', home / 'factory.sqlite-wal']
        def stamps():
            return [(p.stat().st_size, p.stat().st_mtime_ns) if p.exists() else None for p in paths]
        for _ in range(5):
            before = stamps()
            for source in paths:
                target = copied / source.name
                target.unlink(missing_ok=True)
                if source.is_file():
                    shutil.copyfile(source, target)
            if before == stamps():
                break
        else:
            raise ValueError('Factory store changed during copy; retry replay')
        if (home / 'artifacts').is_dir():
            shutil.copytree(home / 'artifacts', copied / 'artifacts')
        results = []
        with Store(copied) as store, environment(FACTORY_HOME=str(copied), GIT_OPTIONAL_LOCKS='0'):
            task = store.get_task(task_id)
            reads = task.get('constraints', {})
            reads = reads.get('read_tasks', []) if isinstance(reads, dict) else []
            for e in calls:
                capability = e['capability']
                packet = dict(inputs=e['inputs'], capability=capability, resources=dict(e.get('resources', {})))
                started = time.perf_counter()
                try:
                    if capability == 'inspector.inspect':
                        from .inspector import dispatch as inspect_dispatch
                        # Probe only copied workspaces; Git cannot refresh the source index.
                        for handle, resource in list(packet['resources'].items()):
                            if resource.get('kind') == 'workspace':
                                source = Path(resource['path']).resolve()
                                destination = copied / 'replay-workspaces' / str(len(list(copied.glob('replay-workspaces/*'))))
                                destination.parent.mkdir(exist_ok=True)
                                shutil.copytree(source, destination, symlinks=True)
                                packet['resources'][handle] = dict(resource, path=str(destination))
                        result = inspect_dispatch(store.scoped(task_id), task_id, capability, packet)

