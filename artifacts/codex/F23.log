    @staticmethod
    def _verify_blob(path, sha256, size, preview_limit=0):
        digest = hashlib.sha256()
        preview = bytearray()
        length = 0
        try:
            with path.open('rb') as source:
                for block in iter(lambda: source.read(1024 * 1024), b''):
                    digest.update(block)
                    length += len(block)
                    preview.extend(block[:max(0, preview_limit - len(preview))])
        except OSError as exc:
            raise PersistenceFailed('Artifact bytes unavailable') from exc
        if digest.hexdigest() != sha256 or length != size:
            raise PersistenceFailed('Artifact integrity check failed')
        return bytes(preview)

    def read_artifact(self, task_id, artifact_id):
        record = self._get('artifacts', task_id, artifact_id)
        self._verify_blob(self.home / record['location'], record['sha256'], record['size'])
        return record

    def artifact_bytes(self, task_id, artifact_id):
        record = self._get('artifacts', task_id, artifact_id)
        return self._verify_blob(self.home / record['location'], record['sha256'], record['size'], record['size'])

    def read(self, task_id, record_id):
        """Read a full record; artifacts include a verified, at most 64 KiB preview."""
        for table, (key, _) in TABLES.items():
            row = self._db.execute(f'SELECT * FROM {table} WHERE task_id=? AND {key}=?', (task_id, record_id)).fetchone()
            if row is not None:
                record = self._decode(table, row)
                if table == 'artifacts':
                    preview = self._verify_blob(self.home / record['location'], record['sha256'], record['size'], 65536)
                    # Replacement characters can expand invalid UTF-8. Bound the
                    # encoded preview as well as the source bytes.
                    record['text_preview'] = preview.decode('utf-8', errors='replace').encode('utf-8')[:65536].decode('utf-8', errors='ignore')
                    record['preview_truncated'] = record['size'] > 65536
                return record
        raise NotFound('Record not found')

    def query(self, task_id, *, kinds=None, text=None, since=0, limit=50):
        if type(limit) is not int or not 1 <= limit <= 50:
            raise ValueError('limit must be 1..50')
        if type(since) is not int or since < 0:
            raise ValueError('since must be a nonnegative integer')
        if kinds is not None and (not isinstance(kinds, list) or not all(isinstance(k, str) for k in kinds)):
            raise ValueError('kinds must be a list of strings')
        if text is not None and not isinstance(text, str):
            raise ValueError('text must be a string')
        self.get_task(task_id)
        clauses, params = ['task_id=?', 'cursor>?'], [task_id, since]
        if kinds:
            placeholders = ','.join('?' for _ in kinds)
            clauses.append(f'(kind IN ({placeholders}) OR type IN ({placeholders}))')
            params.extend(kinds + kinds)
        if text:
            clauses.append('instr(lower(record),lower(?))>0')
            params.append(text)
        rows = self._db.execute('SELECT cursor,id,type,kind,summary,created FROM evidence WHERE ' + ' AND '.join(clauses) + ' ORDER BY cursor LIMIT ?', (*params, limit)).fetchall()
        return {'items': [{k: row[k] for k in ('id', 'type', 'kind', 'summary', 'created')} for row in rows], 'cursor': rows[-1]['cursor'] if rows else since}

    def dump(self, task_id):
        self.get_task(task_id)
        result = {}
        for table in TABLES:
            records = [self._decode(table, row) for row in self._db.execute(f'SELECT * FROM {table} WHERE task_id=?', (task_id,))]
            if table == 'artifacts':
                for record in records:
                    self._verify_blob(self.home / record['location'], record['sha256'], record['size'])
            result[table] = records
        return result


class ScopedStore:
    """Read grants never grant writes. Every public operation takes an explicit task id."""
    def __init__(self, store, task_id, readable):
        self._store, self.task_id, self.readable = store, task_id, readable

    def _check(self, task_id, write=False):
        if task_id != self.task_id and (write or task_id not in self.readable):
            raise ScopeDenied('Task is outside the authorized scope')

    def get_task(self, task_id):
        self._check(task_id)
        return self._store.get_task(task_id)

    def query(self, task_id, **filters):
        self._check(task_id)
        return self._store.query(task_id, **filters)

    def read(self, task_id, record_id):
        self._check(task_id)
        return self._store.read(task_id, record_id)

    def dump(self, task_id):
        self._check(task_id)
        return self._store.dump(task_id)

    def read_artifact(self, task_id, artifact_id):
        self._check(task_id)
        return self._store.read_artifact(task_id, artifact_id)

    def artifact_bytes(self, task_id, artifact_id):
        self._check(task_id)
        return self._store.artifact_bytes(task_id, artifact_id)

    def create_task(self, record):
        self._check(record.get('task_id'), write=True)
        return self._store.create_task(record)

    def advance_decision(self, task_id, expected_rev, record):
        self._check(task_id, write=True)
        return self._store.advance_decision(task_id, expected_rev, record, readable=self.readable)

    def _agent_id(self, value):
        if value is None:
            return
        identifier(value)
        prefixes = ['admission', *(r[0] for r in self._store._db.execute('SELECT attempt_id FROM attempts'))]
        if ':' in value or any(value.startswith(prefix) for prefix in prefixes):
            raise ScopeDenied('Evidence id is reserved for the host')

    def put_artifact(self, task_id, artifact_id, data, media_type, producer_attempt):
        self._agent_id(artifact_id)
        self._check(task_id, write=True)
        return self._store.put_artifact(task_id, artifact_id, data, media_type, producer_attempt)

    def append_observation(self, task_id, record):
        self._agent_id(record.get('obs_id'))
        if 'host_run' in record or record.get('kind') in {'build_result', 'lab_result', 'evaluation', 'admission', 'operator_intervention', 'taskgraph_patch'}:
            raise ScopeDenied('Observation fields are reserved for the host')
        self._check(task_id, write=True)
        return self._store.append_observation(task_id, record)

    def create_attempt(self, task_id, record):
        self._check(task_id, write=True)
        return self._store.create_attempt(task_id, record)

    def transition_attempt(self, task_id, attempt_id, state, *, expected_state=None, **changes):
        self._check(task_id, write=True)
        return self._store.transition_attempt(task_id, attempt_id, state, expected_state=expected_state, **changes)

    def add_evaluation(self, task_id, record):
        self._check(task_id, write=True)
        return self._store.add_evaluation(task_id, record)

    def add_upload(self, task_id, record):
        self._check(task_id, write=True)
        return self._store.add_upload(task_id, record)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--home', type=Path, default=Path(os.environ.get('FACTORY_HOME', '~/.jiuwenswarm-factory')).expanduser())
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('init-task').add_argument('file', type=Path)
    sub.add_parser('show').add_argument('task_id')
    sub.add_parser('dump').add_argument('task_id')
    args = parser.parse_args()
    with Store(args.home) as store:
        if args.command == 'init-task':
            result = store.create_task(json.loads(args.file.read_text()))
        elif args.command == 'show':
            result = store.get_task(args.task_id)
        else:
            result = store.dump(args.task_id)
    print(json.dumps(result, indent=2, ensure_ascii=False))


if __name__ == '__main__':
    main()
"""Native CC packet entry point for task-scoped evidence capabilities."""
from __future__ import annotations

import json
import os
from pathlib import Path
import sqlite3
import sys
import time

from .store import FactoryError, NotFound, ScopeDenied, Store


def fields(value, allowed, required=()):
    if not isinstance(value, dict) or set(value) - set(allowed) or set(required) - set(value):
        raise ValueError('Invalid or missing input fields')


def artifact_source(record, packet):
    if ('path' in record) == ('text' in record):
        raise ValueError('Supply exactly one of path or text')
    if 'text' in record:
        if not isinstance(record['text'], str):
            raise ValueError('text must be a string')
        return record['text'].encode('utf-8')
    if not isinstance(record['path'], str) or not record['path']:
        raise ValueError('path must be a nonempty string')
    roots = [Path(value).expanduser().resolve() for value in
             (packet.get('output_dir'), os.environ.get('FACTORY_WORKSPACE')) if isinstance(value, str) and value]
    candidate = Path(record['path']).expanduser()
    if not candidate.is_absolute():
        if not roots:
            raise ScopeDenied('Artifact publication requires an authorized directory')
        candidate = roots[0] / candidate
    candidate = candidate.resolve()
    if not any(candidate.is_relative_to(root) for root in roots):
        raise ScopeDenied('Artifact path is outside output_dir and workspace')
    if not candidate.is_file():
        raise ValueError('Artifact path must name an existing file')
    return candidate


def dispatch(store, task_id, capability, packet):
    inputs = packet.get('inputs', {})
    if capability.startswith('expert_streaming.'):
        from .expert_streaming import dispatch as streaming_dispatch
        return streaming_dispatch(store, task_id, capability.removeprefix('expert_streaming.'), inputs)
    if capability in {'evidence.plan_get', 'evidence.plan_patch'}:
        from .taskgraph import plan_get, plan_patch
        if capability == 'evidence.plan_get':
            fields(inputs, {'rev'})
            return {'plan': plan_get(store, task_id, **inputs)}
        fields(inputs, {'patch', 'expected_graph_rev', 'decision_rev'},
               {'patch', 'expected_graph_rev', 'decision_rev'})
        return {'plan': plan_patch(store, task_id, **inputs)}
    if capability.startswith('lab.'):
        from .manager import Manager
        operation = capability.removeprefix('lab.')
        if operation not in {'submit', 'status', 'cancel', 'result', 'ab_submit', 'ab_status', 'ab_result'}:
            raise ValueError('Unknown lab capability')
        if hasattr(store, '_check'):
            store._check(task_id, write=True)
            host = store._store
        else:
            host = store
        manager = Manager(host, host.home / 'lab-spool')
        if operation == 'ab_submit':
            required = {'base_image', 'candidate_image', 'base_env', 'candidate_env', 'rounds', 'idem_key', 'component'}
            fields(inputs, required | {'contract_id'}, required)
            return manager.ab_submit(task_id, **inputs)
        if operation == 'submit':
            fields(inputs, {'image', 'build_attempt_id', 'contract_id', 'run_config', 'idem_key'},
                   {'image', 'build_attempt_id', 'contract_id', 'run_config', 'idem_key'})
            admission = manager.admit(task_id, inputs['image'], inputs['build_attempt_id'])
            attempt = manager.submit_run(task_id, admission['admission_id'], inputs['contract_id'],
                                         inputs['run_config'], inputs['idem_key'])
            return dict(admission=admission, **{k: attempt[k] for k in ('attempt_id', 'state', 'jobq_id')})
        fields(inputs, {'attempt_id'}, {'attempt_id'})
        attempt = manager.jobs._get(inputs['attempt_id'])
        if attempt['task_id'] != task_id or attempt['kind'] != 'lab':
            raise ScopeDenied('Lab attempt belongs to another task or capability')
        if operation.startswith('ab_') and attempt['request'].get('mode') != 'ab':
            raise ValueError('A/B operation requires an A/B attempt')
        return getattr(manager, operation)(inputs['attempt_id'])
    if capability.startswith('builder.'):
        from .builder import Builder
        operation = capability.removeprefix('builder.')
        if operation not in {'submit', 'status', 'cancel', 'result'}:
            raise ValueError('Unknown builder capability')
        # Unwrap only after enforcing the current task's write boundary. Read
        # grants must never allow cancellation or use of another task's build.
        if hasattr(store, '_check'):
            store._check(task_id, write=True)
            host = store._store
        else:
            host = store
        builder = Builder(host)
        if operation == 'submit':
            fields(inputs, {'request', 'idem_key'}, {'request', 'idem_key'})
            attempt = builder.submit(task_id, inputs['request'], inputs['idem_key'])
            return {key: attempt[key] for key in ('attempt_id', 'state', 'jobq_id')}
        fields(inputs, {'attempt_id'}, {'attempt_id'})
        attempt = builder.jobs._get(inputs['attempt_id'])
        if attempt['task_id'] != task_id:
            raise ScopeDenied('Attempt belongs to another task')
        return getattr(builder, operation)(inputs['attempt_id'])
    if capability == 'evidence.query':
        fields(inputs, {'kinds', 'text', 'since', 'limit', 'task_id'})
        options = dict(inputs)
        target = options.pop('task_id', task_id)
        return store.query(target, **options)
    if capability == 'evidence.read':
        fields(inputs, {'id', 'task_id'}, {'id'})
        if not isinstance(inputs['id'], str) or not inputs['id']:
            raise ValueError('id must be a nonempty string')
        if 'task_id' in inputs:
            return store.read(inputs['task_id'], inputs['id'])
        # The advertised interface needs only an evidence id. Prefer the
        # current task, then search explicitly granted tasks in stable order.
        for target in [task_id, *sorted(store.readable - {task_id})]:
            try:
                return store.read(target, inputs['id'])
            except NotFound:
                continue
        raise NotFound('Record not found')
    if capability != 'evidence.publish':
        raise ValueError('Unknown evidence capability')
    if not hasattr(store, '_check'):
        store = store.scoped(task_id)
    fields(inputs, {'type', 'record', 'expected_rev'}, {'type', 'record'})
    record = inputs['record']
    if not isinstance(record, dict):
        raise ValueError('record must be an object')
    record = dict(record)
    if record.get('task_id', task_id) != task_id:
        raise ScopeDenied('Publication belongs to another task')
    if inputs['type'] == 'observation':
        if 'expected_rev' in inputs:
            raise ValueError('expected_rev applies only to decisions')
        if record.get('kind') == 'ab_result':
            raise ScopeDenied('A/B acceptance is reserved for Manager evidence')
        return store.append_observation(task_id, record)
    if inputs['type'] == 'decision':
        if 'expected_rev' in record and 'expected_rev' in inputs and record['expected_rev'] != inputs['expected_rev']:
            raise ValueError('Conflicting expected_rev values')
        expected_rev = record.pop('expected_rev', inputs.get('expected_rev'))
        if store.get_task(task_id).get('contract_id') == 'qwen36-bare-greedy-v1' or record.get('action', {}).get('type') in {'keep_component', 'keep_dormant', 'revert_component'}:
            from .controller import validate_action
            validate_action(record.get('action'))
            if record['action']['type'] == 'keep_component':
                from .controller import validate_keep_evidence
                validate_keep_evidence(store, task_id, record)
        return store.advance_decision(task_id, expected_rev, record)
    if inputs['type'] == 'artifact':
        if 'expected_rev' in inputs:
            raise ValueError('expected_rev applies only to decisions')
        fields(record, {'task_id', 'artifact_id', 'path', 'text', 'media_type', 'producer_attempt'})
        source = artifact_source(record, packet)
        return store.put_artifact(task_id, record.get('artifact_id'), source,
                                  record.get('media_type', 'text/plain' if 'text' in record else 'application/octet-stream'),
                                  record.get('producer_attempt', packet.get('attempt')))
    raise ValueError('type must be observation, decision or artifact')


def input_reason(exc):
    """Keep actionable validation text while redacting configured credentials."""
    from .redact import sanitize
    message = sanitize(str(exc))
    return message[:12000 if 'Allowed knobs and ranges:' in message else 300]


def main():
    from . import telemetry
    started = time.perf_counter()
    packet, result, store = {}, None, None
    capability = sys.argv[1] if len(sys.argv) > 1 else ''
    task_id = os.environ.get('FACTORY_TASK_ID', '').strip()
    home = telemetry.home_path()
    telemetry.set_turn_env(home, task_id)
    try:
        if len(sys.argv) != 2:
            raise ValueError('One capability argument is required')
        packet = json.load(sys.stdin)
        if not isinstance(packet, dict):
            raise ValueError('Packet must be an object')
        if packet.get('capability', sys.argv[1]) != sys.argv[1]:
            raise ValueError('Packet capability differs from command')
        task_id = os.environ.get('FACTORY_TASK_ID', '').strip()
        if not task_id:
            raise ValueError('FACTORY_TASK_ID is required')
        readable = frozenset(t.strip() for t in os.environ.get('FACTORY_READ_TASKS', '').split(',') if t.strip())
        store = Store(home)
        if store:
            # Inspector dispatch: returns a native envelope, including failed
            # probes with their observation/artifact references (F04).
            if sys.argv[1].startswith('inspector.'):
                from .inspector import dispatch as inspector_dispatch
                result = inspector_dispatch(store.scoped(task_id), task_id, sys.argv[1], packet)
            else:
                outputs = dispatch(store.scoped(task_id, readable), task_id, sys.argv[1], packet)
                result = {'outcome': 'ok', 'outputs': outputs}
    except FactoryError as exc:
        result = {'outcome': 'error', 'error': {'code': exc.code, 'message': str(exc)}}
    except (ValueError, TypeError, KeyError, OverflowError, sqlite3.ProgrammingError) as exc:
        result = {'outcome': 'error', 'error': {'code': 'INVALID_INPUT', 'message': input_reason(exc)}}
    except (OSError, sqlite3.Error):
        result = {'outcome': 'error', 'error': {'code': 'PERSISTENCE_FAILED', 'message': 'Evidence persistence failed'}}
    except Exception as exc:  # never leave the capsule without a typed, explainable envelope
        import traceback
        from .redact import sanitize
        traceback.print_exc()
        result = {'outcome': 'error', 'error': {'code': 'INTERNAL_ERROR',
                  'message': sanitize(f'{type(exc).__name__}: {exc}')[:400]}}
    finally:
        telemetry.call(home, task_id, capability, packet, result or {'outcome': 'error'}, started, store=store)
        if store is not None:
            store.close()
    print(json.dumps(result, ensure_ascii=False, allow_nan=False))


if __name__ == '__main__':
    main()

