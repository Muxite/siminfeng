@@ -0,0 +1,168 @@
+"""Fetch reproducible subsets through the public HF datasets-server rows API."""
+import argparse
+from collections import Counter, defaultdict
+import hashlib
+import json
+from pathlib import Path
+import random
+import sys
+import urllib.error
+import urllib.parse
+import urllib.request
+
+try:
+    from .common import sha256, write_json
+except ImportError:
+    from common import sha256, write_json
+
+API = "https://datasets-server.huggingface.co/rows"
+SOURCES = {
+    "mmlu-pro": ("TIGER-Lab/MMLU-Pro", "default", "test"),
+    "arc-challenge": ("allenai/ai2_arc", "ARC-Challenge", "test"),
+    "gsm8k": ("openai/gsm8k", "main", "test"),
+}
+# Probe at fetch time; no claim that an unverified mirror is available or canonical.
+GPQA_MIRRORS = [("fingertap/GPQA-Diamond", "default", "test"),
+                ("fingertap/GPQA-Diamond", "default", "train")]
+
+
+def rows_url(dataset, config, split, offset=0, length=100):
+    if not 1 <= length <= 100:
+        raise ValueError("rows length must be 1..100")
+    return API + "?" + urllib.parse.urlencode(dict(dataset=dataset, config=config,
+                                                 split=split, offset=offset, length=length))
+
+
+def parse_page(payload):
+    """The documented envelope is {rows: [{row_idx, row, ...}], num_rows_total}."""
+    rows = [(int(entry["row_idx"]), entry["row"]) for entry in payload["rows"]]
+    return rows, int(payload["num_rows_total"])
+
+
+def fetch_rows(dataset, config, split, opener=urllib.request.urlopen):
+    offset, total = 0, None
+    result, pages = [], []
+    while total is None or offset < total:
+        url = rows_url(dataset, config, split, offset)
+        with opener(url, timeout=60) as response:
+            raw = response.read()
+        rows, count = parse_page(json.loads(raw))
+        if total is not None and count != total:
+            raise ValueError("dataset size changed while fetching")
+        total = count
+        if not rows or [i for i, _ in rows] != list(range(offset, offset + len(rows))):
+            raise ValueError("empty or noncontiguous datasets-server page")
+        result.extend(rows)
+        pages.append(dict(url=url, offset=offset, length=len(rows), sha256=hashlib.sha256(raw).hexdigest()))
+        offset += len(rows)
+    if len(result) != total:
+        raise ValueError("incomplete dataset")
+    return result, pages
+
+
+def normalize(name, index, row, source, seed=42):
+    meta = {"row_offset": index, "category": row.get("category", row.get("domain", "all"))}
+    if name == "mmlu-pro":
+        question, choices = row["question"], row["options"]
+        answer = row.get("answer")
+        if answer is None:
+            answer = chr(65 + int(row["answer_index"]))
+        meta["question_id"] = row.get("question_id")
+    elif name == "arc-challenge":
+        question = row["question"]
+        choices = row["choices"]["text"]
+        labels = [str(label) for label in row["choices"]["label"]]
+        answer = chr(65 + labels.index(str(row["answerKey"])))
+        meta["original_id"] = row.get("id")
+    elif name == "gsm8k":
+        question, choices, answer = row["question"], None, row["answer"]
+    elif name == "gpqa-diamond":
+        question = row["Question"]
+        original = [row["Correct Answer"], *[row[f"Incorrect Answer {i}"] for i in (1, 2, 3)]]
+        order = list(range(4))
+        random.Random(f"{seed}:{source}:{index}").shuffle(order)
+        choices = [original[i] for i in order]
+        answer = chr(65 + order.index(0))
+        meta["choice_permutation"] = order
+        meta["category"] = row.get("Subdomain", row.get("High-level domain", "all"))
+    else:
+        raise ValueError(name)
+    if choices is not None:
+        if not 2 <= len(choices) <= 26 or answer not in [chr(65 + i) for i in range(len(choices))]:
+            raise ValueError(f"invalid MCQ at row {index}")
+    return dict(id=f"{name}:{index}", source=source, question=question,
+                choices=choices, answer=answer, meta=meta)
+
+
+def subset(rows, n, seed):
+    """Proportional category allocation, largest remainders, seeded tie breaking."""
+    if not 1 <= n <= len(rows):
+        raise ValueError(f"n must be 1..{len(rows)}")
+    rng = random.Random(seed)
+    groups = defaultdict(list)
+    for row in rows:
+        groups[str(row["meta"].get("category", "all"))].append(row)
+    keys = sorted(groups)
+    rng.shuffle(keys)
+    quotas = {key: n * len(groups[key]) // len(rows) for key in keys}
+    ranked = sorted(keys, key=lambda key: n * len(groups[key]) % len(rows), reverse=True)
+    for key in ranked[:n - sum(quotas.values())]:
+        quotas[key] += 1
+    selected = []
+    for key in sorted(keys):
+        group = sorted(groups[key], key=lambda row: row["id"])
+        rng.shuffle(group)
+        selected.extend(group[:quotas[key]])
+    rng.shuffle(selected)
+    return selected
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("name", choices=[*SOURCES, "gpqa-diamond"])
+    parser.add_argument("-n", type=int, required=True)
+    parser.add_argument("--seed", type=int, default=42)
+    parser.add_argument("--outdir", type=Path, default=Path("~/models/campaign/data/acc").expanduser())
+    parser.add_argument("--gpqa-dataset", help="Public Diamond mirror with original GPQA columns")
+    parser.add_argument("--config", help="Override source config")
+    parser.add_argument("--split", help="Override split (GPQA mirrors may use train)")
+    args = parser.parse_args()
+    if args.n < 1:
+        parser.error("n must be positive")
+    if args.name == "gpqa-diamond":
+        sources = [(args.gpqa_dataset, args.config or "default", args.split or "train")] if args.gpqa_dataset else GPQA_MIRRORS
+    else:
+        dataset, config, split = SOURCES[args.name]
+        sources = [(dataset, args.config or config, args.split or split)]
+    failures = []
+    for dataset, config, split in sources:
+        try:
+            raw, pages = fetch_rows(dataset, config, split)
+            break
+        except urllib.error.HTTPError as exc:
+            if args.name != "gpqa-diamond" or exc.code not in (401, 403, 404, 422):
+                raise
+            failures.append(f"{dataset}/{config}/{split}: HTTP {exc.code}")
+    else:
+        print("SKIP GPQA-Diamond: no accessible public mirror; " + "; ".join(failures), file=sys.stderr)
+        return
+    source = rows_url(dataset, config, split)
+    normalized = [normalize(args.name, i, row, source, args.seed) for i, row in raw]
+    selected = subset(normalized, args.n, args.seed)
+    args.outdir.mkdir(parents=True, exist_ok=True)
+    path = args.outdir / f"{args.name}-{args.n}-s{args.seed}.jsonl"
+    metadata = path.with_suffix(".meta.json")
+    if path.exists() or metadata.exists():
+        raise FileExistsError(f"refusing to overwrite {path} or {metadata}")
+    path.write_text("".join(json.dumps(row, ensure_ascii=False) + "\n" for row in selected))
+    write_json(metadata, dict(dataset=dataset, config=config, split=split, source_url=source,
+               seed=args.seed, n=args.n, total_rows=len(raw), pages=pages,
+               row_offsets=[r["meta"]["row_offset"] for r in selected], sha256=sha256(path),
+               selection="proportional category / largest remainders / seeded shuffle",
+               categories=dict(Counter(str(r["meta"]["category"]) for r in selected)),
+               gpqa_mirror_unverified=args.name == "gpqa-diamond"))
+    print(path)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/campaign/cc/acc/evaluate.py b/campaign/cc/acc/evaluate.py
new file mode 100644
index 0000000000000000000000000000000000000000..cabecbdb9daa67f0f01c2fadef3d7c675d1f7152
--- /dev/null
+++ b/campaign/cc/acc/evaluate.py
@@ -0,0 +1,58 @@
+"""Common serial evaluator: one loaded server, one durable record per item."""
+import json
+import os
+import time
+import uuid
+
+try:
+    from . import common, server
+except ImportError:
+    import common
+    import server
+
+
+def run(args, mode, protocol, make_payload, score, format_prompt):
+    if args.dry_run:
+        print(server.from_args(args).dry_run())
+        return
+    items = common.read_jsonl(args.data)
+    if not items:
+        raise ValueError("empty dataset")
+    common.indexed(items)
+    for item in items:
+        format_prompt(item)  # Validate before starting a costly model.
+    out = common.prepare_run(args, mode, protocol)
+    output = out / "items.jsonl"
+    pending = common.pending_items(items, output)
+    try:
+        if pending:
+            session = out / "sessions" / uuid.uuid4().hex
+            with server.from_args(args, session) as running:
+                template_path = out / "template.json"
+                template = dict(chat_template=running.props.get("chat_template"),
+                                thinking_settings=common.thinking_settings(running.props))
+                if template_path.exists() and json.loads(template_path.read_text()) != template:
+                    raise ValueError("server template changed since previous attempt")
+                common.write_json(template_path, template)
+                with output.open("a", encoding="utf-8") as stream:
+                    for item in pending:
+                        request = make_payload(item, running.props, protocol["max_tokens"])
+                        started = time.monotonic()
+                        response = common.request_json(running.url + "/v1/chat/completions", request,
+                                                       timeout=args.request_timeout)
+                        elapsed_ms = (time.monotonic() - started) * 1000
+                        row = dict(id=item["id"], answer=item["answer"], source=item["source"],
+                                   meta=item.get("meta", {}), elapsed_ms=elapsed_ms,
+                                   session=str(session.relative_to(out)), request=request, response=response,
+                                   **score(item, response), **common.response_metrics(response))
+                        stream.write(json.dumps(row, ensure_ascii=False, allow_nan=False) + "\n")
+                        stream.flush()
+                        os.fsync(stream.fileno())
+                        print(f"{item['id']}: correct={row['correct']} ({elapsed_ms:.0f} ms)", flush=True)
+    finally:
+        rows = common.read_jsonl(output)
+        result = common.summary(rows)
+        result.update(items_file="items.jsonl", expected_n=len(items), complete=len(rows) == len(items),
+                      mode=mode, protocol=protocol, dataset_sha256=common.sha256(args.data))
+        common.write_json(out / "summary.json", result)
+    print(json.dumps(result, indent=2))
diff --git a/campaign/cc/acc/gen.py b/campaign/cc/acc/gen.py
new file mode 100644
index 0000000000000000000000000000000000000000..2ccf9eb8ff54566a7ce797b897c9291de862bdb5
--- /dev/null
+++ b/campaign/cc/acc/gen.py
@@ -0,0 +1,69 @@
+"""Greedy GSM8K-style generation and exact numeric scoring."""
+import argparse
+from decimal import Decimal, InvalidOperation
+import re
+
+try:
+    from . import common, server
+    from .evaluate import run
+except ImportError:
+    import common
+    import server
+    from evaluate import run
+
+PROMPT_FORMAT = "Question: {question}\nSolve the problem. Finish with: The answer is <number>."
+SYSTEM = "You are a helpful assistant."
+NUMBER = r"[-+]?(?:\d{1,3}(?:,\d{3})+|\d+)(?:\.\d+)?(?:[eE][-+]?\d+)?|[-+]?\.\d+"
+
+
+def extract_number(text):
+    # Prefer explicit final-answer markers; otherwise use the last number.
+    marked = re.findall(r"(?:####|the answer is)\s*[:=]?\s*\$?\s*(" + NUMBER + r")", text, re.I)
+    numbers = marked or re.findall(NUMBER, text)
+    if not numbers:
+        return None
+    try:
+        value = Decimal(numbers[-1].replace(",", ""))
+        return str(value) if value.is_finite() else None
+    except InvalidOperation:
+        return None
+
+
+def format_prompt(item):
+    if item["choices"] is not None:
+        raise ValueError("generation expects choices=null")
+    return PROMPT_FORMAT.format(question=item["question"])
+
+
+def payload(item, props, max_tokens=384):
+    return dict(messages=[{"role": "system", "content": SYSTEM},
+                          {"role": "user", "content": format_prompt(item)}],
+                max_tokens=max_tokens, temperature=0, **common.thinking_settings(props))
+
+
+def score(item, response):
+    text = response["choices"][0]["message"].get("content") or ""
+    prediction, expected = extract_number(text), extract_number(str(item["answer"]))
+    if expected is None:
+        raise ValueError(f"answer for {item['id']} has no numeric target")
+    return dict(prediction=prediction, expected_numeric=expected,
+                correct=prediction is not None and Decimal(prediction) == Decimal(expected),
+                text=text, finish_reason=response["choices"][0].get("finish_reason"))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    server.add_arguments(parser)
+    parser.add_argument("--data", required=True)
+    parser.add_argument("--max-tokens", type=int, default=384)
+    parser.add_argument("--request-timeout", type=float, default=1800)
+    args = parser.parse_args()
+    if args.max_tokens < 1:
+        parser.error("max-tokens must be positive")
+    run(args, "gen", dict(prompt_format=PROMPT_FORMAT, system=SYSTEM,
+        max_tokens=args.max_tokens, temperature=0, numeric_extraction="last explicit marker else last number",
+        non_thinking="enable_thinking=false when template uses variable"), payload, score, format_prompt)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/campaign/cc/acc/kld.py b/campaign/cc/acc/kld.py
new file mode 100644
index 0000000000000000000000000000000000000000..f074e854c1c8949407b9581c1b5ab092dddf1ff9
--- /dev/null
+++ b/campaign/cc/acc/kld.py
@@ -0,0 +1,115 @@
+"""Save reference logits, run candidate KL divergence, or parse captured output."""
+import argparse
+import json
+from pathlib import Path
+import re
+import subprocess
+
+try:
+    from . import common, server
+except ImportError:
+    import common
+    import server
+
+FLOAT = r"([-+]?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?)"
+
+
+def parse(text):
+    patterns = dict(ppl=r"Mean PPL\(Q\)\s*:\s*" + FLOAT,
+                    mean_kld=r"Mean\s+KLD:\s*" + FLOAT,
+                    kld_p99=r"99\.0%\s+KLD:\s*" + FLOAT,
+                    same_top_p=r"Same top p:\s*" + FLOAT,
+                    rms_dp=r"RMS Δp\s*:\s*" + FLOAT)
+    result = {}
+    for key, pattern in patterns.items():
+        match = re.search(pattern, text)
+        if not match:
+            raise ValueError(f"missing {key}: incomplete or unsupported KL output")
+        result[key] = float(match.group(1))
+    context = re.search(r"computing over\s+(\d+)\s+chunks,\s*n_ctx=(\d+)", text)
+    rows = re.findall(r"^\s*(\d+)\s+" + FLOAT + r"\s*±", text, re.M)
+    result["n_chunks"] = int(rows[-1][0]) if rows else None
+    result["n_ctx"] = int(context.group(2)) if context else None
+    result["planned_chunks"] = int(context.group(1)) if context else None
+    result["probability_units"] = "percent"  # same_top_p and rms_dp, as printed
+    return result
+
+
+parse_kld = parse
+
+
+def build_runner(args):
+    text = Path(args.text).expanduser().resolve()
+    logits = Path(args.logits).expanduser().resolve()
+    argv = [*args.engine_arg, "-m", "/om/" + Path(args.model).name,
+            "-f", "/d/" + text.name, "-c", "512", "--chunks", str(args.chunks),
+            "-b", "512", "-ub", "1", "--kl-divergence-base", "/kl/" + logits.name]
+    if args.action == "candidate":
+        argv.append("--kl-divergence")
+    return server.OwnedContainer(args.image, args.model, args.outdir, "llama-perplexity", argv,
+        server.parse_env(args.env), mounts=[(text.parent, "/d", True),
+                                          (logits.parent, "/kl", args.action == "candidate")])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest="action", required=True)
+    parse_cmd = commands.add_parser("parse", help="Parse saved stdout + stderr")
+    parse_cmd.add_argument("file", type=Path)
+    for name in ("reference", "candidate"):
+        cmd = commands.add_parser(name)
+        server.add_arguments(cmd)
+        cmd.add_argument("--logits", required=True, help="Host reference logits file (output/input)")
+        cmd.add_argument("--text", default="~/models/campaign/data/wikitext/wikitext-2-raw/wiki.test.raw")
+        cmd.add_argument("--chunks", type=int, default=8)
+        cmd.add_argument("--timeout", type=float, default=7200)
+    args = parser.parse_args()
+    if args.action == "parse":
+        print(json.dumps(parse(args.file.read_text()), indent=2))
+        return
+    if args.chunks < 1:
+        parser.error("chunks must be positive")
+    running = build_runner(args)
+    if args.dry_run:
+        print(running.dry_run())
+        return
+    out = Path(args.outdir)
+    if out.exists():
+        raise FileExistsError("KL runs require a fresh outdir")
+    logits = Path(args.logits).expanduser().resolve()
+    metadata = logits.with_suffix(logits.suffix + ".meta.json")
+    corpus_sha = common.sha256(Path(args.text).expanduser())
+    fixed = dict(text_sha256=corpus_sha, n_ctx=512, chunks=args.chunks, batch=512, ubatch=1)
+    if args.action == "reference":
+        if logits.exists() or metadata.exists():
+            raise FileExistsError("refusing to overwrite reference logits")
+        logits.parent.mkdir(parents=True, exist_ok=True)
+    else:
+        reference = json.loads(metadata.read_text())
+        if reference["fixed"] != fixed or reference["logits_sha256"] != common.sha256(logits):
+            raise ValueError("reference logits/corpus/context/chunks do not match")
+    provenance = dict(fixed=fixed, model_sha256=common.sha256(Path(args.model).expanduser()),
+                      image=args.image, env=args.env, engine_argv=args.engine_arg)
+    with running:
+        common.write_json(out / "provenance.json", provenance)
+        completed = subprocess.run(server.docker_command(["wait", running.name]),
+                                   capture_output=True, text=True, timeout=args.timeout, check=True)
+        if completed.stdout.strip() != "0":
+            raise RuntimeError(f"llama-perplexity exit {completed.stdout.strip()}; inspect logs")
+    text = (out / "stdout.txt").read_text() + "\n" + (out / "stderr.txt").read_text()
+    if args.action == "candidate":
+        result = parse(text)
+        if result["n_ctx"] != 512 or result["n_chunks"] != args.chunks:
+            raise ValueError("KL output context/chunks do not match requested workload")
+    else:
+        if not logits.is_file() or not logits.stat().st_size:
+            raise RuntimeError("reference did not produce logits")
+        common.write_json(metadata, dict(**provenance, logits_sha256=common.sha256(logits),
+                                        run_dir=str(out.resolve())))
+        result = dict(reference_saved=str(logits), **fixed)
+    common.write_json(out / "summary.json", result)
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/campaign/cc/acc/mcq.py b/campaign/cc/acc/mcq.py
new file mode 100644
index 0000000000000000000000000000000000000000..11d0080202e7f534d71e8a0f087f6ba1751deec6
--- /dev/null
+++ b/campaign/cc/acc/mcq.py
@@ -0,0 +1,78 @@
+"""One-token, chat-template MCQ accuracy with resumable per-item evidence."""
+import argparse
+import math
+
+try:
+    from . import common, server
+    from .evaluate import run
+except ImportError:
+    import common
+    import server
+    from evaluate import run
+
+PROMPT_FORMAT = "Question: {question}\n{lettered_choices}\nAnswer with the letter only.\nAnswer:"
+SYSTEM = "You are a helpful assistant."
+
+
+def format_prompt(item):
+    choices = item["choices"]
+    if choices is None or not 2 <= len(choices) <= 26:
+        raise ValueError("MCQ requires 2..26 choices")
+    return PROMPT_FORMAT.format(question=item["question"], lettered_choices="\n".join(
+        f"{chr(65 + i)}. {choice}" for i, choice in enumerate(choices)))
+
+
+def top_logprobs(response):
+    if "choices" in response:
+        content = response["choices"][0].get("logprobs", {}).get("content", [])
+    else:
+        content = response.get("completion_probabilities", [])
+    return content[0].get("top_logprobs", []) if content else []
+
+
+def letter_argmax(entries, choices):
+    letters = [chr(65 + i) for i in range(choices)] if isinstance(choices, int) else list(choices)
+    scores = {}
+    for entry in entries:
+        token = entry.get("token")
+        if token is None and entry.get("bytes") is not None:
+            token = bytes(entry["bytes"]).decode("utf-8", errors="replace")
+        score = entry.get("logprob")
+        if not isinstance(score, (float, int)) or not math.isfinite(score):
+            continue
+        for letter in letters:
+            if token in (letter, " " + letter):
+                scores[letter] = max(score, scores.get(letter, -math.inf))
+    prediction = max(letters, key=lambda x: scores.get(x, -math.inf)) if scores else None
+    return prediction, scores
+
+
+def payload(item, props, max_tokens=1):
+    return dict(messages=[{"role": "system", "content": SYSTEM},
+                          {"role": "user", "content": format_prompt(item)}],
+                max_tokens=1, temperature=0, logprobs=True, top_logprobs=20,
+                **common.thinking_settings(props))
+
+
+def score(item, response):
+    entries = top_logprobs(response)
+    prediction, scores = letter_argmax(entries, len(item["choices"]))
+    return dict(prediction=prediction, correct=prediction is not None and prediction == item["answer"],
+                no_letter=prediction is None, argmax_letter_found=prediction is not None,
+                letter_logprobs=scores, returned_top_k=len(entries))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    server.add_arguments(parser)
+    parser.add_argument("--data", required=True)
+    parser.add_argument("--request-timeout", type=float, default=600)
+    args = parser.parse_args()
+    run(args, "mcq", dict(prompt_format=PROMPT_FORMAT, system=SYSTEM, max_tokens=1,
+        temperature=0, top_logprobs=20, letter_variants=["L", " L"],
+        variant_aggregation="max", non_thinking="enable_thinking=false when template uses variable"),
+        payload, score, format_prompt)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/campaign/cc/acc/server.py b/campaign/cc/acc/server.py
new file mode 100644
index 0000000000000000000000000000000000000000..1b924086c9bb913508c404d28c948b0b1a1f768b
--- /dev/null
+++ b/campaign/cc/acc/server.py
@@ -0,0 +1,222 @@
+"""Owned NVIDIA containers, watchdog/telemetry and localhost llama-server."""
+import argparse
+import atexit
+import json
+import os
+from pathlib import Path
+import shlex
+import signal
+import socket
+import subprocess
+import sys
+import time
+import uuid
+
+try:
+    from .common import request_json, write_json
+except ImportError:
+    from common import request_json, write_json
+
+ROOT = Path(__file__).resolve().parents[2]
+OBSERVER = ROOT / "cc/resource_observe/resource_observe.py"
+
+
+def docker_command(argv, prefix=None):
+    prefix = os.environ.get("DOCKER_CMD_PREFIX", "") if prefix is None else prefix
+    command = ["docker", *map(str, argv)]
+    return shlex.split(prefix) + [shlex.join(command)] if prefix else command
+
+
+def parse_env(values):
+    result = {}
+    for value in values:
+        key, sep, val = value.partition("=")
+        if not sep or not key or not all(c.isalnum() or c == "_" for c in key):
+            raise ValueError("--env must be NAME=VALUE")
+        result[key] = val
+    return result
+
+
+def free_port():
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        return sock.getsockname()[1]
+
+
+class OwnedContainer:
+    def __init__(self, image, model, outdir, tool, argv, env=None, mounts=()):
+        self.image = image
+        self.model = Path(model).expanduser().resolve()
+        self.outdir = Path(outdir)
+        self.tool = tool
+        self.argv = list(argv)
+        self.env = dict(env or {})
+        self.mounts = list(mounts)
+        self.name = "acc-" + uuid.uuid4().hex
+        self.children = []
+        self.started = False
+        self.closed = False
+        self.signals = {}
+        self.start_time = None
+
+    def command(self):
+        args = ["run", "-d", "--name", self.name, "--runtime", "nvidia",
+                "--network", "host", "--label", "campaign=c2", "--label", "acc=1"]
+        env = {**self.env, "NVIDIA_VISIBLE_DEVICES": "all",
+               "NVIDIA_DRIVER_CAPABILITIES": "compute,utility"}
+        for key, value in sorted(env.items()):
+            args += ["-e", f"{key}={value}"]
+        args += ["-v", f"{self.model.parent}:/om:ro"]
+        for host, target, readonly in self.mounts:
+            args += ["-v", f"{Path(host).expanduser().resolve()}:{target}" + (":ro" if readonly else ":rw")]
+        return docker_command(args + [self.image, "/app/" + self.tool, *self.argv])
+
+    def kill_command(self):
+        return docker_command(["kill", self.name])
+
+    def dry_run(self):
+        return "\n".join([shlex.join(self.command()),
+                          "# finally / atexit / SIGTERM cleanup:",
+                          shlex.join(self.kill_command()),
+                          shlex.join(docker_command(["rm", "-f", self.name]))])
+
+    def _signal(self, signum, frame):
+        raise SystemExit(128 + signum)
+
+    def __enter__(self):
+        self.outdir.mkdir(parents=True, exist_ok=True)
+        self.start_time = time.monotonic()
+        atexit.register(self.close)
+        try:
+            for sig in (signal.SIGTERM, signal.SIGINT):
+                self.signals[sig] = signal.signal(sig, self._signal)
+            (self.outdir / "cmd.txt").write_text(self.dry_run() + "\n")
+            write_json(self.outdir / "invocation.json", dict(image=self.image, model=str(self.model),
+                       argv=self.argv, env=self.env, name=self.name))
+            # Mark before launch: cleanup also covers a launch that succeeds but loses its reply.
+            self.started = True
+            result = subprocess.run(self.command(), check=True, capture_output=True, text=True, timeout=120)
+            (self.outdir / "container.id").write_text(result.stdout)
+            watchdog = [sys.executable, str(OBSERVER), "watchdog",
+                "--min-available-mib", os.getenv("OM_MIN_AVAIL_MIB", "600"),
+                "--max-swap-used-mib", os.getenv("OM_MAX_SWAP_MIB", "2560"),
+                "--max-swap-rate-mibs", os.getenv("OM_MAX_SWAP_RATE", "1000"),
+                "--interval-ms", "250", "--kill-cmd", shlex.join(self.kill_command()),
+                "--out", str(self.outdir / "watchdog.jsonl")]
+            sampler = [sys.executable, str(OBSERVER), "sample", "--backends", "io,proc,tegrastats",
+                "--path", str(self.model.parent), "--interval-ms", "500", "--duration-s",
+                os.getenv("OM_MAX_S", "1800"), "--out", str(self.outdir / "telemetry.jsonl")]
+            for cmd in (watchdog, sampler):
+                self.children.append(subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
+            return self
+        except BaseException:
+            self.close()
+            raise
+
+    def close(self):
+        if self.closed:
+            return
+        self.closed = True
+        errors = []
+        # Kill the owned container first: an observer shutdown failure must never
+        # prevent the GPU workload from being stopped.
+        if self.started:
+            def run(args):
+                try:
+                    return subprocess.run(args, capture_output=True, text=True, timeout=30)
+                except (OSError, subprocess.SubprocessError) as exc:
+                    errors.append(str(exc))
+                    return None
+            run(self.kill_command())
+            logs = run(docker_command(["logs", self.name]))
+            if logs is not None:
+                (self.outdir / "stdout.txt").write_text(logs.stdout)
+                (self.outdir / "stderr.txt").write_text(logs.stderr)
+            state = run(docker_command(["inspect", self.name, "--format", "{{json .State}}",]))
+            image = run(docker_command(["inspect", self.name, "--format", "{{.Image}}",]))
+            run(docker_command(["rm", "-f", self.name]))
+            write_json(self.outdir / "result.json", dict(wall_s=time.monotonic() - self.start_time,
+                       container_state=state.stdout.strip() if state else None,
+                       image_id=image.stdout.strip() if image else None, cleanup_errors=errors))
+        for child in self.children:
+            try:
+                child.terminate()
+                try:
+                    child.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    child.kill()
+                    child.wait(timeout=5)
+            except (OSError, subprocess.SubprocessError) as exc:
+                errors.append(str(exc))
+        for sig, previous in self.signals.items():
+            signal.signal(sig, previous)
+        atexit.unregister(self.close)
+
+    def __exit__(self, exc_type, exc, traceback):
+        self.close()
+
+
+class Server(OwnedContainer):
+    def __init__(self, image, model, outdir, engine_argv=(), env=None, port=None, health_timeout=600):
+        self.port = port or free_port()
+        self.health_timeout = health_timeout
+        self.url = f"http://127.0.0.1:{self.port}"
+        argv = [*engine_argv, "-m", "/om/" + Path(model).name, "--host", "127.0.0.1",
+                "--port", str(self.port), "--jinja"]
+        super().__init__(image, model, outdir, "llama-server", argv, env)
+
+    def __enter__(self):
+        super().__enter__()
+        try:
+            deadline = time.monotonic() + self.health_timeout
+            while time.monotonic() < deadline:
+                try:
+                    if request_json(self.url + "/health", timeout=2).get("status") == "ok":
+                        self.props = request_json(self.url + "/props", timeout=10)
+                        write_json(self.outdir / "props.json", self.props)
+                        return self
+                except (OSError, ValueError):
+                    pass
+                state = subprocess.run(docker_command(["inspect", self.name, "--format", "{{.State.Running}}"]),
+                                       capture_output=True, text=True, timeout=15)
+                if state.returncode or state.stdout.strip() != "true":
+                    raise RuntimeError("llama-server exited during startup; inspect session logs")
+                time.sleep(.5)
+            raise TimeoutError("llama-server health timeout")
+        except BaseException:
+            self.close()
+            raise
+
+
+def add_arguments(parser):
+    parser.add_argument("--image", required=True)
+    parser.add_argument("--model", required=True, help="Host GGUF; parent mounted read-only as /om")
+    parser.add_argument("--outdir", required=True)
+    parser.add_argument("--env", action="append", default=[], metavar="NAME=VALUE")
+    parser.add_argument("--engine-arg", action="append", default=[], help="Repeat; use --engine-arg=-ngl for flags")
+    parser.add_argument("--health-timeout", type=float, default=600)
+    parser.add_argument("--dry-run", action="store_true", help="Print Docker start and cleanup, execute nothing")
+
+
+def from_args(args, outdir=None):
+    return Server(args.image, args.model, outdir or args.outdir, args.engine_arg,
+                  parse_env(args.env), health_timeout=args.health_timeout,
+                  port=18080 if args.dry_run else None)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    add_arguments(parser)
+    parser.add_argument("--duration", type=float, default=1800, help="Seconds to serve after health succeeds")
+    args = parser.parse_args()
+    server = from_args(args)
+    if args.dry_run:
+        print(server.dry_run())
+        return
+    with server:
+        print(server.url, flush=True)
+        time.sleep(args.duration)
+
+
+if __name__ == "__main__":
+    main()
