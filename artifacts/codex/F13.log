        LLAMA_LOG_INFO("expert_prefetch: CPU host-consumer hook enabled; device-only experts skipped, next=%d, LRU=32 ids/32 tokens\n", expert_prefetch_next);
    }
    for (auto & layer : expert_prefetch_layers) {
        layer.observed = false;
        layer.predicted.clear();
    }
    ggml_backend_sched_set_cpu_callback(sched.get(), expert_prefetch_layers.empty() ? nullptr : expert_prefetch_cb, this);
