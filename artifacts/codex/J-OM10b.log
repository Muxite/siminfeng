from pathlib import Path
import difflib
root=Path('/home/muk/projects/siminfeng/campaign/cc/mmap_advice/patches')
def patch(old,new,target):
    paths=sorted({p.relative_to(old) for p in old.rglob('*') if p.is_file()} | {p.relative_to(new) for p in new.rglob('*') if p.is_file()})
    out=[]
    for rel in paths:
        a,b=old/rel,new/rel
        before=a.read_bytes() if a.exists() else b''
        after=b.read_bytes() if b.exists() else b''
        if before==after: continue
        out.append(f'diff --git a/{rel} b/{rel}\\n')
        if not a.exists(): out.append('new file mode 100644\\n')
        out.extend(difflib.unified_diff(before.decode().splitlines(True),after.decode().splitlines(True),fromfile=f'a/{rel}' if a.exists() else '/dev/null',tofile=f'b/{rel}' if b.exists() else '/dev/null'))
    (root/target).write_text(''.join(out))
