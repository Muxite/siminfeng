+bool llama_model::tensor_is_mapped(const ggml_tensor * t) const {
+    if (!t || !t->data) {
+        return false;
+    }
+    const uintptr_t ptr = reinterpret_cast<uintptr_t>(t->data);
+    const size_t bytes = ggml_nbytes(t);
+    for (const auto & mapping : pimpl->mappings) {
+        const uintptr_t base = reinterpret_cast<uintptr_t>(mapping->addr());
+        if (ptr >= base && ptr - base <= mapping->size() && bytes <= mapping->size() - (ptr - base)) {
+            return true;
+        }
+    }
+    return false;
+}
+
 bool llama_model::no_alloc() const {
     return params.no_alloc;
 }
