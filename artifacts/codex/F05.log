                    job = json.loads(self._call('show', attempt['jobq_id']).stdout)
                except subprocess.CalledProcessError:
                    if (self.jobq_dir / (attempt['jobq_id'] + '.json')).exists():
                        raise
                    job = None
            state = job['state'] if job else 'unknown'
            detail = state
            if state in {'timeout', 'skipped_dep_failed'}:
                state = 'failed'
            if state not in TERMINAL | {'queued', 'running'}:
                state = 'unknown'
            if job and job.get('stop_reason') == 'cancelled' and state == 'running':
                state = 'cancel_requested'

