bool llama_model::expert_file_info(const ggml_tensor * t, expert_file_range & out) const {
    if (!t || !tensor_is_mapped(t)) { return false; }
    const auto it = pimpl->expert_offsets.find(t->name);
    if (it == pimpl->expert_offsets.end()) { return false; }
    const auto idx = it->second.first;
    const auto offset = it->second.second;
    if (idx >= pimpl->mappings.size() || idx >= pimpl->expert_files.size()) { return false; }
    const auto & mapping = pimpl->mappings[idx];
    if (offset > mapping->size() || ggml_nbytes(t) > mapping->size() - offset ||
            static_cast<char *>(mapping->addr()) + offset != t->data) { return false; }
    out = {idx, offset, mapping->size(), mapping->addr(), pimpl->expert_files[idx]->file_id()};
    return true;
}

bool llama_model::tensor_is_mapped(const ggml_tensor * t) const {
    if (!t || !t->data) {
        return false;
    }
    const uintptr_t ptr = reinterpret_cast<uintptr_t>(t->data);
    const size_t bytes = ggml_nbytes(t);
    for (const auto & mapping : pimpl->mappings) {
        const uintptr_t base = reinterpret_cast<uintptr_t>(mapping->addr());
        if (ptr >= base && ptr - base <= mapping->size() && bytes <= mapping->size() - (ptr - base)) {
            return true;
        }
    }
    return false;
}

bool llama_model::no_alloc() const {
    return params.no_alloc;
}

std::map<ggml_backend_buffer_type_t, size_t> llama_model::memory_breakdown() const {
    std::map<ggml_backend_buffer_type_t, size_t> ret;
    for (const auto & [ctx, bufs] : pimpl->ctxs_bufs) {
        if (no_alloc()) {
            GGML_ASSERT(bufs.size() == 1);
            ggml_backend_buffer_t buf = bufs[0].get();
            GGML_ASSERT(ggml_backend_buffer_get_base(buf) == nullptr);
            ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(buf);
            ret[buft] += ggml_backend_alloc_ctx_tensors_from_buft_size(ctx.get(), buft);
