+void llama_context::expert_prefetch_advise(size_t il, int32_t id) {
+#ifdef __linux__
+    auto & state = expert_prefetch_layers[il];
+    for (auto it = state.recent.begin(); it != state.recent.end();) {
+        if (state.tokens - it->second >= 32) {
+            it = state.recent.erase(it);
+        } else {
+            if (it->first == id) {
+                const auto hit = *it;
+                state.recent.erase(it);
+                state.recent.push_back(hit);
+                return;
+            }
+            ++it;
+        }
+    }
+    const auto & layer = model.layers[il];
+    bool advised = false;
+    bool failed = false;
+    for (const ggml_tensor * w : { layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps }) {
+        if (!w) {
+            continue;
+        }
+        if (id < 0 || id >= w->ne[2] || w->ne[3] != 1 || !ggml_is_contiguous(w) ||
+                w->nb[2] == 0 || !model.tensor_is_mapped(w)) {
+            if (!expert_prefetch_warned) {
+                LLAMA_LOG_INFO("expert_prefetch: skipping non-mmap or non-expert-contiguous tensors/invalid ids (once)\n");
+                expert_prefetch_warned = true;
+            }
+            continue;
+        }
+        static const uintptr_t page = (uintptr_t) sysconf(_SC_PAGESIZE);
+        const uintptr_t start = reinterpret_cast<uintptr_t>(w->data) + size_t(id) * w->nb[2];
+        if (page == 0 || page == UINTPTR_MAX || start > UINTPTR_MAX - w->nb[2] ||
+                start + w->nb[2] > UINTPTR_MAX - (page - 1)) {
+            continue;
+        }
+        const uintptr_t first = start - start % page;
+        const uintptr_t end = start + w->nb[2];
+        const uintptr_t last = end + (page - end % page) % page;
+        ++expert_prefetch_calls;
+        expert_prefetch_bytes += last - first;
+        if (madvise(reinterpret_cast<void *>(first), last - first, MADV_WILLNEED) != 0) {
+            ++expert_prefetch_failures;
+            failed = true;
+        } else {
+            advised = true;
+        }
+    }
+    if (advised && !failed) {
+        if (state.recent.size() == 32) {
+            state.recent.erase(state.recent.begin());
+        }
+        state.recent.emplace_back(id, state.tokens);
+    }
+#else
+    (void) il;
+    (void) id;
+#endif
+}
+
+void llama_context::expert_prefetch_cb(ggml_tensor * t, bool ask, bool * observe, void * data) {
