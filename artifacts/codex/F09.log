def load(path):
    try:
        return normalize(read_yaml(path))
    except TypeError as error:
        raise CCError('INVALID_DECLARATION', str(error)) from error


def read_json(path):
    return json.loads(Path(path).read_text(encoding='utf-8-sig'), object_pairs_hook=unique_json)


def contained(root, relative):
    root = Path(root).resolve()
    require(isinstance(relative, str) and bool(relative) and not Path(relative).is_absolute(), 'INVALID_PATH', str(relative))
    target = root / relative
    require(root in target.resolve().parents, 'INVALID_PATH', relative)
    require(not any(p.is_symlink() for p in [target, *list(target.parents)[:len(target.parts)-len(root.parts)]]), 'INVALID_PATH', 'Links are unsupported')
    return target


def tree_files(root):
    rows = []
    for path in sorted(Path(root).rglob('*')):
        relative = path.relative_to(root)
        if any(part in IGNORED for part in relative.parts):
            continue
        require(not path.is_symlink(), 'INVALID_PATH', f'Source links unsupported: {relative}')
        if path.is_file():
            rows.append({'path': relative.as_posix(), 'sha256': file_sha(path), 'size': path.stat().st_size, 'mode': stat.S_IMODE(path.stat().st_mode)})
    return rows


def snapshot(root):
    rows = tree_files(root)
    git = {}
    for key, arguments in [('head', ['rev-parse', 'HEAD']), ('index_path', ['rev-parse', '--git-path', 'index'])]:
        proc = subprocess.run(['git', '-C', str(root), *arguments], capture_output=True, text=True, stdin=subprocess.DEVNULL)
        if proc.returncode == 0:
            git[key] = proc.stdout.strip()
    if 'index_path' in git:
        index = Path(git.pop('index_path'))
TABLES = {
    'tasks': ('task_id', 'task_id TEXT PRIMARY KEY, objective TEXT NOT NULL, constraints JSON NOT NULL, allowed_effects JSON NOT NULL, target JSON NOT NULL, budget JSON NOT NULL, revision INTEGER NOT NULL, current_decision_rev INTEGER NOT NULL, evidence_cursor INTEGER NOT NULL, created REAL NOT NULL'),
    'decisions': ('decision_id', 'decision_id TEXT NOT NULL, task_id TEXT NOT NULL REFERENCES tasks(task_id), rev INTEGER NOT NULL, parent_rev INTEGER NOT NULL, evidence_ids JSON NOT NULL, observations JSON NOT NULL, hypothesis TEXT NOT NULL, uncertainty TEXT NOT NULL, action JSON NOT NULL, expected_evidence TEXT NOT NULL, budget JSON NOT NULL, stop_condition TEXT NOT NULL, reason_for_change TEXT NOT NULL, created REAL NOT NULL, PRIMARY KEY(task_id, decision_id), UNIQUE(task_id, rev)'),
    'artifacts': ('artifact_id', 'artifact_id TEXT NOT NULL, task_id TEXT NOT NULL REFERENCES tasks(task_id), sha256 TEXT NOT NULL, size INTEGER NOT NULL, media_type TEXT NOT NULL, producer_attempt TEXT, location TEXT NOT NULL, complete INTEGER NOT NULL, created REAL NOT NULL, PRIMARY KEY(task_id, artifact_id)'),
