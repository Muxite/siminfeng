#!/usr/bin/env python3
"""cost_report: wall-time and agent-token accounting from the evidence index and native Codex event streams (no estimates)."""
import json, collections, os, glob, re
R = os.path.expanduser("~/projects/siminfeng/campaign")
ops = [json.loads(l) for l in open(f"{R}/index/ops.jsonl")]
cat = collections.defaultdict(lambda: [0, 0.0])
def klass(o):
    d = (o.get("desc") or "").lower(); a = o.get("agent") or ""
    if a.startswith("codex") or a.startswith("astra"): return "agent:" + a
    if "build_engine" in d or "docker build" in d: return "build"
    if "bin/lab run" in d or "lab run" in d or " attempt" in d or d.startswith(("w1","w3","w6")) or "nsys" in d or "ncu" in d: return "gpu/experiment"
    if "quantize" in d or "convert" in d: return "preparation"
    return "other-ops"
for o in ops:
    if o.get("elapsed_s") is None: continue
    c = cat[klass(o)]; c[0] += 1; c[1] += o["elapsed_s"]
print("== wall time by class (sum of op wall seconds; overlapping/background ops double-count)")
for k, (n, s) in sorted(cat.items(), key=lambda kv: -kv[1][1]): print(f"{k:22s} ops={n:4d}  {s/60:8.1f} min")
print("\n== Codex/astra native token usage (turn.completed events in raw streams)")
tot = collections.Counter()
for o in ops:
    if not (o.get("agent", "").startswith(("codex", "astra")) and o.get("stdout")): continue
    u = collections.Counter()
    try:
        for l in open(o["stdout"]["path"], errors="ignore"):
            if '"turn.completed"' in l:
                m = json.loads(l).get("usage", {}); [u.update({k: m.get(k, 0)}) for k in ("input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens")]
    except Exception: pass
    print(f"{o['agent']:14s} {o['elapsed_s']/60:6.1f} min  in={u['input_tokens']:>9,} (cached {u['cached_input_tokens']:>9,}) out={u['output_tokens']:>7,} reasoning={u['reasoning_output_tokens']:>7,}")
    tot.update(u)
print(f"{'TOTAL':14s}            in={tot['input_tokens']:>9,} (cached {tot['cached_input_tokens']:>9,}) out={tot['output_tokens']:>7,} reasoning={tot['reasoning_output_tokens']:>7,}")
print("\nNot measured here: Claude (orchestrator, Opus and Sonnet subagents) token cost — available only in the Claude Code transcripts under ~/.claude/projects (hooks capture tool calls, not billing).")
