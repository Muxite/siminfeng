ab run JOB                       new attempt (retry = new attempt); no GPU admission control (lock removed)\n  lab cancel JOB ATT                request cancellation (confirmed only when owned containers are gone)\n  lab status [JOB]                  states\n  lab reconcile                     inspect non-terminal attempts against REAL processes/containers; never trusts heartbeats\n  lab register JOB ATT              register result into index (idempotent; stale/conflicting rejected)\nStore: $LAB/{images,jobs,index}. Fault injection for recovery tests: LAB_FAULT=die_after_start|die_in_export\n\"\"\"\nimport json, sys, os, re, time, uuid, hashlib, fcntl, subprocess, argparse, shutil, datetime as dt, glob\nLAB = os.environ.get(\"LAB\", os.path.expanduser(\"~/projects/siminfeng/campaign/lab\"))\nCID = os.environ.get(\"CAMPAIGN_ID\", \"c1\")\nnow = lambda: dt.datetime.now(dt.timezone.utc).isoformat()\ndef jd(o): return json.dumps(o, sort_keys=True)\ndef sha(p):\n    h = hashlib.sha256()\n    with open(p, \"rb\") as f:\n        for b in iter(lambda: f.read(1 << 20), b\"\"): h.update(b)\n    return h.hexdigest()\ndef sha_s(s): return hashlib.sha256(s.encode()).hexdigest()\ndef sh(cmd, **kw): return subprocess.run(cmd, capture_output=True, text=True, **kw)\ndef append(path, rec):\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)\n    try: fcntl.flock(fd, fcntl.LOCK_EX); os.write(fd, (jd(rec) + \"\\n\").encode()); os.fsync(fd)\n    finally: os.close(fd)\ndef proc_start(pid):\n    try: return open(f\"/proc/{pid}/stat\").read().rsplit(\")\", 1)[1].split()[19]\n    except Exception: return None\ndef last_state(adir):\n    p = os.path.join(adir, \"state.jsonl\")\n    rows = [json.loads(l) for l in open(p)] if os.path.exists(p) else []\n    return rows[-1] if rows else None\n\n# ---- test definitions: how an image's tools are exercised and judged (the \"tests\" half of a lab) ----\ndef load_tests():\n    t = {}\n    import glob as g\n    for f in sorted(g.glob(os.path.join(LAB, \"tests\", \"*.json\"))): t.update(json.load(open(f)))\n    return t\nTESTS = load_tests()\ndef assess(test, out, err, rc):\n    \"\"\"Decode only for parsing; preserve diagnostics and contain parser failures.\"\"\"\n    invalid_utf8 = False\n    try:\n        decoded = []\n        for value in (out, err):\n            if isinstance(value, bytes):\n                try: value = value.decode(\"utf-8\")\n                except UnicodeDecodeError:\n                    invalid_utf8 = True\n                    value = value.decode(\"utf-8\", errors=\"replace\")\n                # Match the universal newlines of the previous text-mode reads.\n                value = value.replace(\"\\r\\n\", \"\\n\").replace(\"\\r\", \"\\n\")\n            decoded.append(value)\n        result = _parse_assessment(test, *decoded, rc)\n    except Exception as exc:\n        result = dict(ok=False, assessment_error=f\"{type(exc).__name__}: {exc}\")\n    if invalid_utf8:\n        # Generated text may legitimately end/split inside a multibyte char (byte-level tokens).\n        # Flag always; fail closed only for parsers that extract numbers from the text.\n        result.update(invalid_utf8=True, decode_replacements=sum(v.count(\"\\ufffd\") for v in decoded))\n        if TESTS.get(test, {}).get(\"parser\") != \"completion\": result[\"ok\"] = False\njob-ad883810b3 {\n  \"job\": \"job-ad883810b3\",\n  \"submitted\": \"2026-11-09T22:17:05.140545+00:00\",\n  \"spec\": {\n    \"image\": \"llamacpp-b0\",\n    \"image_id\": \"sha256:cf383f82e33130ce1be424b4c88a78ed12d8a693406b0c3b7ddb61afed0612d1\",\n    \"model\": \"/home/muk/models/campaign/gguf/granite-3.1-1b-a400m-instruct-mixE4K.gguf\",\n    \"model_sha256\": \"2e520c4a7b15ce292cc88e92fef00fb99da276dc5d6fc8e8f832b8525f8565a6\",\n    \"data\": null,\n    \"data_sha256\": null,\n    \"tests\": [\n      \"m1_static_n24\",\n      \"m1_static_n18\",\n      \"m1_static_n12\",\n  