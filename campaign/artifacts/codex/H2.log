, "value": 0, "unit": "percent", "scope": "gpu", "source": "tegrastats"}, {"name": "temp_cpu", "value": 49.187, "unit": "celsius", "scope": "sensor", "source": "tegrastats"}, {"name": "temp_soc2", "value": 48.562, "unit": "celsius", "scope": "sensor", "source": "tegrastats"}, {"name": "temp_soc0", "value": 49.75, "unit": "celsius", "scope": "sensor", "source": "tegrastats"}, {"name": "temp_gpu", "value": 49.375, "unit": "celsius", "scope": "sensor", "source": "tegrastats"}, {"name": "temp_tj", "value": 49.75, "unit": "celsius", "scope": "sensor", "source": "tegrastats"}, {"name": "temp_soc1", "value": 48.968, "unit": "celsius", "scope": "sensor", "source": "tegrastats"}, {"name": "power_VDD_IN_instant", "value": 6031, "unit": "mW", "scope": "rail", "source": "tegrastats"}, {"name": "power_VDD_IN_avg", "value": 6021, "unit": "mW", "scope": "rail", "source": "tegrastats"}, {"name": "power_VDD_CPU_GPU_CV_instant", "value": 1621, "unit": "mW", "scope": "rail", "source": "tegrastats"}, {"name": "power_VDD_CPU_GPU_CV_avg", "value": 1613, "unit": "mW", "scope": "rail", "source": "tegrastats"}, {"name": "power_VDD_SOC_instant", "value": 1505, "unit": "mW", "scope": "rail", "source": "tegrastats"}, {"name": "power_VDD_SOC_avg", "value": 1497, "unit": "mW", "scope": "rail", "source": "tegrastats"}], "unavailable": [{"name": "gpu_freq", "backend": "tegrastats", "reason": "no @MHz in GR3D_FREQ"}, {"name": "emc_freq", "backend": "tegrastats", "reason": "EMC_FREQ not reported on this board/release"}], "parse_errors": []}

