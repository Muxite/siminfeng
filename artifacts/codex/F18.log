+    rusage end;
+    getrusage(RUSAGE_SELF, &end);
+    const auto time_us = [](const timeval & t) { return int64_t(t.tv_sec) * 1000000 + t.tv_usec; };
+    const size_t count = std::min<uint64_t>(p.tokens, p.token_ns.size());
+    std::sort(p.token_ns.begin(), p.token_ns.begin() + count);
