ia-smi\",\"--query-gpu=memory.used\",\"--format=csv,noheader,nounits\"]).stdout.strip()\n183:                    cg = cg or cid_cgroup(cname)\n185:                        v = read_int(cg + \"/memory.peak\") or read_int(cg + \"/memory.current\"); peak_host = max(peak_host, v or 0)\n193:        results[f\"{t}#{ti}\"] = dict(exit_code=rc, elapsed_s=round(time.monotonic()-ts,3), partial=died, mem=dict(gpu_peak_mib=peak_gpu, gpu_baseline_mib=base_gpu, gpu_delta_mib=peak_gpu-base_gpu, host_cgroup_peak_mib=round(peak_host/2**20,1), io_read_mib=round(io_rbytes/2**20,1), samples=nsamp, method=\"nvidia-smi memory.used polled 4Hz (device otherwise idle; includes CUDA context) + cgroup memory.peak\"), **assess(t, open(o, errors=\"replace\").read(), open(e, errors=\"replace\").read(), rc))\n196:    post = gpu_state()\n","exit_code":0,"status":"completed"}}
