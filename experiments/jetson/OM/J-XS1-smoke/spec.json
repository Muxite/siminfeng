{
  "id": "J-XS1-smoke",
  "outdir_base": "experiments/jetson/OM",
  "runner": "om_run",
  "tool": "llama-completion",
  "argv": [
    "-m",
    "/om/model.gguf",
    "-f",
    "/om/prompts/p1.txt",
    "-n",
    "64",
    "-c",
    "4096",
    "--temp",
    "0",
    "-s",
    "1",
    "-no-cnv",
    "-ngl",
    "99",
    "-lm",
    "mmap",
    "-cmoe",
    "-lv",
    "4"
  ],
  "metric": "eval_ms_per_token",
  "direction": "lower",
  "threads": true,
  "order": "explicit",
  "explicit_order": [
    "base",
    "join"
  ],
  "arms": {
    "base": {
      "image": "factory/llamacpp:xs-dev-10-11",
      "env": {
        "LLAMA_EXPERT_FILL": "1",
        "LLAMA_EXPERT_FILL_CHUNK_KIB": "2048",
        "LLAMA_EXPERT_FILL_DIAG": "0",
        "LLAMA_EXPERT_FILL_MAX_TOKENS": "1",
        "LLAMA_EXPERT_FILL_MIN_TOKENS": "0",
        "LLAMA_EXPERT_FILL_POPULATE": "0",
        "LLAMA_EXPERT_FILL_RANDOM": "decode",
        "LLAMA_EXPERT_FILL_THREADS": "16",
        "LLAMA_EXPERT_PREFETCH": "0",
        "LLAMA_EXPERT_PREFETCH_NEXT": "0",
        "LLAMA_EXPERT_PREGATE": "1",
        "LLAMA_EXPERT_PREGATE_K": "8",
        "LLAMA_EXPERT_PREGATE_LOOKAHEAD": "1",
        "LLAMA_EXPERT_PREGATE_MAX_INFLIGHT": "4",
        "LLAMA_EXPERT_PREGATE_ORDER": "after",
        "LLAMA_MMAP_ADVICE": "default",
        "LLAMA_EXPERT_READINESS": "1"
      },
      "expect_switch": false
    },
    "join": {
      "image": "factory/llamacpp:xs-dev-10-11",
      "env": {
        "LLAMA_EXPERT_FILL": "1",
        "LLAMA_EXPERT_FILL_CHUNK_KIB": "2048",
        "LLAMA_EXPERT_FILL_DIAG": "0",
        "LLAMA_EXPERT_FILL_MAX_TOKENS": "1",
        "LLAMA_EXPERT_FILL_MIN_TOKENS": "0",
        "LLAMA_EXPERT_FILL_POPULATE": "0",
        "LLAMA_EXPERT_FILL_RANDOM": "decode",
        "LLAMA_EXPERT_FILL_THREADS": "16",
        "LLAMA_EXPERT_PREFETCH": "0",
        "LLAMA_EXPERT_PREFETCH_NEXT": "0",
        "LLAMA_EXPERT_PREGATE": "1",
        "LLAMA_EXPERT_PREGATE_K": "8",
        "LLAMA_EXPERT_PREGATE_LOOKAHEAD": "1",
        "LLAMA_EXPERT_PREGATE_MAX_INFLIGHT": "4",
        "LLAMA_EXPERT_PREGATE_ORDER": "after",
        "LLAMA_MMAP_ADVICE": "default",
        "LLAMA_EXPERT_READINESS": "1",
        "LLAMA_EXPERT_PREGATE_JOIN": "1"
      },
      "expect_switch": true,
      "switch_regex": [
        "expert_fill: active",
        "expert_pregate: active k=8 ",
        "expert_readiness: active",
        "expert_readiness: stats decode_tokens=[1-9]",
        "readiness=1 join=1$",
        "join_waits=[0-9]+"
      ]
    }
  }
}
