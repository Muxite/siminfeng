e host-side benchmark could not be built at all (found on p1004,\n  2932\t# 2026-10-23: the CPU lane is exactly what a box without a usable GPU needs to measure).  This branch builds the one target\n  2933\t# that has no device code, so the CPU-lane A/B runs anywhere.\n  2934\tif(STRATA_BUILD_DSV41 AND NOT STRATA_ENABLE_CUDA AND NOT STRATA_ENABLE_HIP AND NOT STRATA_HIP_GFX906)\n  2935\t  message(STATUS \"STRATA_BUILD_DSV41: no GPU backend, building the host-side benchmark only (ds4_gg_bench)\")\n  2936\t  if(STRATA_NATIVE_EXPERTS)\n  2937\t    add_executable(ds4_gg_bench tests/dsv41/gg_dot_bench.cpp src/dsv41/ds4_gg_cpu.cpp)\n  2938\t    target_include_directories(ds4_gg_bench PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/include ${CMAKE_CURRENT_SOURCE_DIR}/src/dsv41\n  2939\t                               ${CMAKE_CURRENT_SOURCE_DIR}/third_party/ggml)\n  2940\t    target_link_libraries(ds4_gg_bench PRIVATE strata_kernels_cpu Threads::Threads)\n  2941\t    target_compile_definitions(ds4_gg_bench PRIVATE STRATA_DSV41_TQ_CPU=1)\n  2942\t  endif()\n  2943\tendif()\n  2944\t\n  2945\t# ---- strata-split: the opt-in engine that splits every layer across 2-4 NVIDIA cards (src/split, from sFNX, MIT, John Fink) ----\n  2946\t# OFF by default, Linux + CUDA only, no other target depends on it; see src/split/CMakeLists.txt and docs/SPLIT_ENGINE.md.\n  2947\toption(STRATA_BUILD_SPLIT \"Build strata-split: sFNX's split-every-layer engine, host-memory exchange (Linux, CUDA or HIP gfx1201, 2-4 cards)\" OFF)\n  2948\tif(STRATA_BUILD_SPLIT)\n  2949\t  add_subdirectory(src/split)\n  2950\tendif()\n9:#include <cstdint>\n     1\t// include/strata/core/hit_hook.hpp - R4.2c: the seam between the host loop and the VRAM expert tier.\n     2\t//\n     3\t// **IT IS ITS OWN HEADER BECAUSE BOTH SIDES NEED IT AND NEITHER SHOULD OWN IT.**  `session.hpp` declares the\n     4\t// loop that calls the hook; `expert_source.hpp` declares the implementation that answers it.  Putting the type\n     5\t// in either one makes the other include a header it has no other use for, and the loop knowing what an expert\n     6\t// cache is (or the adapter knowing what a graph is) is exactly the coupling this seam exists to avoid.\n     7\t#pragma once\n     8\t\n     9\t#include <cstdint>\n    10\t\n    11\tnamespace strata::core {\n    12\t\n    13\t/// **TWO PHASES, AND THE SPLIT IS THE WHOLE POINT.**  `Launch` runs BEFORE the CPU pool and `Combine` runs\n    14\t/// AFTER the misses have been copied into `parts`.  That ordering is what lets the GPU's resident experts run\n    15\t/// at the same time as the CPU's misses instead of after them:\n    16\t///\n    17\t///     ring -> hits(Launch)   [GPU: quantize + grouped experts into `hit_out`]\n    18\t///          -> pool()         [CPU: the misses, CONCURRENT with the GPU]\n    19\t///          -> H2D misses into `parts`\n    20\t///          -> hits(Combine)  [GPU: parts += hit_out]\n    21\t///          -> post[l]\n    22\t///\n    23\t/// **MEASURED, AND WHY IT IS NOT THE OBVIOUS ORDER.**  The first version called the hit path once, after the\n    24\t/// pool, writing straight into `parts`.  The drain duly fell **18.2 -> 10.2 ms** - the CPU really was doing\n    25\t/// half the experts - and **the token did not move at all**, because the GPU's half had simply been moved onto\n    26\t/// the critical path behind the CPU's instead of beside it.  A second buffer and one `add_inplace` buy the\n    27\t/// overlap back.\n    28\tenum class HitPhase { Launch, Combine };\n    29\t\n    30\t/// `ids` AND `k` ARE THE ROUTER'S OWN OUTPUT, AND THEY ARE WHY THIS HOOK TAKES ARGUMENTS AT ALL.\n    31\t///\n    32\t/// The first version took only `(user, stream, phase)` and left the hit/miss decision inside the pool\n    33\t/// callback - which runs AFTER `Launch`.  So `Launch` read the hit list from the PREVIOUS layer and computed\n    34\t/// the previous layer's experts into the current layer's rows.  It produced a token, the timings