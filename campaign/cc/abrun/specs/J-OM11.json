{
  "id": "J-OM11",
  "outdir_base": "experiments/jetson/OM",
  "runner": "om_run",
  "tool": "llama-completion",
  "argv": [
    "-m",
    "/om/model.gguf",
    "-f",
    "/om/prompts/p1.txt",
    "-n",
    "64",
    "-c",
    "4096",
    "--temp",
    "0",
    "-s",
    "1",
    "-no-cnv",
    "-ngl",
    "99",
    "-lm",
    "mmap",
    "-cmoe",
    "-lv",
    "4"
  ],
  "metric": "eval_ms_per_token",
  "arms": {
    "base": {
      "image": "campaign/llamacpp:jetson-up1108-om11",
      "env": {},
      "expect_switch": false,
      "switch_regex": [
        "expert_config: effective fill=0 random=0 max_tokens=0 threads=8 chunk_kib=1024 pregate=0 k=8 order=after max_inflight=4 lookahead=1 min_tokens=0 diag=0 populate=0 diag_csv=\\(unset\\) prefetch=0 prefetch_next=0$"
      ],
      "switch_regex_is_config": true
    },
    "pg8": {
      "image": "campaign/llamacpp:jetson-up1108-om11",
      "env": {
        "LLAMA_EXPERT_FILL": "1",
        "LLAMA_EXPERT_FILL_RANDOM": "decode",
        "LLAMA_EXPERT_FILL_THREADS": "16",
        "LLAMA_EXPERT_FILL_CHUNK_KIB": "2048",
        "LLAMA_EXPERT_PREFETCH": "0",
        "LLAMA_EXPERT_PREFETCH_NEXT": "0",
        "LLAMA_MMAP_ADVICE": "default",
        "LLAMA_EXPERT_FILL_MAX_TOKENS": "1",
        "LLAMA_EXPERT_FILL_MIN_TOKENS": "0",
        "LLAMA_EXPERT_FILL_POPULATE": "0",
        "LLAMA_EXPERT_PREGATE": "1",
        "LLAMA_EXPERT_PREGATE_K": "8",
        "LLAMA_EXPERT_PREGATE_ORDER": "after",
        "LLAMA_EXPERT_PREGATE_MAX_INFLIGHT": "4",
        "LLAMA_EXPERT_PREGATE_LOOKAHEAD": "1"
