def env_arm(value):
    name, sep, raw = value.partition("=")
    if not sep or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_]*", name):
        raise argparse.ArgumentTypeError('"'expected NAME={\"ENV\":\"value\", \"UNSET\":null}')
    try:
