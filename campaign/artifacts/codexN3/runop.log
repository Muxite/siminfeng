{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '120,192p' cc/build_engine/test_build_engine.py && ls -la artifacts/codexN3 && sed -n '147,219p' cc/build_engine/build_engine.py && command -v cc\"","aggregated_output":"    calls = []\n    state = {\"fail_build\": False, \"staged_content\": None}\n\n    def fake(command, **kwargs):\n        if command[0] != \"docker\":\n            return real_run(command, **kwargs)\n        calls.append(command)\n        stdout, stderr = kwargs[\"stdout\"], kwargs[\"stderr\"]\n        result = \"\"\n        code = 0\n        if command[1] == \"version\":\n            result = '{\"Client\":{\"Version\":\"test\"},\"Server\":{\"Version\":\"test\"}}'\n        elif command[1:3] == [\"buildx\", \"version\"]:\n            result = \"buildx unit-test\"\n        elif command[1:3] == [\"buildx\", \"bake\"]:\n            env = kwargs[\"env\"]\n            staged = Path(kwargs[\"cwd\"])\n            assert env[\"SOURCE_DIR\"] == \".\"\n            assert (staged / \".campaign-recipe\" / \"Dockerfile\").exists()\n            assert Path(command[command.index(\"--file\") + 1]).parent == staged / \".campaign-recipe\"\n            assert not any(a.startswith(\"--allow\") for a in command)  # no filesystem entitlements requested\n            state[\"staged_content\"] = (staged / \"input.txt\").read_text()\n            assert not (staged / \".git\").exists()\n            assert \"@sha256:\" in env[\"BASE_RUNTIME\"]\n            state[\"cmake_defines\"] = env[\"CMAKE_DEFINES\"]\n            state[\"dockerfile\"] = (staged / \".campaign-recipe\" / \"Dockerfile\").read_text()\n            state[\"bake\"] = (staged / \".campaign-recipe\" / \"docker-bake.hcl\").read_text()\n            result = \"full compiler stdout\\n\"\n            stderr.write(b\"full compiler stderr\\n\")\n            metadata = state.get(\"metadata\", {\"engine\": {\"containerimage.config.digest\": CONFIG_ID}})\n            Path(command[command.index(\"--metadata-file\") + 1]).write_text(json.dumps(metadata))\n            code = 42 if state[\"fail_build\"] else 0\n        elif command[1:3] == [\"image\", \"inspect\"]:\n            if command[-1].startswith(\"nvidia/\"):\n                result = json.dumps([{\"RepoDigests\": [\"nvidia/cuda@sha256:\" + \"2\" * 64]}])\n            else:\n                result = json.dumps([{\"Id\": state.get(\"inspect_id\", \"sha256:\" + \"9\" * 64), \"RepoDigests\": [],\n                                      \"Created\": \"2026-01-01T00:00:00Z\", \"Architecture\": \"amd64\", \"Os\": \"linux\"}])\n        elif command[1] == \"run\":\n            assert \"--network=none\" in command\n            assert \"--rm\" in command\n            assert \"--read-only\" in command\n            assert \"/bin/sh\" in command\n            # runtime probes use Docker's own immutable reported ID (containerd store rejects\n            # `docker run <config digest>`, observed novmm-2/shot-1 exit 125), never a tag\n            assert state.get(\"inspect_id\", \"sha256:\" + \"9\" * 64) in command\n            if command[-1] == engine.LINKAGE_SCRIPT:\n                assert kwargs[\"timeout\"] == 60\n                result = state.get(\"linkage_output\", linkage_output())\n                code = state.get(\"linkage_code\", 0)\n                stderr.write(b\"probe diagnostic\\n\")\n                if state.get(\"linkage_timeout\"):\n                    stdout.write(b\"partial probe output\\n\")\n                    raise subprocess.TimeoutExpired(command, 60)\n            else:\n                assert \"sha256sum\" in command[-1]\n                result = \"\".join(\"a\" * 64 + \"  /app/\" + tool + \"\\n\" for tool in engine.TOOLS) + \"b\" * 64 + \"  /app/libggml.so.0\\n\"\n        elif command[1] == \"save\":\n            assert command[-1] == state.get(\"inspect_id\", \"sha256:\" + \"9\" * 64)\n            make_tar(command[command.index(\"--output\") + 1], state.get(\"archive\", classic_archive()))\n        else:\n            pytest.fail(\"Unexpected Docker command: \" + repr(command))\n        stdout.write(result.encode())\n        return subprocess.CompletedProcess(command, code)\n\n    monkeypatch.delenv(\"BASE_DEVEL\", raising=False)\n    monkeypatch.delenv(\"BASE_RUNTIME\", raising=False)\n    monkeypatch.setattr(subprocess, \"run\", fake)\n    return calls, state\n\n\ndef test_record_schema_and_success(source, tmp_path, mock_docker):\n    args = arguments(source, tmp_path)\ntotal 16\ndrwxrwxr-x   2 muk muk  4096 Nov  9 22:31 .\ndrwxrwxr-x 180 muk muk 12288 Nov  9 22:32 ..\n-rw-rw-r--   1 muk muk     0 Nov  9 22:31 runop.log\ndef archive_identities(path):\n    \"\"\"Read the linux/amd64 config through OCI indexes or a classic Docker manifest.\n\n    index.json is an archive catalog, not necessarily the original image index.\n    Its descriptors may include both an image index and a platform manifest.\n    \"\"\"\n    out = {\"config_digest\": None, \"index_digest\": None, \"index_manifests\": [],\n           \"index_entry_digests\": [], \"manifest_digest\": None}\n    configs, manifests, indexes = set(), set(), set()\n    with tarfile.open(path) as archive:\n        names = {member.name.removeprefix(\"./\"): member for member in archive}\n\n        def read(name, digest=None):\n            member = names.get(name)\n            if member is None or not member.isfile():\n                raise ValueError(\"Missing image archive object: \" + name)\n            raw = archive.extractfile(member).read()\n            actual = \"sha256:\" + hashlib.sha256(raw).hexdigest()\n            if digest is not None and actual != digest:\n                raise ValueError(\"Image archive digest mismatch: \" + name)\n            return json.loads(raw), actual\n\n        def blob(digest):\n            if not isinstance(digest, str) or not re.fullmatch(r\"sha256:[0-9a-f]{64}\", digest):\n                raise ValueError(\"Invalid image archive digest: \" + str(digest))\n            return read(\"blobs/sha256/\" + digest.split(\":\")[1], digest)[0]\n\n        seen = set()\n\n        def visit(desc):\n            if desc.get(\"annotations\", {}).get(\"vnd.docker.reference.type\") == \"attestation-manifest\":\n                return\n            platform = desc.get(\"platform\", {})\n            if platform and (platform.get(\"os\"), platform.get(\"architecture\")) != (\"linux\", \"amd64\"):\n                return\n            digest = desc.get(\"digest\")\n            if digest in seen:\n                return\n            seen.add(digest)\n            doc = blob(digest)\n            if \"manifests\" in doc:\n                indexes.add(digest)\n                for child in doc[\"manifests\"]:\n                    visit(child)\n            elif \"config\" in doc:\n                config_id = doc[\"config\"][\"digest\"]\n                config = blob(config_id)\n                if (config.get(\"os\"), config.get(\"architecture\")) == (\"linux\", \"amd64\"):\n                    configs.add(config_id)\n                    manifests.add(digest)\n\n        if \"index.json\" in names:\n            catalog, _ = read(\"index.json\")\n            out[\"index_manifests\"] = [{\"digest\": d.get(\"digest\"), \"mediaType\": d.get(\"mediaType\")}\n                                      for d in catalog.get(\"manifests\", [])]\n            out[\"index_entry_digests\"] = [d[\"digest\"] for d in out[\"index_manifests\"]]\n            for descriptor in catalog.get(\"manifests\", []):\n                visit(descriptor)\n        elif \"manifest.json\" in names:\n            entries, _ = read(\"manifest.json\")\n            for entry in entries:\n                config, digest = read(entry[\"Config\"])\n                if (config.get(\"os\"), config.get(\"architecture\")) == (\"linux\", \"amd64\"):\n                    configs.add(digest)\n        if len(configs) != 1:\n            raise ValueError(\"Saved archive must identify exactly one linux/amd64 image config\")\n        out[\"config_digest\"] = configs.pop()\n        out[\"manifest_digest\"] = next(iter(manifests)) if len(manifests) == 1 else None\n        out[\"index_digest\"] = next(iter(indexes)) if len(indexes) == 1 else None\n    return out\n\n\ndef archive_provenance(path):\n/usr/bin/cc\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > cc/build_engine/host_linkage.py <<'PY'\n\\\"\\\"\\\"Offline CUDA ELF inspection; no Docker or host ELF tools required.\n\nLayer streaming, digest checks and whiteout merging follow\ncc/engine_handoff/engine_handoff.py:observe_archive. Only the resolved CUDA\nbackend is copied out, into a caller-owned temporary directory.\n\\\"\\\"\\\"\nimport gzip\nimport hashlib\nimport json\nimport mmap\nfrom pathlib import Path\nimport posixpath\nimport re\nimport shutil\nimport struct\nimport tarfile\nimport tempfile\n\nSYMBOLS = (\\\"cudaMalloc\\\", \\\"cudaFree\\\", \\\"cudaMallocAsync\\\", \\\"cudaFreeAsync\\\",\n           \\\"cudaMemGetInfo\\\", \\\"cuMemCreate\\\")\n\n\nclass HashReader:\n    # Same streaming adapter as engine_handoff; avoid importing its yaml dependency.\n    def __init__(self, stream):\n        self.stream = stream\n        self.hash = hashlib.sha256()\n\n    def read(self, size=-1):\n        data = self.stream.read(size)\n        self.hash.update(data)\n        return data\n\n    def drain(self):\n        while self.read(1024 * 1024):\n            pass\n        return self.hash.hexdigest()\n\n\ndef archive_name(name):\n    if not isinstance(name, str) or \\\"..\\\" in name.split(\\\"/\\\"):\n        raise ValueError(f\\\"unsafe archive path: {name\"'!r}\")\n    return posixpath.normpath(name.lstrip(\"/\"))\n\n\ndef extract_backend(path, destination, config_id=None):\n    \"\"\"Merge layer metadata, resolve links, then stream only the chosen file out.\n\n    Whiteouts apply to the lower view before same-layer entries, irrespective of\n    tar order. Never extract tar paths or links onto the host filesystem.\n    \"\"\"\n    with tarfile.open(path, \"r:*\") as outer:\n        members = {}\n        for member in outer:\n            name = archive_name(member.name)\n            if name in members:\n                raise ValueError(\"duplicate archive member: \" + name)\n            members[name] = member\n\n        def stream(name):\n            member = members.get(archive_name(name))\n            if member is None or not member.isfile():\n                raise ValueError(\"missing regular archive member: \" + name)\n            return outer.extractfile(member)\n\n        def metadata(name, expected=None):\n            with stream(name) as src:\n                raw = src.read(8 * 1024 * 1024 + 1)\n            if len(raw) > 8 * 1024 * 1024:\n                raise ValueError(\"archive metadata too large: \" + name)\n            digest = \"sha256:\" + hashlib.sha256(raw).hexdigest()\n            if expected is not None and expected != digest:\n                raise ValueError(\"archive metadata SHA-256 mismatch: \" + name)\n            return json.loads(raw), digest\n\n        def blob(digest):\n            if not isinstance(digest, str) or not re.fullmatch(r\"sha256:[0-9a-f]{64}\", digest):\n                raise ValueError(\"unsupported OCI digest: \" + str(digest))\n            return metadata(\"blobs/sha256/\" + digest[7:], digest)[0]\n\n        images, seen = {}, set()\n\n        def visit(desc, depth=0):\n            if depth > 8:\n                raise ValueError(\"OCI index nesting too deep\")\n            if desc.get(\"annotations\", {}).get(\"vnd.docker.reference.type\") == \"attestation-manifest\":\n                return\n            platform = desc.get(\"platform\", {})\n            if platform and (platform.get(\"os\"), platform.get(\"architecture\")) != (\"linux\", \"amd64\"):\n                return\n            digest = desc[\"digest\"]\n            if digest in seen:\n                return\n            seen.add(digest)\n            doc = blob(digest)\n            if \"manifests\" in doc:\n                for child in doc[\"manifests\"]:\n                    visit(child, depth + 1)\n            else:\n                identity = doc[\"config\"][\"digest\"]\n                config = blob(identity)\n                if (config.get(\"os\"), config.get(\"architecture\")) == (\"linux\", \"amd64\"):\n                    layers = [(\"blobs/sha256/\" + d[\"digest\"][7:], d[\"digest\"]) for d in doc[\"layers\"]\n                              if re.fullmatch(r\"sha256:[0-9a-f]{64}\", d[\"digest\"])]\n                    if len(layers) != len(doc[\"layers\"]):\n                        raise ValueError(\"unsupported OCI layer digest\")\n                    if identity in images and images[identity] != (config, layers):\n                        raise ValueError(\"ambiguous image layers\")\n                    images[identity] = (config, layers)\n\n        if \"index.json\" in members:\n            catalog, _ = metadata(\"index.json\")\n            for descriptor in catalog[\"manifests\"]:\n                visit(descriptor)\n        else:\n            manifest, _ = metadata(\"manifest.json\")\n            for entry in manifest:\n                config, identity = metadata(entry[\"Config\"])\n                if (config.get(\"os\"), config.get(\"architecture\")) == (\"linux\", \"amd64\"):\n                    images[identity] = (config, [(name, None) for name in entry[\"Layers\"]])\n        if len(images) != 1 or (config_id is not None and config_id not in images):\n            raise ValueError(\"archive must identify exactly one matching linux/amd64 config\")\n        identity, (config, layers) = next(iter(images.items()))\n        diff_ids = config.get(\"rootfs\", {}).get(\"diff_ids\")\n        if diff_ids is not None and len(diff_ids) != len(layers):\n            raise ValueError(\"config rootfs.diff_ids count differs from layer count\")\n\n        def entries(index, consume):\n            name, expected = layers[index]\n            with stream(name) as src:\n                magic = src.read(2)\n                src.seek(0)\n                raw = HashReader(src)\n                decoded = gzip.GzipFile(fileobj=raw) if magic == b\"'\"\\\\x1f\\\\x8b\\\" else raw\n                unpacked = HashReader(decoded)\n                with tarfile.open(fileobj=unpacked, mode=\\\"r|\\\") as layer:\n                    for number, entry in enumerate(layer):\n                        consume(layer, number, entry)\n                        layer.members.clear()\n                diff_sha = unpacked.drain()\n                blob_sha = raw.drain()\n                if magic == b\\\"\\\\x1f\\\\x8b\\\":\n                    decoded.close()\n            if expected is not None and expected \"'!= \"sha256:\" + blob_sha:\n                raise ValueError(\"layer blob SHA-256 mismatch: \" + name)\n            if diff_ids is not None and diff_ids[index] != \"sha256:\" + diff_sha:\n                raise ValueError(\"layer rootfs.diff_ids SHA-256 mismatch: \" + name)\n\n        view = {}\n\n        def remove(tree, target, children_only=False):\n            for key in list(tree):\n                if (key == target and not children_only) or key.startswith(target.rstrip(\"/\") + \"/\"):\n                    del tree[key]\n\n        for index in range(len(layers)):\n            changes, removals = {}, []\n\n            def merge(layer, number, entry):\n                p = \"/\" + archive_name(entry.name)\n                parent, leaf = posixpath.split(p)\n                if leaf == \".wh..wh..opq\":\n                    removals.append((parent, True))\n                elif leaf.startswith(\".wh.\"):\n                    removals.append((posixpath.join(parent, leaf[4:]), False))\n                else:\n                    # Replacing a non-directory also hides lower descendants.\n                    if not entry.isdir():\n                        removals.append((p, False))\n                        remove(changes, p)\n                    kind = (\"file\" if entry.isfile() else \"symlink\" if entry.issym()\n                            else \"hardlink\" if entry.islnk() else \"dir\" if entry.isdir() else \"other\")\n                    changes[p] = (kind, entry.linkname, index, number)\n\n            entries(index, merge)\n            for target, children_only in removals:\n                remove(view, target, children_only)\n            view.update(changes)\n\n        def resolve(path):\n            visited = set()\n            for _ in range(64):\n                if path in visited:\n                    raise ValueError(\"library symlink cycle: \" + path)\n                visited.add(path)\n                parts = path.strip(\"/\").split(\"/\")\n                for count in range(1, len(parts) + 1):\n                    prefix = \"/\" + \"/\".join(parts[:count])\n                    node = view.get(prefix)\n                    if node is None:\n                        return None\n                    kind, target, _, _ = node\n                    if kind in (\"symlink\", \"hardlink\"):\n                        base = \"/\" if kind == \"hardlink\" else posixpath.dirname(prefix)\n                        path = posixpath.normpath(posixpath.join(base, target, *parts[count:]))\n                        break\n                    if count == len(parts):\n                        return (path, node) if kind == \"file\" else None\n                    if kind != \"dir\":\n                        return None\n                else:\n                    return None\n            raise ValueError(\"library symlink chain too deep\")\n\n        candidates = sorted(p for p in view if re.fullmatch(r\"/app/libggml-cuda'\"\\\\.so(?:\\\\..+)?\\\", p))\n        for candidate in candidates:\n            resolved = resolve(candidate)\n            if resolved is not None:\n                resolved_path, node = resolved\n                output = Path(destination) / \\\"libggml-cuda.so\\\"\n\n                def copy(layer, number, entry):\n                    if number == node[3]:\n                        with layer.extractfile(entry) as src, output.open(\\\"wb\\\") as dst:\n                            shutil.copyfileobj(src, dst, 1024 * 1024)\n\n                entries(node[2], copy)\n                return output, {\\\"library\\\": candidate, \\\"resolved_library\\\": resolved_path,\n                                \\\"image_config_id\\\": identity}\n        raise ValueError(\\\"CUDA backend library not found in merged /app\\\")\n\n\ndef inspect_elf(path):\n    \\\"\\\"\\\"Read SHT_DYNSYM and SHT_DYNAMIC in ELF32/64 of either byte order.\n\n    Section headers survive normal stripping. An ELF without usable dynamic\n    sections is explicitly unavailable, never reported as missing imports.\n    \\\"\\\"\\\"\n    with Path(path).open(\\\"rb\\\") as src:\n        if Path(path).stat().st_size < 16:\n            raise ValueError(\\\"truncated ELF identification\\\")\n        with mmap.mmap(src.fileno(), 0, access=mmap.ACCESS_READ) as data:\n            def unpack(fmt, offset):\n                size = struct.calcsize(fmt)\n                if offset < 0 or offset + size > len(data):\n                    raise ValueError(\\\"ELF structure outside file\\\")\n                return struct.unpack_from(fmt, data, offset)\n\n            if data[:4] \"'!= b\"'\"\\\\x7fELF\\\" or data[4] not in (1, 2) or data[5] not in (1, 2) or data[6] \"'!= 1:\n                raise ValueError(\"unsupported ELF identification\")\n            endian = \"<\" if data[5] == 1 else \">\"\n            wide = data[4] == 2\n            header = unpack(endian + (\"HHIQQQIHHHHHH\" if wide else \"HHIIIIIHHHHHH\"), 16)\n            shoff, shsize, shnum = header[5], header[10], header[11]\n            section_fmt = endian + (\"IIQQQQIIQQ\" if wide else \"IIIIIIIIII\")\n            if not shoff or shsize < struct.calcsize(section_fmt):\n                raise ValueError(\"ELF section headers unavailable\")\n            if shnum == 0:\n                shnum = unpack(section_fmt, shoff)[5]\n            if shnum < 1 or shoff + shsize * shnum > len(data):\n                raise ValueError(\"invalid ELF section table\")\n            sections = [unpack(section_fmt, shoff + i * shsize) for i in range(shnum)]\n\n            def string(section, offset):\n                start, size = section[4], section[5]\n                if section[1] != 3 or start + size > len(data) or not 0 <= offset < size:\n                    raise ValueError(\"invalid ELF string table reference\")\n                end = data.find(b\"'\"\\\\0\\\", start + offset, start + size)\n                if end < 0:\n                    raise ValueError(\\\"unterminated ELF string\\\")\n                return data[start + offset:end].decode(\\\"utf-8\\\", errors=\\\"strict\\\")\n\n            imports, needed, found = set(), [], set()\n            for section in sections:\n                kind, offset, size, link, stride = section[1], section[4], section[5], section[6], section[9]\n                if kind not in (6, 11):  # SHT_DYNAMIC, SHT_DYNSYM\n                    continue\n                found.add(kind)\n                fmt = endian + ((\\\"qQ\\\" if wide else \\\"iI\\\") if kind == 6 else\n                                (\\\"IBBHQQ\\\" if wide else \\\"IIIBBH\\\"))\n                if stride < struct.calcsize(fmt) or size % stride or offset + size > len(data) or link >= shnum:\n                    raise ValueError(\\\"invalid ELF dynamic section\\\")\n                for pos in range(offset, offset + size, stride):\n                    row = unpack(fmt, pos)\n                    if kind == 6:\n                        if row[0] == 0:\n                            break\n                        if row[0] == 1:  # DT_NEEDED\n                            needed.append(string(sections[link], row[1]))\n                    elif row[3 if wide else 5] == 0:  # SHN_UNDEF only\n                        imports.add(string(sections[link], row[0]).split(\\\"@\\\", 1)[0])\n            if found \"'!= {6, 11}:\n                raise ValueError(\"ELF dynamic symbols/dependencies unavailable\")\n            return {\"dt_needed\": needed, \"undefined_imports\": {name: name in imports for name in SYMBOLS},\n                    \"libcudart_dynamic\": any(re.fullmatch(r\"libcudart'\"\\\\.so(?:\\\\..+)?\\\", name) for name in needed)}\n\n\ndef collect_host_linkage(archive, config_id=None, temp_parent=None):\n    result = {\\\"status\\\": \\\"unavailable\\\", \\\"library\\\": None, \\\"resolved_library\\\": None,\n              \\\"dt_needed\\\": None, \\\"libcudart_dynamic\\\": None,\n              \\\"undefined_imports\\\": dict.fromkeys(SYMBOLS),\n              \\\"symbols\\\": {\\\"tool\\\": \\\"python-elf\\\", \\\"location\\\": \\\"host\\\", \\\"returncode\\\": None, \\\"reason\\\": None}}\n    try:\n        with tempfile.TemporaryDirectory(prefix=\\\"linkage-\\\", dir=temp_parent) as temporary:\n            library, evidence = extract_backend(archive, temporary, config_id)\n            result.update(evidence)\n            result.update(inspect_elf(library))\n        result[\\\"status\\\"] = \\\"passed\\\" if result[\\\"libcudart_dynamic\\\"] and result[\\\"undefined_imports\\\"][\\\"cudaMalloc\\\"] else \\\"failed\\\"\n        result[\\\"symbols\\\"][\\\"returncode\\\"] = 0\n    except Exception as exc:\n        result[\\\"reason\\\"] = str(exc)\n        result[\\\"symbols\\\"].update(returncode=1, reason=str(exc))\n    return result\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > cc/build_engine/host_linkage.py <<'PY'\n\\\"\\\"\\\"Offline CUDA ELF inspection; no Docker or host ELF tools required.\n\nLayer streaming, digest checks and whiteout merging follow\ncc/engine_handoff/engine_handoff.py:observe_archive. Only the resolved CUDA\nbackend is copied out, into a caller-owned temporary directory.\n\\\"\\\"\\\"\nimport gzip\nimport hashlib\nimport json\nimport mmap\nfrom pathlib import Path\nimport posixpath\nimport re\nimport shutil\nimport struct\nimport tarfile\nimport tempfile\n\nSYMBOLS = (\\\"cudaMalloc\\\", \\\"cudaFree\\\", \\\"cudaMallocAsync\\\", \\\"cudaFreeAsync\\\",\n           \\\"cudaMemGetInfo\\\", \\\"cuMemCreate\\\")\n\n\nclass HashReader:\n    # Same streaming adapter as engine_handoff; avoid importing its yaml dependency.\n    def __init__(self, stream):\n        self.stream = stream\n        self.hash = hashlib.sha256()\n\n    def read(self, size=-1):\n        data = self.stream.read(size)\n        self.hash.update(data)\n        return data\n\n    def drain(self):\n        while self.read(1024 * 1024):\n            pass\n        return self.hash.hexdigest()\n\n\ndef archive_name(name):\n    if not isinstance(name, str) or \\\"..\\\" in name.split(\\\"/\\\"):\n        raise ValueError(f\\\"unsafe archive path: {name\"'!r}\")\n    return posixpath.normpath(name.lstrip(\"/\"))\n\n\ndef extract_backend(path, destination, config_id=None):\n    \"\"\"Merge layer metadata, resolve links, then stream only the chosen file out.\n\n    Whiteouts apply to the lower view before same-layer entries, irrespective of\n    tar order. Never extract tar paths or links onto the host filesystem.\n    \"\"\"\n    with tarfile.open(path, \"r:*\") as outer:\n        members = {}\n        for member in outer:\n            name = archive_name(member.name)\n            if name in members:\n                raise ValueError(\"duplicate archive member: \" + name)\n            members[name] = member\n\n        def stream(name):\n            member = members.get(archive_name(name))\n            if member is None or not member.isfile():\n                raise ValueError(\"missing regular archive member: \" + name)\n            return outer.extractfile(member)\n\n        def metadata(name, expected=None):\n            with stream(name) as src:\n                raw = src.read(8 * 1024 * 1024 + 1)\n            if len(raw) > 8 * 1024 * 1024:\n                raise ValueError(\"archive metadata too large: \" + name)\n            digest = \"sha256:\" + hashlib.sha256(raw).hexdigest()\n            if expected is not None and expected != digest:\n                raise ValueError(\"archive metadata SHA-256 mismatch: \" + name)\n            return json.loads(raw), digest\n\n        def blob(digest):\n            if not isinstance(digest, str) or not re.fullmatch(r\"sha256:[0-9a-f]{64}\", digest):\n                raise ValueError(\"unsupported OCI digest: \" + str(digest))\n            return metadata(\"blobs/sha256/\" + digest[7:], digest)[0]\n\n        images, seen = {}, set()\n\n        def visit(desc, depth=0):\n            if depth > 8:\n                raise ValueError(\"OCI index nesting too deep\")\n            if desc.get(\"annotations\", {}).get(\"vnd.docker.reference.type\") == \"attestation-manifest\":\n                return\n            platform = desc.get(\"platform\", {})\n            if platform and (platform.get(\"os\"), platform.get(\"architecture\")) != (\"linux\", \"amd64\"):\n                return\n            digest = desc[\"digest\"]\n            if digest in seen:\n                return\n            seen.add(digest)\n            doc = blob(digest)\n            if \"manifests\" in doc:\n                for child in doc[\"manifests\"]:\n                    visit(child, depth + 1)\n            else:\n                identity = doc[\"config\"][\"digest\"]\n                config = blob(identity)\n                if (config.get(\"os\"), config.get(\"architecture\")) == (\"linux\", \"amd64\"):\n                    layers = [(\"blobs/sha256/\" + d[\"digest\"][7:], d[\"digest\"]) for d in doc[\"layers\"]\n                              if re.fullmatch(r\"sha256:[0-9a-f]{64}\", d[\"digest\"])]\n                    if len(layers) != len(doc[\"layers\"]):\n                        raise ValueError(\"unsupported OCI layer digest\")\n                    if identity in images and images[identity] != (config, layers):\n                        raise ValueError(\"ambiguous image layers\")\n                    images[identity] = (config, layers)\n\n        if \"index.json\" in members:\n            catalog, _ = metadata(\"index.json\")\n            for descriptor in catalog[\"manifests\"]:\n                visit(descriptor)\n        else:\n            manifest, _ = metadata(\"manifest.json\")\n            for entry in manifest:\n                config, identity = metadata(entry[\"Config\"])\n                if (config.get(\"os\"), config.get(\"architecture\")) == (\"linux\", \"amd64\"):\n                    images[identity] = (config, [(name, None) for name in entry[\"Layers\"]])\n        if len(images) != 1 or (config_id is not None and config_id not in images):\n            raise ValueError(\"archive must identify exactly one matching linux/amd64 config\")\n        identity, (config, layers) = next(iter(images.items()))\n        diff_ids = config.get(\"rootfs\", {}).get(\"diff_ids\")\n        if diff_ids is not None and len(diff_ids) != len(layers):\n            raise ValueError(\"config rootfs.diff_ids count differs from layer count\")\n\n        def entries(index, consume):\n            name, expected = layers[index]\n            with stream(name) as src:\n                magic = src.read(2)\n                src.seek(0)\n                raw = HashReader(src)\n                decoded = gzip.GzipFile(fileobj=raw) if magic == b\"'\"\\\\x1f\\\\x8b\\\" else raw\n                unpacked = HashReader(decoded)\n                with tarfile.open(fileobj=unpacked, mode=\\\"r|\\\") as layer:\n                    for number, entry in enumerate(layer):\n                        consume(layer, number, entry)\n                        layer.members.clear()\n                diff_sha = unpacked.drain()\n                blob_sha = raw.drain()\n                if magic == b\\\"\\\\x1f\\\\x8b\\\":\n                    decoded.close()\n            if expected is not None and expected \"'!= \"sha256:\" + blob_sha:\n                raise ValueError(\"layer blob SHA-256 mismatch: \" + name)\n            if diff_ids is not None and diff_ids[index] != \"sha256:\" + diff_sha:\n                raise ValueError(\"layer rootfs.diff_ids SHA-256 mismatch: \" + name)\n\n        view = {}\n\n        def remove(tree, target, children_only=False):\n            for key in list(tree):\n                if (key == target and not children_only) or key.startswith(target.rstrip(\"/\") + \"/\"):\n                    del tree[key]\n\n        for index in range(len(layers)):\n            changes, removals = {}, []\n\n            def merge(layer, number, entry):\n                p = \"/\" + archive_name(entry.name)\n                parent, leaf = posixpath.split(p)\n                if leaf == \".wh..wh..opq\":\n                    removals.append((parent, True))\n                elif leaf.startswith(\".wh.\"):\n                    removals.append((posixpath.join(parent, leaf[4:]), False))\n                else:\n                    # Replacing a non-directory also hides lower descendants.\n                    if not entry.isdir():\n                        removals.append((p, False))\n                        remove(changes, p)\n                    kind = (\"file\" if entry.isfile() else \"symlink\" if entry.issym()\n                            else \"hardlink\" if entry.islnk() else \"dir\" if entry.isdir() else \"other\")\n                    changes[p] = (kind, entry.linkname, index, number)\n\n            entries(index, merge)\n            for target, children_only in removals:\n                remove(view, target, children_only)\n            view.update(changes)\n\n        def resolve(path):\n            visited = set()\n            for _ in range(64):\n                if path in visited:\n                    raise ValueError(\"library symlink cycle: \" + path)\n                visited.add(path)\n                parts = path.strip(\"/\").split(\"/\")\n                for count in range(1, len(parts) + 1):\n                    prefix = \"/\" + \"/\".join(parts[:count])\n                    node = view.get(prefix)\n                    if node is None:\n                        return None\n                    kind, target, _, _ = node\n                    if kind in (\"symlink\", \"hardlink\"):\n                        base = \"/\" if kind == \"hardlink\" else posixpath.dirname(prefix)\n                        path = posixpath.normpath(posixpath.join(base, target, *parts[count:]))\n                        break\n                    if count == len(parts):\n                        return (path, node) if kind == \"file\" else None\n                    if kind != \"dir\":\n                        return None\n                else:\n                    return None\n            raise ValueError(\"library symlink chain too deep\")\n\n        candidates = sorted(p for p in view if re.fullmatch(r\"/app/libggml-cuda'\"\\\\.so(?:\\\\..+)?\\\", p))\n        for candidate in candidates:\n            resolved = resolve(candidate)\n            if resolved is not None:\n                resolved_path, node = resolved\n                output = Path(destination) / \\\"libggml-cuda.so\\\"\n\n                def copy(layer, number, entry):\n                    if number == node[3]:\n                        with layer.extractfile(entry) as src, output.open(\\\"wb\\\") as dst:\n                            shutil.copyfileobj(src, dst, 1024 * 1024)\n\n                entries(node[2], copy)\n                return output, {\\\"library\\\": candidate, \\\"resolved_library\\\": resolved_path,\n                                \\\"image_config_id\\\": identity}\n        raise ValueError(\\\"CUDA backend library not found in merged /app\\\")\n\n\ndef inspect_elf(path):\n    \\\"\\\"\\\"Read SHT_DYNSYM and SHT_DYNAMIC in ELF32/64 of either byte order.\n\n    Section headers survive normal stripping. An ELF without usable dynamic\n    sections is explicitly unavailable, never reported as missing imports.\n    \\\"\\\"\\\"\n    with Path(path).open(\\\"rb\\\") as src:\n        if Path(path).stat().st_size < 16:\n            raise ValueError(\\\"truncated ELF identification\\\")\n        with mmap.mmap(src.fileno(), 0, access=mmap.ACCESS_READ) as data:\n            def unpack(fmt, offset):\n                size = struct.calcsize(fmt)\n                if offset < 0 or offset + size > len(data):\n                    raise ValueError(\\\"ELF structure outside file\\\")\n                return struct.unpack_from(fmt, data, offset)\n\n            if data[:4] \"'!= b\"'\"\\\\x7fELF\\\" or data[4] not in (1, 2) or data[5] not in (1, 2) or data[6] \"'!= 1:\n                raise ValueError(\"unsupported ELF identification\")\n            endian = \"<\" if data[5] == 1 else \">\"\n            wide = data[4] == 2\n            header = unpack(endian + (\"HHIQQQIHHHHHH\" if wide else \"HHIIIIIHHHHHH\"), 16)\n            shoff, shsize, shnum = header[5], header[10], header[11]\n            section_fmt = endian + (\"IIQQQQIIQQ\" if wide else \"IIIIIIIIII\")\n            if not shoff or shsize < struct.calcsize(section_fmt):\n                raise ValueError(\"ELF section headers unavailable\")\n            if shnum == 0:\n                shnum = unpack(section_fmt, shoff)[5]\n            if shnum < 1 or shoff + shsize * shnum > len(data):\n                raise ValueError(\"invalid ELF section table\")\n            sections = [unpack(section_fmt, shoff + i * shsize) for i in range(shnum)]\n\n            def string(section, offset):\n                start, size = section[4], section[5]\n                if section[1] != 3 or start + size > len(data) or not 0 <= offset < size:\n                    raise ValueError(\"invalid ELF string table reference\")\n                end = data.find(b\"'\"\\\\0\\\", start + offset, start + size)\n                if end < 0:\n                    raise ValueError(\\\"unterminated ELF string\\\")\n                return data[start + offset:end].decode(\\\"utf-8\\\", errors=\\\"strict\\\")\n\n            imports, needed, found = set(), [], set()\n            for section in sections:\n                kind, offset, size, link, stride = section[1], section[4], section[5], section[6], section[9]\n                if kind not in (6, 11):  # SHT_DYNAMIC, SHT_DYNSYM\n                    continue\n                found.add(kind)\n                fmt = endian + ((\\\"qQ\\\" if wide else \\\"iI\\\") if kind == 6 else\n                                (\\\"IBBHQQ\\\" if wide else \\\"IIIBBH\\\"))\n                if stride < struct.calcsize(fmt) or size % stride or offset + size > len(data) or link >= shnum:\n                    raise ValueError(\\\"invalid ELF dynamic section\\\")\n                for pos in range(offset, offset + size, stride):\n                    row = unpack(fmt, pos)\n                    if kind == 6:\n                        if row[0] == 0:\n                            break\n                        if row[0] == 1:  # DT_NEEDED\n                            needed.append(string(sections[link], row[1]))\n                    elif row[3 if wide else 5] == 0:  # SHN_UNDEF only\n                        imports.add(string(sections[link], row[0]).split(\\\"@\\\", 1)[0])\n            if found \"'!= {6, 11}:\n                raise ValueError(\"ELF dynamic symbols/dependencies unavailable\")\n            return {\"dt_needed\": needed, \"undefined_imports\": {name: name in imports for name in SYMBOLS},\n                    \"libcudart_dynamic\": any(re.fullmatch(r\"libcudart'\"\\\\.so(?:\\\\..+)?\\\", name) for name in needed)}\n\n\ndef collect_host_linkage(archive, config_id=None, temp_parent=None):\n    result = {\\\"status\\\": \\\"unavailable\\\", \\\"library\\\": None, \\\"resolved_library\\\": None,\n              \\\"dt_needed\\\": None, \\\"libcudart_dynamic\\\": None,\n              \\\"undefined_imports\\\": dict.fromkeys(SYMBOLS),\n              \\\"symbols\\\": {\\\"tool\\\": \\\"python-elf\\\", \\\"location\\\": \\\"host\\\", \\\"returncode\\\": None, \\\"reason\\\": None}}\n    try:\n        with tempfile.TemporaryDirectory(prefix=\\\"linkage-\\\", dir=temp_parent) as temporary:\n            library, evidence = extract_backend(archive, temporary, config_id)\n            result.update(evidence)\n            result.update(inspect_elf(library))\n        result[\\\"status\\\"] = \\\"passed\\\" if result[\\\"libcudart_dynamic\\\"] and result[\\\"undefined_imports\\\"][\\\"cudaMalloc\\\"] else \\\"failed\\\"\n        result[\\\"symbols\\\"][\\\"returncode\\\"] = 0\n    except Exception as exc:\n        result[\\\"reason\\\"] = str(exc)\n        result[\\\"symbols\\\"].update(returncode=1, reason=str(exc))\n    return result\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
