+// Q4_K MUL_MAT_ID curve with pageable host weights and selected-expert uploads.
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <numeric>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static void require(bool ok, const char * what) {
+    if (!ok) { throw std::runtime_error(what); }
+}
+struct tensors {
+    ggml_context * ctx;
+    ggml_backend_buffer_t buf = nullptr;
+    tensors() {
+        ggml_init_params p = {ggml_tensor_overhead() * 32 + ggml_graph_overhead_custom(32, false), nullptr, true};
+        ctx = ggml_init(p);
+        require(ctx != nullptr, "ggml_init failed");
+    }
+    void alloc(ggml_backend_t backend) {
+        buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        require(buf != nullptr, "allocation failed");
+    }
+    ~tensors() {
+        if (buf) { ggml_backend_buffer_free(buf); }
+        ggml_free(ctx);
+    }
+    tensors(const tensors &) = delete;
+    tensors & operator=(const tensors &) = delete;
+};
+struct op_graph : tensors {
+    ggml_tensor * b;
+    ggml_tensor * ids;
+    ggml_tensor * out;
+    ggml_cgraph * graph;
+    op_graph(ggml_backend_t backend, ggml_tensor * a, int channels, int n) {
+        b = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, a->ne[0], channels, n);
+        ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 8, n);
+        out = ggml_mul_mat_id(ctx, a, b, ids);
+        require(ggml_backend_supports_op(backend, out), "backend does not support this MUL_MAT_ID");
+        graph = ggml_new_graph_custom(ctx, 32, false);
+        ggml_build_forward_expand(graph, out);
+        alloc(backend);
+    }
+};
+static void compute(ggml_backend_t backend, ggml_cgraph * graph) {
+    require(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "graph compute failed");
+    ggml_backend_synchronize(backend);
+}
+template<class F> static double median_ms(F f) {
+    std::array<double, 3> times;
+    for (double & t : times) {
+        const auto start = std::chrono::steady_clock::now();
+        f();
+        t = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+    }
+    std::sort(times.begin(), times.end());
+    return times[1];
+}
+struct upload_range { size_t offset, bytes; };
+static std::vector<upload_range> ranges(const ggml_tensor * a, const std::vector<int32_t> & ids, int & selected) {
+    std::array<bool, 256> used{};
+    for (int id : ids) { require(id >= 0 && id < 256, "invalid id"); used[id] = true; }
+    selected = std::count(used.begin(), used.end(), true);
+    std::vector<upload_range> result;
+    for (int first = 0; first < 256;) {
+        if (!used[first]) { ++first; continue; }
+        int last = first;
+        while (last + 1 < 256 && used[last + 1]) { ++last; }
+        const size_t padding = last < 255 ? std::min<size_t>(a->nb[2], 512) : 0;
+        result.push_back({first * a->nb[2], (last + 1 - first) * a->nb[2] + padding});
+        first = last + 1;
+    }
+    return result;
+}
+static void run_shape(ggml_backend_t cpu, ggml_backend_t gpu, const char * shape,
+                      int k, int m, int channels, bool smoke) {
+    tensors weights_cpu;
+    auto * a_cpu = ggml_new_tensor_3d(weights_cpu.ctx, GGML_TYPE_Q4_K, k, m, 256);
+    weights_cpu.alloc(cpu);
+    ggml_backend_buffer_set_usage(weights_cpu.buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    std::mt19937 rng(19);
+    std::uniform_real_distribution<float> uniform(-0.5f, 0.5f);
+    std::vector<float> one_expert(size_t(k) * m);
+    for (auto & x : one_expert) { x = uniform(rng); }
+    const size_t quantized = ggml_quantize_chunk(GGML_TYPE_Q4_K, one_expert.data(), a_cpu->data, 0, m, k, nullptr);
+    require(quantized == a_cpu->nb[2], "unexpected Q4_K expert size");
+    for (int e = 1; e < 256; ++e) {
+        std::memcpy(static_cast<char *>(a_cpu->data) + e * a_cpu->nb[2], a_cpu->data, a_cpu->nb[2]);
+    }
+    tensors weights_gpu;
+    ggml_tensor * a_gpu = nullptr;
+    if (gpu) {
+        a_gpu = ggml_new_tensor_3d(weights_gpu.ctx, GGML_TYPE_Q4_K, k, m, 256);
+        weights_gpu.alloc(gpu);
+        ggml_backend_buffer_set_usage(weights_gpu.buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        ggml_backend_tensor_memset(a_gpu, 0, 0, ggml_nbytes(a_gpu));
+    }
+    std::array<int32_t, 256> perm;
+    std::iota(perm.begin(), perm.end(), 0);
+    std::vector<int32_t> router_stream(8 * 512);
+    for (int t = 0; t < 512; ++t) {
+        std::shuffle(perm.begin(), perm.end(), rng);
+        std::copy_n(perm.begin(), 8, router_stream.begin() + 8 * t);
+    }
+    for (int n : {1, 2, 4, 8, 16, 32, 64, 128, 512}) {
+        if (smoke && n != 1) { continue; }
+        op_graph c(cpu, a_cpu, channels, n);
+        std::vector<int32_t> ids(router_stream.begin(), router_stream.begin() + 8 * n);
+        std::vector<float> activation(ggml_nelements(c.b));
+        for (auto & x : activation) { x = uniform(rng); }
+        ggml_backend_tensor_set(c.b, activation.data(), 0, ggml_nbytes(c.b));
+        ggml_backend_tensor_set(c.ids, ids.data(), 0, ggml_nbytes(c.ids));
+        compute(cpu, c.graph);
+        const double cpu_ms = median_ms([&] { compute(cpu, c.graph); });
+        int selected = 0;
+        const auto uploads = ranges(a_cpu, ids, selected);
+        size_t upload_bytes = 0;
+        for (auto r : uploads) { upload_bytes += r.bytes; }
+        double gpu_ms = -1, staged_ms = -1, cpu_boundary_ms = -1, nmse = -1;
+        if (gpu) {
+            op_graph g(gpu, a_gpu, channels, n);
+            ggml_backend_tensor_set(g.b, activation.data(), 0, ggml_nbytes(g.b));
+            ggml_backend_tensor_set(g.ids, ids.data(), 0, ggml_nbytes(g.ids));
+            auto upload = [&] {
+                for (auto r : uploads) {
+                    ggml_backend_tensor_set_async(gpu, a_gpu, static_cast<const char *>(a_cpu->data) + r.offset, r.offset, r.bytes);
+                }
+            };
+            upload();
+            compute(gpu, g.graph);
+            const size_t out_bytes = ggml_nbytes(c.out);
+            std::vector<float> reference(ggml_nelements(c.out)), actual(reference.size());
+            ggml_backend_tensor_get(c.out, reference.data(), 0, out_bytes);
+            ggml_backend_tensor_get(g.out, actual.data(), 0, out_bytes);
+            double err = 0, norm = 0;
+            for (size_t i = 0; i < reference.size(); ++i) {
+                err += std::pow(double(actual[i]) - reference[i], 2);
+                norm += double(reference[i]) * reference[i];
+            }
+            nmse = err / std::max(norm, 1e-30);
+            require(std::isfinite(nmse) && nmse < 5e-4, "CPU/GPU NMSE exceeds 5e-4");
+            gpu_ms = median_ms([&] { compute(gpu, g.graph); });
+            std::vector<int32_t> router(ids.size());
+            // This includes the callback's GPU router readback, dedup, upload and compute.
+            staged_ms = median_ms([&] {
+                ggml_backend_tensor_get_async(gpu, g.ids, router.data(), 0, ggml_nbytes(g.ids));
+                ggml_backend_synchronize(gpu);
+                int count;
+                const auto current = ranges(a_cpu, router, count);
+                for (auto r : current) {
+                    ggml_backend_tensor_set_async(gpu, a_gpu, static_cast<const char *>(a_cpu->data) + r.offset, r.offset, r.bytes);
+                }
+                compute(gpu, g.graph);
+            });
+            // CPU expert boundary: GPU activations/ids in, GPU result out.
+            cpu_boundary_ms = median_ms([&] {
+                ggml_backend_tensor_get_async(gpu, g.b, c.b->data, 0, ggml_nbytes(c.b));
+                ggml_backend_tensor_get_async(gpu, g.ids, c.ids->data, 0, ggml_nbytes(c.ids));
+                ggml_backend_synchronize(gpu);
+                compute(cpu, c.graph);
+                ggml_backend_tensor_set_async(gpu, g.out, c.out->data, 0, out_bytes);
+                ggml_backend_synchronize(gpu);
+            });
+        }
+        std::printf("%s,%d,%d,%d,%zu,%d,%zu,%zu,%.6f,%.6f,%.6f,%.6f,%.8g\n",
+                    shape, k, m, n, size_t(channels), selected, uploads.size(), upload_bytes,
+                    cpu_ms, cpu_boundary_ms, gpu_ms, staged_ms, nmse);
+        std::fflush(stdout);
+    }
+}
+int main(int argc, char ** argv) {
+    ggml_backend_t cpu = nullptr, gpu = nullptr;
+    try {
+        bool cpu_only = false, smoke = false;
+        int threads = 6;
+        for (int i = 1; i < argc; ++i) {
+            const std::string arg = argv[i];
+            if (arg == "--cpu-only") { cpu_only = true; }
+            else if (arg == "--smoke") { smoke = true; }
+            else if (arg == "--threads" && i + 1 < argc) { threads = std::stoi(argv[++i]); }
+            else { throw std::runtime_error("usage: expert-crossover [--cpu-only] [--smoke] [--threads 6]"); }
+        }
+        require(threads > 0 && threads <= 64, "invalid thread count");
+        ggml_backend_load_all();
+        cpu = ggml_backend_cpu_init();
+        require(cpu != nullptr, "CPU backend unavailable");
+        ggml_backend_cpu_set_n_threads(cpu, threads);
+        if (!cpu_only) {
+            gpu = ggml_backend_init_by_name("CUDA0", nullptr);
+            require(gpu != nullptr, "CUDA0 unavailable (use --cpu-only for local validation)");
+        }
+        std::fprintf(stderr, "expert-crossover threads=%d ids=seed19_uniform_top8 reps=3 warm_pageable_weights=1\n", threads);
+        std::puts("shape,k,m,n_tokens,activation_channels,selected,copies,upload_bytes,cpu_ms,cpu_boundary_ms,gpu_resident_ms,gpu_staged_ms,nmse");
+        run_shape(cpu, gpu, "up_gate", 2048, 512, 1, smoke);
+        run_shape(cpu, gpu, "down", 512, 2048, 8, smoke);
+        if (gpu) { ggml_backend_free(gpu); }
+        ggml_backend_free(cpu);
+        ggml_quantize_free();
+        return 0;
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "expert-crossover: %s\n", e.what());
+        if (gpu) { ggml_backend_free(gpu); }
+        if (cpu) { ggml_backend_free(cpu); }
+        return 1;
+    }
+}
diff --git a//home/muk/projects/xs-dev/placement/operator_common.sh b//home/muk/projects/xs-dev/placement/operator_common.sh
new file mode 100644
index 0000000000000000000000000000000000000000..eb4128272c4b948b8c69d6c9a0968a03ff312637
--- /dev/null
+++ b//home/muk/projects/xs-dev/placement/operator_common.sh
@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+# Shared by operator scripts; never executes a GPU job when sourced.
+set -euo pipefail
+F19_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+F19_LLAMA=${F19_LLAMA:-$(dirname "$F19_ROOT")/llama-place}
+F19_RESULTS=${F19_RESULTS:-$F19_ROOT/results}
+F19_MODEL_DIR=${F19_MODEL_DIR:-$HOME/models/campaign/qwen36-35b-a3b}
+F19_MODEL=${F19_MODEL:-Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf}
+F19_LAB=${F19_LAB:-/home/muk/projects/siminfeng}
+F19_PIN=6e9d96cf4e007c74aab91bb59767247737a80f0f
+
+require_job() {
+    [[ -n ${JOBQ_JOB_ID:-} ]] || { echo 'Submit through bin/jobq; JOBQ_JOB_ID is missing.' >&2; exit 2; }
+}
+require_image() {
+    : "${F19_IMAGE:?Set F19_IMAGE to the CUDA 12.6 engine image verified against the pin.}"
+}
+check_source() {
+    [[ $(git -C "$F19_LLAMA" rev-parse HEAD) == "$F19_PIN" ]] || { echo 'Wrong llama-place commit' >&2; exit 2; }
+    git -C "$F19_LLAMA" diff --exit-code --quiet -- ggml src common
+}
+new_output() {
+    OUT=$F19_RESULTS/$1
+    mkdir -p "$F19_RESULTS"
+    mkdir "$OUT" || { echo "Output already exists: $OUT (use a fresh F19_RESULTS)." >&2; exit 2; }
+    printf '%s\n' "$JOBQ_JOB_ID" > "$OUT/job-id.txt"
+    cp /proc/meminfo "$OUT/meminfo.before.txt"
+}
+engine_container() {
+    local command
+    # %q preserves each argv element through sg's single command-string argument.
+    printf -v command '%q ' docker run --rm --runtime nvidia --network none \
+        --user "$(id -u):$(id -g)" --entrypoint /bin/bash \
+        -v "$F19_ROOT:/placement:ro" -v "$OUT:/out:rw" \
+        -v "$F19_MODEL_DIR:/om:ro" "$F19_IMAGE" "$@"
+    printf '%s\n' "$command" > "$OUT/container-command.txt"
+    sg docker -c "$command"
+}
diff --git a//home/muk/projects/xs-dev/placement/probe_uma.cu b//home/muk/projects/xs-dev/placement/probe_uma.cu
new file mode 100644
index 0000000000000000000000000000000000000000..faca2de24ee3ec8489a5aaf1b6ba83a827ebabe3
--- /dev/null
+++ b//home/muk/projects/xs-dev/placement/probe_uma.cu
@@ -0,0 +1,179 @@
+// Read-only, bounded UMA probe. Run on the operator's exclusive GPU queue.
+#include <cuda_runtime.h>
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <stdexcept>
+#include <string>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <vector>
+
+using clock_type = std::chrono::steady_clock;
+static double ms(clock_type::time_point start) {
+    return std::chrono::duration<double, std::milli>(clock_type::now() - start).count();
+}
+static void check(cudaError_t e) {
+    if (e != cudaSuccess) { throw std::runtime_error(cudaGetErrorString(e)); }
+}
+__global__ void read_all(const volatile uint32_t * p, size_t words, unsigned long long * out) {
+    unsigned long long v = 0;
+    for (size_t i = blockIdx.x * blockDim.x + threadIdx.x; i < words; i += size_t(gridDim.x) * blockDim.x) {
+        v += p[i];
+    }
+    __shared__ unsigned long long sums[256];
+    sums[threadIdx.x] = v;
+    __syncthreads();
+    for (unsigned s = 128; s; s >>= 1) {
+        if (threadIdx.x < s) { sums[threadIdx.x] += sums[threadIdx.x + s]; }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) { out[blockIdx.x] = sums[0]; }
+}
+static int attribute(const char * name, cudaDeviceAttr attr) {
+    int value = -1;
+    cudaError_t e = cudaDeviceGetAttribute(&value, attr, 0);
+    if (e != cudaSuccess) { (void) cudaGetLastError(); }
+    std::printf("# %s=%d\n", name, value);
+    return value;
+}
+static void skip(const char * kind, const char * reason, double setup_ms = 0) {
+    std::printf("%s\tSKIP:%s\t%.6f\t0\t0\t0\t0\n", kind, reason, setup_ms);
+}
+static void bench(const char * kind, const void * p, size_t bytes, double setup_ms,
+                  unsigned long long expected, unsigned long long * out) {
+    const unsigned blocks = 256;
+    cudaEvent_t a, b;
+    check(cudaEventCreate(&a));
+    check(cudaEventCreate(&b));
+    std::vector<float> times;
+    for (int r = 0; r < 21; ++r) {
+        check(cudaEventRecord(a));
+        read_all<<<blocks, 256>>>(static_cast<const volatile uint32_t *>(p), bytes / 4, out);
+        check(cudaGetLastError());
+        check(cudaEventRecord(b));
+        check(cudaEventSynchronize(b));
+        float elapsed;
+        check(cudaEventElapsedTime(&elapsed, a, b));
+        times.push_back(elapsed);
+    }
+    std::vector<unsigned long long> sums(blocks);
+    check(cudaMemcpy(sums.data(), out, blocks * sizeof(*out), cudaMemcpyDeviceToHost));
+    unsigned long long sum = 0;
+    for (auto v : sums) { sum += v; }
+    if (sum != expected) { throw std::runtime_error("checksum mismatch"); }
+    const double first = times.front();
+    std::sort(times.begin() + 1, times.end());
+    const double warm = (times[10] + times[11]) / 2;
+    std::printf("%s\tOK\t%.6f\t%.6f\t%.6f\t%.6f\t%llu\n",
+                kind, setup_ms, first, warm, bytes / (warm * 1e-3) / (1ULL << 30), sum);
+    check(cudaEventDestroy(a));
+    check(cudaEventDestroy(b));
+}
+int main(int argc, char ** argv) {
+    try {
+        if (argc < 2 || argc > 4) {
+            std::fprintf(stderr, "usage: probe_uma FILE [BYTES=67108864] [PAGE_ALIGNED_OFFSET=0]\n");
+            return 2;
+        }
+        const size_t bytes = argc > 2 ? std::stoull(argv[2]) : 64ULL << 20;
+        const off_t offset = argc > 3 ? std::stoull(argv[3]) : 0;
+        const size_t page = size_t(sysconf(_SC_PAGESIZE));
+        if (!bytes || bytes > (256ULL << 20) || bytes % page || offset < 0 || size_t(offset) % page) {
+            throw std::runtime_error("require page-aligned bytes/offset and 0 < bytes <= 256 MiB");
+        }
+        check(cudaSetDeviceFlags(cudaDeviceMapHost));
+        check(cudaSetDevice(0));
+        cudaDeviceProp prop;
+        check(cudaGetDeviceProperties(&prop, 0));
+        int runtime, driver;
+        check(cudaRuntimeGetVersion(&runtime));
+        check(cudaDriverGetVersion(&driver));
+        std::printf("# device=%s cc=%d.%d runtime=%d driver=%d bytes=%zu offset=%lld\n",
+                    prop.name, prop.major, prop.minor, runtime, driver, bytes, (long long) offset);
+        const int pageable = attribute("pageableMemoryAccess", cudaDevAttrPageableMemoryAccess);
+        attribute("pageableMemoryAccessUsesHostPageTables", cudaDevAttrPageableMemoryAccessUsesHostPageTables);
+        attribute("concurrentManagedAccess", cudaDevAttrConcurrentManagedAccess);
+        attribute("canUseHostPointerForRegisteredMem", cudaDevAttrCanUseHostPointerForRegisteredMem);
+        attribute("integrated", cudaDevAttrIntegrated);
+        const int mapped = attribute("canMapHostMemory", cudaDevAttrCanMapHostMemory);
+        const int registered = attribute("hostRegisterSupported", cudaDevAttrHostRegisterSupported);
+        const int readonly = attribute("hostRegisterReadOnlySupported", cudaDevAttrHostRegisterReadOnlySupported);
+        std::puts("kind\tstatus\tsetup_ms\tfirst_read_ms\twarm_median_ms\twarm_GiB_s\tchecksum");
+        const int fd = open(argv[1], O_RDONLY);
+        if (fd < 0) { throw std::runtime_error("open FILE failed"); }
+        struct stat st;
+        if (fstat(fd, &st) || uint64_t(offset) > uint64_t(st.st_size) || bytes > uint64_t(st.st_size) - uint64_t(offset)) {
+            throw std::runtime_error("file range outside FILE");
+        }
+        auto start = clock_type::now();
+        void * file = mmap(nullptr, bytes, PROT_READ, MAP_SHARED, fd, offset);
+        close(fd);
+        if (file == MAP_FAILED) { throw std::runtime_error("mmap failed"); }
+        unsigned long long expected = 0;
+        const auto * words = static_cast<const uint32_t *>(file);
+        for (size_t i = 0; i < bytes / 4; ++i) { expected += words[i]; }
+        std::printf("# mmap_and_cpu_prefault_ms=%.6f checksum=%llu\n", ms(start), expected);
+        unsigned long long * out = nullptr;
+        check(cudaMalloc(&out, 256 * sizeof(*out)));
+
+        void * device = nullptr;
+        start = clock_type::now();
+        check(cudaMalloc(&device, bytes));
+        check(cudaMemcpy(device, file, bytes, cudaMemcpyHostToDevice));
+        check(cudaDeviceSynchronize());
+        bench("cudaMalloc", device, bytes, ms(start), expected, out);
+        check(cudaFree(device));
+
+        if (registered == 1 && readonly == 1 && mapped == 1) {
+            start = clock_type::now();
+            const cudaError_t e = cudaHostRegister(file, bytes, cudaHostRegisterMapped | cudaHostRegisterReadOnly);
+            if (e == cudaSuccess) {
+                void * alias = nullptr;
+                const cudaError_t alias_e = cudaHostGetDevicePointer(&alias, file, 0);
+                if (alias_e == cudaSuccess) {
+                    bench("registered_ro_mmap", alias, bytes, ms(start), expected, out);
+                } else {
+                    skip("registered_ro_mmap", cudaGetErrorName(alias_e), ms(start));
+                    (void) cudaGetLastError();
+                }
+                check(cudaHostUnregister(file));
+            } else {
+                skip("registered_ro_mmap", cudaGetErrorName(e), ms(start));
+                (void) cudaGetLastError();
+            }
+        } else { skip("registered_ro_mmap", "missing_registration_readonly_or_mapping_attribute"); }
+
+        if (mapped == 1) {
+            void * pinned = nullptr;
+            start = clock_type::now();
+            check(cudaMallocHost(&pinned, bytes));
+            std::memcpy(pinned, file, bytes);
+            void * alias = nullptr;
+            check(cudaHostGetDevicePointer(&alias, pinned, 0));
+            bench("cudaMallocHost", alias, bytes, ms(start), expected, out);
+            check(cudaFreeHost(pinned));
+        } else { skip("cudaMallocHost", "canMapHostMemory_is_not_1"); }
+
+        if (pageable == 1) {
+            start = clock_type::now();
+            void * plain = std::malloc(bytes);
+            if (!plain) { throw std::bad_alloc(); }
+            std::memcpy(plain, file, bytes);
+            bench("pageable_malloc_direct", plain, bytes, ms(start), expected, out);
+            std::free(plain);
+            bench("pageable_ro_mmap_direct", file, bytes, 0, expected, out);
+        } else { skip("pageable_malloc_direct", "pageableMemoryAccess_is_not_1"); }
+        check(cudaFree(out));
+        munmap(file, bytes);
+        return 0;
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "probe_uma: %s\n", e.what());
+        return 1;
+    }
+}
diff --git a//home/muk/projects/xs-dev/placement/run_build.sh b//home/muk/projects/xs-dev/placement/run_build.sh
