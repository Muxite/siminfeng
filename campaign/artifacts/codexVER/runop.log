e.findall(r'(\\\\d+)/(\\\\d+) tests passed', block[1])\n        require(len(counts) == 1, 'missing or ambiguous backend pass count')\n        passed, total = map(int, counts[0])\n        operation_lines = re.findall(r'\"'^'\"\\\\s+([A-Z_0-9]+)\\\\(.*\\\\):\\\\s*(\\\\S+)\\\\s*\"'$'\"', block[1], re.M)\n        require(total > 0 and len(operation_lines) == total, 'backend operation coverage mismatch')\n        value = passed == total and all(op == c['operation'] and status == 'OK' for op, status in operation_lines)\n        value = value and bool(re.search(r'Backend ' + backend + r': OK', block[1]))\n        ev = [dict(info, job=c['job'], attempt=c['attempt'], backend=c['backend'], operation=c['operation'],\n                   passed=passed, total=total, association='legacy sidecar associated by criteria; not a lab test')]\n    else:\n        require(metric in METRICS, f'unknown metric: {metric}')\n        value, sample = records.metric(c['candidate'], metric)\n        ev.append(sample)\n        mode = c.get('mode', 'value')\n        if mode \"'!= '\"'value':\n            baseline, sample = records.metric(c['baseline'], metric)\n            ev.append(sample)\n            if mode in ('delta_pct', 'abs_delta_pct'):\n                require(baseline > 0, 'percentage baseline must be positive')\n                value = 100 * (value / baseline - 1)\n                if mode == 'abs_delta_pct':\n                    value = abs(value)\n            elif mode == 'abs_delta':\n                value = abs(value - baseline)\n            else:\n                raise EvidenceError(f'unknown mode: {mode}')\n        if 'alternating' in c:\n            schedule = c['alternating']\n            require(c['candidate']['job'] == c['baseline']['job'] and\n                    c['candidate']['attempt'] == c['baseline']['attempt'], 'alternating comparison must use same attempt')\n            _, _, tests, _ = records.job(c['candidate']['job'], c['candidate']['attempt'])\n            group = schedule['group']\n            require(len(group) == len(set(group)) and len(group) >= 2, 'invalid alternating group')\n            require(c['candidate']['test'] in group and c['baseline']['test'] in group, 'comparison absent from alternating group')\n            rounds, repeat = schedule['rounds'], schedule.get('repeat', 1)\n            require(type(rounds) is int and rounds >= 2 and type(repeat) is int and repeat >= 1, 'invalid rounds/repeat')\n            # Same forward/reverse semantics as make_order.py, filtered to this group.\n            expected = [name for _ in range(repeat) for i in range(rounds) for name in (group if i % 2 == 0 else group[::-1])]\n            observed = [name for name in tests if name in group]\n            require(observed == expected, 'alternating order mismatch')\n            ev.append({'job': c['candidate']['job'], 'attempt': c['candidate']['attempt'], 'alternating_order': observed})\n    op = c['op']\n    require(op in OPS, f'unknown comparator: {op}')\n    threshold = c['threshold']\n    if type(value) is bool:\n        require(op == '==' and type(threshold) is bool, 'boolean criterion requires == boolean')\n    else:\n        number(threshold)\n    return {'id': c['id'], 'status': 'PASS' if OPS[op](value, threshold) else 'FAIL',\n            'metric': metric, 'op': op, 'threshold': threshold, 'value': value, 'evidence': ev}\n\n\ndef evaluate(protocol, lab, root):\n    records = Records(lab, root)\n    try:\n        require(protocol['schema'] == 'criteria/1', 'unsupported criteria schema')\n        criteria = protocol['criteria']\n        require(isinstance(criteria, list) and bool(criteria), 'empty criteria')\n        ids = [c['id'] for c in criteria]\n        require(all(isinstance(i, str) and i for i in ids) and len(set(ids)) == len(ids), 'invalid/duplicate criterion IDs')\n    except (KeyError, TypeError, ValueError) as exc:\n        return {'schema': 'verdict/1', 'status': 'FAIL', 'criteria': [], 'error': str(exc), 'job_ids': []}\n    results = []\n    for c in criteria:\n        try:\n            results.append(check(c, records))\n        except (OSError, ValueError, TypeError, KeyError, IndexError, OverflowError) as exc:\n            results.append({'id': c['id'], 'metric': c.get('metric'), 'status': 'FAIL',\n                            'error': f'{type(exc).__name__}: {exc}', 'evidence': []})\n    # Include requested IDs even when records are missing.\n    def job_ids(value):\n        if isinstance(value, dict):\n            return ({value['job']} if isinstance(value.get('job'), str) else set()).union(*(job_ids(v) for v in value.values()))\n        if isinstance(value, list):\n            return set().union(*(job_ids(v) for v in value))\n        return set()\n    return {'schema': 'verdict/1', 'protocol': protocol.get('id'), 'scope': protocol.get('scope'),\n            'status': 'PASS' if all(r['status'] == 'PASS' for r in results) else 'FAIL',\n            'criteria': results, 'job_ids': sorted(job_ids(criteria))}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('criteria', type=Path)\n    parser.add_argument('--root', type=Path, default=Path(__file__).resolve().parents[2], help='root for legacy sidecar paths')\n    parser.add_argument('--lab', type=Path, default=None, help='defaults to LAB or ROOT/lab')\n    args = parser.parse_args()\n    try:\n        raw = args.criteria.read_bytes()\n        protocol = read_json(args.criteria)\n        result = evaluate(protocol, args.lab or os.environ.get('LAB') or args.root / 'lab', args.root)\n        result.update(criteria_file=str(args.criteria), criteria_sha256=digest(raw))\n    except (OSError, ValueError, TypeError, KeyError) as exc:\n        result = {'schema': 'verdict/1', 'status': 'FAIL', 'criteria': [], 'job_ids': [], 'error': str(exc)}\n    print(json.dumps(result, indent=2, sort_keys=True, allow_nan=False))\n    return 0 if result['status'] == 'PASS' else 1\n\n\nif __name__ == '__main__':\n    sys.exit(main())\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > cc/verdict/build_criteria.py <<'PY'\n\\\"\\\"\\\"Materialize the reviewed protocol transcriptions; never copies or invents job data.\\\"\\\"\\\"\nimport hashlib\nimport json\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parents[2]\nOUT = Path(__file__).resolve().parent / 'criteria'\nC1 = 'job-34c09bec98'\nKV = 'job-a945fa8656'\n\n\ndef ref(job, test, count):\n    return dict(job=job, attempt='att-1', test=test, count=count)\n\n\ndef numeric(id, metric, candidate, baseline=None, mode='value', op='<=', threshold=0, **extra):\n    return dict(id=id, metric=metric, candidate=candidate, **({'baseline': baseline} if baseline else {}),\n                mode=mode, op=op, threshold=threshold, **extra)\n\n\ndef text(id, groups):\n    return dict(id=id, metric='text_sha', groups=groups, op='==', threshold=True)\n\n\ndef sidecar(path):\n    return dict(path=path, sha256=hashlib.sha256((ROOT / path).read_bytes()).hexdigest())\n\n\ndef write(name, scope, criteria, sources):\n    (OUT / (name + '.json')).write_text(json.dumps(dict(schema='criteria/1', id=name, scope=scope,\n                                                      sources=sources, criteria=criteria), indent=2) + '\\\\n')\n\n\ndef main():\n    acceptance = [numeric('Q8_0 decode gain', 'tg_ts', ref(C1, 'c1_q8_tg_r1', 4), ref(C1, 'c1_q8_tg_r0', 4),\n                          'delta_pct', '>=', 2,\n                          alternating=dict(group=['c1_q8_tg_r0', 'c1_q8_tg_r1'], rounds=2, repeat=2))]\n    for model in ('q8', 'mix'):\n        acceptance += [text(f'{model} OFF/ON greedy identity', [ref(C1, f'c1_{model}_gen_r{r}', 4) for r in (0, 1)]),\n                       numeric(f'{model} printed PPL identity', 'ppl', ref(C1, f'c1_{model}_ppl_r1', 1),\n                               ref(C1, f'c1_{model}_ppl_r0', 1), 'abs_delta')]\n    acceptance += [dict(id='CUDA MUL_MAT correctness', metric='backend_ops', job=C1, attempt='att-1',\n                        backend='CUDA0', operation='MUL_MAT', op='==', threshold=True,\n                        **sidecar('artifacts/x4-c1/tbo-mulmat.out')),\n                   dict(id='No compiler during timing', metric='host_quiet', job=C1, attempt='att-1',\n                        counters={'cc': 0}, max_gap_s=15, op='==', threshold=True,\n                        **sidecar('artifacts/x2/timed-hostload.log'))]\n    write('D029-q8_reuse', 'D026 primary Q8_0 acceptance, with correctness for both model groups. '\n          'Host quiet means the recorded cc counter is zero; this log does not measure downloads or CPU inference. '\n          'The backend log is legacy external evidence, not a test inside the job.', acceptance, ['D026', 'D029'])\n    # D029 explicitly reports mixE4K as a separate, sub-threshold track.\n    mix = json.loads(json.dumps(acceptance))\n    mix[0] = numeric('mixE4K decode gain', 'tg_ts', ref(C1, 'c1_mix_tg_r1', 4), ref(C1, 'c1_mix_tg_r0', 4),\n                     'delta_pct', '>=', 2, alternating=dict(group=['c1_mix_tg_r0', 'c1_mix_tg_r1'], rounds=2, repeat=2))\n    write('D029-mixE4K', 'D026 separate mixE4K track (recorded sub-threshold).', mix, ['D026', 'D029'])\n    for quant in ('q8_0', 'q4_0'):\n        quality = [numeric('PPL within one percent', 'ppl', ref(KV, f'kv_ppl4k_{quant}', 1),\n                           ref(KV, 'kv_ppl4k_f16', 1), 'abs_delta_pct', '<=', 1)]\n        write('D033-' + quant, 'D033 reported same-accuracy PPL gate only (±1%). '\n              'Does not establish all D028 requirements: nonidentical greedy text leaves KLD pending.',\n              quality, ['D028', 'D033'])\n        write('D033-' + quant + '-frozen', 'D028 full same-accuracy gate: PPL within 1% AND greedy text identical. '\n              'D028 leaves KLD pending when text differs and freezes no KLD threshold. '\n              'This file fails closed on nonidentity; it does not invent a KLD waiver or threshold.',\n              quality + [text('Greedy identity or unresolved KLD', [ref(KV, 'kv_gen32k_f16', 3),\n                                                                  ref(KV, f'kv_gen32k_{quant}', 3)])], ['D028', 'D033'])\n\n\nif __name__ == '__main__':\n    main()\nPY\npython3 cc/verdict/build_criteria.py\npython3 -B cc/verdict/verdict.py cc/verdict/criteria/D029-q8_reuse.json > artifacts/codexVER/D029-q8_reuse.verdict.json\npython3 - <<'PY'\nimport json\nr=json.load(open('artifacts/codexVER/D029-q8_reuse.verdict.json'))\nprint(r['status'])\nfor c in r['criteria']: print(c['id'],c['status'],c.get('value'),c.get('error'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
