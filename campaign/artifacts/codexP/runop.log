{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"ls -la cc/resource_observe artifacts/codexP 2>/dev/null; sed -n '1,200p' bin/lab\"","aggregated_output":"artifacts/codexP:\ntotal 8\ndrwxrwxr-x   2 muk muk 4096 Nov  9 22:12 .\ndrwxrwxr-x 150 muk muk 4096 Nov  9 22:12 ..\n-rw-rw-r--   1 muk muk    0 Nov  9 22:12 runop.log\n#!/usr/bin/env python3\n\"\"\"lab — feasibility core of a \"lab\": image(container) + tests -> job -> attempts -> evidence. No UI. Discovery prototype.\n  lab image add NAME REF            register an image by immutable id/digest\n  lab submit --image N --model P --tests a,b --key K [--res cpus=8,memory=16g,timeout_s=300]   idempotent by key; job.json is immutable\n  lab run JOB                       new attempt (retry = new attempt); no GPU admission control (lock removed)\n  lab cancel JOB ATT                request cancellation (confirmed only when owned containers are gone)\n  lab status [JOB]                  states\n  lab reconcile                     inspect non-terminal attempts against REAL processes/containers; never trusts heartbeats\n  lab register JOB ATT              register result into index (idempotent; stale/conflicting rejected)\nStore: $LAB/{images,jobs,index}. Fault injection for recovery tests: LAB_FAULT=die_after_start|die_in_export\n\"\"\"\nimport json, sys, os, re, time, uuid, hashlib, fcntl, subprocess, argparse, shutil, datetime as dt, glob\nLAB = os.environ.get(\"LAB\", os.path.expanduser(\"~/projects/siminfeng/campaign/lab\"))\nCID = os.environ.get(\"CAMPAIGN_ID\", \"c1\")\nnow = lambda: dt.datetime.now(dt.timezone.utc).isoformat()\ndef jd(o): return json.dumps(o, sort_keys=True)\ndef sha(p):\n    h = hashlib.sha256()\n    with open(p, \"rb\") as f:\n        for b in iter(lambda: f.read(1 << 20), b\"\"): h.update(b)\n    return h.hexdigest()\ndef sha_s(s): return hashlib.sha256(s.encode()).hexdigest()\ndef sh(cmd, **kw): return subprocess.run(cmd, capture_output=True, text=True, **kw)\ndef append(path, rec):\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)\n    try: fcntl.flock(fd, fcntl.LOCK_EX); os.write(fd, (jd(rec) + \"\\n\").encode()); os.fsync(fd)\n    finally: os.close(fd)\ndef proc_start(pid):\n    try: return open(f\"/proc/{pid}/stat\").read().rsplit(\")\", 1)[1].split()[19]\n    except Exception: return None\ndef last_state(adir):\n    p = os.path.join(adir, \"state.jsonl\")\n    rows = [json.loads(l) for l in open(p)] if os.path.exists(p) else []\n    return rows[-1] if rows else None\n\n# ---- test definitions: how an image's tools are exercised and judged (the \"tests\" half of a lab) ----\ndef load_tests():\n    t = {}\n    import glob as g\n    for f in sorted(g.glob(os.path.join(LAB, \"tests\", \"*.json\"))): t.update(json.load(open(f)))\n    return t\nTESTS = load_tests()\ndef assess(test, out, err, rc):\n    txt = out + \"\\n\" + err\n    if TESTS[test].get(\"parser\") == \"ppl\":\n        m = re.search(r\"Final estimate: PPL = ([\\d.]+) \\+/- ([\\d.]+)\", txt)\n        return dict(ok=rc == 0 and bool(m), ppl=float(m.group(1)) if m else None, ppl_stderr=float(m.group(2)) if m else None)\n    if TESTS[test].get(\"parser\") == \"kl\":\n        g = lambda pat: (lambda m: float(m.group(1)) if m else None)(re.search(pat, txt))\n        return dict(ok=rc == 0 and g(r\"Mean\\s+KLD:\\s+([\\d.]+)\") is not None, kld=g(r\"Mean\\s+KLD:\\s+([\\d.]+)\"), kld_p99=g(r\"99.0%\\s+KLD:\\s+([\\d.]+)\"),\n                    top1_pct=g(r\"Same top p:\\s+([\\d.]+)\"), ppl_ratio=g(r\"Mean PPL\\(Q\\)/PPL\\(base\\)\\s*:\\s+([\\d.]+)\"), ppl=g(r\"Mean PPL\\(Q\\)\\s*:\\s+([\\d.]+)\"))\n    if TESTS[test].get(\"parser\") == \"completion\":\n        m = re.findall(r\"\\beval time =\\s+([\\d.]+) ms /\\s+(\\d+) (?:runs|tokens).*?([\\d.]+) tokens per second\", txt)\n        pe = re.findall(r\"prompt eval time =\\s+([\\d.]+) ms /\\s+(\\d+) tokens.*?([\\d.]+) tokens per second\", txt)\n        dec = [x for x in m]   # lines starting with 'eval time' (decode); 'prompt eval time' captured separately\n        return dict(ok=rc == 0 and bool(dec), decode_tps=float(dec[-1][2]) if dec else None, decode_tokens=int(dec[-1][1]) if dec else None,\n                    prefill_tps=float(pe[-1][2]) if pe else None, prefill_tokens=int(pe[-1][1]) if pe else None, text_head=out.strip()[-160:])\n    if TESTS[test].get(\"parser\") == \"gen\":\n        return dict(ok=rc == 0 and len(out.strip()) > 20, chars=len(out.strip()), head=out.strip()[:120])\n    if TESTS[test].get(\"parser\") == \"bench_json\":\n        try: rows = json.loads(out[out.index(\"[\"):out.rindex(\"]\") + 1])\n        except Exception: return dict(ok=False, parse_error=True)\n        return dict(ok=rc == 0 and bool(rows), samples=[dict(n_prompt=r[\"n_prompt\"], n_gen=r[\"n_gen\"], avg_ts=r[\"avg_ts\"], samples_ts=r.get(\"samples_ts\")) for r in rows])\n    return dict(ok=rc == 0)\n\ndef gpu_state():\n    q = sh([\"nvidia-smi\",\"--query-gpu=memory.used,clocks.sm,temperature.gpu,power.draw\",\"--format=csv,noheader\"]).stdout.strip()\n    apps = sh([\"nvidia-smi\",\"--query-compute-apps=pid,used_memory\",\"--format=csv,noheader\"]).stdout.strip().splitlines()\n    return dict(gpu=q, compute_apps=apps)\n\ndef read_int(path):\n    try: return int(open(path).read().strip())\n    except Exception: return None\n\ndef cid_cgroup(cname):\n    cid = sh([\"docker\", \"inspect\", \"-f\", \"{{.Id}}\", cname]).stdout.strip()\n    return f\"/sys/fs/cgroup/system.slice/docker-{cid}.scope\" if cid else None\n\ndef cmd_image(a):\n    ref = a.ref; r = sh([\"docker\", \"image\", \"inspect\", ref, \"-f\", \"{{.Id}}|{{json .RepoDigests}}|{{.Created}}\"])\n    if r.returncode: sys.exit(\"image not present locally: \" + r.stderr)\n    iid, rd, created = r.stdout.strip().split(\"|\")\n    rec = dict(name=a.name, ref=ref, image_id=iid, repo_digests=json.loads(rd), created=created, registered=now())\n    p = os.path.join(LAB, \"images\", a.name + \".json\"); os.makedirs(os.path.dirname(p), exist_ok=True)\n    if os.path.exists(p) and json.load(open(p))[\"image_id\"] != iid: sys.exit(\"name already bound to a different image id (images are immutable)\")\n    json.dump(rec, open(p, \"w\"), indent=1); print(jd(rec))\n\ndef archive_ids(path):\n    \"\"\"Identities read from the docker-save archive itself: config digest (image config) and top-level index digest (what the containerd store reports as Id).\"\"\"\n    import tarfile\n    out = dict(config=None, index=None)\n    with tarfile.open(path) as t:\n        names = t.getnames()\n        if \"manifest.json\" in names:\n            m = json.load(t.extractfile(\"manifest.json\"))\n            if m and m[0].get(\"Config\", \"\").startswith(\"blobs/sha256/\"): out[\"config\"] = \"sha256:\" + m[0][\"Config\"].split(\"/\")[-1]\n        if \"index.json\" in names:\n            ms = json.load(t.extractfile(\"index.json\")).get(\"manifests\", [])\n            out[\"index_entries\"] = [m.get(\"digest\") for m in ms]\n            if len(ms) == 1: out[\"index\"] = ms[0].get(\"digest\")\n    return out\n\ndef cmd_imageload(a):\n    \"\"\"Admit an engine image delivered as a docker archive. Order: (1) archive bytes hash, (2) archive's own config digest vs expected,\n    (3) docker load, (4) loaded image id must equal the archive's index digest (the containerd store's notion of Id).\"\"\"\n    got = sha(a.archive)\n    if got != a.sha256: print(f\"REJECT: archive sha256 mismatch (expected {a.sha256[:12]}..., got {got[:12]}...)\"); sys.exit(10)\n    ids = archive_ids(a.archive)\n    if ids[\"config\"] != a.expect_config_id: print(f\"REJECT: archive config digest {str(ids['config'])[:19]}... != expected {a.expect_config_id[:19]}...\"); sys.exit(12)\n    r = sh([\"docker\", \"load\", \"-i\", a.archive])\n    if r.returncode: print(\"REJECT: docker load failed:\", r.stderr[-300:]); sys.exit(11)\n    cands = ids.get(\"index_entries\") or [ids[\"index\"] or ids[\"config\"]]\n    want = next((c for c in cands if sh([\"docker\", \"image\", \"inspect\", c, \"-f\", \"{{.Id}}\"]).stdout.strip() == c), None)\n    if want is None: print(f\"REJECT: no loaded image has an id among the archive's index entries {[c[:19] for c in cands]}\"); sys.exit(13)\n    a.ref = want; a.op = \"add\"; cmd_image(a); print(\"admitted:\", a.name, \"config\", ids[\"config\"][:19], \"docker-id\", want[:19])\n\ndef cmd_chaos(a):\n    ow = json.load(open(os.path.join(LAB, \"jobs\", a.job, a.att, \"owner.json\"))); cs = owned_containers(a.att, ow[\"token\"])\n    for c in cs: sh([\"docker\", \"kill\", c])\n    append(os.path.join(LAB, \"jobs\", a.job, a.att, \"chaos.jsonl\"), dict(ts=now(), action=\"kill-sandbox\", containers=cs)); print(\"killed owned containers:\", cs)\n\ndef cmd_submit(a):\n    img = json.load(open(os.path.join(LAB, \"images\", a.image + \".json\")))\n    res = dict(cpus=\"8\", memory=\"16g\", pids=\"512\", timeout_s=\"300\", gpu_wait_s=\"600\"); res.update(dict(kv.split(\"=\") for kv in (a.res or \"\").split(\",\") if kv))\n    spec = dict(image=a.image, image_id=img[\"image_id\"], model=os.path.abspath(a.model), model_sha256=a.model_sha256 or sha(a.model),\n                data=a.data, data_sha256=(sha(a.data) if a.data else None), tests=a.tests.split(\",\"), resources=res, key=a.key)\n    jid = \"job-\" + sha_s(a.key)[:10]; jdir = os.path.join(LAB, \"jobs\", jid); p = os.path.join(jdir, \"job.json\")\n    if os.path.exists(p):\n        old = json.load(open(p))[\"spec\"]\n        if old != spec: sys.exit(f\"idempotency key reused with DIFFERENT spec -> rejected (job {jid})\")\n        print(f\"duplicate submission: existing {jid}\"); return\n    os.makedirs(jdir); json.dump(dict(job=jid, submitted=now(), spec=spec, spec_sha256=sha_s(jd(spec))), open(p, \"w\"), indent=1); os.chmod(p, 0o444)\n    append(os.path.join(jdir, \"job.log\"), dict(ts=now(), ev=\"submitted\")); print(jid)\n\ndef owned_containers(att, token=None):\n    r = sh([\"docker\", \"ps\", \"-aq\", \"--filter\", f\"label=lab_attempt={att}\"]).stdout.split(); out = []\n    for c in r:\n        lab = json.loads(sh([\"docker\", \"inspect\", c, \"-f\", \"{{json .Config.Labels}}\"]).stdout)\n        if token is None or lab.get(\"lab_token\") == token: out.append(c)\n    return out\n\ndef cmd_run(a):\n    job = json.load(open(os.path.join(LAB, \"jobs\", a.job, \"job.json\"))); spec = job[\"spec\"]; jdir = os.path.join(LAB, \"jobs\", a.job)\n    img = json.load(open(os.path.join(LAB, \"images\", spec[\"image\"] + \".json\")))\n    for prev in sorted(glob.glob(os.path.join(jdir, \"att-*\"))):   # duplicate-delivery / replacement guard\n        ls = last_state(prev); pa = os.path.basename(prev)\n        if ls and ls[\"state\"] != \"terminal\":\n            ow = json.load(open(os.path.join(prev, \"owner.json\")))\n            if proc_start(ow[\"runner_pid\"]) == ow[\"runner_start\"] or owned_containers(pa, ow[\"token\"]):\n                print(f\"REJECT: {pa} is still active (runner alive or owned containers present); no duplicate execution\"); sys.exit(8)\n            print(f\"REJECT: {pa} is non-terminal and its owner is gone; run `lab reconcile` to confirm it stopped before replacement\"); sys.exit(9)\n    n = len(glob.glob(os.path.join(jdir, \"att-*\"))) + 1; att = f\"att-{n}\"; adir = os.path.join(jdir, att); os.makedirs(adir)\n    token = uuid.uuid4().hex\n    json.dump(dict(attempt=att, runner_pid=os.getpid(), runner_start=proc_start(os.getpid()), token=token, started=now()), open(os.path.join(adir, \"owner.json\"), \"w\"))\n    S = lambda s, **kw: append(os.path.join(adir, \"state.jsonl\"), dict(ts=now(), job=a.job, attempt=att, state=s, **kw))\n    S(\"queued\"); res = spec[\"resources\"]\n    S(\"preparing\")\n    if sha(spec[\"model\"]) != spec[\"model_sha256\"]: S(\"terminal\", execution=\"not_started\", reason=\"model hash mismatch\"); sys.exit(4)\n    S(\"running\", admission=\"none (gpu lock removed by user decision)\", gpu_pre=gpu_state())\n    results = {}; cancelled = False; interrupted = False; sandbox_died = False\n    for ti, tfull in enumerate(spec[\"tests\"]):\n        t = tfull; td = TESTS[t]; cname = f\"lab-{CID}-{a.job}-{att}-{t}-{ti}\".lower()\n        cmd = [\"docker\",\"run\",\"--rm\",\"--name\",cname,\"--label\",f\"campaign={CID}\",\"--label\",f\"lab_job={a.job}\",\"--label\",f\"lab_attempt={att}\",\"--label\",f\"lab_token={token}\",\n               *sum([[\"-e\", f\"{k}={v}\"] for k, v in td.get(\"env\", {}).items()], []),\"--gpus\",\"all\",\"--cpus\",res[\"cpus\"],\"--memory\",td.get(\"memory\", res[\"memory\"]),\"--memory-swap\",td.get(\"memory\", res[\"memory\"]),\"--pids-limit\",res[\"pids\"],\"-v\",f\"{os.path.dirname(spec['model'])}:/m:ro\",*td.get(\"docker_args\", [])]\n        if spec.get(\"data\"): cmd += [\"-v\", f\"{os.path.dirname(spec['data'])}:/d:ro\"]\n        mfile = td.get(\"model_file\", os.path.basename(spec[\"model\"]))\n        cmd += [\"--entrypoint\",\"/app/\"+td[\"tool\"], img[\"image_id\"], \"-m\", \"/m/\"+mfile]\n        if td.get(\"needs_data\"): cmd += [\"-f\", \"/d/\"+os.path.basename(spec[\"data\"])]\n        cmd += td[\"args\"]\n        if td.get(\"cold_cache\"):   # evict ONLY this model file's cached pages (posix_fadvise); never a host-wide flush\n            fd = os.open(os.path.join(os.path.dirname(spec[\"model\"]), mfile), os.O_RDONLY); os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED); os.close(fd)\n        o, e = os.path.join(adir, f\"{t}#{ti}.stdout\"), os.path.join(adir, f\"{t}#{ti}.stderr\"); ts = time.monotonic()\n        with open(o,\"w\") as fo, open(e,\"w\") as fe:\n            p = subprocess.Popen(cmd, stdout=fo, stderr=fe, start_new_session=True)\n            S(\"running\", test=t, container=cname)\n            if os.environ.get(\"LAB_FAULT\") == \"die_after_start\": time.sleep(1.5); os.kill(os.getpid(), 9)\n            peak_gpu, peak_host, io_rbytes, cg, base_gpu = 0, 0, 0, None, int(sh([\"nvidia-smi\",\"--query-gpu=memory.used\",\"--format=csv,noheader,nounits\"]).stdout.strip() or 0); nsamp = 0; tlast = 0\n            while p.poll() is None:\n                if time.monotonic() - tlast > 0.25:   # memory sampler: GPU total used (device is otherwise idle) + container cgroup\n                    tlast = time.monotonic(); g = sh([\"nvidia-smi\",\"--query-gpu=memory.used\",\"--format=csv,noheader,nounits\"]).stdout.strip()\n                    if g: peak_gpu = max(peak_gpu, int(g)); nsamp += 1\n                    cg = cg or cid_cgroup(cname)\n                    if cg:\n                        v = read_int(cg + \"/memory.peak\") or read_int(cg + \"/memory.current\"); peak_host = max(peak_host, v or 0)\n                        try: io_rbytes = max(io_rbytes, sum(int(x.split(\"=\")[1]) for l in open(cg + \"/io.stat\") for x in l.split() if x.startswith(\"rbytes=\")))\n                        except Exception: pass\n                if os.path.exists(os.path.join(adir, \"cancel_requested\")): cancelled = True; sh([\"docker\",\"kill\",cname]); break\n                if time.monotonic() - ts > float(res[\"timeout_s\"]): sh([\"docker\",\"kill\",cname]); interrupted = True; break\n                time.sleep(0.3)\n            rc = p.wait()\n        died = (not cancelled) and (not interrupted) and rc in (137, 143)   # SIGKILL/SIGTERM not requested by us: sandbox/container terminated externally (or OOM)\n        results[f\"{t}#{ti}\"] = dict(exit_code=rc, elapsed_s=round(time.monotonic()-ts,3), partial=died, mem=dict(gpu_peak_mib=peak_gpu, gpu_baseline_mib=base_gpu, gpu_delta_mib=peak_gpu-base_gpu, host_cgroup_peak_mib=round(peak_host/2**20,1), io_read_mib=round(io_rbytes/2**20,1), samples=nsamp, method=\"nvidia-smi memory.used polled 4Hz (device otherwise idle; includes CUDA context) + cgroup memory.peak\"), **assess(t, open(o, errors=\"replace\").read(), open(e, errors=\"replace\").read(), rc))\n        if died: sandbox_died = True; S(\"sandbox_terminated\", test=t, exit_code=rc, last_durable_bytes=os.path.getsize(o), last_durable_mtime=dt.datetime.fromtimestamp(os.path.getmtime(o), dt.timezone.utc).isoformat())\n        if cancelled or interrupted or died: break\n    post = gpu_state()\n    S(\"assessing\")\n    left = owned_containers(att, token)\n    if cancelled: S(\"cancel_confirmed\" if not left else \"cancel_unconfirmed\", owned_left=left)\n    files = {f: sha(os.path.join(adir, f)) for f in sorted(os.listdir(adir)) if f.endswith((\".stdout\",\".stderr\"))}\n","exit_code":0,"status":"completed"}}
