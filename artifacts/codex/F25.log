        self.assertEqual((result['state'], result['reason']), ('blocked', 'CHECKER_UNAVAILABLE'))
        self.assertEqual(result['assessment']['verdict'], 'not_run')
        self.assertFalse((Path(result['provenance']['attempt_dir']) / 'stdout.log').exists())

