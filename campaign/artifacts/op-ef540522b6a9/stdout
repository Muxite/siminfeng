ow(int64_t want_bytes, std::string& err);\n   149\t    /// The number of leading slots that fit wholly inside the first `bytes` bytes.\n   150\t    int64_t slots_within(int64_t bytes) const;\n   151\t    /// The bytes the first `n` slots span.\n   152\t    int64_t bytes_of(int64_t n) const { return slot_end(n < 0 ? 0 : n > slots_ ? slots_ : n); }\n   153\t\n   154\t    /// `(layer, expert)` -> slot index, or `kNotResident`.  Bounds-checked: a bad layer or expert returns\n   155\t    /// `kNotResident` rather than reading whatever is adjacent in the table.\n   156\t    int32_t slot_of(int64_t layer, int64_t expert) const;\n   157\t    /// Claims the next free slot for `(layer, expert)`.  Returns the slot, or `kNotResident` when the cache is\n   158\t    /// full - **it never evicts**, because eviction policy is a measured question (`R4.1`'s LFU-decay vs LRU\n   159\t    /// sweep) and a placeholder policy would set the hit rate that everything downstream is then sized against.\n   160\t    int32_t admit(int64_t layer, int64_t expert);\n   161\t\n   162\t    /// Publish a same-layer replacement after its slot copy has completed.\n   163\t    void replace(int64_t layer, int32_t old_expert, int32_t new_expert) {\n   164\t        auto& old = residency_[(size_t) layer * n_expert_ + old_expert];\n   165\t        residency_[(size_t) layer * n_expert_ + new_expert] = old;\n   166\t        old = kNotResident;\n   167\t    }\n   168\t\n   169\t    /// **R4.2g: GIVE EACH LAYER ITS OWN SLOTS.  ROUND 328 MEASURED WHY THE GLOBAL FORM CANNOT WORK.**\n   170\t    ///\n   171\t    /// `admit`'s original policy hands out slots in ARRIVAL ORDER from one counter shared by every layer\n   172\t    /// (`if (next_free_ >= slots_) return kNotResident;`).  A position looks at 10 experts in each of 48\n   173\t    /// layers, so the first `n_slots` distinct (layer, expert) pairs are **about 26 layers of POSITION 0** -\n   174\t    /// the cache fills entirely inside the first position it ever sees and never changes again, so hits are\n   175\t    /// confined to those few layers for the rest of the run.\n   176\t    ///\n   177\t    /// Measured, `--expert-cache 256`: **1781 of 60000 = 2.97%**.  `Memory/cache_allocation.py` scores the\n   178\t    /// same run's routing and says **8 slots per layer is worth 21.4%** and 64 is worth **70.4%**.  The cache\n   179\t    /// was never short of capacity - it was handing all of it to two layers.\n   180\t    ///\n   181\t    /// With this on, layer `l` may only use slots `[l*q, (l+1)*q)` where `q = slots()/n_layers`, the last\n   182\t    /// layer taking the remainder.  **EVICTION IS STILL ABSENT** - the property the comment above calls\n   183\t    /// deliberate is preserved exactly; only WHICH slot a layer may take changes.  Default off, so every\n   184\t    /// caller that predates this flag is bit-for-bit unaffected.\n   185\t    void set_per_layer_admission(bool on) { per_layer_ = on; }\n   186\t    bool per_layer_admission() const { return per_layer_; }\n   187\t    /// The slot range layer `l` may admit into under per-layer admission.  Exposed so a test can check it.\n   188\t    void layer_slot_range(int64_t layer, int64_t& lo, int64_t& hi) const;\n   189\t\n   190\t    /// The device address of one slot.\n   191\t    uint8_t* device_slot(int32_t slot);\n   192\t    const uint8_t* device_slot(int32_t slot) const;\n   193\t\n   194\t    /// Copies `(layer, expert)`'s blob from `host_blob` into `slot` on `stream`.  Asynchronous: the caller\n   195\t    /// orders it.  Returns false if the indices are out of range rather than reading past the arena.\n   196\t    /// `bytes` (plan v0.3 P6): the blob's own size when it is smaller than the slot (a native pack); 0 = the slot.\n   197\t    bool fill_slot(int32_t slot, const uint8_t* host_blob, void* stream, std::string& err, int64_t bytes = 0);\n   198\t\n   199\t    /// **THE SAME COPY, BUT BLOCKING, AND THE PROFILE FILL NEEDS IT.**  `fill_slot` is asynchr