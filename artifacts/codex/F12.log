+
+// Qwen35MoE (the Qwen3.6 GGUF uses this arch):
+// x_L = RMSNorm(attention_L + residual_L, attn_post_norm_L, eps).
+// logits = W*x, p = softmax(logits), ids = topk(p); no gate_inp_b,
+// no exp_probs_b, no groups. Selected weights are normalized AFTER top-k.
+// softmax is monotone, so ranking logits gives the same IDs (ties by ID).
+void llama_context::expert_pregate_init() {
+    const char * env = getenv("LLAMA_EXPERT_PREGATE");
+    if (!env || strcmp(env, "1") != 0) { return; }
+    try {
+        if (model.arch != LLM_ARCH_QWEN35MOE || model.hparams.n_expert_groups > 1 || !loras->empty() || !model.hdmd.rot.empty()) {
+            throw std::runtime_error("pregate requires qwen35moe without groups, LoRA, or folded rotations");
+        }
+        const char * k = getenv("LLAMA_EXPERT_PREGATE_K");
+        if (k && strcmp(k, "12") == 0) { expert_pregate_k = 12; }
+        else if (k && strcmp(k, "16") == 0) { expert_pregate_k = 16; }
+        expert_pregate_layers.resize(model.hparams.n_layer()); // excludes unexecuted MTP blocks
+        const long page = sysconf(_SC_PAGESIZE);
+        if (page <= 0) { throw std::runtime_error("invalid page size"); }
+        // Decode/copy from file once, never GPU tensor data. Original mmap may have holes.
+        for (size_t il = 1; il < expert_pregate_layers.size(); ++il) {
+            const auto * w = model.layers[il].ffn_gate_inp;
+            llama_model::expert_file_range info;
+            if (!w || !ggml_is_contiguous(w) || w->ne[0] != model.hparams.n_embd ||
+                    w->ne[1] != model.hparams.n_expert || w->ne[2] != 1 || w->ne[3] != 1 ||
+                    !model.expert_file_info(w, info, false)) {
+                throw std::runtime_error("router file offsets/layout unavailable");
+            }
+            const auto * traits = ggml_get_type_traits(w->type);
+            if (w->type != GGML_TYPE_F32 && !traits->to_float) {
+                throw std::runtime_error("router type has no CPU decoder");
+            }
+            auto & dst = expert_pregate_layers[il].router;
+            dst.resize(ggml_nelements(w));
+            const size_t first = info.offset / size_t(page) * size_t(page);
+            const size_t delta = info.offset - first, len = delta + ggml_nbytes(w);
+            void * ptr = mmap(nullptr, len, PROT_READ, MAP_PRIVATE, info.source_fd, off_t(first));
+            if (ptr == MAP_FAILED) { throw std::runtime_error("router file mmap failed"); }
+            const char * data = static_cast<const char *>(ptr) + delta;
+            if (w->type == GGML_TYPE_F32) { memcpy(dst.data(), data, ggml_nbytes(w)); }
+            else {
+                for (int64_t row = 0; row < w->ne[1]; ++row) {
+                    traits->to_float(data + row * w->nb[1], dst.data() + row * w->ne[0], w->ne[0]);
+                }
+            }
+            munmap(ptr, len);
+        }
+        expert_pregate_enabled = true;
+        LLAMA_LOG_INFO("expert_pregate: active k=%zu arch=qwen35moe gating=softmax router=file-cpu-copy\n", expert_pregate_k);
+    } catch (const std::exception & e) {
+        expert_pregate_layers.clear();
+        LLAMA_LOG_INFO("expert_pregate: inactive (%s)\n", e.what());
+    }
+}
+
+void llama_context::expert_pregate_hook(size_t il, const ggml_tensor * t, const std::vector<int32_t> & selected) {
+    if (!expert_fill_decode || !expert_fill_this_ubatch || il >= expert_pregate_layers.size()) { return; }
+    auto & current = expert_pregate_layers[il];
+    if (!current.predicted.empty()) {
+        ++pregate_arrivals;
+        pregate_actual += selected.size(); pregate_predicted += current.predicted.size();
+        for (auto id : selected) {
+            pregate_hits += std::find(current.predicted.begin(), current.predicted.end(), id) != current.predicted.end();
+        }
+        uint64_t pending = 0, running = 0;
+        for (const auto & batch : current.batches) {
+            if (batch) { pending += batch->pending.load(); running += batch->running.load(); }
+        }
+        pregate_pending_reads += pending;
+        pregate_inflight_reads += running; pregate_inflight_arrivals += pending != 0;
+    }
+    if (expert_pregate_failed || il + 1 >= expert_pregate_layers.size()) { return; }
+    try {
+        if (!loras->empty()) { throw std::runtime_error("LoRA activated after pregate initialization"); }
+        // Before-node CPU callback runs AFTER the scheduler's host copies and prefix
+        // synchronize. src[1] of the FIRST gate/up MUL_MAT_ID is [embd,1,1,1],
+        // a reshape/host copy of attn_post_norm, not the down-projection activation.
+        const ggml_tensor * x = t->src[1];
+        const ggml_tensor * base = x && x->view_src ? x->view_src : x;
+        const auto * w = model.layers[il + 1].ffn_gate_inp;
+        if (!x || !base || !base->buffer || !ggml_backend_buffer_is_host(base->buffer) ||
+                !x->data || x->type != GGML_TYPE_F32 || x->ne[0] != w->ne[0] ||
+                x->ne[1] != 1 || x->ne[2] != 1 || x->ne[3] != 1 || !ggml_is_contiguous(x) ||
+                (t->src[0] != model.layers[il].ffn_up_exps && t->src[0] != model.layers[il].ffn_gate_exps &&
+                 t->src[0] != model.layers[il].ffn_gate_up_exps)) {
+            throw std::runtime_error("first expert input is not a host F32 decode MoE vector");
+        }
+        const auto & router = expert_pregate_layers[il + 1].router;
+        const auto * input = static_cast<const float *>(x->data);
+        std::vector<std::pair<float, int32_t>> logits;
+        logits.reserve(w->ne[1]);
+        for (int64_t e = 0; e < w->ne[1]; ++e) {
+            float dot = 0;
+            for (int64_t j = 0; j < w->ne[0]; ++j) { dot += router[e * w->ne[0] + j] * input[j]; }
+            if (!std::isfinite(dot)) { throw std::runtime_error("nonfinite pregate logits"); }
+            logits.emplace_back(dot, int32_t(e));
+        }
+        const size_t k = std::min(expert_pregate_k, logits.size());
+        std::partial_sort(logits.begin(), logits.begin() + k, logits.end(), [](const auto & a, const auto & b) {
+            return a.first != b.first ? a.first > b.first : a.second < b.second;
+        });
+        auto & next = expert_pregate_layers[il + 1];
+        next.predicted.clear(); next.batches.clear();
+        for (size_t i = 0; i < k; ++i) { next.predicted.push_back(logits[i].second); }
+        std::map<size_t, std::vector<ExpertFiller::Range>> ranges;
+        const auto & layer = model.layers[il + 1];
+        for (const ggml_tensor * expert : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
+            if (!expert) { continue; }
+            llama_model::expert_file_range info;
+            if (!model.expert_file_info(expert, info)) { throw std::runtime_error("pregate expert offsets unavailable"); }
+            for (auto id : next.predicted) {
+                if (id < 0 || id >= expert->ne[2]) { throw std::runtime_error("pregate expert ID outside tensor"); }
+                ranges[info.file_index].push_back({info.offset + size_t(id) * expert->nb[2], expert->nb[2]});
+            }
+        }
+        // Never fill()/wait_async() here: enqueue takes only a short queue mutex.
+        // The existing synchronous fill below is unchanged and may duplicate in-flight preads.
+        for (const auto & entry : ranges) {
+            next.batches.push_back(expert_fillers.at(entry.first)->enqueue_async(entry.second));
+        }
+        ++pregate_predictions;
+    } catch (const std::exception & e) {
+        ++pregate_skips; expert_pregate_failed = true;
+        LLAMA_LOG_INFO("expert_pregate: prediction disabled (%s)\n", e.what());
+    }
+}
+
+void llama_context::expert_pregate_stats() {
+    uint64_t bytes=0, reads=0, errors=0, dropped=0;
+    for (auto & entry : expert_fillers) {
+        entry.second->wait_async(); // teardown only, after graph synchronize
+        const auto c = entry.second->async_counters();
+        bytes += c.bytes_read; reads += c.read_syscalls; errors += c.errors; dropped += c.dropped;
+    }
+    LLAMA_LOG_INFO("expert_pregate: stats predictions=%" PRIu64 " arrivals=%" PRIu64
+        " hits=%" PRIu64 " actual=%" PRIu64 " predicted=%" PRIu64 " recall_at_k=%.6f precision=%.6f"
+        " async_bytes_read=%" PRIu64 " async_reads=%" PRIu64 " async_errors=%" PRIu64 " dropped=%" PRIu64
+        " inflight_at_arrival=%" PRIu64 " inflight_reads=%" PRIu64 " pending_reads=%" PRIu64
+        " sync_bytes_with_prediction=%" PRIu64 " sync_bytes_without_prediction=%" PRIu64
+        " sync_calls_with_prediction=%" PRIu64 " sync_calls_without_prediction=%" PRIu64 " skips=%" PRIu64 "\n",
+        pregate_predictions, pregate_arrivals, pregate_hits, pregate_actual, pregate_predicted,
+        pregate_actual ? double(pregate_hits)/pregate_actual : 0.0,
+        pregate_predicted ? double(pregate_hits)/pregate_predicted : 0.0,
+        bytes, reads, errors, dropped, pregate_inflight_arrivals, pregate_inflight_reads, pregate_pending_reads,
+        pregate_sync_with, pregate_sync_without, pregate_calls_with, pregate_calls_without, pregate_skips);
 }
 
