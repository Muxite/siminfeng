@pytest.mark.parametrize('name', NAMES)
def test_declarations_and_materials(name):
    folder = CCS / name
    declaration = yaml.safe_load((folder / 'cc.yaml').read_text())
    schema = json.loads((ROOT / 'jiuwenswarm/ccv2/schemas/cc.schema.json').read_text())
