+
+void llama_context::expert_pin_begin(uint32_t n_tokens) {
+    if (!expert_config.pin_mib) { return; }
+    if (!expert_pin_checked) {
+        expert_pin_checked = true;
+        try {
+            if (!model.expert_pin_supported()) { throw std::runtime_error("pin requires plain mmap without model-wide mlock"); }
+            const long page = sysconf(_SC_PAGESIZE);
+            if (page <= 0) { throw std::runtime_error("invalid page size"); }
+            expert_pin_indices.resize(model.layers.size());
+            for (size_t il = 0; il < model.layers.size(); ++il) {
+                const auto & layer = model.layers[il];
+                const ggml_tensor * first = nullptr;
+                for (const auto * w : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
+                    if (w) { first = w; break; }
+                }
+                if (!first) { continue; }
+                if (first->ne[2] <= 0 || first->ne[2] > INT32_MAX) { throw std::runtime_error("invalid pin expert count"); }
+                for (int64_t id = 0; id < first->ne[2]; ++id) {
+                    expert_pin_entry entry {il, int32_t(id), 0, 0, {}};
+                    for (const auto * w : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
+                        if (!w) { continue; }
+                        llama_model::expert_file_range info;
+                        if (w->ne[2] != first->ne[2] || w->ne[3] != 1 || !ggml_is_contiguous(w) || !w->nb[2] ||
+                                !model.expert_file_info(w, info)) { throw std::runtime_error("pin expert layout/mmap unavailable"); }
+                        if (size_t(id) > (info.mapping_size - info.offset) / w->nb[2]) { throw std::runtime_error("pin expert offset outside mmap"); }
+                        const size_t start = info.offset + size_t(id) * w->nb[2];
+                        if (w->nb[2] > info.mapping_size - start) { throw std::runtime_error("pin expert range outside mmap"); }
+                        const size_t end = start + w->nb[2];
+                        const size_t lo = start / size_t(page) * size_t(page);
+                        const size_t hi = end + std::min((size_t(page) - end % size_t(page)) % size_t(page), info.mapping_size - end);
+                        const uintptr_t base = reinterpret_cast<uintptr_t>(info.mapping);
+                        entry.ranges.emplace_back(base + lo, base + hi);
+                        entry.bytes += hi - lo;
+                    }
+                    expert_pin_indices[il].push_back(expert_pin_entries.size());
+                    expert_pin_entries.push_back(std::move(entry));
+                }
+            }
+            if (expert_pin_entries.empty()) { throw std::runtime_error("no mmap experts to pin"); }
+            expert_prefetch_layers.resize(model.layers.size());
+            expert_pin_active = true;
+        } catch (const std::exception & e) {
+            fprintf(stderr, "expert_pin: inactive (%s)\n", e.what());
+        }
+    }
+    if (!expert_pin_active || n_tokens != 1) { return; }
+    if (expert_pin_tokens >= expert_config.pin_warmup &&
+            (expert_pin_tokens - expert_config.pin_warmup) % expert_config.pin_every == 0) { expert_pin_repin(); }
+    ++expert_pin_tokens;
+}
+
+void llama_context::expert_pin_selected(size_t il, const std::vector<int32_t> & selected) {
+    if (!expert_pin_active || !expert_fill_decode || il >= expert_pin_indices.size()) { return; }
+    const auto & indices = expert_pin_indices[il];
+    for (const int32_t id : selected) {
+        if (id >= 0 && size_t(id) < indices.size()) { ++expert_pin_entries[indices[id]].frequency; }
+    }
+}
+
+void llama_context::expert_pin_repin() {
+    std::vector<size_t> ranked;
+    for (size_t i = 0; i < expert_pin_entries.size(); ++i) {
+        if (expert_pin_entries[i].frequency) { ranked.push_back(i); }
+    }
+    std::sort(ranked.begin(), ranked.end(), [&](size_t a, size_t b) {
+        const auto & x = expert_pin_entries[a];
+        const auto & y = expert_pin_entries[b];
+        return x.frequency != y.frequency ? x.frequency > y.frequency : a < b;
+    });
+    uint64_t budget = uint64_t(expert_config.pin_mib) * 1024 * 1024, experts = 0;
+    std::vector<std::pair<uintptr_t, uintptr_t>> ranges;
+    for (const auto i : ranked) {
+        const auto & entry = expert_pin_entries[i];
+        if (entry.bytes > budget) { continue; }
+        budget -= entry.bytes; ++experts;
+        ranges.insert(ranges.end(), entry.ranges.begin(), entry.ranges.end());
+    }
+    std::sort(ranges.begin(), ranges.end());
+    std::vector<std::pair<uintptr_t, uintptr_t>> merged;
+    for (const auto & r : ranges) {
+        if (!merged.empty() && r.first <= merged.back().second) { merged.back().second = std::max(merged.back().second, r.second); }
+        else { merged.push_back(r); }
+    }
+    // Rebuild the union so shared boundary pages remain locked for retained experts.
+    expert_pin_unlock();
+    ++expert_pin_repins;
+    if (!expert_pin_willneed) {
+        for (const auto & r : merged) {
+            if (mlock(reinterpret_cast<void *>(r.first), r.second - r.first)) {
+                const int error = errno;
+                munlock(reinterpret_cast<void *>(r.first), r.second - r.first);
+                ++expert_pin_failures; expert_pin_willneed = true;
+                expert_pin_unlock();
+                fprintf(stderr, "expert_pin: mlock failed errno=%d; pin_mode=willneed (pages remain evictable)\n", error);
+                break;
+            }
+            expert_pin_locked.push_back(r);
+            expert_pin_bytes += r.second - r.first;
+        }
+        if (!expert_pin_willneed) { expert_pin_experts = experts; }
+    }
+    if (expert_pin_willneed) {
+        for (const auto & r : merged) { madvise(reinterpret_cast<void *>(r.first), r.second - r.first, MADV_WILLNEED); }
+    }
+}
