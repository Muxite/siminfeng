"""Inventory declarations using the CC-v2 loader and validator."""
from pathlib import Path

from jiuwenswarm.ccv2.ccv2 import load, tree_files
from .story import paint, wrap


def capsule_rows(root=None):
    root = Path(root) if root else Path(__file__).parent / 'ccs'
    rows = []
    for path in sorted(root.rglob('cc.yaml')):
        declaration = load(path)
        caps = declaration.get('capabilities', {})
        rows.append(dict(id=declaration['id'], version=declaration['version'],
                         binding=','.join(sorted({b['kind'] for b in declaration.get('bindings', {}).values()})) or 'material-only',
                         capabilities=list(caps), changes=sorted({e for c in caps.values() for e in c.get('changes', [])}),
                         files=len(tree_files(path.parent)), lines=len(path.read_text().splitlines()), valid=True))
    return rows


def format_capsules(rows, plain=False):
    lines = ['ID                          VERSION BINDING        FILES YAML VALID', '─' * 99]
    for row in rows:
        lines.extend(wrap(f"{row['id']:27} {row['version']:7} {row['binding']:14} "
                          f"{row['files']:5} {row['lines']:4} ✓ valid"))
        lines.extend(wrap('capabilities: ' + (', '.join(row['capabilities']) or '·'), '  '))
        lines.extend(wrap('changes: ' + (', '.join(row['changes']) or '·'), '  '))
    lines.extend(wrap(f"{len(rows)} capsules · {sum(len(r['capabilities']) for r in rows)} capabilities · "
                      f"{sum(r['lines'] for r in rows)} lines of cc.yaml · 0 adapters"))
    return '\n'.join(paint(line, plain) for line in lines)
"""Native CC packet entry point for task-scoped evidence capabilities."""
from __future__ import annotations

import json
import os
from pathlib import Path
import sqlite3
import sys
import time

from .store import FactoryError, NotFound, ScopeDenied, Store


def fields(value, allowed, required=()):
    if not isinstance(value, dict) or set(value) - set(allowed) or set(required) - set(value):
        raise ValueError('Invalid or missing input fields')


def artifact_source(record, packet):
    if ('path' in record) == ('text' in record):
        raise ValueError('Supply exactly one of path or text')
    if 'text' in record:
        if not isinstance(record['text'], str):
            raise ValueError('text must be a string')
        return record['text'].encode('utf-8')
    if not isinstance(record['path'], str) or not record['path']:
        raise ValueError('path must be a nonempty string')
    roots = [Path(value).expanduser().resolve() for value in
             (packet.get('output_dir'), os.environ.get('FACTORY_WORKSPACE')) if isinstance(value, str) and value]
    candidate = Path(record['path']).expanduser()
    if not candidate.is_absolute():
        if not roots:
            raise ScopeDenied('Artifact publication requires an authorized directory')
        candidate = roots[0] / candidate
    candidate = candidate.resolve()
    if not any(candidate.is_relative_to(root) for root in roots):
        raise ScopeDenied('Artifact path is outside output_dir and workspace')
    if not candidate.is_file():
        raise ValueError('Artifact path must name an existing file')
    return candidate


def dispatch(store, task_id, capability, packet):
    inputs = packet.get('inputs', {})
    if capability.startswith('lab.'):
        from .manager import Manager
        operation = capability.removeprefix('lab.')
        if operation not in {'submit', 'status', 'cancel', 'result', 'ab_submit', 'ab_status', 'ab_result'}:
            raise ValueError('Unknown lab capability')
        if hasattr(store, '_check'):
            store._check(task_id, write=True)
            host = store._store
        else:
            host = store
        manager = Manager(host, host.home / 'lab-spool')
        if operation == 'ab_submit':
            required = {'base_image', 'candidate_image', 'base_env', 'candidate_env', 'rounds', 'idem_key', 'component'}
            fields(inputs, required | {'contract_id'}, required)
            return manager.ab_submit(task_id, **inputs)
        if operation == 'submit':
            fields(inputs, {'image', 'build_attempt_id', 'contract_id', 'run_config', 'idem_key'},
                   {'image', 'build_attempt_id', 'contract_id', 'run_config', 'idem_key'})
            admission = manager.admit(task_id, inputs['image'], inputs['build_attempt_id'])
            attempt = manager.submit_run(task_id, admission['admission_id'], inputs['contract_id'],
                                         inputs['run_config'], inputs['idem_key'])
            return dict(admission=admission, **{k: attempt[k] for k in ('attempt_id', 'state', 'jobq_id')})
        fields(inputs, {'attempt_id'}, {'attempt_id'})
        attempt = manager.jobs._get(inputs['attempt_id'])
        if attempt['task_id'] != task_id or attempt['kind'] != 'lab':
            raise ScopeDenied('Lab attempt belongs to another task or capability')
        if operation.startswith('ab_') and attempt['request'].get('mode') != 'ab':
            raise ValueError('A/B operation requires an A/B attempt')
        return getattr(manager, operation)(inputs['attempt_id'])
    if capability.startswith('builder.'):
        from .builder import Builder
        operation = capability.removeprefix('builder.')
        if operation not in {'submit', 'status', 'cancel', 'result'}:
            raise ValueError('Unknown builder capability')
        # Unwrap only after enforcing the current task's write boundary. Read
        # grants must never allow cancellation or use of another task's build.
        if hasattr(store, '_check'):
            store._check(task_id, write=True)
            host = store._store
        else:
            host = store
        builder = Builder(host)
        if operation == 'submit':
            fields(inputs, {'request', 'idem_key'}, {'request', 'idem_key'})
            attempt = builder.submit(task_id, inputs['request'], inputs['idem_key'])
            return {key: attempt[key] for key in ('attempt_id', 'state', 'jobq_id')}
        fields(inputs, {'attempt_id'}, {'attempt_id'})
        attempt = builder.jobs._get(inputs['attempt_id'])
        if attempt['task_id'] != task_id:
            raise ScopeDenied('Attempt belongs to another task')
        return getattr(builder, operation)(inputs['attempt_id'])
    if capability == 'evidence.query':
        fields(inputs, {'kinds', 'text', 'since', 'limit', 'task_id'})
        options = dict(inputs)
        target = options.pop('task_id', task_id)
        return store.query(target, **options)
    if capability == 'evidence.read':
        fields(inputs, {'id', 'task_id'}, {'id'})
        if not isinstance(inputs['id'], str) or not inputs['id']:
            raise ValueError('id must be a nonempty string')
        if 'task_id' in inputs:
            return store.read(inputs['task_id'], inputs['id'])
        # The advertised interface needs only an evidence id. Prefer the
        # current task, then search explicitly granted tasks in stable order.
        for target in [task_id, *sorted(store.readable - {task_id})]:
            try:
                return store.read(target, inputs['id'])
            except NotFound:
                continue
        raise NotFound('Record not found')
    if capability != 'evidence.publish':
        raise ValueError('Unknown evidence capability')
    if not hasattr(store, '_check'):
        store = store.scoped(task_id)
    fields(inputs, {'type', 'record', 'expected_rev'}, {'type', 'record'})
    record = inputs['record']
    if not isinstance(record, dict):
        raise ValueError('record must be an object')
    record = dict(record)
    if record.get('task_id', task_id) != task_id:
        raise ScopeDenied('Publication belongs to another task')
    if inputs['type'] == 'observation':
        if 'expected_rev' in inputs:
            raise ValueError('expected_rev applies only to decisions')
        return store.append_observation(task_id, record)
    if inputs['type'] == 'decision':
        if 'expected_rev' in record and 'expected_rev' in inputs and record['expected_rev'] != inputs['expected_rev']:
            raise ValueError('Conflicting expected_rev values')
        expected_rev = record.pop('expected_rev', inputs.get('expected_rev'))
        if store.get_task(task_id).get('contract_id') == 'qwen36-bare-greedy-v1' or record.get('action', {}).get('type') in {'keep_component', 'keep_dormant', 'revert_component'}:
            from .controller import validate_action
            validate_action(record.get('action'))
        return store.advance_decision(task_id, expected_rev, record)
    if inputs['type'] == 'artifact':
        if 'expected_rev' in inputs:
            raise ValueError('expected_rev applies only to decisions')
        fields(record, {'task_id', 'artifact_id', 'path', 'text', 'media_type', 'producer_attempt'})
        source = artifact_source(record, packet)
        return store.put_artifact(task_id, record.get('artifact_id'), source,
                                  record.get('media_type', 'text/plain' if 'text' in record else 'application/octet-stream'),
                                  record.get('producer_attempt', packet.get('attempt')))
    raise ValueError('type must be observation, decision or artifact')


def input_reason(exc):
    """Keep actionable validation text while redacting configured credentials."""
    from .redact import sanitize
    return sanitize(str(exc))[:300]


def main():
    from . import telemetry
    started = time.perf_counter()
    packet, result, store = {}, None, None
    capability = sys.argv[1] if len(sys.argv) > 1 else ''
    task_id = os.environ.get('FACTORY_TASK_ID', '').strip()
    home = telemetry.home_path()
    telemetry.set_turn_env(home, task_id)
    try:
        if len(sys.argv) != 2:
            raise ValueError('One capability argument is required')
        packet = json.load(sys.stdin)
        if not isinstance(packet, dict):
            raise ValueError('Packet must be an object')
        if packet.get('capability', sys.argv[1]) != sys.argv[1]:
            raise ValueError('Packet capability differs from command')
        task_id = os.environ.get('FACTORY_TASK_ID', '').strip()
        if not task_id:
            raise ValueError('FACTORY_TASK_ID is required')
        readable = frozenset(t.strip() for t in os.environ.get('FACTORY_READ_TASKS', '').split(',') if t.strip())
        store = Store(home)
        if store:
            # Inspector dispatch: returns a native envelope, including failed
            # probes with their observation/artifact references (F04).
            if sys.argv[1].startswith('inspector.'):
                from .inspector import dispatch as inspector_dispatch
                result = inspector_dispatch(store.scoped(task_id), task_id, sys.argv[1], packet)
            else:
                outputs = dispatch(store.scoped(task_id, readable), task_id, sys.argv[1], packet)
                result = {'outcome': 'ok', 'outputs': outputs}
    except FactoryError as exc:
        result = {'outcome': 'error', 'error': {'code': exc.code, 'message': str(exc)}}
    except (ValueError, TypeError, KeyError, OverflowError, sqlite3.ProgrammingError) as exc:
        result = {'outcome': 'error', 'error': {'code': 'INVALID_INPUT', 'message': input_reason(exc)}}
    except (OSError, sqlite3.Error):
        result = {'outcome': 'error', 'error': {'code': 'PERSISTENCE_FAILED', 'message': 'Evidence persistence failed'}}
    except Exception as exc:  # never leave the capsule without a typed, explainable envelope
        import traceback
        from .redact import sanitize
        traceback.print_exc()
        result = {'outcome': 'error', 'error': {'code': 'INTERNAL_ERROR',
                  'message': sanitize(f'{type(exc).__name__}: {exc}')[:400]}}
    finally:
        telemetry.call(home, task_id, capability, packet, result or {'outcome': 'error'}, started, store=store)
        if store is not None:
            store.close()
    print(json.dumps(result, ensure_ascii=False, allow_nan=False))


if __name__ == '__main__':
    main()
"""Native factory CLI. Service imports are lazy; help and status stay offline."""
from __future__ import annotations

import argparse
import asyncio
import json
import sys

from .migration import check_legacy_config_or_exit


def format_status(value, plain=False, evidence=None):
    from .story import duration, evaluation_summary, paint, wrap
    import time
    decision = value.get('latest_decision') or {}
    used = value.get('budget_used', {})
    task = (evidence or {}).get('tasks', [{}])[0]
    limit = task.get('budget', value.get('budget', {}))
    lines = wrap(f"Task: {value['task_id']} · {value.get('outcome') or 'in progress'} · rev {decision.get('rev', 0)}")
    lines += wrap(f"Budget: {used.get('turns', 0)}/{limit.get('max_turns', '?')} turns · "
                  f"{duration(used.get('wall_clock_s', 0))}/{duration(limit['wall_clock_s']) if 'wall_clock_s' in limit else '?'}")
    action = decision.get('action', {})
    def compact(text):
        parts = wrap(text, '  ')
        if len(parts) > 3:
            return parts[:2] + [parts[2][:98] + ' …']
        return parts
    lines += ['Now']
    lines += compact(f"{action.get('type', 'awaiting decision')}: " +
                  str(action.get('next_bounded_operation', '')))
    lines += compact(decision.get('reason_for_change', ''))
    lines += ['Jobs']
    jobs = value.get('active_jobs', [])
    for job in jobs[:5]:
        history = job.get('history', [])
        since = job.get('started') or (history[0].get('created') if history else time.time())
        lines += wrap(f"{job.get('kind', '?')} · {job.get('state', '?')} · age {duration(time.time() - since)}", '  ')
    if len(jobs) > 5:
        lines += [f'  +{len(jobs) - 5} more jobs']
    if not jobs:
        lines += ['  idle']
    artifacts = value.get('artifacts', [])
    lines += ['Evidence']
    if evidence:
        counts = ', '.join(f'{k} {len(v)}' for k, v in evidence.items()
                           if isinstance(v, list) and k != 'events')
    else:
        counts = f"artifacts {len(artifacts)}, evaluations {len(value.get('evaluations', []))}"
    lines += wrap(counts + f" · {sum(a.get('size', 0) for a in artifacts)} bytes", '  ')
    lines += ['Last evaluation']
    evaluations = value.get('evaluations', [])
    lines += wrap(evaluation_summary(max(evaluations, key=lambda e: e.get('created', 0)))
                  if evaluations else 'none', '  ')
    lines += wrap('Readiness: ' + ' · '.join(f"{'✓' if ready else '✗'} {key}"
                  for key, ready in value.get('readiness', {}).items()))
    return '\n'.join(paint(line, plain) for line in lines)


def readonly_status(data):
    """Match Controller.status without initializing or mutating the live store."""
    from .story import ACTIVE
    import time
    task = data['tasks'][0]
    state = data['_meta'].get('controller_state', {})
    latest = max(data.get('decisions', []), key=lambda d: d['rev'], default=None)
    active = [a for a in data.get('attempts', []) if a['state'] in ACTIVE]
    return dict(task_id=task['task_id'], objective=task['objective'],
                outcome=state.get('outcome'), latest_decision=latest, active_jobs=active,
                artifacts=[{k: a[k] for k in ('artifact_id', 'media_type', 'size')}
                           for a in data.get('artifacts', [])], evaluations=data.get('evaluations', []),
                readiness=dict(decision_published=latest is not None, jobs_idle=not active,
                               evaluations_present=bool(data.get('evaluations'))),
                budget_used=dict(turns=state.get('turns', 0), wall_clock_s=max(0,
                    (state.get('finished') or time.time()) - state['started']) if state.get('started') is not None else 0),
                pending_attempts=state.get('pending_attempts', []), pending_questions=state.get('pending_questions', []))


async def auth(command, home):
    from .controller import configure_agent, scrub
    configure_agent({'task_id': 'auth', 'allowed_effects': []}, home=home)
    from jiuwenswarm.server.runtime.codex_subscription.service import get_service
    service = get_service()
    try:
        if command == 'login':
            started = await service.login()
            # Sign-in URL is intentionally shown; no auth tokens are printed.
            print('Open this URL to sign in:\n' + started['auth_url'], flush=True)
            for _ in range(180):
                await asyncio.sleep(2)
                result = await service.status()
                if result.get('state') not in {'signing_in', 'signed_out'}:
                    break
            else:
                raise ValueError('Timed out waiting for sign-in')
        else:
            result = await service.status()
        print(json.dumps(scrub(result), indent=2))
    finally:
        await service.transport.close()


def main(argv=None):
    check_legacy_config_or_exit()
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--home', help='factory home (default FACTORY_HOME or ~/.jiuwenswarm-factory)')
    sub = parser.add_subparsers(dest='command', required=True)
    init = sub.add_parser('init', help='initialize an operator task JSON')
    init.add_argument('task_file')
    for name in ('run', 'resume', 'status', 'show', 'cancel'):
        command = sub.add_parser(name)
        command.add_argument('task_id')
        if name in {'run', 'resume'}:
            command.add_argument('--grant', action='append', default=[], help='operator grant (repeatable; default none)')
        if name in {'status', 'show'}:
            command.add_argument('--json', action='store_true')
        command.add_argument('--plain', action='store_true')
        if name == 'show':
            command.add_argument('id', nargs='?', help='evidence record ID; omit to show all records')
    story = sub.add_parser('story', help='tell a task evidence story')
    story.add_argument('source')
    story.add_argument('--follow', action='store_true')
    story.add_argument('--plain', action='store_true')
    story.add_argument('--json', action='store_true')
    capsules = sub.add_parser('capsules', help='list factory Capability Capsules')
    capsules.add_argument('--plain', action='store_true')
    export = sub.add_parser('export', help='export a read-only sanitized evidence bundle')
    export.add_argument('task_id')
    export.add_argument('--out', required=True)
    export.add_argument('--extra-file', action='append', default=[])
    sub.add_parser('login', help='sign in under the factory data directory')
    sub.add_parser('auth-status', help='show factory account status without tokens')
    telemetry = sub.add_parser('telemetry', help='summarize capsule and controller telemetry')
    telemetry.add_argument('task_id', nargs='?')
    telemetry.add_argument('--json', action='store_true')
    telemetry.add_argument('--since')
    monitor = sub.add_parser('monitor', help='serve the read-only live factory monitor')
    monitor.add_argument('--port', type=int, default=8787)
    monitor.add_argument('--bind', default='127.0.0.1')
    for command in (telemetry, monitor):
        command.add_argument('--home', default=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    if args.command == 'telemetry':
        from .telemetry import show
        show(args.home, args.task_id, args.since, args.json)
        return
    if args.command == 'monitor':
        from .monitor import serve
        serve(args.home, args.bind, args.port)
        return
    if args.command == 'export':
        from .export import main as export_main
        export_main([args.task_id, '--out', args.out] + (['--home', args.home] if args.home else [])
                    + [arg for path in args.extra_file for arg in ('--extra-file', path)])
        return
    if args.command in {'story', 'capsules', 'status'}:
        from .store import FactoryError
        import sqlite3
        try:
            if args.command == 'story':
                from .story import show_story
                show_story(args.source, args.home, args.plain, args.json, args.follow)
            elif args.command == 'capsules':
                from .capsules import capsule_rows, format_capsules
                print(format_capsules(capsule_rows(), args.plain))
            else:
                from .story import load_source
                from .controller import scrub
                data = scrub(load_source(args.task_id, args.home))
                result = readonly_status(data)
                print(json.dumps(result, indent=2) if args.json else format_status(result, args.plain, data))
        except KeyboardInterrupt:
            raise SystemExit(130) from None
        except (FactoryError, ValueError, OSError, sqlite3.Error) as exc:
            print(str(exc), file=sys.stderr)
            raise SystemExit(2) from None
        return
    from .controller import Controller, factory_home, scrub
    from .store import FactoryError
    home = args.home or factory_home()
    controller = None
    try:
        if args.command in {'login', 'auth-status'}:
            asyncio.run(auth(args.command, home))
            return
        controller = Controller(home, grants=getattr(args, 'grant', []))
        if args.command == 'init':
            print(controller.init_task(args.task_file))
        elif args.command in {'run', 'resume'}:
            result = asyncio.run(getattr(controller, args.command)(args.task_id))
            print(format_status(scrub(result), args.plain, controller._snapshot(args.task_id)))
        elif args.command == 'show':
            result = (controller.store.read(args.task_id, args.id) if args.id
                      else controller.store.dump(args.task_id))
            print(json.dumps(scrub(result), indent=2, ensure_ascii=False))
        elif args.command == 'cancel':
            print(json.dumps(scrub(controller.cancel(args.task_id)), indent=2))
    except KeyboardInterrupt:
        raise SystemExit(130) from None
    except (FactoryError, ValueError, OSError) as exc:
        print(scrub(str(exc)), file=sys.stderr)
        raise SystemExit(2) from None
    finally:
        if controller:
            controller.store.close()


if __name__ == '__main__':
    main()
"""Read-only factory evidence views, shared by live stores and exported bundles."""
from __future__ import annotations

import json
import os
from pathlib import Path
import re
import sys
import shutil
import tempfile
import textwrap
import time

from .export import snapshot

TERMINAL = {'accept', 'reject', 'report_inconclusive', 'partial'}
ACTIVE = {'queued', 'running', 'cancel_requested', 'unknown'}


def wrap(value, indent=''):
    return textwrap.wrap(' '.join(str(value).splitlines()), width=100, initial_indent=indent,
                         subsequent_indent=indent, break_long_words=True, break_on_hyphens=False) or [indent]


def paint(line, plain=False):
    if plain or not sys.stdout.isatty() or 'NO_COLOR' in os.environ:
        return line
    color = '31' if '✗' in line else '32' if '✓' in line else '2'
    return f'\033[{color}m{line}\033[0m'


def short(value):
    return str(value or '?').removeprefix('sha256:').removeprefix('factory-')[:8]


def duration(seconds):
    seconds = max(0, int(seconds))
    return f'{seconds // 60:02d}:{seconds % 60:02d}'


def load_source(source, home=None):
    path = Path(source).expanduser()
    bundle = path.is_dir()
    home = Path(home or os.environ.get('FACTORY_HOME', '~/.jiuwenswarm-factory')).expanduser().resolve()
    if bundle:
        data = {p.stem: json.loads(p.read_text()) for p in sorted((path / 'records').glob('*.json'))}
        if not data.get('tasks'):
            raise ValueError('Bundle has no task records')
    else:
        # SQLite may create -shm even with mode=ro on a WAL database. Read a
        # stable copy so viewing evidence never creates files in factory home.
        for retry in range(5):
            paths = [home / 'factory.sqlite', home / 'factory.sqlite-wal']
            def stamps():
                return [(p.stat().st_size, p.stat().st_mtime_ns) if p.exists() else None for p in paths]
            before = stamps()
            with tempfile.TemporaryDirectory(prefix='factory-view-') as temporary:
                for p in paths:
                    if p.exists():
                        shutil.copyfile(p, Path(temporary) / p.name)
                if before != stamps():
                    continue
                data = snapshot(Path(temporary), source)
                break
        else:
            raise ValueError('Factory evidence changed during read; retry the view')
    task = data['tasks'][0]
    transcript = path / 'session.jsonl' if bundle else home / 'sessions' / (task['task_id'] + '.jsonl')
    turns, started, finished = 0, None, None
    turn_ends = []
    if transcript.is_file():
        for line in transcript.read_text().splitlines():
            event = json.loads(line)
            turns = max(turns, event.get('turn', 0))
            if event.get('event') == 'turn.start':
                try:
                    remaining = json.loads(event['query'])['remaining_budget']['wall_clock_s']
                    started = event['t'] - (task['budget']['wall_clock_s'] - remaining)
                except (KeyError, TypeError, ValueError):
                    pass
            if event.get('event') == 'turn.end':
                finished = event['t']
                turn_ends.append(finished)
    contract_id = task.get('contract_id')
    if contract_id:
        if bundle:
            contracts = [json.loads(p.read_text()) for p in (path / 'contracts').glob('*.json')]
            data['_contract'] = next((c for c in contracts if c.get('contract_id') == contract_id), {})
        else:
            from .contract import load
            try:
                data['_contract'] = dict(load(contract_id))
            except (ValueError, OSError, AttributeError):
                data['_contract'] = {}
    latest = max(data.get('decisions', []), key=lambda d: d['rev'], default={})
    outcome = latest.get('action', {}).get('type')
    data['_meta'] = dict(outcome=outcome if outcome in TERMINAL else None,
                         budget_used=dict(turns=turns, wall_clock_s=(finished - started)
                         if finished is not None and started is not None else 0))
    state = dict(turns=0, started=None, outcome=None)
    if not bundle:
        state_path = home / 'sessions' / (task['task_id'] + '.state.json')
        if state_path.is_file():
            state = json.loads(state_path.read_text())
            data['_meta'] = dict(outcome=state.get('outcome'), budget_used=dict(
                turns=state.get('turns', 0), wall_clock_s=max(0, (state.get('finished') or time.time())
                - state['started']) if state.get('started') is not None else 0))
    data['_meta']['controller_state'] = state
    data['_meta']['turn_ends'] = turn_ends
    return data


def flatten(value):
    result = {}
    if isinstance(value, dict):
        for key, item in value.items():
            if isinstance(item, dict):
                result.update(flatten(item))
            elif key not in {'type', 'next_bounded_operation'}:
                result[key] = item
    return result


def evaluation_summary(record):
    inputs = record.get('inputs', {})
    if 'ab_result' in inputs:
        ab = inputs['ab_result']
        return (f"{record.get('contract_id')} · {record.get('correctness')} · "
                f"{record.get('execution_outcome')} · gate {ab.get('gate')} · "
                f"ratio {ab.get('ratio')} · output {ab.get('output_class')}")
    run = inputs.get('run', inputs)
    details = run.get('details', inputs.get('details', {}))
    checks = details.get('engagement_checks', {})
    contract = record.get('contract', {})
    contract = contract.get('snapshot', contract)
    candidate = run.get('stdout_sha256', '?')
    reference = (contract.get('reference') or {}).get('stdout_sha256', '?')
    relation = '==' if candidate == reference and candidate != '?' else 'vs'
    return (f"{record.get('contract_id', '?')} · {record.get('correctness', '?')} · "
            f"{record.get('execution_outcome', '?')} · {record.get('evidence_completeness', '?')} · "
            f"stdout {short(candidate)} {relation} reference {short(reference)}"
            + (f" · engagement {sum(v is True for v in checks.values())}/{len(checks)}" if checks else ''))


def build_events(data):
    events = []

    def add(created, key, kind, summary, mark='·', rev=None):
        events.append(dict(created=created or 0, id=key, kind=kind, summary=summary, mark=mark, rev=rev))

    previous = flatten(data['tasks'][0].get('initial_run_config', {}))
    previous_action = {}
    # Observed requested config is useful even when decisions use prose actions.
    configs = sorted([(r.get('created', 0), flatten(r.get('values', {}).get('requested', {})))
                      for r in data.get('observations', []) if r.get('values', {}).get('requested')])
    decisions = sorted(data.get('decisions', []), key=lambda d: d['rev'])
    for i, d in enumerate(decisions):
        action = d.get('action', {})
        current = flatten(action)
        prose = str(action.get('next_bounded_operation', ''))
        for key in previous:
            match = re.search(re.escape(key) + r'\s+(?:changed?\s+to|[=:]|from\s+\S+\s+to)\s*[\"\']?([\w.-]+)', prose)
            if match:
                current[key] = match.group(1).rstrip('.')
        end = decisions[i + 1]['created'] if i + 1 < len(decisions) else float('inf')
        for at, config in configs:
            if d['created'] <= at < end:
                current.update(config)
        # Only run-config switches (ENV_STYLE names) count as a replan diff, not prose fields.
        changes = [f'{k} {previous[k]} → {v}' for k, v in current.items()
                   if k in previous and previous[k] != v and re.fullmatch(r'[A-Z][A-Z0-9_]*', k)]
        kind = action.get('type', 'decide')
        failure = next((e for e in d.get('evidence_ids', []) if any(
            o.get('obs_id') == e and o.get('error') for o in data.get('observations', []))), None)
        step = str(action.get('next_operation') or action.get('next_bounded_operation') or '')
        step = re.split(r'(?<=[.;])\s', step, maxsplit=1)[0].rstrip('.;')
        summary = '; '.join(changes) or step or d.get('reason_for_change', '').split(';')[0]
        if action.get('component') and kind not in {'keep_component', 'keep_dormant', 'revert_component'}:
            summary = f"{action['component']} · {summary}"
        if failure:
            summary += ' · because ' + short(failure)
        if kind in {'keep_component', 'keep_dormant', 'revert_component'}:
            changes = []
            ratio = action.get('ratio')
            summary = {'keep_component': f"keep {action.get('component')} · "
                                         f"{ratio:.2f}× · image {short(str(action.get('image')))}"
                                         if isinstance(ratio, (int, float)) else f"keep {action.get('component')}",
                       'keep_dormant': f"dormant {action.get('component')} · switch off · needed by "
                                       + ', '.join(action.get('needed_by') or []),
                       'revert_component': f"revert {action.get('component')} · {action.get('reason')}"}[kind]
        if kind in TERMINAL:
            changes = []
            summary = d.get('reason_for_change', '')
        add(d['created'], d['decision_id'], ('replan/' + kind) if changes or failure else kind,
            summary, rev=d['rev'])
        previous.update(current)
    for r in data.get('observations', []):
        v = r.get('values', {})
        error = r.get('error') or {}
        failed = bool(error.get('code') or v.get('code') or v.get('state') == 'failed')
        kind, summary = r.get('kind', 'observation'), ''
        mark = '✗' if failed else '·'
        if failed:
            if kind.startswith('inspector.'):
                kind = 'inspect'
            summary = f"{error.get('code', v.get('code', 'FAILED'))} {error.get('message', v.get('message', ''))}"
        elif kind == 'ab_result':
            mark = '✓' if v.get('gate') == 'improved' else '·'
            summary = (f"{v.get('component')} · gate {v.get('gate')} · ratio {v.get('ratio')} · "
                       f"A/A {v.get('aa_gap')} · output {v.get('output_class')} · ms/token {v.get('per_arm_ms')}")
        elif kind == 'build_result':
            kind, mark = 'build', '✓' if v.get('status') == 'success' else '✗'
            summary = (f"{short(r.get('host_run', {}).get('attempt_id'))} · "
                       f"{round(v['build_wall_seconds']) if isinstance(v.get('build_wall_seconds'), (int, float)) else '?'} s → image {short(v.get('image_id'))}")
        elif kind == 'inspector.inspect':
            source = v.get('source', {})
            kind, mark = 'integrate', '✓' if source.get('commit') else '·'
            patches = ', '.join(p.get('name', '?') for p in source.get('applied_patches', []))
            summary = f"commit {short(source.get('commit'))} · {patches}"
        elif kind == 'lab_result':
            kind, mark = 'lab', '✓' if v.get('execution_outcome') == 'ok' else '✗'
            details = v.get('details', {})
            contract = data.get('_contract', {})
            argv = contract.get('workload', {}).get('argv', [])
            tokens = argv[argv.index('-n') + 1] if '-n' in argv and argv.index('-n') + 1 < len(argv) else '?'
            speed = details.get('eval_ms_per_token', '?')
            summary = (f"{tokens} tokens · {speed} ms/token · "
                       f"{v.get('execution_outcome', '?')} · {details.get('worker', {}).get('cleanup', '?')}")
            nsys = details.get('nsys') or {}
            if details.get('traced'):
                kernels = (nsys.get('kernels') or {}).get('total_ms')
                top = ((nsys.get('os_runtime') or {}).get('top') or [{}])[0].get('name')
                summary = (f"{tokens} tokens · TRACED (timing perturbed) · GPU kernels {kernels} ms"
                           f" · top OS call {top} · {v.get('execution_outcome', '?')}")
        elif kind.startswith('inspector.'):
            kind, mark = 'inspect', '✓'
            effective = v.get('effective', {})
            from .effective_config import ENV_KEYS, DEFAULTS
            requested = {ENV_KEYS.get(k, k) for k in v.get('requested', {})}
            priority = ['k', 'pregate', 'fill']
            keys = priority + [k for k in effective if k not in priority]
            settings = [f'{k}={effective[k]}' for k in keys if k in effective
                        and (k in requested or str(effective[k]) != DEFAULTS.get(k))]
            shown = []
            for setting in settings:
                if len('effective ' + ' · '.join([*shown, setting]) + ' · … · matches request') > 74:
                    shown.append('…')
                    break
                shown.append(setting)
            summary = 'effective ' + ' · '.join(shown) + ' · matches request' if effective else r['kind']
        else:
            summary = v.get('message', r.get('limitations', '') or kind)
        add(r.get('created'), r['obs_id'], kind, summary, mark)
    for a in data.get('attempts', []):
        history = a.get('history', []) or [dict(state=a.get('state'), created=a.get('started'))]
        for index, h in enumerate(history):
            state = h.get('state', 'unknown')
            mark = '✓' if state == 'succeeded' else '✗' if state in {'failed', 'cancelled'} else '·'
            survived = state == 'succeeded' and any(
                (history[0].get('created') or 0) < end < (h.get('created') or 0)
                for end in data.get('_meta', {}).get('turn_ends', []))
            suffix = ' · survived turn end' if survived else ''
            add(h.get('created'), a['attempt_id'] + ':' + str(index), a.get('kind', 'job'),
                f"{short(a['attempt_id'])} {state} · durable job{suffix}", mark)
        admission = a.get('request', {}).get('admission')
        if admission:
            add(history[0].get('created'), a['attempt_id'] + ':admission', 'admit',
                f"{short(str(admission.get('admission_id', '?')).removeprefix('admission:'))} · image {short(admission.get('image', {}).get('id'))}"
                f" · target {admission.get('target_profile', '?')}", '✓')
    for r in data.get('uploads', []):
        add(r.get('created'), r['upload_id'], 'upload', r.get('ack_state', '?'),
            '✓' if r.get('ack_state') == 'durable' else '·')
    for r in data.get('evaluations', []):
        add(r.get('created'), r['eval_id'], 'contract', evaluation_summary(r),
            '✓' if r.get('correctness') == 'pass' else '✗')
    for kind, records in data.items():
        if kind in {'tasks', 'decisions', 'observations', 'attempts', 'uploads', 'evaluations', 'artifacts', 'events', '_meta', '_contract'}:
            continue
        if isinstance(records, list):
            for i, r in enumerate(records):
                add(r.get('created'), f'{kind}:{i}', kind, r.get('message', 'record'))
    for r in data.get('events', []):
        if r.get('type', r.get('kind')) not in {'task', 'decision', 'observation', 'attempt', 'upload', 'evaluation', 'artifact'}:
            add(r.get('created'), 'event:' + str(r.get('cursor')), r.get('kind', 'unknown'), 'record')
    return sorted(events, key=lambda e: (e['created'], e['id']))


def event_lines(event, created):
    badge = f"rev {event['rev']}" if event['rev'] is not None else event['mark']
    prefix = f" {duration(event['created'] - created)}  {badge:5} {event['kind']:10} "
    content = ' '.join(str(event['summary']).split())
    lines = textwrap.wrap(prefix + content, width=100, subsequent_indent=' ' * 25,
                          break_long_words=False, break_on_hyphens=False)
    if event['kind'] in TERMINAL and len(lines) > 3:
        lines = lines[:3]
        lines[-1] = textwrap.shorten(lines[-1].strip(), width=74, placeholder='…') + '…'
        lines[-1] = ' ' * 25 + lines[-1]
    return lines


def header(data):
    task, meta = data['tasks'][0], data['_meta']
    contract = data.get('_contract') or next((a.get('request', {}).get('contract') for a in data.get('attempts', [])
                     if a.get('request', {}).get('contract')), {})
    if not contract and data.get('evaluations'):
        contract = data['evaluations'][-1].get('contract', {})
        contract = contract.get('snapshot', contract)
    name = Path(contract.get('model', {}).get('path', 'model unknown')).stem
    name = re.sub(r'-(?:UD-)?(?:I?Q\d.*|F(?:16|32)|BF16)$', '', name, flags=re.I)
    used = meta['budget_used']
    return wrap(f" factory · {short(task['task_id'])} · {name} on {task.get('target', '?')} · "
                f"{(meta['outcome'] or 'in progress').upper()} · {used['turns']} turns · "
                f"{duration(round(used['wall_clock_s']))}") + [' ' + '─' * 98]


def chain_links(data):
    """The evidence chain component → … → evaluation as (link, mark) pairs; mark is ✓, ✗ or ·."""
    task = data['tasks'][0]
    attempts = data.get('attempts', [])
    builds = [a for a in attempts if a.get('kind') == 'build']
    labs = [a for a in attempts if a.get('kind') == 'lab']
    values = [o.get('values', {}) for o in data.get('observations', [])]
    def jobmark(jobs):
        return '✓' if any(a.get('state') == 'succeeded' for a in jobs) else '✗' if any(a.get('state') in {'failed', 'cancelled'} for a in jobs) else '·'
    links = [('component', '✓' if task.get('component_cc') else '·'),
             ('commit', '✓' if any(v.get('source', {}).get('commit') for v in values) or any(a.get('request', {}).get('source', {}).get('commit') for a in builds) else '·'),
             ('build', jobmark(builds)),
             ('image', '✓' if any(v.get('image_id') for v in values) else '·'),
             ('admission', '✓' if any(a.get('request', {}).get('admission') for a in labs) else '·'),
             ('lab', jobmark(labs)),
             ('evaluation', '✓' if any(e.get('correctness') == 'pass' for e in data.get('evaluations', [])) else '✗' if data.get('evaluations') else '·')]
    return links


def footer(data):
    stack = []
    if any(d.get('action', {}).get('type') in {'keep_component', 'keep_dormant', 'revert_component'}
           for d in data.get('decisions', [])):
        stack = wrap('engine stack: ' + ' → '.join(decision_stack(data)))
    links = chain_links(data)
    artifacts = data.get('artifacts', [])
    count = sum(len(v) for k, v in data.items() if isinstance(v, list) and k != 'events')
    return stack + wrap('chain: ' + ' → '.join(f'{name} {mark}' for name, mark in links)) + wrap(
        f"evidence: {count} records · {len(artifacts)} artifacts · {sum(a.get('size', 0) for a in artifacts)} bytes")


def decision_stack(data):
    stack = [data['tasks'][0].get('source', {}).get('pre_integration_commit') or 'bare']
    for d in sorted(data.get('decisions', []), key=lambda d: d['rev']):
        action = d.get('action', {})
        name = action.get('component')
        if action.get('type') == 'keep_component' and name not in stack:
            stack.append(name)
        elif action.get('type') == 'keep_dormant' and name not in stack:
            stack.append(name + ' (off)')
        elif action.get('type') == 'revert_component' and name in stack[1:]:
            stack.remove(name)
    return stack


def render_story(data, plain=False):
    lines = header(data)
    for event in build_events(data):
        lines.extend(event_lines(event, data['tasks'][0]['created']))
    return '\n'.join(paint(line, plain) for line in lines + footer(data))


def show_story(source, home=None, plain=False, as_json=False, follow=False):
    if follow and Path(source).expanduser().is_dir():
        raise ValueError('--follow requires a live task id')
    if follow and as_json:
        raise ValueError('--follow and --json cannot be combined')
    seen = set()
    first = True
    while True:
        data = load_source(source, home)
        events = build_events(data)
        if as_json:
            print(json.dumps(events, indent=2, ensure_ascii=False))
            return
        lines = header(data) if first else []
        for event in events:
            if event['id'] not in seen:
                lines.extend(event_lines(event, data['tasks'][0]['created']))
                seen.add(event['id'])
        if not follow or data['_meta']['outcome']:
            lines.extend(footer(data))
        for line in lines:
            print(paint(line, plain), flush=True)
        if not follow or data['_meta']['outcome']:
            return
        first = False
        time.sleep(2)
"""Read-only stdlib live monitor. No model calls, reconciliation or Store initialization."""
from contextlib import closing
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
from pathlib import Path
import shutil
import sqlite3
import tempfile
from urllib.parse import parse_qs, urlsplit
from .store import FactoryError
from .redact import sanitize
from .story import load_source, build_events, chain_links, ACTIVE
from .telemetry import home_path, read_events


def tasks(home):
    # Copy WAL and DB using the same stable read discipline as story.
    paths = [home / 'factory.sqlite', home / 'factory.sqlite-wal']
    if not paths[0].exists():
        return []
    def stamps():
        return [(p.stat().st_size, p.stat().st_mtime_ns) if p.exists() else None for p in paths]
    for _ in range(5):
        before = stamps()
        with tempfile.TemporaryDirectory(prefix='factory-monitor-') as directory:
            for p in paths:
                if p.exists():
                    shutil.copyfile(p, Path(directory) / p.name)
            if before != stamps():
                continue
            with closing(sqlite3.connect(Path(directory) / 'factory.sqlite')) as db:
                db.row_factory = sqlite3.Row
                return [dict(row) for row in db.execute('SELECT task_id,objective,created FROM tasks ORDER BY created DESC')]
    raise ValueError('Store changed during read; retry')


STATES = {'integrate': 'integrating', 'build': 'building', 'measure': 'measuring',
          'keep_component': 'kept', 'keep_dormant': 'dormant', 'revert_component': 'reverted'}


def engine_stack(data):
    """Base engine plus each component the agent named in a decision, in first-mention order.
    Speeds come from the component's A/B result (or, for a single-component task, its last lab run)."""
    task = data['tasks'][0]
    base = dict(name=task.get('source', {}).get('pre_integration_commit') or 'bare engine',
                state='base', ms_per_token=None, ratio=None)
    rows = {}
    for decision in sorted(data.get('decisions', []), key=lambda d: d['rev']):
        action = decision.get('action', {})
        name, kind = action.get('component'), action.get('type')
        if name and kind in STATES:
            row = rows.setdefault(name, dict(name=name, state=None, ms_per_token=None, ratio=None))
            row['state'] = STATES[kind]
            if kind in {'keep_component', 'keep_dormant', 'revert_component'}:
                row.update(reason=action.get('reason'), ratio=action.get('ratio', row['ratio']))
    for obs in data.get('observations', []):
        values = obs.get('values', {})
        if obs.get('kind') == 'ab_result' and values.get('component'):
            row = rows.setdefault(values['component'], dict(name=values['component'], state='measuring',
                                                            ms_per_token=None, ratio=None))
            arms = values.get('per_arm_ms') or {}
            row.update(ms_per_token=arms.get('candidate'), gate=values.get('gate'))
            row['ratio'] = row['ratio'] or values.get('ratio')
            base['ms_per_token'] = base['ms_per_token'] or arms.get('base')
    if not rows and task.get('component_cc'):
        # Single-component task (the recorded demo): its outcome and last lab speed.
        evaluations = data.get('evaluations', [])
        speed = (evaluations[-1].get('inputs', {}).get('run', {}).get('details', {}).get('eval_ms_per_token')
                 if evaluations else None)
        outcome = data['_meta'].get('outcome')
        rows[task['component_cc']] = dict(name=task['component_cc'], ms_per_token=speed, ratio=None,
            state='kept' if outcome == 'accept' else 'reverted' if outcome in {'reject', 'report_inconclusive'}
            else 'integrating')
    stack = [base, *rows.values()]
    for row in stack[1:]:
        if row['ratio'] is None and base['ms_per_token'] and row['ms_per_token']:
            row['ratio'] = base['ms_per_token'] / row['ms_per_token']
    return stack


def tail(home, attempt):
    """Last lines of whatever the attempt is writing right now: its build log, lab stderr or jobq log."""
    aid = attempt['attempt_id']
    roots = [p for pattern in (f'builds/{aid}*', f'lab-spool/{aid}*') for p in home.glob(pattern)]
    qdir = attempt.get('resources', {}).get('jobq_dir')
    files = [p for root in roots for p in root.rglob('*')
             if p.is_file() and (p.suffix in {'.log', '.stdout', '.stderr'} or p.name == 'stderr.txt')]
    if qdir and attempt.get('jobq_id'):
        files.append(Path(qdir) / (Path(attempt['jobq_id']).name + '.log'))
    files = [p for p in files if p.is_file() and p.stat().st_size]
    if not files:
        return []
    newest = max(files, key=lambda p: p.stat().st_mtime)
    with newest.open('rb') as stream:
        stream.seek(max(0, newest.stat().st_size - 4096))
        lines = stream.read().decode(errors='replace').splitlines()[-14:]
    return [line[:160] for line in lines]


def job(home, attempt_id):
    for task in tasks(home):
        for attempt in load_source(task['task_id'], home).get('attempts', []):
            if attempt['attempt_id'] == attempt_id:
                return dict(attempt=attempt, state=attempt['state'], log=tail(home, attempt))
    raise ValueError('Attempt not found')


def make_handler(home=None):
    home = home_path(home)
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def do_GET(self):
            url = urlsplit(self.path)
            query = parse_qs(url.query)
            def arg(key):
                return query.get(key, [''])[0]
            try:
                if url.path == '/':
                    body, mime = HTML.encode(), 'text/html; charset=utf-8'
                else:
                    if url.path == '/api/tasks':
                        value = tasks(home)
                    elif url.path == '/api/story':
                        data = load_source(arg('task'), home)
                        value = dict(events=build_events(data), task=data['tasks'][0], meta=data['_meta'], chain=chain_links(data),
                                     engine_stack=engine_stack(data), latest_decision=max(data.get('decisions', []), key=lambda d: d['rev'], default=None),
                                     active_jobs=[a for a in data.get('attempts', []) if a['state'] in ACTIVE])
                    elif url.path == '/api/telemetry':
                        value = read_events(home, arg('task') or None, arg('since'))
                    elif url.path == '/api/job':
                        value = job(home, arg('attempt'))
                    else:
                        self.send_error(404)
                        return
                    body, mime = json.dumps(sanitize(value), ensure_ascii=False).encode(), 'application/json; charset=utf-8'
                self.send_response(200)
                self.send_header('Content-Type', mime)
                self.send_header('Content-Length', str(len(body)))
                self.send_header('Cache-Control', 'no-store')
                self.end_headers()
                self.wfile.write(body)
            except (FactoryError, ValueError, OSError, sqlite3.Error, KeyError) as exc:
                body = json.dumps(dict(error=sanitize(str(exc)))).encode()
                self.send_response(400)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Content-Length', str(len(body)))
                self.end_headers()
                self.wfile.write(body)
    return Handler


def make_server(home=None, bind='127.0.0.1', port=8787):
    return ThreadingHTTPServer((bind, port), make_handler(home))


def serve(home=None, bind='127.0.0.1', port=8787):
    with make_server(home, bind, port) as server:
        print(f'Factory monitor listening on {server.server_address[0]}:{server.server_address[1]}', flush=True)
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            pass


HTML = (Path(__file__).with_name('monitor.html')).read_text()

