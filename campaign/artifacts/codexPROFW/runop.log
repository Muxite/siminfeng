{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"mkdir -p cc/profilers/tests\ncat > cc/profilers/ncu_summary.py <<'PY'\n\\\"\\\"\\\"Summarize long-form Nsight Compute CSV without NVIDIA tooling.\\\"\\\"\\\"\nimport argparse\nimport csv\nimport io\nimport json\nimport math\nfrom pathlib import Path\nimport re\n\nTIME = 'gpu__time_duration.sum'\nREAD = 'dram__bytes_read.sum'\nWRITE = 'dram__bytes_write.sum'\nDRAM = 'dram__throughput.avg.pct_of_peak_sustained_elapsed'\nSM = 'sm__throughput.avg.pct_of_peak_sustained_elapsed'\nMETRICS = (TIME, READ, DRAM, SM)\n\n\ndef quantity(value, unit, kind):\n    factors = {'time': {'ns': 1e-9, 'us': 1e-6, 'µs': 1e-6, 'ms': 1e-3, 's': 1},\n               'bytes': {'byte': 1, 'Kbyte': 1e3, 'Mbyte': 1e6, 'Gbyte': 1e9},\n               'percent': {'%': 1}}[kind]\n    if unit not in factors:\n        raise ValueError(f'unsupported {kind} unit: {unit\"'!r}'\"')\n    result = float(value.replace(',', '')) * factors[unit]\n    if not math.isfinite(result) or result < 0:\n        raise ValueError(f'invalid metric value: {value\"'!r}'\"')\n    return result\n\n\ndef kernel_class(name):\n    \\\"\\\"\\\"Group template instantiations by function, preserving distinct functions.\\\"\\\"\\\"\n    match = re.search(r'([\\\\w:]+)\\\\s*(?:<|\\\\()', name)\n    return match.group(1) if match else name.strip()\n\n\ndef summarize(source):\n    lines = [line for line in source.splitlines() if line.strip() and not line.startswith('==')]\n    reader = csv.DictReader(io.StringIO('\\\\n'.join(lines)))\n    required = {'ID', 'Process ID', 'Kernel Name', 'Metric Name', 'Metric Unit', 'Metric Value'}\n    if not required.issubset(reader.fieldnames or []):\n        raise ValueError('missing ncu CSV header columns')\n    launches = {}\n    for row in reader:\n        if row['ID'] == 'ID':  # repeated export header\n            continue\n        metric = row['Metric Name']\n        if metric not in (*METRICS, WRITE):\n            continue\n        key = (row['Process ID'], row['ID'])\n        launch = launches.setdefault(key, {'name': row['Kernel Name'], 'metrics': {}})\n        if launch['name'] \"'!= row['\"'Kernel Name'] or metric in launch['metrics']:\n            raise ValueError(f'ambiguous duplicate launch/metric: {key}, {metric}')\n        kind = 'time' if metric == TIME else 'bytes' if metric in (READ, WRITE) else 'percent'\n        launch['metrics'][metric] = quantity(row['Metric Value'], row['Metric Unit'], kind)\n    if not launches:\n        raise ValueError('no kernel metrics')\n    groups = {}\n    tiny_time = tiny_count = 0\n    for launch in launches.values():\n        metrics = launch['metrics']\n        if not set(METRICS).issubset(metrics):\n            raise ValueError(f'incomplete metrics for {launch[\\\"name\\\"]}')\n        duration = metrics[TIME]\n        if duration <= 0:\n            raise ValueError('kernel duration must be positive')\n        tiny = duration < 5e-6 and metrics[DRAM] < 5\n        tiny_count += int(tiny)\n        tiny_time += duration if tiny else 0\n        group = groups.setdefault(kernel_class(launch['name']), dict(count=0, time_s=0.,\n            read_bytes=0., write_bytes=0., dram_weight=0., sm_weight=0., launch_bound_count=0,\n            launch_bound_time_s=0.))\n        group['count'] += 1\n        group['time_s'] += duration\n        group['read_bytes'] += metrics[READ]\n        group['write_bytes'] += metrics.get(WRITE, 0)\n        group['dram_weight'] += duration * metrics[DRAM]\n        group['sm_weight'] += duration * metrics[SM]\n        group['launch_bound_count'] += int(tiny)\n        group['launch_bound_time_s'] += duration if tiny else 0\n    total = sum(g['time_s'] for g in groups.values())\n    for group in groups.values():\n        group['time_share'] = group['time_s'] / total\n        group['GB_s'] = (group['read_bytes'] + group['write_bytes']) / group['time_s'] / 1e9\n        group['dram_pct'] = group.pop('dram_weight') / group['time_s']\n        group['sm_pct'] = group.pop('sm_weight') / group['time_s']\n        group['launch_bound'] = group['launch_bound_count'] == group['count']\n    return dict(kernels=len(launches), time_s=total,\n                effective_GB_s=sum(g['read_bytes'] + g['write_bytes'] for g in groups.values()) / total / 1e9,\n                byte_scope='read+write' if any(WRITE in x['metrics'] for x in launches.values()) else 'read',\n                launch_bound_count=tiny_count, launch_bound_time_share=tiny_time / total,\n                classes=dict(sorted(groups.items())))\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('csv', type=Path)\n    args = parser.parse_args()\n    print(json.dumps(summarize(args.csv.read_text()), indent=2))\n\n\nif __name__ == '__main__':\n    main()\nPY\ncat > cc/profilers/bpf_split_timer.py <<'PY'\n\\\"\\\"\\\"Generate CPU graph uprobes and parse bpftrace's aggregate output.\\\"\\\"\\\"\nimport argparse\nimport json\nimport math\nfrom pathlib import Path\nimport re\nimport shlex\n\n\ndef positive(value):\n    value = float(value)\n    if not math.isfinite(value) or value <= 0:\n        raise ValueError('duration and tokens/s must be positive and finite')\n    return value\n\n\ndef script(pid, library, seconds=5, per_thread=False):\n    seconds = positive(seconds)\n    if int(pid) <= 0 or not re.fullmatch(r'/[\\\\w/+.\\\\-]+', library):\n        raise ValueError('positive host PID and an absolute, literal library path required')\n    thread = '\\\\n  @thread_graphs[tid] = count();\\\\n  @thread_tot_us[tid] = sum(\"'$us);'\"' if per_thread else ''\n    return f'''// PROFW v1: elapsed graph-call time, not summed worker CPU time.\nuprobe:{library}:ggml_graph_compute /pid == {int(pid)}/ {{\n  @s[tid] = nsecs;\n}}\nuretprobe:{library}:ggml_graph_compute /pid == {int(pid)} && @s[tid]/ {{\n  \"'$us = (nsecs - @s[tid]) / 1000;\n  @graphs = count();\n  @graph_tot_us = sum($us);\n  @graph_us = hist($us);{thread}\n  delete(@s[tid]);\n}}\ninterval:ms:{max(1, round(seconds * 1000))} {{ exit(); }}\nEND {{\n  printf(\"PROFW window_s={max(1, round(seconds * 1000)) / 1000}'\"\\\\\\\\n\\\");\n  clear(@s);\n}}\n'''\n\n\ndef container_command(container, seconds=5, per_thread=False):\n    \\\"\\\"\\\"Emit a shell recipe; do not inspect Docker or invoke sudo here.\\\"\\\"\\\"\n    command = ['python3', str(Path(__file__).resolve()), 'script', '--pid', '\\\"\"'$pid\"'\"',\n               '--library', '\\\"\"'$library\"'\"', '--seconds', str(positive(seconds))]\n    if per_thread:\n        command.append('--per-thread')\n    invocation = ' '.join(x if x in ('\\\"\"'$pid\"'\"', '\\\"\"'$library\"'\"') else shlex.quote(x) for x in command)\n    return f'''set -eu\npid=\"'$(docker inspect -f '\"'{{{{.State.Pid}}}}' {shlex.quote(container)})\n[ \\\"\"'$pid\" -gt 0 ]\nlibraries=$(readlink -e /proc/\"$pid\"/root/app/libggml-cpu.so.* | sort -u)\n[ \"$(printf '\"'%s\\\\\\\\n' \\\"\"'$libraries\" | wc -l)\" -eq 1 ]\n[ -n \"$libraries\" ]\nlibrary=\"$libraries\"\n{invocation} | sudo bpftrace -\n'\"'''\n\n\ndef parse(source, seconds=None, tokens_per_second=None):\n    if seconds is None:\n        window = re.search(r'\"'^PROFW window_s=(['\"\\\\d.]+)\"'$'\"', source, re.M)\n        if not window:\n            raise ValueError('legacy captures require explicit --seconds')\n        seconds = float(window[1])\n    seconds = positive(seconds)\n    def scalar(name):\n        matches = re.findall(rf'\"'^@{name}:'\"\\\\s*(\\\\d+)\\\\s*\"'$'\"', source, re.M)\n        if len(matches) \"'!= 1:\n            raise ValueError(f'\"'expected one @{name} aggregate')\n        return int(matches[0])\n    count, total_us = scalar('graphs'), scalar('graph_tot_us')\n    hist = []\n    section = re.search(r'\"'^@graph_us:'\"\\\\s*\\\\n((?:\\\\[[\"'^'\"\\\\n]*\\\\n?)+)', source, re.M)\n    def bound(value):\n        match = re.fullmatch(r'(\\\\d+)([KM]?)', value.strip())\n        if not match:\n            raise ValueError(f'invalid histogram bound: {value}')\n        return int(match[1]) * {'': 1, 'K': 1024, 'M': 1024**2}[match[2]]\n    if section:\n        for low, high, n in re.findall(r'\"'^'\"\\\\[([\"'^,]+),'\"\\\\s*([\"'^'\"\\\\)]+)\\\\)\\\\s+(\\\\d+)', section[1], re.M):\n            hist.append(dict(low_us=bound(low), high_us=bound(high), count=int(n)))\n    if sum(b['count'] for b in hist) \"'!= count:\n        raise ValueError('\"'histogram does not account for every completed split')\n    threads = {}\n    for name, tid, value in re.findall(r'\"'^@thread_(graphs|tot_us)'\"\\\\[(\\\\d+)\\\\]:\\\\s*(\\\\d+)\"'$'\"', source, re.M):\n        threads.setdefault(tid, {})[name] = int(value)\n    return dict(splits=count, splits_per_token=count / (seconds * positive(tokens_per_second))\n                if tokens_per_second is not None else None,\n                cpu_time_frac=total_us / (seconds * 1e6), hist=hist,\n                window_s=seconds, total_us=total_us, mean_us=total_us / count if count else None,\n                threads=threads)\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    sub = parser.add_subparsers(dest='mode', required=True)\n    for mode in ('script', 'container'):\n        child = sub.add_parser(mode)\n        child.add_argument('--seconds', type=float, default=5)\n        child.add_argument('--per-thread', action='store_true')\n        if mode == 'script':\n            child.add_argument('--pid', type=int, required=True)\n            child.add_argument('--library', required=True)\n        else:\n            child.add_argument('--container', required=True)\n    child = sub.add_parser('parse')\n    child.add_argument('input', type=Path)\n    child.add_argument('--seconds', type=float)\n    child.add_argument('--tokens-per-second', type=float)\n    args = parser.parse_args()\n    if args.mode == 'parse':\n        print(json.dumps(parse(args.input.read_text(), args.seconds, args.tokens_per_second), indent=2))\n    elif args.mode == 'script':\n        print(script(args.pid, args.library, args.seconds, args.per_thread), end='')\n    else:\n        print(container_command(args.container, args.seconds, args.per_thread), end='')\n\n\nif __name__ == '__main__':\n    main()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"mkdir -p cc/profilers/tests\ncat > cc/profilers/ncu_summary.py <<'PY'\n\\\"\\\"\\\"Summarize long-form Nsight Compute CSV without NVIDIA tooling.\\\"\\\"\\\"\nimport argparse\nimport csv\nimport io\nimport json\nimport math\nfrom pathlib import Path\nimport re\n\nTIME = 'gpu__time_duration.sum'\nREAD = 'dram__bytes_read.sum'\nWRITE = 'dram__bytes_write.sum'\nDRAM = 'dram__throughput.avg.pct_of_peak_sustained_elapsed'\nSM = 'sm__throughput.avg.pct_of_peak_sustained_elapsed'\nMETRICS = (TIME, READ, DRAM, SM)\n\n\ndef quantity(value, unit, kind):\n    factors = {'time': {'ns': 1e-9, 'us': 1e-6, 'µs': 1e-6, 'ms': 1e-3, 's': 1},\n               'bytes': {'byte': 1, 'Kbyte': 1e3, 'Mbyte': 1e6, 'Gbyte': 1e9},\n               'percent': {'%': 1}}[kind]\n    if unit not in factors:\n        raise ValueError(f'unsupported {kind} unit: {unit\"'!r}'\"')\n    result = float(value.replace(',', '')) * factors[unit]\n    if not math.isfinite(result) or result < 0:\n        raise ValueError(f'invalid metric value: {value\"'!r}'\"')\n    return result\n\n\ndef kernel_class(name):\n    \\\"\\\"\\\"Group template instantiations by function, preserving distinct functions.\\\"\\\"\\\"\n    match = re.search(r'([\\\\w:]+)\\\\s*(?:<|\\\\()', name)\n    return match.group(1) if match else name.strip()\n\n\ndef summarize(source):\n    lines = [line for line in source.splitlines() if line.strip() and not line.startswith('==')]\n    reader = csv.DictReader(io.StringIO('\\\\n'.join(lines)))\n    required = {'ID', 'Process ID', 'Kernel Name', 'Metric Name', 'Metric Unit', 'Metric Value'}\n    if not required.issubset(reader.fieldnames or []):\n        raise ValueError('missing ncu CSV header columns')\n    launches = {}\n    for row in reader:\n        if row['ID'] == 'ID':  # repeated export header\n            continue\n        metric = row['Metric Name']\n        if metric not in (*METRICS, WRITE):\n            continue\n        key = (row['Process ID'], row['ID'])\n        launch = launches.setdefault(key, {'name': row['Kernel Name'], 'metrics': {}})\n        if launch['name'] \"'!= row['\"'Kernel Name'] or metric in launch['metrics']:\n            raise ValueError(f'ambiguous duplicate launch/metric: {key}, {metric}')\n        kind = 'time' if metric == TIME else 'bytes' if metric in (READ, WRITE) else 'percent'\n        launch['metrics'][metric] = quantity(row['Metric Value'], row['Metric Unit'], kind)\n    if not launches:\n        raise ValueError('no kernel metrics')\n    groups = {}\n    tiny_time = tiny_count = 0\n    for launch in launches.values():\n        metrics = launch['metrics']\n        if not set(METRICS).issubset(metrics):\n            raise ValueError(f'incomplete metrics for {launch[\\\"name\\\"]}')\n        duration = metrics[TIME]\n        if duration <= 0:\n            raise ValueError('kernel duration must be positive')\n        tiny = duration < 5e-6 and metrics[DRAM] < 5\n        tiny_count += int(tiny)\n        tiny_time += duration if tiny else 0\n        group = groups.setdefault(kernel_class(launch['name']), dict(count=0, time_s=0.,\n            read_bytes=0., write_bytes=0., dram_weight=0., sm_weight=0., launch_bound_count=0,\n            launch_bound_time_s=0.))\n        group['count'] += 1\n        group['time_s'] += duration\n        group['read_bytes'] += metrics[READ]\n        group['write_bytes'] += metrics.get(WRITE, 0)\n        group['dram_weight'] += duration * metrics[DRAM]\n        group['sm_weight'] += duration * metrics[SM]\n        group['launch_bound_count'] += int(tiny)\n        group['launch_bound_time_s'] += duration if tiny else 0\n    total = sum(g['time_s'] for g in groups.values())\n    for group in groups.values():\n        group['time_share'] = group['time_s'] / total\n        group['GB_s'] = (group['read_bytes'] + group['write_bytes']) / group['time_s'] / 1e9\n        group['dram_pct'] = group.pop('dram_weight') / group['time_s']\n        group['sm_pct'] = group.pop('sm_weight') / group['time_s']\n        group['launch_bound'] = group['launch_bound_count'] == group['count']\n    return dict(kernels=len(launches), time_s=total,\n                effective_GB_s=sum(g['read_bytes'] + g['write_bytes'] for g in groups.values()) / total / 1e9,\n                byte_scope='read+write' if any(WRITE in x['metrics'] for x in launches.values()) else 'read',\n                launch_bound_count=tiny_count, launch_bound_time_share=tiny_time / total,\n                classes=dict(sorted(groups.items())))\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('csv', type=Path)\n    args = parser.parse_args()\n    print(json.dumps(summarize(args.csv.read_text()), indent=2))\n\n\nif __name__ == '__main__':\n    main()\nPY\ncat > cc/profilers/bpf_split_timer.py <<'PY'\n\\\"\\\"\\\"Generate CPU graph uprobes and parse bpftrace's aggregate output.\\\"\\\"\\\"\nimport argparse\nimport json\nimport math\nfrom pathlib import Path\nimport re\nimport shlex\n\n\ndef positive(value):\n    value = float(value)\n    if not math.isfinite(value) or value <= 0:\n        raise ValueError('duration and tokens/s must be positive and finite')\n    return value\n\n\ndef script(pid, library, seconds=5, per_thread=False):\n    seconds = positive(seconds)\n    if int(pid) <= 0 or not re.fullmatch(r'/[\\\\w/+.\\\\-]+', library):\n        raise ValueError('positive host PID and an absolute, literal library path required')\n    thread = '\\\\n  @thread_graphs[tid] = count();\\\\n  @thread_tot_us[tid] = sum(\"'$us);'\"' if per_thread else ''\n    return f'''// PROFW v1: elapsed graph-call time, not summed worker CPU time.\nuprobe:{library}:ggml_graph_compute /pid == {int(pid)}/ {{\n  @s[tid] = nsecs;\n}}\nuretprobe:{library}:ggml_graph_compute /pid == {int(pid)} && @s[tid]/ {{\n  \"'$us = (nsecs - @s[tid]) / 1000;\n  @graphs = count();\n  @graph_tot_us = sum($us);\n  @graph_us = hist($us);{thread}\n  delete(@s[tid]);\n}}\ninterval:ms:{max(1, round(seconds * 1000))} {{ exit(); }}\nEND {{\n  printf(\"PROFW window_s={max(1, round(seconds * 1000)) / 1000}'\"\\\\\\\\n\\\");\n  clear(@s);\n}}\n'''\n\n\ndef container_command(container, seconds=5, per_thread=False):\n    \\\"\\\"\\\"Emit a shell recipe; do not inspect Docker or invoke sudo here.\\\"\\\"\\\"\n    command = ['python3', str(Path(__file__).resolve()), 'script', '--pid', '\\\"\"'$pid\"'\"',\n               '--library', '\\\"\"'$library\"'\"', '--seconds', str(positive(seconds))]\n    if per_thread:\n        command.append('--per-thread')\n    invocation = ' '.join(x if x in ('\\\"\"'$pid\"'\"', '\\\"\"'$library\"'\"') else shlex.quote(x) for x in command)\n    return f'''set -eu\npid=\"'$(docker inspect -f '\"'{{{{.State.Pid}}}}' {shlex.quote(container)})\n[ \\\"\"'$pid\" -gt 0 ]\nlibraries=$(readlink -e /proc/\"$pid\"/root/app/libggml-cpu.so.* | sort -u)\n[ \"$(printf '\"'%s\\\\\\\\n' \\\"\"'$libraries\" | wc -l)\" -eq 1 ]\n[ -n \"$libraries\" ]\nlibrary=\"$libraries\"\n{invocation} | sudo bpftrace -\n'\"'''\n\n\ndef parse(source, seconds=None, tokens_per_second=None):\n    if seconds is None:\n        window = re.search(r'\"'^PROFW window_s=(['\"\\\\d.]+)\"'$'\"', source, re.M)\n        if not window:\n            raise ValueError('legacy captures require explicit --seconds')\n        seconds = float(window[1])\n    seconds = positive(seconds)\n    def scalar(name):\n        matches = re.findall(rf'\"'^@{name}:'\"\\\\s*(\\\\d+)\\\\s*\"'$'\"', source, re.M)\n        if len(matches) \"'!= 1:\n            raise ValueError(f'\"'expected one @{name} aggregate')\n        return int(matches[0])\n    count, total_us = scalar('graphs'), scalar('graph_tot_us')\n    hist = []\n    section = re.search(r'\"'^@graph_us:'\"\\\\s*\\\\n((?:\\\\[[\"'^'\"\\\\n]*\\\\n?)+)', source, re.M)\n    def bound(value):\n        match = re.fullmatch(r'(\\\\d+)([KM]?)', value.strip())\n        if not match:\n            raise ValueError(f'invalid histogram bound: {value}')\n        return int(match[1]) * {'': 1, 'K': 1024, 'M': 1024**2}[match[2]]\n    if section:\n        for low, high, n in re.findall(r'\"'^'\"\\\\[([\"'^,]+),'\"\\\\s*([\"'^'\"\\\\)]+)\\\\)\\\\s+(\\\\d+)', section[1], re.M):\n            hist.append(dict(low_us=bound(low), high_us=bound(high), count=int(n)))\n    if sum(b['count'] for b in hist) \"'!= count:\n        raise ValueError('\"'histogram does not account for every completed split')\n    threads = {}\n    for name, tid, value in re.findall(r'\"'^@thread_(graphs|tot_us)'\"\\\\[(\\\\d+)\\\\]:\\\\s*(\\\\d+)\"'$'\"', source, re.M):\n        threads.setdefault(tid, {})[name] = int(value)\n    return dict(splits=count, splits_per_token=count / (seconds * positive(tokens_per_second))\n                if tokens_per_second is not None else None,\n                cpu_time_frac=total_us / (seconds * 1e6), hist=hist,\n                window_s=seconds, total_us=total_us, mean_us=total_us / count if count else None,\n                threads=threads)\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    sub = parser.add_subparsers(dest='mode', required=True)\n    for mode in ('script', 'container'):\n        child = sub.add_parser(mode)\n        child.add_argument('--seconds', type=float, default=5)\n        child.add_argument('--per-thread', action='store_true')\n        if mode == 'script':\n            child.add_argument('--pid', type=int, required=True)\n            child.add_argument('--library', required=True)\n        else:\n            child.add_argument('--container', required=True)\n    child = sub.add_parser('parse')\n    child.add_argument('input', type=Path)\n    child.add_argument('--seconds', type=float)\n    child.add_argument('--tokens-per-second', type=float)\n    args = parser.parse_args()\n    if args.mode == 'parse':\n        print(json.dumps(parse(args.input.read_text(), args.seconds, args.tokens_per_second), indent=2))\n    elif args.mode == 'script':\n        print(script(args.pid, args.library, args.seconds, args.per_thread), end='')\n    else:\n        print(container_command(args.container, args.seconds, args.per_thread), end='')\n\n\nif __name__ == '__main__':\n    main()\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"rg -n 'cuda-graph-trace|q8_tg128_node|q8_tg128_graph' evidence/orchestrator.jsonl artifacts/profiles | head -10; cat > cc/profilers/capture.py <<'PY'\n\\\"\\\"\\\"Emit Docker argv as JSON; never execute Docker or profiling tools.\\\"\\\"\\\"\nimport argparse\nimport json\nfrom pathlib import Path\nimport re\n\ntry:\n    from .ncu_summary import METRICS\nexcept ImportError:\n    from ncu_summary import METRICS\n\nTOOLS_IMAGE = 'campaign/cuda-tools:c1'\n\n\ndef host_path(value):\n    path = str(Path(value).absolute())\n    if ',' in path or '\\\\n' in path:\n        raise ValueError('mount paths cannot contain commas or newlines')\n    return path\n\n\ndef extract(image, directory, name='profw-extract'):\n    if not image or image.startswith('-') or not re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9_.-]*', name):\n        raise ValueError('valid image and temporary container name required')\n    return [['docker', 'create', '--name', name, '--entrypoint', '/bin/true', image],\n            ['docker', 'cp', f'{name}:/app/.', host_path(directory)],\n            ['docker', 'rm', name]]\n\n\ndef capture(tool, app, models, output, engine_args, launch_skip=2000, launch_count=600,\n            graph_trace='graph'):\n    if tool not in ('nsys', 'ncu'):\n        raise ValueError('tool must be nsys or ncu')\n    if launch_skip < 0 or launch_count <= 0:\n        raise ValueError('launch-skip must be nonnegative and launch-count positive')\n    if graph_trace not in ('graph', 'node'):\n        raise ValueError('graph_trace must be graph or node')\n    argv = ['docker', 'run', '--rm', '--label', 'campaign=c1', '--gpus', 'all',\n            '--cpus', '4', '--memory', '8g', '--pids-limit', '256']\n    if tool == 'ncu':\n        argv += ['--cap-add', 'SYS_ADMIN']\n    for source, target, readonly in ((app, '/app', True), (models, '/m', True), (output, '/out', False)):\n        argv += ['--mount', f'type=bind,src={host_path(source)},dst={target}' + (',readonly' if readonly else '')]\n    argv += ['--workdir', '/out', '--env', 'LD_LIBRARY_PATH=/app', TOOLS_IMAGE]\n    if tool == 'nsys':\n        argv += ['nsys', 'profile', '--trace=cuda,nvtx,osrt', '--sample=none', '--cpuctxsw=none',\n                 f'--cuda-graph-trace={graph_trace}', '-o', '/out/capture', '-f', 'true']\n    else:\n        argv += ['ncu', '--launch-skip', str(launch_skip), '--launch-count', str(launch_count),\n                 '--metrics', ','.join(METRICS), '--csv', '--log-file', '/out/ncu.csv']\n    return argv + ['/app/llama-bench'] + list(engine_args)\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    sub = parser.add_subparsers(dest='mode', required=True)\n    child = sub.add_parser('extract')\n    child.add_argument('--image', required=True)\n    child.add_argument('--directory', required=True)\n    child.add_argument('--name', default='profw-extract')\n    for tool in ('nsys', 'ncu'):\n        child = sub.add_parser(tool)\n        for option in ('app', 'models', 'output'):\n            child.add_argument('--' + option, required=True)\n        child.add_argument('--launch-skip', type=int, default=2000)\n        child.add_argument('--launch-count', type=int, default=600)\n        child.add_argument('--graph-trace', choices=('graph', 'node'), default='graph')\n        child.add_argument('engine_args', nargs=argparse.REMAINDER)\n    args = parser.parse_args()\n    if args.mode == 'extract':\n        result = extract(args.image, args.directory, args.name)\n    else:\n        engine_args = args.engine_args\n        if engine_args[:1] == ['--']:\n            engine_args = engine_args[1:]\n        result = capture(args.mode, args.app, args.models, args.output, engine_args,\n                         args.launch_skip, args.launch_count, args.graph_trace)\n    print(json.dumps(result, indent=2))\n\n\nif __name__ == '__main__':\n    main()\nPY\nPYTHONDONTWRITEBYTECODE=1 python cc/profilers/ncu_summary.py artifacts/ncu1/ncu.csv > artifacts/codexPROFW/ncu-summary.json\nPYTHONDONTWRITEBYTECODE=1 python cc/profilers/bpf_split_timer.py parse artifacts/bpf1/bpf.txt --seconds 5 --tokens-per-second 23.1 > artifacts/codexPROFW/bpf-summary.json\npython - <<'PY'\nimport json\ns=json.load(open('artifacts/codexPROFW/ncu-summary.json'))\nprint({k:v for k,v in s.items() if k\"'!='\"'classes'})\nfor k,v in s['classes'].items():print(k, v['GB_s'], v['time_share'],v['launch_bound_count'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
