#"'!/usr/bin/env python3
import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

from expert_trace_sim import read_trace

ROOT = Path('"'/home/muk/projects/xs-dev/llama-opt')
OUT = Path('/home/muk/projects/xs-dev/opt-artifacts')
NAMES = {'p12': ('selection_trace', 'trace'), 'p13': ('fill_populate_backend', 'populate'),
         'p14': ('expert_pin', 'pin'), 'p15': ('pregate_temporal', 'temporal')}
LABELS = ('expert_config:', 'expert_fill:', 'expert_trace:', 'expert_pin:', 'expert_pregate:')


def stats(path):
    lines = []
    for line in path.read_text().splitlines():
        for label in LABELS:
            at = line.find(label)
            if at >= 0:
                lines.append(line[at:])
                break
    return list(dict.fromkeys(lines))


def main():
    results = {}
    for patch in NAMES:
        path = OUT / (patch + '-checks.json')
        data = json.loads(path.read_text())
        for case, result in data.items():
            label = patch + '-' + case.replace('_', '-')
            result['stats'] = stats(OUT / (label + '.stderr'))
            actual_hash = hashlib.sha256((OUT / (label + '.stdout')).read_bytes()).hexdigest()
            assert actual_hash == result['stdout_sha256']
        for off, on in (('off', 'on'), ('mapped_off', 'mapped_on')):
            assert data[off]['exit_code'] == data[on]['exit_code'] == 0
            assert data[off]['stdout_sha256'] == data[on]['stdout_sha256']
        assert data['invalid']['exit_code'] == data['unknown']['exit_code'] == -6
        path.write_text(json.dumps(data, indent=2) + '\\n')
        results[patch] = data

    rows = read_trace(OUT / 'p12-trace.csv')
    run = max({r.run for r in rows}, key=int)
    rows = [r for r in rows if r.run == run]
    previous = {}
    hits = actual = 0
    present = {(r.token, r.layer) for r in rows}
    for row in rows:
        if row.phase == 'prompt':
            previous.pop(row.layer, None)
            continue
        if (row.token, row.layer - 1) in present:
            hits += len(set(previous.get(row.layer, ())).intersection(row.selected))
            actual += len(row.selected)
        previous[row.layer] = row.selected
    expected = hits / actual
    line = [s for s in results['p15']['mapped_on']['stats'] if s.startswith('expert_pregate: stats')][-1]
    observed = float(re.search(r'recall_temporal=([0-9.]+)', line)[1])
    assert abs(expected - observed) < 0.000001, (expected, observed)
    crosscheck = {'actual': actual, 'hits': hits, 'expected_recall': expected,
                  'reported_recall': observed, 'result': 'PASS'}
    (OUT / 'p15-recall-crosscheck.json').write_text(json.dumps(crosscheck, indent=2) + '\\n')

    test = subprocess.run(['python3', str(OUT / 'test_expert_trace_sim.py')], capture_output=True, text=True)
    assert test.returncode == 0
    (OUT / 'B2.log').write_text(test.stdout + test.stderr)
    simulator = subprocess.run(['python3', str(OUT / 'expert_trace_sim.py'), str(OUT / 'p12-trace.csv')],
                               capture_output=True, text=True, check=True)
