pen_sized`, the\n   120\t    /// arena is one reserved address range backed by physical segments of that size (CUDA virtual memory\n   121\t    /// management) instead of one cudaMalloc, so `shrink` can give the tail's VRAM back to the driver - for another\n   122\t    /// program - and `grow` can take it again, while every slot keeps its address (the captured graphs, the verify\n   123\t    /// plan's pointers and the prompt path's loan all hold addresses into it).  0 (the default): one cudaMalloc, as\n   124\t    /// always.  CUDA only: a HIP build refuses it at open.  The slots past `slots()` after a shrink must hold no\n   125\t    /// resident expert and no loan: the CALLER evicts them first (they become CPU misses).\n   126\t    void set_segment_bytes(int64_t seg_bytes) { seg_req_ = seg_bytes > 0 ? seg_bytes : 0; }\n   127\t    /// STRATA_MMQ_DIRECT: `open_sized` leaves at least `g` bytes of room after each slot's blob (the prompt MMQ\n   128\t    /// reads a little past a down matrix when it reads an expert in its slot).  Set before opening, like\n   129\t    /// `set_segment_bytes`; `close` keeps it.  0 (the default): no guard.  The uniform `open` ignores it, and so does\n   130\t    /// the SYCL engine's open_sized (its slots then have no guard, and `slot_tail` finds no room).\n   131\t    void set_slot_guard(int64_t g) { guard_req_ = g > 0 ? g : 0; }\n   132\t    /// The guard the open slots were laid out with: what `open_sized` applied (0 for uniform slots, when closed, and\n   133\t    /// on SYCL, whose open_sized applies none).\n   134\t    int64_t slot_guard() const { return guard_; }\n   135\t    /// A sized slot's arena bytes: the blob plus the guard, 256-byte aligned.\n   136\t    static int64_t slot_stride(int64_t blob, int64_t guard = 0) { return (blob + guard + 255) / 256 * 256; }\n   137\t    bool segmented() const { return !segs_.empty(); }\n   138\t    int64_t segment_bytes() const { return seg_; }\n   139\t    /// Bytes of the arena backed by VRAM now (a whole number of segments; the arena when not segmented).\n   140\t    int64_t mapped_bytes() const;\n   141\t    /// Unmaps every segment past the first `keep_bytes` (rounded UP to a segment boundary): `slots()` becomes the\n   142\t    /// slots wholly inside what stays.  Waits for the device first.  False with `err` when not segmented or a driver\n   143\t    /// call failed.\n   144\t    bool shrink(int64_t keep_bytes, std::string& err);\n   145\t    /// Maps segments again up to `want_bytes` (rounded DOWN to a segment, at most the arena; the last, shorter\n   146\t    /// segment only when `want_bytes` covers the arena).  Stops at the first segment the driver cannot back (false,\n   147\t    /// `err`: what was mapped by then stays).  The new slots are empty until the caller fills them.\n   148\t    bool grow(int64_t want_bytes, std::string& err);\n   149\t    /// The number of leading slots that fit wholly inside the first `bytes` bytes.\n   150\t    int64_t slots_within(int64_t bytes) const;\n   151\t    /// The bytes the first `n` slots span.\n   152\t    int64_t bytes_of(int64_t n) const { return slot_end(n < 0 ? 0 : n > slots_ ? slots_ : n); }\n   153\t\n   154\t    /// `(layer, expert)` -> slot index, or `kNotResident`.  Bounds-checked: a bad layer or expert returns\n   155\t    /// `kNotResident` rather than reading whatever is adjacent in the table.\n   156\t    int32_t slot_of(int64_t layer, int64_t expert) const;\n   157\t    /// Claims the next free slot for `(layer, expert)`.  Returns the slot, or `kNotResident` when the cache is\n   158\t    /// full - **it never evicts**, because eviction policy is a measured question (`R4.1`'s LFU-decay vs LRU\n   159\t    /// sweep) and a placeholder policy would set the hit rate that everything downstream is then sized against.\n   160\t    int32_t admit(int64_t layer, int64_t expert);\n   161\t\n   162\t    /// Publish a same-layer replacement after its slot copy has completed.\n   163\t    void replace(int64_t layer, int32_t old_expert, int32_t new_expert) {\n   164\t        auto& old = residency_[(size_t) layer * n_expert_ + old_expert];\n   165\t        residency_[(size_t) layer * n_expert_ + new_expert] = old;\n   166\t        old = kNotResident;\n   167\t    }\n   168\t\n   169\t    /// **R4.2g: GIVE EACH LAYER ITS OWN SLOTS.  ROUND 328 MEASURED WHY THE GLOBAL FORM CANNOT WORK.**\n   170\t    ///\n   171\t    /// `admit`'s original policy hands out slots in ARRIVAL ORDER from one counter shared by every layer\n   172\t    /// (`if (next_free_ >= slots_) return kNotResident;`).  A position looks at 10 experts in each of 48\n   173\t    /// layers, so the first `n_slots` distinct (layer, expert) pairs are **about 26 layers of POSITION 0** -\n   174\t    /// the cache fills entirely inside the first position it ever sees and never changes again, so hits are\n   175\t    /// confined to those few layers for the rest of the run.\n   176\t    ///\n   177\t    /// Measured, `--expert-cache 256`: **1781 of 60000 = 2.97%**.  `Memory/cache_allocation.py` scores the\n   178\t    /// same run's routing and says **8 slots per layer is worth 21.4%** and 64 is worth **70.4%**.  The cache\n   179\t    /// was never short of capacity - it was handing all of it to two layers.\n   180\t    ///\n   181\t    /// With this on, layer `l` may only use slots `[l*q, (l+1)*q)` where `q = slots()/n_layers`, the last\n   182\t    /// layer taking the remainder.  **EVICTION IS STILL ABSENT** - the property the comment above calls\n   183\t    /// deliberate is preserved exactly; only WHICH slot a layer may take changes.  Default off, so every\n   184\t    /// caller that predates this flag is bit-for-bit unaffected.\n   185\t    void set_per_layer_admission(bool on) { per_layer_ = on; }\n   186\t    bool per_layer_admission() const { return per_layer_; }\n   187\t    /// The slot range layer `l` may admit into under per-layer admission.  Exposed so a test can check it.\n   188\t    void layer_slot_range(int64_t layer, int64_t& lo, int64_t& hi) const;\n   189\t\n   190\t    /// The device address of one slot.\n   191\t    uint8_t* device_slot(int32_t slot);\n   192\t    const uint8_t* device_slot(int32_t slot) const;\n   193\t\n   194\t    /// Copies `(layer, expert)`'s blob from `host_blob` into `slot` on `stream`.  Asynchronous: the caller\n   195\t    /// orders it.  Returns false if the indices are out of range rather than reading past the arena.\n   196\t    /// `bytes` (plan v0.3 P6): the blob's own size when it is smaller than the slot (a native pack); 0 = the slot.\n   197\t    bool fill_slot(int32_t slot, const uint8_t* host_blob, void* stream, std::string& err, int64_t bytes = 0);\n   198\t\n   199\t    /// **THE SAME COPY, BUT BLOCKING, AND THE PROFILE FILL NEEDS IT.**  `fill_slot` is asynchronous because on\n   200\t    /// the token path the fill and the kernel that reads it are ordered by one stream and waiting would be a\n   201\t    /// synchronisation per layer.  At STARTUP there is no such ordering to lean on: the source is pageable host\n   202\t    /// memory, `verify_slot` reads the slot back on the LEGACY stream, and a legacy-stream copy is not ordered\n   203\t    /// against a `cudaStreamNonBlocking` one.  The first version used the async form and `verify_slot` refused\n   204\t    /// the whole run with \"slot 0 differs from the arena at byte 0\" - which is the check doing its job.\n   205\t    bool fill_slot_blocking(int32_t slot, const uint8_t* host_blob, std::string& err, int64_t bytes = 0);\n   206\t    /// perf-review D-4: `fill_slot_blocking`'s copy on the same (legacy) stream, but queued: many slots are refilled\n   207\t    /// with one `sync_queued` at the end instead of a wait per slot. Same ordering against earlier work, same bytes.\n   208\t    bool fill_slot_queued(int32_t slot, const uint8_t* host_blob, std::string& err, int64_t bytes = 0);\n   209\t    /// `fill_slot_queued` for a blob that is not in one piece: each `parts[i].n` bytes at `parts[i].p` go to byte `parts[i].at`\n   210\t    /// of the slot (the pieces tile the blob).  Same queue, same `sync_queued`.\n   211\t    bool fill_slot_queued_parts(int32_t slot, const BlobPart* parts, int n, std::string& err);\n   212\t    bool sync_queued(std::string& err);\n   213\t\n   214\t    /// Reads `slot` back to the host and compares it to `host_blob`, byte for byte.  **THE ONLY THING THAT SAYS\n   215\t    /// THE CACHE HOLDS THE EXPERT IT CLAIMS TO.**  A slot table that is right about indices and wrong about\n   216\t    /// bytes produces a plausible token, which is exactly the failure this project has paid for most often.\n   217\t    bool verify_slot(int32_t slot, const uint8_t* host_blob, std::string& err, int64_t bytes = 0);\n   218\t\n   219\t    /// Slots filled so far, for the startup report.\n   220\t    int64_t fills() const { return fills_; }\n   221\t\n   222\t    /// STRATA_EXPERT_NIBBLE=1 (strata/core/expert_nibble.hpp): called once the startup fill has written every slot\n   223\t    /// (some of them as 4-bit codes, not GGUF blocks) and checked them.  From then on no slot may be written through\n   224\t    /// this class: the fill_slot calls stop the engine (they would write GGUF bytes, possibly into a 4-bit slot, and a\n   225\t    /// wrong expert gives a plausible token, never an error), and `admit` claims nothing.  Never called with the switch\n   226\t    /// off: an unsealed cache is the one above.\n   227\t    void seal() { sealed_ = true; }\n   228\t    bool sealed() const { return sealed_; }\n   229\t\n   230\t    /// The elastic K/V (--kv-grow): the arena in a VMM range (vmm.hpp) instead of one cudaMalloc, so the K/V can take\n   231\t    /// single chunks of it and give them back. Applies to the next `open`; ignored where VMM is not available.\n   232\t    static void set_vmm(bool enabled);\n   233\t    /// The arena's range (null: one cudaMalloc).\n   234\t    VmmRange* vmm_range() { return vmm_.get(); }\n   235\t    /// Byte offset of slot `s` in the arena (s == slots(): the end).\n   236\t    uint64_t slot_offset(int64_t s) const { return off_.empty() ? (uint64_t) s * (uint64_t) blob_ : off_[(size_t) s]; }\n   237\t    /// The arena bytes of slot `s` (its blob, any slack and the guard).\n   238\t    uint64_t slot_room(int32_t s) const { return slot_offset(s + 1) - slot_offset(s); }\n   239\t    /// STRATA_MMQ_DIRECT: the address `blob` bytes into slot `s` when the slot has room for `need` more bytes there\n   240\t    /// (null otherwise, or for a bad slot).  Uniform slots too: their stride is the largest blob.\n   241\t    uint8_t* slot_tail(int32_t s, uint64_t blob, uint64_t need) const {\n   242\t        if (s < 0 || s >= slots_ || base_ == nullptr) return nullptr;\n   243\t        return slot_room(s) >= blob + need ? base_ + slot_offset(s) + blob : nullptr;\n   244\t    }\n   245\t\n   246\tprivate:\n   247\t#if defined(STRATA_USE_HIP)\n   248\t    bool ensure_blocking_staging(std::size_t bytes, std::string& err);\n   249\t    uint8_t* blocking_staging_ = nullptr;\n   250\t    std::size_t blocking_staging_bytes_ = 0;\n   251\t#endif\n   252\t    int64_t slot_end(int64_t n) const { return off_.empty() ? n * blob_ : (int64_t) off_[(size_t) n]; }\n   253\t    bool open_segmented(uint64_t want, std::string& err);\n   254\t    void release_segmented();\n   255\t    uint8_t* base_ = nullptr;\n   256\t    int64_t live_slots_ = 0;            ///< #533: slots() - all of them unless shrunk\n   257\t    int64_t seg_req_ = 0;               ///< #533: the segment size asked for (0: one cudaMalloc)\n   258\t    int64_t guard_req_ = 0;             ///< STRATA_MMQ_DIRECT: bytes kept after each sized slot's blob (set_slot_guard)\n   259\t    int64_t guard_ = 0;                 ///< ...the guard open_sized applied to the open slots (0: none)\n   260\t    int64_t seg_ = 0;                   ///< #533: the segment size used (a multiple of the driver's granularity)\n   261\t    uint64_t reserved_ = 0;             ///< #533: the reserved address range's size\n   262\t    std::vector<unsigned long long> segs_;   ///< #533: each segment's physical handle (0: unmapped)\n   263\t    std::vector<int64_t> seg_size_;     ///< #533: each segment's size (the last one may be shorter)\n   264\t    int64_t mapped_segs_ = 0;           ///< #533: segments [0, mapped_segs_) are backed\n   265\t    std::unique_ptr<VmmRange> vmm_;    ///< the arena's range when it is in VMM (set_vmm)\n   266\t    std::vector<int32_t> residency_;   ///< [n_layers * n_expert] -> slot or kNotResident\n   267\t    int64_t slots_ = 0;\n   268\t    int64_t n_layers_ = 0;\n   269\t    int64_t n_expert_ = 0;\n   270\t    int64_t blob_ = 0;\n   271\t    int64_t next_free_ = 0;\n   272\t    int64_t fills_ = 0;\n   273\t    /// R4.2g.  `per_layer_` off (the default) leaves `next_free_` as the only admission counter, so the\n   274\t    /// pre-existing path is untouched.\n   275\t    bool per_layer_ = false;\n   276\t    std::vector<int32_t> layer_next_;   ///< [n_layers] -> that layer's next free slot\n   277\t    std::vector<uint64_t> off_;         ///< plan v0.3 P6: slot offsets (slots + 1 entries) when sized\n   278\t    int64_t admitted_ = 0;\n   279\t    bool sealed_ = false;               ///< STRATA_EXPERT_NIBBLE: `seal` was called (no slot is written after it)\n   280\t};\n   281\t\n   282\t}  // namespace strata::core\n     1\t// include/strata/core/hit_hook.hpp - R4.2c: the seam between the host loop and the VRAM expert tier.\n     2\t//\n     3\t// **IT IS ITS OWN HEADER BECAUSE BOTH SIDES NEED IT AND NEITHER SHOULD OWN IT.**  `session.hpp` declares the\n     4\t// loop that calls the hook; `expert_source.hpp` declares the implementation that answers it.  Putting the type\n     5\t// in either one makes the other include a header it has no other use for, and the loop knowing what an expert\n     6\t// cache is (or the adapter knowing what a graph is) is exactly the coupling this seam exists to avoid.\n     7\t#pragma once\n     8\t\n     9\t#include <cstdint>\n    10\t\n    11\tnamespace strata::core {\n    12\t\n    13\t/// **TWO PHASES, AND THE SPLIT IS THE WHOLE POINT.**  `Launch` runs BEFORE the CPU pool and `Combine` runs\n    14\t/// AFTER the misses have been copied into `parts`.  That ordering is what lets the GPU's resident experts run\n    15\t/// at the same time as the CPU's misses instead of after them:\n    16\t///\n    17\t///     ring -> hits(Launch)   [GPU: quantize + grouped experts into `hit_out`]\n    18\t///          -> pool()         [CPU: the misses, CONCURRENT with the GPU]\n    19\t///          -> H2D misses into `parts`\n    20\t///          -> hits(Combine)  [GPU: parts += hit_out]\n    21\t///          -> post[l]\n    22\t///\n    23\t/// **MEASURED, AND WHY IT IS NOT THE OBVIOUS ORDER.**  The first version called the hit path once, after the\n    24\t/// pool, writing straight into `parts`.  The drain duly fell **18.2 -> 10.2 ms** - the CPU really was doing\n    25\t/// half the experts - and **the token did not move at all**, because the GPU's half had simply been moved onto\n    26\t/// the critical path behind the CPU's instead of beside it.  A second buffer and one `add_inplace` buy the\n    27\t/// overlap back.\n    28\tenum class HitPhase { Launch, Combine };\n    29\t\n    30\t/// `ids` AND `k` ARE THE ROUTER'S OWN OUTPUT, AND THEY ARE WHY THIS HOOK TAKES ARGUMENTS AT ALL.\n    31\t///\n    32\t/// The first version took only `(user, stream, phase)` and left the hit/miss decision inside the pool\n    33\t/// callback - which runs AFTER `Launch`.  So `Launch` read the hit list from the PREVIOUS layer and computed\n    34\t/// the previous layer's experts into the current layer's rows.  It produced a token, the timings looked\n    35\t/// plausible, and **C1 moved from mean KL 9.69e-02 to 1.03e+00 and top-1 from 0.867 to 0.333.**  The decision\n    36\t/// has to happen in `Launch`, on the ids the doorbell published for THIS layer, and the pool then consumes it.\n    37\t///\n    38\t/// A null `HitFn` means \"no VRAM tier\" - the default, and what every caller had before R4.\n    39\tusing HitFn = void (*)(void* user, void* stream, HitPhase phase, const int32_t* ids, int64_t k);\n    40\t\n    41\t}  // namespace strata::core\n     1\t// include/strata/artifact/model_family.hpp - which model family a GGUF holds, from its general.architecture.\n     2\t//\n     3\t// Strata was written for one model (Qwen3.8-Flash-Next, `qwen4exp`).  Qwen3.6-35B-A3B (`qwen35moe`) is a close\n     4\t// cousin (same tokenizer, the same Gated-DeltaNet + gated-attention 3:1 layer pattern, the same head dims), so the\n     5\t// reader, the geometry and the layout tables know both.  The ENGINE runs only the families `model_family_runs`\n     6\t// names; a recognised family it does not run yet is refused with `model_family_not_supported`, not mis-run.\n     7\t//\n     8\t// No dependencies: the GGUF reader (the architecture guard) and the core geometry both include this.\n     9\t#pragma once\n    10\t\n    11\t#include <string>\n    12\t\n    13\tnamespace strata {\n    14\t\n    15\tenum class ModelFamily {\n    16\t    Unknown = 0,\n    17\t    Qwen4Exp,    ///< Qwen3.8-Flash-Next and its fine-tunes / pruned variants (Swift 1.5, the Coder)\n    18\t    Qwen35Moe,   ///< Qwen3.6-35B-A3B (Unsloth's MTP GGUFs): plain pre-norm residual, dense attention, nextn MTP block\n    19\t};\n    20\t\n    21\tinline ModelFamily model_family_from_arch(const std::string& arch) {\n    22\t    if (arch == \"qwen4exp\") return ModelFamily::Qwen4Exp;\n    23\t    if (arch == \"qwen35moe\") return ModelFamily::Qwen35Moe;\n    24\t    return ModelFamily::Unknown;\n    25\t}\n    26\t\n    27\t/// The GGUF architecture string (also the metadata key prefix: \"<arch>.block_count\").\n    28\tinline const char* model_family_arch(ModelFamily f) {\n    29\t    switch (f) {\n    30\t    case ModelFamily::Qwen4Exp:\n    31\t        return \"qwen4exp\";\n    32\t    case ModelFamily::Qwen35Moe:\n    33\t        return \"qwen35moe\";\n    34\t    default:\n    35\t        return \"\";\n    36\t    }\n    37\t}\n    38\t\n    39\t/// The model's name for messages.\n    40\tinline const char* model_family_title(ModelFamily f) {\n    41\t    switch (f) {\n    42\t    case ModelFamily::Qwen4Exp:\n    43\t        return \"Qwen3.8-Flash-Next\";\n    44\t    case ModelFamily::Qwen35Moe:\n    45\t        return \"Qwen3.6-35B-A3B\";\n    46\t    default:\n    47\t        return \"an unknown model\";\n    48\t    }\n    49\t}\n    50\t\n    51\t/// Whether Flash-Next's engine path runs the family.  Qwen3.6 has an engine path of its own (src/qwen35), which the\n    52\t/// CUDA and HIP builds of `strata` switch to at the top of main(); the Intel Arc (SYCL) build has none yet, so there\n    53\t/// (and on Flash-Next's path) the family is refused with `model_family_not_supported`.\n    54\tinline bool model_family_runs(ModelFamily f) { return f == ModelFamily::Qwen4Exp; }\n    55\t\n    56\t/// The refusal for a recognised family the engine does not run (empty when it runs it).\n    57\tinline std::string model_family_not_supported(ModelFamily f) {\n    58\t    if (model_family_runs(f)) return {};\n    59\t    if (f == ModelFamily::Unknown) return \"this is not a model family Strata knows\";\n    60\t    return std::string(model_family_title(f)) + \" (architecture '\" + model_family_arch(f) +\n    61\t           \"') runs on the NVIDIA (CUDA) and AMD (HIP) builds of Strata; this build does not run it yet (the Intel \"\n    62\t           \"Arc / SYCL port is in development). Use a CUDA or HIP build, or a Qwen3.8-Flash-Next model file\";\n    63\t}\n    64\t\n    65\t}  // namespace strata\n","exit_code":0,"status":"completed"}}
