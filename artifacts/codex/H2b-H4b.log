#!/usr/bin/env python3
"""Plan and execute a declarative counterbalanced experiment."""
import argparse
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

sys.dont_write_bytecode = True

if __package__:
    from . import gate, preflight, run_summary
else:
    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
    from cc.abrun import gate, preflight, run_summary

ROOT = Path(__file__).resolve().parents[2]


def validate(spec):
    for key in ('id', 'outdir_base', 'runner', 'tool', 'argv', 'arms', 'order'):
        if key not in spec:
            raise ValueError(f'missing spec field: {key}')
    safe = r'[A-Za-z0-9][A-Za-z0-9_.-]*'
    if not isinstance(spec['id'], str) or not re.fullmatch(safe, spec['id']):
        raise ValueError('id must be a safe path component')
    if spec['runner'] != 'om_run':
        raise ValueError('only runner=om_run is supported')
    if not isinstance(spec['tool'], str) or not re.fullmatch(safe, spec['tool']):
        raise ValueError('tool must be a binary name')
    if not isinstance(spec['outdir_base'], str) or not spec['outdir_base']:
        raise ValueError('outdir_base must be a nonempty path')
    if not isinstance(spec['argv'], list) or not all(isinstance(x, str) for x in spec['argv']):
        raise ValueError('argv must be an array of strings')
    arms = spec['arms']
    if not isinstance(arms, dict) or len(arms) < 2 or 'base' not in arms:
        raise ValueError('arms must contain base and at least one treatment')
    for name, arm in arms.items():
        if not re.fullmatch(safe, name) or not isinstance(arm, dict):
            raise ValueError('invalid arm')
        if not isinstance(arm.get('image'), str) or not arm['image']:
            raise ValueError(f'{name}: missing image')
        env = arm.get('env', {})
        if not isinstance(env, dict) or any(not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', k)
                                           or not isinstance(v, str) or re.search(r'\s', v)
                                           for k, v in env.items()):
            raise ValueError(f'{name}: env must map names to strings without whitespace (om_run restriction)')
        if not isinstance(arm.get('expect_switch', False), bool):
            raise ValueError('expect_switch must be boolean')
    regexes = spec.get('switch_regex', [])
    if not isinstance(regexes, list) or not all(isinstance(r, str) for r in regexes):
        raise ValueError('switch_regex must be an array of regex strings')
    for pattern in regexes:
        re.compile(pattern)
    if any(a.get('expect_switch') for a in arms.values()) and not regexes:
        raise ValueError('expect_switch requires switch_regex')
    if arms['base'].get('expect_switch'):
        raise ValueError('base cannot expect a switch')
    rounds = spec.get('rounds', 1)
    if not isinstance(rounds, int) or isinstance(rounds, bool) or rounds < 1:
        raise ValueError('rounds must be a positive integer')
    if not isinstance(spec.get('metric', 'eval_tps'), str):
        raise ValueError('metric must be a summary field name')
    planned_order(spec)


def planned_order(spec):
    arms = list(spec['arms'])
    arms = ['base'] + [name for name in arms if name != 'base']
    order = spec['order']
    if order == 'explicit':
        names = spec.get('explicit_order')
        if not isinstance(names, list) or not names or any(n not in arms for n in names):
            raise ValueError('explicit_order must be a nonempty list of known arms')
        if set(names) != set(arms):
            raise ValueError('explicit_order must include every arm')
    else:
        expected = ''.join(chr(65 + i) for i in range(len(arms)))
        expected += expected[::-1]
        if order not in (expected, 'mirrored'):
            raise ValueError(f'{len(arms)} arms require order={expected!r} or mirrored')
        names = arms + arms[::-1]
    return names * spec.get('rounds', 1)


def plan(spec):
    out = Path(spec['outdir_base']).expanduser() / spec['id']
    if not out.is_absolute():
        out = ROOT / out
    runs = []
    for index, arm in enumerate(planned_order(spec), 1):
        config = spec['arms'][arm]
        directory = out / f'{index:03d}-{arm}'
        env_flags = ' '.join(f'-e {k}={v}' for k, v in config.get('env', {}).items())
        override = os.environ.get('ABRUN_RUNNER')
        runner = shlex.split(override) if override else [str(ROOT / 'cc/om_run/om_run.sh')]
        command = runner + [str(directory), config['image'], env_flags, spec['tool']] + spec['argv']
        if not override:
            command = [str(ROOT / 'bin/run_op'), '--agent', 'abrun', '--task', spec['id'], '--'] + command
        runs.append({'index': index, 'arm': arm, 'dir': str(directory), 'command': command})
    return out, runs


def write_report(out, spec, runs, verdict):
    (out / 'verdict.json').write_text(json.dumps(verdict, indent=2) + '\n')
    lines = [f"# {spec['id']}", '', f"Status: {verdict['status']}", '',
             '| # | Arm | Status | Metric | Wall s | Output SHA |',
             '|---|---|---|---:|---:|---|']
    metric = spec.get('metric', 'eval_tps')
    for row in runs:
        s = row['summary']
        lines.append(f"| {row['index']} | {row['arm']} | {s['status']} | {s.get(metric)} | {s['wall_s']} | {s['output_sha']} |")
    lines += ['', f'Metric: {metric} (higher is better)', '', '| Arm | Mean | B/A | Gate |',
              '|---|---:|---:|---|']
    for arm, mean in verdict['means'].items():
        comparison = verdict['comparisons'].get(arm, {})
        lines.append(f"| {arm} | {mean} | {comparison.get('ratio', '—')} | {comparison.get('verdict', 'base')} |")
    lines += ['', f"A/A gap: {verdict['aa_gap']}; drift: {verdict['drift']}; threshold: {verdict['threshold']}",
              '', f"Output class: {verdict['output']['class']}", '',
              'Output details: `' + json.dumps(verdict['output']) + '`', '',
              *verdict.get('invalid_reasons', []), *verdict.get('reasons', [])]
    (out / 'REPORT.md').write_text('\n'.join(lines) + '\n')


def execute(spec, out, runs):
    # Exclusive creation refuses accidental overwrite/replay into prior results.
    out.mkdir(parents=True, exist_ok=False)
    (out / 'spec.json').write_text(json.dumps(spec, indent=2) + '\n')
    grouped = {arm: [] for arm in spec['arms']}
    completed, invalid = [], []
    try:
        checked = set()
        for arm in spec['arms'].values():
            key = (arm['image'], spec['tool'])
            if key not in checked:
                preflight.check(*key, spec['argv'])
                checked.add(key)
        for run in runs:
            rc = subprocess.run(run['command'], cwd=ROOT).returncode
            summary = run_summary.summarize(run['dir'], spec.get('switch_regex', []))
            run['summary'] = summary
            completed.append(run)
            grouped[run['arm']].append(summary)
            config = spec['arms'][run['arm']]
            if config.get('expect_switch') and not summary['switch_lines']:
                invalid.append(f"{run['arm']}: switch inert (no switch_lines)")
            if run['arm'] == 'base' and summary['switch_lines']:
                invalid.append('base: switch leaked (switch_lines present)')
            if rc != 0 or summary['status'] != 'ok':
                invalid.append(f"{run['arm']}: runner rc={rc}, status={summary['status']}")
            if invalid:
                break
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        invalid.append(str(exc))
    verdict = gate.evaluate(grouped, spec.get('metric', 'eval_tps'))
    if verdict['reasons']:
        invalid.extend(verdict['reasons'])
    verdict.update(status='INVALID' if invalid else 'completed', invalid_reasons=invalid,
                   planned_order=[r['arm'] for r in runs],
                   executed_order=[r['arm'] for r in completed])
    if invalid:
        for comparison in verdict['comparisons'].values():
            comparison['verdict'] = 'null'
    write_report(out, spec, completed, verdict)
    print(json.dumps(verdict, indent=2))
    return 1 if invalid else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('spec')
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--submit', action='store_true')
    args = parser.parse_args()
    try:
        path = Path(args.spec).resolve()
        spec = json.loads(path.read_text())
        validate(spec)
        out, runs = plan(spec)
        if args.dry_run:
            print('Order: ' + ', '.join(r['arm'] for r in runs))
            for run in runs:
                print(f"Run {run['index']}: {run['arm']}  {shlex.join(run['command'])}")
            return 0
        if args.submit:
            queue = ROOT / 'bin/jobq'
            if not queue.exists():
                raise ValueError('--submit requires bin/jobq')
            return subprocess.run([str(queue), 'submit', '--class', 'gpu', '--name', spec['id'],
                                   '--', sys.executable, str(Path(__file__).resolve()), str(path)],
                                  cwd=ROOT).returncode
        return execute(spec, out, runs)
    except (OSError, ValueError, TypeError, re.error) as exc:
        parser.exit(1, f'abrun: {exc}\n')


if __name__ == '__main__':
    sys.exit(main())
#!/usr/bin/env python3
"""A/A-aware, higher-is-better performance gate for labelled summaries."""
import argparse
import json
import math
from pathlib import Path
import statistics


def finite(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def evaluate(arms, metric='eval_tps', base='base'):
    inputs = {arm: [run.get(metric) for run in runs] for arm, runs in arms.items()}
    means, gaps = {}, {}
    reasons = []
    for arm, numbers in inputs.items():
        valid = bool(numbers) and all(finite(n) and n > 0 for n in numbers)
        means[arm] = statistics.mean(numbers) if valid else None
        gaps[arm] = ((max(numbers) - min(numbers)) / means[arm]
                     if valid and len(numbers) >= 2 else None)
        if not valid:
            reasons.append(f'{arm}: missing/nonpositive/nonfinite {metric}')
        if any(r.get('status', 'ok') != 'ok' for r in arms[arm]):
            reasons.append(f'{arm}: unsuccessful run')
    base_values = inputs.get(base, [])
    drift_halves = None
    drift = None
    if means.get(base) and len(base_values) >= 2:
        split = len(base_values) // 2
        drift_halves = [statistics.mean(base_values[:split]), statistics.mean(base_values[split:])]
        drift = abs(drift_halves[1] - drift_halves[0]) / means[base]
    aa_gap = max((gap for gap in gaps.values() if gap is not None), default=0.0)
    threshold = max(0.03, 2 * aa_gap, 2 * (drift or 0.0))
    if base not in arms:
        reasons.append(f'base arm {base!r} absent')
    comparisons = {}
    for arm in arms:
        if arm == base:
            continue
        ratio = means[arm] / means[base] if means[arm] and means.get(base) else None
        verdict = 'null'
        if ratio is not None and not reasons:
            if ratio - 1 > threshold and not math.isclose(ratio - 1, threshold, rel_tol=1e-12):
                verdict = 'improved'
            elif 1 - ratio > threshold and not math.isclose(1 - ratio, threshold, rel_tol=1e-12):
                verdict = 'regressed'
        comparisons[arm] = {'mean': means[arm], 'base_mean': means.get(base),
                            'ratio': ratio, 'change': ratio - 1 if ratio is not None else None,
                            'threshold': threshold, 'verdict': verdict}
    hashes = {arm: [run.get('output_sha') for run in runs] for arm, runs in arms.items()}
    flat = [value for values in hashes.values() for value in values]
    if not flat or any(value is None for value in flat):
        output = {'class': 'unknown', 'reason': 'output hash missing', 'hashes': hashes}
    elif len(set(flat)) == 1:
        output = {'class': 'identical', 'hashes': hashes}
    else:
        reference = next(iter(hashes.get(base, [])), flat[0])
        output = {'class': 'differs', 'hashes': hashes,
                  'differs': {arm: [{'run_index': i, 'output_sha': h} for i, h in enumerate(values)
                                    if h != reference] for arm, values in hashes.items()
                              if any(h != reference for h in values)},
                  'reference_sha': reference}
    return {'metric': metric, 'base': base, 'inputs': inputs, 'means': means,
            'aa_gaps': gaps, 'aa_gap': aa_gap, 'drift_halves': drift_halves,
            'drift': drift, 'threshold': threshold, 'minimum_effect': 0.03,
            'noise_multiplier': 2, 'comparisons': comparisons, 'output': output,
            'reasons': reasons}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('summaries', help='JSON object: arm -> summary objects or summary.json paths')
    parser.add_argument('--metric', default='eval_tps')
    parser.add_argument('--base', default='base')
    args = parser.parse_args()
    arms = json.loads(Path(args.summaries).read_text())
    arms = {arm: [json.loads(Path(r).read_text()) if isinstance(r, str) else r for r in runs]
            for arm, runs in arms.items()}
    print(json.dumps(evaluate(arms, args.metric, args.base), indent=2))


if __name__ == '__main__':
    main()
#!/usr/bin/env python3
"""Summarize guarded runs without requiring complete or well-formed logs."""
import argparse
import hashlib
import json
import math
from pathlib import Path
import re
import statistics


def numeric(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def summarize(directory, switch_regex=(), write=True):
    directory = Path(directory)
    result = {'dir': str(directory), 'reasons': {}, 'warnings': []}

    def put(key, value, reason='not recorded'):
        result[key] = value
        if value is None:
            result['reasons'][key] = reason
        else:
            result['reasons'].pop(key, None)

    def read(name):
        try:
            return (directory / name).read_text(errors='replace')
        except OSError as exc:
            result['warnings'].append(f'{name}: {exc.strerror}')
            return ''

    try:
        record = json.loads(read('result.json'))
        if not isinstance(record, dict):
            record = {}
    except (ValueError, TypeError):
        record = {}
    put('status', record.get('status'), 'result.json status missing or invalid')
    put('wall_s', record.get('wall_s') if numeric(record.get('wall_s')) else None)
    stderr = read('stderr.txt')
    stdout = read('stdout.txt')
    try:
        digest = hashlib.sha256((directory / 'stdout.txt').read_bytes()).hexdigest()[:12]
    except OSError:
        digest = None
    put('output_sha', digest, 'stdout.txt unavailable')
    patterns = []
    for pattern in switch_regex:
        try:
            patterns.append(re.compile(pattern))
        except re.error as exc:
            result['warnings'].append(f'invalid switch regex {pattern!r}: {exc}')
    result['switch_lines'] = [line for line in stderr.splitlines()
                              if any(p.search(line) for p in patterns)]
    for metric, expression in [('prompt_tps', r'prompt eval time.*?([\d.]+) tokens per second'),
                               ('eval_tps', r'(?<!prompt )\beval time.*?([\d.]+) tokens per second'),
                               ('load_s', r'\bload time\s*=\s*([\d.]+) ms'),
                               ('eval_tokens', r'(?<!prompt )\beval time.*?/\s*(\d+) (?:runs|tokens)')]:
        matches = re.findall(expression, stderr)
        try:
            value = float(matches[-1]) if matches else None
        except ValueError:
            value = None
        if metric == 'load_s' and value is not None:
            value /= 1000
        put(metric, value, 'performance line absent or invalid')

    # Preserve both the benchmark average and the clock-ramp-discarded mean.
    try:
        bench = json.loads(stdout)
    except ValueError:
        bench = []
    if isinstance(bench, dict):
        bench = [bench]
    if not isinstance(bench, list):
        bench = []
    result['bench'] = {'pp': [], 'tg': []}
    for row in bench:
        if not isinstance(row, dict):
            continue
        kind = ('pp' if row.get('n_prompt') and not row.get('n_gen') else
                'tg' if row.get('n_gen') and not row.get('n_prompt') else None)
        if kind is None:
            continue
        samples = row.get('samples_ts', [])
        samples = samples if isinstance(samples, list) else []
        clean = all(numeric(x) for x in samples)
        steady = statistics.mean(samples[1:]) if len(samples) > 1 and clean else None
        avg = row.get('avg_ts') if numeric(row.get('avg_ts')) else None
        result['bench'][kind].append({'avg_ts': avg, 'samples_ts': samples, 'steady': steady})
        for suffix, value in [('avg_ts', avg), ('samples_ts', samples), ('steady', steady)]:
            put(f'{kind}_{suffix}', value, 'need at least two finite benchmark samples')
        metric = 'prompt_tps' if kind == 'pp' else 'eval_tps'
        put(metric, avg, 'benchmark avg_ts missing')
        if kind == 'tg' and numeric(row.get('n_gen')):
            put('eval_tokens', row['n_gen'])
    for kind in ('pp', 'tg'):
        for suffix in ('avg_ts', 'samples_ts', 'steady'):
            if f'{kind}_{suffix}' not in result:
                put(f'{kind}_{suffix}', None, 'no matching llama-bench JSON row')

    values = {}
    swap_derived = []
    unavailable = {}
    factors = {'B': 1 / 1024, 'KiB': 1, 'MiB': 1024, 'GiB': 1024 ** 2,
               'kB': 1000 / 1024}
    for line in read('telemetry.jsonl').splitlines():
        try:
            row = json.loads(line)
        except ValueError:
            result['warnings'].append('ignored malformed telemetry line')
            continue
        if not isinstance(row, dict):
            continue
        local = {}
        metrics = row.get('metrics', [])
        for metric in metrics if isinstance(metrics, list) else []:
            if not isinstance(metric, dict) or not numeric(metric.get('value')):
                continue
            name, value = metric.get('name'), metric['value']
            if not isinstance(name, str):
                continue
            if name == 'device_read':
                factor = factors.get(metric.get('unit', 'KiB'))
                if factor is None:
                    unavailable[name] = 'unsupported device_read unit'
                    continue
                value *= factor
            elif name in ('mem_available', 'swap_used', 'swap_total', 'swap_free'):
                factor = factors.get(metric.get('unit', 'MiB'))
                if factor is None:
                    continue
                value *= factor / 1024
            values.setdefault(name, []).append(value)
            local[name] = value
        if 'swap_total' in local and 'swap_free' in local:
            swap_derived.append(local['swap_total'] - local['swap_free'])
        missing = row.get('unavailable', [])
        for metric in missing if isinstance(missing, list) else []:
            if isinstance(metric, dict):
                unavailable[metric.get('name')] = str(metric.get('reason') or 'unavailable')

    def delta(name):
        v = values.get(name, [])
        return max(v) - min(v) if len(v) >= 2 else None

    read_kib, ios = delta('device_read'), delta('device_read_ios')
    put('nvme_gib', read_kib / 1024 ** 2 if read_kib is not None else None,
        unavailable.get('device_read', 'need two device_read samples'))
    put('avg_kib_per_io', read_kib / ios if read_kib is not None and ios and ios > 0 else None,
        'need device_read and positive device_read_ios delta')
    tokens = result['eval_tokens']
    put('nvme_gib_per_token', result['nvme_gib'] / tokens
        if result['nvme_gib'] is not None and tokens and tokens > 0 else None,
        'need NVMe delta and positive eval token count')
    for key, names, fn in [('mem_available_min_mib', ['mem_available'], min),
                           ('swap_max_mib', ['swap_used'], max),
                           ('gpu_freq_median', ['gpu_freq', 'gpu_freq_cur'], statistics.median)]:
        samples = next((values[n] for n in names if values.get(n)), [])
        if key == 'swap_max_mib':
            samples = samples + swap_derived
        put(key, fn(samples) if samples else None,
            '; '.join(unavailable.get(n, f'{n} not recorded') for n in names))
    if write:
        try:
            (directory / 'summary.json').write_text(json.dumps(result, indent=2) + '\n')
        except OSError as exc:
            result['warnings'].append(f'cannot write summary.json: {exc.strerror}')
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('dirs', nargs='+')
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--no-write', action='store_true')
    parser.add_argument('--switch-regex', action='append', default=[])
    args = parser.parse_args()
    summaries = [summarize(d, args.switch_regex, not args.no_write) for d in args.dirs]
    if args.json:
        print(json.dumps(summaries[0] if len(summaries) == 1 else summaries, indent=2))
    else:
        for summary in summaries:
            print(json.dumps(summary))


if __name__ == '__main__':
    main()

