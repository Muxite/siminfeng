{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > cc/memory_pareto/test_pareto.py <<'PY'\n\\\"\\\"\\\"Synthetic inputs only; no lab services or external dependencies beyond pytest.\\\"\\\"\\\"\nimport csv\nimport importlib.util\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nSPEC = importlib.util.spec_from_file_location('pareto', Path(__file__).with_name('pareto.py'))\npareto = importlib.util.module_from_spec(SPEC)\nSPEC.loader.exec_module(pareto)\n\n\ndef write_csv(path, rows):\n    with path.open('w', newline='') as stream:\n        writer = csv.DictWriter(stream, fieldnames=pareto.FIELDS)\n        writer.writeheader()\n        for overrides in rows:\n            row = dict(config='base', desc='synthetic', **{'class': 'transferable'},\n                       gpu_mib=600, host_mib=100, tg_ts=20, pp_ts=50,\n                       kld=0.1, top1_pct=98, ppl_ratio=1.02, notes='')\n            row.update(overrides)\n            writer.writerow(row)\n    return path\n\n\ndef load(tmp_path, overrides, budget=700):\n    path = write_csv(tmp_path / 'configs.csv', overrides)\n    return {r['config']: r for r in pareto.analyze(pareto.read_csv(path), budget)}\n\n\ndef test_dominated_and_tradeoff(tmp_path):\n    rows = load(tmp_path, [dict(config='best'), dict(config='dominated', gpu_mib=650, tg_ts=19, kld=.2),\n                           dict(config='fast', gpu_mib=800, tg_ts=30, kld=.2)])\n    assert rows['best']['pareto_optimal']\n    assert not rows['dominated']['pareto_optimal']\n    assert rows['fast']['pareto_optimal']\n\n\ndef test_budget_boundary_and_unknown(tmp_path):\n    rows = load(tmp_path, [dict(config='boundary', gpu_mib=700), dict(config='over', gpu_mib=700.1, tg_ts=30),\n                           dict(config='unknown', gpu_mib='')])\n    assert rows['boundary']['fits_budget'] is True\n    assert rows['boundary']['budget_pareto_optimal']\n    assert rows['over']['fits_budget'] is False\n    assert rows['over']['pareto_optimal']\n    assert not rows['over']['budget_pareto_optimal']\n    assert rows['unknown']['fits_budget'] is None\n    assert rows['unknown']['missing_objectives'] == ['gpu_mib']\n    assert not rows['unknown']['pareto_optimal']\n\n\ndef test_missing_quality_never_zero_filled(tmp_path):\n    rows = load(tmp_path, [dict(config='missing', gpu_mib=1, tg_ts=100, kld='', top1_pct='NA', ppl_ratio='nan'),\n                           dict(config='complete'), dict(config='kld_only', top1_pct='', ppl_ratio='')])\n    assert rows['missing']['missing_quality'] == ['kld', 'top1_pct', 'ppl_ratio']\n    assert rows['missing']['fits_budget']\n    assert not rows['missing']['pareto_optimal']\n    assert not rows['missing']['budget_pareto_optimal']\n    assert rows['complete']['pareto_optimal']\n    assert rows['kld_only']['pareto_optimal']  # KLD alone supplies the quality objective.\n\n\ndef test_exact_ties_and_single_axis_domination(tmp_path):\n    rows = load(tmp_path, [dict(config='tie1'), dict(config='tie2'), dict(config='worse', kld=.11)])\n    assert rows['tie1']['pareto_optimal'] and rows['tie2']['pareto_optimal']\n    assert rows['tie1']['budget_pareto_optimal'] and rows['tie2']['budget_pareto_optimal']\n    assert not rows['worse']['pareto_optimal']\n\n\ndef test_classes_are_labelled_and_have_separate_frontiers(tmp_path):\n    rows = load(tmp_path, [dict(config='transfer'), dict(config='discrete', gpu_mib=500, **{'class': 'discrete-only'})])\n    assert rows['discrete']['pareto_optimal']\n    assert not rows['transfer']['pareto_optimal']\n    assert rows['transfer']['class_pareto_optimal']\n    assert rows['discrete']['class'] == 'discrete-only'\n\n\ndef test_cli_outputs_sorted_markdown_json_and_scatter(tmp_path, capsys):\n    source = write_csv(tmp_path / 'configs.csv', [dict(config='large', gpu_mib=900),\n                                                dict(config='small|x', gpu_mib=0, kld=0),\n                                                dict(config='unknown', gpu_mib='')])\n    output = tmp_path / 'out'\n    assert pareto.main([str(source), '--output-dir', str(output), '--budget-mib', '0']) == 0\n    payload = json.loads((output / 'pareto.json').read_text())\n    assert [r['config'] for r in payload['rows']] == ['small|x', 'large', 'unknown']\n    assert payload['rows'][0]['fits_budget']\n    assert payload['budget_mib'] == 0\n    report = (output / 'pareto.md').read_text()\n    assert capsys.readouterr().out == report\n    assert 'small\\\\\\\\|x' in report\n    assert 'GPU MiB' in report and '\"'```text'\"' in report\n    assert 'statistical significance' in report\n    assert 'Discrete-only' in report\n\n\ndef test_header_only_csv(tmp_path):\n    path = write_csv(tmp_path / 'empty.csv', [])\n    assert pareto.read_csv(path) == []\n    assert 'No measurements' in pareto.markdown([], 700, str(path))\n    assert 'No scatter points' in pareto.scatter([], 700)\n\n\n@pytest.mark.parametrize('field,value', [('gpu_mib', '-1'), ('kld', 'oops'), ('class', 'bad'), ('top1_pct', '101')])\ndef test_invalid_csv_values_rejected(tmp_path, field, value):\n    path = write_csv(tmp_path / 'bad.csv', [{field: value}])\n    with pytest.raises(ValueError):\n        pareto.read_csv(path)\n\n\n@pytest.mark.parametrize('budget', ['-1', 'nan', 'inf'])\ndef test_invalid_budget_rejected(budget, tmp_path):\n    with pytest.raises(SystemExit) as exc:\n        pareto.main(['--budget-mib', budget, '--output-dir', str(tmp_path)])\n    assert exc.value.code == 2\n\n\ndef test_explicit_missing_csv_does_not_silently_use_lab(tmp_path):\n    with pytest.raises(SystemExit) as exc:\n        pareto.main([str(tmp_path / 'missing.csv'), '--output-dir', str(tmp_path)])\n    assert exc.value.code == 2\n\n\ndef test_csv_is_primary_even_if_lab_exists(tmp_path, monkeypatch):\n    monkeypatch.setattr(pareto, 'ROOT', tmp_path)\n    source = tmp_path / 'experiments/memory/configs.csv'\n    source.parent.mkdir(parents=True)\n    write_csv(source, [dict(config='manual')])\n    # An invalid lab file must not be read when the manual CSV is present.\n    lab = tmp_path / 'lab/jobs/job-a/att-1'\n    lab.mkdir(parents=True)\n    (lab / 'result.json').write_text('not json')\n    pareto.main(['--output-dir', str(tmp_path / 'out')])\n    payload = json.loads((tmp_path / 'out/pareto.json').read_text())\n    assert payload['source_kind'] == 'csv'\n    assert payload['rows'][0]['config'] == 'manual'\n\n\ndef test_fallback_keeps_measurements_separate_and_skips_failures(tmp_path):\n    lab = tmp_path / 'lab'\n    attempt = lab / 'jobs/job-a/att-1'\n    attempt.mkdir(parents=True)\n    (lab / 'tests').mkdir()\n    (lab / 'tests/mem.json').write_text(json.dumps({'mem': {'model_file': 'q4.gguf', 'args': ['-n', '128']}}))\n    (attempt.parent / 'job.json').write_text(json.dumps({'spec': {'model': 'bf16.gguf', 'tests': ['mem', 'ppl']}}))\n    (attempt / 'result.json').write_text(json.dumps({\n        'execution': {'status': 'completed'}, 'quality': {'tests': {\n            'mem#0': {'exit_code': 0, 'mem': {'gpu_peak_mib': 650, 'gpu_delta_mib': 600},\n                      'samples': [{'n_prompt': 0, 'n_gen': 128, 'avg_ts': 42}]},\n            'ppl#1': {'exit_code': 0, 'ppl': 7.2, 'ppl_stderr': .1},\n            'bad#2': {'exit_code': 1}, 'partial#3': {'exit_code': 0, 'partial': True}}}}))\n    interrupted = attempt.parent / 'att-2'\n    interrupted.mkdir()\n    (interrupted / 'result.json').write_text(json.dumps({'execution': {'status': 'interrupted'},\n                                                       'quality': {'tests': {'bad': {'exit_code': 0}}}}))\n    rows = pareto.read_lab(lab)\n    assert len(rows) == 2\n    assert rows[0]['desc'] == 'q4.gguf'\n    assert rows[0]['gpu_mib'] == 650  # Peak, never delta.\n    assert rows[0]['tg_ts'] == 42\n    assert rows[0]['kld'] is None and rows[0]['ppl_ratio'] is None\n    assert rows[1]['tg_ts'] is None\n    assert 'ppl=7.2' in rows[1]['notes']\n    assert all(r['class'] == 'unclassified' for r in rows)\n    assert not any(r['pareto_optimal'] for r in pareto.analyze(rows, 700))\nPY\ncat > cc/memory_pareto/README.md <<'MD'\n# Memory, quality and speed report\n\nRun from any working directory (Python standard library only):\n\n\"'```sh\npython /home/muk/projects/siminfeng/campaign/cc/memory_pareto/pareto.py\npython cc/memory_pareto/pareto.py experiments/memory/configs.csv --budget-mib 700\n```\n\nThe script prints a Markdown table sorted by ascending GPU MiB (unknown memory last), followed by a terminal ASCII scatter of GPU MiB versus KLD. It writes `pareto.md` and `pareto.json` beside the script by default. `--output-dir artifacts/codexI` selects another assignment-permitted destination. Reports are overwritten on reruns. Nothing is written to the input paths. No network, Docker, or third-party runtime packages are used.\n\n## Inputs\n\nThe primary input is `experiments/memory/configs.csv`, resolved relative to the campaign root, with these required headers:\n\n```csv\nconfig,desc,class,gpu_mib,host_mib,tg_ts,pp_ts,kld,top1_pct,ppl_ratio,notes\n```\n\n`class` must be `transferable`, `discrete-only`, or `mixed`. Supply the orchestrator'\"'s classifications; the script does not validate scientific transferability. Memory is MiB; TG and PP are tokens per second. KLD is smaller-is-better. Top1 is a percentage; PPL ratio is supplied relative to the experiment's stated reference. Neither is converted into KLD. Empty cells, NA, N/A, null, none, NaN and nonfinite numbers become unavailable, never zero. Invalid numbers, negative values, invalid classes, and percentages above 100 are errors. Zero is valid. Notes should identify workloads, hardware, model, measurement method and quality reference. Rows are individual observations; repeated names or exact metric ties are preserved.\n\nIf the default CSV is absent, the script reads \"'`lab/jobs/*/att-*/result.json`, the corresponding `job.json` (`spec.model`), and `lab/tests/*.json` (test-specific `model_file`, args and env). `--lab-root` overrides this fallback root. An explicitly supplied CSV path that is absent is an error; an invalid or empty existing CSV never triggers fallback.\n\nFallback accepts completed attempts and successful, nonpartial tests only. It emits a separate row per benchmark sample record or quality test; it never joins observations across tests, attempts, models or workloads. GPU MiB means `mem.gpu_peak_mib`, **not** baseline-subtracted delta; host MiB means `host_cgroup_peak_mib`. TG requires zero prompt tokens and positive generated tokens; PP requires zero generated tokens and positive prompt tokens. Combined PP+TG samples supply neither speed objective. `avg_ts` supplies speed; repeated `samples_ts` are not independently analyzed. Raw PPL and its stderr are recorded in notes, but no PPL ratio or KLD is invented. Fallback classification is explicitly `unclassified`, so these rows cannot support transferable claims. Job/test/sample identifiers and source result paths are retained. Attempts are not averaged or deduplicated.\n\n## Frontier and budget\n\nA row is Pareto-optimal if no other eligible row has GPU MiB no higher, TG tokens/s no lower, and KLD no higher, with at least one strict improvement. All three objectives must be available. Exact ties remain optimal together. Missing Top1 or PPL ratio is flagged but does not disqualify a row with KLD. Missing KLD, GPU memory or TG speed excludes it from every frontier. Missing-quality and missing-objective lists are explicit in both output formats.\n\nThe table and JSON mark the global frontier, the frontier among budget-fitting rows, and the frontier within each labelled class. The global comparison is a descriptive pooled view; it does not combine discrete-only measurements into transferable claims. Always consult the class column and class frontier. Comparing workloads or quality references that differ may be meaningless even within one class.\n\nA row fits when its known GPU MiB is **at most** `--budget-mib` (inclusive); missing GPU memory has unknown fit. Fit does not require quality data or frontier membership. The budget defaults to 700 MiB, a rounded scaled analogue of a 500 GB to 128 GB target on a 2.67 GB model (2.67 × 128 / 500 ≈ 0.684 GB). This is a comparison line, not a prediction of unified-memory or production capacity; GB/MiB conventions and runtime overhead matter. Host memory is shown separately and is not added to the GPU budget. Since GPU memory is also an objective, a fitting row'\"'s dominator must also fit; the budget frontier is therefore the global frontier restricted to fitting rows.\n\nThe ASCII scatter is only a two-dimensional projection; its frontier symbols come from all three objectives, including TG speed. \"'`+` indicates plotting-cell collisions. Point coordinates reference table row numbers. Unknown GPU/KLD points are omitted and an empty plot is explained.\n\n## Limits and validation\n\nThis tool establishes **no statistical significance**, uncertainty bounds, speed stability, quality equivalence, or causal improvement. It uses exact input values without tolerance, confidence intervals or significance tests. A frontier is relative only to supplied observations and these objectives, not proof of general optimality. Host memory, PP, Top1 and PPL ratio are contextual columns, not optimization axes. Discrete-only rows remain labelled; neither they nor mixed/unclassified rows establish transferable savings. Fair claims require matched workloads, hardware, model/quality references and memory accounting, reviewed outside this script.\n\nRun synthetic checks without writing outside the assignment locations:\n\n```sh\nPYTHONDONTWRITEBYTECODE=1 python -m pytest -q -p no:cacheprovider '\"\\\\\n  --basetemp=artifacts/codexI/pytest-tmp cc/memory_pareto/test_pareto.py\n\"'```\n\nTests cover domination, speed/quality trade-offs, inclusive and unknown budget fit, missing quality/objectives, ties, class frontiers, sorting and report output, zero values, invalid inputs, CSV precedence, and conservative lab fallback.\nMD\nPYTHONDONTWRITEBYTECODE=1 python -m pytest -q -p no:cacheprovider --basetemp=artifacts/codexI/pytest-tmp cc/memory_pareto/test_pareto.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
