{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python3 -B - <<'PY'\nimport json,sys\nsys.path.insert(0,'cc/moe_planner')\nimport decode_model\nq=json.load(open('artifacts/codexPL4/model-stats.json'))['qwen']\nprint('stats scalars', {k:v for k,v in q.items() if isinstance(v,(int,float,str))})\nprint('tensor sample',q['tensors'][:2])\nc=json.load(open('cc/moe_planner/calibration.json'))['physical_decode']['constants']\nfor k in (0,18,30,42,48):print('base',k,decode_model.predict(q,'static',k,c)['decode_tps'])\nfor domain in ('prose','chat','code'):\n rows=[json.loads(s) for s in open(f'artifacts/codexQRT/{domain}.jsonl') if '\\\"decode\\\"' in s];layers={l:[] for l in range(48)}\n for r in rows:layers[r['layer']].append(set(r['experts']))\n print(domain,[(d,round(sum(sum(len(set().union(*v[i:i+d])) for i in range(65-d))/(65-d) for v in layers.values())/48,3)) for d in (1,2,3,4,8,16)])\nPY\ncat artifacts/codexPL4/last-message.txt\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
