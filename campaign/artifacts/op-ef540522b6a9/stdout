rts_bytes != parts_bytes) {\n   633\t        err = \"session_loop: the scratch was sized for a different k or n_embd\";\n   634\t        return false;\n   635\t    }\n   636\t\n   637\t    // HOST-side staging for the pool's answer.  It is copied to `gr.parts_dev` before the next launch, on the\n   638\t    // same stream, so the ordering is the stream's and no captured node is needed for it.\n   639\t    //\n   640\t    // ---- **PINNED, BECAUSE A COPY FROM PAGEABLE MEMORY IS NOT ASYNCHRONOUS AT ALL.**\n   641\t    //\n   642\t    // `cudaMemcpyAsync` with a pageable source cannot DMA: the driver first memcpys the bytes into an internal\n   643\t    // pinned bounce buffer, SYNCHRONOUSLY, on this thread, and only then enqueues the transfer.  So the \"async\"\n   644\t    // copy would be a blocking memcpy plus a driver round trip, on the critical path of all 48 layers.  The\n   645\t    // doorbell's `h_x_f` is `cudaHostAlloc(Mapped)` for exactly this reason and this buffer is the same kind of\n   646\t    // object.\n   647\t    float* y_miss = scratch->y_miss;\n   648\t    cudaEvent_t probe = scratch->probe;\n   649\t\n   650\t    // the first layer has no previous layer's experts: `y_miss` starts at zero, which is what \"hits are empty\n   651\t    // in this phase\" means once every miss has been computed\n   652\t    cudaMemcpyAsync(gr.parts_dev, y_miss, parts_bytes, cudaMemcpyHostToDevice, cs);\n   653\t    doorbell_reset(*s.db);\n   654\t    uint32_t expected = 0;\n   655\t\n   656\t    // **`pre[0]` IS LAUNCHED BEFORE THE LOOP SO EVERY ITERATION HAS THE SAME SHAPE**: poll the ring that\n   657\t    // `pre[l]` published, run the pool on it, combine, then start layer `l+1`'s `pre`.\n   658\t    //\n   659\t    // SLOT 0 OF THE DUMP IS THE INPUT, not a layer output.  `s.R` holds the embedding broadcast to every stream\n   660\t    // when this function is entered, which is the reference's `hc_init` node - so dumping it here is what splits\n   661\t    // \"th