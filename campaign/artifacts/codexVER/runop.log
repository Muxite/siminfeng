cpython-312.pyc\ncc/routing_trace/trace_replay.py\ncc/routing_trace/routing-trace.patch\ncc/routing_trace/test_trace_replay.py\ncc/nsys_decode/README.md\ncc/nsys_decode/analyze_nsys.py\ncc/nsys_decode/test_analyze_nsys.py\ncc/moe_planner/__pycache__/plan.cpython-312.pyc\ncc/moe_planner/__pycache__/test_plan.cpython-312-pytest-9.0.2.pyc\ncc/moe_planner/test_plan.py\ncc/moe_planner/calibration.json\ncc/moe_planner/plan.py\ncc/moe_planner/quality_ledger.json\ncc/moe_planner/fit_decode.py\ncc/moe_planner/decode_model.py\ncc/moe_planner/build_quality_ledger.py\ncc/moe_planner/test_quality_ledger.py\ncc/moe_planner/test_decode_model.py\ncc/moe_planner/cpu_type_screen.py\ncc/moe_planner/validate_decode.py\ncc/moe_planner/PLANNER.md\ncc/gpu_budget/README.md\ncc/gpu_budget/gpubudget.c\ncc/gpu_budget/build.sh\ncc/gpu_budget/test_budget.cu\ncc/gpu_budget/run_test.sh\ncc/demo/inspect.py\ncc/demo/demo.sh\ncc/demo/DEMO.md\ncc/moe_static_hot/test_make_hot_set.py\ncc/factory/README.md\ncc/moe_static_hot/README.md\ncc/factory/factory.py\ncc/moe_static_hot/static-hot.patch\ncc/moe_static_hot/make_hot_set.py\ncc/factory/components.json\ncc/factory/test_factory.py\ndecisions/D016-image-identity-confusion.md\ndecisions/D004-profiler-qualification.md\ndecisions/D007-gpu-lock-removed.md\ndecisions/D008-profile-decode-granite.md\ndecisions/D023-novmm-engine-under-budget.md\ndecisions/D015-ssd-tier-emulation.md\ndecisions/D006-reconcile-overwrote-result.md\ndecisions/D014-slot-cache-prediction.md\ndecisions/D001-wrapper-orphan-gap.md\ndecisions/D017-routing-skew-control.md\ndecisions/D029-c1-q8reuse-accepted.md\ndecisions/D009-representation-screen.md\ndecisions/D038-qwen-frontier-protocol.md\ndecisions/D039-qwen-frontier-results.md\ncc/build_engine/README.md\ndecisions/D019-hybrid-harness-result.md\ndecisions/D005-ppl-gate-calibration.md\ndecisions/D018-directive-strata-concepts-and-budget.md\ndecisions/D021-gpu-budget-shim-qualified.md\ncc/engine_handoff/README.md\ncc/pap/README.md\ncc/pa