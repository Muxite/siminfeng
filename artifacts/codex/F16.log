                logits.reserve(router_weight->ne[1]);
                for (int64_t e = 0; e < router_weight->ne[1]; ++e) {
                    float dot = 0;
                    for (int64_t j = 0; j < router_weight->ne[0]; ++j) { dot += router[e * router_weight->ne[0] + j] * input[j]; }
                    if (!std::isfinite(dot)) { throw std::runtime_error("nonfinite pregate logits"); }
                    logits.emplace_back(dot, int32_t(e));
                }
                const size_t k = std::min(expert_pregate_k, logits.size());
                auto rank = [&](const auto & a, const auto & b) {
                    if (a.first != b.first) { return a.first > b.first; }
                    if (expert_config.pregate_mode == "hybrid") {
                        const auto x = std::find(temporal_ids.begin(), temporal_ids.end(), a.second);
                        const auto y = std::find(temporal_ids.begin(), temporal_ids.end(), b.second);
                        if (x != y) { return x < y; }
                    }
                    return a.second < b.second;
                };
                // Keep the router source ranking independent of the hybrid tie break.
                std::partial_sort(logits.begin(), logits.begin() + k, logits.end(), [](const auto & a, const auto & b) {
                    return a.first != b.first ? a.first > b.first : a.second < b.second;
                });
                for (size_t i = 0; i < k; ++i) { router_ids.push_back(logits[i].second); }
                chosen = router_ids;
                if (expert_config.pregate_mode == "hybrid") {
                    std::vector<std::pair<float, int32_t>> candidates;
                    for (const auto & score : logits) {
                        if (std::find(router_ids.begin(), router_ids.end(), score.second) != router_ids.end() ||
                                std::find(temporal_ids.begin(), temporal_ids.end(), score.second) != temporal_ids.end()) { candidates.push_back(score); }
                    }
                    std::sort(candidates.begin(), candidates.end(), rank);
                    chosen.clear();
                    for (size_t i = 0; i < std::min(k, candidates.size()); ++i) { chosen.push_back(candidates[i].second); }
                }
            }
            auto & predictions = next.predictions[distance - 1];
            predictions.clear();
            const auto & layer = model.layers[target];
            for (const int32_t id : chosen) {
                ExpertFiller::Prediction prediction;
                prediction.id = id;
                std::map<size_t, std::vector<ExpertFiller::Range>> ranges;
                for (const ggml_tensor * expert : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
                    if (!expert) { continue; }
                    llama_model::expert_file_range info;
                    if (!model.expert_file_info(expert, info)) { throw std::runtime_error("pregate expert offsets unavailable"); }
                    const auto id = prediction.id;
                    if (id < 0 || id >= expert->ne[2]) { throw std::runtime_error("pregate expert ID outside tensor"); }
                    ranges[info.file_index].push_back({info.offset + size_t(id) * expert->nb[2], expert->nb[2]});
                }
                // Residency at prediction time is distinct from completed IO.
                // Probe all files before publishing jobs for this expert.
                std::vector<size_t> cold;
                for (const auto & entry : ranges) {
                    if (expert_fillers.at(entry.first)->nonresident(entry.second)) { cold.push_back(entry.first); }
                }
                for (const auto & entry : ranges) {
                    auto & filler = *expert_fillers.at(entry.first);
                    prediction.enqueue(filler, entry.second, target, [&](const auto &) {
                        return std::find(cold.begin(), cold.end(), entry.first) == cold.end();
                    }, distance);
                }
                next.predicted.push_back(prediction.id);
                predictions.push_back(std::move(prediction));
            }
            ++pregate_predictions;
        }
    } catch (const std::exception & e) {
        ++pregate_skips; expert_pregate_failed = true;
        LLAMA_LOG_INFO("expert_pregate: prediction disabled (%s)\n", e.what());
    }
}

void llama_context::expert_pregate_stats() {
    uint64_t bytes=0, reads=0, errors=0, dropped=0, cancelled_jobs=0, cancelled_bytes=0, demand_ns=0;
    for (auto & entry : expert_fillers) {
        entry.second->wait_async(); // teardown only, after graph synchronize
        demand_ns += entry.second->counters().total_fill_wall_ns;
        const auto c = entry.second->async_counters();
        bytes += c.bytes_read; reads += c.read_syscalls; errors += c.errors; dropped += c.dropped;
        cancelled_jobs += c.cancelled_jobs; cancelled_bytes += c.cancelled_bytes;
    }
    const auto & t = pregate_timeliness;
    LLAMA_LOG_INFO("expert_pregate: stats predictions=%" PRIu64 " arrivals=%" PRIu64
        " hits=%" PRIu64 " actual=%" PRIu64 " predicted=%" PRIu64 " recall_at_k=%.6f precision=%.6f"
        " async_bytes_read=%" PRIu64 " async_reads=%" PRIu64 " async_errors=%" PRIu64 " dropped=%" PRIu64
        " cancelled_jobs=%" PRIu64 " cancelled_bytes=%" PRIu64
        " inflight_at_arrival=%" PRIu64 " inflight_reads=%" PRIu64 " pending_reads=%" PRIu64
        " sync_bytes_with_prediction=%" PRIu64 " sync_bytes_without_prediction=%" PRIu64
        " sync_calls_with_prediction=%" PRIu64 " sync_calls_without_prediction=%" PRIu64 " skips=%" PRIu64

codex
P13 now targets the mapped pages directly with `MADV_POPULATE_READ`, including cached pages that may still lack page-table entries. P14 ranks complete expert bundles after warmup and falls back to evictable `WILLNEED` advice if `mlock` fails.

One limitation in the requested hybrid rule: ranking the union by router score and capping it at router K normally keeps the router’s original top K. Temporal IDs affect the result mainly at score ties. I’m preserving that rule and will call it out in the results.
