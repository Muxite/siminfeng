def test_gate_noise_and_drift():
    g = gate.evaluate({'base': runs([90, 110]), 'B': runs([120, 120])})
    assert g['aa_gap'] == .2
    assert g['drift'] == .2
    assert g['drift_halves'] == [90, 110]
    assert g['threshold'] == .4
    assert g['comparisons']['B']['verdict'] == 'null'


