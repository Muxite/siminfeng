"""Deterministic admission, durable lab submission and evidence upload boundary."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import time

from . import contract as contracts
from .jobs import Jobs
from .lab_runner import ENV_KEYS, collect, inspect_image
from .store import ArtifactConflict, FactoryError, NotFound, Store, encoded

from .config import BASELINE_RECORD, BASELINE_IMAGE, LAB_TIMEOUT


class AdmissionError(FactoryError):
    def __init__(self, code, message):
        self.code = code
        super().__init__(message)


class UploadConflict(FactoryError):
    code = 'UPLOAD_CONFLICT'


class Manager:
    def __init__(self, store, spool_root):
        self.store = store
        self.spool_root = Path(spool_root).resolve()
        self.spool_root.mkdir(parents=True, exist_ok=True)
        self.jobs = Jobs(store)

    def admit(self, task_id, image_ref, build_attempt_id):
        self.store.get_task(task_id)
        if not isinstance(image_ref, dict) or set(image_ref) != {'tag', 'id'}:
            raise ValueError('image requires tag and id')
        if (not isinstance(image_ref['tag'], str) or not image_ref['tag'] or image_ref['tag'].startswith('-')
                or not re.fullmatch(r'sha256:[a-f0-9]{64}', image_ref['id'])):
            raise ValueError('Invalid image tag or immutable Id')
        build = self.store._get('attempts', task_id, build_attempt_id)
        if build['kind'] != 'build':
            raise ValueError('build_attempt_id must name a build')
        # Reconcile the durable build lifecycle before accepting its receipt.
        if build['jobq_id'] or build['state'] != 'succeeded':
            build = self.jobs.status(build_attempt_id)
        if build['state'] != 'succeeded':
            raise ValueError('Admission requires a successful build attempt')
        receipt = json.loads(self.store.artifact_bytes(task_id, build_attempt_id + ':receipt'))
        row = inspect_image(image_ref['tag'])
        if row['Id'] != receipt.get('image_id') or row['Id'] != image_ref['id']:
            raise AdmissionError('BAD_DIGEST', 'Local image Id differs from build receipt or requested Id')
        if row.get('Architecture') != 'arm64' or (row.get('Config', {}).get('Labels') or {}).get('campaign.target.profile') != 'jetson-orin':
            raise AdmissionError('WRONG_TARGET', 'Image requires arm64 and campaign.target.profile=jetson-orin')
        admission = dict(task_id=task_id, image=dict(image_ref), build_attempt_id=build_attempt_id,
            delivery='same_host_local_image', architecture='arm64', target_profile='jetson-orin')
        key = hashlib.sha256(encoded(admission).encode()).hexdigest()
        admission['admission_id'] = 'admission:' + key
        self.store.put_artifact(task_id, admission['admission_id'], encoded(admission).encode(),
                                'application/json', build_attempt_id)
        return admission

    def _admission(self, task_id, admission_id):
        record = json.loads(self.store.artifact_bytes(task_id, admission_id))
        if record['task_id'] != task_id or record['admission_id'] != admission_id:
            raise ValueError('Admission identity differs')
        return record

    def submit_run(self, task_id, admission_id, contract_id, run_config, idem_key, role='candidate'):
        # role is set only by the Manager (freeze_reference -> 'reference'); agents cannot pass it.
        if role not in {'candidate', 'reference'}:
            raise ValueError('role must be candidate or reference')
        admission = self._admission(task_id, admission_id)
        contract = contracts.load(contract_id)
        if not isinstance(run_config, dict) or set(run_config) - {'env', 'argv_overrides'}:
            raise ValueError('run_config allows env and argv_overrides')
        env = dict(contract['workload']['env'])
        requested = run_config.get('env', {})
        if not isinstance(requested, dict):
            raise ValueError('run_config.env must be an object')
        env.update(requested)
        if any(k not in set(ENV_KEYS) | {'LLAMA_MMAP_ADVICE'} or not isinstance(v, str)
               or not re.fullmatch(r'[A-Za-z0-9_./:+-]+', v) for k, v in env.items()):
            raise ValueError('Lab environment requires supported engine keys and shell-safe string values')
        argv = contract['workload']['argv']
        if run_config.get('argv_overrides') not in (None, {}, [], argv):
            raise ValueError('Scored workload argv is fixed; use a version+1 contract for changes')
        config = dict(admission=admission, contract=dict(contract), env=env, argv=argv, role=role)
        digest = hashlib.sha256(encoded(config).encode()).hexdigest()
        path = self.spool_root / 'configs' / (digest + '.json')
        if not path.exists():
            contracts.atomic_json(path, config)
        argv = [sys.executable, '-m', 'jiuwenswarm.factory.lab_runner', '--task', task_id,
            '--run', '{attempt_id}', '--admission', admission_id, '--contract', contract['contract_id'],
            '--config', str(path), '--spool', str(self.spool_root)]
        env_extra = dict(FACTORY_HOME=str(self.store.home))
        # Only these explicit executable seams are inherited for offline tests.
        for key in ('FACTORY_DOCKER', 'FACTORY_OM_RUN'):
            if key in os.environ:
                env_extra[key] = os.environ[key]
        return self.jobs.submit(task_id, 'lab', config, idem_key, 'gpu', argv, LAB_TIMEOUT, env_extra)

    def status(self, attempt_id):
        return self.jobs.status(attempt_id)

    def cancel(self, attempt_id):
        attempt = self.jobs.cancel(attempt_id)
        root = self.spool_root / attempt_id
        # jobq can SIGKILL an unresponsive worker. Reap only that run's recorded
        # container too, even if the worker's finally block could not execute.
        if (root / 'container.id').is_file():
            from .lab_runner import docker
            cid = (root / 'container.id').read_text().strip()
            if re.fullmatch(r'[a-f0-9]{12,64}', cid):
                docker(['rm', '-f', cid])
        return attempt

    def result(self, attempt_id):
        result = self.jobs.result(attempt_id)
        attempt = self.jobs._get(attempt_id)
        evaluation = None
        try:
            evaluation = self.store._get('evaluations', attempt['task_id'], attempt_id + ':evaluation')
        except NotFound:
            pass
        outcome = evaluation['execution_outcome'] if evaluation else (
            'cancelled' if result['state'] == 'cancelled' else 'upload_pending')
        return dict(result, execution_outcome=outcome, evaluation=evaluation,
                    evidence_refs=attempt['result_refs'])

    def ingest_upload(self, task_id, lab_run_id, bundle_dir):
        """Verify bytes, commit evidence, then acknowledge. Identical retries replay."""
        root = Path(bundle_dir).resolve()
        if root != self.spool_root / lab_run_id or not root.is_dir():
            raise ValueError('Bundle must be the lab run directory in the configured spool')
        raw_manifest = (root / 'manifest.json').read_bytes()
        digest = hashlib.sha256(raw_manifest).hexdigest()
        manifest = json.loads(raw_manifest)
        if manifest['task_id'] != task_id or manifest['lab_run_id'] != lab_run_id:
            raise ValueError('Upload task or lab run identity differs')
        with self.jobs.locked():
            attempt = self.store._get('attempts', task_id, lab_run_id)
            if attempt['kind'] != 'lab':
                raise ValueError('Upload requires a lab attempt')
            request = attempt['request']
            if (manifest['admission_id'] != request['admission']['admission_id'] or
                    manifest['contract_id'] != request['contract']['contract_id']):
                raise ValueError('Upload admission or contract identity differs')
            previous = self.store._db.execute('SELECT * FROM uploads WHERE task_id=? AND lab_run_id=?',
                                              (task_id, lab_run_id)).fetchone()
            if previous and previous['sha256'] != digest:
                raise UploadConflict('Lab run already names a different manifest')
            files = manifest['files']
            if not isinstance(files, dict) or 'config.json' not in files or 'worker.json' not in files:
                raise ValueError('Manifest requires config.json and worker.json')
            # Snapshot the verified bytes; concurrent changes cannot enter storage.
            content = {}
            for name, sha in files.items():
                if name in {'manifest.json', 'ack.json'} or Path(name).name != name or name in {'.', '..'}:
                    raise ValueError('Manifest paths must be bundle file basenames')
                path = (root / name).resolve()
                if path.parent != root or not path.is_file():
                    raise ValueError('Manifest path escapes bundle or is missing')
                data = path.read_bytes()
                if hashlib.sha256(data).hexdigest() != sha:
                    if previous:
                        raise UploadConflict('Previously uploaded lab run bytes have changed')
                    raise ValueError('Manifest SHA256 mismatch: ' + name)
                content[name] = data
            config = json.loads(content['config.json'])
            if config != dict(request, lab_run_id=lab_run_id):
                raise ValueError('Bundle configuration differs from submitted run')
            ack = dict(upload_id=lab_run_id + ':upload', sha256=digest, ack_state='durable')
            if not previous:
                # Analyse only a private copy of the hash-verified evidence.
                import tempfile
                with tempfile.TemporaryDirectory(dir=self.spool_root) as directory:
                    for name, data in content.items():
                        (Path(directory) / name).write_bytes(data)
                    run = collect(directory, config)
                evaluation = contracts.evaluate(request['contract'], run)
                refs = []
                for name, data in {'manifest.json': raw_manifest, **content}.items():
                    try:
                        artifact = self.store.put_artifact(task_id, lab_run_id + ':' + name, data,
                            'application/json' if name.endswith('.json') else 'text/plain', lab_run_id)
                    except ArtifactConflict as exc:
                        raise UploadConflict('Lab run already names different upload bytes') from exc
                    refs.append(artifact['artifact_id'])
                now = time.time()
                # All semantic records and the upload marker commit together.
                with self.store._transaction():
                    obs_id, eval_id = lab_run_id + ':observation', lab_run_id + ':evaluation'
                    self.store._insert('observations', dict(obs_id=obs_id, task_id=task_id,
                        source_artifacts=refs.copy(), kind='lab_result', values=run, error={},
                        host_run=dict(attempt_id=lab_run_id), confidence=None,
                        limitations=request['contract']['scope'], created=now))
                    self.store._insert('evaluations', dict(eval_id=eval_id, task_id=task_id,
                        contract_id=request['contract']['contract_id'], contract_version=str(request['contract']['version']),
                        contract=request['contract'], inputs=dict(run=run, source_artifacts=refs.copy(),
                            observation_id=obs_id, details=evaluation['details']),
                        **{k: evaluation[k] for k in ('execution_outcome', 'correctness', 'evidence_completeness')}, created=now))
                    refs += [obs_id, eval_id]
                    self.store._db.execute('UPDATE attempts SET result_refs=? WHERE task_id=? AND attempt_id=?',
                                           (encoded(refs), task_id, lab_run_id))
                    self.store._insert('uploads', dict(task_id=task_id, lab_run_id=lab_run_id,
                        upload_id=ack['upload_id'], sha256=digest, ack_state='durable', created=now))
            contracts.atomic_json(root / 'ack.json', ack)
            return ack

    def retry_spool(self):
        results = []
        for path in sorted(self.spool_root.glob('*/manifest.json')):
            try:
                manifest = json.loads(path.read_text())
                results.append(self.ingest_upload(manifest['task_id'], manifest['lab_run_id'], path.parent))
            except (FactoryError, OSError, ValueError, KeyError, TypeError) as exc:
                results.append(dict(lab_run_id=path.parent.name, execution_outcome='upload_pending',
                                    error=str(exc)[:200]))
        return results


def freeze_reference(manager, contract_id, image):
    contract = contracts.load(contract_id)
    if contract['reference']['stdout_sha256'] is not None:
        raise contracts.ContractFrozen('Contract is frozen; create a version+1 contract file')
    if image != contract['reference']['image_tag']:
        raise ValueError('Reference image must match the contract image tag')
    # Import the existing baseline build receipt, without invoking a build.
    # It passes the identical admission checks as a newly built candidate.
    record_path = BASELINE_RECORD
    record = json.loads(record_path.read_text())
    if record['image']['Id'] != contract['reference']['image_id']:
        raise ValueError('Baseline build receipt differs from contract')
    task = 'reference-' + contract['contract_id']
    try:
        manager.store.get_task(task)
    except NotFound:
        manager.store.create_task(dict(task_id=task, objective='Operator reference freeze', target={'profile': 'jetson-orin'}))
    key = 'reference-build-receipt'
    manager.store.put_artifact(task, key + ':receipt', encoded(dict(image_id=record['image']['Id'])).encode(), 'application/json', key)
    try:
        build = manager.store._get('attempts', task, key)
    except NotFound:
        build = manager.store.create_attempt(task, dict(attempt_id=key, kind='build', idem_key=key,
            fingerprint=hashlib.sha256(record_path.read_bytes()).hexdigest(), request=dict(imported_build_record=str(record_path))))
    if build['state'] == 'queued':
        build = manager.store.transition_attempt(task, key, 'running')
    if build['state'] == 'running':
        manager.store.transition_attempt(task, key, 'succeeded')
    # Imported historical builds have no jobq id to reconcile. Validate the raw
    # image and use admit's receipt check with the already observed terminal state.
    admission = manager.admit(task, dict(tag=image, id=record['image']['Id']), build['attempt_id'])
    # Key binds the contract content: an amended (still unfrozen) contract can never reuse an older run.
    ckey = hashlib.sha256(encoded(dict(contract)).encode()).hexdigest()[:12]
    handle = manager.submit_run(task, admission['admission_id'], contract_id, {'env': {}}, 'reference-run-' + ckey, role='reference')
    n = 1
    while handle['state'] in {'failed', 'cancelled', 'unknown'}:
        # A terminal prior attempt stays visible; the operator rerun is a new linked attempt.
        n += 1
        handle = manager.jobs.retry(handle['attempt_id'], f'reference-run-{ckey}-r{n}')
    while True:
        result = manager.result(handle['attempt_id'])
        if result['evaluation']:
            run = result['evaluation']['inputs']['run']
            frozen = contracts.freeze(contract.path, run)
            print(frozen['reference']['stdout_sha256'])
            return
        if result['state'] in {'failed', 'cancelled', 'unknown'}:
            raise ValueError('Reference run did not produce durable successful evidence; inspect result or retry-spool')
        time.sleep(.5)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('operation', choices=['ingest', 'retry-spool', 'freeze-reference'])
    parser.add_argument('--spool', type=Path)
    parser.add_argument('--task')
    parser.add_argument('--run')
    parser.add_argument('--bundle', type=Path)
    parser.add_argument('--contract', default='qwen36-greedy-v1')
    parser.add_argument('--image', default=BASELINE_IMAGE)
    args = parser.parse_args()
    with Store(Path(os.environ.get('FACTORY_HOME', '~/.jiuwenswarm-factory'))) as store:
        manager = Manager(store, args.spool or store.home / 'lab-spool')
        if args.operation == 'ingest':
            print(json.dumps(manager.ingest_upload(args.task, args.run, args.bundle)))
        elif args.operation == 'retry-spool':
            print(json.dumps(manager.retry_spool()))
        else:
            freeze_reference(manager, args.contract, args.image)


if __name__ == '__main__':
    main()
"""Fixed external lab worker. Store access belongs exclusively to Manager ingest."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import signal
import subprocess
import sys
import time

from .contract import atomic_json

from .config import OM_RUN, DOCKER_PREFIX, MIN_AVAIL_MIB, DOCKER_TIMEOUT, UPLOAD_TIMEOUT
from .effective_config import ENV_KEYS, parse_effective
REQUIRED = {'stdout.txt', 'stderr.txt', 'result.json', 'watchdog.jsonl',
            'telemetry.jsonl', 'threads.summary.json', 'cmd.txt'}


def docker(args):
    command = shlex.split(os.environ.get('FACTORY_DOCKER', 'docker')) + list(args)
    if not os.environ.get('FACTORY_DOCKER'):
        command = shlex.split(DOCKER_PREFIX) + [shlex.join(command)]
    return subprocess.run(command, capture_output=True, text=True, timeout=DOCKER_TIMEOUT)


def inspect_image(ref):
    result = docker(['image', 'inspect', ref])
    if result.returncode:
        raise ValueError('Local image is unavailable')
    return json.loads(result.stdout)[0]


def collect(root, config):
    """Parse raw files again on ingestion; never trust a worker's scored verdict."""
    root = Path(root)
    contract = config['contract']
    stderr = (root / 'stderr.txt').read_text(errors='replace') if (root / 'stderr.txt').exists() else ''
    def read_json(name):
        try:
            return json.loads((root / name).read_text())
        except (OSError, ValueError):
            return {}
    result = read_json('result.json')
    worker = read_json('worker.json')
    threads = read_json('threads.summary.json')
    lines, effective = parse_effective(stderr)
    mismatches = {}
    for key, value in config['env'].items():
        if key == 'LLAMA_MMAP_ADVICE':
            continue  # Patch 08 does not report this field; no effective-value claim.
        expected = str(int(value)) if value.isascii() and value.isdigit() else value
        actual = effective.get(ENV_KEYS.get(key))
        if actual != expected:
            mismatches[key] = dict(requested=value, effective=actual)
    config_ok = bool(lines) and len(set(lines)) == 1 and set(effective) == set(ENV_KEYS.values()) and not mismatches
    xfill = any(row.get('comm', '').startswith('xfill-') and row.get('samples', 0) > 0
                for row in threads.get('threads', {}).values())
    checks = {'effective_config_matches_request': config_ok, 'xfill_threads_present': xfill}
    required = list(contract['engagement_checks'])
    if config.get('role', 'candidate') == 'candidate':
        # Component-specific checks (e.g. patch 09 thread names) cannot hold on the reference image.
        required += contract.get('candidate_engagement_checks', [])
    for check in required:
        if check not in checks:
            checks[check] = check in stderr
    missing = sorted(name for name in REQUIRED if not (root / name).is_file())
    outcome = worker.get('execution_outcome', 'ok')
    invalid = re.search(r'^expert_config: invalid .*$', stderr, re.MULTILINE)
    watchdog = (root / 'watchdog.jsonl').read_text(errors='replace') if (root / 'watchdog.jsonl').exists() else ''
    if outcome == 'ok':
        if invalid:
            outcome = 'config_rejected'
        elif (result.get('oom_killed') or result.get('watchdog_trips') or 'watchdog_trip' in watchdog
              or result.get('exit_code') != 0 or result.get('status') != 'ok'
              or not config_ok or not all(checks.get(k, False) for k in required)):
            outcome = 'measurement_failed'
    complete = not missing and bool(result) and bool(threads)
    stdout = root / 'stdout.txt'
    metric = re.search(r'(?<!prompt )\beval time.*?\(\s*([\d.]+) ms per token', stderr)
    return dict(execution_outcome=outcome, evidence_completeness='complete' if complete else 'partial',
        stdout_sha256=hashlib.sha256(stdout.read_bytes()).hexdigest() if stdout.is_file() else None,
        image_id=config['admission']['image']['id'], run_ref=config.get('lab_run_id'),
        details=dict(requested=config['env'], effective=effective, mismatches=mismatches,
            unreported_requested=[k for k in config['env'] if k not in ENV_KEYS],
            effective_line_count=len(lines), engagement_checks=checks, missing_files=missing,
            invalid_message=invalid.group(0) if invalid else None,
            exit_status=result.get('exit_code'), aborted=(result.get('exit_code') or 0) > 128 or
                (result.get('exit_code') or 0) < 0 or bool(result.get('signal')),
            eval_ms_per_token=float(metric[1]) if metric else None, worker=worker))


def write_bundle(root, task, run, admission, contract):
    files = {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(root.iterdir())
             if p.is_file() and p.name not in {'manifest.json', 'ack.json'} and not p.name.startswith('.pending-')}
    manifest = dict(task_id=task, lab_run_id=run, admission_id=admission,
                    contract_id=contract, files=files)
    atomic_json(root / 'manifest.json', manifest)
    return manifest


def upload(task, run, root, spool):
    """A separate host process owns persistence. No store module is imported here."""
    for delay in (0, .2, 1, 2):
        if delay:
            time.sleep(delay)
        try:
            result = subprocess.run([sys.executable, '-m', 'jiuwenswarm.factory.manager',
                'ingest', '--task', task, '--run', run, '--bundle', str(root), '--spool', str(spool)],
                capture_output=True, text=True, timeout=UPLOAD_TIMEOUT)
        except (OSError, subprocess.SubprocessError):
            continue
        if result.returncode == 0 and (root / 'ack.json').exists():
            return True
    return False


def run(task, lab_run, admission, contract_id, config, spool):
    root = Path(spool) / lab_run
    root.mkdir(parents=True, exist_ok=True)
    config = json.loads(Path(config).read_text())
    config['lab_run_id'] = lab_run
    atomic_json(root / 'config.json', config)
    outcome, reason = 'ok', None
    process = None
    cancelled = False
    def stop(signum, frame):
        nonlocal cancelled
        cancelled = True
        if process is not None:
            process.terminate()
    previous = {sig: signal.signal(sig, stop) for sig in (signal.SIGTERM, signal.SIGINT)}
    try:
        image = inspect_image(config['admission']['image']['id'])
        if image['Id'] != config['admission']['image']['id']:
            outcome = 'bad_digest'
        elif image.get('Architecture') != 'arm64' or (image.get('Config', {}).get('Labels') or {}).get('campaign.target.profile') != 'jetson-orin':
            outcome = 'wrong_target'
        else:
            model = Path(config['contract']['model']['path'])
            if model.stat().st_size != config['contract']['model']['size']:
                raise ValueError('Model file size differs from contract')
            expected_sha = config['contract']['model'].get('sha256')
            if expected_sha:
                with model.open('rb') as stream:
                    if hashlib.file_digest(stream, 'sha256').hexdigest() != expected_sha:
                        raise ValueError('Model SHA256 differs from contract')
            # om_run interpolates ENV_FLAGS into its sg command. Manager restricts
            # every value to shell-safe tokens before this worker can be submitted.
            flags = ' '.join('-e ' + k + '=' + v for k, v in sorted(config['env'].items()))
            env = dict(os.environ, OM_THREADS='1', OM_MIN_AVAIL_MIB=str(MIN_AVAIL_MIB),
                       OM_MODELDIR=str(model.parent), DOCKER_CMD_PREFIX=DOCKER_PREFIX)
            with (root / 'launcher.stdout.txt').open('w') as stdout, (root / 'launcher.stderr.txt').open('w') as stderr:
                process = subprocess.Popen([os.environ.get('FACTORY_OM_RUN', OM_RUN), str(root),
                    image['Id'], flags, config['contract']['workload']['tool'], *config['argv']],
                    stdout=stdout, stderr=stderr, env=env)
                process.wait()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as exc:
        outcome, reason = 'measurement_failed', type(exc).__name__ + ': lab preflight or execution failed'
    finally:
        if cancelled:
            outcome = 'cancelled'
        # The container id belongs to this run directory. Never reap by global label.
        cleanup = 'no_container_created'
        cid_path = root / 'container.id'
        if cid_path.exists():
            cid = cid_path.read_text().strip()
            if re.fullmatch(r'[a-f0-9]{12,64}', cid):
                try:
                    removed = docker(['rm', '-f', cid])
                    cleanup = 'reaped' if removed.returncode == 0 or 'No such container' in removed.stderr else 'failed'
                except (OSError, subprocess.SubprocessError):
                    cleanup = 'failed'
            else:
                cleanup = 'invalid_container_id'
        if cleanup in {'failed', 'invalid_container_id'} and outcome == 'ok':
            outcome = 'measurement_failed'
        atomic_json(root / 'worker.json', dict(execution_outcome=outcome, reason=reason, cleanup=cleanup))
        for sig, handler in previous.items():
            signal.signal(sig, handler)
    write_bundle(root, task, lab_run, admission, contract_id)
    if not upload(task, lab_run, root, spool):
        print(json.dumps(dict(execution_outcome='upload_pending', lab_run_id=lab_run)))
        return 1
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ('task', 'run', 'admission', 'contract', 'config', 'spool'):
        parser.add_argument('--' + name, required=True)
    args = parser.parse_args()
    return run(args.task, args.run, args.admission, args.contract, args.config, args.spool)


if __name__ == '__main__':
    raise SystemExit(main())
"""Versioned greedy-continuation contracts. Freezing is an operator action."""
from __future__ import annotations

import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import tempfile
from datetime import datetime, timezone

CONTRACTS = Path(__file__).parent / 'contracts'
OUTCOMES = {'ok', 'config_rejected', 'measurement_failed', 'candidate_failed',
            'wrong_target', 'bad_digest', 'cancelled', 'upload_pending'}


class ContractFrozen(ValueError):
    pass


class Contract(dict):
    path: Path


def load(contract_id):
    path = Path(contract_id)
    if '/' not in str(contract_id) and not str(contract_id).endswith('.json'):
        if not re.fullmatch(r'[A-Za-z0-9_-]+', str(contract_id)):
            raise ValueError('Invalid contract identifier')
        path = CONTRACTS / (str(contract_id) + '.json')
    result = Contract(json.loads(path.read_text()))
    result.path = path.resolve()
    if result['version'] < 1 or result['tolerance'] != 'byte-identical stdout':
        raise ValueError('Unsupported contract version or tolerance')
    return result


def atomic_json(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix='.pending-')
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(value, stream, sort_keys=True, indent=2, allow_nan=False)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    finally:
        Path(temporary).unlink(missing_ok=True)


def freeze(path, reference_run):
    """Write the reference once, under a process lock; return the frozen contract."""
    path = Path(path)
    if '/' not in str(path) and path.suffix != '.json':
        raise ValueError('freeze requires an explicit contract path')
    contract = load(path)
    with path.with_suffix('.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        current = load(contract.path)
        if current['reference']['stdout_sha256'] is not None:
            raise ContractFrozen('Contract is frozen; create a version+1 contract file')
        if (reference_run.get('execution_outcome') != 'ok' or
                reference_run.get('evidence_completeness') != 'complete' or
                reference_run.get('image_id') != current['reference']['image_id']):
            raise ValueError('Reference requires a successful complete run of the pinned reference image')
        sha = reference_run.get('stdout_sha256', '')
        if not re.fullmatch(r'[a-f0-9]{64}', sha):
            raise ValueError('Reference stdout SHA256 is required')
        current['reference'].update(stdout_sha256=sha,
            frozen_at=datetime.now(timezone.utc).isoformat(), run_ref=reference_run['run_ref'])
        atomic_json(current.path, current)
        contract.clear()
        contract.update(current)
        return contract


def evaluate(contract, run):
    outcome = run.get('execution_outcome', 'measurement_failed')
    if outcome not in OUTCOMES:
        raise ValueError('Unknown execution outcome')
    complete = run.get('evidence_completeness') == 'complete'
    details = dict(run.get('details', {}))
    correctness = 'not_evaluated'
    reference = contract['reference']['stdout_sha256']
    if outcome == 'ok' and complete and reference and run.get('stdout_sha256'):
        correctness = 'pass' if reference == run['stdout_sha256'] else 'fail'
        if correctness == 'fail':
            outcome = 'candidate_failed'
    elif outcome == 'ok':
        details['unscored_reason'] = 'reference_unfrozen' if not reference else 'incomplete_evidence'
    return dict(execution_outcome=outcome, correctness=correctness,
                evidence_completeness='complete' if complete else 'partial', details=details)

