void llama_context::expert_fill_phase(uint32_t n_tokens) {
    if (expert_diag_enabled) {
        expert_diag_finish_token();
        if (n_tokens == 1) {
            ++expert_diag_token_idx; expert_diag_token_active = true;
            struct rusage r {}; getrusage(RUSAGE_SELF, &r);
            expert_diag_gap_maj = r.ru_majflt; expert_diag_gap_min = r.ru_minflt;
            expert_diag_gap_ns = expert_diag_now(); expert_diag_gap = true;
        }
    }
    expert_fill_decode = n_tokens == 1;
    expert_fill_this_ubatch = n_tokens >= expert_fill_min_tokens &&
        (!expert_fill_max_tokens || n_tokens <= expert_fill_max_tokens);
    if (!expert_fill_enabled || expert_fill_failed || !expert_fill_random_decode ||
            expert_fill_random_applied || !expert_fill_decode) { return; }
    // Transition before the first single-token graph, including when fill is filtered out.
    expert_fill_random_applied = true;
    const long page = sysconf(_SC_PAGESIZE);
    bool ok = page > 0;
    for (const auto & layer : model.layers) {
        for (const ggml_tensor * w : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
            if (!w) { continue; }
            llama_model::expert_file_range info;
            if (!ok || !model.expert_file_info(w, info)) { ok = false; continue; }
            const size_t first = info.offset - info.offset % size_t(page);
            const size_t end = info.offset + ggml_nbytes(w);
            const size_t pad = (size_t(page) - end % size_t(page)) % size_t(page);
            const size_t last = end + std::min(pad, info.mapping_size - end);
            if (madvise(static_cast<char *>(info.mapping) + first, last - first, MADV_RANDOM)) { ok = false; }
        }
    }
    if (ok) {
        LLAMA_LOG_INFO("expert_fill: random advice applied at decode\n");
    } else {
        expert_fill_failed = true;
        LLAMA_LOG_INFO("expert_fill: inactive (decode random advice failed)\n");
    }
}

void llama_context::expert_fill_selected(size_t il, const std::vector<int32_t> & selected) {
    if (expert_fill_failed || !expert_fill_this_ubatch) { return; }
    try {
        std::map<size_t, std::vector<ExpertFiller::Range>> ranges;
        const auto & layer = model.layers[il];
        for (const ggml_tensor * w : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
            if (!w) { continue; }
            llama_model::expert_file_range info;
            if (!model.expert_file_info(w, info)) { throw std::runtime_error("expert mmap/file offsets unavailable"); }
            for (const auto id : selected) {
                if (id < 0 || id >= w->ne[2] || size_t(id) > (SIZE_MAX - info.offset) / w->nb[2]) {
                    throw std::runtime_error("expert slice out of bounds");
                }
                ranges[info.file_index].push_back({info.offset + size_t(id) * w->nb[2], w->nb[2]});
            }
        }
        const bool diag = expert_diag_enabled && expert_diag_token_active;
        struct rusage before {}, after {}, thread_before {}, thread_after {};
        uint64_t start = 0;
        if (diag) {
            // Previous layer was consumed; this is a separate, after-use eviction probe.
            for (const auto & entry : expert_diag_previous) {
                expert_diag_token.next_nonresident += expert_fillers.at(entry.first)->nonresident(entry.second);
                ++expert_diag_token.next_checks;
            }
            expert_diag_close_gap();
            getrusage(RUSAGE_SELF, &before); getrusage(RUSAGE_THREAD, &thread_before);
            start = expert_diag_now();
        }
        for (const auto & entry : ranges) {
            auto & filler = *expert_fillers.at(entry.first);
            ExpertFiller::Counters a {};
            if (diag) { a = filler.counters(); }
            const uint64_t sync_bytes = filler.fill(entry.second, expert_fill_decode);
            if (expert_pregate_enabled && expert_fill_decode && il < expert_pregate_layers.size()) {
                const bool predicted = !expert_pregate_layers[il].predicted.empty();
                (predicted ? pregate_sync_with : pregate_sync_without) += sync_bytes;
                ++(predicted ? pregate_calls_with : pregate_calls_without);
            }
            if (diag) {
                const auto b = filler.counters();
                expert_diag_token.bytes_read += b.bytes_read - a.bytes_read;
                expert_diag_token.thread_majflt += b.thread_majflt - a.thread_majflt;
                expert_diag_token.thread_minflt += b.thread_minflt - a.thread_minflt;
                expert_diag_token.populate_calls += b.populate_calls - a.populate_calls;
                expert_diag_token.populate_ns += b.populate_ns - a.populate_ns;
                expert_diag_token.populate_errors += b.populate_errors - a.populate_errors;
                expert_diag_token.post_nonresident += filler.nonresident(entry.second);
                ++expert_diag_token.post_checks;
            }
        }
        if (diag) {
            getrusage(RUSAGE_SELF, &after); getrusage(RUSAGE_THREAD, &thread_after);
            expert_diag_token.fill_ns += expert_diag_now() - start;
            expert_diag_token.majflt_fill += after.ru_majflt - before.ru_majflt;
            expert_diag_token.minflt_fill += after.ru_minflt - before.ru_minflt;
            expert_diag_token.thread_majflt += thread_after.ru_majflt - thread_before.ru_majflt;
            expert_diag_token.thread_minflt += thread_after.ru_minflt - thread_before.ru_minflt;
            expert_diag_layers[il] = ranges; expert_diag_previous = ranges;
            getrusage(RUSAGE_SELF, &after);
            expert_diag_gap_maj = after.ru_majflt; expert_diag_gap_min = after.ru_minflt;
            expert_diag_gap_ns = expert_diag_now(); expert_diag_gap = true;
        }
    } catch (const std::exception & e) {
        expert_fill_failed = true;
        LLAMA_LOG_INFO("expert_fill: inactive (%s)\n", e.what());
    }
}
