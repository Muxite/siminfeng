{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat ../.claude/skills/frozen-experiment/scripts/agg.py ../.claude/skills/frozen-experiment/scripts/make_order.py ../.claude/skills/engine-candidate/scripts/text_fp.py; cat artifacts/x2/agg.py; head -6 artifacts/x2/att2-hostload.log artifacts/x2/kv1-hostload.log; tail -10 artifacts/x4-c1/tbo-mulmat.out; head -12 'lab/jobs/job-34c09bec98/att-1/c1_q8_gen_r0#4.stdout'; ls lab/jobs/job-3d2fbbd061/att-1/result.json lab/jobs/job-d2e342e743/att-1/result.json lab/jobs/job-85805b616c/att-1/result.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat ../.claude/skills/frozen-experiment/scripts/agg.py ../.claude/skills/frozen-experiment/scripts/make_order.py ../.claude/skills/engine-candidate/scripts/text_fp.py; cat artifacts/x2/agg.py; head -6 artifacts/x2/att2-hostload.log artifacts/x2/kv1-hostload.log; tail -10 artifacts/x4-c1/tbo-mulmat.out; head -12 'lab/jobs/job-34c09bec98/att-1/c1_q8_gen_r0#4.stdout'; ls lab/jobs/job-3d2fbbd061/att-1/result.json lab/jobs/job-d2e342e743/att-1/result.json lab/jobs/job-85805b616c/att-1/result.json\"","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Aggregate lab job results into per-test medians (generalised from artifacts/x2/agg.py).\n\nRun from the campaign dir (or set LAB=/path/to/lab):\n  agg.py job-ad883810b3 [job-...]            # table per job\n  agg.py JOB --compare base=treat ...        # % delta of decode/prefill medians between two test names\n  agg.py JOB --strip _r0,_r1                 # merge variants by stripping suffixes from test names\n  agg.py JOB --json                          # machine-readable\nRows: test name (the part before '#<index>'), n samples, gpu delta MiB (max), host cgroup peak MiB (max),\nmedian of decode_tps/prefill_tps/ppl/kld/top1_pct, [min-max] spread of decode, and BAD count when ok=false.\nA job is only scorable if tests_completed_cleanly == tests_expected; the header says so.\n\"\"\"\nimport argparse, collections, json, os, statistics as st, sys\n\nMETRICS = ((\"decode_tps\", \"dec\"), (\"prefill_tps\", \"pre\"), (\"ppl\", \"ppl\"), (\"kld\", \"kld\"), (\"top1_pct\", \"top1\"), (\"tg_ts\", \"tg\"), (\"pp_ts\", \"pp\"))\n# llama-bench tests (parser bench_json) carry v[\"samples\"]=[{n_prompt,n_gen,avg_ts}]; map them to tg (n_gen>0) / pp metrics.\ndef bench(v):\n    out = {}\n    for s in v.get(\"samples\") or []:\n        if \"avg_ts\" in s: out[\"tg_ts\" if s.get(\"n_gen\", 0) > 0 else \"pp_ts\"] = s[\"avg_ts\"]\n    return out\n\ndef load(job, lab):\n    p = job if os.path.isfile(job) else os.path.join(lab, \"jobs\", job, \"att-1\", \"result.json\")\n    if os.path.isdir(job): p = os.path.join(job, \"result.json\")\n    return json.load(open(p))\n\ndef group(res, strip=()):\n    g = collections.defaultdict(lambda: collections.defaultdict(list))\n    for k, v in res[\"quality\"][\"tests\"].items():\n        n = k.split(\"#\")[0]\n        for s in strip: n = n.replace(s, \"\")\n        m = g[n]; mem = v.get(\"mem\") or {}\n        m[\"n\"].append(1)\n        if \"gpu_delta_mib\" in mem: m[\"mib\"].append(mem[\"gpu_delta_mib\"])\n        if \"host_cgroup_peak_mib\" in mem: m[\"host\"].append(mem[\"host_cgroup_peak_mib\"])\n        vv = dict(v, **bench(v))\n        for x, y in METRICS:\n            if vv.get(x) is not None: m[y].append(vv[x])\n        if not v.get(\"ok\", False): m[\"bad\"].append(k)\n    return g\n\ndef summarize(g):\n    out = {}\n    for n, m in g.items():\n        d = dict(n=len(m[\"n\"]), gpu_mib=max(m[\"mib\"]) if m[\"mib\"] else None, host_mib=max(m[\"host\"]) if m[\"host\"] else None, bad=len(m[\"bad\"]))\n        for _, y in METRICS:\n            if m[y]: d[y] = st.median(m[y]); d[y + \"_min\"] = min(m[y]); d[y + \"_max\"] = max(m[y])\n        out[n] = d\n    return out\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"jobs\", nargs=\"+\"); ap.add_argument(\"--compare\", action=\"append\", default=[], help=\"BASE=TREAT test names\")\n    ap.add_argument(\"--strip\", default=\"\"); ap.add_argument(\"--json\", action=\"store_true\")\n    ap.add_argument(\"--lab\", default=os.environ.get(\"LAB\", \"lab\"))\n    a = ap.parse_args(); strip = [s for s in a.strip.split(\",\") if s]\n    allj = {}\n    for j in a.jobs:\n        r = load(j, a.lab); cov = r[\"evidence\"][\"coverage\"]; s = summarize(group(r, strip)); allj[j] = s\n        if a.json: continue\n        flag = \"\" if cov[\"tests_completed_cleanly\"] == cov[\"tests_expected\"] else \"  ** INCOMPLETE: do not score **\"\n        print(f\"== {j} {r['execution']} {cov['tests_completed_cleanly']}/{cov['tests_expected']}{flag}\")\n        for n, d in s.items():\n            cols = []\n            for _, y in METRICS:\n                if y in d:\n                    f = f\"{d[y]:.3f}\" if y in (\"kld\", \"ppl\") else f\"{d[y]:.1f}\"\n                    cols.append(f\"{y} {f}\" + (f\" [{d[y+'_min']:.1f}-{d[y+'_max']:.1f}]\" if y in (\"dec\", \"tg\") and d[\"n\"] > 1 else \"\"))\n            gm = \"-\" if d[\"gpu_mib\"] is None else d[\"gpu_mib\"]; hm = \"-\" if d[\"host_mib\"] is None else f\"{d['host_mib']:.0f}\"\n            print(f\"{n:34s} n{d['n']:<3d} gpu {gm!s:>5} host {hm:>7}\", *cols, f\"BAD {d['bad']}\" if d[\"bad\"] else \"\")\n        for c in a.compare:\n            b, t = c.split(\"=\")\n            for _, y in (METRICS[0], METRICS[1], METRICS[5], METRICS[6]):\n                if b in s and t in s and y in s[b] and y in s[t]:\n                    print(f\"  {t} vs {b} {y}: {s[t][y]:.1f} vs {s[b][y]:.1f} = {100*(s[t][y]/s[b][y]-1):+.2f}%\")\n    if a.json: print(json.dumps(allj, indent=1, sort_keys=True))\n\nif __name__ == \"__main__\":\n    main()\n#!/usr/bin/env python3\n\"\"\"Alternating-order generator for lab test lists (comma-separated, as `bin/lab submit --tests` wants).\n\nSemantics (reproduces artifacts/x2/{pap1,c1,match1,kv1,hsplit1,plan1}-order.txt):\n  per group: `rounds` rounds, round i runs the group forward if i is even, reversed if odd\n  (2 rounds on a pair = ABBA); the concatenation of all groups is repeated `--repeat` times;\n  `--once` tests (deterministic quality tests: ppl/kld) are appended a single time at the end.\nUsage:\n  make_order.py --group a,b,c --rounds 3                      # one group, F R F\n  make_order.py --group a,b --group c,d --rounds 2 --repeat 2 # c1 style\n  make_order.py --group a,b --rounds 3 --once kl_a,kl_b --out order.txt\nPrints the list to stdout (and to --out if given); prints a count summary to stderr.\n\"\"\"\nimport argparse, collections, sys\n\ndef make(groups, rounds=3, repeat=1, once=()):\n    seq = []\n    for _ in range(repeat):\n        for g in groups:\n            for i in range(rounds):\n                seq += g if i % 2 == 0 else g[::-1]\n    return seq + list(once)\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"--group\", action=\"append\", required=True, help=\"comma-separated test names; repeatable\")\n    ap.add_argument(\"--rounds\", type=int, default=3)\n    ap.add_argument(\"--repeat\", type=int, default=1)\n    ap.add_argument(\"--once\", default=\"\", help=\"comma-separated tests appended once (quality tests)\")\n    ap.add_argument(\"--out\")\n    a = ap.parse_args()\n    groups = [[t for t in g.split(\",\") if t] for g in a.group]\n    seq = make(groups, a.rounds, a.repeat, [t for t in a.once.split(\",\") if t])\n    s = \",\".join(seq)\n    if a.out: open(a.out, \"w\").write(s)\n    print(s)\n    c = collections.Counter(seq)\n    print(f\"# {len(seq)} runs, {len(c)} distinct tests, per-test count min/max {min(c.values())}/{max(c.values())}\", file=sys.stderr)\n\nif __name__ == \"__main__\":\n    main()\n#!/usr/bin/env python3\n\"\"\"Greedy-text fingerprint (D024): sha256 of each llama-completion stdout in a lab job, grouped by test name.\nRun from the campaign dir:  text_fp.py JOB [--filter gen]   (LAB env overrides lab dir)\nSame fingerprint across variants = identical greedy text (required for computation-preserving candidates).\nKnown references (Granite, chat.txt, -n 160, temp 0, seed 1): Q8_0 all-GPU 65894776; mixE4K all-GPU 950b46b1;\nmixE4K experts on CPU (--n-cpu-moe 24) 76dc9422; static-hot 'never engaged' also shows 76dc9422 (D024).\"\"\"\nimport collections, glob, hashlib, os, re, sys\na = [x for x in sys.argv[1:] if not x.startswith(\"--\")]; flt = sys.argv[sys.argv.index(\"--filter\") + 1] if \"--filter\" in sys.argv else \"\"\nif not a: sys.exit(__doc__)\na = [x for x in a if x != flt]\nlab = os.environ.get(\"LAB\", \"lab\"); g = collections.defaultdict(list)\nfor f in sorted(glob.glob(f\"{lab}/jobs/{a[0]}/att-*/*.stdout\")):\n    t = os.path.basename(f)[:-7].split(\"#\")[0]\n    if flt in t: g[t].append(hashlib.sha256(open(f, \"rb\").read()).hexdigest()[:8])\nfor t, h in g.items(): print(f\"{t:30s}\", \"IDENTICAL\" if len(set(h)) == 1 else \"DIFFER   \", \" \".join(h))\nimport json,sys,statistics as st,collections,hashlib,os\nfor j in sys.argv[1:]:\n  d=f'lab/jobs/{j}/att-1'; r=json.load(open(d+'/result.json')); print('==',j,r['execution'],r['evidence']['coverage']['tests_completed_cleanly'],'/',r['evidence']['coverage']['tests_expected'])\n  g=collections.defaultdict(lambda: collections.defaultdict(list))\n  for k,v in r['quality']['tests'].items():\n    n=k.split('#')[0]; m=g[n]; m['mib'].append(v['mem']['gpu_delta_mib']); m['host'].append(v['mem']['host_cgroup_peak_mib'])\n    for x,y in (('decode_tps','dec'),('prefill_tps','pre'),('ppl','ppl'),('kld','kld'),('top1_pct','top1')):\n      if v.get(x) is not None: m[y].append(v[x])\n    if not v['ok']: m['bad'].append(k)\n  for n,m in g.items():\n    print(f\"{n:34s} gpu {max(m['mib']):5d} host {max(m['host']):7.0f}\", *(f\"{x} {st.median(m[x]):.3f}\" if x in('kld',) else f\"{x} {st.median(m[x]):.1f}\" for x in ('dec','pre','ppl','kld','top1') if m[x]), ('BAD '+str(len(m['bad']))) if m['bad'] else '')\n==> artifacts/x2/att2-hostload.log <==\n2026-11-09T22:15:54Z 2.98 2.48 2.03 cc=2\n2026-11-09T22:15:59Z 2.98 2.49 2.03 cc=2\n2026-11-09T22:16:04Z 3.06 2.51 2.04 cc=2\n2026-11-09T22:16:09Z 2.90 2.49 2.04 cc=2\n2026-11-09T22:16:14Z 2.99 2.51 2.05 cc=2\n2026-11-09T22:16:19Z 3.63 2.65 2.10 cc=2\n\n==> artifacts/x2/kv1-hostload.log <==\n2026-11-09T23:03:28Z 2.50 5.47 6.46 cc=0\n2026-11-09T23:03:33Z 2.38 5.40 6.43 cc=0\n2026-11-09T23:03:38Z 2.27 5.32 6.40 cc=0\n2026-