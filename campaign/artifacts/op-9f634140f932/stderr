static int tensor_layer(const char * name, const char * prefix) {
    const size_t len = std::strlen(prefix);
    if (std::strncmp(name, prefix, len) != 0 || name[len] == '\0') {
        return -1;
    }
    int layer = 0;
    for (const char * p = name + len; *p; ++p) {
        if (*p < '0' || *p > '9' || layer > (INT_MAX - (*p - '0')) / 10) {
            return -1;
        }
        layer = layer * 10 + (*p - '0');
    }
    return layer;
}

