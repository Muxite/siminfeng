+        if (!x || !base || !base->buffer || !ggml_backend_buffer_is_host(base->buffer) ||
+                !x->data || x->type != GGML_TYPE_F32 || x->ne[0] != w->ne[0] ||
+                x->ne[1] != 1 || x->ne[2] != 1 || x->ne[3] != 1 || !ggml_is_contiguous(x) ||
+                (t->src[0] != model.layers[il].ffn_up_exps && t->src[0] != model.layers[il].ffn_gate_exps &&
