index 0000000000000000000000000000000000000000..6fcc1a266f6954bc26a509f80241ced4fe978108
--- /dev/null
+++ b//home/muk/projects/xs-dev/placement/run_build.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# OPERATOR ONLY. Queue class: build. Expected: 15-40 min first CUDA build, <2 min incremental.
+# Outputs: build-operator/bin/expert-crossover, build-operator/probe_uma, build-operator.log, build-manifest.json.
+set -euo pipefail
+source "$(dirname "$0")/operator_common.sh"
+require_job
+check_source
+command -v cmake >/dev/null
+NVCC=${F19_NVCC:-/usr/local/cuda/bin/nvcc}
+[[ -x "$NVCC" ]] || { echo "NVCC_MISSING: $NVCC" >&2; exit 2; }
+BUILD=$F19_ROOT/build-operator
+mkdir -p "$BUILD"
+exec > >(tee "$F19_ROOT/build-operator.log") 2>&1
+"$NVCC" --version
+cmake -S "$F19_ROOT" -B "$BUILD" -DCMAKE_BUILD_TYPE=Release \
+    -DLLAMA_SOURCE="$F19_LLAMA" -DGGML_CUDA=ON -DCMAKE_CUDA_COMPILER="$NVCC" \
+    -DCMAKE_CUDA_ARCHITECTURES=87 -DGGML_NATIVE=OFF \
+    -DGGML_CPU_ARM_ARCH=armv8.2-a+dotprod+fp16 -DBUILD_SHARED_LIBS=OFF
+cmake --build "$BUILD" --target expert-crossover -j2
+"$NVCC" -O3 -std=c++17 -arch=sm_87 --cudart=static "$F19_ROOT/probe_uma.cu" -o "$BUILD/probe_uma"
+python3 - "$F19_ROOT" "$F19_PIN" <<'PY'
+import hashlib, json, pathlib, sys
+p = pathlib.Path(sys.argv[1])
+files = ['build-operator/bin/expert-crossover', 'build-operator/probe_uma', 'crossover.cpp', 'probe_uma.cu']
+record = {'pin': sys.argv[2], 'execution': 'not run', 'sha256': {f: hashlib.sha256((p/f).read_bytes()).hexdigest() for f in files}}
+(p/'build-manifest.json').write_text(json.dumps(record, indent=2)+'\n')
+PY
+echo BUILD_OK
diff --git a//home/muk/projects/xs-dev/placement/run_crossover.sh b//home/muk/projects/xs-dev/placement/run_crossover.sh
new file mode 100644
index 0000000000000000000000000000000000000000..90c3b031332ad545dd6dbb37d1c167b9de1b3e0e
--- /dev/null
+++ b//home/muk/projects/xs-dev/placement/run_crossover.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+# OPERATOR ONLY. Queue class: gpu. Expected: 2-8 min; timeout: 900 s.
+# Outputs: 04-crossover/curve.csv (18 rows), stderr.txt, container-command.txt, build-manifest.json.
+set -euo pipefail
+source "$(dirname "$0")/operator_common.sh"
+require_job
+require_image
+[[ -x $F19_ROOT/build-operator/bin/expert-crossover ]] || { echo 'Run run_build.sh first.' >&2; exit 2; }
+new_output 04-crossover
+cp "$F19_ROOT/build-manifest.json" "$OUT/"
+engine_container -c 'set -euo pipefail; export LD_LIBRARY_PATH=/app:/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}; /placement/build-operator/bin/expert-crossover --threads 6 > /out/curve.csv 2> /out/stderr.txt'
+python3 - "$OUT/curve.csv" <<'PY'
+import csv, math, sys
+rows = list(csv.DictReader(open(sys.argv[1])))
+assert len(rows) == 18, len(rows)
+for shape in ('up_gate', 'down'):
+    assert sorted(int(r['n_tokens']) for r in rows if r['shape'] == shape) == [1,2,4,8,16,32,64,128,512]
+for r in rows:
+    assert all(math.isfinite(float(r[k])) and float(r[k]) > 0 for k in ('cpu_ms','cpu_boundary_ms','gpu_resident_ms','gpu_staged_ms'))
+    assert 0 <= float(r['nmse']) < 5e-4
+print('CROSSOVER_OK rows=18 numerical_check=PASS')
+PY
+cp /proc/meminfo "$OUT/meminfo.after.txt"
diff --git a//home/muk/projects/xs-dev/placement/run_model.sh b//home/muk/projects/xs-dev/placement/run_model.sh
new file mode 100644
index 0000000000000000000000000000000000000000..4b376a2029e4a5828f795574b0d2845036c92d7a
--- /dev/null
+++ b//home/muk/projects/xs-dev/placement/run_model.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# OPERATOR ONLY. Queue class: gpu. Expected: 2-6 min per invocation; timeout: 900 s.
+# Usage: run_model.sh baseline|no-offload|adaptive|baseline-replay
+# Outputs: NN-MODE/{summary.json,stdout.txt,stderr.txt,result.json,telemetry.jsonl,watchdog.jsonl,page_cache.*.json,cmd.txt}.
+set -euo pipefail
+source "$(dirname "$0")/operator_common.sh"
+require_job
+require_image
+MODE=${1:?baseline|no-offload|adaptive|baseline-replay}
+FLAGS=(--op-offload)
+THRESHOLD=32
+case "$MODE" in
+    baseline) LABEL=01-baseline ;;
+    no-offload) LABEL=02-no-offload; FLAGS=(--no-op-offload) ;;
+    adaptive) LABEL=05-adaptive ;;
+    baseline-replay) LABEL=06-baseline-replay ;;
+    *) echo "Unknown mode: $MODE" >&2; exit 2 ;;
+esac
+[[ ${OM_NSYS:-0} == 0 ]] || { echo 'Use untraced timings for this campaign.' >&2; exit 2; }
+new_output "$LABEL"
+if [[ $MODE == adaptive ]]; then
+    AUTO_ARGS=()
+    [[ ${F19_ENABLE_AUTO:-0} == 1 ]] && AUTO_ARGS=(--enable)
+    python3 "$F19_ROOT/select_policy.py" --baseline "$F19_RESULTS/01-baseline/summary.json" \
+        --cpu "$F19_RESULTS/02-no-offload/summary.json" --curve "$F19_RESULTS/04-crossover/curve.csv" \
+        "${AUTO_ARGS[@]}" > "$OUT/policy.json"
+    THRESHOLD=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["threshold"])' "$OUT/policy.json")
+    FLAGS=("$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["flag"])' "$OUT/policy.json")")
+fi
+# The existing strict LLAMA_EXPERT_* validator accepts exactly these settings at the pin.
+ENV_FLAGS="-e GGML_OP_OFFLOAD_MIN_BATCH=$THRESHOLD -e GGML_CUDA_REGISTER_HOST=0 -e LLAMA_EXPERT_FILL=1 -e LLAMA_EXPERT_FILL_RANDOM=decode -e LLAMA_EXPERT_FILL_THREADS=16 -e LLAMA_EXPERT_FILL_CHUNK_KIB=2048 -e LLAMA_EXPERT_FILL_MIN_TOKENS=0 -e LLAMA_EXPERT_FILL_MAX_TOKENS=1 -e LLAMA_EXPERT_FILL_DIAG=0 -e LLAMA_EXPERT_FILL_POPULATE=0 -e LLAMA_EXPERT_PREFETCH=0 -e LLAMA_EXPERT_PREFETCH_NEXT=0 -e LLAMA_EXPERT_PREGATE=1 -e LLAMA_EXPERT_PREGATE_K=8 -e LLAMA_EXPERT_PREGATE_ORDER=after -e LLAMA_EXPERT_PREGATE_MAX_INFLIGHT=4 -e LLAMA_EXPERT_PREGATE_LOOKAHEAD=1 -e LLAMA_MMAP_ADVICE=default"
+export OM_MODELDIR=$F19_MODEL_DIR
+export OM_CACHE_PROTOCOL=cold
+export OM_CACHE_MODEL=$F19_MODEL_DIR/$F19_MODEL
+export OM_MAX_S=900 OM_MIN_AVAIL_MIB=700 OM_MAX_SWAP_MIB=1536
+export DOCKER_CMD_PREFIX='sg docker -c'
+# om_run writes only into OUT; the model is mounted read-only. Cold uses per-file fadvise, never global drop_caches.
+bash "$F19_LAB/cc/om_run/om_run.sh" "$OUT" "$F19_IMAGE" "$ENV_FLAGS" llama-completion \
+    -m "/om/$F19_MODEL" -f /om/prompts/p1.txt -n 64 -c 4096 --temp 0 -s 1 -no-cnv \
+    -ngl 99 -cmoe -lm mmap -b 512 -ub 512 -t 6 -tb 6 -lv 4 "${FLAGS[@]}"
+python3 "$F19_ROOT/summarize_model.py" "$OUT"
+cp /proc/meminfo "$OUT/meminfo.after.txt"
+echo "MODEL_OK $OUT/summary.json"
