#!/usr/bin/env python3
"""Local, flock-serialized job queue. All state changes happen under lock."""
import re, argparse
from contextlib import contextmanager
import fcntl
import json
import math
import os
from pathlib import Path
import signal
import subprocess
import sys
import time
import uuid

ROOT = Path(__file__).resolve().parent.parent
SELF = str(Path(__file__).resolve())
DIR = Path(os.environ.get('JOBQ_DIR', ROOT / 'lab/jobq')).resolve()
TERMINAL = {'succeeded', 'failed', 'cancelled', 'skipped_dep_failed', 'timeout'}


@contextmanager
def locked():
    DIR.mkdir(parents=True, exist_ok=True)
    with (DIR / 'lock').open('a') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def jobs():
    return sorted((json.loads(p.read_text()) for p in DIR.glob('job-*.json')),
                  key=lambda j: (j['submitted'], j['id']))


def get(jid):
    if not jid.startswith('job-') or any(c not in 'job-0123456789abcdef' for c in jid):
        raise ValueError('invalid job id')
    try:
        return json.loads((DIR / (jid + '.json')).read_text())
    except FileNotFoundError:
        raise ValueError('unknown job: ' + jid)


def save(j, event):
    path = DIR / (j['id'] + '.json')
    tmp = path.with_suffix('.tmp')
    tmp.write_text(json.dumps(j, indent=2) + '\n')
    os.replace(tmp, path)
    with (DIR / 'events.jsonl').open('a') as f:
        f.write(json.dumps(dict(time=time.time(), job=j['id'], event=event,
                               state=j['state'])) + '\n')
        f.flush()
        os.fsync(f.fileno())


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        # A dead supervisor may remain a zombie until its parent reaps it.
        stat = Path('/proc/%s/stat' % pid)
        if stat.exists() and stat.read_text().rsplit(')', 1)[1].split()[0] == 'Z':
            return False
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def kill_groups(j, sig):
    # Let run_op reap the command and record its outcome during the TERM grace.
    groups = {j.get('pgid')}
    if sig == signal.SIGKILL:
        groups.add(j.get('wrapper_pgid'))
    for pgid in groups - {None}:
        try:
            os.killpg(pgid, sig)
        except ProcessLookupError:
            pass


def finish(j, state, rc):
    j.update(state=state, rc=rc, end=time.time())
    save(j, state)


def reconcile():
    for j in jobs():
        if j['state'] == 'running' and not alive(j.get('runner_pid')):
            kill_groups(j, signal.SIGKILL)
            finish(j, j.get('stop_reason') or 'failed', None)


def compatible(j, running):
    for other in running:
        if j['class'] in ('gpu', 'build') and other['class'] in ('gpu', 'build'):
            return False
        if j['class'] == 'gpu' and other['class'] == 'cpu' and not other['allow_during_gpu']:
            return False
        if j['class'] == 'cpu' and other['class'] == 'gpu' and not j['allow_during_gpu']:
            return False
    return True


def worker(once):
    children = []
    try:
        while True:
            children[:] = [p for p in children if p.poll() is None]
            with locked():
                reconcile()
                alljobs = jobs()
                byid = {j['id']: j for j in alljobs}
                running = [j for j in alljobs if j['state'] == 'running']
                for j in alljobs:
                    if j['state'] != 'queued':
                        continue
                    deps = [byid[d] for d in j['deps']]
                    if any(d['state'] in TERMINAL - {'succeeded'} for d in deps):
                        finish(j, 'skipped_dep_failed', None)
                        continue
                    if any(d['state'] != 'succeeded' for d in deps) or not compatible(j, running):
                        continue
                    j.update(state='running', start=time.time())
                    for other in running:
                        other['concurrent_jobs'].append(j['id'])
                        j['concurrent_jobs'].append(other['id'])
                        save(other, 'overlap')
                    with (DIR / (j['id'] + '.log')).open('ab') as log:
                        p = subprocess.Popen([sys.executable, SELF, '_run', j['id']],
                                             stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                             start_new_session=True)
                    children.append(p)
                    j['runner_pid'] = p.pid
                    save(j, 'started')
                    running.append(j)
                pending = any(j['state'] in ('queued', 'running') for j in alljobs)
            if once and not pending:
                return 0
            time.sleep(.05)
    finally:
        for p in children:
            p.poll()


def run_job(jid):
    p = None
    try:
        with locked():
            j = get(jid)
            if j.get('stop_reason'):
                finish(j, j['stop_reason'], None)
                return 0
            runop = os.environ.get('JOBQ_RUN_OP', str(ROOT / 'bin/run_op'))
            job_env = (json.loads(Path(j['env_file']).read_text()) if j.get('env_file')
                       else j.get('env', dict(os.environ)))
            job_env['JOBQ_JOB_ID'] = jid
            p = subprocess.Popen([runop, '--agent', 'jobq', '--task', j['name'], '--',
                                  sys.executable, SELF, '_exec', jid],
                                 cwd=j['cwd'], env=job_env, start_new_session=True)
            j['wrapper_pgid'] = p.pid
            save(j, 'wrapper_started')
        stopped_at = None
        while True:
            with locked():
                j = get(jid)
                if not j.get('stop_reason') and j['timeout'] is not None and time.time() - j['start'] >= j['timeout']:
                    j['stop_reason'] = 'timeout'
                    save(j, 'timeout_requested')
                if j.get('stop_reason'):
                    if stopped_at is None:
                        # One TERM lets cleanup handlers finish without interruption.
                        kill_groups(j, signal.SIGTERM)
                        stopped_at = time.monotonic()
                    if p.poll() is not None:
                        kill_groups(j, signal.SIGKILL)  # any remaining descendants
                        finish(j, j['stop_reason'], p.returncode)
                        return 0
                    if time.monotonic() - stopped_at >= j.get('grace', 20):
                        kill_groups(j, signal.SIGKILL)
                        rc = p.wait()
                        finish(j, j['stop_reason'], rc)
                        return 0
                elif p.poll() is not None:
                    # Do not leave command descendants behind after wrapper exit.
                    kill_groups(j, signal.SIGKILL)
                    finish(j, 'succeeded' if p.returncode == 0 else 'failed', p.returncode)
                    return 0
            time.sleep(.025)
    except Exception as exc:
        with locked():
            j = get(jid)
            kill_groups(j, signal.SIGKILL)
            j['error'] = str(exc)
            finish(j, 'failed', None)
        if p:
            p.wait()
        return 1


def exec_job(jid):
    with locked():
        j = get(jid)
        if j.get('stop_reason') or j['state'] != 'running':
            return 1
        j.update(pid=os.getpid(), pgid=os.getpgrp())
        save(j, 'command_started')
    os.execvpe(j['argv'][0], j['argv'], os.environ)


def seconds(value):
    n = float(value)
    if not math.isfinite(n) or n < 0:
        raise argparse.ArgumentTypeError('seconds must be finite and nonnegative')
    return n


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    sp = ap.add_subparsers(dest='command', required=True)
    s = sp.add_parser('submit')
    s.add_argument('--class', dest='cls', choices=['gpu', 'build', 'cpu'], required=True)
    s.add_argument('--after', nargs='+', action='extend', default=[])
    s.add_argument('--name')
    s.add_argument('--timeout', type=seconds)
    s.add_argument('--grace', type=seconds, default=20, help='TERM to KILL grace in seconds')
    s.add_argument('--allow-during-gpu', action='store_true')
    s.add_argument('argv', nargs=argparse.REMAINDER)
    w = sp.add_parser('worker'); w.add_argument('--once', action='store_true')
    sp.add_parser('list')
    r = sp.add_parser('reap-containers')
    r.add_argument('--yes', action='store_true', help='Remove stale containers; default prints commands')
    r.add_argument('--dry-run', action='store_true', help='Print commands only (the default)')
    for cmd in ('show', 'wait', 'cancel', '_run', '_exec'):
        p = sp.add_parser(cmd); p.add_argument('jobid')
        if cmd == 'wait':
            p.add_argument('--timeout', type=seconds)
    a = ap.parse_args()
    if a.command == 'reap-containers':
        sys.path.insert(0, str(ROOT))
        from cc.acc.server import reap_containers
        reap_containers(dry_run=not a.yes or a.dry_run, labels=('om=1', 'acc=1'), unowned_max_age=None)
        return 0
    if a.command == '_run':
        return run_job(a.jobid)
    if a.command == '_exec':
        return exec_job(a.jobid)
    if a.command == 'worker':
        return worker(a.once)
    if a.command == 'wait':
        deadline = None if a.timeout is None else time.monotonic() + a.timeout
        while True:
            with locked():
                reconcile(); j = get(a.jobid)
            if j['state'] in TERMINAL:
                return 0 if j['state'] == 'succeeded' else 1
            if deadline is not None and time.monotonic() >= deadline:
                return 2
#!/usr/bin/env bash
# om_run.sh — guarded over-memory engine run on jetson-arm.
# usage: om_run.sh OUTDIR IMAGE "ENV_FLAGS" TOOL ARGS...
#   e.g. om_run.sh experiments/jetson/OM/b1-r1 campaign/llamacpp:jetson-c1-p03 "" llama-bench -m /om/model.gguf -lm mmap -ngl 99 -cmoe -p 64 -n 32 -r 2
# Model dir ~/models/campaign/qwen36-35b-a3b is mounted read-only at /om. Watchdog kills ONLY this container
# when MemAvailable < OM_MIN_AVAIL_MIB (default 700) or zram swap used > OM_MAX_SWAP_MIB (default 1536).
set -u
OUT=$1; IMG=$2; ENVF=$3; TOOL=$4; shift 4
R=$(cd "$(dirname "$0")/../.." && pwd); mkdir -p "$OUT"
NAME="om-$(date +%s)-$$"
MODELDIR=${OM_MODELDIR:-$HOME/models/campaign/qwen36-35b-a3b}
DATADIR=$HOME/models/campaign/data/wikitext/wikitext-2-raw
DP=${DOCKER_CMD_PREFIX:-}
dk(){ if [ -n "$DP" ]; then $DP "docker $*"; else docker "$@"; fi; }
printf '%s\n' "$IMG" "$ENVF" "$TOOL $*" > "$OUT/cmd.txt"
# OM_NSYS=1: run the engine under Nsight Systems (mounted read-only from the host install).
# Traced runs perturb timing; use them for breakdowns only, never as speed evidence.
NSYS_MOUNT=""; NSYS_PREFIX=""
if [ "${OM_NSYS:-0}" = 1 ]; then
    NSYS_DIR=${OM_NSYS_DIR:-/opt/nvidia/nsight-systems/2024.5.4}
    [ -x "$NSYS_DIR/target-linux-tegra-armv8/nsys" ] || { echo "NSYS_MISSING $NSYS_DIR" > "$OUT/status"; exit 2; }
    NSYS_MOUNT="-v $NSYS_DIR:/nsys:ro -v $(cd "$OUT" && pwd):/prof"
    NSYS_PREFIX="/nsys/target-linux-tegra-armv8/nsys profile -t cuda,nvtx,osrt --cuda-graph-trace=node --sample=none --cpuctxsw=none -f true -o /prof/nsys"
fi
# Host-only page-cache protocol; unset means carryover (measure without warming).
# OM_CACHE_MODEL overrides host model path inference from -m/--model under /om/.
# warm uses OM_CACHE_WARM_RANGES (host JSON) or OM_CACHE_WARM_BYTES (prefix).
OM_CACHE_ARGV=("$@")
om_cache_record(){ python3 "$R/cc/page_cache/run_protocol.py" "$1" "$OUT" "$MODELDIR" "${OM_CACHE_ARGV[@]}"; }
trap 'om_cache_record end || echo "page-cache end recording failed" >&2' EXIT
om_cache_record start || { echo "CACHE_PROTOCOL_FAIL" > "$OUT/status"; exit 2; }
dk run -d --name "$NAME" --runtime nvidia --network none --label campaign=c1 --label om=1 $ENVF \
   -v "$MODELDIR":/om:ro -v "$DATADIR":/d:ro $NSYS_MOUNT "$IMG" $NSYS_PREFIX /app/$TOOL "$@" > "$OUT/container.id" || { echo "START_FAIL" > "$OUT/status"; exit 2; }
if [ "${OM_THREADS:-0}" = 1 ]; then
    python3 "$R/cc/thread_sampler/thread_sampler.py" --container "$NAME" --hz "${OM_THREADS_HZ:-100}" \
        --out "$OUT/threads.jsonl" --summary "$OUT/threads.summary.json" \
        >"$OUT/threads.log" 2>&1 & TS=$!
fi
if [ -n "$DP" ]; then KILLCMD="$DP 'docker kill $NAME'"; else KILLCMD="docker kill $NAME"; fi
python3 "$R/cc/resource_observe/resource_observe.py" watchdog --min-available-mib ${OM_MIN_AVAIL_MIB:-600} \
   --max-swap-used-mib ${OM_MAX_SWAP_MIB:-2560} --max-swap-rate-mibs ${OM_MAX_SWAP_RATE:-1000} --interval-ms 250 --kill-cmd "$KILLCMD" --out "$OUT/watchdog.jsonl" & WD=$!
python3 "$R/cc/resource_observe/resource_observe.py" sample --backends io,proc,tegrastats --path "$MODELDIR" --interval-ms 500 \
   --duration-s ${OM_MAX_S:-1800} --out "$OUT/telemetry.jsonl" >/dev/null 2>&1 & SM=$!
T0=$(date +%s.%N)
RC=$(dk wait "$NAME"); T1=$(date +%s.%N)
kill $WD $SM 2>/dev/null; wait $WD 2>/dev/null; WDRC=$?
dk logs "$NAME" > "$OUT/stdout.txt" 2> "$OUT/stderr.txt"
if [ "${OM_THREADS:-0}" = 1 ]; then
    wait "$TS" || echo "thread sampler failed; see threads.log" >&2
    if [ -s "$OUT/threads.jsonl" ]; then
        python3 "$R/cc/thread_sampler/thread_sampler.py" --summarize "$OUT/threads.jsonl" \
            --stderr "$OUT/stderr.txt" --summary "$OUT/threads.summary.json" \
            >>"$OUT/threads.log" 2>&1 || echo "thread summary failed; see threads.log" >&2
    fi
fi
if [ "${OM_NSYS:-0}" = 1 ]; then
    # nsys appends its own progress text to the engine's stdout; move it out so the output check sees only the engine.
