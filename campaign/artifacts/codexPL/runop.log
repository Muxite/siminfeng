{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"PYTHONDONTWRITEBYTECODE=1 python3 -B -m pytest -q -p no:cacheprovider cc/moe_planner/test_plan.py --basetemp=artifacts/codexPL/pytest-temp > artifacts/codexPL/pytest.txt 2>&1\ncat artifacts/codexPL/pytest.txt\npython3 -B - <<'PY'\nimport ast,json,pathlib,sys\nsys.path.insert(0,'cc/moe_planner');import plan\nfor p in pathlib.Path('cc/moe_planner').glob('*.py'): ast.parse(p.read_text())\nx=json.load(open('artifacts/codexPL/plan-900.json'))\nassert plan.emit_lab_tests(x)==json.load(open('artifacts/codexPL/lab-tests.json'))\nh=plan.read_json('cc/engine_handoff/hosts/x86-main.json');s=plan.read_json('artifacts/codexPL/granite-inspected.json')\ne=plan.plan(s,h,dict(gpu_mib=900,ctx=4096,max_quality_loss=.05));assert not e['plans']\npathlib.Path('artifacts/codexPL/plan-900-kld005.json').write_text(json.dumps(e,indent=2)+'\\\\n')\ne=plan.plan(s,h,dict(gpu_mib=900,ctx=4096),allow_extrapolation=True,top=5)\npathlib.Path('artifacts/codexPL/plan-900-exploratory.json').write_text(json.dumps(e,indent=2)+'\\\\n')\nprint('Example definitions match emitter; strict KLD example correctly has no supported plan.')\nprint('Deliverables:',*[str(p) for p in pathlib.Path('cc/moe_planner').iterdir()],sep='\\\\n')\nprint('Top:',x['plans'][0]['id'], 'GPU:',x['plans'][0]['gpu_mib'], 'host:',x['plans'][0]['host_mib'])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
