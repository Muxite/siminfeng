7-routing-skew-control.md\ndecisions/D029-c1-q8reuse-accepted.md\ndecisions/D009-representation-screen.md\ndecisions/D038-qwen-frontier-protocol.md\ndecisions/D039-qwen-frontier-results.md\ndecisions/D008-profile-decode-granite.md\ndecisions/D023-novmm-engine-under-budget.md\ndecisions/D015-ssd-tier-emulation.md\ndecisions/D006-reconcile-overwrote-result.md\ndecisions/D004-profiler-qualification.md\ndecisions/D007-gpu-lock-removed.md\ndecisions/D016-image-identity-confusion.md\ncc/routing_trace/__pycache__/test_trace_replay.cpython-312-pytest-9.0.2.pyc\ncc/routing_trace/__pycache__/trace_replay.cpython-312.pyc\n","exit_code":0,"status":"completed"}}
