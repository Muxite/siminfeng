 the cached ones stay zero: the device computes these misses as zero\n   451\t        // one extra slot at the end, CUDA MMQ can read past the last expert\n   452\t        n_zero = cpu_share > 0.0f ? std::min<int32_t>(n_expert_used, 64) : 0;\n   453\t        auto alloc_size = [&](const group & g, int32_t n_slots) {\n   454\t            const size_t alignment = ggml_backend_buft_get_alignment(devices[g.id].buft);\n   455\t            size_t res = 0;\n   456\t            for (const ggml_tensor * t : g.ref) {\n   457\t                res += GGML_PAD(t->nb[2]*(n_slots + n_zero + 1), alignment);\n   458\t            }\n   459\t            return res;\n   460\t        };\n   461\t\n   462\t        // the budget is split among the devices with host experts like the layers, by the tensor split or by default by free memory\n   463\t        const float * tensor_split = model.tensor_split();\n   464\t        const bool split_by_free = tensor_split == nullptr ||\n   465\t            std::all_of(tensor_split, tensor_split + model.n_devices(), [](float x) { return x == 0.0f; });\n   466\t        double split_sum = 0.0;\n   467\t        for (device & d : devices) {\n   468\t            if (d.host_bytes == 0) {\n   469\t                continue;\n   470\t            }\n   471\t            ggml_backend_dev_t dev = ggml_backend_get_device(d.backend);\n   472\t            if (split_by_free) {\n   473\t                size_t free;\n   474\t                size_t total;\n   475\t                ggml_backend_dev_memory(dev, &free, &total);\n   476\t                d.split = (double) free;\n   477\t            } else {\n   478\t                const auto it = std::find_if(model.devices.begin(), model.devices.end(), [&](const llama_device & ld) { return ld.dev == dev; });\n   479\t                GGML_ASSERT(it != model.devices.end());\n   480\t                d.split = (double) tensor_split[it - model.devices.begin()];\n   481\t            }\n   482\t            split_sum += d.split;\n   483\t        }\n   484\t        if (split_sum == 0.0) {\n   485\t            // the devices do not report their free memory\n   486\t            for (device & d : devices) {\n   487\t                d.split    = d.host_bytes > 0 ? 1.0 : 0.0;\n   488\t                split_sum += d.split;\n   489\t            }\n   490\t        }\n   491\t\n   492\t        // within a device the budget is split by the size of the experts, so each group caches the same fraction of its experts\n   493\t        cpu_share_q = (uint32_t) std::lround(cpu_share*65536.0f);\n   494\t        if (const char * path = getenv(\"LLAMA_MOE_CACHE_TRACE\"); path != nullptr && *path != '\\0') {\n   495\t            trace = fopen(path, \"wb\");\n   496\t            if (trace == nullptr) {\n   497\t                throw std::runtime_error(std::string(\"failed to open the MoE cache trace \") + path);\n   498\t            }\n   499\t            write_trace_header(split_sum);\n   500\t        }\n   501\t        std::vector<size_t> n_tensors(devices.size(), 0);\n   502\t        size_t n_tensors_host = 0;\n   503\t        for (group & g : groups) {\n   504\t            const device & d = devices[g.id];\n   505\t            const int32_t n_expert  = g.ref[0]->ne[2];\n   506\t            const size_t  budget    = (size_t) ((double) size*d.split/split_sum*g.host_bytes/d.host_bytes);\n   507\t            const int32_t max_slots = g.layers.size()*n_expert;\n   508\t            while (g.n_slots < max_slots && alloc_size(g, g.n_slots + 1) <= budget) {\n   509\t                g.n_slots++;\n   510\t            }\n   511\t            if (g.n_slots < n_expert_used) {\n   512\t                LLAMA_LOG_WARN(\"%s: MoE cache budget is too small for %zu layers, they are not cached\\n\", __func__, g.layers.size());\n   513\t                g.n_slots = 0;\n   514\t                continue;\n   515\t            }\n   516\t            g.lru.init(model.layers.size(), n_expert, g.n_slots);\n   517\t            n_tensors[g.id] += g.ref.size()*(1 + g.layers.size());\n   518\t            n_tensors_host  += g.layers.size()*(n_zero > 0 ? 3 : 1); // slot maps and CPU map\n   519\t        }\n   520\t        if (n_tensors_host == 0) {\n   521\t            throw std::runtime_error(\"MoE cache is too small to hold the experts of one token\");\n   522\t        }\n   523\t\n   524\t        auto init_ctx = [](size_t n_tensors) {\n   525\t            ggml_init_params params = {\n   526\t                /*.mem_size   =*/ n_tensors*ggml_tensor_overhead(),\n   527\t                /*.mem_buffer =*/ nullptr,\n   528\t                /*.no_alloc   =*/ true,\n   529\t            };\n   530\t            ggml_context_ptr res(ggml_init(params));\n   531\t            if (!res) {\n   532\t                throw std::runtime_error(\"failed to create the MoE cache context\");\n   533\t            }\n   534\t            return res;\n   535\t        };\n   536\t        for (size_t id = 0; id < devices.size(); ++id) {\n   537\t            if (n_tensors[id] > 0) {\n   538\t                devices[id].ctx = init_ctx(n_tensors[id]);\n   539\t            }\n   540\t        }\n   541\t        ctx_host  = init_ctx(n_tensors_host);\n   542\t        ctx_views = init_ctx(2);\n   543\t\n   544\t        ggml_backend_buffer_type_t buft_host = ggml_backend_cpu_buffer_type();\n   545\t        const size_t alignment_host = ggml_backend_buft_get_alignment(buft_host);\n   546\t\n   547\t        for (size_t ig = 0; ig < groups.size(); ++ig) {\n   548\t            group & g = groups[ig];\n   549\t            if (g.n_slots == 0) {\n   550\t                continue;\n   551\t            }\n   552\t            ggml_context * ctx = devices[g.id].ctx.get();\n   553\t            for (const ggml_tensor * t : g.ref) {\n   554\t                ggml_tensor * bank = ggml_new_tensor_3d(ctx, t->type, t->ne[0], t->ne[1], g.n_slots + n_zero + 1);\n   555\t                GGML_ASSERT(bank->nb[2] == t->nb[2]);\n   556\t                ggml_format_name(bank, \"moe_cache.%zu.%s\", ig, t->name);\n   557\t                g.banks.push_back(bank);\n   558\t            }\n   559\t            for (int32_t il : g.layers) {\n   560\t                layer & l = layers[il];\n   561\t                l.ig      = (int32_t) ig;\n   562\t                l.experts = llama_moe_cache_layer_experts(model.layers[il]);\n   563\t                for (size_t ip = 0; ip < l.experts.size(); ++ip) {\n   564\t                    ggml_tensor * bank   = g.banks[ip];\n   565\t                    ggml_tensor * cached = ggml_view_3d(ctx, bank, bank->ne[0], bank->ne[1], g.n_slots + n_zero, bank->nb[1], bank->nb[2], 0);\n   566\t                    ggml_format_name(cached, \"moe_cache.%s\", l.experts[ip]->name);\n   567\t                    bindings[l.experts[ip]] = { il, (int32_t) ip, cached };\n   568\t                }\n   569\t                l.slot_map = ggml_new_tensor_2d(ctx_host.get(), GGML_TYPE_I32, 1, g.ref[0]->ne[2]);\n   570\t                ggml_format_name(l.slot_map, \"moe_cache.slot_map-%d\", il);\n   571\t                layer_of[l.slot_map] = { il, false };\n   572\t                buf_host_size += GGML_PAD(ggml_nbytes(l.slot_map), alignment_host);\n   573\t                if (n_zero > 0) {\n   574\t                    l.slot_map_cpu = ggml_new_tensor_2d(ctx_host.get(), GGML_TYPE_I32, 1, g.ref[0]->ne[2]);\n   575\t                    ggml_format_name(l.slot_map_cpu, \"moe_cache.slot_map_cpu-%d\", il);\n   576\t                    layer_of[l.slot_map_cpu] = { il, true };\n   577\t                    buf_host_size += GGML_PAD(ggml_nbytes(l.slot_map_cpu), alignment_host);\n   578\t                    l.cpu_map = ggml_new_tensor_2d(ctx_host.get(), GGML_TYPE_I32, 1, g.ref[0]->ne[2]);\n   579\t                    ggml_format_name(l.cpu_map, \"moe_cache.cpu_map-%d\", il);\n   580\t                    buf_host_size += GGML_PAD(ggml_nbytes(l.cpu_map), alignment_host);\n   581\t                }\n   582\t            }\n   583\t            devices[g.id].buf_size += alloc_size(g, g.n_slots);\n   584\t        }\n   585\t\n   586\t        // with no_alloc, dummy buffers are attached so the memory use can still be measured, see llama_context::memory_breakdown\n   587\t        for (device & d : devices) {\n   588\t            if (!d.ctx) {\n   589\t                continue;\n   590\t            }\n   591\t            d.buf = llama_memory_bufs::alloc_buf(d.ctx.get(), d.buft, no_alloc, \"MoE cache\");\n   592\t            if (!no_alloc) {\n   593\t                ggml_backend_buffer_clear(d.buf.get(), 0);\n   594\t                d.buf_size = ggml_backend_buffer_get_size(d.buf.get());\n   595\t            }\n   596\t        }\n   597\t        buf_host = llama_memory_bufs::alloc_buf(ctx_host.get(), buft_host, no_alloc, \"MoE cache slot maps\");\n   598\t        if (!no_alloc) {\n   599\t            ggml_backend_buffer_clear(buf_host.get(), 0xff); // the CPU maps are -1\n   600\t            buf_host_size = ggml_backend_buffer_get_size(buf_host.get());\n   601\t\n   602\t            for (group & g : groups) {\n   603\t                for (int32_t il : g.layers) {\n   604\t                    if (layers[il].slot_map != nullptr) {\n   605\t                        int32_t * slots = (int32_t *) layers[il].slot_map->data;\n   606\t                        std::fill(slots, slots + layers[il].slot_map->ne[1], g.lru.empty);\n   607\t                        g.lru.slot_map[il] = slots;\n   608\t                    }\n   609\t                }\n   610\t            }\n   611\t        }\n   612\t\n   613\t        // as weights, the ops that read the banks run on the device and the slot maps are copied with the copy callback\n   614\t        for (device & d : devices) {\n   615\t            if (d.buf) {\n   616\t                ggml_backend_buffer_set_usage(d.buf.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);\n   617\t            }\n   618\t        }\n   619\t        ggml_backend_buffer_set_usage(buf_host.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);\n   620\t\n   621\t        for (size_t id = 0; id < devices.size(); ++id) {\n   622\t            const device & d = devices[id];\n   623\t            if (d.host_bytes == 0) {\n   624\t                continue;\n   625\t            }\n   626\t            LLAMA_LOG_INFO(\"%s: %10s MoE cache size = %8.2f MiB for %.2f MiB of host experts, %.0f%% of the misses on the CPU\\n\", __func__,\n   627\t                ggml_backend_buft_name(d.buft), d.buf_size/1024.0/1024.0, d.host_bytes/1024.0/1024.0, 100.0*cpu_share);\n   628\t            for (const group & g : groups) {\n   629\t                if (g.id == (int32_t) id) {\n   630\t                    LLAMA_LOG_INFO(\"%s: %2zu layers, %s: %5d slots (%.1f%%, %.1f tokens worth)\\n\", __func__,\n   631\t                        g.layers.size(), ggml_type_name(g.ref.back()->type), g.n_slots, 100.0*g.n_slots/(g.layers.size()*g.ref[0]->ne[2]),\n   632\t                        (double) g.n_slots/(g.layers.size()*n_expert_used));\n   633\t                }\n   634\t            }\n   635\t        }\n   636\t    }\n   637\t\n   638\t    ggml_backend_t backend(int32_t il) const {\n   639\t        return devices[groups[layers[il].ig].id].backend;\n   640\t    }\n   641\t\n   642\t    // trace format, little endian: \"MCT1\", then u32 n_layer, n_expert_used, n_group\n   643\t    // per group: u32 device, n_expert, n_layers, the layers (u32), f64 split, split_sum, u64 group host bytes, device host bytes, alignment,\n   644\t    //            u32 n_tensors, the bytes of one expert of each tensor (u64)\n   645\t    // then one record per slot lookup: i32 layer, experts per token, n_ids, the ids (i32)\n   646\t    void write_trace_header(double split_sum) {\n   647\t        auto u32 = [&](uint32_t v) { fwrite(&v, sizeof(v), 1, trace); };\n   648\t        auto u64 = [&](uint64_t v) { fwrite(&v, sizeof(v), 1, trace); };\n   649\t        auto f64 = [&](double   v) { fwrite(&v, sizeof(v), 1, trace); };\n   650\t        fwrite(\"MCT1\", 1, 4, trace);\n   651\t        u32(layers.size());\n   652\t        u32(n_expert_used);\n   653\t        u32(groups.size());\n   654\t        for (const group & g : groups) {\n   655\t            const device & d = devices[g.id];\n   656\t            u32(g.id);\n   657\t            u32(g.ref[0]->ne[2]);\n   658\t            u32(g.layers.size());\n   659\t            for (int32_t il : g.layers) {\n   660\t                u32(il);\n   661\t            }\n   662\t            f64(d.split);\n   663\t            f64(split_sum);\n   664\t            u64(g.host_bytes);\n   665\t            u64(d.host_bytes);\n   666\t            u64(ggml_backend_buft_get_alignment(d.buft));\n   667\t            u32(g.ref.size());\n   668\t            for (const ggml_tensor * t : g.ref) {\n   669\t                u64(t->nb[2]);\n   670\t            }\n   671\t        }\n   672\t    }\n   673\t\n   674\t    void write_trace(int32_t il, int32_t n_used) {\n   675\t        const int32_t rec[3] = { il, n_used, (int32_t) ids.size() };\n   676\t        fwrite(rec, sizeof(int32_t), 3, trace);\n   677\t        fwrite(ids.data(), sizeof(int32_t), ids.size(), trace);\n   678\t    }\n   679\t\n   680\t    ~impl() {\n   681\t        log_stats();\n   682\t        if (trace != nullptr) {\n   683\t            fclose(trace);\n   684\t        }\n   685\t    }\n   686\t\n   687\t    ggml_tensor * get_slot_map(int32_t il, int64_t n_tokens, int64_t n_expert_used, bool cpu_part) const {\n   688\t        if (il < 0 || il >= (int32_t) layers.size() || layers[il].ig < 0) {\n   689\t            return nullptr;\n   690\t        }\n   691\t        const layer & l = layers[il];\n   692\t\n   693\t        // large batches use most experts of a layer, so they gain little from the cache and would evict the experts used in generation\n   694\t        if (n_tokens == 0 || n_tokens > max_batch || std::min(n_tokens*n_expert_used, l.slot_map->ne[1]) > groups[l.ig].n_slots) {\n   695\t            return nullptr;\n   696\t        }\n   697\t        GGML_ASSERT(!cpu_part || l.slot_map_cpu != nullptr);\n   698\t        return cpu_part ? l.slot_map_cpu : l.slot_map;\n   699\t    }\n   700\t\n   701\t    ggml_tensor * get_cpu_map(int32_t il, int64_t n_tokens) const {\n   702\t        if (il < 0 || il >= (int32_t) layers.size() || layers[il].cpu_map == nullptr) {\n   703\t            return nullptr;\n   704\t        }\n   705\t        // the scheduler would run the CPU part on a device that offloads such batches from host weights\n   706\t        ggml_tensor probe = {};\n   707\t        probe.op    = GGML_OP_MUL_MAT_ID;\n   708\t        probe.type  = GGML_TYPE_F32;\n   709\t        probe.ne[0] = 1;\n   710\t        probe.ne[1] = n_expert_used;\n   711\t        probe.ne[2] = n_tokens;\n   712\t        probe.ne[3] = 1;\n   713\t        for (const device & d : devices) {\n   714\t            if (ggml_backend_offload_op(d.backend, &probe)) {\n   715\t                return nullptr;\n   716\t            }\n   717\t        }\n   718\t        return layers[il].cpu_map;\n   719\t    }\n   720\t\n   721\t    ggml_tensor * get_experts(const ggml_tensor * w) const {\n   722\t        const auto it = bindings.find(w);\n   723\t        return it != bindings.end() ? it->second.cached : nullptr;\n   724\t    }\n   725\t\n   726\t    int64_t copy_experts(ggml_backend_t backend, const ggml_tensor * w, ggml_tensor * dst, int64_t e, int64_t last) {\n   727\t        const auto it = bindings.find(w);\n   728\t        if (it == bindings.end()) {\n   729\t            return 0;\n   730\t        }\n   731\t        const binding & b = it->second;\n   732\t        const group & g = groups[layers[b.il].ig];\n   733\t        if (backend != devices[g.id].backend) {\n   734\t            return 0;\n   735\t        }\n   736\t\n   737\t        // large batches only read the cache, so the experts used in generation stay in it\n   738\t        const int32_t * slots = g.lru.slot_map[b.il];\n   739\t        if (slots == nullptr || slots[e] >= g.n_slots) {\n   740\t            return 0;\n   741\t        }\n   742\t        int64_t n = 1;\n   743\t        while (e + n <= last && slots[e + n] < g.n_slots && slots[e + n] == slots[e] + n) {\n   744\t            n++;\n   745\t        }\n   746\t\n   747\t        ggml_tensor * bank = g.banks[b.ip];\n   748\t        ggml_reset(ctx_views.get());\n   749\t        ggml_tensor * src_view = ggml_view_3d(ctx_views.get(), bank, bank->ne[0], bank->ne[1], n, bank->nb[1], bank->nb[2], slots[e]*bank->nb[2]);\n   750\t        ggml_tensor * dst_view = ggml_view_3d(ctx_views.get(), dst,  dst->ne[0],  dst->ne[1],  n, dst->nb[1],  dst->nb[2],  e*dst->nb[2]);\n   751\t        ggml_backend_view_init(src_view);\n   752\t        ggml_backend_view_init(dst_view);\n   753\t        ggml_backend_tensor_copy_async(backend, backend, src_view, dst_view);\n   754\t\n   755\t        stats_copy.hits  += n;\n   756\t        stats_copy.bytes += ggml_nbytes(src_view);\n   757\t\n   758\t        return n;\n   759\t    }\n   760\t\n   761\t    bool copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, ggml_cgraph * graph) {\n   762\t        const auto it = layer_of.find(src);\n   763\t        if (it == layer_of.end()) {\n   764\t            return false;\n   765\t        }\n   766\t        const int32_t il      = it->second.first;\n   767\t        const bool    has_cpu = it->second.second;\n   768\t        layer & l = layers[il];\n   769\t        group & g = groups[l.ig];\n   770\t\n   771\t        GGML_ASSERT(backend == devices[g.id].backend);\n   772\t\n   773\t        // the get_rows that looks up the slots of the selected experts\n   774\t        const int n_nodes = ggml_graph_n_nodes(graph);\n   775\t        const ggml_tensor * lookup = nullptr;\n   776\t        for (int i = 0; i < n_nodes && lookup == nullptr; ++i) {\n   777\t            const ggml_tensor * node = ggml_graph_node(graph, i);\n   778\t            if (node->op == GGML_OP_GET_ROWS && node->src[0] == dst) {\n   779\t                lookup = node;\n   780\t            }\n   781\t        }\n   782\t        GGML_ASSERT(lookup != nullptr);\n   783\t\n   784\t        // the selected experts must be computed in an earlier split\n   785\t        // the scheduler starts a new split at the lookup because it reads a host weight, but only if the split already has inputs\n   786\t        const ggml_tensor * sel = lookup->src[1];\n   787\t        for (int i = 0; i < n_nodes; ++i) {\n   788\t            const ggml_tensor * node = ggml_graph_node(graph, i);\n   789\t            if (node == sel || node == sel->view_src) {\n   790\t                GGML_ABORT(\"the experts of layer %d are selected in the same split as their MoE cache lookup\", il);\n   791\t            }\n   792\t        }\n   793\t        GGML_ASSERT(ggml_is_contiguous(sel));\n   794\t        GGML_ASSERT(sel->op == GGML_OP_RESHAPE); // of the [n_expert_used, n_tokens] ids, see build_moe_cache_slots\n   795\t\n   796\t        const int32_t n_used = (int32_t) sel->src[0]->ne[0];\n   797\t\n   798\t        ids.resize(ggml_nelements(sel));\n   799\t        ggml_backend_tensor_get_async(backend, sel, ids.data(), 0, ggml_nbytes(sel));\n   800\t        ggml_backend_synchronize(backend);\n   801\t\n   802\t        if (trace != nullptr) {\n   803\t            write_trace(il, n_used);\n   804\t        }\n   805\t\n   806\t        // part of the misses is computed on the CPU once the cache is full, the carry keeps the share right on average\n   807\t        const uint32_t share_q = has_cpu && g.lru.n_filled == g.lru.n_slots ? cpu_share_q : 0;\n   808\t        auto n_cpu = [&](size_t n_miss) {\n   809\t            const uint64_t acc = (uint64_t) n_miss*share_q + l.cpu_acc;\n   810\t            l.cpu_acc = acc & 0xffff;\n   811\t            return (size_t) (acc >> 16);\n   812\t        };\n   813\t        size_t n_hit = 0;\n   814\t        if (!g.lru.plan(il, ids.data(), ids.size(), sel->src[0]->ne[1], n_used, n_zero, n_cpu, fills, cpu, n_hit)) {\n   815\t            GGML_ABORT(\"the MoE cache is too small for the experts selected in layer %d\", il);\n   816\t        }\n   817\t        if (has_cpu) {\n   818\t            int32_t * cpu_map = (int32_t *) l.cpu_map->data;\n   819\t            for (int32_t e : l.cpu_experts) {\n   820\t                cpu_map[e] = -1;\n   821\t            }\n   822\t            l.cpu_experts.clear();\n   823\t            for (const auto & f : cpu) {\n   824\t                cpu_map[f.expert] = f.expert;\n   825\t                l.cpu_experts.push_back(f.expert);\n   826\t            }\n   827\t        }\n   828\t\n   829\t        // upload the missing experts, consecutive experts going to consecutive slots are uploaded together\n   830\t        size_t bytes = 0;\n   831\t        for (size_t ip = 0; ip < l.experts.size(); ++ip) {\n   832\t            const ggml_tensor * w    = l.experts[ip];\n   833\t            ggml_tensor       * bank = g.banks[ip];\n   834\t            const size_t expert_size = w->nb[2];\n   835\t            for (size_t i = 0; i < fills.size();) {\n   836\t                size_t n = 1;\n   837\t                while (i + n < fills.size() && fills[i + n].expert == fills[i].expert + (int32_t) n && fills[i + n].slot == fills[i].slot + (int32_t) n) {\n   838\t                    n++;\n   839\t                }\n   840\t                ggml_backend_tensor_set_async(backend, bank, (const uint8_t *) w->data + fills[i].expert*expert_size, fills[i].slot*expert_size, n*expert_size);\n   841\t                bytes += n*expert_size;\n   842\t                i += n;\n   843\t            }\n   844\t        }\n   845\t\n   846\t        stats & st = ids.size() <= (size_t) 8*n_expert_used ? stats_small : stats_large;\n   847\t        st.hits   += n_hit;\n   848\t        st.misses += fills.size() + cpu.size();\n   849\t        st.cpu    += cpu.size();\n   850\t        st.bytes  += bytes;\n   851\t\n   852\t        // the next copy synchronizes the backend before it changes the slot map again\n   853\t        ggml_backend_tensor_set_async(backend, dst, l.slot_map->data, 0, ggml_nbytes(l.slot_map));\n   854\t\n   855\t        return true;\n   856\t    }\n   857\t\n   858\t    void log_stats() const {\n   859\t        auto log = [](const char * name, const stats & st) {\n   860\t            const size_t n = st.hits + st.misses;\n   861\t            if (n == 0) {\n   862\t                return;\n   863\t            }\n   864\t            LLAMA_LOG_INFO(\"llama_moe_cache: %s: hits = %zu, misses = %zu (%zu on the CPU), hit rate = %.2f%%, uploaded = %.2f MiB\\n\",\n   865\t                name, st.hits, st.misses, st.cpu, 100.0*st.hits/n, st.bytes/1024.0/1024.0);\n   866\t        };\n   867\t        log(\"ubatch <= 8\", stats_small);\n   868\t        log(\"ubatch  > 8\", stats_large);\n   869\t        if (stats_copy.hits > 0) {\n   870\t            LLAMA_LOG_INFO(\"llama_moe_cache: large batches: %zu experts copied from the cache, %.2f MiB\\n\", stats_copy.hits, stats_copy.bytes/1024.0/1024.0);\n   871\t        }\n   872\t    }\n   873\t};\n   874\t\n   875\tllama_moe_cache::llama_moe_cache(const llama_model & model, bool no_alloc, const std::vector<ggml_backend_t> & backends, const std::vector<ggml_backend_buffer_type_t> & bufts, size_t size, float cpu_share) :\n   876\t    pimpl(new impl(model, no_alloc, backends, bufts, size, cpu_share)) {\n   877\t}\n   878\t\n   879\tllama_moe_cache::~llama_moe_cache() = default;\n   880\t\n   881\tggml_backend_t llama_moe_cache::backend(int32_t il) const {\n   882\t    return pimpl->backend(il);\n   883\t}\n   884\t\n   885\tggml_tensor * llama_moe_cache::get_slot_map(int32_t il, int64_t n_tokens, int64_t n_expert_used, bool cpu_part) const {\n   886\t    return pimpl->get_slot_map(il, n_tokens, n_expert_used, cpu_part);\n   887\t}\n   888\t\n   889\tggml_tensor * llama_moe_cache::get_experts(const ggml_tensor * w) const {\n   890\t    return pimpl->get_experts(w);\n   891\t}\n   892\t\n   893\tggml_tensor * llama_moe_cache::get_cpu_map(int32_t il, int64_t n_tokens) const {\n   894\t    return pimpl->get_cpu_map(il, n_tokens);\n   895\t}\n   896\t\n   897\tbool llama_moe_cache::copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, ggml_cgraph * graph) {\n   898\t    return pimpl->copy(backend, src, dst, graph);\n   899\t}\n   900\t\n   901\tint64_t llama_moe_cache::copy_experts(ggml_backend_t backend, const ggml_tensor * w, ggml_tensor * dst, int64_t e, int64_t last) {\n   902\t    return pimpl->copy_experts(backend, w, dst, e, last);\n   903\t}\n   904\t\n   905\tstd::map<ggml_backend_buffer_type_t, size_t> llama_moe_cache::memory_breakdown() const {\n   906\t    std::map<ggml_backend_buffer_type_t, size_t> res;\n   907\t    for (const auto & d : pimpl->devices) {\n   908\t        if (d.buf) {\n   909\t            res[ggml_backend_buffer_get_type(d.buf.get())] += d.buf_size;\n   910\t        }\n   911\t    }\n   912\t    if (pimpl->buf_host) {\n   913\t        res[ggml_backend_buffer_get_type(pimpl->buf_host.get())] += pimpl->buf_host_size;\n   914\t    }\n   915\t    return res;\n   916\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'cat decisions/D041-qwen-moe-cache-screen-and-ncu.md decisions/D042-external-research-probes-1.md; cat artifacts/codexQRT/ANALYSIS.md; cat cc/model_inspect/README.md; head -100 cc/model_inspect/inspect_model.py'","aggregated_output":"# D041 — Upstream `--moe-cache-mib` beats static offload on Qwen at 8 GB (INDICATIVE); ncu decode roofline\n\nStatus: **INDICATIVE**. The screen was unfrozen, with 2 alternating rounds and no pre-registered protocol. A frozen follow-up is required before the factory adopts this.\nDate: 2026-11-10. Lane: x86-main.\nEngine: release-1 (`run_ref sha256:5b8a6a22…`, pin 31288c9c6). That pin contains upstream PR #29887, `--moe-cache-mib`.\nScript: `artifacts/mc-qwen/screen.sh`, op T-MCQ. Raw output is in `artifacts/mc-qwen/`.\n\n## Why\nD022 found that static `--n-cpu-moe` beats the engine LRU cache at every footprint. That test used **Granite**, whose experts are 0.84 MiB each.\nExternal reports for the upstream cache show decode gains on 16–32 GB cards with large MoEs (R9700 11→27.6 t/s; 5060 Ti 16 GB 15→19 t/s). They also say a hit rate of about 75% is needed.\nD031 had already flagged a proxy-scale bias, so the D022 conclusion needed retesting on Qwen3-30B-A3B Q4_K_M.\n\n## Result\nSettings: chat prompt, 128 tokens, greedy decoding, FA on, ctx 4096. Peak VRAM is from nvidia-smi polled every 0.5 s.\n\n| Config | Peak MiB | Decode t/s (r1, r2) | Prompt eval ms | Text sha |\n|---|---:|---|---:|---|\n| static `--n-cpu-moe 30` | 8193 | 36.88, 37.33 | 757, 783 | 1189257b |\n| all-CPU experts + `--moe-cache-mib 6000` | 7831 | **51.13, 51.44** | 1082, 1089 | bf80f280 |\n| static `--n-cpu-moe 42` | 4105 | 27.93, 26.77 | 1000, 996 | 77a3045a |\n| all-CPU experts + `--moe-cache-mib 2200` | 4029 | 18.00, 18.15 | 1088, 1088 | bf80f280 |\n\n- **At about 8 GB, the cache gives +38% decode with 362 MiB less VRAM.**\n  - TTFT is about 40% worse, 1085 ms against 770 ms. This matches the reported prompt-processing loss.\n- At about 4 GB, the cache is −34%. The crossover lies between the two budgets, and the hit rate is the likely driver.\n  - That fits T-QRT's coverage curves. Held-out decode coverage is 77% at the K=8-sized hot set, falling to 15% at K=42.\n- Every placement produced different greedy text, including static K30 against K42. This is the usual numeric divergence between CPU and GPU, not evidence of a bug. Even so, it needs a **KLD/PPL check**, not text identity.\n  - The two cache configs produce identical text, which is consistent with all expert math running on the GPU.\n- The host was quiet: no compiles, load average 2.4.\n\n## Consequences\n1. The D022 scope is narrowed to \"small experts / low coverage\". The planner must not hard-reject the expert cache.\n2. Planner: add the cache as a lever. Model the hit rate from routing-trace coverage curves (T-QRT), and price misses at PCIe upload cost. The decision rule becomes: cache when predicted coverage ≥ about 70%, otherwise static.\n3. The report must show the TTFT cost. The factory should expose a \"decode-optimised vs TTFT-optimised\" choice.\n4. Frozen follow-up: ABBA ×3 at budgets 4/6/8/10/12 GB, with the cache size swept to find the crossover. Add KLD against a reference and the hit rate from engine logs.\n\n## ncu decode roofline (Granite Q8_0, release-1, all-GPU), op T-NCU1\nSettings: `ncu --launch-skip 2000 --launch-count 600` on `llama-bench tg32`. Raw data is in `artifacts/ncu1/ncu.csv`.\nCaveat: ncu serialises kernels and flushes caches, so small-kernel times are inflated against graph replay.\n\n- The effective DRAM bandwidth over the profiled window is 222 GB/s. The 5070 Ti's peak is about 896 GB/s.\n- The large expert `mul_mat_vec_q` reaches 578 GB/s (66% of peak DRAM).\n- About 40% of kernel time goes to tiny 2–4 µs kernels at under 1% DRAM: `quantize_q8_1`, `rms_norm`, `add`, `scale`, `topk_moe`, `moe_weighted_reduction`.\n  - On a model this small, decode is launch- and latency-bound, not bandwidth-bound.\n  - **Fusion candidates:** rms_norm with quantize_q8_1, and scale with add.\n- An unprofiled nsys timeline is needed to size the real gain. ncu's serialisation exaggerates small kernels.\n# D042 — External-research probes, round 1 (INDICATIVE): n-gram speculation, perf, bpftrace, research intake\n\nStatus: INDICATIVE. These are single-round screens, no protocol was frozen, and the host was quiet. Date: 2026-11-10. Engine: release-1 (`sha256:5b8a6a22…`).\nResearch intake: `research/intake-1.json` and `research/INTAKE.md`, written by a Sonnet agent.\n- Channels that worked: paper-gatherer, `gh`, and the HF API.\n- Semantic Scholar rate-limited abstract lookups (HTTP 429), and the GitHub MCP failed to connect.\n\n## 1. N-gram self-speculation (`llama-server --spec-type`), Qwen3-30B-A3B Q4_K_M, K=30, op T-SPEC1/1b\nSettings: 256 tokens, temperature 0, single slot. Scripts: `artifacts/spec1/probe*.py`.\n\n| Prompt | base t/s | ngram-mod t/s | ngram-map-k t/s | drafts accepted | Text identical |\n|---|---:|---:|---:|---|---|\n| code rewrite (`/no_think`) | 35.6 | **85.2 (2.4×)** | 60.2 | 225/225 | yes |\n| list repeat (`/no_think`) | 35.2 | **106.6 (3.0×)** | 36.4 | 229/229 | yes |\n| open chat | 36.9 | 36.7 | 34.8 | 0 drafts | yes |\n\n- **Engagement lesson.** Run T-SPEC1 used prompts without `/no_think`. Qwen3 then began with free-form reasoning, so no drafts were made, and the probe looked like \"no effect\".\n  - Always log `timings.draft_n` and `draft_n_accepted`. Without them, the absence of a gain can't be told apart from speculation never running.\n- **Result: lossless, and gated by workload.** The factory should enable `ngram-mod` for copy-heavy work (editing, RAG quoting, code refactors). It costs nothing on chat.\n- **Why it suits offloaded MoE.** Verifying a batch of drafted tokens reads the CPU-resident experts once per batch instead of once per token. That cuts the dominant per-token CPU byte cost (see §3).\n- The Granite all-GPU repetitive prompt reached 1787 t/s, about 2.2× its baseline.\n\n## 2. perf (host change: `perf_event_paranoid` 4→1, runtime only; system-wide counting runs through `sudo perf`)\n- Zen 2 on kernel 6.8 exposes **no `amd_df` / UMC PMU**, so true DRAM bandwidth can't be counted.\n- The proxy, L1 data-cache fills from DRAM × 64 B, gave 14.9 GB/s during Qwen all-CPU-expert decode (24.4 t/s).\n  - It undercounts because it misses fills made only by the L2 prefetcher.\n  - IPC was 0.58 across 16 threads.\n- Conclusion: **CPU bandwidth must come from a microbenchmark** (T-CAL), not counters. perf remains useful for IPC and cycles.\n\n## 3. bpftrace uprobes on the CPU backend (sudo; target `/proc/<container pid>/root/app/libggml-cpu.so`)\nSettings: Qwen K=48, all experts on the CPU, 5 s window. Output: `artifacts/bpf1/bpf.txt`.\n- 5626 calls to `ggml_graph_compute`, which is **48.9 per token at 23.1 t/s**. That is one CPU split per layer.\n- CPU split time was **4.45 s of 5 s (89% of wall time)**, with a median per-split time of 0.5–1 ms (mean 0.79 ms).\n  - This independently confirms D039's 0.757 ms per CPU layer.\n  - The remaining 11% is GPU work, handoff and sampling.\n- **Pitfalls:**\n  - Use `docker inspect -f '{{.State.Pid}}'`. `pgrep` matches the host docker client.\n  - The CPU MoE matmul function is a templated static (`ggml_compute_forward_mul_mat_id_tiled_one_expert<…>`). Probe the C-exported `ggml_compute_forward_mul_mat_id_tiled` or `ggml_graph_compute` instead.\n- This is a zero-rebuild, low-overhead per-layer timer, and it should become a CC (`bpf_split_timer`).\n\n## 4. Intake priorities (see intake-1.json)\n1. Rebase onto upstream moe-cache changes after the pin. PR #30966 CPU-share targets our 4 GB loss in D041.\n2. Rebase onto ClassLRU, #31233 and #31853.\n3. Hit-rate regression issue #31421: check the hit rate at batch 1.\n4. MTP with Qwen3.6-35B-A3B-MTP GGUF (about 21 GB download).\n5. REAP-pruned Qwen3-30B (15B).\n6. S2-MoE (arXiv 2608.15018, llama.cpp-based code).\n7. Speculation and expert-bytes model.\n8. CUDA fusion PRs.\n\n## 5. Host calibration (T-CAL) first real run — NEGATIVE, fixed in T-CAL2\n- The CPU probe first failed with rc 127. The engine binary links `libcuda` even with `-b CPU`, so every engine-image probe needs `--gpus`. That is fixed in calibrate.py.\n- Constants after the rerun:\n  - GPU: 1384 GB/s. **Impossible**; the peak is about 896 GB/s.\n  - CPU: Q4_K 97, Q8_0 147 GB/s. **Impossible**; the DDR4 peak is about 50 GB/s.\n  - H2D: 28.7 GB/s. Plausible for PCIe 4.0.\n  - Handoff: 199 µs. Plausible; PL4's fitted value was 137 µs.\n- Cause: test-backend-ops perf reuses one weight buffer, about 33 MB on the GPU and about 7 MB on the CPU. Those fit the 48 MB GPU L2 and 32 MB CPU L3.\n- **Methodology rule:** every bandwidth probe must (a) use a working set of at least 8× the last-level cache and (b) pass a physical-ceiling plausibility guard. T-CAL2 adds both.\n# Qwen3-30B-A3B routing skew and placement forecast (T-QRT)\n\n## Result\n\nThe observer is shared across compatible MoE graphs, but the original tool was limited to 32 expert IDs and top-8. It could not trace this Qwen model. The additive patch reads `qwen3moe.expert_count` for Qwen3 only; Granite retains its original behavior. The graph, router, experts, backend and sampling math are unchanged. `model_inspect` already handles 128 experts and needed no edits. `trace_replay.py` still assumes Granite/32 and was not used.\n\n## Capture and validation\n\nSource: `31288c9c66e59377f7788d920678a565bb89dd37`, archived into `artifacts/codexQRT/tree`. CPU-only build, `GGML_CUDA=OFF`, `GGML_NATIVE=OFF`, `cmake --build ... --target llama-routing-trace -j4`, under `nice -n 10`. `configure.log`, `build.log`, `build-flags.txt`, `git-apply-check.log`, `patch-apply.log` and `build.sha256` retain build evidence. The final patch passes `git apply --check` against the pinned examples CMake file with new-file paths absent. `reference-status.txt` is empty (tracked reference tree clean).\n\nEach capture uses mmap, no repacking, `-ngl 0 -t 8 -tb 8 -b 128 -ub 128 -c 4096 -n 64`, under nice. One model process ran at a time, after the compiler finished. Commands, prompt hashes, exit codes and elapsed times are in `captures.json`; `capture.py` and `capture.log` reproduce the serial capture. Raw prompts have no added chat template. Greedy generation evaluates exactly 64 tokens even if EOG occurs. All prompt logits are requested to prevent last-layer pruning. Observer synchronization and all-logits prefill perturb performance; capture elapsed times are not baseline throughput.\n\nModel SHA256, independently computed from the local GGUF: `9f1a24700a339b09c06009b729b5c809e0b64c213b8af5b711b3dbdfd0c5ba48`.\n\n| Trace | Split | Prefill tokens | Decode tokens | Rows | Bytes | SHA256 |\n|---|---|---:|---:|---:|---:|---|\n| prose | TRAIN | 1302 | 64 | 65568 | 12872290 | `e6b2049c94b9d2ea81cafcf9e63d1d88955671d39bcbb809d80b7edad08b34e3` |\n| chat | EVAL | 59 | 64 | 5904 | 1151205 | `7e7b84b5dd1164c49dab9f22ca93f32f7e95fc9cf681e47dd354d6ae70fc9888` |\n| code | EVAL | 1764 | 64 | 87744 | 17233002 | `3c9e18340e6b7df997aaf00cd3b8cf50ebc88fa46ce0308d229cd6238ef1eaa0` |\n\nAll three exited zero. `analyze.py` checks eight distinct in-range IDs, one sequence, contiguous positions, exactly 64 decode positions, no duplicate token/layer record, and every position in all 48 layers. It cross-checks every phase/layer histogram against the official inspector. The required `python3 cc/model_inspect/inspect_model.py <gguf> --trace <trace>` ran for each capture, producing `prose-inspect.json`, `chat-inspect.json`, `code-inspect.json`, including complete per-layer coverage curves. `pytest.log`: 64 passed (existing tracer replay and model-inspection suites).\n\n## Fitting and exact byte budgets\n\nHot experts are ranked separately for each layer using only prose TRAIN prefill request counts, with ascending expert ID on ties. Prose decode is diagnostic only. Chat/code prefill and decode never choose hot sets or allocations. Coverage counts unweighted (token, expert) requests, not mixture weight mass. Evaluation decode pools 64 chat and 64 code tokens with equal request weight. This is a small two-prompt evaluation, not a representative workload guarantee.\n\nThe GGUF has 16,740 MiB of expert weights and 951.34 MiB of other weights. Its 24 layers with 2.53125 MiB/expert and 24 with 2.91796875 MiB/expert average 2.724609375 MiB. Static K means the first K layers put expert tensors on the CPU while other weights stay on the GPU; thus the comparable expert budget is the sum of expert bytes in layers K..47. Runtime/KV/compute/staging buffers are excluded from both analytical weight budgets. D039 GPU deltas include them and are listed separately.\n\nFor each byte budget, start every layer at H=floor(budget / sum(per-layer expert sizes)), then spend the remaining bytes on the next TRAIN-ranked expert with highest request-count/byte benefit until no expert fits. This is a simple nearly uniform allocation, not a claim of global optimal placement. H ranges below are the actual per-layer counts. Exact IDs and byte slack are in `analysis.json`. Nominal equal-sized-expert counts would be 106.67, 80, 48, 16; actual quantized layer sizes change these.\n\n| K | D039 GPU delta MiB | Expert budget MiB | Used expert MiB | H range | Remaining MiB |\n|---:|---:|---:|---:|---:|---:|\n| 8 | 15684 | 13851.00 | 13850.89 | 105-122 | 0.105 |\n| 18 | 12246 | 10413.00 | 10410.50 | 79-98 | 2.496 |\n| 30 | 8162 | 6327.00 | 6326.93 | 48-55 | 0.070 |\n| 42 | 4074 | 2241.00 | 2241.00 | 17-19 | 0.000 |\n\n| K | H range | TRAIN prefill | chat prefill | code prefill | chat decode | code decode | pooled decode | hybrid t/s (80-30 us) | static t/s |\n|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|\n| 8 | 105-122 | 100.00% | 90.71% | 58.13% | 91.39% | 62.55% | 76.97% | 59.2-69.0 | 93.5 |\n| 18 | 79-98 | 99.37% | 76.34% | 34.55% | 78.91% | 43.58% | 61.25% | 44.2-49.4 | 54.6 |\n| 30 | 48-55 | 92.70% | 56.43% | 17.05% | 58.61% | 31.32% | 44.96% | 35.0-38.2 | 36.6 |\n| 42 | 17-19 | 61.48% | 21.26% | 2.91% | 21.16% | 9.37% | 15.26% | 25.4-27.0 | 27.7 |\n\nAll coverage columns above use the same TRAIN-fitted hot sets, including EVAL prefill. The full inspector coverage curves rank each individual trace for descriptive statistics; those EVAL-fitted curves are not used for the held-out table.\n\n## Decode forecast and crossover\n\nD039 fit: c=(1/24.4 - 1/93.5)/40 = 0.757210 ms/CPU layer; t_gpu=1/93.5 - 8c = 4.637503 ms/token. The requested 2.72 MiB expert / 30 decimal GB/s model costs 0.760567 ms per fully cold top-8 layer.\n\nFor the main forecast, in milliseconds: `t = t_gpu + 48*(1-heldout_decode_coverage)*8*2.72*2^20/30e9*1000 + 48*t_handoff`. All 48 layers contain CPU-side cold banks, so the main table charges 48 handoffs even when a token selects only hot experts. An optional miss-aware implementation could avoid some boundaries; observed CPU-active layers and that optimistic 50 us variant are retained in `analysis.json`.\n\nD031/T-PROF adds 371.13 us of exposed sync/copy time for 12 extra CPU boundaries: 30.93 us/boundary. Its split total is 812.10/24=33.84 us/boundary. Those motivate 30 us as a lower estimate. Residual host time (+214.40 us/12=17.87 us) cannot be separated from CPU work/scheduling, and Qwen activations are larger. Use 50 us centrally and 80 us as a sensitivity upper bound. This is an assumed engineering range, not a measured Qwen confidence interval. The old per-slot GPU dispatch is excluded: the forecast assumes the T-PROF batched skip-ID dispatch design preserves roughly the fitted GPU term. Any new GPU work consumes the same benefit margin.\n\nD039 c includes aggregate CPU-layer overhead and only approximately identifies a pure bandwidth cost. Its intercept is not an independently measured all-GPU run (the whole model does not fit). Adding a separate handoff term to the byte estimate is conservative relative to the original aggregate fit, but does not remove this identification uncertainty. Actual Q4 type bandwidth, per-expert fixed CPU overhead, GPU hot work, overlap, host contention and memory allocation can change the forecast. No CUDA hybrid was implemented or measured.\n\n| K | Held-out decode | Hybrid t/s at 50 us | Static measured t/s | Required coverage at 50 us | Max affordable handoff us | CPU-active layers observed |\n|---:|---:|---:|---:|---:|---:|---:|\n| 8 | 76.97% | 64.7 | 93.5 | 89.98% | -48.9 | 33.74 |\n| 18 | 61.25% | 47.2 | 54.6 | 69.11% | -9.8 | 41.80 |\n| 30 | 44.96% | 36.9 | 36.6 | 44.44% | 54.0 | 47.45 |\n| 42 | 15.26% | 26.3 | 27.7 | 20.39% | 11.0 | 48.00 |\n\nThe coverage crossover sets the requested latency equation equal to each measured static point. The maximum handoff is the residual latency margin divided by 48; dispatch overhead beyond t_gpu must fit inside that same margin. K=8 and K=18 already lose at zero handoff. K=30 crosses parity at 44.44% coverage for a 50 us handoff; measured held-out coverage is only 44.96%. Its entire remaining margin is about 0.193 ms/token. K=42 requires 20.39% coverage at 50 us but achieves 15.26%; it would need handoff below 11.02 us, outside the estimated range. Thus there is no robust crossover across the requested budgets.\n\nEach domain is itself skewed: mean per-layer prefill entropy is 5.471 bits for prose, 5.488 for chat, and 5.410 for code, versus a 7-bit uniform maximum; separately fitted descriptive hot sets reach 90% coverage at mean H=42.92, 41.02, and 43.10 respectively. This does not mean prose-selected experts transfer to code. Low cross-domain coverage is evidence against this particular TRAIN policy, not proof that all expert placement policies fail.\n\n## Recommendation\n\nDo not prioritize a general qwen3moe CUDA hybrid on this TRAIN/EVAL evidence. At 30-80 us handoff, the pooled forecasts lose at K=8,18,42; K=30 spans 35.0-38.2 t/s versus static 36.6, with only a 0.7% central gain. The required batched skip-ID dispatch is a prerequisite, but its unknown incremental cost can erase that small gain. First validate hot sets trained on a larger, diverse and deployment-matched corpus against longer held-out continuations. A domain-specific prototype could be reconsidered if held-out coverage clears the listed thresholds with enough margin to pay dispatch, allocation and handoff costs. Preserve original selected-slot order/numerics, batch CUDA skip-ID expert dispatch, and measure actual Qwen handoffs before claiming speedup. This assignment measures routing and forecasts; it does not validate a hybrid implementation.\n\n## Reproduction\n\nAfter applying the patch and building the target as in `cc/routing_trace/README.md`, run:\n\n```bash\nPYTHONDONTWRITEBYTECODE=1 nice -n 10 python3 artifacts/codexQRT/capture.py\nPYTHONDONTWRITEBYTECODE=1 python3 artifacts/codexQRT/analyze.py\nPYTHONDONTWRITEBYTECODE=1 python3 artifacts/codexQRT/write_report.py\n```\n\nWrites for this assignment are confined to the additive `cc/routing_trace/{routing-trace.patch,README.md}` changes and `artifacts/codexQRT/**`. No Docker, GPU execution, commits or changes to the reference source were used.\n# Model inspection\n\n`inspect_model.py` uses Python 3.12, numpy, and the pinned local\n`ref/llama.cpp/gguf-py`. It reads that reference tree without writing caches.\nIt never reads, dequantizes, copies, or hashes tensor payloads. A read-only\nfile mapping provides metadata parsing; its tensor-construction hook is\nreplaced with shape/type accounting, and the mapping closes after inspection.\nNo builds, GPU work, worker pools, or model inference are required.\n\nFrom the campaign root:\n\n```bash\nOPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1 \\\n  python cc/model_inspect/inspect_model.py \\\n  ~/models/campaign/gguf/granite-3.1-1b-a400m-instruct-mixE4K.gguf \\\n  --trace experiments/routing/prose.json \\\n  --out artifacts/codexMI/granite-mixE4K.json --summary\n```\n\nThe Python API is `inspect(gguf_path, trace=None) -> dict`, with\n`schema: \"model-stats/0\"`. Without `--out` or `--summary`, the CLI writes JSON\nto stdout. `--summary` prints a human-readable Markdown table; use `--out`\nalongside it to retain the full machine report. Missing paths or invalid\nheaders/traces produce a nonzero exit. Output parent directories must exist.\n\n## Accounting conventions\n\n- Shapes use GGML order (`ne[0]` is the contiguous dimension), the reverse of\n  numpy shape order. Bytes are exact tensor payload bytes from integer shape\n  products and `GGML_QUANT_SIZES`; file headers and alignment gaps are excluded.\n- `ROLE_PATTERNS` is the explicit ordered classification table. It covers\n  Granite, Mixtral/llama MoE, Qwen2/3 MoE, DeepSeek2 MLA and leading dense FFNs,\n  GPT-OSS fused gate/up and biases, and hybrid hot/cold tensors and ID maps.\n  Unknown tensors contribute to `other`, remain in `tensors`, and appear in\n  `unknown_tensors` with a warning. Tied embedding/output storage is counted\n  once; absent output tensors do not create a fictitious second embedding.\n- Shared expert count/dimensions come from metadata when supplied. A shared\n  FFN without count metadata is flagged rather than guessing a count from a\n  fused matrix. Expert FFN width falls back to bank shapes when needed.\n- `per_layer_experts` reports physical, real and null expert bytes and each\n  projection's per-expert storage. Hot/cold banks with different encodings\n  retain separate byte rates; a single common rate is `null` when unequal.\n  Hybrid metadata declares one null slot in every hot bank; these slots count\n  toward physical storage, placement floors and the proportional storage\n  estimate; a separate active estimate excludes the null overhead.\n- Active bytes are non-expert bytes (including shared FFNs once) plus\n  `top_k/E * stored_expert_bytes`, as requested. The additional\n  `real_experts_only_bytes` field uses real expert bytes without null padding.\n  These estimate proportional weight storage, not measured memory traffic.\n  They assume uniformly sized experts. Missing top-k\n  makes this estimate unavailable rather than inventing a value.\n- GPU strategy floors place all non-expert weights, including shared FFNs,\n  on GPU. Fractions apply to stored expert bytes and allow fractional expert\n  counts. They exclude KV, runtime, compute buffers, allocator padding, host\n  duplicates and transfer staging. Hybrid reports additionally include the\n  actual hot-bank placement floor, including null slots and router ID maps.\n- KV assumes one full-context sequence and the same cache type for K/V.\n  Block sizes and bytes come from ggml. Rows with invalid block alignment\n  yield `null` plus a reason, never fractional blocks. Current DeepSeek MLA\n  `key_length_mla`/`value_length_mla` metadata triggers the pinned engine's\n  K-only compressed latent/rope allocation; legacy GGUF dimensions use separate\n  K/V storage. Backend support for a listed cache type is not implied. There\n  is no sliding-window reduction or allocator/context padding. The requested\n  contexts are reported even when they exceed a model's context limit.\n\n## Routing traces\n\n`--trace` accepts the JSONL records documented by\n`cc/routing_trace/README.md` or the replay JSON produced by `trace_replay.py`\n(including `experiments/routing/*.json`). JSONL validates model-specific\nexpert ranges/top-k, weights, layer/phase, and duplicate positions. Replay\nJSON uses its histograms, not simulated cache hits. Raw and replay reports\nagree on the real prose trace.\n\nMetrics count unweighted expert requests: frequency, Shannon entropy (bits),\nGini over all E experts including unused ones, and cumulative coverage by\ndescending frequency (expert ID breaks ties). `coverage_curve[H-1]` is the\nfraction covered by the top H experts; recommendations are minimum H for\n50%, 75%, and 90%. Empty histograms have unavailable rates/recommendations.\n\nPhases and optional per-row `split` labels remain separate. The official raw\nformat has no train/eval split; it is explicitly `unspecified`, with observed\nsequence/position ranges recorded. Replay split/train/evaluation/source\nannotations are preserved when present. No split is inferred from filenames.\nEvery report warns that train≠eval and that completeness is not established.\nRecommendations fitted to these traces need disjoint evaluation before use.\n\n## Verification\n\n```bash\nOPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1 \\\n  python -m pytest -q cc/model_inspect/test_inspect_model.py \\\n  --basetemp=artifacts/codexMI/pytest-tmp \\\n  -o cache_dir=artifacts/codexMI/pytest-cache\n```\n\nTests inspect real BF16, Q8_0, Q4_K_M and mixE4K Granite files and the real\nhybrid split. They verify D013's approximately 90% expert share, mixE4K's\nQ4_K experts with the Q8_0 source's non-expert types unchanged, null slots,\nbyte totals, placement floors, independent KV block-size calculations,\nheader-only access, synthetic shared-expert/MLA headers, routing metrics,\ntrace validation, real raw/replay equivalence, and CLI outputs. Real-file\ntests skip with explicit reasons on machines without the campaign models.\n#!/usr/bin/env python3\n\"\"\"Header-only GGUF weight/KV accounting. No tensor payloads are accessed.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nfrom collections import Counter, defaultdict\nimport json\nimport math\nfrom pathlib import Path\nimport re\nimport sys\n\n# Keep the reference tree read-only, including Python's implicit cache writes.\nsys.dont_write_bytecode = True\nROOT = Path(__file__).resolve().parents[2]\nsys.path.insert(0, str(ROOT / \"ref/llama.cpp/gguf-py\"))\nimport gguf  # noqa: E402\n\n\n# Ordered, explicit llama.cpp GGUF names; suffixes include weight/bias/scales and\n# hybrid .weight.hot/.weight.cold. Architecture labels document coverage rather\n# than restricting matches (converters reuse these names across architectures).\nROLE_PATTERNS = [\n    (\"router\", r\"blk\\.\\d+\\.ffn_(?:gate_inp(?:_shexp)?|exp_probs_b|expert_ids)(?:\\..*)?\",\n     \"granitemoe, llama/mixtral, qwen2moe/qwen3moe, deepseek2, gpt-oss, hybrid ID maps\"),\n    (\"shared_ffn\", r\"blk\\.\\d+\\.ffn_(?:gate|up|down|gate_up)_(?:shexp|shared_exps)(?:\\..*)?\",\n     \"qwen2moe/qwen3moe and deepseek2 shared experts\"),\n    (\"expert_ffn\", r\"blk\\.\\d+\\.ffn_(?:gate|up|down|gate_up|norm)_exps(?:\\..*)?\",\n     \"granitemoe, llama/mixtral, qwen2moe/qwen3moe, deepseek2, gpt-oss fused gate_up; hot/cold\"),\n    (\"norm\", r\"(?:output_norm|blk\\.\\d+\\.(?:attn|ffn|layer|post_attention|post_ffn)[\\w]*norm[\\w]*)(?:\\..*)?\",\n     \"all architectures, including deepseek2 attn_q_a_norm/attn_kv_a_norm\"),\n    (\"attn_qkv\", r\"blk\\.\\d+\\.attn_(?:q|k|v|qkv|q_a|q_b|kv_a_mqa|kv_b|k_b|v_b|kv)(?:\\..*)?\",\n     \"GQA/MHA and deepseek2 MLA projections\"),\n    (\"attn_out\", r\"blk\\.\\d+\\.attn_(?:output|output_a|output_b|sinks|gate)(?:\\..*)?\",\n     \"attention output and gpt-oss attention sinks\"),\n    (\"dense_ffn\", r\"blk\\.\\d+\\.ffn_(?:gate|up|down|gate_up|act)(?:\\..*)?\",\n     \"dense FFNs, including deepseek2 initial dense layers\"),\n    (\"embed\", r\"(?:token_embd|position_embd|token_types)(?:\\..*)?\", \"token/position embeddings\"),\n    (\"output\", r\"output(?:\\..*)?\", \"untied output head; tied embeddings counted only once\"),\n]\nROLES = tuple(dict.fromkeys(role for role, _, _ in ROLE_PATTERNS)) + (\"other\",)\nCOMPILED_ROLES = [(role, re.compile(pattern)) for role, pattern, _ in ROLE_PATTERNS]\nCACHE_TYPES = (\"F16\", \"BF16\", \"Q8_0\", \"Q5_1\", \"Q5_0\", \"Q4_1\", \"Q4_0\")\n\n\ndef classify(name):\n    return next((role for role, pattern in COMPILED_ROLES if pattern.fullmatch(name)), \"other\")\n\n\nclass HeaderReader(gguf.GGUFReader):\n    \"\"\"Reuse pinned metadata parsing, but never create or read payload views.\n\n    GGUFReader maps the file read-only; only header pages are touched. Overriding\n    this hook also allows inspection of metadata for tensor types that have no\n    numpy dequantizer. This is the only use of a private gguf-py reader hook.\n    \"\"\"\n\n    def _build_tensors(self, start_offs, fields):\n        self.tensor_headers = []\n        seen = set()\n        for field in fields:\n            _, _, _, dims, raw_type, offset = field.parts\n            name = field.name\n            if name in seen:\n                raise ValueError(f\"duplicate tensor: {name}\")\n            seen.add(name)\n            shape = [int(x) for x in dims]\n            dtype = gguf.GGMLQuantizationType(int(raw_type[0]))\n            block, size = gguf.GGML_QUANT_SIZES[dtype]\n            if not shape or any(d <= 0 for d in shape) or shape[0] % block:\n                raise ValueError(f\"invalid shape/block alignment for {name}: {shape}, {dtype.name}\")\n            nbytes = math.prod(shape) // block * size\n            if start_offs + int(offset[0]) + nbytes > self.data.nbytes:\n                raise ValueError(f\"tensor extends beyond file: {name}\")\n            self.tensor_headers.append({\"name\": name, \"ggml_type\": dtype.name,\n                                        \"shape\": shape, \"bytes\": nbytes})\n\n\ndef _layer_values(value, n_layer):\n    if isinstance(value, list):\n        if len(value) != n_layer:\n            raise ValueError(\"per-layer metadata length differs from block_count\")\n        return value\n    return [value] * n_layer\n\n\ndef kv_stats(model, warnings):\n    \"\"\"Logical full-context cache, one sequence, K and V of the same type.\n\n    Quantization blocks apply to each flattened GQA row, not to total elements\n    across layers. No fictitious fractional blocks: invalid rows yield null.\n    \"\"\"\n    layers = model[\"n_layer\"]\n    contexts = list(dict.fromkeys([2048, 4096, 8192, 32768] +\n                                 ([model[\"