+new_output 03-uma
+engine_container -c 'set -euo pipefail; /placement/build-operator/probe_uma "$1" 67108864 0 > /out/probe.tsv 2> /out/stderr.txt' \
+    f19 "/om/$F19_MODEL"
+cp /proc/meminfo "$OUT/meminfo.after.txt"
+echo "UMA_OK $OUT/probe.tsv"
