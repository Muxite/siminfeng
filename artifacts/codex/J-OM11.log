#!/usr/bin/env python3
"""Recompute a gate from saved summaries without changing original evidence."""
import argparse
import json
from pathlib import Path
import sys

if __package__:
    from . import abrun, gate, run_summary
else:
    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
    from cc.abrun import abrun, gate, run_summary


def recompute(outdir, exclude=(), metric=None, reason=''):
    outdir = Path(outdir)
    spec = json.loads((outdir / 'spec.json').read_text())
    grouped = {arm: [] for arm in spec['arms']}
    paths = sorted(outdir.glob('*/summary.json'))
    known = {p.parent.name for p in paths}
    excluded = list(dict.fromkeys(exclude))
    unknown = set(excluded) - known
    if unknown:
        raise ValueError('unknown excluded run IDs: ' + ', '.join(sorted(unknown)))
    included, invalid = [], []
    for path in paths:
        run_id = path.parent.name
        if run_id in excluded:
            continue
        arm = run_id.split('-', 1)[1]
        if arm not in grouped:
            raise ValueError(f'{run_id}: unknown arm {arm!r}')
        summary = json.loads(path.read_text())
        # Recompute available raw evidence, including precision and phase metrics.
        # Summary-only archives remain readable; never overwrite their files.
        if (path.parent / 'stderr.txt').exists():
            observed = run_summary.summarize(path.parent, abrun.switch_patterns(spec), write=False)
            summary.update(observed)
        elif 'switch_matches' not in summary:
            observed = run_summary.summarize(path.parent, abrun.switch_patterns(spec), write=False)
            summary.update({key: observed[key] for key in ('switch_matches', 'switch_lines')})
        invalid.extend(f'{run_id}: {error}' for error in abrun.switch_errors(spec, arm, summary))
        grouped[arm].append(summary)
        included.append(run_id)
    verdict = gate.evaluate(grouped, metric or spec.get('metric', 'eval_ms_per_token'),
                            direction=spec.get('direction') if metric is None else None)
    invalid.extend(verdict['reasons'])
    verdict.update(status='INVALID' if invalid else 'completed', invalid_reasons=invalid,
                   excluded_runs=excluded, included_runs=included, reason=reason)
    if invalid:
        for comparison in verdict['comparisons'].values():
            comparison['verdict'] = 'null'
    return verdict


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('outdir', type=Path)
    parser.add_argument('--exclude', nargs='+', action='extend', default=[], metavar='RUN_ID')
    parser.add_argument('--metric')
    parser.add_argument('--reason', default='')
    parser.add_argument('--no-write', action='store_true')
    parser.add_argument('--dry', action='store_true', help='print secondary table without writing any files')
    args = parser.parse_args()
    try:
        verdict = recompute(args.outdir, args.exclude, args.metric, args.reason)
        text = json.dumps(verdict, indent=2) + '\n'
        if not args.no_write and not args.dry:
            (args.outdir / 'verdict-regate.json').write_text(text)
        if args.dry:
            print(f'{args.outdir.name}: metric={verdict["metric"]}, direction={verdict["direction"]}')
            print(gate.secondary_table(verdict))
        else:
            print(text, end='')
    except (OSError, ValueError, KeyError) as exc:
        parser.exit(1, f'regate: {exc}\n')


if __name__ == '__main__':
    main()


def write_report(out, spec, runs, verdict):
    (out / 'verdict.json').write_text(json.dumps(verdict, indent=2) + '\n')
    lines = [f"# {spec['id']}", '', f"Status: {verdict['status']}", '',
             '| # | Arm | Status | Metric | Wall s | Output SHA | Switch matches |',
             '|---|---|---|---:|---:|---|---|']
    metric = spec.get('metric', 'eval_ms_per_token')
    for row in runs:
        s = row['summary']
        matches = json.dumps(s.get('switch_matches', {})).replace('|', '&#124;')
        lines.append(f"| {row['index']} | {row['arm']} | {s['status']} | {s.get(metric)} | {s['wall_s']} | {s['output_sha']} | {matches} |")
    lines += ['', f"Metric: {metric} ({verdict['direction']} is better)", '', f"| Arm | Mean | {'A/B' if verdict['direction'] == 'lower' else 'B/A'} | Gate |",
              '|---|---:|---:|---|']
    for arm, mean in verdict['means'].items():
        comparison = verdict['comparisons'].get(arm, {})
        lines.append(f"| {arm} | {mean} | {comparison.get('ratio', '—')} | {comparison.get('verdict', 'base')} |")
    lines += ['', '## Secondary metrics (descriptive; no verdict)', '', gate.secondary_table(verdict)]
    lines += ['', f"A/A gap: {verdict['aa_gap']}; drift: {verdict['drift']}; threshold: {verdict['threshold']}",
              '', f"Output class: {verdict['output']['class']}", '',
              'Output details: `' + json.dumps(verdict['output']) + '`', '',
              *verdict.get('invalid_reasons', []), *verdict.get('reasons', [])]
    (out / 'REPORT.md').write_text('\n'.join(lines) + '\n')


def execute(spec, out, runs):
    # Exclusive creation refuses accidental overwrite/replay into prior results.
    out.mkdir(parents=True, exist_ok=False)
    (out / 'spec.json').write_text(json.dumps(spec, indent=2) + '\n')
    grouped = {arm: [] for arm in spec['arms']}
    completed, invalid = [], []
    try:
        checked = set()
        for arm in spec['arms'].values():
            key = (arm['image'], spec['tool'])
            if key not in checked:
                preflight.check(*key, spec['argv'])
                checked.add(key)
        for run in runs:
            rc = subprocess.run(run['command'], cwd=ROOT).returncode
            summary = run_summary.summarize(run['dir'], switch_patterns(spec))
            run['summary'] = summary
            completed.append(run)
            grouped[run['arm']].append(summary)
            invalid.extend(switch_errors(spec, run['arm'], summary))
            if rc != 0 or summary['status'] != 'ok':
                invalid.append(f"{run['arm']}: runner rc={rc}, status={summary['status']}")
            if invalid:
                break
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        invalid.append(str(exc))
    verdict = gate.evaluate(grouped, spec.get('metric', 'eval_ms_per_token'), direction=spec.get('direction'))
    if verdict['reasons']:
        invalid.extend(verdict['reasons'])
    verdict.update(status='INVALID' if invalid else 'completed', invalid_reasons=invalid,
                   planned_order=[r['arm'] for r in runs],
                   executed_order=[r['arm'] for r in completed])
    if invalid:
        for comparison in verdict['comparisons'].values():
            comparison['verdict'] = 'null'
    write_report(out, spec, completed, verdict)
    print(json.dumps(verdict, indent=2))
    return 1 if invalid else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('spec')
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--submit', action='store_true')
    args = parser.parse_args()
    try:
        path = Path(args.spec).resolve()
        spec = json.loads(path.read_text())
        validate(spec)
        out, runs = plan(spec)
        if args.dry_run:
            print('Order: ' + ', '.join(r['arm'] for r in runs))
            for run in runs:
                print(f"Run {run['index']}: {run['arm']}  {shlex.join(run['command'])}")
            return 0
        if args.submit:
            queue = ROOT / 'bin/jobq'
            if not queue.exists():
                raise ValueError('--submit requires bin/jobq')
            return subprocess.run([str(queue), 'submit', '--class', 'gpu', '--name', spec['id'],
                                   '--', sys.executable, str(Path(__file__).resolve()), str(path)],
                                  cwd=ROOT).returncode
        return execute(spec, out, runs)
    except (OSError, ValueError, TypeError, re.error) as exc:
        parser.exit(1, f'abrun: {exc}\n')


if __name__ == '__main__':
    sys.exit(main())

