    result = mcq.score(dict(id='test', answer='A', choices=['a', 'b']),
                       {'choices': [{'logprobs': {'content': [{'top_logprobs': []}]}}]})
    assert result['no_letter'] is True
    assert 'argmax_letter_found' not in result
