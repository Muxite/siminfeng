    59\t    int64_t qsa_alloc = 0;                ///< allocated QSA states (>= 1 whenever the model has any)\n    60\t    int64_t gdn_ord0 = 0;                 ///< global GDN ordinal of `gdn_state` row 0\n    61\t    int64_t gdn_alloc = 0;                ///< allocated GDN rows\n    62\t    int qsa_primary() const { return (int) qsa_ord0; }\n    63\t    /// The doorbell the host loop polls.  Null until a caller provides one - the engine runs without it, and\n    64\t    /// neither `session_token` nor `session_replay` looks at it.\n    65\t    const Doorbell* db = nullptr;\n    66\t\n    67\t    // ================================ THE PLE, AND IT IS SEQUENCE STATE ================================\n    68\t    //\n    69\t    // **THE PLE IS A LAYER-1 MODULE AND THIS ENGINE DID NOT RUN IT, WHICH IS WHY C1 FAILED** (LEDGER L123).\n    70\t    // Every part of it was already built and parity-tested - the hash against `ref/ngram.py` with the\n    71\t    // artifact's own constants, the IQ4_NL row read against numpy over the original GGUF, and the block\n    72\t    // against ggml's own graph - and none of it was ever called from the model path.  These fields are what\n    73\t    // was missing on the state side.\n    74\t    //\n    75\t    // `ple_prev` is the last two tokens OLDEST FIRST with `-1` where there is none, which is exactly\n    76\t    // `ngram_rows`' `prev` argument; `ple_token` is the token being decoded.  **They are advanced by the\n    77\t    // DRIVER, once per token**, because the hash is a function of the sequence and not of a layer.\n    78\t    int32_t ple_prev[2] = {-1, -1};\n    79\t    int32_t ple_token = -1;\n    80\t    /// `NG_HIST` rows of `hc_dim` NORMALIZED history, **ROW-FASTEST**: `ple_hist[row + NG_HIST*channel]`.\n    81\t    /// That is `ggml_reshape_3d(state, d_conv-1, conv_channels, n_seqs)`, not a layout choice - the transposed\n    82\t    /// reading fails ggml's own assert (`ple_layer_xcheck.cpp` L79-83).\n    83\t    float* ple_hist = nullptr;\n    84\t    /// **THE WHOLE PLE RUN LIVES HERE, AND THAT IS NOT A CONVENIENCE.**  Its history and its token window are\n    85\t    /// sequence state, so the session is where they belong - and putting the rest of it here too means\n    86\t    /// `session_capture`/`session_loop`/`session_token` need no new parameter to reach it.  A `PleRun` whose\n    87\t    /// `ready()` is false is skipped, which is what every caller had before LEDGER L123.\n    88\t    PleRun ple;\n    89\t};\n    90\t\n    91\t/// Bytes for a whole session at `max_cells` of context.  Every layer's state is sized at once, because P2.T10\n    92\t/// requires ZERO token-path allocations - a `cudaMalloc` that happened on the first token of a longer sequence\n    93\t/// would satisfy every test here and fail that one.\n    94\t///\n    95\t/// [layer_lo, layer_hi) carves only that range's per-layer state (a split stage runs a slice of the model);\n    96\t/// the default full range is byte-identical to the old whole-model carve.  Pure arithmetic - safe to call for\n    97\t/// a candidate range before anything is allocated, which is how the layer-split search prices a placement.\n    98\tuint64_t session_bytes(const ModelGeometry& g, int64_t max_cells, int64_t k, int64_t layer_lo = 0,\n    99\t                       int64_t layer_hi = -1);\n   100\t/// Carves `base` (DEVICE memory) into `s`.  Returns the bytes used.  Same range convention as `session_bytes`.\n   101\tuint64_t session_init(const ModelGeometry& g, int64_t max_cells, int64_t k, void* base, SessionState& s,\n   102\t                      int64_t layer_lo = 0, int64_t layer_hi = -1);\n   103\t/// Before the memory `session_init` carved is freed: forgets what points into it from outside the session (the\n   104\t/// rope kernels' registered angle table, #280), so a later session never rotates by freed memory.\n   105\tvoid session_release(SessionState& s);\n   106\t/// Zeroes every layer's state - the residual to `R_init`, everything else to zero, so a fresh sequence starts\n   107\t/// from the reference's own `zeros()`.\n   108\tvoid session_zero(SessionState& s, const ModelGeometry& g, const float* R_init, void* stream);\n   109\t\n   110\t/// One token: layers 0..47 in order, each a `block_layer`, and the residual is updated in place.\n   111\t///\n   112\t/// `parts` is (k, n_embd) DEVICE memory, filled by the caller - by the CPU expert pool and the VRAM-resident\n   113\t/// experts.  In this phase `moe_layer` consumes it directly; the doorbell protocol's job is to let it be\n   114\t/// produced DURING the layer rather than before it, which is a change to *when* the host runs, not to what this\n   115\t/// function computes.\n   116\t///\n   117\t/// `sync_every_layer` inserts a device synchronisation and an error check after EVERY layer.  That is the\n   118\t/// `--sync-every-layer` debug mode, and it is deliberately a parameter rather than a compile-time choice: the\n   119\t/// errors it catches (a kernel reading a buffer that a later layer writes) are invisible otherwise, and the\n   120\t/// synchronisation it costs is exactly what P2.X3 forbids in the fast path.\n   121\tbool session_token(const WeightTable& tables, const ModelGeometry& g, int64_t pos, int32_t pos_base,\n   122\t                   SessionState& s, const float* parts, void* stream, bool sync_every_layer,\n   123\t                   std::string& err);\n   124\t\n   125\t// ================================ the captured form ================================\n   126\t\n   127\t/// ONE GRAPH PER LAYER, because a graph bakes in its POINTERS and every layer has different weights AND\n   128\t/// different state.  That is not a limitation to work around - it is what makes the per-layer graph the right\n   129\t/// unit: the host decides when each layer runs, which is what lets the CPU expert pool start while the GPU is\n   130\t/// still working on the next one.\n   131\t///\n   132\t/// WHY THIS IS WORTH DOING, MEASURED: **the engine is launch-bound, not bandwidth-bound.**  Every kernel in\n   133\t/// `gdn_layer` measured ~0.028 ms - including `gdn_gate`, which processes FORTY-EIGHT elements, and a kernel\n   134\t/// cannot execute for 28 us.  That is what a null-stream launch costs on this driver, and `gdn_layer` makes ~19\n   135\t/// of them while a block makes ~45.  Replaying the 43-node block graph measured **1.585 ms against 2.393 ms**\n   136\t/// for the same work as direct launches - a 1.51x that is pure launch overhead.\n   137\tstruct SessionGraphs {\n   138\t    cudaGraphExec_t* execs = nullptr;   ///< one per layer, in layer order\n   139\t    int64_t n = 0;\n   140\t    /// **THE SECOND GRAPH PER LAYER: `moe_finish` + `gr_write`, launched AFTER the host has run the pool.**\n   141\t    ///\n   142\t    /// Without it the loop has to hand layer `l`'s expert vectors to layer `l+1`, which multiplies them by\n   143\t    /// layer `l+1`'s router weights - see `layer.hpp`'s note on `moe_route`.  With it, `post[l]` is launched\n   144\t    /// after the pool returns, so layer `l`'s experts are combined with layer `l`'s weights.\n   145\t    ///\n   146\t    /// The cost is the overlap, and it is worth stating: the window is now whatever GPU work follows the ring\n   147\t    /// inside `pre[l]` - the shared expert, and nothing else, because everything after the combine depends on\n   148\t    /// `parts`.  **A per-layer CPU pool cannot be hidden behind a strictly serial residual chain**, which is\n   149\t    /// why the CPU term is answered by Phase 3's VRAM cache and not by this pipeline.\n   150\t    cudaGraphExec_t* posts = nullptr;\n   151\t    bool captured = false;\n   152\t    /// THE DEVICE ADDRESS THE GRAPHS WERE CAPTURED WITH.  The host loop copies each layer's expert outputs\n   153\t    /// here before launching the next layer, and a graph bakes the POINTER, so it has to be this one.\n   154\t    float* parts_dev = nullptr;\n   155\t\n   156\t    /// **DIAGNOSTIC, AND IT IS THE ONE THAT SAYS WHETHER THE DOORBELL IS DECORATIVE.**\n   157\t    ///\n   158\t    /// Counts the layers where the ring was observed while the graph was STILL RUNNING - i.e. the layers where\n   159\t    /// the pool actually had a window to work in.  A nonzero `h_seq` read at the same moment\n   160\t    /// `cudaEventQuery` returns `cudaSuccess` means the layer was already over, and the pool then runs with the\n   161\t    /// GPU IDLE, which makes the whole pipeline equivalent to a serialised one.\n   162\t    ///\n   163\t    /// That distinction is invisible in the loop's RETURN VALUE - both paths produce a correct token - and it\n   164\t    /// is invisible in a per-layer timing, because the layer still takes the same time either way.  It shows up\n   165\t    /// only as \"the overlap hides nothing\", which is why it is counted here.\n   166\t    int64_t rings_mid_graph = 0;\n   167\t\n   168\t    /// **THE WINDOW, MEASURED RATHER THAN ASSUMED.**  Milliseconds from `cudaGraphLaunch` to the moment the\n   169\t    /// ring was observed, summed over the loop.  The pool's window is `layer period - this`, and that is the\n   170\t    /// entire budget the overlap has: if the CPU's per-layer work exceeds it, the GPU goes idle for the\n   171\t    /// difference on every layer and a \"pipelined\" loop measures the same as a serialised one.\n   172\t    ///\n   173\t    /// It is NOT the same as the doorbell's position inside the graph.  It includes the launch itself, the\n   174\t    /// driver's submission, and however long the host took to notice - all of which are real and none of which\n   175\t    /// the pool gets to use.\n   176\t    double ms_to_ring = 0;\n   177\t\n   178\t    // ================================ R0.9: THE LAYER AS THREE GRAPHS ================================\n   179\t    //\n   180\t    // **THE CAPTURED PER-STAGE TABLE THE PROTOCOL HAS DEMANDED SINCE R0 AND NOBODY HAS HAD.**  Round 309's\n   181\t    // came from `--no-capture`, and round 312 showed its `moe_finish` figure was a host-gap artefact four\n   182\t    // times the captured cost of the same work - so the plan has been choosing between R3.3, R3.4 and R3.5\n   183\t    // without knowing what any of them is worth.\n   184\t    //\n   185\t    // An event recorded BETWEEN two `cudaGraphLaunch` calls is not inside a capture and is therefore valid,\n   186\t    // so the layer is captured at its own documented seam (`block_layer_pre`'s `half`) and timed from outside.\n   187\t    /// **R0.11: FIVE PREFIX GRAPHS, ADDED BESIDE `preA`/`preB` RATHER THAN REPLACING THEM.**\n   188\t    /// `preP[k]` (k = 1..5) runs stages `0..k-1`. Consecutive differences are the per-stage times, which is\n   189\t    /// what prices the two `gr_read`s and the `gr_write` (R3.3) against GDN's interior (R3.4). A prefix and not\n   190\t    /// a range, because the stages are a chain: stage 1 reads what stage 0 wrote and stage 2 mutates the\n   191\t    /// residual in place.\n   192\t    ///\n   193\t    /// **THE FIFTH PREFIX USED TO BE `execs[l]`, AND THAT WAS THE BUG ROUND 324 COULD NOT FIND.**  Prefix 5\n   194\t    /// has ~7 more nodes than prefix 4, so the two differ in launch setup as well as in execution - and the\n   195\t    /// difference attributed ALL of it to stage 4, the router. Capturing prefix 5 the same way as the others\n   196\t    /// makes the two comparable and the difference purely stage 4's.\n   197\t    cudaGraphExec_t* preP[5] = {nullptr, nullptr, nullptr, nullptr, nullptr};\n   198\t    cudaGraphExec_t* preA = nullptr;   ///< `half == 1`: gr_read -> attention -> gr_write   (the MIXER)\n   199\t    cudaGraphExec_t* preB = nullptr;   ///< `half == 2`: gr_read -> moe_route              (FFN front + ROUTER)\n   200\t    bool split_captured = false;\n   201\t\n   202\t    /// How many times `session_loop` has run.  `rings_mid_graph` and `ms_to_ring` are CUMULATIVE and the loop\n   203\t    /// is called once per token, so anything reporting a ratio needs this - and prefill runs the loop too, so\n   204\t    /// \"per generated token\" is the wrong denominator.\n   205\t    int64_t calls_total = 0;\n   206\t\n   207\t    /// **WHERE THE PER-LAYER ROUND TRIP GOES, AND `ms_to_ring` ALONE CANNOT SAY.**\n   208\t    ///\n   209\t    /// `--no-pool` measures **38.73 ms/token against a 26.32 ms pure-GPU floor**, so ~12.4 ms/token - a quarter\n   210\t    /// of the token - is spent in the loop with no expert work at all: 0.258 ms per layer. `ms_to_ring` covers\n   211\t    /// only the first half of that; it stops when the ring is seen, and everything the host then does before\n   212\t    /// the next `pre` is launched is invisible to it.\n   213\t    ///\n   214\t    /// So the round trip is split at the ring, and **`ms_to_ring` above IS the first half** - do not add a\n   215\t    /// second counter for it:\n   216\t    ///\n   217\t    ///   * `ms_to_ring` - launch -> ring observed. The GPU is working (or already finished) here.\n   218\t    ///   * `ms_host`    - ring observed -> `pre[l+1]` launched. **The GPU has nothing queued and is IDLE for\n   219\t    ///                    all of this unless `pre[l]`'s tail still covers it.** This is\n   220\t    ///                    `cudaMemcpyAsync(parts)` + `cudaGraphLaunch(post[l])` + `cudaGraphLaunch(pre[l+1])` +\n   221\t    ///                    `cudaEventRecord`, and if it is the large half then the fix is fewer driver calls\n   222\t    ///                    (R2.4), not a faster kernel.\n   223\t    ///\n   224\t    /// Cumulative, like `ms_to_ring`; divide by `calls_total * n_layers`.\n   225\t    double ms_host = 0;\n   226\t};\n   227\t\n   228\t/// Captures all 48 layer graphs.  Idempotent: a second call is a no-op.\n   229\t///\n   230\t/// `pos`/`pos_base` are baked in ONLY through the fixed-address pinned staging in each `QsaState`, which the\n   231\t/// replay re-reads every token - so the position is data, not an argument.  That is the whole reason rounds\n   232\t/// 211-214 moved the per-token counts into device buffers.\n   233\tbool session_capture(const WeightTable& tables, const ModelGeometry& g, SessionState& s, const float* parts,\n   234\t                     SessionGraphs& gr, std::string& err, bool split = false, int64_t layer_lo = 0,\n   235\t                     int64_t layer_hi = -1);\n   236\t\n   237\t/// One token by REPLAYING the captured graphs.  Identical arithmetic to `session_token`; the only difference is\n   238\t/// that ~2,000 kernel launches become 48 graph launches.\n   239\tbool session_replay(const ModelGeometry& g, int64_t pos, int32_t pos_base, SessionState& s, SessionGraphs& gr,\n   240\t                    void* stream, std::string& err);\n   241\t\n   242\t/// One token by replaying BOTH halves of every layer - `pre[l]` and `post[l]` - with no pool running.\n   243\t///\n   244\t/// **THIS IS THE TRUE PER-TOKEN GPU FLOOR, AND `session_replay` IS NOT.**  `session_replay` launches only\n   245\t/// `gr.execs[l]`, the `pre` graphs, so it omits the 48 `post` graphs (shared expert, combine, second `gr_write`)\n   246\t/// entirely - and everything published as \"39.8 ms pure GPU\" came from it while being described as the whole\n   247\t/// GPU.  See `Memory/ERRORS.md` A4.\n   248\t///\n   249\t/// `parts` is left at whatever the buffer holds, because no pool writes it; that is deliberate and makes the\n   250\t/// measurement pure GPU work.  The LM head is NOT included here - the caller times it separately, since it runs\n   251\t/// on the host-side path rather than inside a captured graph.\n   252\tbool session_replay_full(const ModelGeometry& g, int64_t pos, int32_t pos_base, SessionState& s,\n   253\t                         SessionGraphs& gr, void* stream, std::string& err);\n   254\t\n   255\t/// **ONE TOKEN THROUGH THE SPLIT GRAPHS, WITH EVERY STAGE TIMED FROM OUTSIDE THE CAPTURE.**  Requires\n   256\t/// `session_capture(..., split = true)`.  Replays `preA[l]`, `preB[l]`, `post[l]` in order on one stream -\n   257\t/// the same order `session_loop` uses - and reports the three totals in milliseconds for the whole token.\n   258\t///\n   259\t/// The stages are ordered by the stream, so an event pair around each launch measures that launch's GPU work\n   260\t/// plus the gap the driver left before it.  That gap is real and is why the three totals sum slightly above\n   261\t/// `session_replay_full`; the comparison is printed by the caller rather than hidden here.\n   262\t/// **R0.11: THE FIVE STAGES SEPARATELY, BY DIFFERENCING PREFIXES.**  `stage_ms` is resized to 5 and holds\n   263\t/// stages 0..4 in milliseconds for a whole token; `mixer_per_layer` holds prefix 3's time for each layer, which\n   264\t/// is what R0.10's GDN-versus-QSA split needs.  Requires `session_capture(..., split = true)`.\n   265\t///\n   266\t/// **THE RESIDUAL IS SAVED AND RESTORED BETWEEN PREFIXES.**  Stage 2 is `gr_write`, which mutates `R` in\n   267\t/// place, so without the restore every prefix after the first reads a residual the earlier ones already\n   268\t/// advanced - and every number after the first would be measuring a different tensor while looking correct.\n   269\tbool session_replay_stage_prefixes(const ModelGeometry& g, int64_t pos, int32_t pos_base, SessionState& s,\n   270\t                                   SessionGraphs& gr, void* stream, std::vector<double>& stage_ms,\n51:uint64_t session_bytes(const ModelGeometry& g, int64_t max_cells, int64_t k, int64_t layer_lo, int64_t layer_hi) {\n72:uint64_t session_init(const ModelGeometry& g, int64_t max_cells, int64_t k, void* base, SessionState& s,\n122:    // `session_zero`; it survives every token, which is the whole point of a conv history.\n128:void session_release(SessionState& s) {\n139:void window_reset(const strata::core::SessionState* ss);   // metal/src/engine/window.cpp: that session's running state (the main one or a batch slot's) back to a new sequence's\n144:void session_zero(SessionState& s, const ModelGeometry& g, const float* R_init, void* stream) {\n148:    strata::metal_engine::window_reset(&s);\n170:    // so a stale one is a real contribution and not a zero.  The token window resets to `NG_HIST`-many nulls\n200:bool session_capture(const WeightTable& tables, const ModelGeometry& g, SessionState& s, const float* parts,\n234:                err = std::string(\"session_capture: stream create failed\");\n238:                err = \"session_capture: begin failed at layer \" + std::to_string(l);\n250:                err = \"session_capture: \" + std::string(what) + \" layer \" + std::to_string(l) + \": \" + err;\n257:                err = \"session_capture: \" + std::string(what) + \" layer \" + std::to_string(l) + \": \" +\n262:                err = \"session_capture: instantiate failed at layer \" + std::to_string(l);\n287:bool session_replay(const ModelGeometry& g, int64_t pos, int32_t pos_base, SessionState& s, SessionGraphs& gr,\n289:    if (!gr.captured || gr.n != g.n_layers) { err = \"session_replay: not captured\"; return false; }\n295:            err = \"session_replay: layer \" + std::to_string(l) + \": \" + cudaGetErrorString(e);\n302:bool session_replay_full(const ModelGeometry& g, int64_t pos, int32_t pos_base, SessionState& s,\n305:        err = \"session_replay_full: not captured with post graphs\";\n311:        // `pre[l]` then `post[l]`, in the order `session_loop` uses.  The two are ordered on one stream, and\n315:            err = \"session_replay_full: pre[\" + std::to_string(l) + \"]: \" + cudaGetErrorString(e);\n320:            err = \"session_replay_full: post[\" + std::to_string(l) + \"]: \" + cudaGetErrorString(e);\n327:bool session_replay_stages_per_layer(const ModelGeometry& g, int64_t pos, int32_t pos_base, SessionState& s,\n331:        err = \"session_replay_stages: not captured with the split\";\n343:        if (cudaEventCreate(&e) != cudaSuccess) { err = \"session_replay_stages: event create\"; return false; }\n374:bool session_replay_stages(const ModelGeometry& g, int64_t pos, int32_t pos_base, SessionState& s,\n378:    if (!session_replay_stages_per_layer(g, pos, pos_base, s, gr, stream, per, ms_ffn, ms_post, err)) return false;\n384:bool session_replay_stage_sweep(const ModelGeometry& g, int64_t pos, int32_t pos_base, SessionState& s,\n387:        err = \"session_replay_stage_sweep: not captured with the split\";\n390:    if (k < 1 || k > 5) { err = \"session_replay_stage_sweep: k must be 1..5\"; return false; }\n396:        err = \"session_replay_stage_sweep: event create\";\n405:            err = std::string(\"session_replay_stage_sweep: launch: \") + cudaGetErrorString(e);\n413:        err = \"session_replay_stage_sweep: sync\";\n424:bool session_replay_stage_prefixes(const ModelGeometry& g, int64_t pos, int32_t pos_base, SessionState& s,\n428:        err = \"session_replay_stage_prefixes: not captured with the split\";\n438:        err = \"session_replay_stage_prefixes: could not save the residual\";\n447:        err = \"session_replay_stage_prefixes: event create\";\n467:                err = std::string(\"session_replay_stage_prefixes: launch prefix \") + std::to_string(k) + \": \" +\n496:void session_graphs_free(SessionGraphs& gr) {\n587:bool session_loop(const ModelGeometry& g, int64_t pos, int32_t pos_base, SessionState& s, SessionGraphs& gr,\n590:    if (!gr.captured || gr.n != g.n_layers) { err = \"session_loop: not captured\"; return false; }\n591:    if (gr.parts_dev == nullptr) { err = \"session_loop: the graphs were captured without a parts buffer\"; return false; }\n592:    if (s.db == nullptr) { err = \"session_loop: no doorbell; the loop has nothing to poll\"; return false; }\n604:    // replay, and those hold whatever was last written there.  `session_capture` left them at position 0.\n608:    // value, and that is exactly why the buffers are pinned and fixed.\"  `session_replay` calls `s