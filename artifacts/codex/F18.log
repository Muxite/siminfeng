llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, llm_graph_type gtype, llama_memory_context_i * mctx, ggml_status & ret) {
    if (mctx && !mctx->apply()) {
        LLAMA_LOG_ERROR("%s: failed to apply memory context\n", __func__);
        ret = GGML_STATUS_FAILED;
        return nullptr;
    }

    auto * res = get_gf_res_prev();
    auto * gf  = res->get_gf();

#ifdef __linux__
    expert_fill_init();
    expert_fill_phase(ubatch.n_tokens);
    if (expert_fill_enabled && !expert_fill_failed && expert_fill_this_ubatch) { expert_demand_tokens += ubatch.n_tokens; }
    if (expert_pregate_enabled) {
        // Layer numbers restart for every ubatch; retire previous-token backlog.
        for (auto & entry : expert_fillers) { entry.second->cancel_async_through(SIZE_MAX); }
        for (auto & layer : expert_pregate_layers) {
            layer.predicted.clear();
            for (auto & predictions : layer.predictions) { predictions.clear(); }
        }
    }
    if (!expert_config.fill && expert_config.prefetch && expert_prefetch_layers.empty()) {
        expert_prefetch_layers.resize(model.layers.size());
        expert_prefetch_next = expert_config.prefetch_next;
        LLAMA_LOG_INFO("expert_prefetch: CPU host-consumer hook enabled; device-only experts skipped, next=%d, LRU=32 ids/32 tokens\n", expert_prefetch_next);
    }
