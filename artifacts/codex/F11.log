\"\"\"Read-only stdlib live monitor. No model calls, reconciliation or Store initialization.\"\"\"
from contextlib import closing
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
from pathlib import Path
import shutil
import sqlite3
import tempfile
from urllib.parse import parse_qs, urlsplit
from .redact import sanitize
from .story import load_source, build_events, ACTIVE
from .telemetry import home_path, read_events


def tasks(home):
    # Copy WAL and DB using the same stable read discipline as story.
    paths = [home / 'factory.sqlite', home / 'factory.sqlite-wal']
    if not paths[0].exists():
        return []
    def stamps():
        return [(p.stat().st_size, p.stat().st_mtime_ns) if p.exists() else None for p in paths]
    for _ in range(5):
        before = stamps()
        with tempfile.TemporaryDirectory(prefix='factory-monitor-') as directory:
            for p in paths:
                if p.exists():
                    shutil.copyfile(p, Path(directory) / p.name)
            if before "'!= stamps():
                continue
            with closing(sqlite3.connect(Path(directory) / '"'factory.sqlite')) as db:
                db.row_factory = sqlite3.Row
                return [dict(row) for row in db.execute('SELECT task_id,objective,created FROM tasks ORDER BY created DESC')]
    raise ValueError('Store changed during read; retry')


def engine_stack(data):
    task = data['tasks'][0]
    base = dict(name=task.get('source', {}).get('pre_integration_commit') or 'Base engine', state='base', ms_per_token=None)
    stack = [base]
    # Applied patch order is host-observed, not guessed from objective prose.
    for obs in sorted(data.get('observations', []), key=lambda x: x.get('created', 0)):
        values = obs.get('values', {})
        for component in values.get('source', {}).get('applied_patches', []):
            name = component.get('name', component.get('id', 'component')) if isinstance(component, dict) else str(component)
            if not any(r['name'] == name for r in stack):
                stack.append(dict(name=name, state='integrating', ms_per_token=None))
    if len(stack) == 1 and task.get('component_cc'):
        stack.append(dict(name=task['component_cc'], state='integrating', ms_per_token=None))
    # Correlate measurements via lab admission -> build -> recorded source patches.
    for attempt in data.get('attempts', []):
        if attempt['kind'] == 'build' and attempt['state'] == 'succeeded':
            patches = attempt.get('request', {}).get('source', {}).get('applied_patches', [])
            names = [p.get('name') if isinstance(p, dict) else p for p in patches]
            for row in stack[1:]:
                if row['name'] in names or (not names and len(stack) == 2):
                    row['state'] = 'built'
    for obs in sorted(data.get('observations', []), key=lambda x: x.get('created', 0)):
        values = obs.get('values', {})
        speed = values.get('details', {}).get('eval_ms_per_token')
        if speed is None:
            continue
        aid = obs.get('host_run', {}).get('attempt_id')
        lab = next((a for a in data.get('attempts', []) if a['attempt_id'] == aid), {})
        bid = lab.get('request', {}).get('admission', {}).get('build_attempt_id')
        build = next((a for a in data.get('attempts', []) if a['attempt_id'] == bid), {})
        patches = build.get('request', {}).get('source', {}).get('applied_patches')
        names = [p.get('name') if isinstance(p, dict) else p for p in (patches or [])]
        target = next((r for r in reversed(stack) if r['name'] in names), None)
        if target is None:
            target = base if patches == [] else (stack[-1] if len(stack) == 2 else None)
        if target:
            target.update(state='measured', ms_per_token=speed)
    for decision in sorted(data.get('decisions', []), key=lambda d: d['rev']):
        action = decision.get('action', {})
        kind = action.get('type')
        name = action.get('component', action.get('component_cc'))
        target = next((r for r in stack if r['name'] == name), stack[-1] if len(stack) == 2 else None)
        if target and kind in {'accept', 'keep', 'reject', 'revert'}:
            target['state'] = 'kept ✓' if kind in {'accept', 'keep'} else 'reverted ✗'
    for row in stack:
        row['speedup'] = base['ms_per_token'] / row['ms_per_token'] if base['ms_per_token'] and row['ms_per_token'] else None
    return stack


def job(home, attempt_id):
    for task in tasks(home):
        data = load_source(task['task_id'], home)
        for attempt in data.get('attempts', []):
            if attempt['attempt_id'] "'!= attempt_id:
                continue
            log = []
            resources = attempt.get('"'resources', {})
            qdir = resources.get('jobq_dir')
            jid = attempt.get('jobq_id')
            if qdir and jid and Path(jid).name == jid:
                root = Path(qdir).resolve()
                # jobq's log lives beside the durable job record.
                for candidate in (root / (jid + '.log'), root / 'logs' / (jid + '.log')):
                    if candidate.is_file() and candidate.resolve().is_relative_to(root):
                        from collections import deque
                        with candidate.open(errors='replace') as stream:
                            log = list(deque(stream, maxlen=20))
                        break
            return dict(attempt=attempt, state=attempt['state'], log=[line.rstrip('\\n') for line in log])
    raise ValueError('Attempt not found')


def make_server(home=None, bind='127.0.0.1', port=8787):
    home = home_path(home)
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def do_GET(self):
            url = urlsplit(self.path)
            query = parse_qs(url.query)
            def arg(key):
                return query.get(key, [''])[0]
            try:
                if url.path == '/':
                    body, mime = HTML.encode(), 'text/html; charset=utf-8'
                else:
                    if url.path == '/api/tasks':
                        value = tasks(home)
                    elif url.path == '/api/story':
                        data = load_source(arg('task'), home)
                        value = dict(events=build_events(data), task=data['tasks'][0], meta=data['_meta'],
                                     engine_stack=engine_stack(data), latest_decision=max(data.get('decisions', []), key=lambda d: d['rev'], default=None),
                                     active_jobs=[a for a in data.get('attempts', []) if a['state'] in ACTIVE])
                    elif url.path == '/api/telemetry':
                        value = read_events(home, arg('task') or None, arg('since'))
                    elif url.path == '/api/job':
                        value = job(home, arg('attempt'))
                    else:
                        self.send_error(404)
                        return
                    body, mime = json.dumps(sanitize(value), ensure_ascii=False).encode(), 'application/json; charset=utf-8'
                self.send_response(200)
                self.send_header('Content-Type', mime)
                self.send_header('Content-Length', str(len(body)))
                self.send_header('Cache-Control', 'no-store')
                self.end_headers()
                self.wfile.write(body)
            except (ValueError, OSError, sqlite3.Error, KeyError) as exc:
                body = json.dumps(dict(error=sanitize(str(exc)))).encode()
                self.send_response(400)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Content-Length', str(len(body)))
                self.end_headers()
                self.wfile.write(body)
    return ThreadingHTTPServer((bind, port), Handler)


def serve(home=None, bind='127.0.0.1', port=8787):
    with make_server(home, bind, port) as server:
        print(f'Factory monitor listening on {server.server_address[0]}:{server.server_address[1]}', flush=True)
        try:
            server.serve_forever()
