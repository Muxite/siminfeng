"""Inventory declarations using the CC-v2 loader and validator."""
from pathlib import Path

from jiuwenswarm.ccv2.ccv2 import load, tree_files
from .story import paint, wrap


def capsule_rows(root=None):
    root = Path(root) if root else Path(__file__).parent / 'ccs'
    rows = []
    for path in sorted(root.rglob('cc.yaml')):
        declaration = load(path)
        caps = declaration.get('capabilities', {})
        rows.append(dict(id=declaration['id'], version=declaration['version'],
                         binding=','.join(sorted({b['kind'] for b in declaration.get('bindings', {}).values()})) or 'material-only',
                         materials={k: v.get('kind', 'reference') for k, v in declaration.get('materials', {}).items()}, capabilities=list(caps), changes=sorted({e for c in caps.values() for e in c.get('changes', [])}),
                         files=len(tree_files(path.parent)), lines=len(path.read_text().splitlines()), valid=True))
    return rows


def format_capsules(rows, plain=False):
    lines = ['ID                          VERSION BINDING        FILES YAML VALID', '─' * 99]
    for row in rows:
        lines.extend(wrap(f"{row['id']:27} {row['version']:7} {row['binding']:14} "
                          f"{row['files']:5} {row['lines']:4} ✓ valid"))
        lines.extend(wrap('capabilities: ' + (', '.join(row['capabilities']) or '·'), '  '))
        lines.extend(wrap('materials: ' + (', '.join(f'{k} ({v})' for k, v in row.get('materials', {}).items()) or '·'), '  '))
        lines.extend(wrap('changes: ' + (', '.join(row['changes']) or '·'), '  '))
    lines.extend(wrap(f"{len(rows)} capsules · {sum(len(r['capabilities']) for r in rows)} capabilities · "
                      f"{sum(r['lines'] for r in rows)} lines of cc.yaml · 0 adapters"))
    return '\n'.join(paint(line, plain) for line in lines)
"""Translate capsule capability names to the task-scoped factory native API."""
import json
import os
import subprocess
import sys

from jiuwenswarm.factory.telemetry import set_turn_env
set_turn_env()

PREFIX = 'builder'
packet = json.load(sys.stdin)
cap = packet['capability']
packet['capability'] = PREFIX + '.' + cap
try:
    process = subprocess.run([os.environ.get('FACTORY_PYTHON', sys.executable), '-m', 'jiuwenswarm.factory.api', packet['capability']],
                             input=json.dumps(packet), capture_output=True, text=True, timeout=49)
    result = json.loads(process.stdout)
except subprocess.TimeoutExpired:
    result = {'outcome': 'error', 'error': {'code': 'TIMEOUT', 'message': 'Factory API exceeded the bounded call deadline'}}
except (ValueError, TypeError):
    # Surface the cause to the agent: the last stderr lines (the API redacts its own messages).
    detail = ' | '.join(process.stderr.strip().splitlines()[-3:])[-600:] if process.stderr else 'no stderr'
    result = {'outcome': 'error', 'error': {'code': 'API_FAILED',
              'message': 'Factory API did not return a JSON result: ' + detail}}
if PREFIX == 'lab' and result.get('error', {}).get('code') == 'INVALID_INPUT':
    # F06 installs lab.* dispatch. Until then the evidence API rejects it.
    result = {'outcome': 'error', 'error': {'code': 'NOT_IMPLEMENTED', 'message': 'Lab API is not installed'}}
if result.get('outcome') == 'ok':
    outputs = result['outputs']
    if PREFIX == 'evidence' and cap in {'read', 'publish'}:
        result['outputs'] = {'record': outputs}
    elif PREFIX in {'builder', 'lab'}:
        if cap == 'submit':
            result['outputs'] = {k: outputs[k] for k in ('attempt_id', 'state', 'jobq_id')}
print(json.dumps(result))
