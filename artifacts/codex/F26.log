                if operation == 'supersede':
                    by = identifier(change['by'])
                    if by == key or by not in nodes or nodes[by]['state'] in TERMINAL:
                        raise ValueError('Superseding node must exist and be active')
                    node['superseded_by'] = by
    _validate(nodes)


def _view(task_id, rev, nodes, history):
    ready, blocked = [], {}
    for key, node in nodes.items():
        if node['state'] in TERMINAL | {'done'}:
            continue
        reasons = [f"dependency {dep} is {nodes[dep]['state']}" for dep in node['depends_on'] if nodes[dep]['state'] != 'done']
        if node['state'] in {'blocked', 'failed'}:
            reasons.append(node['reason'] or node['state'])
        if reasons:
            blocked[key] = reasons
        elif node['state'] in {'proposed', 'ready'}:
            ready.append(key)
    return dict(schema='factory.taskgraph/1', task_id=task_id, rev=rev,
                nodes=list(nodes.values()), ready_frontier=ready,
                blocked_reasons=blocked, history=history)


def replay(task_id, history, rev=None):
    """Reconstruct a graph solely from committed patch records."""
    history = sorted(json.loads(encoded(history)), key=lambda h: h['rev'])
    if rev is None:
        rev = history[-1]['rev'] if history else 0
    _revision(rev)
    if rev > (history[-1]['rev'] if history else 0):
        raise NotFound('Plan revision not found')
    nodes, applied = {}, []
    for entry in history:
        if entry['rev'] > rev:
            break
        if entry['parent_rev'] != len(applied) or entry['rev'] != len(applied) + 1:
            raise ValueError('Noncontiguous plan history')
        _apply(nodes, entry['patch'], entry['decision_rev'])
        applied.append(entry)
    return _view(task_id, rev, nodes, applied)


def from_records(data, rev=None):
    """Works with Store dumps, read-only story snapshots and exported bundles."""
    task_id = data['tasks'][0]['task_id']
    history = [r['values'] for r in data.get('observations', []) if r['kind'] == KIND]
    return replay(task_id, history, rev)


def _host(store, task_id, write=False):
    if hasattr(store, '_check'):
        store._check(task_id, write=write)
        return store._store
def to_json(graph):
    """Detached JSON-compatible object shared by native CCs and the monitor."""
    return json.loads(encoded(graph))


def render_text(graph):
    lines = [f"Plan {graph['task_id']} · graph rev {graph['rev']}"]
    depths = {}
    pending = list(graph['nodes'])
    while pending:
        remaining = []
        for node in pending:
            if any(dep not in depths for dep in node['depends_on']):
                remaining.append(node)
                continue
            depth = max((depths[d] + 1 for d in node['depends_on']), default=0)
            depths[node['node_id']] = depth
            lines.append('  ' * depth + f"[{node['state']}] {node['node_id']}: {node['title']}" +
                         (f" ({node['capability']})" if node['capability'] else ''))
            for reason in graph['blocked_reasons'].get(node['node_id'], []):
                lines.append('  ' * (depth + 1) + reason)
        pending = remaining
    lines.append('Ready frontier: ' + (', '.join(graph['ready_frontier']) or '(empty)'))
    lines.append('Revision history:')
    for entry in graph['history']:
        changes = '; '.join(f"{op}: " + ', '.join(n['node_id'] for n in values) for op, values in entry['patch'].items() if values)
        lines.append(f"  graph {entry['rev']} ← decision {entry['decision_rev']} ({entry['origin']}): {changes}")
    return '\n'.join(lines)


def to_dot(graph):
    quote = lambda value: json.dumps(value, ensure_ascii=False)
    lines = ['digraph factory_plan {']
    for node in graph['nodes']:
        label = f"{node['node_id']} [{node['state']}]\n{node['title']}"
        lines.append(f'  {quote(node["node_id"])} [label={quote(label)}];')
        for dep in node['depends_on']:
            lines.append(f'  {quote(dep)} -> {quote(node["node_id"])};')
        if node.get('superseded_by'):
            lines.append(f'  {quote(node["node_id"])} -> {quote(node["superseded_by"])} [style=dashed,label="superseded"];')
    for entry in graph['history']:
        changes = ', '.join(f'{op} ' + '/'.join(n['node_id'] for n in values) for op, values in entry['patch'].items() if values)
        lines.append('  // ' + quote(f"graph {entry['rev']} decision {entry['decision_rev']}: {changes}"))
import json
import threading
import pytest
from urllib.request import urlopen
from jiuwenswarm.factory.monitor import make_server, HTML
from jiuwenswarm.factory.telemetry import emit


def test_monitor_endpoints(store):
    attempt = store.create_attempt('t', dict(kind='build', request={}, idem_key='k', fingerprint='f'))
    emit(store.home, 'cc.call', 't', capability='evidence.query', duration_ms=1)
    before = sorted(str(p.relative_to(store.home)) for p in store.home.rglob('*'))
    try:
        server = make_server(store.home, port=0)
    except PermissionError:
        pytest.skip('Environment prohibits socket creation; HTTP test requires loopback sockets')
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    def get(path):
        with urlopen(f'http://127.0.0.1:{server.server_port}' + path, timeout=10) as response:
            return response.read()
    try:
        assert b'<h2>Engine</h2>' in get('/')
        tasks = json.loads(get('/api/tasks'))
        assert tasks[0]['task_id'] == 't'
        story = json.loads(get('/api/story?task=t'))
        assert isinstance(story['events'], list)
        assert story['task']['objective'] == 'offline build'
        assert isinstance(story['engine_stack'], list)
        assert json.loads(get('/api/telemetry?task=t&since=0'))[-1]['capability'] == 'evidence.query'
        job = json.loads(get('/api/job?attempt=' + attempt['attempt_id']))
        assert job['state'] == 'queued' and job['log'] == []
        assert sorted(str(p.relative_to(store.home)) for p in store.home.rglob('*')) == before
    finally:
        server.shutdown()
        server.server_close()
        thread.join()
    assert 'http://' not in HTML and 'https://' not in HTML
    assert 'innerHTML' not in HTML


def test_monitor_models_and_scrubbed_tail(store, tmp_path):
    from jiuwenswarm.factory.monitor import tasks, job, engine_stack
    from jiuwenswarm.factory.story import load_source
    qdir = tmp_path / 'queue'
    qdir.mkdir()
    a = store.create_attempt('t', dict(kind='build', request={}, idem_key='k', fingerprint='f', jobq_id='job-x', resources=dict(jobq_dir=str(qdir))))
    (qdir / 'job-x.log').write_text('\n'.join(str(n) for n in range(25)))
    assert len(job(store.home, a['attempt_id'])['log']) == 14
    assert tasks(store.home)[0]['task_id'] == 't'
    assert engine_stack(load_source('t', store.home))[0]['state'] == 'base'


def wire_get(home, path):
    """Exercise the actual HTTP handler without sockets in restricted sandboxes."""
    import io
    from types import SimpleNamespace
    from jiuwenswarm.factory.monitor import make_handler
    class Connection:
        def __init__(self):
            self.response = bytearray()
        def makefile(self, *args):
            return io.BytesIO(('GET ' + path + ' HTTP/1.0\r\nHost: localhost\r\n\r\n').encode())
        def sendall(self, data):
            self.response.extend(data)
    connection = Connection()
    make_handler(home)(connection, ('127.0.0.1', 1), SimpleNamespace())
    headers, body = bytes(connection.response).split(b'\r\n\r\n', 1)
    assert b'200 OK' in headers, bytes(connection.response)
    return body


def test_http_handler_without_network(store):
    from jiuwenswarm.factory.story import build_events, load_source
    a = store.create_attempt('t', dict(kind='build', request={}, idem_key='k', fingerprint='f'))
    assert b'<h2>Engine</h2>' in wire_get(store.home, '/')
    assert json.loads(wire_get(store.home, '/api/tasks'))[0]['task_id'] == 't'
    story = json.loads(wire_get(store.home, '/api/story?task=t'))
    assert story['events'] == build_events(load_source('t', store.home))
    assert isinstance(json.loads(wire_get(store.home, '/api/telemetry?task=t')), list)
    assert json.loads(wire_get(store.home, '/api/job?attempt=' + a['attempt_id']))['state'] == 'queued'

