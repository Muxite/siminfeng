"""MCP front door for agents: discover, read, call, start and stop CCs in a folder.

One stdio server per agent session. It wraps one `Host` (so receipts, call keys
and instance records persist in `--store`) and one folder of CC packages
(`--ccs DIR`, each child holding a `cc.yaml`).

Authority comes only from `--grant` flags and `--workspace`; an agent cannot
widen them. Reading a material never grants execution.
"""
from __future__ import annotations

import argparse
import atexit
import functools
import json
import uuid
from pathlib import Path
from typing import Any

from .ccv2 import CCError, Host, callable_entries, service_entries

MAX_TEXT = 200_000


class Catalog:
    def __init__(self, ccs, store: Path, grants=(), workspace: Path | None = None):
        self.roots = [Path(c).resolve() for c in ([ccs] if isinstance(ccs, (str, Path)) else ccs)]
        self.ccs = self.roots[0]
        resources = {}
        self.workspace = Path(workspace).resolve() if workspace else None
        if workspace:
            resources['workspace'] = {'kind': 'workspace', 'path': str(Path(workspace).resolve())}
        self.host = Host(store, resources=resources, session_grants=list(grants))
        self.releases: dict[str, str] = {}
        self.errors: dict[str, dict] = {}
        self.owned: dict[str, str] = {}  # instance id -> handle, for instances this session started

    # -- discovery ---------------------------------------------------------
    def scan(self) -> list[dict]:
        self.releases.clear()
        self.errors.clear()
        entries = []
        folders = [p for root in self.roots if root.is_dir() for p in sorted(root.iterdir()) if (p / 'cc.yaml').is_file()]
        for folder in folders:
            try:
                release = self.host.prepare(folder)
                release = release['release'] if isinstance(release, dict) else release
                declaration = self.host.describe(release)
            except CCError as e:
                self.errors[folder.name] = e.record()
                entries.append({'folder': folder.name, 'usable': False, 'error': e.record()})
                continue
            if declaration['id'] in self.releases:
                err = {'code': 'DUPLICATE_ID', 'path': '', 'message': f"{declaration['id']!r} in {folder} duplicates an earlier CC; the earlier one is kept"}
                self.errors[folder.name] = err
                entries.append({'folder': folder.name, 'usable': False, 'error': err})
                continue
            self.releases[declaration['id']] = release
            entries.append(self.summary(declaration, release, folder.name))
        return entries

    @staticmethod
    def summary(declaration: dict, release: str, folder: str) -> dict:
        callable_ = callable_entries(declaration)
        services = service_entries(declaration)
        caps = {}
        for name, cap in declaration.get('capabilities', {}).items():
            caps[name] = {
                'kind': 'service' if name in services else 'finite',
                'does': cap.get('does'),
                'takes': sorted(cap.get('takes', {})),
                'gives': sorted(cap.get('gives', {})),
                'needs': cap.get('needs', []),
                'effects': cap.get('changes', []),
                'binding': (declaration['bindings'].get(cap.get('using', 'default')) or {}).get('kind'),
                'module': cap.get('kind', 'tool'),
            }
        return {
            'cc': declaration['id'], 'version': declaration['version'], 'release': release,
            'folder': folder, 'usable': True, 'capabilities': caps,
            'materials': {k: v.get('description') for k, v in declaration.get('materials', {}).items()},
            'material_kinds': {k: v.get('kind', 'reference') for k, v in declaration.get('materials', {}).items()},
            'callable': sorted(callable_), 'services': sorted(services),
        }

    def release_for(self, cc: str) -> str:
        if cc not in self.releases:
            self.scan()
        if cc not in self.releases:
            raise CCError('UNKNOWN_CC', f'{cc!r} not found in {self.ccs}; known: {sorted(self.releases)}')
        return self.releases[cc]

    def workspace_file(self, path: str) -> Path:
        root = self.workspace
        if root is None:
            raise CCError('NO_WORKSPACE', 'No workspace is configured; artifacts cannot be registered')
        target = (root / path).resolve() if not Path(path).is_absolute() else Path(path).resolve()
        if root != target and root not in target.parents:
            raise CCError('OUTSIDE_WORKSPACE', f'{path!r} is outside the workspace')
        if not target.is_file():
            raise CCError('NOT_A_FILE', f'{path!r} is not a file in the workspace')
        return target

    # -- use ---------------------------------------------------------------
    def material(self, cc: str, name: str) -> dict:
        release = self.release_for(cc)
        meta = self.host.material(release, name)
        _, bundle = self.host.release(release)
        path = Path(bundle) / meta['path']
        data = path.read_bytes()
        text = data[:MAX_TEXT].decode('utf-8', errors='replace')
        return {'cc': cc, 'material': name, 'media_type': meta.get('media_type'),
                'description': meta.get('description'), 'truncated': len(data) > MAX_TEXT, 'text': text,
                'authority': 'Reading this grants no execution authority.'}

    def start(self, cc: str, capability: str, inputs: dict | None, key: str | None) -> dict:
        instance = self.host.start(self.release_for(cc), capability, inputs or {}, key=key or str(uuid.uuid4()))
        endpoints = instance.get('endpoints') or {}
        if instance.get('state') == 'running' and endpoints:
            handle = f"env-{instance['id']}"
            self.host.resources[handle] = {'kind': 'environment', 'url': next(iter(endpoints.values())),
                                           'instance': instance['id']}
            instance = dict(instance, handle=handle)
        if instance.get('id') and instance.get('state') in {'running', 'preparing'}:
            self.owned[instance['id']] = instance.get('handle', '')
        return instance

    def stop(self, instance: str) -> dict:
        if instance not in self.owned:
            raise CCError('NOT_OWNED', f'{instance!r} was not started by this session; refusing to stop it')
        result = self.host.stop(instance)
        if result.get('state') == 'stopped':
            self.host.resources.pop(self.owned.pop(instance), None)
        return result

    def stop_all(self) -> None:
        for instance in list(self.owned):
            try:
                self.stop(instance)
            except Exception:
                pass


def build(catalog: Catalog):
    from mcp.server.fastmcp import FastMCP

    mcp = FastMCP('cc-v2')

    def guarded(fn):
        @functools.wraps(fn)  # keeps the real signature so MCP advertises the right arguments
        def run(*a, **k):
            try:
                return fn(*a, **k)
            except CCError as e:
                return {'error': e.record()}
        return run

    @mcp.tool()
    @guarded
    def cc_list() -> Any:
        """List the Capability Capsules available to this session: their capabilities (finite or service), materials, and whether each declaration is usable. Start here."""
        return {'ccs': catalog.scan(), 'folders': [str(r) for r in catalog.roots],
                'handles': {k: v['kind'] for k, v in catalog.host.resources.items()},
                'note': 'Pass a listed handle name as the value of a handle input (e.g. workspace).'}

    @mcp.tool()
    @guarded
    def cc_describe(cc: str) -> Any:
        """Full normalized declaration of one CC (ports, bindings, effects)."""
        return catalog.host.describe(catalog.release_for(cc))

    @mcp.tool()
    @guarded
    def cc_material(cc: str, material: str) -> Any:
        """Read a passive material (instructions, methodology, reference). Reading it does not authorize running anything."""
        return catalog.material(cc, material)

    @mcp.tool()
    @guarded
    def cc_artifact(path: str) -> Any:
        """Register a file inside the workspace as an artifact ({uri, sha256}) usable as an artifact input. Paths outside the workspace are refused."""
        return catalog.host.put_artifact(catalog.workspace_file(path))

    @mcp.tool()
    @guarded
    def cc_call(cc: str, capability: str, inputs: dict | None = None, key: str | None = None) -> Any:
        """Run a finite capability and return its receipt. Reuse the same `key` to retry without running twice; omit it for a fresh call. A receipt state of failed/blocked/unknown is not a success."""
        return catalog.host.call(catalog.release_for(cc), capability, inputs or {}, key=key or str(uuid.uuid4()))

    @mcp.tool()
    @guarded
    def cc_start(cc: str, capability: str, inputs: dict | None = None, key: str | None = None) -> Any:
        """Start a served capability (native process or image). Returns the instance with native endpoints and, when running, a `handle` you can pass to client CCs. Always cc_stop it when done."""
        return catalog.start(cc, capability, inputs, key)

    @mcp.tool()
    @guarded
    def cc_instance(instance: str) -> Any:
        """Inspect a started instance (state, readiness, endpoints, image identity)."""
        return catalog.host.inspect_instance(instance)

    @mcp.tool()
    @guarded
    def cc_stop(instance: str) -> Any:
        """Stop an instance this session owns and confirm it stopped. A state other than 'stopped' means stop was not confirmed."""
        return catalog.stop(instance)

    return mcp


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--ccs', required=True, action='append', help='folder containing CC packages (each with cc.yaml); repeatable')
    p.add_argument('--store', required=True)
    p.add_argument('--grant', action='append', default=[])
    p.add_argument('--workspace', help="path exposed as the 'workspace' handle")
    p.add_argument('--allow-built', action='append', default=[], help='extra CC folder the agent may write into; its CCs run with the same grants as trusted ones')
    a = p.parse_args(argv)
    catalog = Catalog([Path(c) for c in a.ccs + a.allow_built], Path(a.store), a.grant, Path(a.workspace) if a.workspace else None)
    atexit.register(catalog.stop_all)
    try:
        build(catalog).run()
    finally:
        catalog.stop_all()


if __name__ == '__main__':
    main()
"""Bounded Git-change materializer, separate from runtime dispatch."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import time
import uuid


def _materialize(host, template, change, output, *, trusted_build=False, timeout=120, core=None, attempt=None, persist=None):
    """Build in a new checkout; never applies a candidate to the caller's repository."""
    if core is None:
        from . import ccv2 as core
    core.require(trusted_build is True, 'BUILD_AUTHORIZATION_REQUIRED', 'Source builds execute repository code; authorize --trusted-build')
    core.fields(change, {'format', 'repository', 'base', 'patch', 'tree', 'build'}, {'format', 'repository', 'base', 'patch', 'tree', 'build'})
    core.require(change['format'] == 'cc-source-change/1', 'UNSUPPORTED_SOURCE_FORMAT', 'Expected cc-source-change/1')
    import re
    core.require(all(isinstance(change[k], str) and re.fullmatch('[0-9a-f]{40}', change[k]) for k in ('base', 'tree')), 'MUTABLE_SOURCE', 'Base commit and expected Git tree must be full immutable IDs')
    core.require(isinstance(change['repository'], str) and change['repository'], 'MISSING_MATERIAL', 'Repository locator required')
    build = change['build']
    core.fields(build, {'command', 'lock', 'output'}, {'command', 'output'})
    core.require(isinstance(build['command'], list) and build['command'] and all(isinstance(a, str) and a for a in build['command']), 'INVALID_RECIPE', 'Build command must be an argument vector')
    core.require(isinstance(timeout, (int, float)) and not isinstance(timeout, bool) and 0 < timeout <= 3600, 'INVALID_LIMIT', 'Build timeout must be 0..3600 seconds')
    template, output = Path(template).resolve(), Path(output).resolve()
    core.require(not output.exists(), 'OUTPUT_EXISTS', 'Materialization writes a new package; choose an unused destination')
    declaration = json.loads(json.dumps(core.load(template/'cc.yaml')))
    patch = host.artifact_path(change['patch'])
    env = dict(os.environ, GIT_LFS_SKIP_SMUDGE='1', GIT_TERMINAL_PROMPT='0', PYTHONDONTWRITEBYTECODE='1')
    records = attempt['steps']
    def run(arguments, cwd, code):
        try:
            result = subprocess.run(arguments, cwd=cwd, env=env, capture_output=True, timeout=timeout)
        except subprocess.TimeoutExpired as error:
            records.append({'command': arguments, 'exit_code': None, 'outcome': 'unknown',
                            'stdout': (error.stdout or b'').decode('utf-8', errors='replace'),
                            'stderr': (error.stderr or b'').decode('utf-8', errors='replace')})
            persist()
            raise core.CCError('BUILD_TIMEOUT', 'Deadline exceeded; descendant cessation is not confirmed. Inspect this attempt before retrying.')
        records.append({'command': arguments, 'exit_code': result.returncode,
                        'stdout': result.stdout.decode('utf-8', errors='replace'), 'stderr': result.stderr.decode('utf-8', errors='replace')})
        persist()
        core.require(result.returncode == 0, code, records[-1]['stderr'] or records[-1]['stdout'])
        return result.stdout.decode('utf-8').strip()
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='cc-build-', dir=output.parent) as temporary:
        checkout = Path(temporary)/'source'; checkout.mkdir()
        run(['git', 'init', str(checkout)], output.parent, 'SOURCE_UNAVAILABLE')
        run(['git', '-c', 'core.autocrlf=false', 'fetch', '--depth=1', change['repository'], change['base']], checkout, 'SOURCE_UNAVAILABLE')
        run(['git', '-c', 'core.autocrlf=false', 'checkout', '--detach', 'FETCH_HEAD'], checkout, 'SOURCE_UNAVAILABLE')
        base = run(['git', 'rev-parse', 'HEAD'], checkout, 'SOURCE_UNAVAILABLE')
        core.require(base == change['base'], 'BASE_MISMATCH', 'Fetched source differs from requested base')
        run(['git', 'apply', '--allow-empty', '--check', '--index', '--binary', str(patch)], checkout, 'PATCH_REJECTED')
        run(['git', 'apply', '--allow-empty', '--index', '--binary', str(patch)], checkout, 'PATCH_REJECTED')
        tree = run(['git', 'write-tree'], checkout, 'SOURCE_INVALID')
        core.require(tree == change['tree'], 'TREE_MISMATCH', 'Patch does not reconstruct the declared source tree')
        entries = run(['git', 'ls-files', '--stage'], checkout, 'SOURCE_INVALID')
        core.require(not any(line.startswith('160000 ') for line in entries.splitlines()), 'UNSUPPORTED_SOURCE_MATERIAL', 'Resolve submodules with a qualified build profile; do not silently omit them')
        tracked = run(['git', 'ls-files', '-z'], checkout, 'SOURCE_INVALID')
        for name in filter(None, tracked.split('\0')):
            path = core.contained(checkout, name)
            if path.is_file():
                with path.open('rb') as stream:
                    pointer = stream.read(128).startswith(b'version https://git-lfs.github.com/spec/v1')
                core.require(not pointer, 'UNSUPPORTED_SOURCE_MATERIAL', 'Unresolved Git LFS pointer: ' + name)
        lock = None
        if 'lock' in build:
            path = core.contained(checkout, build['lock'])
            core.require(path.is_file(), 'MISSING_DEPENDENCY_LOCK', build['lock'])
            lock = {'path': build['lock'], 'sha256': core.file_sha(path)}
        command = [a.replace('{python}', host.python) for a in build['command']]
        run(command, checkout, 'BUILD_FAILED')
        # A build may create ignored output, but may not quietly rewrite source.
        after = run(['git', 'diff', '--name-only'], checkout, 'SOURCE_INVALID')
        staged = run(['git', 'write-tree'], checkout, 'SOURCE_INVALID')
        core.require(not after and staged == tree, 'BUILD_MUTATED_SOURCE', 'Build modified tracked source after the declared tree was bound')
        payload = core.contained(checkout, build['output'])
        core.require(payload.is_dir(), 'MISSING_BUILD_OUTPUT', build['output'])
        payload_files = core.tree_files(payload)
        core.require(bool(payload_files), 'MISSING_BUILD_OUTPUT', 'Build output is empty')
        package = Path(temporary)/'package'; package.mkdir()
        for row in core.tree_files(template):
            target = package/row['path']; target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(template/row['path'], target)
        core.require(not (package/'payload').exists(), 'CONFLICTING_MATERIAL', 'Template must not contain a stale payload')
        shutil.copytree(payload, package/'payload')
        record = {'format': 'cc-build/1', 'attempt': attempt['id'], 'source_change': change, 'observed_base': base, 'observed_tree': tree,
                  'dependency_lock': lock, 'command': command, 'python': {'path': host.python, 'sha256': core.file_sha(host.python)},
                  'payload_files': payload_files, 'steps': records, 'completed': time.time(),
                  'limits': 'Trusted local build; lock identity is not proof of full environment closure or software quality'}
        (package/'build-record.json').write_bytes(core.encoded(record))
        declaration['provenance'] = 'build-record.json'
        (package/'cc.yaml').write_bytes(core.encoded(declaration))
        # Validate executable paths and contracts before making the package visible.
        release = host.prepare(package)
        package.rename(output)
    return {'format': 'cc-materialization/1', 'package': str(output), 'release': release,
            'source_tree': tree, 'build_record': host.put_artifact(output/'build-record.json')}


def materialize(host, template, change, output, *, trusted_build=False, timeout=120, core=None):
    """Retain every authorized build attempt, including failure and uncertainty."""
    if core is None:
        from . import ccv2 as core
    core.require(trusted_build is True, 'BUILD_AUTHORIZATION_REQUIRED', 'Source builds execute repository code; authorize --trusted-build')
    identity = str(uuid.uuid4())
    directory = host.store/'builds'/identity
    directory.mkdir(parents=True)
    path = directory/'attempt.json'
    attempt = {'format': 'cc-build-attempt/1', 'id': identity, 'state': 'running', 'started': time.time(),
               'source_change': change, 'steps': [], 'limits': 'Trusted local build; no process containment or automatic retry. Logs may contain sensitive build data.'}
    def persist():
        temporary = path.with_suffix('.tmp')
        temporary.write_bytes(core.encoded(attempt))
        temporary.replace(path)
    persist()
    try:
        result = _materialize(host, template, change, output, trusted_build=True, timeout=timeout,
                              core=core, attempt=attempt, persist=persist)
        attempt.update(state='succeeded', result=result, completed=time.time())
        persist()
        return result
    except Exception as error:
        attempt.update(state='unknown' if getattr(error, 'code', None) == 'BUILD_TIMEOUT' else 'failed',
                       error={'code': getattr(error, 'code', 'BUILD_FAILED'), 'message': str(error)}, completed=time.time())
        persist()
        if isinstance(error, core.CCError):
            error.path = str(path)
            raise
        raise core.CCError('BUILD_FAILED', str(error), str(path)) from error

