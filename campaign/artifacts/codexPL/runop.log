art=proc_start(os.getpid()), token=token, started=now()), open(os.path.join(adir, \"owner.json\"), \"w\"))\n    S = lambda s, **kw: append(os.path.join(adir, \"state.jsonl\"), dict(ts=now(), job=a.job, attempt=att, state=s, **kw))\n    S(\"queued\"); res = spec[\"resources\"]\n    S(\"preparing\", **({\"inputs_unverified\": True} if \"inputs\" not in spec else {}))\n    error = verify_inputs(spec)\n    if error:\n        S(\"terminal\", execution=\"not_started\", reason=error, **({\"inputs_unverified\": True} if \"inputs\" not in spec else {})); sys.exit(4)\n    S(\"running\", admission=\"none (gpu lock removed by user decision)\", gpu_pre=gpu_state())\n    results = {}; cancelled = False; interrupted = False; sandbox_died = False\n    for ti, tfull in enumerate(spec[\"tests\"]):\n        t = tfull; td = spec.get(\"test_definitions\", TESTS)[t]; cname = f\"lab-{CID}-{a.job}-{att}-{t}-{ti}\".lower()\n        cmd = [\"docker\",\"run\",\"--rm\",\"--name\",cname,\"--label\",f\"campaign={CID}\",\"--label\",f\"lab_job={a.job}\",\"--label\",f\"lab_attempt={att}\",\"--label\",f\"lab_token={token}\",\n               *sum([[\"-e\", f\"{k}={v}\"] for k, v in td.get(\"env\", {}).items()], []),\"--gpus\",\"all\",\"--cpus\",res[\"cpus\"],\"--memory\",td.get(\"memory\", res[\"memory\"]),\"--memory-swap\",td.get(\"memory\", res[\"memory\"]),\"--pids-limit\",res[\"pids\"],\"-v\",f\"{os.path.dirname(spec['model'])}:/m:ro\",*td.get(\"docker_args\", [])]\n        if spec.get(\"data\"): cmd += [\"-v\", f\"{os.path.dirname(spec['data'])}:/d:ro\"]\n        mfile = td.get(\"model_file\", os.path.basename(spec[\"model\"]))\n        cmd += [\"--entrypoint\",\"/app/\"+td[\"tool\"], img[\"image_id\"], \"-m\", \"/m/\"+mfile]\n        if td.get(\"needs_data\"): cmd += [\"-f\", \"/d/\"+os.path.basename(spec[\"data\"])]\n        cmd += td[\"args\"]\n        if td.get(\"cold_cache\"):   # evict ONLY this model file's cached pages (posix_fadvise); never a host-wide flush\n            fd = os.open(os.path.join(os.path.dirname(spec[\"model\"]), mfile), os.O_RDONLY); os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED); os.close(fd)\n        o, e = os.path.join(adir, f\"{t}#{ti}.stdout\"), os.path.join(adir, f\"{t}#{ti}.stderr\"); ts = time.monotonic()\n        with open(o,\"w\") as fo, open(e,\"w\") as fe:\n            p = subprocess.Popen(cmd, stdout=fo, stderr=fe, start_new_session=True)\n\trepeat_last_n = 64, repeat_penalty = 1.000, frequency_penalty = 0.000, presence_penalty = 0.000\n\tdry_multiplier = 0.000, dry_base = 1.750, dry_allowed_length = 2, dry_penalty_last_n = 64\n\ttop_k = 40, top_p = 0.950, min_p = 0.050, xtc_probability = 0.000, xtc_threshold = 0.100, typical_p = 1.000, top_n_sigma = -1.000, temp = 0.000\n\tmirostat = 0, mirostat_lr = 0.100, mirostat_ent = 5.000, adaptive_target = -1.000, adaptive_decay = 0.900\n0.00.594.703 I sampler chain: logits -> ?penalties -> ?dry -> ?top-n-sigma -> top-k -> ?typical -> top-p -> min-p -> ?xtc -> temp-ext -> greedy \n0.00.594.704 I generate: n_ctx = 4096, n_batch = 2048, n_predict = 160, n_keep = 0\n0.00.594.704 I \n0.01.013.577 I common_perf_print:    sampling time =      11.51 ms\n0.01.013.579 I common_perf_print:    samplers time =       4.79 ms /   222 tokens\n0.01.013.583 I common_perf_print:        load time =     174.76 ms\n0.01.013.584 I common_perf_print: prompt eval time =     174.19 ms /    62 tokens (    2.81 ms per token,   355.94 tokens per second)\n0.01.013.584 I common_perf_print:        eval time =     231.97 ms /   159 runs   (    1.46 ms per token,   685.44 tokens per second)\n0.01.013.585 I common_perf_print:       total time =     419.35 ms /   221 tokens\n0.01.013.586 I common_perf_print: unaccounted time =       1.68 ms /   0.4 %      (total - sampling - prompt eval - eval) / (total)\n0.01.013.586 I common_perf_print:    graphs reused =        158\n0.01.013.586 I common_perf_print:   graph reallocs =          0    /     0        (same size) / (changed size)\nREADME.md\npareto.json\npareto.md\npareto.py\ntest_pareto.py\ncc/memory_pareto/pareto.py:126:        return 'No scatter points: GPU MiB and KLD are both required.'\ncc/memory_pareto/pareto.py:140:    lines += ['   0 +' + '-' * width, '      0 to %g GPU MiB (lower is better)' % xmax,\ncc/memory_pareto/pareto.py:141:              '      : budget %g MiB; * frontier; o other; + overlapping points' % budget,\ncc/memory_pareto/pareto.py:142:              'Points (table row: GPU MiB, KLD): ' + '; '.join('%d: %g, %g' % (i, r['gpu_mib'], r['kld']) for i, r in points)]\ncc/memory_pareto/pareto.py:146:CAVEATS = ('Pareto objectives: minimize GPU MiB, maximize TG tokens/s, minimize KLD. '\ncc/memory_pareto/pareto.py:148:           'Budget fit is GPU MiB <= the budget, independent of quality availability. '\ncc/memory_pareto/pareto.py:157:               ('gpu_mib', 'GPU MiB'), ('host_mib', 'Host MiB'), ('tg_ts', 'TG t/s'),\ncc/memory_pareto/pareto.py:160:             'GPU budget: **%g MiB** (default 700: rounded scaled analogue of 500 GB -> 128 GB on a 2.67 GB model; not a physical capacity prediction).' % budget,\ncc/memory_pareto/test_pareto.py:92:    assert 'GPU MiB' in report and '```text' in report\ncc/memory_pareto/README.md:10:The script prints a Markdown table sorted by ascending GPU MiB (unknown memory last), followed by a terminal ASCII scatter of GPU MiB versus KLD. It writes `pareto.md` and `pareto.json` beside the script by default. `--output-dir artifacts/codexI` selects another assignment-permitted destination. Reports are overwritten on reruns. Nothing is written to the input paths. No network, Docker, or third-party runtime packages are used.\ncc/memory_pareto/README.md:20:`class` must be `transferable`, `discrete-only`, or `mixed`. Supply the orchestrator's classifications; the script does not validate scientific transferability. Memory is MiB; TG and PP are tokens per second. KLD is smaller-is-better. Top1 is a percentage; PPL ratio is supplied relative to the experiment's stated reference. Neither is converted into KLD. Empty cells, NA, N/A, null, none, NaN and nonfinite numbers become unavailable, never zero. Invalid numbers, negative values, invalid classes, and percentages above 100 are errors. Zero is valid. Notes should identify workloads, hardware, model, measurement method and quality reference. Rows are individual observations; repeated names or exact metric ties are preserved.\ncc/memory_pareto/README.md:24:Fallback accepts completed attempts and successful, nonpartial tests only. It emits a separate row per benchmark sample record or quality test; it never joins observations across tests, attempts, models or workloads. GPU MiB means `mem.gpu_peak_mib`, **not** baseline-subtracted delta; host MiB means `host_cgroup_peak_mib`. TG requires zero prompt tokens and positive generated tokens; PP requires zero generated tokens and positive prompt tokens. Combined PP+TG samples supply neither speed objective. `avg_ts` supplies speed; repeated `samples_ts` are not independently analyzed. Raw PPL and its stderr are recorded in notes, but no PPL ratio or KLD is invented. Fallback classification is explicitly `unclassified`, so these rows cannot support transferable claims. Job/test/sample identifiers and source result paths are retained. Attempts are not averaged or deduplicated.\ncc/memory_pareto/README.md:28:A row is Pareto-optimal if no other eligible row has GPU MiB no higher, TG tokens/s no lower, and KLD no higher, with at least one strict improvement. All three objectives must be available. Exact ties remain optimal together. Missing Top1 or PPL ratio is flagged but does not disqualify a row with KLD. Missing KLD, GPU memory or TG speed excludes it from every frontier. Missing-quality and missing-objective lists are explicit in both output formats.\ncc/memory_pareto/README.md:32:A row fits when its known GPU MiB is **at most** `--budget-mib` (inclusive); missing GPU memory has unknown fit. Fit does not require quality data or frontier membership. The budget defaults to 700 MiB, a rounded scaled analogue of a 500 GB to 128 GB target on a 2.67 GB model (2.67 × 128 / 500 ≈ 0.684 GB). This is a comparison line, not a prediction of unified-memory or production capacity; GB/MiB conventions and runtime overhead matter. Host memory is shown separately and is not added to the GPU budget. Since GPU memory is also an objective, a fitting row's dominator must also fit; the budget frontier is therefore the global frontier restricted to fitting rows.\ncc/memory_pareto/pareto.md:5:GPU budget: **700 MiB** (default 700: rounded scaled analogue of 500 GB -> 128 GB on a 2.67 GB model; not a physical capacity prediction).\ncc/memory_pareto/pareto.md:7:Pareto objectives: minimize GPU MiB, maximize TG tokens/s, minimize KLD. Only rows with all three objectives are eligible; exact ties all remain optimal. Budget fit is GPU MiB <= the budget, independent of quality availability. Global and budget frontiers are descriptive pooled comparisons, not transferable claims. Class frontiers compare rows only within their labelled class. Discrete-only, mixed and unclassified measurements do not establish transferable savings. No statistical significance is established; workloads, hardware, memory accounting and quality references must be comparable.\ncc/memory_pareto/pareto.md:9:| Config | Description | Class | GPU MiB | Host MiB | TG t/s | PP t/s | KLD | Top1 % | PPL ratio | Fits budget | Pareto | Budget Pareto | Class Pareto | Missing quality | Missing objectives | Notes | Source |\ncc/memory_pareto/pareto.md:11:| mixE2K | experts Q2_K / rest Q8_0 | transferable | 948 | NA | 841 | 35602 | 0.771232 | 58.804 | 2.09015 | no | yes | no | yes | none | none | quality collapse | /home/muk/projects/siminfeng/campaign/experiments/memory/configs.csv:7 |\ncc/memory_pareto/pareto.md:12:| mixE3K | experts Q3_K / rest Q8_0 | transferable | 1064 | NA | 733 | 38426 | 0.135039 | 81.804 | 1.10043 | no | yes | no | yes | none | none |  | /home/muk/projects/siminfeng/campaign/experiments/memory/configs.csv:6 |\ncc/memory_pareto/pareto.md:36:      0 to 2984 GPU MiB (lower is better)\ncc/memory_pareto/pareto.md:37:      : budget 700 MiB; * frontier; o other; + overlapping points\ncc/memory_pareto/pareto.md:38:Points (table row: GPU MiB, KLD): 1: 948, 0.771232; 2: 1064, 0.135039; 3: 1218, 0.040017; 4: 1222, 0.077526; 5: 1794, 0.003389; 6: 2984, 0\ncc/memory_pareto/pareto.json:10:  \"caveats\": \"Pareto objectives: minimize GPU MiB, maximize TG tokens/s, minimize KLD. Only rows with all three objectives are eligible; exact ties all remain optimal. Budget fit is GPU MiB <= the budget, independent of quality availability. Global and budget frontiers are descriptive pooled comparisons, not transferable claims. Class frontiers compare rows only within their labelled class. Discrete-only, mixed and unclassified measurements do not establish transferable savings. No statistical significance is established; workloads, hardware, memory accounting and quality references must be comparable.\",\ncc/memory_pareto/pareto.json:13:      \"config\": \"mixE2K\",\ncc/memory_pareto/pareto.json:33:      \"config\": \"mixE3K\",\n","exit_code":0,"status":"completed"}}
