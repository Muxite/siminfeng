id: factory.builder
version: 1.0.0
bindings:
  default:
    kind: native
    command:
    - '{python}'
    - '{bundle}/run.py'
capabilities:
  submit:
    does: Submit a durable build job. This acknowledges submission, not success; inspect
      status and result separately.
    takes:
      request: json
      idem_key: text
    gives:
      attempt_id: text
      state: text
      jobq_id: json
    needs:
    - python
    changes:
    - process.exec
  status:
    does: Read and reconcile the owned build attempt.
    takes:
      attempt_id: text
    gives:
      attempt: json
    needs:
    - python
    changes:
    - process.exec
  cancel:
    does: Request cancellation of the owned build attempt.
    takes:
      attempt_id: text
    gives:
      attempt: json
    needs:
    - python
    changes:
    - process.exec
  result:
    does: Read build result references; submission alone is not success.
    takes:
      attempt_id: text
    gives:
      attempt_id: text
      state: text
      result_refs: json
    needs:
    - python
    changes:
    - process.exec
