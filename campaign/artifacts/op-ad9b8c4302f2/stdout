ts of one model - see llama_model_set_attn_rot\n        const char * env_rot_disable = getenv(\"LLAMA_ATTN_ROT_DISABLE\");\n\n        const bool attn_rot_disable = !model.attn_rot || (env_rot_disable != nullptr && atoi(env_rot_disable) != 0);\n        if (attn_rot_disable) {\n            LLAMA_LOG_WARN(\"%s: attention rotation force disabled (%s)\\n\", __func__,\n                    model.attn_rot ? \"LLAMA_ATTN_ROT_DISABLE\" : \"llama_model_set_attn_rot\");\n        }\n\n        bool attn_rot_k =\n            !attn_rot_disable &&\n            n_embd_head_k_all > 0 &&\n            ggml_is_quantized(type_k) &&\n            hparams.n_embd_head_k() % 64 == 0;\n\n        // always create Hadamard rotation tensors for DeepSeek lightning indexers\n        if ((model.arch == LLM_ARCH_DEEPSEEK32 || model.arch == LLM_ARCH_DEEPSEEK4 ||\n                model.arch == LLM_ARCH_GLM_DSA || model.arch == LLM_ARCH_DOTS3NOTE) &&\n                hparams.n_embd_head_k_full == hparams.indexer_head_size) {\n            attn_rot_k = true;\n        }\n\n        const bool attn_rot_v =\n            !attn_rot_disable &&\n            n_embd_head_v_all > 0 &&\n            ggml_is_quantized(type_v) &&\n            hparams.n_embd_head_v() % 64 == 0;\n\n        if (attn_rot_k) {\n            n_rot_k = 64;\n\n            // TODO: investigate if using the smallest rotation matrix is beneficial also for K (similar as for V)\n            // ref: https://github.com/ggml-org/llama.cpp/pull/21038#issuecomment-4141323088\n            while (n_embd_head_k_all % (2*n_rot_k) == 0) {\n                n_rot_k *= 2;\n            }\n        }\n        if (attn_rot_v) {\n            n_rot_v = 64;\n            // using smaller rotation matrices for V seems beneficial\n            // ref: https://github.com/ggml-org/llama.cpp/pull/21038#issuecomment-4146397570\n            //while (hparams.n_embd_head_v() % (2*n_rot_v) == 0) {\n            //    n_rot_v *= 2;\n            //}\n        }\n    }\n\n    LLAMA_LOG_INFO(\"%s: n_rot_k = %u, n_embd_head_k_all = %d\\n\", __func__, n_rot_k, n_embd_head_k_all);\n    LLAMA_LOG_INFO(\"%s: n_rot_v = %u, n_embd_head_k_all = %d\\n\", __func__, n_rot_v, n_embd_head_v_all);\n\n2634:        // a Hadamard-latent table stores rotated rows: restore the primal basis, h = s * (H z)\n# Q8 activation reuse campaign patch\n\nApply only to llama.cpp `31288c9c66e59377f7788d920678a565bb89dd37`. See [DESIGN.md](DESIGN.md) for the safety rule and exclusions. This directory contains the patch and its handoff documentation; no reference-source files were edited.\n\n## Build CC\n\nFrom the campaign root, the orchestrator can build with the existing Build CC:\n\n```bash\npython3 cc/build_engine/build_engine.py \\\n  --source ref/llama.cpp --commit 31288c9c6 \\\n  --patch cc/q8_reuse/q8-activation-reuse.patch \\\n  --tag campaign/llamacpp:c1-q8-reuse \\\n  --out artifacts/codexH/build-q8-reuse\n```\n\nUse a fresh/empty output directory and the Build CC's required locally available, digest-pinned CUDA bases. Build a separate unpatched image from the same commit/toolchain for baseline comparison. The Build CC archives the source and applies the patch to its staging copy. Docker and CUDA were not run for this assignment.\n\n## A/B switch\n\nReuse defaults ON. The environment setting is read once per process. Start separate processes for each run:\n\n```bash\nGGML_CUDA_Q8_REUSE=0 /app/llama-bench -m \"$MODEL_Q8\" -ngl 99 -p 0 -n 128 -b 1 -ub 1\nGGML_CUDA_Q8_REUSE=1 /app/llama-bench -m \"$MODEL_Q8\" -ngl 99 -p 0 -n 128 -b 1 -ub 1\n0.00.065.447 I llama_completion: llama backend init\n0.00.065.455 I llama_completion: load the model and apply lora adapter, if any\n/src/ggml/src/ggml-impl.h:330: fatal error\n/app/libggml-base.so.0(+0x1671b)[0x75f4b298e71b]\n/app/libggml-base.so.0(+0x16b9c)[0x75f4b298eb9c]\n/app/libggml-base.so.0(ggml_abort+0x15b)[0x75f4b298ed7b]\n/app/libggml-base.so.0(ggml_backend_sched_split_graph+0x10e4)[0x75f4b29ab054]\n/app/libllama.so.0(_ZN13ll