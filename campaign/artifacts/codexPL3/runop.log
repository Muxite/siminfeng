{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'cat cc/moe_planner/plan.py'","aggregated_output":"#!/usr/bin/env python3\n\"\"\"Offline hypotheses for pinned llama.cpp; never starts an engine or a GPU job.\"\"\"\nfrom __future__ import annotations\nimport argparse\nimport hashlib\nimport json\nimport math\nfrom pathlib import Path\nimport statistics\n\nHERE = Path(__file__).resolve().parent\nROOT = HERE.parents[1]\nMIB = 1048576\n\n\ndef read_json(path):\n    return json.loads(Path(path).read_text())\n\n\ndef finite(value, name, positive=False):\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):\n        raise ValueError(f'{name} must be finite numeric')\n    if value < 0 or (positive and value == 0):\n        raise ValueError(f'{name} must be {\"positive\" if positive else \"nonnegative\"}')\n    return value\n\n\ndef line(xs, ys):\n    mean_x, mean_y = statistics.mean(xs), statistics.mean(ys)\n    denom = sum((x - mean_x) ** 2 for x in xs)\n    if not denom:\n        raise ValueError('fit needs distinct coordinates')\n    slope = sum((x - mean_x) * (y - mean_y) for x, y in zip(xs, ys)) / denom\n    return mean_y - slope * mean_x, slope\n\n\ndef grouped(cal, family):\n    rows = [p for p in cal['points'] if p['family'] == family]\n    return [dict(x=x, **{key: statistics.median(p[key] for p in rows if p['x'] == x)\n                        for key in ('gpu_mib', 'decode_tps', 'prompt_ms', 'host_cgroup_peak_mib')})\n            for x in sorted({p['x'] for p in rows})]\n\n\ndef fit(rows, family):\n    \"\"\"OLS GPU/time for static; log-time for LRU (always positive).\"\"\"\n    result = {'log_time': family == 'lru'}\n    for key in ('gpu_mib', 'decode_us', 'prompt_ms'):\n        ys = [1e6 / r['decode_tps'] if key == 'decode_us' else r[key] for r in rows]\n        if result['log_time'] and key != 'gpu_mib':\n            ys = [math.log(y) for y in ys]\n        result[key] = line([r['x'] for r in rows], ys)\n    return result\n\n\ndef predict_fit(model, x):\n    out = {}\n    for key in ('gpu_mib', 'decode_us', 'prompt_ms'):\n        a, b = model[key]\n        value = a + b * x\n        if model['log_time'] and key != 'gpu_mib':\n            value = math.exp(value)\n        out[key] = max(value, 1e-6)\n    out['decode_tps'] = 1e6 / out['decode_us']\n    return out\n\n\ndef residual_report(cal):\n    report = {}\n    for family in ('static', 'lru'):\n        rows = grouped(cal, family)\n        model = fit(rows, family)\n        fitted, loo = [], []\n        for i, r in enumerate(rows):\n            for target, prediction in ((fitted, predict_fit(model, r['x'])),\n                                       (loo, predict_fit(fit(rows[:i] + rows[i+1:], family), r['x']))):\n                target.append(dict(x=r['x'], gpu_mib_error=prediction['gpu_mib']-r['gpu_mib'],\n                                   decode_pct_error=100*(prediction['decode_tps']/r['decode_tps']-1),\n                                   prompt_ms_error=prediction['prompt_ms']-r['prompt_ms']))\n        report[family] = dict(coefficients=model, fitted=fitted, leave_one_coordinate_out=loo,\n                             max_fit_gpu_mib=max(abs(r['gpu_mib_error']) for r in fitted),\n                             max_loo_gpu_mib=max(abs(r['gpu_mib_error']) for r in loo),\n                             max_fit_decode_pct=max(abs(r['decode_pct_error']) for r in fitted),\n                             max_loo_decode_pct=max(abs(r['decode_pct_error']) for r in loo))\n    return report\n\n\ndef adapt_stats(raw):\n    \"\"\"Small explicit adapter: canonical fields, tensors, or inspector totals.\"\"\"\n    if raw.get('schema', raw.get('format')) != 'model-stats/0':\n        raise ValueError('expected model-stats/0')\n    meta = raw.get('model', {})\n    s = dict(raw)\n    for name in ('arch', 'n_layer', 'n_expert', 'n_expert_used', 'context_length'):\n        s[name] = raw.get(name, meta.get(name))\n    if s['arch'] is None:\n        s['arch'] = raw.get('architecture')\n    for name in ('n_layer', 'n_expert', 'n_expert_used', 'context_length'):\n        finite(s[name], name, positive=True)\n        if int(s[name]) != s[name]:\n            raise ValueError(f'{name} must be integral')\n        s[name] = int(s[name])\n    if s['n_expert_used'] > s['n_expert']:\n        raise ValueError('n_expert_used exceeds n_expert')\n    if 'expert_bytes' not in s or 'nonexpert_bytes' not in s:\n        tensors = raw.get('tensors')\n        if tensors is not None:\n            s['expert_bytes'] = sum(t['bytes'] for t in tensors if t['role'] == 'expert_ffn')\n            s['nonexpert_bytes'] = sum(t['bytes'] for t in tensors if t['role'] != 'expert_ffn')\n        else:\n            roles = raw.get('totals', {}).get('by_role', raw.get('totals_by_role', {}))\n            sizes = {k: v['bytes'] if isinstance(v, dict) else v for k, v in roles.items()}\n            if not sizes or 'expert_ffn' not in sizes:\n                raise ValueError('need expert_bytes/nonexpert_bytes, tensors, or totals.by_role bytes')\n            s['expert_bytes'] = sizes['expert_ffn']\n            s['nonexpert_bytes'] = sum(v for k, v in sizes.items() if k != 'expert_ffn')\n    for name in ('expert_bytes', 'nonexpert_bytes'):\n        finite(s[name], name, positive=True)\n    kv = raw.get('kv_bytes_per_token', raw.get('kv', {}).get('bytes_per_token'))\n    if kv is None and 'kv_cache' in raw:\n        kv = {k: v['bytes_per_token'] for k, v in raw['kv_cache']['cache_types'].items()\n              if v.get('bytes_per_token') is not None}\n    if not isinstance(kv, dict) or 'f16' not in kv:\n        raise ValueError('need kv_bytes_per_token with total K+V f16 bytes')\n    s['kv_bytes_per_token'] = {k: finite(v, f'KV {k}', positive=True) for k, v in kv.items()}\n    s['model_path'] = raw.get('model_path', raw.get('gguf_path', raw.get('path', raw.get('source', {}).get('path'))))\n    if not s['model_path']:\n        raise ValueError('need model_path (or path/source.path) to emit exact model flags')\n    s['representation'] = raw.get('representation') or next(\n        (r for r in ('mixE4K', 'mixE3K', 'mixE2K', 'Q4_K_M', 'Q8_0', 'bf16')\n         if r in Path(s['model_path']).name), 'unknown')\n    return s\n\n\ndef variants(s, cal):\n    \"\"\"Only enumerate sibling GGUFs that exist, never imaginary quantizations.\"\"\"\n    out = [s]\n    ref = cal['representations'].get(s['representation'])\n    known = (s['arch'] == 'granitemoe' and s['n_layer'] == 24 and s['n_expert'] == 32\n             and s['n_expert_used'] == 8 and ref\n             and Path(s['model_path']).name == ref['model_file']\n             and abs(s['expert_bytes'] / ref['expert_bytes'] - 1) < .001\n             and abs(s['nonexpert_bytes'] / ref['nonexpert_bytes'] - 1) < .001)\n    if known:\n        for name, rec in cal['representations'].items():\n            path = Path(s['model_path']).parent / rec['model_file']\n            if name != s['representation'] and path.is_file():\n                out.append(dict(s, representation=name, model_path=str(path),\n                                expert_bytes=rec['expert_bytes'], nonexpert_bytes=rec['nonexpert_bytes']))\n    return out\n\n\ndef resource_limits(sample, gpu_budget, host_budget):\n    warnings = []\n    if sample is None:\n        return gpu_budget, host_budget, warnings\n    if sample.get('schema') != 'resource-sample/0':\n        raise ValueError('expected resource-sample/0')\n    fields = sample.get('fields', {})\n    def get(key, unit):\n        f = fields.get(key, {})\n        if f.get('status') != 'ok' or f.get('value') is None:\n            warnings.append(f'{key} unavailable; no zero or free-memory assumption')\n            return None\n        if f.get('unit') != unit:\n            raise ValueError(f'{key}: expected unit {unit}')\n        return finite(f['value'], key)\n    total, used = get('gpu.memory.total', 'MiB'), get('gpu.memory.used', 'MiB')\n    if total is not None and used is not None:\n        gpu_budget = min(gpu_budget, max(0, total-used))\n    available = get('host.mem.available', 'B')\n    if available is not None:\n        host_budget = min(host_budget, available/MIB)\n    warnings.append('Resource sample is a non-atomic availability hint; no reservation or process attribution')\n    return gpu_budget, host_budget, warnings\n\n\ndef hybrid_hit_rate(stats, spec):\n    \"\"\"Apply the existing TRAIN-selected IDs to an explicitly supplied decode trace.\"\"\"\n    groups = [g for g in stats.get('routing_trace', {}).get('groups', []) if g['phase'] == 'decode']\n    if len(groups) != 1 or len(groups[0]['layers']) != stats['n_layer']:\n        return sum(spec['hot_counts'])/(stats['n_layer']*stats['n_expert']), 'uniform routing fallback; no complete unambiguous decode trace'\n    total, hits = 0, 0\n    for layer, hot_ids in enumerate(spec['hot_ids']):\n        hist = groups[0]['layers'][str(layer)]['frequency']\n        if len(hist) != stats['n_expert'] or any(type(n) is not int or n < 0 for n in hist):\n            raise ValueError('invalid routing frequency')\n        total += sum(hist)\n        hits += sum(hist[e] for e in hot_ids)\n    if not total:\n        raise ValueError('decode routing trace has no requests')\n    return hits/total, f\"decode trace split={groups[0]['split']}; hot IDs fixed from prose prefill TRAIN; train/eval disjointness must be verified\"\n\n\ndef load_components(source=None):\n    \"\"\"Registry may be absent. Accepted entries default on; pending needs enabled=true.\"\"\"\n    if source is None:\n        source = ROOT / 'cc/factory/components.json'\n        if not source.is_file():\n            return {}\n    if isinstance(source, (str, Path)) and Path(source) == ROOT/'cc/factory/components.json' and not Path(source).is_file():\n        return {}\n    raw = read_json(source) if isinstance(source, (str, Path)) else source\n    entries = raw.get('components', raw) if isinstance(raw, dict) else raw\n    if isinstance(entries, list):\n        entries = {r if isinstance(r, str) else r.get('id', r.get('name')):\n                   {'enabled': True} if isinstance(r, str) else r for r in entries}\n    if not isinstance(entries, dict):\n        raise ValueError('components must be a mapping or list')\n    out = {}\n    for name, rec in entries.items():\n        if isinstance(rec, bool):\n            rec = {'enabled': rec}\n        if not isinstance(rec, dict):\n            continue  # registry metadata\n        enabled = rec.get('enabled', rec.get('status') == 'accepted')\n        if type(enabled) is not bool:\n            raise ValueError(f'component {name}: enabled must be boolean')\n        if enabled:\n            out[name] = rec\n    return out\n\n\ndef crossover_model(stats, cal):\n    rec = cal['planner_v2']['hybrid_crossover']\n    per_byte = rec['cpu_expert_us'] / rec['reference_expert_bytes']\n    fixed = rec['extra_token_us'] / rec['extra_handoff_layers']\n    size = stats['expert_bytes'] / (stats['n_layer'] * stats['n_expert'])\n    threshold = fixed / per_byte\n    return dict(source=rec['source'], expert_bytes=size, cpu_us_per_byte=per_byte,\n                per_layer_fixed_us=fixed, crossover_expert_bytes=threshold,\n                crossover_expert_mib=threshold/MIB,\n                required_margin=rec['required_margin'],\n                predicted_beneficial=size*per_byte > rec['required_margin']*fixed,\n                note='Necessary amortization condition only; routing savings and GPU qualification still required')\n\n\ndef prefill_prediction(cal, family, coord, prompt_tokens, ctx, flash):\n    \"\"\"Fit prefill us/token independently of decode, using measured prompt counts.\"\"\"\n    source_family = 'lru' if family == 'lru' else 'static'\n    points = [r for r in cal['points'] if r['family'] == source_family]\n    xs = sorted({r['x'] for r in points})\n    ys = [statistics.median(1e6/r['prefill_tps'] if r.get('prefill_tps') else\n                           r['prompt_ms']*1000/r['prompt_tokens']\n                           for r in points if r['x'] == x) for x in xs]\n    a, b = line(xs, ys)\n    us = max(1e-6, a+b*(coord if family != 'hybrid' else 24))\n    source = 'D022 measured prefill_tps (62-token chat); linear prompt-length hypothesis'\n    d028 = cal['planner_v2']['flash_attention']\n    if ctx >= 8192:\n        # Transfer the independently measured CPU-placement penalty to D028's\n        # long-prompt GPU endpoint. Context/prompt/placement transfer is unvalidated.\n        baseline = 1e6/d028['prefill_tps_on' if flash else 'prefill_tps_off']\n        us = baseline + max(0, us-a)\n        source = 'D028 1560-token prefill endpoint + D022 placement us/token penalty; extrapolated'\n    return dict(prefill_tps=1e6/us, prefill_ms=prompt_tokens*us/1000, source=source)\n\n\ndef pareto_front(candidates):\n    \"\"\"Minimize GPU and risk, maximize decode; unknown risk is +infinity.\"\"\"\n    def values(p):\n        return p['gpu_mib'], -p['decode_tps'], p['quality_risk'] if p['quality_risk'] is not None else math.inf\n    frontier = []\n    for p in sorted(candidates, key=lambda p: (*values(p), p['id'])):\n        v = values(p)\n        if any(all(a <= b for a, b in zip(values(q), v)) and\n               any(a < b for a, b in zip(values(q), v)) for q in frontier):\n            continue\n        frontier = [q for q in frontier if not (\n            all(a <= b for a, b in zip(v, values(q))) and any(a < b for a, b in zip(v, values(q))))]\n        frontier.append(p)\n    return frontier\n\n\ndef plan(raw, host, budget, *, allow_extrapolation=False, top=5, sample=None,\n         all_representations=True, cal=None, prompt_tokens=62, components=None):\n    cal = cal or read_json(HERE / 'calibration.json')\n    s = adapt_stats(raw)\n    enabled = load_components(components)\n    crossover = crossover_model(s, cal)\n    ctx = budget['ctx']\n    finite(ctx, 'ctx', positive=True)\n    if int(ctx) != ctx or ctx > s['context_length']:\n        raise ValueError('ctx must be integral and no greater than model context_length')\n    ctx = int(ctx)\n    if type(top) is not int or top < 1:\n        raise ValueError('top must be a positive integer')\n    finite(prompt_tokens, 'prompt_tokens', positive=True)\n    if int(prompt_tokens) != prompt_tokens or prompt_tokens >= ctx:\n        raise ValueError('prompt_tokens must be integral and less than ctx')\n    prompt_tokens = int(prompt_tokens)\n    objective = budget.get('objective', 'decode')\n    if objective not in ('decode', 'ttft', 'balanced'):\n        raise ValueError('objective must be decode, ttft, or balanced')\n    max_kld = budget.get('max_quality_loss')\n    if max_kld is not None:\n        finite(max_kld, 'max_quality_loss')\n    gb = finite(budget['gpu_mib'], 'gpu_mib', positive=True)\n    hb = finite(budget.get('host_mib', host['ram_bytes']/MIB), 'host_mib', positive=True)\n    gb = min(gb, finite(host['gpu']['memory_mib'], 'host GPU capacity', positive=True))\n    hb = min(hb, finite(host['ram_bytes'], 'host RAM', positive=True)/MIB)\n    gb, hb, warnings = resource_limits(sample, gb, hb)\n    report = residual_report(cal)\n    fits = {f: report[f]['coefficients'] for f in ('static', 'lru')}\n    same_host = (host.get('host_id') == cal['host_id'] and\n                 host.get('memory_model') == cal['conditions']['memory_model'] and\n                 host.get('gpu', {}).get('model') == cal['conditions']['gpu'] and\n                 host.get('cpu', {}).get('model') == cal['conditions']['cpu'])\n    candidates, rejected = [], []\n    for v in variants(s, cal) if all_representations else [s]:\n        rep = v['representation']\n        ref = cal['representations'].get(rep)\n        matched = (ref and v['arch'] == cal['arch'] and v['n_layer'] == 24 and v['n_expert'] == 32\n                   and v['n_expert_used'] == 8 and Path(v['model_path']).name == ref['model_file'] and\n                   abs(v['expert_bytes']/ref['expert_bytes']-1) < .001 and\n                   abs(v['nonexpert_bytes']/ref['nonexpert_bytes']-1) < .001 and\n                   abs(v['kv_bytes_per_token']['f16']-49152) < 1)\n        quality_kld = ref['kld'] if matched else None\n        # Every layer count is interpolation; LRU only measured cache sizes.\n        placements = [('static', k, None) for k in range(v['n_layer']+1)]\n        placements += [('lru', c, None) for c in (128, 256, 384, 640)]\n        if rep == 'mixE4K' and matched:\n            for spec in cal.get('hybrid_specs', []):\n                path = ROOT / spec['model_path']\n                if path.is_file():\n                    placements.append(('hybrid', sum(spec['hot_counts']), str(path)))\n        caches = [(k, z) for k, z in v['kv_bytes_per_token'].items() if k in ('f16', 'q8_0', 'q4_0')]\n        for family, coord, split_path in placements:\n            for kv, kv_bpt in caches:\n                # Batch/ubatch alternatives are proposed tests, never calibrated improvements.\n                for batch, ubatch in ((2048, 512), (512, 128), (512, 512)):\n                    reasons, notes = [], []\n                    flash = ctx >= 8192 or kv != 'f16'\n                    component_ids = sorted(k for k in enabled if k in ('q8_reuse', 'kv_quant_fix'))\n                    ident = f'{rep}-{family}{coord}-{kv}-c{ctx}-b{batch}-u{ubatch}'\n                    if flash:\n                        ident += '-fa'\n                    if component_ids:\n                        ident += '-cmp-' + '-'.join(component_ids)\n                    if kv != 'f16' and 'kv_quant_fix' not in enabled:\n                        rejected.append(dict(id=ident, reasons=['D028: quantized KV aborted; requires enabled component kv_quant_fix']))\n                        continue\n                    if family == 'hybrid' and not crossover_model(v, cal)['predicted_beneficial']:\n                        rejected.append(dict(id=ident, reasons=['D030/D031: hybrid rejected in small-expert regime; below crossover margin']))\n                        continue\n                    if not same_host:\n                        reasons.append('host differs from discrete x86-main calibration')\n                    if not matched:\n                        reasons.append('model stats differ from calibrated Granite representation')\n                    if rep != 'mixE4K':\n                        reasons.append('representation timing/placement transferred from mixE4K')\n                    if ctx != 4096:\n                        reasons.append('context outside measured singleton 4096')\n                    if kv != 'f16':\n                        reasons.append('quantized KV: speed and combined KLD unmeasured')\n                    if (batch, ubatch) != (2048, 512):\n                        reasons.append('batch/ubatch memory scaling and prefill unmeasured')\n                    if prompt_tokens != 62:\n                        reasons.append('prompt length outside measured singleton 62')\n                    if family == 'lru' and coord / (v['expert_bytes']/MIB) < .60:\n                        rejected.append(dict(id=ident, reasons=['D022/D019 policy: LRU resident-byte coverage <60% on discrete PCIe']))\n                        continue\n                    if family == 'hybrid':\n                        reasons.append('hybrid end-to-end GPU speed/memory/quality unmeasured')\n                    if reasons and not allow_extrapolation:\n                        rejected.append(dict(id=ident, reasons=['requires --allow-extrapolation'] + reasons))\n                        continue\n                    base = predict_fit(fits['lru' if family == 'lru' else 'static'],\n                                       coord if family != 'hybrid' else 0)\n                    base_exp = cal['representations']['mixE4K']['expert_bytes']/MIB\n                    exp, non = v['expert_bytes']/MIB, v['nonexpert_bytes']/MIB\n                    kv_mib = ctx*kv_bpt/MIB\n                    compute_mib = 108*ubatch/512\n                    if family == 'static':\n                        resident = exp*(v['n_layer']-coord)/v['n_layer']\n                        # Preserve D022 intercept and slope, plus analytical byte deltas.\n                        gpu = base['gpu_mib'] + (resident-base_exp*(24-coord)/24) + non-cal['representations']['mixE4K']['nonexpert_bytes']/MIB\n                        decode_us = base['decode_us']\n                        if rep != 'mixE4K' or not matched:\n                            screen = cal['representation_screen'].get(rep, {}).get('decode_tps', 684)\n                            decode_us = 1e6/screen + coord*(base['decode_us']-predict_fit(fits['static'], 0)['decode_us'])/max(coord, 1)*exp/base_exp\n                        flags = ['--n-cpu-moe', str(coord)] if coord else []\n                    elif family == 'lru':\n                        resident = min(exp, coord)\n                        gpu = base['gpu_mib'] + non-cal['representations']['mixE4K']['nonexpert_bytes']/MIB\n                        decode_us = base['decode_us'] * exp/base_exp\n                        flags = ['--n-cpu-moe', str(v['n_layer']), '--moe-cache-mib', str(coord)]\n                        notes.append('LRU log-time fit is weak; prefer static at matched memory (D022)')\n                    else:\n                        # Null bank per layer is mandatory in hybrid_split; includes its bytes.\n                        slot = exp/(v['n_expert']*v['n_layer'])\n                        resident = (coord+v['n_layer'])*slot\n                        gpu = predict_fit(fits['static'], 24)['gpu_mib'] + resident\n                        spec = next(z for z in cal['hybrid_specs'] if sum(z['hot_counts']) == coord)\n                        hit, trace_note = hybrid_hit_rate(v, spec)\n                        hybrid_cost = crossover_model(v, cal)\n                        decode_us = predict_fit(fits['static'], 0)['decode_us'] + hybrid_cost['cpu_us_per_byte']*slot*MIB*v['n_layer']*v['n_expert_used']*(1-hit) + hybrid_cost['per_layer_fixed_us']*v['n_layer']\n                        flags = ['-ot', r'\\.cold$=CPU', '--no-op-offload', '--no-repack']\n                        notes += [trace_note, 'D030/D031 effective per-layer dispatch/handoff cost included; larger-expert transfer remains unmeasured.',\n                                  'D027 amendment: focused CUDA correctness test failed; exploratory until repaired and requalified.']\n                    gpu += kv_mib-192 + compute_mib-108\n                    attention_delta = 0.0\n                    d028 = cal['planner_v2']['flash_attention']\n                    if ctx >= 8192:\n                        scale = (ctx-4096)/(d028['ctx']-4096)\n                        off_delta = d028['gpu_mib_off'] - (predict_fit(fits['static'], 0)['gpu_mib'] + (d028['ctx']-4096)*v['kv_bytes_per_token']['f16']/MIB)\n                        attention_delta = (off_delta - (d028['gpu_mib_off']-d028['gpu_mib_on']))*scale\n                        gpu += attention_delta\n                        decode_us /= d028['decode_tps_on']/d028['decode_tps_off']\n                        notes.append('D028: -fa on default at ctx >=8192; f16 memory/decode transfer is extrapolated; FA quality equivalence unmeasured')\n                    if 'q8_reuse' in enabled:\n                        decode_us /= cal['planner_v2']['q8_reuse']['decode_factor']\n                        notes.append('D029: enabled q8_reuse multiplies decode by 1.02; prefill unchanged; placement/context transfer unmeasured')\n                    # Conservative file-backed working set including load; not warm cgroup RSS.\n                    host_mib = exp+non+400+(v['n_layer']*exp/(v['n_expert']*v['n_layer']) if family == 'hybrid' else 0)\n                    guard = report['lru' if family == 'lru' else 'static']['max_loo_gpu_mib']\n                    prefill = prefill_prediction(cal, family, coord, prompt_tokens, ctx, flash)\n                    prompt_ms = prefill['prefill_ms']\n                    ttft_ms = prompt_ms + decode_us/1000\n                    # Calibrated KLD belongs to the original all-GPU representation only.\n                    exact_quality = family == 'static' and coord == 0 and kv == 'f16' and matched and ctx == 4096 and not flash\n                    kld = quality_kld if exact_quality else None\n                    notes.append('Host estimate = complete mapped weights +400 MiB D015 anonymous allowance; load peak/working-set hypothesis, not measured RSS')\n                    if kld is None:\n                        notes.append('Representation KLD carried as risk prior; placement/KV combined KLD must be measured')\n                    if max_kld is not None and (kld is None or kld > max_kld):\n                        rejected.append(dict(id=ident, reasons=['strict KLD gate: combined quality unknown or exceeds max_quality_loss']))\n                        continue\n                    if gpu+guard > gb or host_mib > hb:\n                        rejected.append(dict(id=ident, reasons=['GPU estimate + LOO guard exceeds budget' if gpu+guard > gb else 'host working set exceeds budget (D015 page-cache cliff)']))\n                        continue\n                    if reasons:\n                        notes += reasons\n                    model_path = split_path or v['model_path']\n                    flags = ['-m', model_path, '-ngl', '99', '--fit', 'off', '-c', str(ctx),\n                             '-b', str(batch), '-ub', str(ubatch), '-ctk', kv, '-ctv', kv,\n                             '-t', '8', '-tb', '8'] + flags\n                    if flash:\n                        flags += ['-fa', 'on']\n                    confidence = 'extrapolated' if reasons else 'calibrated'\n                    p = dict(id=ident, representation=rep, placement=family, gpu_mib=round(gpu,3),\n                             gpu_guard_mib=round(guard,3), host_mib=round(host_mib,3),\n                             decode_tps=round(1e6/decode_us,3), ttft_ms=round(ttft_ms,3),\n                             ttft_definition='warm prompt-eval + one decode proxy; excludes load, tokenizer, queue and sampling',\n                             quality_class='bf16-reference' if kld == 0 else 'measured-representation-drift' if kld is not None else 'combined-quality-unmeasured',\n                             kld=kld, representation_kld=quality_kld,\n                             quality_risk=kld, quality_risk_unknown=kld is None,\n                             kv_type=kv, kv_mib=round(kv_mib,3), flash_attention=flash,\n                             attention_delta_mib=round(attention_delta,3), components=component_ids,\n                             runtime_env={'GGML_CUDA_Q8_REUSE':'1'} if 'q8_reuse' in enabled else {},\n                             technique_family='|'.join([rep, family, kv, 'fa-on' if flash else 'fa-off', ','.join(component_ids) or 'base']),\n                             prefill_tps=round(prefill['prefill_tps'],3), prefill_ms=round(prompt_ms,3),\n                             prefill_source=prefill['source'],\n                             techniques=[rep, family, f'kv:{kv}', f'ctx:{ctx}', f'batch:{batch}', f'ubatch:{ubatch}'],\n                             confidence=confidence, metric_confidence=dict(gpu_mib=confidence, decode_tps=confidence, host_mib='extrapolated', prefill_tps='proxy', ttft_ms='proxy'),\n                             flags=flags, model_path=model_path, notes=notes,\n                             required_engine='hybrid_split patch + pinned base; CUDA qualification required' if family == 'hybrid' else 'llama.cpp 31288c9c6',\n                             prerequisites=['Check mechanism engagement (D024)', 'Measure shim peak AND baseline-subtracted device peak (D023)', 'Paired quality check before accepting drift; 3 alternated timing rounds'])\n                    if family == 'hybrid':\n                        p['hot_counts_per_layer'] = spec['hot_counts']\n                        p['routing_hit_estimate'] = hit\n                        p['prerequisites'].insert(0, 'Resolve D027 CUDA correctness failure; pass test-hybrid-split and GET_ROWS i32 on CUDA')\n                    if 'q8_reuse' in enabled:\n                        p['metric_confidence']['decode_tps'] = 'extrapolated-component-transfer'\n                        p['required_engine'] += ' + q8_reuse patch (D029)'\n                    if 'kv_quant_fix' in enabled:\n                        p['required_engine'] += ' + kv_quant_fix patch (D028; qualification pending)'\n                    candidates.append(p)\n    def rank(p):\n        if objective == 'ttft':\n            score = -p['ttft_ms']\n        elif objective == 'balanced':\n            score = math.log(p['decode_tps'])-math.log(p['ttft_ms'])\n        else:\n            score = p['decode_tps']\n        # Measured regime precedes unvalidated hypotheses regardless of predicted speed.\n        return (p['confidence'] != 'calibrated', -score, p['gpu_mib'], p['id'])\n    candidates.sort(key=rank)\n    best = {}\n    for p in candidates:\n        best.setdefault(p['technique_family'], p)\n    family_best = list(best.values())\n    pareto = sorted(pareto_front(candidates), key=rank)\n    if len(family_best) < top:\n        warnings.append(f'Only {len(family_best)} feasible technique families; top is a maximum, not a quota. Use --allow-extrapolation to consider unmeasured alternatives.')\n    return dict(schema='moe-plan/0', prediction_only=True, prompt_tokens=prompt_tokens, budget=dict(gpu_mib=gb, host_mib=hb, ctx=ctx, max_quality_loss=max_kld, objective=objective),\n                plans=family_best[:top], family_best=family_best, family_count=len(family_best),\n                pareto_set=pareto, pareto_axes=['gpu_mib:min', 'decode_tps:max', 'quality_risk:min'],\n                quality_risk_policy='measured combined KLD; null is unknown and treated as +infinity for dominance, never zero',\n                hybrid_crossover=crossover, enabled_components=sorted(enabled),\n                technique_catalog=cal['planner_v2']['techniques'],\n                feasible_count=len(candidates), rejected=rejected, calibration_residuals=report,\n                warnings=warnings+['No hard VRAM guarantee; predictions require measurement.',\n                                   'Calibrated confidence describes GPU/decode regime; host is analytical and TTFT is a warm proxy.',\n                                   'No finite KLD bound is inferred from identical weights or greedy output.',\n                                   'Missing TTFT/host calibration cannot be resolved by --allow-extrapolation.'])\n\n\ndef emit_lab_tests(result):\n    \"\"\"Exact bin/lab definition mapping; model path resides in each job's model directory.\"\"\"\n    if result['prompt_tokens'] != 62:\n        raise ValueError('lab tests use the D022 62-token chat fixture; cannot emit another prompt length')\n    tests = {}\n    for p in result['plans']:\n        tag = 'pl_'+hashlib.sha256(p['id'].encode()).hexdigest()[:12]\n        flags = p['flags']\n        assert flags[:1] == ['-m']\n        common = flags[2:]\n        remaining = result['budget']['ctx'] - result['prompt_tokens']\n        for phase, n in (('engagement', min(8, remaining)), ('timing', min(160, remaining))):\n            tests[f'{tag}_{phase}'] = dict(tool='llama-completion', parser='completion',\n                model_file=Path(p['model_path']).name,\n                docker_args=[item for k,v in p.get('runtime_env', {}).items() for item in ('-e', f'{k}={v}')]+['-v', str(ROOT / 'artifacts/traces/in')+':/tin:ro'],\n                args=common+['-f', '/tin/chat.txt', '-n', str(n), '--temp', '0', '-s', '1', '-no-cnv', '--no-warmup'])\n        if p['representation_kld'] is not None and (ROOT/'artifacts/kl/bf16.kl').is_file():\n            # Existing reference logits are 20x512. Do not claim this tests ctx=4096.\n            quality_flags = list(common)\n            quality_flags[quality_flags.index('-c')+1] = '512'\n            tests[f'{tag}_quality512'] = dict(tool='llama-perplexity', parser='kl', needs_data=True,\n                model_file=Path(p['model_path']).name,\n                docker_args=[item for k,v in p.get('runtime_env', {}).items() for item in ('-e', f'{k}={v}')]+['-v', str(ROOT/'artifacts/kl')+':/planner-kl:ro'],\n                args=quality_flags+['--chunks', '20', '--kl-divergence', '--kl-divergence-base', '/planner-kl/bf16.kl'])\n    return tests\n\n\ndef main(argv=None):\n    a = argparse.ArgumentParser(description=__doc__)\n    a.add_argument('--stats', required=True)\n    a.add_argument('--host', required=True)\n    a.add_argument('--budget-gpu-mib', type=float, required=True)\n    a.add_argument('--budget-host-mib', type=float)\n    a.add_argument('--ctx', type=int, required=True)\n    a.add_argument('--max-kld', type=float)\n    a.add_argument('--objective', choices=('decode', 'ttft', 'balanced'), default='decode')\n    a.add_argument('--top', type=int, default=5)\n    a.add_argument('--allow-extrapolation', action='store_true')\n    a.add_argument('--only-input-representation', action='store_true')\n    a.add_argument('--resource-sample')\n    a.add_argument('--components', nargs='?', const=str(ROOT/'cc/factory/components.json'), help='Component registry JSON (default: cc/factory/components.json if present); pending entries require enabled=true')\n    a.add_argument('--prompt-tokens', type=int, default=62)\n    a.add_argument('--emit-lab-tests')\n    args = a.parse_args(argv)\n    try:\n        budget = dict(gpu_mib=args.budget_gpu_mib, ctx=args.ctx, max_quality_loss=args.max_kld, objective=args.objective)\n        if args.budget_host_mib is not None:\n            budget['host_mib'] = args.budget_host_mib\n        result = plan(read_json(args.stats), read_json(args.host), budget,\n                      allow_extrapolation=args.allow_extrapolation, top=args.top,\n                      sample=read_json(args.resource_sample) if args.resource_sample else None,\n                      all_representations=not args.only_input_representation, prompt_tokens=args.prompt_tokens,\n                      components=args.components)\n        if args.emit_lab_tests:\n            dest = Path(args.emit_lab_tests).resolve()\n            # Assignment scope also constrains paths requested through this CLI.\n            if not any(dest.is_relative_to(base) for base in (HERE, ROOT/'artifacts/codexPL2')):\n                raise ValueError('--emit-lab-tests must stay under cc/moe_planner or artifacts/codexPL2')\n            dest.parent.mkdir(parents=True, exist_ok=True)\n            dest.write_text(json.dumps(emit_lab_tests(result), indent=2)+'\\n')\n        print(json.dumps(result, indent=2, allow_nan=False))\n    except (ValueError, KeyError, TypeError, OSError) as exc:\n        a.error(str(exc))\n    return 0\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'cat cc/moe_planner/test_plan.py cc/moe_planner/PLANNER.md; cat decisions/D013* decisions/D029* decisions/D033* decisions/D034* decisions/D035* decisions/D036*'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'cat cc/moe_planner/test_plan.py cc/moe_planner/PLANNER.md; cat decisions/D013* decisions/D029* decisions/D033* decisions/D034* decisions/D035* decisions/D036*'","aggregated_output":"\"\"\"CPU-only checks. All test scratch files belong under artifacts/codexPL2.\"\"\"\nimport ast\nimport copy\nimport importlib.util\nimport json\nfrom pathlib import Path\n\nimport pytest\n\nHERE = Path(__file__).resolve().parent\nROOT = HERE.parents[1]\nspec = importlib.util.spec_from_file_location('planner', HERE/'plan.py')\nplanner = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(planner)\n\n\n@pytest.fixture\ndef cal():\n    return planner.read_json(HERE/'calibration.json')\n\n\n@pytest.fixture\ndef stats():\n    return planner.read_json(ROOT/'artifacts/codexPL/granite-fixture.json')\n\n\n@pytest.fixture\ndef host():\n    return planner.read_json(ROOT/'cc/engine_handoff/hosts/x86-main.json')\n\n\ndef run(stats, host, **kw):\n    budget = kw.pop('budget', dict(gpu_mib=900, ctx=4096))\n    kw.setdefault('components', {})  # deterministic even as the factory registry lands\n    return planner.plan(stats, host, budget, **kw)\n\n\ndef test_d022_three_independent_samples_and_raw_provenance(cal):\n    raw = planner.read_json(ROOT/'lab/jobs/job-ad883810b3/att-1/result.json')['quality']['tests']\n    assert len(cal['points']) == 27\n    for family, xs in [('static', [0,6,12,18,24]), ('lru', [128,256,384,640])]:\n        for x in xs:\n            rows = [p for p in cal['points'] if p['family'] == family and p['x'] == x]\n            assert len(rows) == 3\n            for p in rows:\n                r = raw[p['test']]\n                assert p['job_id'] == 'job-ad883810b3' and 'D022' in p['source']\n                assert p['gpu_mib'] == r['mem']['gpu_delta_mib']\n                assert p['decode_tps'] == r['decode_tps']\n    # Independent, frozen rounded decision numbers, not snapshots of the fitter.\n    assert [round(p['decode_tps']) for p in planner.grouped(cal, 'static')] == [684,323,197,152,128]\n    assert [round(p['gpu_mib']) for p in planner.grouped(cal, 'static')] == [1388,1226,1064,902,742]\n\n\n@pytest.mark.parametrize('family,memory_bound,speed_bound', [('static',2.001,16.25), ('lru',.001,39.27)])\ndef test_leave_one_coordinate_out_reproduces_d022(cal, family, memory_bound, speed_bound):\n    rows = planner.grouped(cal, family)\n    for i, held in enumerate(rows):\n        trained = planner.fit(rows[:i]+rows[i+1:], family)\n        predicted = planner.predict_fit(trained, held['x'])\n        assert abs(predicted['gpu_mib']-held['gpu_mib']) <= memory_bound\n        assert abs(100*(predicted['decode_tps']/held['decode_tps']-1)) <= speed_bound\n    report = planner.residual_report(cal)[family]\n    assert report['max_loo_gpu_mib'] <= memory_bound\n    assert report['max_loo_decode_pct'] <= speed_bound\n\n\ndef test_900_budget_selects_n19_and_accounts_for_overhead(stats, host):\n    result = run(stats, host)\n    p = result['plans'][0]\n    assert p['id'].startswith('mixE4K-static19-')\n    assert p['gpu_mib'] == pytest.approx(875.872, abs=.01)\n    assert p['decode_tps'] == pytest.approx(149.633, abs=.001)\n    assert p['host_mib'] == pytest.approx(1178.7, abs=.01)\n    assert all(p['gpu_mib']+p['gpu_guard_mib'] <= 900 for p in result['plans'])\n    assert all(p['confidence'] == 'calibrated' for p in result['plans'])\n    assert all(p['metric_confidence']['host_mib'] == 'extrapolated' for p in result['plans'])\n    assert '--fit' in p['flags'] and p['flags'][p['flags'].index('--fit')+1] == 'off'\n\n\ndef test_budget_guard_and_inclusive_host_boundary(stats, host):\n    first = run(stats, host, top=100)['plans'][0]\n    # Two MiB residual guard prevents calling this marginal point feasible.\n    r = run(stats, host, budget=dict(gpu_mib=876, ctx=4096), top=100)\n    assert all('-static19-' not in p['id'] for p in r['plans'])\n    assert not run(stats, host, budget=dict(gpu_mib=900,host_mib=1000,ctx=4096))['plans']\n    r = run(stats, host, budget=dict(gpu_mib=900,host_mib=1178.701,ctx=4096))\n    assert r['plans']\n    assert not run(stats, host, budget=dict(gpu_mib=600,ctx=4096))['plans']\n\n\ndef test_strict_kld_unknown_never_passes(stats, host):\n    assert not run(stats, host, budget=dict(gpu_mib=900,ctx=4096,max_quality_loss=.05))['plans']\n    r = run(stats, host, budget=dict(gpu_mib=1500,ctx=4096,max_quality_loss=.05), top=100)\n    assert r['plans'] and all(p['kld'] is not None and p['kld'] <= .05 for p in r['plans'])\n    assert all('-static0-f16-' in p['id'] for p in r['plans'])\n    assert not run(stats, host, budget=dict(gpu_mib=1500,ctx=4096,max_quality_loss=0))['plans']\n\n\n@pytest.mark.parametrize('change', ['ctx','host','model','kv'])\ndef test_no_silent_extrapolation(stats, host, change):\n    budget = dict(gpu_mib=20000,ctx=4096)\n    if change == 'ctx':\n        budget['ctx'] = 8192\n    elif change == 'host':\n        host['memory_model'] = 'unified'\n    elif change == 'model':\n        stats['expert_bytes'] *= 2\n    else:\n        stats['kv_bytes_per_token'] = {'f16':49153,'q8_0':26112}\n    assert not run(stats, host, budget=budget)['plans']\n    r = run(stats, host, budget=budget, allow_extrapolation=True)\n    assert r['plans'] and all(p['confidence'] == 'extrapolated' for p in r['plans'])\n\n\ndef test_quant_kv_flash_attention_and_batch_candidates(stats, host):\n    r = run(stats, host, budget=dict(gpu_mib=16000,ctx=4096), allow_extrapolation=True, top=10000,\n            components={'kv_quant_fix': {'enabled':True, 'status':'pending'}})\n    quant = [p for p in r['plans'] if 'kv:q8_0' in p['techniques'] or 'kv:q4_0' in p['techniques']]\n    assert quant\n    assert all(p['flags'][p['flags'].index('-fa')+1] == 'on' for p in quant)\n    assert all(p['confidence'] == 'extrapolated' and p['kld'] is None for p in quant)\n    assert any('ubatch:128' in p['techniques'] for p in r['plans'])\n    assert {p['representation'] for p in r['plans']} == {'bf16','Q8_0','Q4_K_M','mixE4K','mixE3K','mixE2K'}\n\n\ndef test_lru_policy_uses_resident_coverage_not_guessed_hit_rate(stats, host):\n    r = run(stats, host, budget=dict(gpu_mib=16000,ctx=4096), top=10000)\n    assert any(p['placement'] == 'lru' and '--moe-cache-mib' in p['flags'] for p in r['plans'])\n    assert not any(p['placement'] == 'lru' and any(f'lru{x}-' in p['id'] for x in (128,256,384)) for p in r['plans'])\n    assert any('coverage <60%' in ' '.join(p['reasons']) for p in r['rejected'])\n\n\ndef test_hybrid_has_real_per_layer_hot_counts_and_null_bank_cost(stats, host, cal):\n    r = run(stats, host, budget=dict(gpu_mib=16000,ctx=4096), allow_extrapolation=True, top=10000)\n    assert not any(p['placement'] == 'hybrid' for p in r['plans'])\n    assert any('D030/D031' in ' '.join(p['reasons']) for p in r['rejected'])\n    # Isolate accounting under a hypothetical qualified crossover calibration.\n    # Keep each real transform separately because plans now contains family winners.\n    for spec in cal['hybrid_specs']:\n        hypothetical = copy.deepcopy(cal)\n        hypothetical['planner_v2']['hybrid_crossover']['required_margin'] = 0\n        hypothetical['hybrid_specs'] = [spec]\n        r = run(stats, host, budget=dict(gpu_mib=16000,ctx=4096), allow_extrapolation=True,\n                top=10000, cal=hypothetical)\n        hybrid = [p for p in r['plans'] if p['placement'] == 'hybrid']\n        assert len(hybrid) == 1\n        p = hybrid[0]\n        assert len(p['hot_counts_per_layer']) == 24\n        assert '--no-op-offload' in p['flags'] and '--no-repack' in p['flags']\n        assert p['confidence'] == 'extrapolated' and p['kld'] is None\n        assert any('CUDA correctness failure' in s for s in p['prerequisites'])\n        floor = planner.predict_fit(planner.fit(planner.grouped(cal,'static'),'static'),24)['gpu_mib']\n        # At extrapolated ties the winner may use a smaller ubatch.\n        ub = int(p['flags'][p['flags'].index('-ub')+1])\n        payload = (sum(spec['hot_counts'])+24)*.84375\n        assert p['gpu_mib']-floor-(108*ub/512-108) == pytest.approx(payload, abs=.001)\n\n\ndef test_fixed_hot_ids_applied_to_decode_not_reranked(stats, cal):\n    spec = cal['hybrid_specs'][0]\n    stats['routing_trace'] = {'groups':[dict(split='eval',phase='decode',layers={\n        str(l):dict(frequency=[1 if e in spec['hot_ids'][l] else 0 for e in range(32)]) for l in range(24)})]}\n    hit, note = planner.hybrid_hit_rate(stats,spec)\n    assert hit == 1 and 'split=eval' in note\n\n\ndef test_resource_sample_missing_is_not_zero(stats, host):\n    sample = dict(schema='resource-sample/0',fields={})\n    r = run(stats, host, sample=sample)\n    assert r['plans'] and len(r['warnings']) >= 7\n    sample['fields'] = {'gpu.memory.total':dict(status='ok',value=1000,unit='MiB'),\n                        'gpu.memory.used':dict(status='ok',value=500,unit='MiB'),\n                        'host.mem.available':dict(status='ok',value=3000*planner.MIB,unit='B')}\n    assert not run(stats, host, sample=sample)['plans']\n    sample['fields']['gpu.memory.used']['unit']='B'\n    with pytest.raises(ValueError,match='unit'):\n        run(stats,host,sample=sample)\n\n\n@pytest.mark.parametrize('objective', ['decode','ttft','balanced'])\ndef test_objectives_are_deterministic(stats, host, objective):\n    r = run(stats,host,budget=dict(gpu_mib=1500,ctx=4096,objective=objective),top=100)\n    plans = r['plans']\n    scores = [p['decode_tps'] if objective == 'decode' else -p['ttft_ms'] if objective == 'ttft' else p['decode_tps']/p['ttft_ms'] for p in plans]\n    assert scores == sorted(scores,reverse=True)\n\n\n@pytest.mark.parametrize('key,value', [('ctx',0),('ctx',131073),('gpu_mib',float('nan')),('host_mib',-1),('max_quality_loss',-.1)])\ndef test_invalid_budget_fails_closed(stats,host,key,value):\n    budget=dict(gpu_mib=900,ctx=4096);budget[key]=value\n    with pytest.raises(ValueError): run(stats,host,budget=budget)\n\n\ndef test_real_inspector_contract(stats, host):\n    # The parallel T-MI producer has landed; read its artifact without changing it.\n    raw = planner.read_json(ROOT/'artifacts/codexPL/granite-inspected.json')\n    s = planner.adapt_stats(raw)\n    assert s['expert_bytes'] == 648*planner.MIB\n    assert s['kv_bytes_per_token']['q8_0'] == 26112\n    assert run(raw,host)['plans'][0]['id'] == run(stats,host)['plans'][0]['id']\n\n\ndef test_totals_adapter_and_unknown_role_accounted(stats):\n    raw = copy.deepcopy(stats)\n    del raw['expert_bytes'],raw['nonexpert_bytes']\n    raw['totals']={'by_role':{'expert_ffn':648*planner.MIB,'other':100,'shared_ffn':200}}\n    s=planner.adapt_stats(raw)\n    assert s['nonexpert_bytes'] == 300\n    del raw['kv_bytes_per_token']\n    with pytest.raises(ValueError,match='kv_bytes'): planner.adapt_stats(raw)\n\n\ndef test_emission_matches_real_lab_loader_and_schema(stats,host,tmp_path):\n    result=run(stats,host)\n    definitions=planner.emit_lab_tests(result)\n    reference=planner.read_json(ROOT/'lab/tests/match1.json')\n    # bin/lab has no JSON Schema: validate actual consumer-required fields and types.\n    allowed=set().union(*(set(d) for f in (ROOT/'lab/tests').glob('*.json') for d in planner.read_json(f).values()))\n    for td in definitions.values():\n        assert set(td) <= allowed\n        assert td['tool'] in ('llama-completion','llama-perplexity')\n        assert td['parser'] in ('completion','kl')\n        assert isinstance(td['args'],list) and all(isinstance(v,str) for v in td['args'])\n        assert Path(td['model_file']).name == td['model_file']\n        assert '-m' not in td['args']  # lab injects model_file exactly once\n        assert td['args'][td['args'].index('--fit')+1] == 'off'\n        if td['parser']=='kl':\n            assert td['needs_data'] is True\n            assert td['args'][td['args'].index('-c')+1] == '512'\n        else:\n            assert set(reference['m1_static_n24']) == set(td)\n    # Run the real load_tests function in isolation; do not import the CLI or run Docker.\n    (tmp_path/'tests').mkdir()\n    (tmp_path/'tests/planner.json').write_text(json.dumps(definitions))\n    tree=ast.parse((ROOT/'bin/lab').read_text())\n    function=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='load_tests')\n    namespace=dict(json=json,LAB=str(tmp_path),os=__import__('os'))\n    exec(compile(ast.Module(body=[function],type_ignores=[]),'bin/lab','exec'),namespace)\n    assert namespace['load_tests']() == definitions\n\n\ndef test_cli_output_and_write_boundary(stats,host,capsys):\n    dest=ROOT/'artifacts/codexPL2/cli-test-definitions.json'\n    argv=['--stats',str(ROOT/'artifacts/codexPL/granite-fixture.json'),'--host',str(ROOT/'cc/engine_handoff/hosts/x86-main.json'),\n          '--budget-gpu-mib','900','--ctx','4096','--emit-lab-tests',str(dest)]\n    assert planner.main(argv)==0\n    assert json.loads(capsys.readouterr().out)['plans']\n    assert planner.read_json(dest)\n    argv[-1]=str(ROOT/'lab/tests/forbidden-planner.json')\n    with pytest.raises(SystemExit) as e: planner.main(argv)\n    assert e.value.code==2 and not (ROOT/'lab/tests/forbidden-planner.json').exists()\n\n\ndef test_diversity_best_per_family_and_top_is_maximum(stats, host):\n    r = run(stats, host, allow_extrapolation=True, top=5)\n    assert len(r['plans']) == 5\n    assert len({p['technique_family'] for p in r['plans']}) == 5\n    assert len({p['representation'] for p in r['plans']}) >= 4\n    assert r['plans'] == r['family_best'][:5]\n    # A calibrated-only singleton family must not be padded with n20..n23.\n    calibrated = run(stats, host, all_representations=False)\n    assert len(calibrated['plans']) == 1\n    assert calibrated['plans'][0]['id'].startswith('mixE4K-static19-')\n    assert len(calibrated['pareto_set']) == 6\n    assert any('top is a maximum' in w for w in calibrated['warnings'])\n\n\ndef test_pareto_is_global_and_unknown_quality_is_not_zero():\n    def p(name, gpu, speed, risk):\n        return dict(id=name, gpu_mib=gpu, decode_tps=speed, quality_risk=risk)\n    points = [p('dominated', 100, 10, None), p('unknown-fast', 100, 20, None),\n              p('measured', 100, 20, .04), p('small', 90, 15, .08),\n              p('quality', 120, 10, 0)]\n    assert {r['id'] for r in planner.pareto_front(points)} == {'measured', 'small', 'quality'}\n    assert {r['id'] for r in planner.pareto_front(list(reversed(points)))} == {'measured', 'small', 'quality'}\n\n\n@pytest.mark.parametrize('ctx,flash', [(4096,False), (8192,True), (32768,True)])\ndef test_flash_attention_threshold_and_kv_bytes(stats, host, ctx, flash):\n    r = run(stats, host, budget=dict(gpu_mib=16000, ctx=ctx), allow_extrapolation=True, top=10000)\n    assert r['plans']\n    for p in r['plans']:\n        assert p['flash_attention'] is flash\n        assert p['kv_mib'] == pytest.approx(ctx*stats['kv_bytes_per_token'][p['kv_type']]/planner.MIB)\n        if flash:\n            assert p['flags'][p['flags'].index('-fa')+1] == 'on'\n            assert any('D028' in note for note in p['notes'])\n            assert p['confidence'] == 'extrapolated' and p['kld'] is None\n    if ctx == 32768:\n        allgpu = next(p for p in r['family_best'] if p['technique_family'].startswith('mixE4K|static|'))\n        # The all-GPU D028 anchor includes its attention-buffer observation.\n        assert '--n-cpu-moe' not in allgpu['flags']\n        ub = int(allgpu['flags'][allgpu['flags'].index('-ub')+1])\n        assert allgpu['gpu_mib'] == pytest.approx(2762+108*ub/512-108, abs=.01)\n        assert allgpu['prefill_tps'] == pytest.approx(7001, abs=.001)\n\n\ndef test_long_context_quant_kv_requires_enabled_fix(stats, host):\n    budget = dict(gpu_mib=1200, ctx=32768)\n    assert not run(stats, host, budget=budget, allow_extrapolation=True)['plans']\n    pending = {'components': {'kv_quant_fix': {'status':'pending'}}}\n    assert not run(stats, host, budget=budget, allow_extrapolation=True, components=pending)['plans']\n    pending['components']['kv_quant_fix']['enabled'] = True\n    r = run(stats, host, budget=budget, allow_extrapolation=True, components=pending)\n    assert r['plans'] and len({p['technique_family'] for p in r['plans']}) == len(r['plans'])\n    for p in r['plans']:\n        assert p['kv_type'] in ('q8_0','q4_0')\n        assert p['kv_mib'] == pytest.approx(32768*stats['kv_bytes_per_token'][p['kv_type']]/planner.MIB)\n        assert p['gpu_mib']+p['gpu_guard_mib'] <= 1200\n        assert 'kv_quant_fix' in p['required_engine']\n        assert p['kld'] is None and p['quality_risk'] is None\n        assert 'kv_quant_fix' in p['components']\n    strict = dict(budget, max_quality_loss=.08)\n    assert not run(stats, host, budget=strict, allow_extrapolation=True, components=pending)['plans']\n\n\ndef test_components_absence_registry_formats_and_fail_closed(tmp_path, monkeypatch):\n    # Missing default is tolerated, but a misspelled explicit path is an error.\n    monkeypatch.setattr(planner, 'ROOT', tmp_path)\n    assert planner.load_components() == {}\n    with pytest.raises(FileNotFoundError):\n        planner.load_components(tmp_path/'missing.json')\n    registry = tmp_path/'components.json'\n    registry.write_text(json.dumps({'schema':'factory-components/0', 'components':[\n        dict(id='q8_reuse', status='accepted'), dict(id='kv_quant_fix', status='pending'),\n        dict(id='hybrid_split',status='rejected-small-expert-regime'),\n        dict(id='pap',status='pending',enabled=False)]}))\n    assert set(planner.load_components(registry)) == {'q8_reuse'}\n    assert set(planner.load_components(['q8_reuse', 'kv_quant_fix'])) == {'q8_reuse','kv_quant_fix'}\n    with pytest.raises(ValueError, match='boolean'):\n        planner.load_components({'q8_reuse': {'enabled':'false'}})\n\n\ndef test_q8_reuse_multiplies_only_decode_and_emits_env(stats, host):\n    kw = dict(budget=dict(gpu_mib=900,ctx=4096), allow_extrapolation=True, all_representations=False)\n    base = run(stats, host, **kw)['plans'][0]\n    patched_result = run(stats, host, components={'q8_reuse': {'status':'accepted'}}, **kw)\n    patched = patched_result['plans'][0]\n    assert patched['decode_tps'] == pytest.approx(base['decode_tps']*1.02, abs=.001)\n    assert patched['prefill_tps'] == base['prefill_tps']\n    assert patched['prefill_ms'] == base['prefill_ms']\n    assert patched['gpu_mib'] == base['gpu_mib'] and patched['host_mib'] == base['host_mib']\n    assert patched['ttft_ms'] == pytest.approx(patched['prefill_ms']+1000/patched['decode_tps'], abs=.001)\n    assert patched['runtime_env'] == {'GGML_CUDA_Q8_REUSE':'1'}\n    assert 'q8_reuse' in patched['technique_family'] and patched['id'] != base['id']\n    for definition in planner.emit_lab_tests(patched_result).values():\n        assert 'GGML_CUDA_Q8_REUSE=1' in definition['docker_args']\n\n\ndef test_prefill_is_independent_of_decode_and_scales_prompt(stats, host, cal):\n    a = planner.prefill_prediction(cal, 'static', 12, 62, 4096, False)\n    modified = copy.deepcopy(cal)\n    for row in modified['points']:\n        row['decode_tps'] *= 100\n    assert planner.prefill_prediction(modified, 'static',12,62,4096,False) == a\n    doubled = planner.prefill_prediction(cal,'static',12,124,4096,False)\n    assert doubled['prefill_tps'] == a['prefill_tps']\n    assert doubled['prefill_ms'] == a['prefill_ms']*2\n    off = planner.prefill_prediction(cal,'static',0,1560,32768,False)\n    on = planner.prefill_prediction(cal,'static',0,1560,32768,True)\n    assert off['prefill_tps'] == pytest.approx(5865)\n    assert on['prefill_tps'] == pytest.approx(7001)\n    assert on['prefill_ms'] == pytest.approx(1560/7001*1000)\n\n\ndef test_crossover_reports_measured_fixed_cost_and_large_expert_condition(stats, cal):\n    c = planner.crossover_model(planner.adapt_stats(stats), cal)\n    assert c['per_layer_fixed_us'] == pytest.approx(2030/12)\n    assert c['crossover_expert_mib'] == pytest.approx(4.664522)\n    assert c['expert_bytes']/planner.MIB == .84375\n    assert not c['predicted_beneficial']\n    large = copy.deepcopy(stats)\n    large['expert_bytes'] *= 20\n    assert planner.crossover_model(planner.adapt_stats(large), cal)['predicted_beneficial']\n    pap = cal['planner_v2']['techniques']['pap']\n    assert pap['calibration_points'] == [] and pap['status'] == 'pending-calibration'\n    assert {'job_id','test','decode_tps','prefill_tps','kld','cpu_layers'} <= set(pap['point_fields'])\n\n\ndef test_cli_components_read_and_old_write_location_rejected(tmp_path, capsys):\n    registry = tmp_path/'components.json'\n    registry.write_text(json.dumps({'components':{'kv_quant_fix':{'enabled':True,'status':'pending'}}}))\n    args = ['--stats',str(ROOT/'artifacts/codexPL/granite-inspected.json'),\n            '--host',str(ROOT/'cc/engine_handoff/hosts/x86-main.json'),\n            '--budget-gpu-mib','1200','--ctx','32768','--allow-extrapolation','--components',str(registry)]\n    assert planner.main(args) == 0\n    result = json.loads(capsys.readouterr().out)\n    assert result['plans'] and result['enabled_components'] == ['kv_quant_fix']\n    with pytest.raises(SystemExit):\n        planner.main(args+['--emit-lab-tests',str(ROOT/'artifacts/codexPL/forbidden-pl2.json')])\n    assert not (ROOT/'artifacts/codexPL/forbidden-pl2.json').exists()\n# MoE planner: hypotheses before measurement\n\n`plan.py` is a stdlib-only, offline planner for llama.cpp `31288c9c6` and the\ncampaign patches. It does not compile, launch inference, reserve resources,\nsubmit jobs, or contact services. Its recommendation is a discriminating lab\nexperiment, not a demonstrated engine improvement or a hard memory guarantee.\nAll implementation and scratch writes are confined to `cc/moe_planner/` and\n`artifacts/codexPL2/`. Prior T-PL artifacts are read-only inputs. There are no changes to `bin/lab` or `lab/tests`.\n\n## Run\n\nFrom the campaign root:\n\n```sh\npython3 -B cc/moe_planner/plan.py \\\n  --stats artifacts/codexPL/granite-fixture.json \\\n  --host cc/engine_handoff/hosts/x86-main.json \\\n  --budget-gpu-mib 900 --ctx 4096 --top 5 \\\n  --components artifacts/codexPL2/components-baseline.json \\\n  --emit-lab-tests artifacts/codexPL2/lab-tests.json \\\n  > artifacts/codexPL2/plan-900.json\n\nPYTHONDONTWRITEBYTECODE=1 python3 -B -m pytest -q -p no:cacheprovider \\\n  cc/moe_planner/test_plan.py --basetemp=artifacts/codexPL2/pytest-temp\n```\n\nThe real T-MI inspection of mixE4K is also saved read-only as\n`artifacts/codexPL/granite-inspected.json`; it can replace the hand fixture in\nthat command. The checked-in example report uses the real inspection.\n`--only-input-representation` disables discovery of the other available Granite\nGGUFs. Otherwise the six known sibling filenames are considered only if present\nin the input model's directory and the input agrees with the calibrated Granite\narchitecture, dimensions, filename and weight byte counts. Missing quantizations\nare never invented. All other inputs enumerate their supplied representation.\n\nAdditional controls: `--budget-host-mib`, `--max-kld`,\n`--objective decode|ttft|balanced`, `--allow-extrapolation`, and\n`--resource-sample sample.json`, and `--components [registry.json]`. `--prompt-tokens` changes the analytical warm\nTTFT proxy and requires extrapolation for values other than 62; lab emission\nthen refuses because the actual mounted chat fixture contains 62 tokens.\nOutput JSON includes `plans` (at most `--top` family winners), `family_best`\n(all family winners), `pareto_set` (globally nondominated feasible candidates),\nevery rejected candidate and its reason, fit coefficients/residuals, effective\nbudgets and limitations. A family is representation × placement mechanism ×\nKV type × attention mode × enabled engine components. Layer/cache coordinates\nand batch/ubatch sizes compete within a family. Top is a maximum: if only one\ncalibrated family fits, return one plan and explain the shortage. Use\n`--allow-extrapolation` to explore other available representations. That flag\ncontinues to be required for every unmeasured host/model/context/KV/batch regime. Invalid\ninputs exit 2; a valid budget with no feasible supported plan returns an empty\nlist and explicit rejections. An empty list does not prove no engine can run.\n`--emit-lab-tests` deliberately accepts only destinations under the two allowed\nwrite roots, including when symbolic links are involved.\n\n## Input adapter\n\nThe API is `plan(stats, host, budget, allow_extrapolation=False, top=5, ...)`.\nBudget keys are `gpu_mib`, optional `host_mib`, `ctx`, optional\n`max_quality_loss` (mean KLD), and `objective`.\n\n`adapt_stats()` accepts the T-MI producer's `model-stats/0` directly:\n`arch`, `n_layer`, `n_expert`, `n_expert_used`, `context_length`, `gguf_path`,\n`tensors[{role,bytes,...}]`, and\n`kv_cache.cache_types.TYPE.bytes_per_token` (total K plus V).\nShared FFN and unknown roles count toward nonexpert residency, never disappear.\nThe small hand fixture alternatively supplies `model_path`, `representation`,\n`expert_bytes`, `nonexpert_bytes`, and `kv_bytes_per_token` directly. A\n`totals.by_role` or `totals_by_role` byte mapping is another supported adapter.\nUnavailable KV byte counts are omitted; unavailable f16 KV is an error.\nUnknown models have no inferred quality measurement and require extrapolation.\nThe adapter checks shape/byte compatibility, not full GGUF content identity;\nqualified measurement must bind model and image SHA256 values.\n\nThe optional `resource-sample/0` adapter consumes successful, correctly unitized\n`gpu.memory.total`, `gpu.memory.used`, and `host.mem.available` fields. It limits\navailable budgets to device free MiB and available host bytes. Unavailable/error\nfields remain unknown and generate warnings; they never become zero. This is\nonly an availability hint: samples are non-atomic, can be stale, and do not\nreserve memory. Device totals are never relabeled as process allocations or\nadded to process/cgroup counters. Host RAM and GPU VRAM are separate budgets on\nthis discrete host; applying these fits to unified memory requires the explicit\nextrapolation flag and does not establish unified-memory accounting correctness.\n\n## Evidence and decision rules\n\n* **Expert precision before placement.** [D013](../../decisions/D013-mixed-precision-frontier.md)\n  identifies experts as about 90.4% of weight bytes. Consider available expert\n  representations before spending transfer or CPU-compute costs. mixE4K mean\n  KLD 0.040017 is substantially below uniform Q4_K_M 0.077526 at similar GPU\n  footprints. Q8_0 is 0.003389, mixE3K 0.135039, and mixE2K 0.771232.\n  These are representation changes, with measured drift on wikitext, not\n  computation-preserving improvements. [D009](../../decisions/D009-representation-screen.md),\n  [D010](../../decisions/D010-kl-quality-check.md) and D013 supply the numbers.\n* **Never recommend engine LRU below 60% resident-byte coverage on this discrete\n  PCIe host.** This is a conservative planner policy, **not a measured universal\n  60% breakpoint** and not an assumption that byte coverage equals routing hit\n  rate. [D022](../../decisions/D022-static-vs-moecache-matched.md) shows static\n  placement winning at every matched footprint, including c384 (~59% of the\n  648 MiB expert banks) and c640 (~99%).\n  [D019](../../decisions/D019-hybrid-harness-result.md) measures pinned H2D\n  admission at 37.9 us/expert versus 30.6 us CPU compute plus ~15 us per layer.\n  c640 remains an enumerated control but loses to static in the fitted ranking.\n* **Declare context.** [D023](../../decisions/D023-novmm-engine-under-budget.md)\n  measures 192 MiB f16 KV at ctx4096, 108 MiB compute and 778.7 MiB weights.\n  The model's default/max ctx131072 requires 6144 MiB f16 KV analytically;\n  KV then exceeds compressed weights. Context is a required constraint; the\n  planner never silently shortens it to fit. KV q8_0 and q4_0 use the inspector's\n  exact block accounting (102 and 54 MiB at ctx4096 here), require `-fa on`,\n  and remain uncalibrated for speed and combined quality. D028 observed both\n  quantized types aborting before the fix: neither is enumerated unless the\n  `kv_quant_fix` component is explicitly enabled (or accepted in the registry).\n  Pending status alone does not enable it. At ctx >=8192, f16 also defaults to\n  `-fa on`, citing [D028](../../decisions/D028-kv-precision-protocol.md). Its\n  measured 32k f16 memory delta is -984 MiB, decode ratio 627.2/570.2, and\n  prefill ratio 7001/5865. FA changed text; quality equivalence is unknown.\n* **Auto-fit is not a baseline.** D023's virtual 900 MiB budget caused auto-fit\n  to place only 155 MiB on GPU and decode at 86 t/s, below explicit static n24.\n  Every emitted plan sets `-ngl 99 --fit off` and declares placement explicitly.\n  This also avoids the hybrid graph-before-weight-load failure in\n  [D027](../../decisions/D027-hybrid-split-protocol.md).\n* **Verify mechanism engagement before timing.**\n  [D024](../../decisions/D024-static-hot-rejected.md) rejected static-hot because\n  its allocated banks were never used. Every candidate gets a short engagement\n  test first. Require counters/backend logs or a qualified fingerprint; successful\n  process exit alone is insufficient. Greedy-output identity does not bound KLD.\n* **Do not predict normal RAM speed below the working set.**\n  [D015](../../decisions/D015-ssd-tier-emulation.md) demonstrates a page-cache\n  cliff and severe read amplification. The planner requires a conservative\n  complete file-backed weight set plus 400 MiB anonymous allowance. It rejects\n  tighter host budgets rather than interpolating the contention-affected SSD\n  timing. D022 warm cgroup peaks (~412–418 MiB) do not include every residency\n  scenario or all preexisting page-cache charges and cannot certify this budget.\n* **Do not scale throughput inversely with bytes.**\n  [D011](../../decisions/D011-bandwidth-and-q8-profile.md) and D009 show Q8_0\n  improving clean decode by ~32.5% over BF16, but Q4_K_M is slower than Q8_0.\n  Kernel/dequantization and launch costs matter. Representation transfers use\n  measured screen endpoints when available and are explicitly extrapolated.\n\n## Fits and calibration boundaries\n\n`calibration.json` preserves all 27 D022 samples from\n`lab/jobs/job-ad883810b3/att-1/result.json`, with decision, job, attempt and test\nIDs. GPU MiB means **baseline-subtracted device-used peak**, not the shim cap\nand not the absolute device total. Each coordinate has three independent rounds;\nmedians are fitted with equal weight. Source data are immutable inputs. Supporting\nrecords include D023's probe paths, D014's static calibration job, D019's operation\nIDs (not invented lab job IDs), D011/D009 clean screen jobs, D015's job and its\nconflicting repetition caveat, exact header-derived weight bytes for all six\nrepresentations, and the three existing hybrid transform manifests. A null job ID\nis explicitly explained where the source uses an operation or probe instead.\n\nThe static model is ordinary least squares:\n\n```text\nGPU MiB(K)       = 1387.600000 - 26.933333 K\nDecode us(K)     = 1575.237082 + 268.831188 K\nPrompt ms(K)     = 174.238070 + 2.933955 K\n```\n\nThe retained D022 residual diagnostic for LRU is ordinary least squares of log time:\n\n```text\nGPU MiB(C)       = 742 + C\nlog Decode us(C) = 10.290775 - 0.004155091 C\nlog Prompt ms(C) = 5.474944 + 0.000019467 C\n```\n\nThe log model preserves positive time and captures the cache trend with two\nparameters; its error is large. No polynomial or perfectly interpolating fit\nis used to hide that error. Decode t/s = 1e6 / decode us. The prefill model is\nseparate from decode. It fits median microseconds/token\nfrom D022 `prefill_tps` (or measured prompt time/count if a rate is missing)\nagainst placement coordinates. Static reproduces the prompt-ms OLS above; LRU\nuses its own linear prefill fit rather than borrowing decode's log-time fit.\nThese are completion prompt-eval measurements, not bench pp512. TTFT is\n**warm prompt ms + one decode step**, excluding load,\nqueueing, tokenization and sampling. Actual first-token arrival was not measured.\nA different prompt length is a linear-scaling hypothesis requiring the flag.\nAt ctx >=8192 the independent D028 prefill endpoint (7001 t/s FA on, 5865 off,\n1560-token prose) replaces D022's all-GPU intercept. D022's placement penalty\nin us/token is added to that endpoint. This is an explicit extrapolation across\nprompt/context/placement; a 62-token long-context prompt is not a new measured\nprefill result. Output carries `prefill_tps`, `prefill_ms`, and `prefill_source`;\n`ttft_ms = prefill_ms + 1000/decode_tps`.\n\n| Family | Max fitted GPU error | Max held-out GPU error | Max fitted decode error | Max held-out decode error |\n| --- | ---: | ---: | ---: | ---: |\n| Static | 0.800 MiB | 2.000 MiB | 7.201% | 16.246% |\n| LRU | <0.001 MiB | <0.001 MiB | 10.327% | 39.263% |\n\nLeave-one-**coordinate**-out removes all three samples of one layer/cache setting\nbefore refitting. It does not leak other repetitions of the held-out setting.\nEndpoint folds test extrapolation for validation only; normal inference refuses\nout-of-domain predictions. The complete per-fold residuals and coefficients are\nreturned in JSON. Prompt-time held-out errors reach ~2.203 ms static and ~5.311 ms\nLRU; these are not TTFT confidence intervals. Budget checks add the maximum\nheld-out GPU residual to predicted device memory. This is an empirical guard,\nnot a statistical guarantee or a bound on other-process interference.\n\nThe calibrated GPU/decode domain is the exact x86-main CPU/GPU/discrete-memory\nprofile, matching Granite mixE4K byte layout, f16 KV, ctx4096, batch2048,\nubatch512, eight threads, the D022 prompt and K in [0,24] or C in [128,640].\nStatic intermediate integer K is interpolation. Every other representation,\nmodel, host, context, KV type, prompt length, batch/ubatch, and all hybrid GPU\npredictions require `--allow-extrapolation` and have `confidence=extrapolated`.\nThe overall `calibrated` label describes the GPU/decode regime only;\n`metric_confidence` separately identifies host as an analytical working-set\nhypothesis and TTFT as a proxy. No flag creates missing measurements.\n\nOutside that domain, byte accounting adjusts the D022 footprint by changed\nresident expert/nonexpert bytes, KV bytes relative to 192 MiB, and a hypothetical\ncompute allowance `108 * ubatch/512`. This assumes linear buffer scaling and\nignores alignment/backend algorithm changes. Static decode transfers use clean\nD009 GPU endpoints where available and scale CPU penalty with expert bytes;\nmissing endpoints fall back to D022's ~684 t/s, explicitly unvalidated. The\nother-representation LRU transfer scales fitted time with expert bytes. These\ncoarse proposals exist to select tests; they are not calibrated speed results.\n\nLong-context memory retains the exact KV/token byte accounting from model-stats.\nFor ctx >=8192, use the D028 all-GPU f16 endpoint to model attention workspace:\nlet `scale = (ctx-4096)/(32768-4096)` and let `off_delta` be 3746 minus\n(D022 all-GPU fitted MiB + the 4096→32768 f16 KV delta). Add\n`(off_delta - 984) * scale` to the D022-plus-KV footprint. At ctx32768 this\nrecovers 2762 MiB for mixE4K all-GPU at the baseline ubatch (within input byte\nrounding). The correction is +30.4 MiB relative to the existing linear KV model;\nsubtracting 984 again from that model would double-count a nonexistent KQ buffer.\nUse the f16 workspace correction as an explicitly unmeasured transfer for\nquantized KV. Decode uses D028's FA ratio multiplicatively; other placement,\nprompt and context effects remain unmeasured. Batch/ubatch buffer scaling is\nstill a hypothesis. No context is shortened to make a plan fit.\n\nD030 rejected hybrid at all three measured Granite placements. D031 measured\n2030 us/token extra cost at n12, with 12 additional handoff layers: an effective\n169.17 us/layer, including dispatch, exposed synchronization/transfers and host\ncost. D019's 30.6 us per 884736-byte expert supplies a CPU us/byte estimate.\nThe reported crossover is `fixed_us / cpu_us_per_byte = 4.665 MiB/expert`.\nA conservative 2x margin implements the assignment's “much greater” condition:\nonly experts above ~9.329 MiB satisfy the necessary amortization condition.\nGranite's 0.844 MiB experts fail it, so all real hybrid transforms are rejected\nwith D030/D031 reasons, even with extrapolation enabled. This is a scale model,\nnot proof of a universal threshold or sufficient evidence to enable a new model.\n\nThe hybrid accounting path retains existing n18/n12/n6 transform manifests,\nfixed TRAIN hot IDs, per-layer null expert bytes and decode trace evaluation.\nIts CPU cost scales with expert bytes and its fixed cost now comes from D031;\nCUDA correctness/quality qualification remains required. Larger models do not\ninherit Granite split files. Tests isolate the accounting under a hypothetical\ncrossover calibration without promoting those files into valid recommendations.\n\n### Components and pending PAP calibration\n\n`--components` reads `cc/factory/components.json` by default if it exists.\nAbsence is tolerated; an explicit missing alternative path fails. A JSON object\nmay contain a `components` mapping/list or directly map IDs to records. List\nrecords accept `id` or `name`. `status: accepted` defaults enabled; an explicit\nboolean `enabled` overrides that. Pending/rejected entries default disabled;\n`enabled: true` is the caller's explicit opt-in. An empty object disables all\ncomponents. The planner does not edit the registry or build/apply patches.\nFor example, an exploratory registry may contain:\n\n```json\n{\"components\": {\n  \"q8_reuse\": {\"status\": \"accepted\"},\n  \"kv_quant_fix\": {\"status\": \"pending\", \"enabled\": true}\n}}\n```\n\nEnabled q8_reuse multiplies decode t/s by **1.02** (D029); memory and prefill\nstay unchanged. Runtime environment `GGML_CUDA_Q8_REUSE=1` and the patch\nrequirement accompany the plan and emitted lab definitions. Transfer of that\nfactor to placements/contexts beyond D029 remains explicit in metric confidence\nand notes. q8_reuse preserves computation in its measured regime; it does not\nmake representation, placement or quantized-KV KLD known.\n\n`calibration.json:planner_v2.techniques.pap` is a pending representation trade-off\nentry, with empty calibration points, a lab/jobs result source, explicit future\npoint fields (including model bytes, CPU layers, GPU MiB, decode, prefill, KLD\nand job/attempt/test provenance), and D032 acceptance criteria. No PAP speed,\nquality or nonexistent model is emitted. Future calibration must bind the actual\ntransform/model and same-placement control before activating this technique.\n\n## Ranking, quality and the measurement handoff\n\nPlans must fit `predicted GPU + guard <= GPU budget` and conservative host\nworking set `<= host budget`, each capped by physical capacity and optionally\nresource availability. Each family is ranked first; its best candidate survives. Ranking first\nprefers the calibrated regime. Within each\nconfidence tier, decode maximizes decode t/s, ttft minimizes the warm TTFT proxy,\nand balanced maximizes decode t/s divided by TTFT. Ties prefer smaller GPU\nfootprint and stable candidate ID. No cross-tier speed claim is implied. `family_best` contains every winner;\n`plans` takes the first `--top` of those. `pareto_set` is independent of this\nranking and considers **all** feasible candidates, minimizing GPU MiB and\nquality risk while maximizing decode t/s. Quality risk is measured combined\nKLD; unknown risk is JSON null and treated as +infinity for dominance, never\nzero. Measured representation KLD is retained separately as a prior. Tied\nnondominated points remain available, and the full Pareto set is not truncated\nby `--top`.\n\nWithout `--max-kld`, measured representation KLD is a risk prior; changed\nCPU/GPU placement, hybrid arithmetic and quantized KV have **unknown combined\nKLD**. They get `quality_class=combined-quality-unmeasured` and `kld=null`.\nA finite quality constraint fails closed on unknown combined KLD even with the\nextrapolation flag. Only a matched original all-GPU representation with f16 KV\ncan use its measured representation drift as the gate. That measurement remains\na wikitext screening prior, not a guarantee for other tasks or context lengths.\nThe 900 MiB example consequently has no admissible plan under a strict KLD\nceiling until placement quality is measured. Unknown quality is never zero.\n\nThe emitted JSON is exactly a mapping of test names to `bin/lab` definitions,\nwith `tool`, `parser`, `model_file`, `docker_args`, `args`, and, for quality,\n`needs_data`. Tests exercise the real `load_tests()` in isolation and compare\nconsumer-required fields with the repository's definitions. No new schema\nfields or automatic modifications of `lab/tests` are introduced.\n\nFor each plan, test prefix is `pl_` plus the first 12 hex characters of SHA256\nof the plan ID. Suffixes are `_engagement` (8 generated tokens), `_timing` (160),\nand, for known Granite variants with the existing logits present, `_quality512`.\nCompletion tests mount the exact D022 chat prompt read-only; model flags match\nthe plan, with `-m` provided once by the runner. Quality uses the same\nplacement/KV flags at **ctx512** with 20 chunks and the existing\n`artifacts/kl/bf16.kl`, as required by that reference. It tests placement drift\nat ctx512; it cannot certify ctx4096/long-context KV quality. Provide the exact\nwikitext-2 `wiki.test.raw` from the D009 job as the job's data input. To validate\nquality at ctx4096, first make matching BF16 reference logits and a paired test\nat that context; this task does not run or invent that measurement.\n\nThe owner must import definitions into a permitted lab location, choose an\nimmutable qualified image, and submit with `--model` in the directory containing\nthe test's `model_file`. Standard representations share the original GGUF\ndirectory; hybrid models live in `artifacts/codexR/models`, requiring a separate\njob/model directory and the hybrid image. Do not mix those directory groups in\none job. Before any scored timing: pass engagement with a backend observation,\nresolve the hybrid CUDA failure if applicable, pass paired quality, bind\nimage/model/prompt hashes, and confirm the predicted footprint. Run three\nalternating forward/reverse timing rounds under the established one-GPU-job,\nno-compile policy. Record shim peak and device delta separately; shim limits are\ncooperative intercepted-allocation limits and exclude ~310 MiB driver/context\noverhead (D023). Replan after measured failure or material prediction error.\nNo tests were submitted or executed on the GPU by this worker.\n\n## Example and remaining gaps\n\nWith components disabled explicitly, the real mixE4K inspection at 900 MiB,\nctx4096 recommends static n19 with f16 KV:\n875.867 MiB predicted GPU plus 2.000 MiB guard, 1178.695 MiB host working-set\nallowance, 149.633 decode t/s, and 236.666 ms warm TTFT proxy. The hand-derived\nfixture differs by 0.0055 MiB from exact nonexpert header bytes. Exact flags:\n\n```text\n-m /home/muk/models/campaign/gguf/granite-3.1-1b-a400m-instruct-mixE4K.gguf\n-ngl 99 --fit off -c 4096 -b 2048 -ub 512 -ctk f16 -ctv f16\n-t 8 -tb 8 --n-cpu-moe 19\n```\n\nWith extrapolation enabled, the 900 MiB top five instead contain five\nrepresentation families: mixE4K static19 (calibrated regime), mixE2K static9,\nmixE3K static13, Q4_K_M static15, and Q8_0 static20 (the last four use the\nhypothetical ubatch128 footprint). Their combined placement KLD is unknown;\nlow-bit alternatives carry substantial representation risk (see D013).\nWithout extrapolation, the planner returns just the calibrated mixE4K family\nwinner and keeps n19..24 in the separate memory/speed Pareto set.\n\nAt 1200 MiB / ctx32768, f16 KV alone requires 1536 MiB. No supported plan fits\nwith the baseline components. With kv_quant_fix explicitly enabled and\nextrapolation allowed, q4_0 KV takes 432 MiB. For example, mixE4K static15,\nFA on, batch512/ubatch128 predicts 1173 MiB GPU (+2 MiB guard), 196.152 decode\nt/s, and 57.963 ms warm TTFT for the 62-token prompt. These are unvalidated\npost-fix speed/memory/quality hypotheses; a strict KLD gate rejects them.\n\nWith the factory registry now present, the default enables accepted q8_reuse\nand the same n19 plan predicts 152.625 t/s (+2%). Pending kv_quant_fix remains\ndisabled. The component-free examples above use `components-baseline.json`\nso future registry changes cannot alter their interpretation.\n\nReproducible JSON reports, component selections, emitted test definitions and\nCPU-only pytest results are in `artifacts/codexPL2/`. No Docker or GPU work was\nrun. Remaining gaps include actual TTFT/load time, long-context and quantized-KV\nquality, post-fix GPU qualification, host working set, other model/host\ncalibration, batch/prefill buffers, larger-expert crossover validation and PAP\nresults. Measurements must decide acceptance.\n# D013 — Representation Pareto for GPU memory (job-aa57700ee5; BF16 baseline logits artifacts/kl/bf16.kl, 20x512 wikitext-2)\nClass: TRANSFERABLE (accuracy + byte accounting); t/s columns were taken with the engine build compiling in parallel => unscored.\n- Experts are 90.4% of all weight bytes (Q8_0 GGUF: 1283.5 of 1420.5 MB) => the bulk-compression lever is expert precision; attention/embeddings (~10%) can stay high precision cheaply.\n- Fixed overhead ~300 MiB GPU (CUDA context + KV + compute buffers; file size vs peak delta across variants) does NOT shrink with weights: scaled budget (0.26 x model) must be evaluated on weights+KV+buffers, and at this scale the floor is ~650 MiB of weights even at 2 bits.\n- mixE4K vs uniform Q4_K_M at the same memory (1218 vs 1222 MiB): KLD 0.040 vs 0.078, top-1 90.5% vs 85.6%, PPL +2.9% vs +6.0%. Hypothesis (untested): Q4_K_M also quantizes attention tensors at 4-bit, which are small but sensitive.\n- 3-bit experts: KLD 0.135 / top-1 81.8%; 2-bit experts collapse (KLD 0.77, PPL x2.09).\n- Unanswered: sensitivity per layer/expert (routing flips under quantization noise), frequency-based per-expert precision (needs routing trace), imatrix-calibrated low-bit quantization (not tried; likely helps 3-bit), generation-level / task quality beyond wikitext KL.\n# D029 — C1 q8_reuse ACCEPTED: first full-engine computation-preserving gain (+2.1% Q8_0 decode), x86-main\nProtocol D026 (frozen, commit 474be3b before results). Job job-34c09bec98 (image llamacpp-q8reuse2, run_ref sha256:bd78b473..., config 111ddae8...; patch 9943dee4...), same binary GGML_CUDA_Q8_REUSE=0 vs 1, 2 ABBA cycles, 36/36 clean, host monitor 38 samples no compiler, load 2.7-5.0.\nllama-bench tg128 median t/s [range]: Q8_0 OFF 791.3 [789-792] ON 807.6 [806-808] = +2.06% (criterion >= +2%: MET, ranges disjoint). mixE4K OFF 702.9 ON 715.4 = +1.78% (below 2% -> mixE4K track \"consistent but sub-threshold\").\nllama-completion decode (chat, 160 tok): Q8_0 758.4 -> 777.0 (+2.45%); mixE4K 677.6 -> 691.2 (+2.0%). Prefill unchanged within noise.\nCorrectness: CUDA test-backend-ops MUL_MAT 2445/2445 OK; greedy text sha identical base/OFF/ON (Q8_0 65894776, mixE4K 950b46b1); PPL identical (Q8_0 9.653, mixE4K 9.9806, -ub 1).\nClassification: full-engine code gain, computation-preserving, discrete RTX 5070 Ti, Granite, batch-1 decode. Small: it's a launch/redundancy cleanup (D011 predicted 3-4.5%). Not memory-reducing; stacks with every memory technique. Component CC: cc/q8_reuse (integration: env switch, CUDA mmvq path, applies to 31288c9c6).\n# D033 — Quantized KV fixed (T-KVB2 patch) and measured: q8_0 KV = same accuracy, -720 MiB at 32k\nFix: cc/kv_quant_fix/kv-quant-fix.patch sha256 dd0e4ffd... (Codex T-KVB2): the backend scheduler sizes its hash set for graph NODES only while storing nodes+leaves; quantized-KV extra ops push Granite's graph to 2065 tensors > 2053 slots -> GGML_ABORT. Generic capacity defect (upstream-worthy). Image kvfix-1 (Build CC success, run_ref sha256:7c31deda...).\nJob job-a945fa8656 (protocol D028 unchanged, 15/15 clean; download running concurrently: dl=3 in monitor, no compiler). -fa on, -c 32768, 1560-token prompt:\n  KV f16 2762 MiB, decode 625.1, prefill 7383 | q8_0 2042 MiB (-720), 559.2 (-10.5%), 6947 (-6%) | q4_0 1658 MiB (-1104), 502.3 (-20%), 7188 | f16 no-FA 3746 MiB, 573.7, 5916.\n  PPL wikitext -c 4096: f16 7.5385±0.171, q8_0 7.5392±0.171 (+0.01%: ACCEPT, same accuracy), q4_0 8.1368±0.185 (+7.9%: REJECT under the ±1% rule).\nFactory rules: long context -> -fa on (always); then KV q8_0 (needs kv_quant_fix on this llama.cpp pin) trades ~10% decode for ~26% less GPU KV+attention memory at ~equal PPL; q4_0 KV only with an explicit quality budget. Classification: representation (KV) trade-off + engine defect fix (the fix is a correctness enabler, not a speed gain).\n# D034 — Planner (cc/moe_planner, T-PL) predictions validated on GPU (900 MiB budget, ctx 4096)\nProtocol D032(B). Job job-56115e2bf1 (20/20 clean). 5 plans mixE4K --n-cpu-moe 19..23: GPU MiB predicted vs measured within +0.1..+0.3% (all); decode predicted vs measured +2.6..+7.2% (all optimistic; 3 samples each). Within the planner's own leave-one-out bound (16%) -> VALIDATED IN RANGE. KLD 0.040 / top-1 90.5% for all (placement does not change quality, as expected for identical weights).\nNext: add these 5 points to calibration.json (systematic optimism ~5%); validate out of range (Qwen3-30B-A3B proxy, D031) where the planner must say \"extrapolated\".\nMethod lesson: \"plan -> emitted lab tests -> measured -> prediction error\" is the factory's self-check loop; it caught a consistent decode bias on its first run.\n# D035 — Placement-aware precision (PAP) + imatrix: results (protocol D032-A), job job-3d2fbbd061 (48/48 clean)\nConditions: llamacpp-b0, chat -n 160 -c 4096, 3 alternating rounds; host monitor: no compiler, BUT the 18.6 GB proxy-2 download ran throughout (dl=3) and round 3 was slower for several configs -> decode spread 10-15% within a config (vs 1-3% in D022/D029). Speed conclusions are therefore PROVISIONAL.\nQUALITY (deterministic, 20x512 wikitext-test vs bf16 logits; solid):\n  mixE4K KLD 0.040 top1 90.5 | mix4_imat (same types/bytes, imatrix from wikitext TRAIN) 0.027 / 91.9 (-33% KLD, free) |\n  pap12_q3 0.073 / 87.3 | pap18_q3 0.086 / 85.8 | pap24_q3 0.117 / 83.6 vs pap24_q3_noimat 0.135 / 81.8 (imatrix -13%) |\n  pap12_q2 0.193 | pap18_q2 0.258 | pap24_q2 0.359 (2-bit experts unacceptable even with imatrix and only in CPU layers).\nSPEED (median decode t/s, same K vs mixE4K): pap12_q3 214.9 vs 195.7 (+9.8%), pap18_q3 +5.5%, pap24_q3 +8.7%, q2 variants +14..19%; mix4_imat vs mixE4K -3..+4% (identical bytes => file-level noise floor in this job ~±5%).\nGPU MiB unchanged (PAP only touches CPU-resident layers); host cgroup peak unchanged (weights are mmap page cache, not charged) — PAP's memory effect is on file/page-cache size: pap12_q3 738 MB vs mixE4K 816 MB (-9.6%).\nVerdict vs frozen rule (>= +5% AND KLD <= 0.08): pap12_q3 PROVISIONALLY ACCEPTED (speed needs a quiet-host 5-round rerun); all others rejected (quality). Imatrix: ACCEPTED as a factory default — same bytes, -33% KLD at 4-bit, -13% at 3-bit (calibration on wikitext-train; generalization beyond wikitext not tested).\nFactory rules: (1) always quantize experts with an imatrix from a held-out calibration set; (2) lower-bit only for CPU-resident layers and only to 3-bit; (3) speed gain from PAP is bounded by the CPU share of decode time — it matters most where the CPU part dominates (big offloaded models).\n# D036 — Engine components are separable at the binary level: swapping one backend .so carries the q8_reuse gain (E1)\nBuilds q8base-2 (unpatched) and q8reuse-2 (cc/q8_reuse patch) — separate Build CC runs, same commit/toolchain/base digests: of all shared libraries in /app, EXACTLY ONE differs: libggml-cuda.so.0.27.0 (base 14a7d2d8..., reuse f4011d9a...). libllama, libggml-base, libggml-cpu, libggml, libllama-common and all tool impl libs are byte-identical -> builds are reproducible and the q8_reuse component IS one backend library.\nSwap: base /app with reuse's libggml-cuda.so bind-mounted, run in the base image: greedy text identical to reference (Q8_0 65894776); llama-bench tg128 alternating OFF/ON/ON/OFF/OFF/ON: OFF 793.8/791.8/793.6, ON 810.0/809.8/808.8 => +2.0%, reproducing D029 (+2.06%) without rebuilding llama (download running concurrently; spreads still <0.3%).\nImplication for the factory: version components at their engine layer — model artifact (GGUF+imatrix+recipe), runtime config (flags), backend binary (libggml-cuda / libggml-cpu), scheduler/core (libggml-base), model graph/loader (libllama). A backend-only component can be released and A/B-tested as a single .so against a fixed engine, if the ggml ABI version matches (0.27.0 here). Not shown: swaps across different ggml versions, or of components touching libllama (graph/loader), which need ABI/symbol checks (T-COMP).\n","exit_code":0,"status":"completed"}}
