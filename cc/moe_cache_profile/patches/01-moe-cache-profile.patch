+static std::vector<std::pair<int32_t, int32_t>> read_profile(const std::string & path, int32_t n_layer, int32_t n_expert) {
+    std::ifstream in(path);
+    if (!in) {
+        throw std::runtime_error("MoE cache profile: cannot open " + path);
+    }
+    std::vector<std::pair<int32_t, int32_t>> result;
+    std::set<std::pair<int32_t, int32_t>> seen;
+    auto add = [&](int64_t il, int64_t e) {
+        if (il < 0 || il >= n_layer || e < 0 || e >= n_expert) {
+            throw std::runtime_error("MoE cache profile: out-of-range layer/expert " + std::to_string(il) + " " + std::to_string(e));
+        }
+        const auto pair = std::make_pair((int32_t) il, (int32_t) e);
+        if (!seen.insert(pair).second) {
+            throw std::runtime_error("MoE cache profile: duplicate layer/expert");
+        }
+        result.push_back(pair);
+    };
+    in >> std::ws;
+    if (in.peek() == '{' || in.peek() == '[') {
+        using json = nlohmann::ordered_json;
+        const json doc = json::parse(in);
+        auto integer = [](const json & value) -> int64_t {
+            if (!value.is_number_integer() || (value.is_number_unsigned() && value.get<uint64_t>() > INT64_MAX)) {
+                throw std::runtime_error("MoE cache profile: expected an integer");
+            }
+            return value.get<int64_t>();
+        };
+        if (doc.is_object()) {
+            for (const char * key : { "layers", "n_layer", "experts", "n_expert" }) {
+                if (doc.contains(key) && integer(doc.at(key)) != (std::string(key).find("layer") != std::string::npos ? n_layer : n_expert)) {
+                    throw std::runtime_error(std::string("MoE cache profile: model dimension mismatch: ") + key);
+                }
+            }
+        }
+        const json & ranked = doc.is_array() ? doc : doc.at("ranked");
+        if (!ranked.is_array()) {
+            throw std::runtime_error("MoE cache profile: ranked must be an array");
+        }
+        for (const auto & item : ranked) {
+            if (item.is_object()) {
+                add(integer(item.at("layer")), integer(item.at("expert")));
+            } else if (item.is_array() && item.size() == 2) {
+                add(integer(item.at(0)), integer(item.at(1)));
+            } else {
+                throw std::runtime_error("MoE cache profile: expected layer/expert pair");
+            }
+        }
+    } else {
+        std::string line;
+        size_t line_no = 0;
+        while (std::getline(in, line)) {
+            ++line_no;
+            std::istringstream row(line);
+            row >> std::ws;
+            if (row.eof() || row.peek() == '#') {
+                continue;
+            }
+            int64_t il, e;
+            std::string extra;
+            if (!(row >> il >> e) || (row >> extra)) {
+                throw std::runtime_error("MoE cache profile: expected 'layer expert' at line " + std::to_string(line_no));
+            }
+            add(il, e);
+        }
+    }
+    if (in.bad() || result.empty()) {
+        throw std::runtime_error("MoE cache profile: empty profile or read error");
+    }
+    return result;
+}
 
