"""Durable host adapter for jobq. The queue, not the caller, owns processes."""
from __future__ import annotations

from contextlib import contextmanager
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import time

from .store import FactoryError, NotFound, encoded

TERMINAL = {'succeeded', 'failed', 'cancelled'}


class KeyConflict(FactoryError):
    code = 'KEY_CONFLICT'


def fingerprint(kind, request, argv, job_class, timeout_s):
    return hashlib.sha256(json.dumps(dict(kind=kind, request=request, argv=list(argv),
        job_class=job_class, timeout_s=timeout_s), sort_keys=True, separators=(',', ':'),
        ensure_ascii=False, allow_nan=False).encode()).hexdigest()


def metadata(store, attempt, **changes):
    """Host-only metadata update; F02's transition API requires a state change."""
    with store._transaction():
        current = store._get('attempts', attempt['task_id'], attempt['attempt_id'])
        history_entry = changes.pop('history_entry', None)
        current.update(changes)
        if history_entry:
            current['history'].append(dict(created=time.time(), **history_entry))
            changes['history'] = current['history']
        columns = list(changes)
        if columns:
            store._db.execute('UPDATE attempts SET ' + ','.join(k + '=?' for k in columns)
                + ' WHERE task_id=? AND attempt_id=?',
                tuple(encoded(current[k]) if k in store._json_columns['attempts'] else current[k]
                      for k in columns) + (current['task_id'], current['attempt_id']))
            store._event('attempts', current)
    return current


class Jobs:
    def __init__(self, store, jobq_bin=Path('/home/muk/projects/siminfeng/bin/jobq'), jobq_dir=None):
        self.store = store
        self.jobq_bin = Path(jobq_bin).resolve()
        # Default = the host's shared supervisor queue (jobq's own default, <repo>/lab/jobq), so
        # factory gpu/build jobs are serialized with every other GPU/build job on the host and
        # served by the running worker. A private queue would have no worker and no exclusivity.
        self.jobq_dir = Path(jobq_dir or os.environ.get('JOBQ_DIR')
                             or self.jobq_bin.parents[1] / 'lab' / 'jobq').resolve()

    @contextmanager
    def locked(self):
        with (self.store.home / 'jobs.lock').open('a') as stream:
            fcntl.flock(stream, fcntl.LOCK_EX)
            yield

    def _qdir(self, attempt):
        # Reconcile an attempt against the queue it was submitted to (recorded before launch),
        # not whatever queue this Jobs instance defaults to now.
        return Path((attempt.get('resources') or {}).get('jobq_dir') or self.jobq_dir)

    def _call(self, *args, env_extra=None, qdir=None):
        env = dict(os.environ, **(env_extra or {}))
        env.update(JOBQ_DIR=str(qdir or self.jobq_dir),
                   PATH='/usr/local/cuda/bin:' + env.get('PATH', os.defpath),
                   DOCKER_CMD_PREFIX='sg docker -c')
        return subprocess.run([sys.executable, str(self.jobq_bin), *map(str, args)],
            env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, check=True)

    def _get(self, attempt_id):
        row = self.store._db.execute('SELECT * FROM attempts WHERE attempt_id=?', (attempt_id,)).fetchone()
        if row is None:
            raise NotFound('Attempt not found')
        return self.store._decode('attempts', row)

    def _recover(self, attempt):
        if attempt['jobq_id']:
            return attempt
        # The unique name is persisted before launch. Recover the acknowledgement
        # after a submitter crash; jobq has no idempotency key of its own.
        for path in self._qdir(attempt).glob('job-*.json'):
            job = json.loads(path.read_text())
            if job['name'] == 'factory:' + attempt['attempt_id']:
                return metadata(self.store, attempt, jobq_id=job['id'])
        return attempt

    def submit(self, task_id, kind, request: dict, idem_key: str, job_class, argv,
               timeout_s, env_extra):
        if not isinstance(idem_key, str) or not idem_key.strip():
            raise ValueError('idem_key must be nonempty')
        if job_class not in {'build', 'gpu', 'cpu'} or not argv:
            raise ValueError('Invalid job class or argv')
        if not math.isfinite(timeout_s) or timeout_s < 0:
            raise ValueError('Invalid timeout')
        argv = list(map(str, argv))
        fp = fingerprint(kind, request, argv, job_class, timeout_s)
        with self.locked():
            row = self.store._db.execute('SELECT * FROM attempts WHERE task_id=? AND idem_key=?',
                                        (task_id, idem_key)).fetchone()
            if row:
                attempt = self.store._decode('attempts', row)
                if attempt['fingerprint'] != fp:
                    raise KeyConflict('Idempotency key names different inputs')
                return self._recover(attempt)
            attempt = self.store.create_attempt(task_id, dict(kind=kind, request=request,
                idem_key=idem_key, fingerprint=fp, resources=dict(argv=argv,
                job_class=job_class, timeout_s=timeout_s, jobq_dir=str(self.jobq_dir))))
            actual = [arg.replace('{attempt_id}', attempt['attempt_id']) for arg in argv]
            try:
                jid = self._call('submit', '--class', job_class, '--name',
                    'factory:' + attempt['attempt_id'], '--timeout', timeout_s, '--', *actual,
                    env_extra=env_extra).stdout.strip()
            except (OSError, subprocess.SubprocessError):
                # Submission may have reached jobq even if its acknowledgement
                # was lost. Preserve identity and reconcile, never blindly retry.
                attempt = self._recover(attempt)
                if attempt['jobq_id']:
                    return attempt
                return self.store.transition_attempt(task_id, attempt['attempt_id'], 'unknown')
            return metadata(self.store, attempt, jobq_id=jid)

    def status(self, attempt_id):
        with self.locked():
            attempt = self._recover(self._get(attempt_id))
            if not attempt['jobq_id']:
                job = None
            else:
                try:
                    job = json.loads(self._call('show', attempt['jobq_id'], qdir=self._qdir(attempt)).stdout)
                except subprocess.CalledProcessError:
                    if (self._qdir(attempt) / (attempt['jobq_id'] + '.json')).exists():
                        raise
                    job = None
            state = job['state'] if job else 'unknown'
            detail = state
            if state in {'timeout', 'skipped_dep_failed'}:
                state = 'failed'
            if state not in TERMINAL | {'queued', 'running'}:
                state = 'unknown'
            if job and job.get('stop_reason') == 'cancelled' and state == 'running':
                state = 'cancel_requested'
            if attempt['state'] == 'cancel_requested' and state in {'queued', 'running'}:
                state = 'cancel_requested'
            changes = {}
            if job:
                changes['owner'] = {key: job.get(key) for key in ('pid', 'pgid', 'wrapper_pgid', 'runner_pid')}
                changes['resources'] = dict(attempt['resources'], jobq_state=detail, rc=job.get('rc'),
                                            error=job.get('error'))
                if state in TERMINAL:
                    changes['cleanup_state'] = self._cleanup(job)
            # A fast command may finish between polls. F02 requires observing
            # the intervening running state before queued -> succeeded.
            if attempt['state'] == 'queued' and state == 'succeeded':
                attempt = self.store.transition_attempt(attempt['task_id'], attempt_id, 'running')
            if attempt['state'] == 'running' and state == 'cancelled':
                attempt = self.store.transition_attempt(attempt['task_id'], attempt_id, 'cancel_requested')
            if (attempt['state'] in TERMINAL and state == 'unknown') or (attempt['state'] == 'unknown' and state == 'queued'):
                attempt = metadata(self.store, attempt, state=state,
                    history_entry=dict(state=state, previous=attempt['state']), **changes)
            if attempt['state'] != state and attempt['state'] not in TERMINAL:
                attempt = self.store.transition_attempt(attempt['task_id'], attempt_id, state, **changes)
            elif changes and any(attempt[k] != v for k, v in changes.items()):
                attempt = metadata(self.store, attempt, **changes)
            if detail in {'timeout', 'skipped_dep_failed'} and not any(h.get('detail') == detail for h in attempt['history']):
                attempt = metadata(self.store, attempt, history_entry={'detail': detail})
            return attempt

    @staticmethod
    def _cleanup(job):
        groups = {job.get('pgid'), job.get('wrapper_pgid')} - {None}
        for path in Path('/proc').glob('[0-9]*/stat'):
            try:
                stat = path.read_text().rsplit(')', 1)[1].split()
                if int(stat[2]) in groups:
                    return 'process_group_remaining'
            except (OSError, ValueError, IndexError):
                continue
        # jobq reaps command process groups; it does not prove Docker daemon
        # cleanup. Never run its global container reaper against unrelated jobs.
        return 'process_groups_reaped;containers_unverified'

    def cancel(self, attempt_id):
        attempt = self.status(attempt_id)
        if attempt['state'] in TERMINAL:
            return attempt
        if attempt['state'] != 'cancel_requested':
            attempt = self.store.transition_attempt(attempt['task_id'], attempt_id, 'cancel_requested')
        if not attempt['jobq_id']:
            return self.status(attempt_id)
        self._call('cancel', attempt['jobq_id'], qdir=self._qdir(attempt))
        while True:
            attempt = self.status(attempt_id)
            if attempt['state'] in TERMINAL | {'unknown'}:
                return attempt
            time.sleep(.05)

    def retry(self, attempt_id, new_idem_key):
        attempt = self.status(attempt_id)
        if attempt['state'] not in TERMINAL:
            raise ValueError('Retry requires an observed terminal attempt')
        if new_idem_key == attempt['idem_key']:
            raise KeyConflict('Retry requires a new idempotency key')
        r = attempt['resources']
        env = {}
        job_path = self._qdir(attempt) / (attempt['jobq_id'] + '.json')
        if job_path.exists():
            job = json.loads(job_path.read_text())
            if job.get('env_file'):
                env = json.loads(Path(job['env_file']).read_text())
        if attempt['kind'] == 'build':
            env.update(attempt['request'].get('env', {}), FACTORY_HOME=str(self.store.home))
        result = self.submit(attempt['task_id'], attempt['kind'], attempt['request'], new_idem_key,
                             r['job_class'], r['argv'], r['timeout_s'], env)
        if not any(h.get('retry_of') == attempt_id for h in result['history']):
            result = metadata(self.store, result, history_entry={'retry_of': attempt_id})
        return result

    def result(self, attempt_id):
        attempt = self.status(attempt_id)
        return dict(attempt_id=attempt_id, state=attempt['state'],
                    result_refs=attempt['result_refs'] if attempt['state'] == 'succeeded' else [])
"""Validated Builder submissions; compilation runs entirely under jobq."""
from __future__ import annotations

import hashlib
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

from .jobs import Jobs, KeyConflict, fingerprint
from .store import encoded

ENGINE = Path('/home/muk/projects/siminfeng/cc/build_engine/build_engine.py')
RECIPE = Path('/home/muk/projects/siminfeng/builds/llamacpp-jetson/Dockerfile')
# Explicit environment inputs affecting compilation. Credentials never enter receipts.
ENV_KEYS = {'PATH', 'LD_LIBRARY_PATH', 'BUILD_JOBS', 'CC', 'CXX', 'CUDAHOSTCXX',
            'CUDACXX', 'CUDA_HOME', 'CUDA_PATH', 'CFLAGS', 'CXXFLAGS', 'LDFLAGS',
            'CCACHE_DIR', 'CCACHE_BASEDIR', 'CCACHE_COMPILERCHECK', 'CCACHE_NOHASHDIR',
            'FACTORY_BUILD_ENGINE', 'BASE_RUNTIME'}


class Builder:
    def __init__(self, store, jobq_bin=Path('/home/muk/projects/siminfeng/bin/jobq'), jobq_dir=None):
        self.store = store
        self.jobs = Jobs(store, jobq_bin, jobq_dir)
        # Reused attempts retain their original identity. Bind additional keys
        # durably so a later request cannot silently change a reuse key's input.
        with store._transaction():
            store._db.execute('CREATE TABLE IF NOT EXISTS builder_reuse_keys (task_id TEXT NOT NULL, idem_key TEXT NOT NULL, fingerprint TEXT NOT NULL, attempt_id TEXT NOT NULL, PRIMARY KEY(task_id, idem_key))')

    def _request(self, request):
        if not isinstance(request, dict) or request.get('target') != 'jetson-orin':
            raise ValueError('target must be jetson-orin')
        if set(request) - {'target', 'source', 'patch', 'tag', 'deadline_s', 'env'}:
            raise ValueError('Unknown build request fields')
        source = request['source']
        path = Path(source['path']).expanduser().resolve()
        def git(*args):
            return subprocess.run(['git', '-C', str(path), *args], check=True,
                stdin=subprocess.DEVNULL, capture_output=True, text=True).stdout.strip()
        try:
            commit = git('rev-parse', 'HEAD')
            if commit != source['commit'] or git('status', '--porcelain', '--untracked-files=all'):
                raise ValueError('Source must be clean and HEAD must equal commit')
            tree = git('rev-parse', 'HEAD^{tree}')
        except subprocess.CalledProcessError as exc:
            raise ValueError('Source must be a git repository') from exc
        if not isinstance(request.get('tag'), str) or not re.fullmatch(r'factory/llamacpp:[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}', request['tag']):
            raise ValueError('tag must use factory/llamacpp namespace')
        deadline = request.get('deadline_s') or 5400
        if isinstance(deadline, bool) or not isinstance(deadline, (int, float)) or not math.isfinite(deadline) or deadline <= 0:
            raise ValueError('deadline_s must be positive and finite')
        extra = request.get('env', {})
        if not isinstance(extra, dict) or set(extra) - ENV_KEYS or not all(isinstance(v, str) for v in extra.values()):
            raise ValueError('Invalid build environment')
        env = {key: os.environ[key] for key in ENV_KEYS if key in os.environ}
        env.update(extra)
        # Normalize the actual environment jobq will capture.
        env['PATH'] = env.get('PATH', os.defpath)
        engine = Path(env.get('FACTORY_BUILD_ENGINE', ENGINE)).resolve()
        normalized = dict(target='jetson-orin', source=dict(path=str(path), commit=commit, tree=tree),
            tag=request['tag'], deadline_s=deadline, env=env,
            engine_sha256=hashlib.sha256(engine.read_bytes()).hexdigest(),
            recipe_sha256=hashlib.sha256(RECIPE.read_bytes()).hexdigest())
        if request.get('patch'):
            patch = Path(request['patch']).expanduser().resolve()
            normalized.update(patch=str(patch), patch_sha256=hashlib.sha256(patch.read_bytes()).hexdigest())
        return normalized

    def submit(self, task_id, request, idem_key):
        self.store.get_task(task_id)
        if not isinstance(idem_key, str) or not idem_key.strip():
            raise ValueError('idem_key must be nonempty')
        request = self._request(request)
        # Stable request path and argv keep attempt identity out of its fingerprint.
        digest = hashlib.sha256(encoded(request).encode()).hexdigest()
        root = self.store.home / 'requests'
        root.mkdir(exist_ok=True)
        request_path = root / (digest + '.json')
        if not request_path.exists():
            fd, name = tempfile.mkstemp(dir=root)
            with os.fdopen(fd, 'w') as stream:
                json.dump(request, stream, sort_keys=True)
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(name, request_path)
        argv = [sys.executable, '-m', 'jiuwenswarm.factory.build_job', '--task', task_id,
                '--attempt', '{attempt_id}', '--request', str(request_path)]
        fp = fingerprint('build', request, argv, 'build', request['deadline_s'])
        # Reconcile matching jobs before deciding whether completed output can
        # be reused. No caller needs to have polled their success previously.
        candidates = self.store._db.execute("SELECT attempt_id FROM attempts WHERE task_id=? AND kind='build' AND fingerprint=?", (task_id, fp)).fetchall()
        for candidate in candidates:
            self.jobs.status(candidate['attempt_id'])
        # Reuse is task-local and limited to observed successful output.
        with self.jobs.locked():
            alias = self.store._db.execute('SELECT * FROM builder_reuse_keys WHERE task_id=? AND idem_key=?', (task_id, idem_key)).fetchone()
            if alias:
                if alias['fingerprint'] != fp:
                    raise KeyConflict('Idempotency key names different inputs')
                return self.jobs._get(alias['attempt_id'])
            keyed = self.store._db.execute('SELECT fingerprint FROM attempts WHERE task_id=? AND idem_key=?', (task_id, idem_key)).fetchone()
            if keyed and keyed['fingerprint'] != fp:
                raise KeyConflict('Idempotency key names different inputs')
            if not keyed:
                rows = self.store._db.execute("SELECT * FROM attempts WHERE task_id=? AND kind='build' AND fingerprint=? AND state='succeeded'", (task_id, fp)).fetchall()
                if rows:
                    result = self.store._decode('attempts', rows[0])
                    with self.store._transaction():
                        self.store._db.execute('INSERT INTO builder_reuse_keys VALUES (?,?,?,?)',
                            (task_id, idem_key, fp, result['attempt_id']))
                    return result
        env = dict(request['env'], FACTORY_HOME=str(self.store.home))
        return self.jobs.submit(task_id, 'build', request, idem_key, 'build', argv, request['deadline_s'], env)

    def status(self, attempt_id):
        return self.jobs.status(attempt_id)

    def cancel(self, attempt_id):
        return self.jobs.cancel(attempt_id)

    def result(self, attempt_id):
        return self.jobs.result(attempt_id)


def submit(store, task_id, request, idem_key):
    return Builder(store).submit(task_id, request, idem_key)


def status(store, attempt_id):
    return Builder(store).status(attempt_id)


def cancel(store, attempt_id):
    return Builder(store).cancel(attempt_id)


def result(store, attempt_id):
    return Builder(store).result(attempt_id)
"""Builder worker. Invoke only as a durable jobq command."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import time

from .builder import ENGINE, RECIPE
from .jobs import metadata
from .store import Store


class PreparationError(Exception):
    def __init__(self, error):
        self.error = error
        super().__init__(error['code'])


def command(argv, *, required=True):
    actual = argv
    if argv[0] == 'docker' and os.environ.get('DOCKER_CMD_PREFIX'):
        actual = shlex.split(os.environ['DOCKER_CMD_PREFIX']) + [shlex.join(argv)]
    try:
        process = subprocess.run(actual, stdin=subprocess.DEVNULL, capture_output=True,
                                 text=True, timeout=1800)
    except (OSError, subprocess.TimeoutExpired) as exc:
        if required:
            raise PreparationError(dict(code='TOOLCHAIN_MISSING', tool=argv[0] if argv[0] != 'docker' else 'docker buildx',
                                        path=os.environ.get('PATH', ''))) from exc
        return dict(available=False, detail=type(exc).__name__)
    if process.returncode and required:
        raise PreparationError(dict(code='TOOLCHAIN_MISSING', tool=argv[0] if argv[0] != 'docker' else 'docker buildx',
                                    path=os.environ.get('PATH', ''), rc=process.returncode))
    return dict(available=process.returncode == 0, rc=process.returncode,
                stdout=process.stdout[-65536:], stderr=process.stderr[-65536:])


def prepare(root, prep):
    prep['toolchain'] = {}
    for tool in ('nvcc', 'gcc', 'cmake', 'ninja', 'docker'):
        location = shutil.which(tool)
        if not location:
            raise PreparationError(dict(code='TOOLCHAIN_MISSING', tool=tool,
                                        path=os.environ.get('PATH', '')))
        args = [tool, 'buildx', 'version'] if tool == 'docker' else [tool, '--version']
        prep['toolchain'][tool] = dict(path=location, **command(args))
    release = Path('/etc/nv_tegra_release')
    prep['nv_tegra_release'] = release.read_text() if release.exists() else None
    prep['nvidia-jetpack'] = command(['dpkg-query', '-W', '-f=${Version}', 'nvidia-jetpack'], required=False)
    prep['disk_free_bytes'] = shutil.disk_usage(root).free
    if prep['disk_free_bytes'] < 8 * 1024 ** 3:
        raise PreparationError(dict(code='DISK_SPACE_LOW', free_bytes=prep['disk_free_bytes'], required_bytes=8 * 1024 ** 3))
    prep['ccache'] = command(['ccache', '-s', '-v'], required=False)
    match = re.search(r'^ARG BASE_RUNTIME=(\S+)', RECIPE.read_text(), re.M)
    reference = os.environ.get('BASE_RUNTIME') or (match.group(1) if match else '')
    if not re.fullmatch(r'nvcr.io/nvidia/l4t-cuda:12\.6\.11-runtime@sha256:[0-9a-f]{64}', reference):
        raise PreparationError(dict(code='BASE_IMAGE_NOT_PINNED'))
    inspected = command(['docker', 'image', 'inspect', reference], required=False)
    prep['base_images'] = {'runtime': {'reference': reference, 'cache_hit': inspected['available']}}
    prep['cache_hit'] = inspected['available']
    if not inspected['available']:
        pulled = command(['docker', 'pull', reference], required=False)
        if not pulled['available']:
            raise PreparationError(dict(code='BASE_IMAGE_PULL_FAILED', reference=reference, detail=pulled))
    prep['status'] = 'success'


def tail(path):
    with path.open('rb') as stream:
        stream.seek(max(0, path.stat().st_size - 65536))
        return stream.read().decode('utf-8', errors='replace')


def run(store, task_id, attempt_id, request):
    attempt = store.read(task_id, attempt_id)
    if attempt['request'] != request:
        raise ValueError('Worker request differs from persisted identity')
    # mkdir(exist_ok=False) prevents worker replay from overwriting any output.
    root = store.home / 'builds' / attempt_id
    root.mkdir(parents=True, exist_ok=False)
    out = root / 'engine'  # Must not exist when build_engine is started.
    stdout, stderr = root / 'stdout.log', root / 'stderr.log'
    stdout.touch()
    stderr.touch()
    prep = dict(status='failed', request_fingerprint=attempt['fingerprint'], cache_hit=None)
    record = {}
    error = {}
    rc = 1
    started = time.monotonic()
    try:
        engine = Path(os.environ.get('FACTORY_BUILD_ENGINE', ENGINE)).resolve()
        for path, expected in ((engine, request['engine_sha256']), (RECIPE, request['recipe_sha256'])):
            if hashlib.sha256(path.read_bytes()).hexdigest() != expected:
                raise PreparationError(dict(code='INPUT_CHANGED', path=str(path)))
        if request.get('patch') and hashlib.sha256(Path(request['patch']).read_bytes()).hexdigest() != request['patch_sha256']:
            raise PreparationError(dict(code='INPUT_CHANGED', path=request['patch']))
        prepare(root, prep)
        # Persist preparation before compilation, including on abrupt termination.
        (root / 'prep.json').write_text(json.dumps(prep, indent=2) + '\n')
        argv = [sys.executable, str(engine), '--target', 'jetson-orin',
                '--source', request['source']['path'], '--commit', request['source']['commit'],
                '--tag', request['tag'], '--out', str(out)]
        if request.get('patch'):
            argv += ['--patch', request['patch']]
        with stdout.open('wb') as output, stderr.open('wb') as errors:
            rc = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=output, stderr=errors).returncode
        if (out / 'build-record.json').exists():
            record = json.loads((out / 'build-record.json').read_text())
        if rc == 0 and (record.get('status') != 'success' or not (record.get('image') or {}).get('Id')):
            rc = 1
            error = dict(code='BUILD_RECORD_INVALID')
    except PreparationError as exc:
        error = exc.error
        prep.update(status='failed', error=error)
    except (OSError, ValueError, KeyError) as exc:
        error = dict(code='BUILD_WORKER_ERROR', detail=str(exc))
    finally:
        (root / 'prep.json').write_text(json.dumps(prep, indent=2) + '\n')
        refs = []
        def artifact(name, data, media='application/json'):
            item = store.put_artifact(task_id, attempt_id + ':' + name, data, media, attempt_id)
            refs.append(item['artifact_id'])
            return {'artifact_id': item['artifact_id'], 'sha256': item['sha256']}
        request_ref = artifact('request', json.dumps(dict(fingerprint=attempt['fingerprint'], request=request), sort_keys=True).encode())
        prep_ref = artifact('prep', root / 'prep.json')
        record_ref = None
        if (out / 'build-record.json').exists():
            record_ref = artifact('build-record', out / 'build-record.json')
        for name, path in (('stdout', stdout), ('stderr', stderr)):
            artifact(name, path, 'text/plain')
            artifact(name + '-tail', tail(path).encode(), 'text/plain')
        image_id = (record.get('image') or {}).get('Id')
        receipt = dict(request_fingerprint=attempt['fingerprint'], request=request_ref,
                       prep=prep_ref, build_record=record_ref, image_id=image_id)
        artifact('receipt', json.dumps(receipt, sort_keys=True).encode())
        values = dict(status='success' if rc == 0 else 'failed',
            failure_stage=record.get('failure_stage') or (None if rc == 0 else 'prep' if prep['status'] != 'success' else 'build'),
            image_id=image_id, tag=request['tag'], source_commit=request['source']['commit'],
            source_tree=record.get('source', {}).get('tree', request['source']['tree']),
            patch_sha256=record.get('patch_sha256', request.get('patch_sha256')),
            toolchain=record.get('toolchain', prep.get('toolchain', {})),
            base_images=record.get('base_images', prep.get('base_images', {})),
            build_wall_seconds=record.get('build_wall_seconds', time.monotonic() - started),
            cache_hit=prep.get('cache_hit'))
        observation = store.append_observation(task_id, dict(obs_id=attempt_id + ':build-result',
            kind='build_result', values=values, error=error, source_artifacts=list(refs),
            host_run=dict(attempt_id=attempt_id, jobq_id=os.environ.get('JOBQ_JOB_ID'), receipt=receipt)))
        refs.append(observation['obs_id'])
        metadata(store, attempt, result_refs=refs)
    return 0 if rc == 0 else 1


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--task', required=True)
    parser.add_argument('--attempt', required=True)
    parser.add_argument('--request', required=True, type=Path)
    args = parser.parse_args()
    with Store(Path(os.environ['FACTORY_HOME'])) as store:
        return run(store, args.task, args.attempt, json.loads(args.request.read_text()))


if __name__ == '__main__':
    raise SystemExit(main())

