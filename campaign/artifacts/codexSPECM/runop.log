/fixtures/cal2/bench-0.status.json\ncc/host_calibrate/tests/fixtures/cal2/CUDA0-MUL_MAT_ID.status.json\ncc/host_calibrate/tests/fixtures/cal2/CPU-MUL_MAT.stdout\ncc/host_calibrate/tests/fixtures/cal2/bench-0.stdout\ncc/host_calibrate/tests/fixtures/cal2/lscpu.status.json\ncc/host_calibrate/tests/fixtures/cal2/h2d.stdout\ncc/host_calibrate/tests/fixtures/bench-real.json\ncc/host_calibrate/tests/fixtures/cpu-expert-real.txt\ncc/host_calibrate/tests/fixtures/lscpu-real.txt\ncc/host_calibrate/bw.cu\ncc/host_calibrate/calibrate.py\ncc/host_calibrate/bw_cpu.c\ncc/host_calibrate/run_plan.py\ncc/host_calibrate/apply.py\nartifacts/codexQRT/prose-inspect.json\nartifacts/codexQRT/chat.jsonl\nartifacts/codexQRT/chat.stdout\nartifacts/codexQRT/code.stderr\nartifacts/codexQRT/prose.stderr\nartifacts/codexQRT/code-inspect.json\nartifacts/codexQRT/prose.jsonl\nartifacts/codexQRT/tree/AGENTS.md\n","exit_code":0,"status":"completed"}}
