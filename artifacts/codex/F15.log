+      patch: json
+      expected_graph_rev: json
+      decision_rev: json
+    gives:
+      plan: json
+    needs:
+    - python
+    changes:
+    - process.exec
   query:
     kind: tool
     does: Query bounded task-scoped evidence summaries and cursor.
