MODEL = '/home/muk/models/campaign/gguf/granite-3.1-1b-a400m-instruct-Q8_0.gguf'
ARGS = ['-m', MODEL, '-p', 'The capital of France is', '-n', '32', '-c', '512',
        '--temp', '0', '-s', '1', '-no-cnv', '-cmoe', '-lm', 'mmap', '-t', '4']
BASE = {'LLAMA_EXPERT_FILL': '1', 'LLAMA_EXPERT_FILL_RANDOM': 'decode',
        'LLAMA_EXPERT_FILL_MAX_TOKENS': '1', 'LLAMA_EXPERT_PREGATE': '1', 'LLAMA_EXPERT_PREGATE_K': '8'}
SETTINGS = {'p12': ('trace', {'LLAMA_EXPERT_TRACE': str(OUT / 'p12-trace.csv')}),
            'p13': ('populate', {'LLAMA_EXPERT_FILL_BACKEND': 'populate'}),
            'p14': ('pin', {'LLAMA_EXPERT_PIN_MIB': '64'}),
            'p15': ('temporal', {'LLAMA_EXPERT_PREGATE_MODE': 'temporal'})}


def run(binary, name, switches, args=ARGS, lock_limit=None):
    env = {key: value for key, value in os.environ.items() if not key.startswith('LLAMA_EXPERT_')}
    env.update(BASE)
    env.update(switches)
    def limits():
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        if lock_limit is not None:
            resource.setrlimit(resource.RLIMIT_MEMLOCK, (lock_limit, lock_limit))
    with (OUT / (name + '.stdout')).open('wb') as stdout, (OUT / (name + '.stderr')).open('wb') as stderr:
        result = subprocess.run([str(binary), *args], env=env, stdout=stdout, stderr=stderr, preexec_fn=limits)
    digest = hashlib.sha256((OUT / (name + '.stdout')).read_bytes()).hexdigest()
    stats = [line for line in (OUT / (name + '.stderr')).read_text().splitlines()
             if line.startswith(('expert_config:', 'expert_fill: stats', 'expert_trace:', 'expert_pin:', 'expert_pregate:'))]
    return {'exit_code': result.returncode, 'stdout_sha256': digest, 'stats': stats, 'switches': switches}


def main():
    patch = sys.argv[1]
    build, switches = SETTINGS[patch]
    binary = ROOT / ('build-' + build) / 'bin/llama-completion'
    if patch == 'p12':
        (OUT / 'p12-trace.csv').unlink(missing_ok=True)
    results = {}
    for suffix, setting in [('off', {}), ('on', switches)]:
        results[suffix] = run(binary, patch + '-' + suffix, setting)
        print(patch, suffix, results[suffix], flush=True)
    assert results['off']['exit_code'] == results['on']['exit_code'] == 0, results
    assert results['off']['stdout_sha256'] == results['on']['stdout_sha256'], results
    if patch == 'p12':
        results['trace_only'] = run(binary, patch + '-trace-only',
                                    {**switches, 'LLAMA_EXPERT_FILL': '0', 'LLAMA_EXPERT_PREGATE': '0',
                                     'LLAMA_EXPERT_TRACE': str(OUT / 'p12-trace-only.csv')})
    if patch == 'p14':
        results['locked'] = run(binary, patch + '-locked', {'LLAMA_EXPERT_PIN_MIB': '4'})
        results['willneed'] = run(binary, patch + '-willneed', switches, lock_limit=0)
        assert any('mode=mlock' in line and 'pinned_experts=0' not in line for line in results['locked']['stats'])
        assert any('mode=willneed' in line for line in results['willneed']['stats'])
    if patch == 'p15':
        results['hybrid'] = run(binary, patch + '-hybrid', {'LLAMA_EXPERT_PREGATE_MODE': 'hybrid'})
    for item in results.values():
        assert item['exit_code'] == 0 and item['stdout_sha256'] == results['off']['stdout_sha256'], item
    # Invalid values and unknown LLAMA_EXPERT_* names must abort even with switches off.
    invalid = {'p12': {'LLAMA_EXPERT_TRACE': ''}, 'p13': {'LLAMA_EXPERT_FILL_BACKEND': 'bogus'},
               'p14': {'LLAMA_EXPERT_PIN_MIB': '8193'}, 'p15': {'LLAMA_EXPERT_PREGATE_MODE': 'bogus'}}
    results['invalid'] = run(binary, patch + '-invalid', invalid[patch])
    results['unknown'] = run(binary, patch + '-unknown', {'LLAMA_EXPERT_UNRECOGNIZED': '1'})
    assert results['invalid']['exit_code'] == results['unknown']['exit_code'] == -6
    (OUT / (patch + '-checks.json')).write_text(json.dumps(results, indent=2) + '\\n')
    print(patch, 'PASS', flush=True)


if __name__ == '__main__':
    main()
