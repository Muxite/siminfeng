#ifdef __linux__
void llama_context::expert_fill_init() {
    if (expert_fill_checked) { return; }
    expert_fill_checked = true;
    if (!expert_config.fill) { return; }
    try {
        for (const auto & layer : model.layers) {
            for (const ggml_tensor * w : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
                if (!w) { continue; }
                llama_model::expert_file_range info;
                if (w->ne[2] <= 0 || w->ne[3] != 1 || !ggml_is_contiguous(w) || !w->nb[2] ||
                        !model.expert_file_info(w, info)) {
                    throw std::runtime_error("expert tensors not mmap-backed or file offsets unavailable/unsupported layout");
                }
                if (!expert_fillers.count(info.file_index)) {
                    expert_fillers.emplace(info.file_index, std::make_unique<ExpertFiller>(
                        "/proc/self/fd/" + std::to_string(info.source_fd), info.mapping, info.mapping_size, expert_config));
                }
            }
        }
        if (expert_fillers.empty()) { throw std::runtime_error("no mmap-backed expert tensors"); }
        expert_prefetch_layers.resize(model.layers.size());
        expert_fill_enabled = true;
        expert_pregate_init();
        expert_diag_enabled = expert_fillers.begin()->second->diagnostic();
        if (expert_diag_enabled) {
            if (!expert_config.diag_csv.empty()) {
                expert_diag_csv = fopen(expert_config.diag_csv.c_str(), "w");
                if (!expert_diag_csv) { throw std::runtime_error("cannot open diagnostic CSV"); }
                fprintf(expert_diag_csv, "token_idx,fill_ns,between_ns,majflt_fill,majflt_between,post_fill_nonresident_pages,pre_use_nonresident_pages,bytes_read\n");
            }
        }
        expert_fill_random_decode = expert_config.random == "decode";
        expert_fill_min_tokens = expert_config.min_tokens;
        expert_fill_max_tokens = expert_config.max_tokens;
        const auto & filler = *expert_fillers.begin()->second;
        LLAMA_LOG_INFO("expert_fill: active threads=%zu chunk_kib=%zu random=%s files=%zu\n",
            filler.threads(), filler.chunk_bytes() / 1024, expert_config.random.c_str(), expert_fillers.size());
    } catch (const std::exception & e) {
        expert_fill_enabled = false; expert_diag_enabled = false;
        if (expert_diag_csv) { fclose(expert_diag_csv); expert_diag_csv = nullptr; }
        expert_fillers.clear();
        LLAMA_LOG_INFO("expert_fill: inactive (%s)\n", e.what());
    }
}

// Qwen35MoE (the Qwen3.6 GGUF uses this arch):
// x_L = RMSNorm(attention_L + residual_L, attn_post_norm_L, eps).
// logits = W*x, p = softmax(logits), ids = topk(p); no gate_inp_b,
// no exp_probs_b, no groups. Selected weights are normalized AFTER top-k.
// softmax is monotone, so ranking logits gives the same IDs (ties by ID).
void llama_context::expert_pregate_init() {
    if (!expert_config.pregate) { return; }
    try {
        if (model.arch != LLM_ARCH_QWEN35MOE || model.hparams.n_expert_groups > 1 || !loras->empty() || !model.hdmd.rot.empty()) {
            throw std::runtime_error("pregate requires qwen35moe without groups, LoRA, or folded rotations");
        }
        expert_pregate_before = expert_config.order == "before";
        expert_pregate_k = expert_config.k;
        expert_pregate_layers.resize(model.hparams.n_layer()); // excludes unexecuted MTP blocks
        const long page = sysconf(_SC_PAGESIZE);
        if (page <= 0) { throw std::runtime_error("invalid page size"); }
        // Decode/copy from file once, never GPU tensor data. Original mmap may have holes.
        for (size_t il = 1; il < expert_pregate_layers.size(); ++il) {
            const auto * w = model.layers[il].ffn_gate_inp;
            llama_model::expert_file_range info;
            if (!w || !ggml_is_contiguous(w) || w->ne[0] != model.hparams.n_embd ||
                    w->ne[1] != model.hparams.n_expert || w->ne[2] != 1 || w->ne[3] != 1 ||
                    !model.expert_file_info(w, info, false)) {
                throw std::runtime_error("router file offsets/layout unavailable");
            }
            const auto * traits = ggml_get_type_traits(w->type);
            if (w->type != GGML_TYPE_F32 && !traits->to_float) {
                throw std::runtime_error("router type has no CPU decoder");
            }
            auto & dst = expert_pregate_layers[il].router;
            dst.resize(ggml_nelements(w));
            const size_t first = info.offset / size_t(page) * size_t(page);
            const size_t delta = info.offset - first, len = delta + ggml_nbytes(w);
            void * ptr = mmap(nullptr, len, PROT_READ, MAP_PRIVATE, info.source_fd, off_t(first));
            if (ptr == MAP_FAILED) { throw std::runtime_error("router file mmap failed"); }
            const char * data = static_cast<const char *>(ptr) + delta;
            if (w->type == GGML_TYPE_F32) { memcpy(dst.data(), data, ggml_nbytes(w)); }
            else {
                for (int64_t row = 0; row < w->ne[1]; ++row) {
                    traits->to_float(data + row * w->nb[1], dst.data() + row * w->ne[0], w->ne[0]);
                }
            }
            munmap(ptr, len);
        }
        expert_pregate_enabled = true;
        LLAMA_LOG_INFO("expert_pregate: active k=%zu arch=qwen35moe gating=softmax router=file-cpu-copy order=%s\n",
            expert_pregate_k, expert_pregate_before ? "before" : "after");
    } catch (const std::exception & e) {
        expert_pregate_layers.clear();
        LLAMA_LOG_INFO("expert_pregate: inactive (%s)\n", e.what());
    }
}

void llama_context::expert_pregate_arrive(size_t il, const std::vector<int32_t> & selected) {
    if (!expert_fill_decode || !expert_fill_this_ubatch || il >= expert_pregate_layers.size()) { return; }
    auto & current = expert_pregate_layers[il];
    // Gather both distances before sampling. Each file's entire arrival snapshot
    // and cancellation share its dispatch lock, so queued means cancelled.
    std::map<ExpertFiller *, std::vector<ExpertFiller::Async>> observed;
    for (const auto & predictions : current.predictions) {
        for (const auto & prediction : predictions) {
            for (const auto & b : prediction.batches) { observed[b.first].push_back(b.second); }
        }
    }
    std::map<const ExpertFiller::AsyncBatch *, ExpertFiller::AsyncState> snapshots;
    for (auto & entry : expert_fillers) {
        auto & batches = observed[entry.second.get()];
        const auto states = entry.second->arrive_async_through(il, batches);
        for (size_t i = 0; i < batches.size(); ++i) { snapshots[batches[i].get()] = states[i]; }
    }

    for (size_t d = 0; d < expert_config.lookahead; ++d) {
        const auto & predictions = current.predictions[d];
        if (predictions.empty()) { continue; }
        ++pregate_arrivals;
        pregate_actual += selected.size(); pregate_predicted += predictions.size();
        pregate_actual_d[d] += selected.size();
        uint64_t pending = 0, running = 0;
        for (const auto & prediction : predictions) {
            const bool hit = std::find(selected.begin(), selected.end(), prediction.id) != selected.end();
            pregate_hits += hit; pregate_hits_d[d] += hit;
            ExpertFiller::AsyncState state;
            for (const auto & b : prediction.batches) { state += snapshots.at(b.second.get()); }
            pregate_timeliness.record(ExpertFiller::classify(prediction.resident_at_predict, state), hit);
            pending += state.pending; running += state.running;
        }
        pregate_pending_reads += pending;
        pregate_inflight_reads += running; pregate_inflight_arrivals += pending != 0;
    }
    // Arrival snapshot/cancellation above always precedes demand, independent of ORDER.
}

void llama_context::expert_pregate_hook(size_t il, const ggml_tensor * t) {
    if (!expert_fill_decode || !expert_fill_this_ubatch || expert_pregate_failed ||
            il + 1 >= expert_pregate_layers.size()) { return; }
    try {
        if (!loras->empty()) { throw std::runtime_error("LoRA activated after pregate initialization"); }
        // Before-node CPU callback runs AFTER the scheduler's host copies and prefix
        // synchronize. src[1] of the FIRST gate/up MUL_MAT_ID is [embd,1,1,1],
        // a reshape/host copy of attn_post_norm, not the down-projection activation.
        const ggml_tensor * x = t->src[1];
        const ggml_tensor * base = x && x->view_src ? x->view_src : x;
        const auto * w = model.layers[il + 1].ffn_gate_inp;
        if (!x || !base || !base->buffer || !ggml_backend_buffer_is_host(base->buffer) ||
                !x->data || x->type != GGML_TYPE_F32 || x->ne[0] != w->ne[0] ||
                x->ne[1] != 1 || x->ne[2] != 1 || x->ne[3] != 1 || !ggml_is_contiguous(x) ||
                (t->src[0] != model.layers[il].ffn_up_exps && t->src[0] != model.layers[il].ffn_gate_exps &&
                 t->src[0] != model.layers[il].ffn_gate_up_exps)) {
            throw std::runtime_error("first expert input is not a host F32 decode MoE vector");
        }
        const auto * input = static_cast<const float *>(x->data);
        // Submit all L+1 experts before L+2; the pool also sorts queued work by
        // target-layer deadline, so a later L+1 submission outranks old L+2 work.
        for (size_t distance = 1; distance <= expert_config.lookahead && il + distance < expert_pregate_layers.size(); ++distance) {
            const size_t target = il + distance;
            const auto * router_weight = model.layers[target].ffn_gate_inp;
            const auto & router = expert_pregate_layers[target].router;
            std::vector<std::pair<float, int32_t>> logits;
            logits.reserve(router_weight->ne[1]);
            for (int64_t e = 0; e < router_weight->ne[1]; ++e) {
                float dot = 0;
                for (int64_t j = 0; j < router_weight->ne[0]; ++j) { dot += router[e * router_weight->ne[0] + j] * input[j]; }
                if (!std::isfinite(dot)) { throw std::runtime_error("nonfinite pregate logits"); }
                logits.emplace_back(dot, int32_t(e));
            }
            const size_t k = std::min(expert_pregate_k, logits.size());
            std::partial_sort(logits.begin(), logits.begin() + k, logits.end(), [](const auto & a, const auto & b) {
                return a.first != b.first ? a.first > b.first : a.second < b.second;
            });
            auto & next = expert_pregate_layers[target];
            auto & predictions = next.predictions[distance - 1];
            predictions.clear();
            const auto & layer = model.layers[target];
            for (size_t i = 0; i < k; ++i) {
                ExpertFiller::Prediction prediction;
                prediction.id = logits[i].second;
                std::map<size_t, std::vector<ExpertFiller::Range>> ranges;
                for (const ggml_tensor * expert : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
                    if (!expert) { continue; }
                    llama_model::expert_file_range info;
                    if (!model.expert_file_info(expert, info)) { throw std::runtime_error("pregate expert offsets unavailable"); }
                    const auto id = prediction.id;
                    if (id < 0 || id >= expert->ne[2]) { throw std::runtime_error("pregate expert ID outside tensor"); }
                    ranges[info.file_index].push_back({info.offset + size_t(id) * expert->nb[2], expert->nb[2]});
                }
                // Residency at prediction time is distinct from completed IO.
                // Probe all files before publishing jobs for this expert.
                std::vector<size_t> cold;
                for (const auto & entry : ranges) {
                    if (expert_fillers.at(entry.first)->nonresident(entry.second)) { cold.push_back(entry.first); }
                }
                for (const auto & entry : ranges) {
                    auto & filler = *expert_fillers.at(entry.first);
                    prediction.enqueue(filler, entry.second, target, [&](const auto &) {
                        return std::find(cold.begin(), cold.end(), entry.first) == cold.end();
                    }, distance);
                }
                next.predicted.push_back(prediction.id);
                predictions.push_back(std::move(prediction));
            }
            ++pregate_predictions;
        }
    } catch (const std::exception & e) {
        ++pregate_skips; expert_pregate_failed = true;
        LLAMA_LOG_INFO("expert_pregate: prediction disabled (%s)\n", e.what());
    }
}

void llama_context::expert_pregate_stats() {
    uint64_t bytes=0, reads=0, errors=0, dropped=0, cancelled_jobs=0, cancelled_bytes=0, demand_ns=0;
    for (auto & entry : expert_fillers) {
        entry.second->wait_async(); // teardown only, after graph synchronize
        demand_ns += entry.second->counters().total_fill_wall_ns;
    expert_diag_token = {}; expert_diag_token_active = false;
    expert_diag_layers.clear(); expert_diag_previous.clear();
}
void llama_context::expert_diag_pre_use(size_t il) {
    if (!expert_diag_enabled || !expert_diag_token_active) { return; }
    auto it = expert_diag_layers.find(il);
    if (it == expert_diag_layers.end()) { return; }
    for (const auto & entry : it->second) {
        expert_diag_token.pre_use_nonresident += expert_fillers.at(entry.first)->nonresident(entry.second);
        ++expert_diag_token.pre_use_checks;
    }
}
void llama_context::expert_fill_phase(uint32_t n_tokens) {
    if (expert_diag_enabled) {
        expert_diag_finish_token();
        if (n_tokens == 1) {
            ++expert_diag_token_idx; expert_diag_token_active = true;
            struct rusage r {}; getrusage(RUSAGE_SELF, &r);
            expert_diag_gap_maj = r.ru_majflt; expert_diag_gap_min = r.ru_minflt;
            expert_diag_gap_ns = expert_diag_now(); expert_diag_gap = true;
        }
    }
    expert_fill_decode = n_tokens == 1;
    expert_fill_this_ubatch = n_tokens >= expert_fill_min_tokens &&
        (!expert_fill_max_tokens || n_tokens <= expert_fill_max_tokens);
    if (!expert_fill_enabled || expert_fill_failed || !expert_fill_random_decode ||
            expert_fill_random_applied || !expert_fill_decode) { return; }
    // Transition before the first single-token graph, including when fill is filtered out.
    expert_fill_random_applied = true;
    const long page = sysconf(_SC_PAGESIZE);
    bool ok = page > 0;
    for (const auto & layer : model.layers) {
        for (const ggml_tensor * w : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
            if (!w) { continue; }
            llama_model::expert_file_range info;
            if (!ok || !model.expert_file_info(w, info)) { ok = false; continue; }
            const size_t first = info.offset - info.offset % size_t(page);
            const size_t end = info.offset + ggml_nbytes(w);
            const size_t pad = (size_t(page) - end % size_t(page)) % size_t(page);
            const size_t last = end + std::min(pad, info.mapping_size - end);
            if (madvise(static_cast<char *>(info.mapping) + first, last - first, MADV_RANDOM)) { ok = false; }
        }
    }
    if (ok) {
        LLAMA_LOG_INFO("expert_fill: random advice applied at decode\n");
    } else {
        expert_fill_failed = true;
        LLAMA_LOG_INFO("expert_fill: inactive (decode random advice failed)\n");
    }
}

void llama_context::expert_fill_selected(size_t il, const std::vector<int32_t> & selected) {
    if (expert_fill_failed || !expert_fill_this_ubatch) { return; }
    try {
        std::map<size_t, std::vector<ExpertFiller::Range>> ranges;
        const auto & layer = model.layers[il];
        for (const ggml_tensor * w : {layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps}) {
            if (!w) { continue; }
            llama_model::expert_file_range info;
            if (!model.expert_file_info(w, info)) { throw std::runtime_error("expert mmap/file offsets unavailable"); }
            for (const auto id : selected) {
                if (id < 0 || id >= w->ne[2] || size_t(id) > (SIZE_MAX - info.offset) / w->nb[2]) {
                    throw std::runtime_error("expert slice out of bounds");
                }
                ranges[info.file_index].push_back({info.offset + size_t(id) * w->nb[2], w->nb[2]});
            }
        }
        const bool diag = expert_diag_enabled && expert_diag_token_active;
        struct rusage before {}, after {}, thread_before {}, thread_after {};
        uint64_t start = 0;
        if (diag) {
            // Previous layer was consumed; this is a separate, after-use eviction probe.
            for (const auto & entry : expert_diag_previous) {
                expert_diag_token.next_nonresident += expert_fillers.at(entry.first)->nonresident(entry.second);
                ++expert_diag_token.next_checks;
            }
            expert_diag_close_gap();
            getrusage(RUSAGE_SELF, &before); getrusage(RUSAGE_THREAD, &thread_before);
            start = expert_diag_now();
        }
        for (const auto & entry : ranges) {
            auto & filler = *expert_fillers.at(entry.first);
            ExpertFiller::Counters a {};
            if (diag) { a = filler.counters(); }
            const uint64_t sync_bytes = filler.fill(entry.second, expert_fill_decode);
            if (expert_pregate_enabled && expert_fill_decode && il < expert_pregate_layers.size()) {
                const bool predicted = !expert_pregate_layers[il].predicted.empty();
                (predicted ? pregate_sync_with : pregate_sync_without) += sync_bytes;
                ++(predicted ? pregate_calls_with : pregate_calls_without);
            }
            if (diag) {
                const auto b = filler.counters();
                expert_diag_token.bytes_read += b.bytes_read - a.bytes_read;
                expert_diag_token.thread_majflt += b.thread_majflt - a.thread_majflt;
                expert_diag_token.thread_minflt += b.thread_minflt - a.thread_minflt;
                expert_diag_token.populate_calls += b.populate_calls - a.populate_calls;
                expert_diag_token.populate_ns += b.populate_ns - a.populate_ns;
                expert_diag_token.populate_errors += b.populate_errors - a.populate_errors;
                expert_diag_token.post_nonresident += filler.nonresident(entry.second);
                ++expert_diag_token.post_checks;
            }
        }
        if (diag) {
            getrusage(RUSAGE_SELF, &after); getrusage(RUSAGE_THREAD, &thread_after);
            expert_diag_token.fill_ns += expert_diag_now() - start;
            expert_diag_token.majflt_fill += after.ru_majflt - before.ru_majflt;
            expert_diag_token.minflt_fill += after.ru_minflt - before.ru_minflt;
            expert_diag_token.thread_majflt += thread_after.ru_majflt - thread_before.ru_majflt;
            expert_diag_token.thread_minflt += thread_after.ru_minflt - thread_before.ru_minflt;
            expert_diag_layers[il] = ranges; expert_diag_previous = ranges;
            getrusage(RUSAGE_SELF, &after);
            expert_diag_gap_maj = after.ru_majflt; expert_diag_gap_min = after.ru_minflt;
            expert_diag_gap_ns = expert_diag_now(); expert_diag_gap = true;
        }
    } catch (const std::exception & e) {
        expert_fill_failed = true;
        LLAMA_LOG_INFO("expert_fill: inactive (%s)\n", e.what());
    }
}
#endif

void llama_context::expert_prefetch_advise(size_t il, int32_t id) {
#ifdef __linux__
    auto & state = expert_prefetch_layers[il];
    for (auto it = state.recent.begin(); it != state.recent.end();) {
        if (state.tokens - it->second >= 32) {
            it = state.recent.erase(it);
        } else {
            if (it->first == id) {
                const auto hit = *it;
                state.recent.erase(it);
                state.recent.push_back(hit);
                return;
            }
            ++it;
        }
    }
    const auto & layer = model.layers[il];
    bool advised = false;
    bool failed = false;
    for (const ggml_tensor * w : { layer.ffn_gate_exps, layer.ffn_up_exps, layer.ffn_down_exps, layer.ffn_gate_up_exps }) {
        if (!w) {
            continue;
        }
        if (id < 0 || id >= w->ne[2] || w->ne[3] != 1 || !ggml_is_contiguous(w) ||
                w->nb[2] == 0 || !model.tensor_is_mapped(w)) {
            if (!expert_prefetch_warned) {
                LLAMA_LOG_INFO("expert_prefetch: skipping non-mmap or non-expert-contiguous tensors/invalid ids (once)\n");
                expert_prefetch_warned = true;
            }
            continue;
        }
        static const uintptr_t page = (uintptr_t) sysconf(_SC_PAGESIZE);
        const uintptr_t start = reinterpret_cast<uintptr_t>(w->data) + size_t(id) * w->nb[2];
        if (page == 0 || page == UINTPTR_MAX || start > UINTPTR_MAX - w->nb[2] ||
                start + w->nb[2] > UINTPTR_MAX - (page - 1)) {
            continue;
        }
        const uintptr_t first = start - start % page;
        const uintptr_t end = start + w->nb[2];
        const uintptr_t last = end + (page - end % page) % page;
        ++expert_prefetch_calls;
        expert_prefetch_bytes += last - first;
        if (madvise(reinterpret_cast<void *>(first), last - first, MADV_WILLNEED) != 0) {
            ++expert_prefetch_failures;
            failed = true;
        } else {
            advised = true;
        }
    }
    if (advised && !failed) {
        if (state.recent.size() == 32) {
            state.recent.erase(state.recent.begin());
        }
        state.recent.emplace_back(id, state.tokens);
    }
#else
    (void) il;
    (void) id;
#endif
}

void llama_context::expert_prefetch_cb(ggml_tensor * t, bool ask, bool * observe, void * data) {
    auto & ctx = *static_cast<llama_context *>(data);
#ifdef __linux__
    if (ctx.expert_fill_failed) { return; }
#endif
    if (t->op != GGML_OP_MUL_MAT_ID || !t->src[0] || !t->src[2]) {
        return;
    }
    size_t il = 0;
    for (; il < ctx.model.layers.size(); ++il) {
        const auto & layer = ctx.model.layers[il];
        if (t->src[0] == layer.ffn_up_exps || t->src[0] == layer.ffn_gate_exps ||
                t->src[0] == layer.ffn_down_exps || t->src[0] == layer.ffn_gate_up_exps) {
            break;
        }
    }
#ifdef __linux__
    if (il < ctx.model.layers.size() && ctx.expert_diag_enabled && ctx.expert_diag_token_active &&
            ctx.expert_prefetch_layers[il].observed) {
        *observe = true;
        if (!ask) { ctx.expert_diag_pre_use(il); }
        return;
    }
#endif
    if (il == ctx.model.layers.size() || ctx.expert_prefetch_layers[il].observed) {
        return;
    }
    *observe = true;
    if (ask) {
        return;
    }
    auto & state = ctx.expert_prefetch_layers[il];
    state.observed = true;
    const ggml_tensor * ids = t->src[2];
    const ggml_tensor * base = ids->view_src ? ids->view_src : ids;
    if (ids->type != GGML_TYPE_I32 || ids->ne[2] != 1 || ids->ne[3] != 1 ||
            !ids->data || !base->buffer || !ggml_backend_buffer_is_host(base->buffer) ||
            !strstr(ids->name, "ffn_moe_topk-")) {
        if (!ctx.expert_prefetch_warned) {
#ifdef __linux__
            if (ctx.expert_fill_enabled) {
                ctx.expert_fill_failed = true;
                LLAMA_LOG_INFO("expert_fill: inactive (unsupported host router ids)\n");
            } else
#endif
            LLAMA_LOG_INFO("expert_prefetch: skipping unsupported router ids (once)\n");
            ctx.expert_prefetch_warned = true;
        }
        return;
    }
    std::vector<int32_t> selected;
    for (int64_t token = 0; token < ids->ne[1]; ++token) {
        for (int64_t k = 0; k < ids->ne[0]; ++k) {
            int32_t id;
            memcpy(&id, static_cast<const char *>(ids->data) + token * ids->nb[1] + k * ids->nb[0], sizeof(id));
            if (id >= 0 && id < t->src[0]->ne[2] &&
                    std::find(selected.begin(), selected.end(), id) == selected.end()) {
                selected.push_back(id);
            }
        }
    }
#ifdef __linux__
    if (ctx.expert_fill_enabled) {
        if (ctx.expert_pregate_enabled) {
            ctx.expert_pregate_arrive(il, selected); // cancel before demand
            if (ctx.expert_pregate_before) { ctx.expert_pregate_hook(il, t); }
        }
        ctx.expert_fill_selected(il, selected); // demand for L first by default
        if (ctx.expert_pregate_enabled && !ctx.expert_pregate_before) {
            ctx.expert_pregate_hook(il, t); // ORDER=after (default): enqueue L+1
        }
        if (ctx.expert_diag_enabled) { ctx.expert_diag_pre_use(il); }
        return;
    }
#endif
    state.tokens += ids->ne[1];
    for (int32_t id : state.predicted) {
        ++ctx.expert_prefetch_total;
        ctx.expert_prefetch_hits += std::find(selected.begin(), selected.end(), id) != selected.end();
    }
    state.predicted.clear();
    for (int32_t id : selected) {
        ctx.expert_prefetch_advise(il, id);
    }
    if (ctx.expert_prefetch_next && il + 1 < ctx.model.layers.size()) {
        auto & next = ctx.expert_prefetch_layers[il + 1];
        const ggml_tensor * w = ctx.model.layers[il + 1].ffn_down_exps;
        if (w && !next.observed) {
            for (int32_t id : selected) {
                if (id < w->ne[2]) {
                    next.predicted.push_back(id);
                    ctx.expert_prefetch_advise(il + 1, id);
                }
            }
        }
    }
}

llama_context::~llama_context() {
    // wait for any pending asynchronous copies into the output buffers before they are freed
    synchronize();

#ifdef __linux__
    if (expert_pregate_enabled) { expert_pregate_stats(); }
    if (expert_diag_enabled) {
        expert_diag_finish_token();
        const auto & d = expert_diag_total;
        fprintf(stderr, "expert_fill: diag tokens=%llu", (unsigned long long)expert_diag_token_idx);
        fprintf(stderr, " fill_ns=%llu", (unsigned long long)d.fill_ns);
        fprintf(stderr, " between_ns=%llu", (unsigned long long)d.between_ns);
        fprintf(stderr, " majflt_fill=%llu", (unsigned long long)d.majflt_fill);
        fprintf(stderr, " minflt_fill=%llu", (unsigned long long)d.minflt_fill);
        fprintf(stderr, " majflt_between=%llu", (unsigned long long)d.majflt_between);
        fprintf(stderr, " minflt_between=%llu", (unsigned long long)d.minflt_between);
        fprintf(stderr, " thread_majflt=%llu", (unsigned long long)d.thread_majflt);
        fprintf(stderr, " thread_minflt=%llu", (unsigned long long)d.thread_minflt);
        fprintf(stderr, " post_nonresident=%llu", (unsigned long long)d.post_nonresident);
        fprintf(stderr, " pre_use_nonresident=%llu", (unsigned long long)d.pre_use_nonresident);
        fprintf(stderr, " next_nonresident=%llu", (unsigned long long)d.next_nonresident);
        fprintf(stderr, " bytes_read=%llu", (unsigned long long)d.bytes_read);
        fprintf(stderr, " post_checks=%llu", (unsigned long long)d.post_checks);
        fprintf(stderr, " pre_use_checks=%llu", (unsigned long long)d.pre_use_checks);
        fprintf(stderr, " next_checks=%llu", (unsigned long long)d.next_checks);
        fprintf(stderr, " populate_calls=%llu", (unsigned long long)d.populate_calls);
        fprintf(stderr, " populate_ns=%llu", (unsigned long long)d.populate_ns);
        fprintf(stderr, " populate_errors=%llu", (unsigned long long)d.populate_errors);
        fprintf(stderr, "\n");
        if (expert_diag_csv) { fclose(expert_diag_csv); expert_diag_csv = nullptr; }
    }
    if (!expert_fillers.empty()) {
        ExpertFiller::Counters sum;
        for (const auto & entry : expert_fillers) {
            const auto s = entry.second->counters();
            sum.populate_calls += s.populate_calls; sum.populate_ns += s.populate_ns; sum.populate_errors += s.populate_errors;
            sum.calls += s.calls; sum.ranges += s.ranges;
            sum.bytes_requested += s.bytes_requested; sum.bytes_skipped_resident += s.bytes_skipped_resident;
            sum.bytes_read += s.bytes_read; sum.read_syscalls += s.read_syscalls;
            sum.total_fill_wall_ns += s.total_fill_wall_ns;
            sum.prompt_calls += s.prompt_calls; sum.prompt_bytes_read += s.prompt_bytes_read;
            sum.prompt_fill_wall_ns += s.prompt_fill_wall_ns;
            sum.decode_calls += s.decode_calls; sum.decode_bytes_read += s.decode_bytes_read;
            sum.decode_fill_wall_ns += s.decode_fill_wall_ns;
            sum.max_single_fill_ns = std::max(sum.max_single_fill_ns, s.max_single_fill_ns);
        }
        LLAMA_LOG_INFO("expert_fill: stats calls=%" PRIu64 " ranges=%" PRIu64 " bytes_requested=%" PRIu64
            " bytes_skipped_resident=%" PRIu64 " bytes_read=%" PRIu64 " read_syscalls=%" PRIu64
            " total_fill_wall_ns=%" PRIu64 " max_single_fill_ns=%" PRIu64
            " prompt_calls=%" PRIu64 " prompt_bytes_read=%" PRIu64 " prompt_fill_wall_ns=%" PRIu64
            " decode_calls=%" PRIu64 " decode_bytes_read=%" PRIu64 " decode_fill_wall_ns=%" PRIu64
            " populate_calls=%" PRIu64 " populate_ns=%" PRIu64 " populate_errors=%" PRIu64
            " demand_wait_ns_total=%" PRIu64 " demand_wait_ns_per_token=%.3f\n",
            sum.calls, sum.ranges, sum.bytes_requested, sum.bytes_skipped_resident, sum.bytes_read,
            sum.read_syscalls, sum.total_fill_wall_ns, sum.max_single_fill_ns,
            sum.prompt_calls, sum.prompt_bytes_read, sum.prompt_fill_wall_ns,
            sum.decode_calls, sum.decode_bytes_read, sum.decode_fill_wall_ns,
            sum.populate_calls, sum.populate_ns, sum.populate_errors,
            sum.total_fill_wall_ns, expert_demand_tokens ? double(sum.total_fill_wall_ns)/expert_demand_tokens : 0.0);
    }
#endif
    if (!expert_prefetch_layers.empty() && expert_prefetch_calls) {
        LLAMA_LOG_INFO("expert_prefetch: advise calls=%" PRIu64 " bytes advised=%" PRIu64 " failures=%" PRIu64
                       " next-layer prediction hits/total=%" PRIu64 "/%" PRIu64 " (%.2f%%)\n",
                expert_prefetch_calls, expert_prefetch_bytes, expert_prefetch_failures,
                expert_prefetch_hits, expert_prefetch_total,
                expert_prefetch_total ? 100.0 * expert_prefetch_hits / expert_prefetch_total : 0.0);
    }

    // when training, ggml_opt allocates extra buffers through the scheduler, so the sizes no longer match the expectation
    if (!model.no_alloc() && !opt_ctx) {
        for (size_t i = 0; i < backend_ptrs.size(); ++i) {
            ggml_backend_t             backend = backend_ptrs[i];
            ggml_backend_buffer_type_t buft    = backend_buft[i];

            const size_t size_exp = backend_buf_exp_size[i];
            const size_t size_act = ggml_backend_sched_get_buffer_size(sched.get(), backend);
            if (size_exp == size_act) {
                LLAMA_LOG_DEBUG("%s: %10s compute buffer size is %8.4f MiB, matches expectation of %8.4f MiB\n",
                    __func__, ggml_backend_buft_name(buft), size_act / (1024.0*1024.0), size_exp / (1024.0*1024.0));
            } else {
                LLAMA_LOG_WARN("%s: %10s compute buffer size of %8.4f MiB, does not match expectation of %8.4f MiB\n",
                    __func__, ggml_backend_buft_name(buft), size_act / (1024.0*1024.0), size_exp / (1024.0*1024.0));
            }
        }
    }
    ggml_opt_free(opt_ctx);
}

void llama_context::resolve_fused_ops(const llama_memory_context_i * mctx, uint32_t n_seqs) {
    const char * func = __func__;
    auto resolve = [&](const llm_fused_op_probe & probe, bool & enabled) {
        if (!enabled) {
            return;
        }

        const uint32_t n_tokens_probe = probe.n_tokens_per_seq*n_seqs;

        auto * gf = graph_reserve(n_tokens_probe, n_seqs, n_tokens_probe, mctx, true);
        if (!gf) {
            throw std::runtime_error(std::string("failed to reserve graph for ") + probe.name + " check");
    LLAMA_LOG_DEBUG("%s: il_start = %d, il_end = %d\n", __func__, il_start, il_end);

    bool res = cvec->apply(model, data, len, n_embd, il_start, il_end);

    sched_need_reserve = true;

    return res;
}

llm_graph_result * llama_context::process_ubatch(const llama_ubatch & ubatch, llm_graph_type gtype, llama_memory_context_i * mctx, ggml_status & ret) {
    if (mctx && !mctx->apply()) {
        LLAMA_LOG_ERROR("%s: failed to apply memory context\n", __func__);
        ret = GGML_STATUS_FAILED;
        return nullptr;
    }

    auto * res = get_gf_res_prev();
    auto * gf  = res->get_gf();

#ifdef __linux__
    expert_fill_init();
    expert_fill_phase(ubatch.n_tokens);
    if (expert_fill_enabled && !expert_fill_failed && expert_fill_this_ubatch) { expert_demand_tokens += ubatch.n_tokens; }
    if (expert_pregate_enabled) {
        // Layer numbers restart for every ubatch; retire previous-token backlog.
        for (auto & entry : expert_fillers) { entry.second->cancel_async_through(SIZE_MAX); }
        for (auto & layer : expert_pregate_layers) {
            layer.predicted.clear();
            for (auto & predictions : layer.predictions) { predictions.clear(); }
        }
    }
    if (!expert_config.fill && expert_config.prefetch && expert_prefetch_layers.empty()) {
        expert_prefetch_layers.resize(model.layers.size());
        expert_prefetch_next = expert_config.prefetch_next;
        LLAMA_LOG_INFO("expert_prefetch: CPU host-consumer hook enabled; device-only experts skipped, next=%d, LRU=32 ids/32 tokens\n", expert_prefetch_next);
    }
    for (auto & layer : expert_prefetch_layers) {
        layer.observed = false;
        layer.predicted.clear();
    }
    ggml_backend_sched_set_cpu_callback(sched.get(), expert_prefetch_layers.empty() ? nullptr : expert_prefetch_cb, this);
#endif

    // the new graph parameters
    // in order to correctly reuse a graph, it's full topology has to be uniquely determined by these parameters
    const auto gparams = graph_params(res, ubatch, mctx, gtype);

    if (!graph_reuse_disable && gf_res_prev_active == res && res->can_reuse(gparams)) {
        //LLAMA_LOG_DEBUG("%s: reusing previous graph\n", __func__);

        // with pipeline parallelism, the previous graph_compute_async may still be running
        // on the GPU. we must synchronize before set_inputs to avoid overwriting input tensors
        // that the previous compute is still reading.
        if (cparams.pipeline_parallel) {
            ggml_backend_sched_synchronize(sched.get());
        }
    ggml_context_ptr ctx;

    std::vector<ggml_tensor *> org;
    std::vector<ggml_tensor *> cpy;
};

